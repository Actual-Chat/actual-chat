<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="latest" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <PropertyGroup>
    <ActualLabFusionVersion>14.2.34</ActualLabFusionVersion>
    <AspNetCoreVersion>10.0.8</AspNetCoreVersion>
    <MicrosoftAspNetCoreVersion>2.3.10</MicrosoftAspNetCoreVersion> <!-- Weird, they have the second version -->
    <BlazorVersion>$(AspNetCoreVersion)</BlazorVersion>
    <EntityFrameworkCoreVersion>10.0.8</EntityFrameworkCoreVersion>
    <EntityFrameworkCoreNpgsqlVersion>10.0.1</EntityFrameworkCoreNpgsqlVersion>
    <EntityFrameworkCoreCheckConstraintsVersion>10.0.0</EntityFrameworkCoreCheckConstraintsVersion>
    <EntityFrameworkCoreInMemoryVersion>$(EntityFrameworkCoreVersion)</EntityFrameworkCoreInMemoryVersion>
    <MicrosoftExtensionsVersion>10.0.8</MicrosoftExtensionsVersion>
    <NpgsqlVersion>10.0.1</NpgsqlVersion>
    <RedisVersion>3.0.17</RedisVersion>
    <SignalRVersion>10.0.8</SignalRVersion>
    <SystemNetHttpJsonVersion>$(AspNetCoreVersion)</SystemNetHttpJsonVersion>
    <OpenTelemetryVersion>1.15.3</OpenTelemetryVersion>
    <OpenTelemetryInstrumentationAspNetCoreVersion>1.15.1</OpenTelemetryInstrumentationAspNetCoreVersion>
    <SentryVersion>5.14.1</SentryVersion>
    <MemoryPackVersion>1.21.4</MemoryPackVersion>
    <MessagePackVersion>3.1.8</MessagePackVersion>
    <SemanticKernelVersion>1.76.0</SemanticKernelVersion>
    <XamarinAndroidLifecycle>2.10.0.2</XamarinAndroidLifecycle>
  </PropertyGroup>
  <!--
    MAUI is not fully compatible with centralized packages management:
    - https://github.com/dotnet/sdk/issues/27840
    So we use only some packages in its project, and some - in other projects.
  -->
  <!-- MAUI-specific packages -->
  <ItemGroup Condition="$(MSBuildProjectName.Contains('Maui'))">
    <PackageVersion Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageVersion Include="Microsoft.Maui.Controls.Compatibility" Version="$(MauiVersion)" />
    <PackageVersion Include="Microsoft.Maui.Essentials" Version="$(MauiVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="$(MauiVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="$(MicrosoftExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="$(MicrosoftExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="$(MicrosoftExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Options.DataAnnotations" Version="$(MicrosoftExtensionsVersion)" />
    <PackageVersion Include="banditoth.MAUI.DeviceId" Version="1.0.2" />
    <PackageVersion Include="Plugin.Firebase.CloudMessaging" Version="4.0.1" />
    <PackageVersion Include="Plugin.Firebase.Analytics" Version="4.0.0" />
    <PackageVersion Include="Plugin.Firebase.Crashlytics" Version="4.0.0" />
    <PackageVersion Include="Plugin.Maui.Audio" Version="4.0.0" />
    <!-- Android -->
    <PackageVersion Include="Mono.Profiler.Android" Version="7.0.0" />
    <PackageVersion Include="Mono.AotProfiler.Android" Version="9.0.0-preview1" />
    <PackageVersion Include="Xamarin.AndroidX.Core" Version="1.18.0" />
    <PackageVersion Include="Xamarin.AndroidX.Collection" Version="1.6.0" />
    <PackageVersion Include="Xamarin.AndroidX.Collection.Ktx" Version="1.6.0" />
    <PackageVersion Include="Xamarin.AndroidX.DataStore.Preferences" Version="1.2.1" />
    <PackageVersion Include="Xamarin.AndroidX.Fragment.Ktx" Version="1.8.9.2" />
    <PackageVersion Include="Xamarin.AndroidX.Lifecycle.Common" Version="$(XamarinAndroidLifecycle)" />
    <PackageVersion Include="Xamarin.AndroidX.Lifecycle.Common.Java8" Version="$(XamarinAndroidLifecycle)" />
    <PackageVersion Include="Xamarin.AndroidX.Lifecycle.Runtime" Version="$(XamarinAndroidLifecycle)" />
    <PackageVersion Include="Xamarin.AndroidX.Lifecycle.Runtime.Ktx" Version="$(XamarinAndroidLifecycle)" />
    <PackageVersion Include="Xamarin.AndroidX.Lifecycle.Runtime.Ktx.Android" Version="$(XamarinAndroidLifecycle)" />
    <PackageVersion Include="Xamarin.AndroidX.Lifecycle.LiveData" Version="$(XamarinAndroidLifecycle)" />
    <PackageVersion Include="Xamarin.AndroidX.Lifecycle.LiveData.Core.Ktx" Version="$(XamarinAndroidLifecycle)" />
    <PackageVersion Include="Xamarin.AndroidX.Lifecycle.Process" Version="$(XamarinAndroidLifecycle)" />
    <PackageVersion Include="Xamarin.AndroidX.Media" Version="1.8.0" />
    <PackageVersion Include="Xamarin.Firebase.Analytics" Version="123.2.0" />
    <PackageVersion Include="Xamarin.Firebase.Crashlytics" Version="120.0.6" />
    <PackageVersion Include="Xamarin.Firebase.Messaging" Version="125.0.2" />
    <PackageVersion Include="Xamarin.GooglePlayServices.Auth" Version="121.5.1.1" />
    <PackageVersion Include="Xamarin.GooglePlayServices.CroNet" Version="118.1.1.2" />
    <PackageVersion Include="Xamarin.Google.Dagger" Version="2.59.2.1" />
    <PackageVersion Include="Xamarin.Google.AI.Edge.LiteRT" Version="2.1.5" />
    <PackageVersion Include="Xamarin.Google.AI.Edge.LiteRT.GPU" Version="1.4.2" />
    <!-- iOS -->
    <PackageVersion Include="Xamarin.Build.Download" Version="0.11.4" />
    <PackageVersion Include="AdamE.Firebase.iOS.Analytics" Version="12.5.0.4" />
    <PackageVersion Include="AdamE.Firebase.iOS.Crashlytics" Version="12.5.0.4" />
    <PackageVersion Include="AdamE.Firebase.iOS.CloudMessaging" Version="12.5.0.4" />
    <PackageVersion Include="ActualLab.Opus.MaciOS" Version="1.0.16-alpha" />
  </ItemGroup>
  <!-- Strictly non-MAUI packages -->
  <ItemGroup Condition="!$(MSBuildProjectName.Contains('Maui'))">
    <PackageVersion Include="Microsoft.Extensions.Caching.Abstractions" Version="$(MicrosoftExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="$(MicrosoftExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="$(MicrosoftExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Options.DataAnnotations" Version="$(MicrosoftExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="$(MicrosoftExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="$(MicrosoftExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="$(MicrosoftExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="$(MicrosoftExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="$(MicrosoftExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.FileProviders.Physical" Version="$(MicrosoftExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.FileSystemGlobbing" Version="$(MicrosoftExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="$(MicrosoftExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="$(MicrosoftExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Debug" Version="$(MicrosoftExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="$(MicrosoftExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="$(MicrosoftExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="$(MicrosoftExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="$(MicrosoftExtensionsVersion)" />
    <!-- Somehow these packages are updated w/ ASP.NET Core -->
    <PackageVersion Include="Microsoft.Extensions.Http.Polly" Version="$(AspNetCoreVersion)" />
    <PackageVersion Include="Microsoft.Extensions.ObjectPool" Version="$(AspNetCoreVersion)" />
  </ItemGroup>
  <!-- Fusion -->
  <ItemGroup>
    <PackageVersion Include="ActualLab.Core" Version="$(ActualLabFusionVersion)" />
    <PackageVersion Include="ActualLab.CommandR" Version="$(ActualLabFusionVersion)" />
    <PackageVersion Include="ActualLab.Fusion" Version="$(ActualLabFusionVersion)" />
    <PackageVersion Include="ActualLab.Fusion.Blazor" Version="$(ActualLabFusionVersion)" />
    <PackageVersion Include="ActualLab.Fusion.EntityFramework" Version="$(ActualLabFusionVersion)" />
    <PackageVersion Include="ActualLab.Fusion.EntityFramework.Npgsql" Version="$(ActualLabFusionVersion)" />
    <PackageVersion Include="ActualLab.Fusion.EntityFramework.Redis" Version="$(ActualLabFusionVersion)" />
    <PackageVersion Include="ActualLab.Fusion.Server" Version="$(ActualLabFusionVersion)" />
    <PackageVersion Include="ActualLab.Interception" Version="$(ActualLabFusionVersion)" />
    <PackageVersion Include="ActualLab.Kvasar" Version="0.3.10" />
    <PackageVersion Include="ActualLab.Redis" Version="$(ActualLabFusionVersion)" />
    <PackageVersion Include="ActualLab.RestEase" Version="$(ActualLabFusionVersion)" />
    <PackageVersion Include="ActualLab.Rpc" Version="$(ActualLabFusionVersion)" />
    <PackageVersion Include="ActualLab.Rpc.Server" Version="$(ActualLabFusionVersion)" />
    <PackageVersion Include="ActualLab.Testing" Version="$(ActualLabFusionVersion)" />
  </ItemGroup>
  <!-- All other packages -->
  <ItemGroup>
    <PackageVersion Include="Anthropic.SDK" Version="5.10.0" />
    <PackageVersion Include="AspNet.Security.OAuth.Apple" Version="10.0.0" />
    <PackageVersion Include="AspNetCore.HealthChecks.NpgSql" Version="9.0.0" />
    <PackageVersion Include="AspNet.Security.OAuth.GitHub" Version="6.0.14" />
    <PackageVersion Include="Blake3" Version="2.2.1" />
    <PackageVersion Include="CommunityToolkit.HighPerformance" Version="8.4.2" />
    <PackageVersion Include="CommunityToolkit.Maui.Core" Version="14.1.1" />
    <PackageVersion Include="Deepgram" Version="6.6.1" />
    <PackageVersion Include="DotNetEnv" Version="3.2.0" />
    <PackageVersion Include="EFCore.CheckConstraints" Version="$(EntityFrameworkCoreCheckConstraintsVersion)" />
    <PackageVersion Include="FFMpegCore" Version="5.4.0" />
    <PackageVersion Include="FirebaseAdmin" Version="3.5.0" />
    <PackageVersion Include="Google.Api.Gax" Version="4.14.0" />
    <PackageVersion Include="Google.Api.Gax.Rest" Version="4.14.0" />
    <PackageVersion Include="Google.Api.Gax.Grpc" Version="4.4.0" />
    <PackageVersion Include="Google.Apis" Version="1.74.0" />
    <PackageVersion Include="Google.Apis.Auth" Version="1.61.0" />
    <PackageVersion Include="Google.Cloud.AspNetCore.DataProtection.Storage" Version="1.0.0-alpha04" />
    <PackageVersion Include="Google.Cloud.RecaptchaEnterprise.V1" Version="2.20.0" />
    <PackageVersion Include="Google.Cloud.Speech.V2" Version="1.8.0" />
    <PackageVersion Include="Google.Cloud.Storage.V1" Version="4.14.0" />
    <PackageVersion Include="Google.Cloud.Video.Transcoder.V1" Version="2.12.0" />
    <PackageVersion Include="Grpc.Core" Version="2.46.6" />
    <!-- Used by OLTP exporter -->
    <PackageVersion Include="HtmlAgilityPack" Version="1.12.4" />
    <PackageVersion Include="libphonenumber-csharp" Version="9.0.31" />
    <PackageVersion Include="MaxMind.GeoIP2" Version="6.0.0" />
    <PackageVersion Include="UAParser" Version="3.1.47" />
    <PackageVersion Include="MailKit" Version="4.16.0" />
    <PackageVersion Include="MemoryPack" Version="$(MemoryPackVersion)" />
    <PackageVersion Include="MemoryPack.Core" Version="$(MemoryPackVersion)" />
    <PackageVersion Include="MemoryPack.Generator" Version="$(MemoryPackVersion)" />
    <PackageVersion Include="MessagePack" Version="$(MessagePackVersion)" />
    <PackageVersion Include="MessagePack.Annotations" Version="$(MessagePackVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.Google" Version="$(AspNetCoreVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="$(AspNetCoreVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.MicrosoftAccount" Version="$(AspNetCoreVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.Authorization" Version="$(AspNetCoreVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.Components" Version="$(AspNetCoreVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.Authorization" Version="$(AspNetCoreVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.Web" Version="$(AspNetCoreVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebView" Version="$(AspNetCoreVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="$(BlazorVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="$(BlazorVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="$(BlazorVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="$(AspNetCoreVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="$(AspNetCoreVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="$(SignalRVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Protocols.MessagePack" Version="$(SignalRVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.StaticFiles" Version="$(MicrosoftAspNetCoreVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="$(EntityFrameworkCoreVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Abstractions" Version="$(EntityFrameworkCoreVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="$(EntityFrameworkCoreInMemoryVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="$(EntityFrameworkCoreVersion)" />
    <PackageVersion Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.18.0" />
    <PackageVersion Include="Microsoft.IO.RecyclableMemoryStream" Version="3.0.1" />
    <PackageVersion Include="Microsoft.JSInterop" Version="$(AspNetCoreVersion)" />
    <PackageVersion Include="Microsoft.JSInterop.WebAssembly" Version="$(AspNetCoreVersion)" />
    <PackageVersion Include="Microsoft.AI.DirectML" Version="1.15.4" />
    <PackageVersion Include="Microsoft.ML.OnnxRuntime" Version="1.26.0" />
    <PackageVersion Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.24.4" />
    <PackageVersion Include="Microsoft.ML.OnnxRuntime.Managed" Version="1.26.0" />
    <PackageVersion Include="MimeKit" Version="4.5.0" />
    <PackageVersion Include="Mjml.Net" Version="4.11.0" />
    <PackageVersion Include="NATS.Net" Version="2.8.0" />
    <PackageVersion Include="NAudio" Version="2.3.0" />
    <PackageVersion Include="Npgsql" Version="$(NpgsqlVersion)" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="$(EntityFrameworkCoreNpgsqlVersion)" />
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.2" />
    <PackageVersion Include="OpusSharp.Core" Version="1.6.1.3" />
    <PackageVersion Include="OpusSharp.Natives" Version="1.6.1.3" />
    <PackageVersion Include="RestEase" Version="1.6.4" />
    <PackageVersion Include="Pidgin" Version="3.5.1" />
    <PackageVersion Include="Polly" Version="8.5.2" />
    <PackageVersion Include="SauceControl.Blake2Fast" Version="2.0.0" />
    <PackageVersion Include="Seq.Extensions.Logging" Version="9.0.0" />
    <PackageVersion Include="Sentry" Version="$(SentryVersion)" />
    <PackageVersion Include="Sentry.Extensions.Logging" Version="$(SentryVersion)" />
    <PackageVersion Include="Sentry.Serilog" Version="$(SentryVersion)" />
    <PackageVersion Include="Sentry.OpenTelemetry" Version="$(SentryVersion)" />
    <PackageVersion Include="Serilog" Version="4.3.1" />
    <PackageVersion Include="Serilog.Sinks.Debug" Version="3.0.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageVersion Include="Serilog.AspNetCore" Version="8.0.1" />
    <PackageVersion Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageVersion Include="Serilog.Extensions.Logging.File" Version="3.0.0" />
    <PackageVersion Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageVersion Include="SkiaSharp" Version="3.119.2" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.119.2" />
    <PackageVersion Include="StackExchange.Redis" Version="$(RedisVersion)" />
    <PackageVersion Include="Svg.Skia" Version="5.0.0" />
    <PackageVersion Include="System.Collections.Immutable" Version="$(MicrosoftExtensionsVersion)" />
    <PackageVersion Include="System.Net.WebSockets" Version="4.3.0" />
    <PackageVersion Include="System.Net.Http.Json" Version="$(SystemNetHttpJsonVersion)" />
    <PackageVersion Include="System.Threading.Channels" Version="$(AspNetCoreVersion)" />
    <PackageVersion Include="TurnerSoftware.RobotsExclusionTools" Version="0.9.1" />
    <PackageVersion Include="Twilio" Version="7.14.9" />
    <PackageVersion Include="Ulid" Version="1.4.1" />
    <PackageVersion Include="ZString" Version="2.6.0" />
    <PackageVersion Include="TimeZoneNames" Version="7.0.0" />
    <PackageVersion Include="TimeZoneConverter" Version="7.2.0" />
    <!-- TODO: Remove or migrate from these -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.Cookies" Version="$(MicrosoftAspNetCoreVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.Routing" Version="$(MicrosoftAspNetCoreVersion)" />
    <PackageVersion Include="System.Reactive" Version="6.0.0" />
    <!-- OpenSearch client -->
    <PackageVersion Include="OpenSearch.Net" Version="1.8.0" />
    <PackageVersion Include="OpenSearch.Client" Version="1.8.0" />
    <!-- Semantic kernel -->
    <PackageVersion Include="Microsoft.SemanticKernel.Connectors.Google" Version="1.61.0-alpha" />
    <PackageVersion Include="Microsoft.SemanticKernel.Abstractions" Version="$(SemanticKernelVersion)" />
    <PackageVersion Include="Microsoft.SemanticKernel" Version="$(SemanticKernelVersion)" />
    <PackageVersion Include="Microsoft.SemanticKernel.Connectors.OpenAI" Version="1.24.0" />
    <PackageVersion Include="Microsoft.SemanticKernel.Agents.Abstractions" Version="$(SemanticKernelVersion)" />
    <PackageVersion Include="Microsoft.SemanticKernel.Agents.Core" Version="$(SemanticKernelVersion)" />
    <!-- Model Context Protocol -->
    <PackageVersion Include="ModelContextProtocol" Version="1.3.0" />
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="1.3.0" />
    <!-- OpenTelemetry & Metrics-->
    <PackageVersion Include="OpenTelemetry" Version="$(OpenTelemetryVersion)" />
    <PackageVersion Include="OpenTelemetry.Api" Version="$(OpenTelemetryVersion)" />
    <PackageVersion Include="OpenTelemetry.Api.ProviderBuilderExtensions" Version="$(OpenTelemetryVersion)" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="$(OpenTelemetryVersion)" />
    <PackageVersion Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" Version="1.9.0-beta.2" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="$(OpenTelemetryVersion)" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="$(OpenTelemetryInstrumentationAspNetCoreVersion)" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="$(OpenTelemetryInstrumentationAspNetCoreVersion)" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.GrpcNetClient" Version="1.9.0-beta.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.EntityFrameworkCore" Version="1.0.0-beta.12" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Process" Version="0.5.0-beta.6" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="$(OpenTelemetryInstrumentationAspNetCoreVersion)" />
    <PackageVersion Include="Npgsql.OpenTelemetry" Version="$(NpgsqlVersion)" />
    <!-- Aspire -->
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="13.3.5" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.2.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.6.0" />
    <!-- For the build project -->
    <PackageVersion Include="CliWrap" Version="3.10.1" />
    <PackageVersion Include="Bullseye" Version="4.1.1" />
    <PackageVersion Include="System.CommandLine.DragonFruit" Version="0.3.0-alpha.21216.1" />
    <PackageVersion Include="System.Management" Version="10.0.2" />
    <PackageVersion Include="Crayon" Version="2.0.69" />
    <!-- Build / test time only -->
    <PackageVersion Include="AwesomeAssertions" Version="9.4.0" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="bunit" Version="2.7.2" />
    <PackageVersion Include="FlakyTest.XUnit" Version="2.4.10" />
    <PackageVersion Include="GitHubActionsTestLogger" Version="3.0.4" />
    <PackageVersion Include="ILRepack.Lib.MSBuild.Task" Version="2.0.45" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.5.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.Build" Version="$(BlazorVersion)" />
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.300" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="$(EntityFrameworkCoreVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Tools" Version="$(EntityFrameworkCoreVersion)" />
    <PackageVersion Include="Microsoft.Playwright" Version="1.60.0" />
    <PackageVersion Include="Moq" Version="4.20.72" />
    <PackageVersion Include="Moq.Autocomplete" Version="0.0.1" />
    <PackageVersion Include="Nerdbank.GitVersioning" Version="3.9.50" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="Xunit.DependencyInjection" Version="9.5.0" />
    <PackageVersion Include="Xunit.DependencyInjection.Logging" Version="9.0.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <!-- Analyzers -->
    <PackageVersion Include="Moq.Analyzers" Version="0.4.2" />
    <PackageVersion Include="Microsoft.VisualStudio.Threading.Analyzers" Version="17.14.15" />
    <PackageVersion Include="Meziantou.Analyzer" Version="3.0.93" />
    <PackageVersion Include="Roslynator.Analyzers" Version="4.15.0" />
    <PackageVersion Include="xunit.analyzers" Version="1.27.0" />
    <!-- Generators -->
    <PackageVersion Include="RestEase.SourceGenerator" Version="1.6.4" />
    <PackageVersion Include="ActualLab.Generators" Version="$(ActualLabFusionVersion)" />
  </ItemGroup>
</Project>
