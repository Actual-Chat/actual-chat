#!/bin/bash
# Resolve host.docker.internal to IPv4 for Chrome DevTools MCP
HOST_IP=$(getent ahosts host.docker.internal 2>/dev/null | grep -oP '^\d+\.\d+\.\d+\.\d+' | head -1)
PORT=${AC_CHROME_DEBUG_PORT:-9222}
URL="http://${HOST_IP:-127.0.0.1}:${PORT}"
exec npx chrome-devtools-mcp@0.20.0 --autoConnect --browserUrl "$URL"
