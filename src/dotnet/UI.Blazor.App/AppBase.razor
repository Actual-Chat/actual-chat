@using ActualChat.Hosting
@using ActualChat.Security
@using ActualChat.UI.Blazor.App.Pages.Landing
@implements IRootComponent
@{
    if (!UIHub.IsInteractive) {
        <LandingForWeb/>
        return;
    }
    if (!_readyToRender)
        return;
    if (_simulatedCrashError != null)
        throw _simulatedCrashError;
}

<ScreenSizeProvider>
    <AlwaysVisibleComponents/>

    <RequirementChecker>
        <Success>
            <TweakedRouter AppAssembly="@UIAssembly" AdditionalAssemblies="@UIModuleAssemblies">
                <Found Context="routeData">
                    <RouteView RouteData="@routeData" DefaultLayout="@typeof(DefaultLayout)"/>
                </Found>
                <NotFound>
                    <PageNotFoundBlock/>
                </NotFound>
            </TweakedRouter>
        </Success>
        <Failure Context="failures">
            <ErrorBlock Failures="@failures"/>
        </Failure>
    </RequirementChecker>
</ScreenSizeProvider>

@code {
    private static Assembly UIAssembly { get; } = typeof(AppBase).Assembly;
    private static Assembly[] UIModuleAssemblies { get; set; } = null!;

    private bool _readyToRender;
    private bool _shouldRender;
    private Exception? _simulatedCrashError;
    private readonly TaskCompletionSource _whenFirstRendered = TaskCompletionSourceExt.New();

    [Inject] protected INavigationInterception NavigationInterception { get; init; } = null!;
    [Inject] protected UIHub UIHub { get; init; } = null!;
    protected IServiceProvider Services => UIHub.Services;
    protected HostInfo HostInfo => UIHub.HostInfo();
    protected ISessionResolver SessionResolver => UIHub.SessionResolver;
    protected AppBlazorCircuitContext CircuitContext => UIHub.CircuitContext;
    protected ModuleHost ModuleHost => UIHub.ModuleHost;

    protected TrueSessionResolver? TrueSessionResolver { get; set; } // Set in MauiBlazorApp.OnInitializedAsync
    [field: AllowNull, MaybeNull]
    protected AppScopedServiceStarter AppScopedServiceStarter => field ??= Services.GetRequiredService<AppScopedServiceStarter>();
    [field: AllowNull, MaybeNull]
    protected Tracer Tracer => field ??= UIHub.Tracer();
    [field: AllowNull, MaybeNull]
    protected ILogger Log => field ??= UIHub.LogFor(GetType());

    [Parameter] public string SessionHash { get; set; } = "";
    [Parameter] public string SessionToken { get; set; } = "";
    [Parameter] public string RenderModeKey { get; set; } = "";

    public AppBase()
        => LoadingUI.MarkAppCreated();

    protected override void OnInitialized() {
        Log.LogWarning("OnInitialized, Hash: {Hash}", GetHashCode());
        if (CircuitContext.IsInteractive)
            CircuitContext.Initialize(this, RenderModeDef.GetOrDefault(RenderModeKey));
    }

    protected override async Task OnInitializedAsync() {
        using var _1 = Tracer.Region();

        var hostKind = HostInfo.HostKind;
        var sessionHash = SessionHash; // It's passed directly only in WASM app
        if (hostKind.IsServer()) {
            var secureTokensBackend = Services.GetRequiredService<ISecureTokensBackend>();
            var session = secureTokensBackend.ParseSessionToken(SessionToken);
            SessionResolver.Session = session; // All clients use DefaultSessionResolver
            sessionHash = session.Hash;
        }
        else if (hostKind.IsMauiApp()) {
            sessionHash = TrueSessionResolver!.Session.Hash;
        }
        if (!UIHub.IsInteractive)
            return;

        // Navigation has changed in Blazor Web apps.
        // Router component enables navigation interception for such an app in its OnAfterRenderAsync method.
        // https://github.com/dotnet/aspnetcore/blob/a2e367760e2e4f52861767461833a12782192a19/src/Components/Components/src/Routing/Router.cs#L328
        // When it's enabled, we can receive LocationChanged event as before with HistoryEntryState filled in;
        // otherwise HistoryEntryState is always null.
        // Since we don't render a Router component before History is initialized, we need to enable interception manually.
        Log.LogInformation("Before checking _whenFirstRendered={IsRendered}", _whenFirstRendered.Task.IsCompleted);
        await _whenFirstRendered.Task.ConfigureAwait(true); // Continue on the Blazor context.
        Log.LogInformation("After checking _whenFirstRendered");
        // I am not sure if it should be done both on server and wasm.
        if (!hostKind.IsMauiApp())
            await NavigationInterception.EnableNavigationInterceptionAsync().ConfigureAwait(true); // Continue on the Blazor context.
        var prepareFirstRenderTask = AppScopedServiceStarter.PrepareFirstRender(sessionHash);
        if (ReferenceEquals(UIModuleAssemblies, null)) {
            // Evaluate UIModuleAssemblies (just once - it's a static member)
            var uiModuleAssemblies = new HashSet<Assembly>();
            foreach (var module in ModuleHost.Modules) {
                if (module.IsUsed && module is IBlazorUIModule)
                    uiModuleAssemblies.Add(module.GetType().Assembly);
            }
            uiModuleAssemblies.Remove(UIAssembly);
            UIModuleAssemblies = uiModuleAssemblies.ToArray();
        }
        await prepareFirstRenderTask;
        _readyToRender = true;
        _shouldRender = true;
        _ = AppScopedServiceStarter.AfterFirstRender(CircuitContext.StopToken);
    }

    public void SimulateCrash(Exception error) {
        _simulatedCrashError = error;
        _shouldRender = true;
        StateHasChanged();
    }

    protected override bool ShouldRender() {
        var shouldRender = _shouldRender;
        _shouldRender = false;
        return shouldRender;
    }

    protected override void OnAfterRender(bool firstRender) {
        if (_whenFirstRendered.TrySetResult())
            Log.LogInformation("OnAfterRender");
    }
}
