@using ActualChat.Hosting
@using ActualChat.Security
@using ActualChat.UI.Blazor.App.Pages.Landing
@inherits ComponentBase<UIHub>
@implements IRootComponent
@implements IDisposable
@{
    if (!Hub.IsInteractive) {
        <LandingForWeb/>
        return;
    }
    if (!_readyToFullyRender) {
        // We render fake AppRouter here to enable the navigation interception
        <ClientUpgradeCover>
            <AppRouter AppAssembly="@BaseUIAssembly" AdditionalAssemblies="@OtherUIAssemblies">
                <Found></Found>
                <NotFound></NotFound>
            </AppRouter>
        </ClientUpgradeCover>
        return;
    }
    if (_simulatedCrashError != null)
        throw _simulatedCrashError;
}

<ClientUpgradeCover>
    <ScreenSizeProvider>
        <AlwaysVisibleComponents/>

        <RequirementChecker>
            <Success>
            <AppRouter AppAssembly="@BaseUIAssembly" AdditionalAssemblies="@OtherUIAssemblies">
                <Found Context="routeData">
                    <RouteView RouteData="@routeData" DefaultLayout="@typeof(DefaultLayout)"/>
                </Found>
                <NotFound>
                    <PageNotFoundBlock/>
                </NotFound>
            </AppRouter>
            </Success>
            <Failure Context="failures">
                <ErrorBlock Failures="@failures"/>
            </Failure>
        </RequirementChecker>
    </ScreenSizeProvider>
</ClientUpgradeCover>

@code {
    public static readonly Assembly BaseUIAssembly = typeof(AppBase).Assembly;
    public static Assembly[] OtherUIAssemblies = [typeof(UIHub).Assembly];

    private bool _readyToFullyRender;
    private bool _shouldRender;
    private Exception? _simulatedCrashError;
    private readonly AsyncTaskMethodBuilder _whenFirstRendered = AsyncTaskMethodBuilderExt.New();
    private BlazorAppLifecycle _appLifecycle = null!;

    protected INavigationInterception NavigationInterception
        => field ??= Hub.Services.GetRequiredService<INavigationInterception>();
    protected ISessionResolver SessionResolver => Hub.SessionResolver;

    protected TrueSessionResolver? TrueSessionResolver { get; set; } // Set in MauiBlazorApp.OnInitializedAsync
    protected AppScopedServiceStarter AppScopedServiceStarter => field ??= Services.GetRequiredService<AppScopedServiceStarter>();
    protected Tracer Tracer => field ??= Hub.Tracer[GetType()];
    protected ILogger Log => field ??= Hub.LogFor(GetType());

    [Parameter] public string SessionHash { get; set; } = "";
    [Parameter] public string SessionToken { get; set; } = "";
    [Parameter] public string RenderModeKey { get; set; } = "";

    public AppBase()
        => LoadingUI.MarkAppCreated();

    protected override void OnInitialized() {
        // Log.LogInformation("OnInitialized, Hash: {Hash}", GetHashCode());
        _appLifecycle = Hub.BlazorAppLifecycle;
        if (IsInteractive)
            Hub.Initialize(this, RenderModeDef.GetOrDefault(RenderModeKey));
    }

    protected override async Task OnInitializedAsync() {
        using var _1 = Tracer.MethodRegion();

        var hostKind = HostInfo.HostKind;
        var sessionHash = SessionHash; // It's passed directly only in the WASM app
        if (hostKind.IsServer()) {
            var secureTokensBackend = Services.GetRequiredService<ISecureTokensBackend>();
            var session = secureTokensBackend.ParseSessionToken(SessionToken);
            SessionResolver.Session = session; // All clients use DefaultSessionResolver
            sessionHash = session.Hash;
        }
        else if (hostKind.IsMauiApp()) {
            sessionHash = TrueSessionResolver!.Session.Hash;
        }
        if (!Hub.IsInteractive)
            return;

        // The Router component enables navigation interception in its OnAfterRenderAsync method:
        // - https://github.com/dotnet/aspnetcore/blob/a2e367760e2e4f52861767461833a12782192a19/src/Components/Components/src/Routing/Router.cs#L328
        // When it is enabled, we can receive the LocationChanged event with HistoryEntryState filled in;
        // otherwise, HistoryEntryState is always null.
        // That's why we need to wait for the AppRouter component to be rendered here.
        await _whenFirstRendered.Task;
        if (!hostKind.IsMauiApp()) // TODO(AY,DF): Check if we need this in WASM?
            await NavigationInterception.EnableNavigationInterceptionAsync();

        await AppScopedServiceStarter.PrepareFirstRender(sessionHash).SilentAwait();
        _readyToFullyRender = true;
        _shouldRender = true;
        _ = AppScopedServiceStarter.AfterFirstRender(Hub.StopToken);
    }

    public void SimulateCrash(Exception error) {
        _simulatedCrashError = error;
        _shouldRender = true;
        StateHasChanged();
    }

    protected override bool ShouldRender() {
        var shouldRender = _shouldRender;
        _shouldRender = false; // We don't want to render again until we set it to true again
        return shouldRender;
    }

    protected override void OnAfterRender(bool firstRender) {
        if (firstRender)
            _whenFirstRendered.TrySetResult();
    }

    public virtual void Dispose()
        => _appLifecycle.OnRootDisposing();
}
