<Project Sdk="Microsoft.NET.Sdk.Razor">

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Localization" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <!-- Embed JSON translation files as resources in the main assembly.
       WithCulture=false prevents MSBuild from treating "Strings.es.json" etc. as culture
       satellite resources (the ".es." in the filename would otherwise trigger that). -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\Strings.*.json" LogicalName="%(Filename)%(Extension)" WithCulture="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UI.App\UI.App.csproj" />
    <ProjectReference Include="..\UI.Blazor\UI.Blazor.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="ActualChat.Chat" />
    <Using Include="ActualChat.UI.Blazor.App" />
    <Using Include="ActualChat.UI.Blazor.App.Components" />
  </ItemGroup>

  <ItemGroup>
    <UpToDateCheckInput Remove="Components\SummaryMessage\SummaryMessage.razor" />
    <UpToDateCheckInput Remove="Components\SummaryMessage\SummaryMessageFooter.razor" />
    <UpToDateCheckInput Remove="Components\SummaryMessage\SummaryMessageHeader.razor" />
    <UpToDateCheckInput Remove="Components\SummaryMessage\SummaryTestPage.razor" />
    <UpToDateCheckInput Remove="Components\SummaryMessage\SummaryTestPageContent.razor" />
    <UpToDateCheckInput Remove="Components\SummaryMessage\TestSummaryMessageContent.razor" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ActualChat.Chat.UI.Blazor.UnitTests" />
  </ItemGroup>

</Project>
