@page "/test/mesh"
@using ActualChat.Hosting

<RequireAccount MustBeAdmin="true"/>
<MainHeader>Mesh Diagnostic Page</MainHeader>
@if (!HostInfo.HostKind.IsServer()) {
    <p>Use Server-Side Rendering mode to see the info.</p>
    return;
}
<ErrorBarrier Name="Mesh">
    @RenderContent()
</ErrorBarrier>


@code {
    private RenderFragment? _renderContent;

    [Inject] private AppUIHub Hub { get; init; } = null!;
    private HostInfo HostInfo => Hub.HostInfo;
    private TypeMapper<IEmbeddedView> ViewResolver => Hub.Services.GetRequiredService<TypeMapper<IEmbeddedView>>();

    private RenderFragment RenderContent() {
        if (_renderContent is null) {
            var componentType =  ViewResolver.Get(typeof(MeshTestPage));
            _renderContent = new RenderFragment(builder => {
                builder.OpenComponent(0, componentType);
                builder.CloseComponent();
            });
        }
        return _renderContent;
    }
}
