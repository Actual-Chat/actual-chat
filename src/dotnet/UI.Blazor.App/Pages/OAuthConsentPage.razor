@page "/oauth/consent"
@using ActualChat.OAuth
@inherits ComponentBase<AppUIHub>

<div class="flex-x h-full">
    <ChatPanelSkeleton/>
    <RightPanelSkeleton/>
</div>

@code {
    private const string AuthorizePath = "/oauth/authorize";
    private const string DenyParameter = "voxt_deny";

    private bool _isDecided;
    private string _authorizeQuery = "";

    private IOAuthGrants OAuthGrants => Hub.OAuthGrants;

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (!firstRender)
            return;

        var uri = new Uri(Nav.Uri);
        _authorizeQuery = WithoutDenyParameter(uri.Query);
        var query = uri.GetQueryCollection();
        var error = query["error"] is { } errorCode ? query["error_description"] ?? errorCode : null;

        var account = await AccountUI.OwnAccount.Use();
        if (error is null && (account.IsGuest || !account.IsActive())) {
            _ = AccountUI.RequestSignInFromHomePage(L.SignIn_ToAuthorizeApp, History.LocalUrl);
            return;
        }

        var clientId = query["client_id"] ?? "";
        var scopes = (query["scope"] ?? "mcp").Split(' ', StringSplitOptions.RemoveEmptyEntries);
        var client = error is null && !clientId.IsNullOrEmpty()
            ? await OAuthGrants.GetClient(Session, clientId, default)
            : null;
        var model = new OAuthConsentModal.Model(
            client, account, scopes, error,
            () => Approve(client!, scopes),
            Deny);
        var modalRef = await ModalUI.Show(model);
        await modalRef.WhenClosed;
        if (_isDecided)
            return;

        // Dismissing the dialog is a decision too: the app that opened it is waiting for a callback.
        // With nothing to answer (error or unknown client), just leave.
        if (client is null)
            _ = History.NavigateTo(Links.Chats, false, false, true);
        else
            await Deny();
    }

    private async Task<bool> Approve(OAuthClientInfo client, string[] scopes) {
        var command = new OAuthGrants_Approve {
            Session = Session,
            ClientId = client.ClientId,
            Scopes = scopes.ToApiArray(),
        };
        var (_, error) = await UICommander.Run(command);
        if (error is not null)
            return false;

        _isDecided = true;
        await History.ForceReload("OAuth consent approved", AuthorizePath + _authorizeQuery);
        return true;
    }

    private Task Deny() {
        _isDecided = true;
        var separator = _authorizeQuery.IsNullOrEmpty() ? "?" : "&";
        var url = AuthorizePath + _authorizeQuery + separator + DenyParameter + "=1";
        return History.ForceReload("OAuth consent denied", url).AsTask();
    }

    private static string WithoutDenyParameter(string query) {
        // Filters raw "&"-separated segments rather than re-rendering a parsed query,
        // so every other parameter (redirect_uri, state, ...) keeps its original encoding.
        if (query.IsNullOrEmpty())
            return "";

        var segments = query.TrimStart('?')
            .Split('&', StringSplitOptions.RemoveEmptyEntries)
            .Where(s => s != DenyParameter && !s.StartsWith(DenyParameter + "="))
            .ToArray();
        return segments.Length == 0 ? "" : "?" + string.Join('&', segments);
    }
}
