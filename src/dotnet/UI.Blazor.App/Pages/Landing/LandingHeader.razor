@using ActualChat.Hosting
@inherits FusionComponentBase<AppUIHub>
@{
    var account = Account;
    var baseUri = HostInfo.BaseUrl.ToUri();
    var privacyPath = Links.Privacy;
    var privacyUri = new Uri(baseUri, privacyPath);
}

@* Header *@
<div class="landing-header">
    @if (ScreenSize.IsNarrow()) {
        <ButtonRound Class="menu-button btn-sm" Click="@Click">
            <i class="icon-menu text-2xl"></i>
        </ButtonRound>
        <div class="c-content">
            <div class="light-header">
                <div class="c-title-wrapper">
                    <div class="c-title">
                        <img draggable="false" src="/dist/images/voxt-white-horizontal.svg" alt="" class="light-title">
                    </div>
                </div>
            </div>
            <div class="dark-header">
                <div class="c-title-wrapper">
                    <div class="c-title">
                        <img draggable="false" src="/dist/images/voxt-black-horizontal.svg" alt="" class="dark-title">
                    </div>
                </div>
            </div>
        </div>
        <div class="c-right">
            @if (account.IsGuestOrNull()) {
                <ButtonRound Class="signin-button btn-sm" Click="@(SignIn)">
                    <i class="icon-log-in text-xl"></i>
                </ButtonRound>
            } else {
                <button
                    class="context-menu-btn md:mx-4"
                    data-menu="@(MenuRef.New<LandingAccountMenu>().ToString())"
                    data-menu-trigger="@MenuTrigger.Primary"
                    data-menu-placement="@(FloatingPosition.BottomStart.ToPositionString())">
                    <AvatarCircle
                        Avatar="@account.Avatar"
                        Size="SquareSize.Size9"/>
                </button>
            }
        </div>
    } else {
        <div class="c-content">
            <div class="light-header">
                <div class="c-title-wrapper">
                    <div class="c-title">
                        <img draggable="false" src="/dist/images/voxt-white-horizontal.svg" alt="" class="light-title">
                    </div>
                    <div class="c-btn-group">
                        <div class="w-16"></div>
                        @if (!HostInfo.HostKind.IsMauiApp()) {
                            <Button
                                Click="@WhyUsClick"
                                Class="btn-text btn-transparent why-us unhovered">@L.Landing_WhyUs</Button>
                            @* <Button
                                Click="@PricingClick"
                                Class="btn-text btn-transparent unhovered">Why now
                            </Button> *@
                        }
                        <a href="@privacyUri" class="btn-text btn-transparent unhovered">@L.Documents_PrivacyPolicy</a>
                    </div>
                </div>
            </div>

            <div class="dark-header">
                <div class="c-title-wrapper">
                    <div class="c-title">
                        <img draggable="false" src="/dist/images/voxt-black-horizontal.svg" alt="" class="dark-title">
                    </div>
                    <div class="c-btn-group">
                        <div class="w-16"></div>
                        @if (!HostInfo.HostKind.IsMauiApp()) {
                            <Button
                                Click="@WhyUsClick"
                                Class="btn-text btn-transparent why-us unhovered">@L.Landing_WhyUs</Button>
                            @* <Button
                                Click="@PricingClick"
                                Class="btn-text btn-transparent unhovered">Why now
                            </Button> *@
                        }
                        <a href="@privacyUri" class="btn-text btn-transparent unhovered">@L.Documents_PrivacyPolicy</a>
                    </div>
                </div>
            </div>
            <div class="c-btn-group">
                @if (account.IsGuestOrNull()) {
                    <button class="signin-button-group items-center lg-icon" @onclick="@SignIn">
                        <span class="font-medium">@L.SignIn_SignIn</span>
                        <i class="icon-monitor text-2xl font-thin"></i>
                    </button>
                    <DownloadButton
                        Title="@L.Landing_GetApp"
                        Click="DownloadClick"
                        Class="download-app lg-icon"/>
                    <button class="btn-download btn-to-main-page !hidden" @onclick="@BackToMainPageClick">
                        @L.Landing_BackToMainPage
                    </button>
                } else {
                    <div
                        class="context-menu-btn"
                        data-menu="@(MenuRef.New<LandingAccountMenu>().ToString())"
                        data-menu-trigger="@MenuTrigger.Primary"
                        data-menu-placement="@(FloatingPosition.BottomStart.ToPositionString())">
                        <AvatarCircle
                            Avatar="@account.Avatar"
                            Size="SquareSize.Size10"/>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    [CascadingParameter] public ScreenSize ScreenSize { get; set; }
    [Parameter, EditorRequired] public AccountFull? Account { get; set; }
    [Parameter] public EventCallback PricingClick { get; set; }
    [Parameter] public EventCallback DownloadClick { get; set; }
    [Parameter] public EventCallback BackToMainPageClick { get; set; }
    [Parameter] public EventCallback WhyUsClick { get; set; }
    [Parameter] public EventCallback Click { get; set; }

    private Task SignIn()
        => ModalUI.Show(new SignInModal.Model());

    private Task OnShowVideoClick()
        => ModalUI.Show(new LandingVideoModal.Model());
}
