@inherits ComponentBase<AppUIHub>

<div class="landing-footer">
    <div class="flex-1 flex-y gap-y-4">
        <div class="flex-y md:flex-x md:gap-x-12 justify-start text-01">
            <a data-href="/docs/privacy" class="footer-link">
                Privacy
            </a>
            <a data-href="/docs/terms" class="footer-link">
                Terms
            </a>
            <a data-href="/docs/cookies" class="footer-link">
                Cookie Preferences
            </a>
            <a href="mailto:@Constants.Team.SupportEmail" target="_blank" class="footer-link">
                Contact us
            </a>
        </div>
        <div class="flex items-end min-h-8 text-01 text-sm">
            @CoreConstants.Copyright
        </div>
    </div>
    <div class="hidden md:flex-y gap-y-3 items-start text-01">
        <a class="footer-link" data-href="@(Links.Chat(Constants.Chat.AnnouncementsChatId).ToAbsolute(UrlMapper))">
            Announcements
        </a>
        <a class="footer-link" data-href="https://github.com/Actual-Chat/actual-chat">
            GitHub
        </a>
    </div>
</div>
