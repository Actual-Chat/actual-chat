@inherits ComponentBase<AppUIHub>

<div class="landing-footer">
    <div class="c-content">
        <div class="c-left">
            <div class="c-links">
                <a href="mailto:@Constants.Team.SupportEmail" target="_blank" class="footer-link">
                    @L.Landing_ContactUs
                </a>
                <a class="footer-link" data-href="https://github.com/Actual-Chat/actual-chat">
                    GitHub
                </a>
                <a data-href="/docs/privacy" class="footer-link">
                    @L.Documents_PrivacyPolicy
                </a>
                <a data-href="/docs/terms" class="footer-link">
                    @L.Landing_Terms
                </a>
                <a data-href="/docs/cookies" class="footer-link">
                    @L.Landing_CookiePreferences
                </a>
            </div>
            <div class="c-copyright">
                @CoreConstants.Copyright
            </div>
        </div>
    </div>
</div>
