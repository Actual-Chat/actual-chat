@inherits ComponentBase<AppUIHub>
@{
    var hideForNarrow = !IsNarrow && ScreenSize.IsNarrow() ? "!hidden" : "";
}

<div class="landing-links @hideForNarrow" xmlns="http://www.w3.org/1999/html">
    <div class="c-title">
        @L.Download_GetApp_Format(CoreConstants.AppName)
    </div>
    <div class="link-group">
        <button class="link-btn" data-href="@(Links.Apps.Android)">
            <div class="link-btn-content">
                <img draggable="false" src="/dist/images/webonly/android-logo-white.svg" alt="Android app">
            </div>
            <div class="c-text">
                <span>@L.Landing_Install</span>
                <span>@L.Landing_ForPlatform_Format("Android")</span>
            </div>
        </button>
        <button class="link-btn" data-href="@(Links.Apps.iOS)">
            <div class="link-btn-content">
                <img draggable="false" src="/dist/images/webonly/apple-logo-white.svg" alt="iOS app">
            </div>
            <div class="c-text">
                <span>@L.Landing_Install</span>
                <span>@L.Landing_ForPlatform_Format("iOS")</span>
            </div>
        </button>
        <button class="link-btn" data-href="@(Links.Apps.Windows)">
            <div class="link-btn-content ">
                <img class="windows-icon" draggable="false" src="/dist/images/webonly/windows-logo-white.svg" alt="Windows app">
            </div>
            <div class="c-text">
                <span>@L.Landing_Install</span>
                <span>@L.Landing_ForPlatform_Format("Windows")</span>
            </div>
        </button>
        <button class="link-btn" @onclick="@SignIn">
            <div class="link-btn-content">
                <img draggable="false" src="/dist/images/webonly/web-logo-white.svg" alt="Web app">
            </div>
            <div class="c-text">
                <span>@L.Landing_JustSignIn</span>
                <span>@L.Landing_ForWebApp</span>
            </div>
        </button>
    </div>
</div>

@code{
    [CascadingParameter] public ScreenSize ScreenSize { get; set; }
    [Parameter] public bool IsNarrow { get; set; }
    [Parameter] public bool EnableIncompleteUI { get; set; }

    private Task SignIn()
        => ModalUI.Show(new SignInModal.Model());
}
