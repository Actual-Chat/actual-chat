@implements IDisposable

@foreach(var link in _links) {
    var isActiveLink = _activeAnchor == link.url;
    var url = _pageUrl + "#" + link.url;
    <a
        href="@url"
        class="c-title @(isActiveLink ? "active" : "")"
        @onclick="@(() => NavigateTo(link.url))"
        @onclick:preventDefault="true">
        @link.title
    </a>
}

@code {
    private string _activeAnchor = "";
    private (string title, string url)[] _links = [];
    private string _pageUrl = "";

    [Inject] private NavigationManager Nav { get; init; } = null!;
    [Inject] private History History { get; init; } = null!;

    [Parameter, EditorRequired] public DocsPage Page { get; set; }

    protected override void OnInitialized() {
        UpdateActiveAnchor();
        Nav.LocationChanged += OnLocationChanged;
    }

    protected override void OnParametersSet() {
        _links = [];
        var pagePath = "";
        var cookiesLinks = new[] {
            ("Introduction", "introduction"),
            ("Whats in a cookie?", "whats-in"),
            ("What to do if you do not want cookies to be set", "how-to-set"),
            ("How can I control cookies?", "control"),
            ("How Actual.Chat uses cookies", "how-we-use"),
            ("Blocking and Deleting", "blocking"),
        };
        var termsLinks = new[] {
            ("Interpretation and Definitions", "definitions"),
            ("Acknowledgment", "acknowledgment"),
            ("User Accounts", "user-accounts"),
            ("Content", "content"),
            ("Copyright Policy", "copyright-policy"),
            ("Feedback and Limitation of Liability", "feedback"),
            ("Governing Law", "governing-law"),
        };
        var privacyLinks = new[] {
            ("Introduction", "introduction"),
            ("Interpretation and Definitions", "definitions"),
            ("Personal Data", "personal-data"),
            ("GDPR Privacy", "gdpr"),
            ("CCPA Privacy", "ccpa"),
            ("CalOPPA", "caloppa"),
        };

        if (Page == DocsPage.Cookies) {
            _links = cookiesLinks;
            pagePath = "cookies";
        } else if (Page == DocsPage.Terms) {
            _links = termsLinks;
            pagePath = "terms";
        } else if (Page == DocsPage.Privacy) {
            _links = privacyLinks;
            pagePath = "privacy";
        }

        _pageUrl = $"docs/{pagePath}/";

        UpdateActiveAnchor();
    }

    public void Dispose()
        => Nav.LocationChanged -= OnLocationChanged;

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
        => UpdateActiveAnchor(true);

    private void UpdateActiveAnchor(bool raiseStateHasChanged = false)
    {
        var uri = Nav.Uri.ToUri();
        var fragment = uri.Fragment;
        var oldActiveAnchor = _activeAnchor;
        _activeAnchor = fragment.StartsWith('#') ? fragment[1..] : "";
        if (raiseStateHasChanged && !Equals(oldActiveAnchor, _activeAnchor))
            StateHasChanged();
    }

    private void NavigateTo(string hash) {
        _activeAnchor = hash;
        _ = History.NavigateTo(_pageUrl + "#" + hash);
    }
}
