<RenderIntoSlot Name="@LayoutSlots.MainLeftDrawer">
    <CascadingValue Value="@Page">
        <DocsLeftPanel/>
    </CascadingValue>
</RenderIntoSlot>

<RenderIntoSlot Name="@LayoutSlots.MainRightDrawer">
    <DocsRightPanel Page="@Page"/>
</RenderIntoSlot>

<RenderIntoSlot Name="@LayoutSlots.MainHeader">
    <DocsHeader Page="@Page"/>
</RenderIntoSlot>

@code {
    [Parameter] public DocsPage Page { get; set; } = DocsPage.Privacy;
}
