@{
    var items = new (string Title, int N)[] {
        ("Voice + Text. Together.", 1),
        ("Video & Screencast", 2),
        ("Read and listen anytime", 3),
        ("Conversation Summaries", 4),
        ("Groups & Places", 5),
    };
}

<div class="landing-page-noise">
    <img draggable="false" src="/dist/images/webonly/landing-page-noise.svg" alt="">
</div>
<div class="c-content">
    <div class="title-text">How @CoreConstants.AppName can help you?</div>

    @for (var i = 0; i < items.Length; i++) {
        var item = items[i];
        var parity = i % 2 == 0 ? "odd" : "even";
        <div class="c-row @parity">
            <div class="colored-card">
                <div class="c-wrapper">
                    <div class="landing-card-video-container">
                        <img draggable="false" src="/dist/images/webonly/page-4-image-@(item.N).svg"
                             alt="" class="landing-card-video-plug">
                    </div>
                </div>
            </div>
            <div class="c-column">
                <div class="c-description">
                    <div class="c-title">@item.Title</div>
                    <div class="c-card-image">
                        <img draggable="false" src="/dist/images/webonly/page-4-card-@(item.N).svg" alt="">
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [CascadingParameter] public ScreenSize ScreenSize { get; set; }
}
