@inherits ComputedStateComponent<ChatUIHub, AccountFull?>
@{
    var account = State.Value;
}

<div @ref="Ref" class="landing theme-light" xmlns="http://www.w3.org/1999/html">
    <LandingLeftMenu @ref="LandingLeftMenuRef" />

    <LandingHeader Account="@account" Click="@OnMenuHandleClick"/>

    <LandingPage Class="page-1">
        <LandingPage1
            IsGuest="@account.IsGuestOrNull()"
            SignInClick="@SignIn"
            ShowVideoClick="@OnShowVideoClick"/>
    </LandingPage>
</div>

@code {
    protected IJSObjectReference JSRef { get; set; } = null!;
    protected ElementReference Ref { get; set; }
    protected LandingLeftMenu? LandingLeftMenuRef { get; set; }

    public override async ValueTask DisposeAsync() {
        await JSRef.DisposeSilentlyAsync("dispose");
        JSRef = null!;
        await base.DisposeAsync();
    }

    protected override ComputedState<AccountFull?>.Options GetStateOptions()
        => new() {
            InitialValue = AccountUI.OwnAccount.Value,
            Category = GetStateCategory(GetType()),
        };

    protected override Task<AccountFull?> ComputeState(CancellationToken cancellationToken)
        => AccountUI.OwnAccount.Use(cancellationToken)!;

    protected Task SignIn()
        => ModalUI.Show(new SignInModal.Model());

    protected Task OnShowVideoClick()
        => ModalUI.Show(new LandingVideoModal.Model());

    protected void OnMenuHandleClick()
        => LandingLeftMenuRef?.Open();
}
