<div class="landing-page-noise">
    <img draggable="false" src="/dist/images/landing/landing-page-noise.svg" alt="">
</div>
<div class="c-content">
    <div class="title-text">Feature Breakdown</div>

    @* Row 1 *@
    <div class="c-row c-first">
        <LandingImageCard>
            <CardImage>
                <img draggable="false" src="/dist/images/landing/page-7-image-1.svg" alt="">
            </CardImage>
            <CardTitle>
                Live transcription
            </CardTitle>
        </LandingImageCard>
        <LandingImageCard>
            <CardImage>
                <img draggable="false" src="/dist/images/landing/page-7-image-2.svg" alt="">
            </CardImage>
            <CardTitle>
                Live translation
            </CardTitle>
        </LandingImageCard>
        <LandingImageCard>
            <CardImage>
                <img draggable="false" src="/dist/images/landing/page-7-image-3.svg" alt="">
            </CardImage>
            <CardTitle>
                Conversation Summaries
            </CardTitle>
        </LandingImageCard>
    </div>

    @* Row 2 *@
    <div class="c-row">
        <LandingImageCard>
            <CardImage>
                <img draggable="false" src="/dist/images/landing/page-7-image-4.svg" alt="">
            </CardImage>
            <CardTitle>
                Organized Places
            </CardTitle>
        </LandingImageCard>
        @if (!ScreenSize.IsNarrow()) {
            <LandingImageCard>
                <CardImage>
                    <img draggable="false" src="/dist/images/landing/page-7-image-5.svg" alt="">
                </CardImage>
                <CardTitle>
                </CardTitle>
            </LandingImageCard>
        }
        <LandingImageCard>
            <CardImage>
                <img draggable="false" src="/dist/images/landing/page-7-image-6.svg" alt="">
            </CardImage>
            <CardTitle>
                File uploads
            </CardTitle>
        </LandingImageCard>
    </div>

    @* Row 3 *@
    <div class="c-row">
        <LandingImageCard>
            <CardImage>
                <img draggable="false" src="/dist/images/landing/page-7-image-7.svg" alt="">
            </CardImage>
            <CardTitle>
                Video & Screenshare
            </CardTitle>
        </LandingImageCard>
        <LandingImageCard>
            <CardImage>
                <img draggable="false" src="/dist/images/landing/page-7-image-8.svg" alt="">
            </CardImage>
            <CardTitle>
                UI customization
            </CardTitle>
        </LandingImageCard>
        <LandingImageCard>
            <CardImage>
                <img draggable="false" src="/dist/images/landing/page-7-image-9.svg" alt="">
            </CardImage>
            <CardTitle>
                Custom notifications
            </CardTitle>
        </LandingImageCard>
    </div>
</div>

@code {
    [CascadingParameter] public ScreenSize ScreenSize { get; set; }
}
