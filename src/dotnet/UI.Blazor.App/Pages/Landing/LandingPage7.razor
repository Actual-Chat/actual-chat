<div class="landing-page-noise grain-overlay"></div>
<div class="c-content">
    <div class="title-text">Feature Breakdown</div>

    @* Row 1 *@
    <div class="c-row c-first">
        <LandingImageCard>
            <CardImage>
                <img draggable="false" src="/dist/images/webonly/page-7-image-1.svg" alt="">
                <div class="c-grain grain-overlay"
                     style="--grain-mask: url(/dist/images/webonly/page-7-image-1-grain.svg)"></div>
            </CardImage>
            <CardTitle>
                Live transcription
            </CardTitle>
        </LandingImageCard>
        <LandingImageCard>
            <CardImage>
                <img draggable="false" src="/dist/images/webonly/page-7-image-2.svg" alt="">
                <div class="c-grain grain-overlay"
                     style="--grain-mask: url(/dist/images/webonly/page-7-image-2-grain.svg)"></div>
            </CardImage>
            <CardTitle>
                Live translation
            </CardTitle>
        </LandingImageCard>
        <LandingImageCard>
            <CardImage>
                <img draggable="false" src="/dist/images/webonly/page-7-image-3.svg" alt="">
                <div class="c-grain grain-overlay"
                     style="--grain-mask: url(/dist/images/webonly/page-7-image-3-grain.svg)"></div>
            </CardImage>
            <CardTitle>
                Conversation Summaries
            </CardTitle>
        </LandingImageCard>
    </div>

    @* Row 2 *@
    <div class="c-row">
        <LandingImageCard>
            <CardImage>
                <img draggable="false" src="/dist/images/webonly/page-7-image-4.svg" alt="">
                <div class="c-grain grain-overlay"
                     style="--grain-mask: url(/dist/images/webonly/page-7-image-4-grain.svg)"></div>
            </CardImage>
            <CardTitle>
                Organized Places
            </CardTitle>
        </LandingImageCard>
        @if (!ScreenSize.IsNarrow()) {
            <LandingImageCard>
                <CardImage>
                    <img draggable="false" src="/dist/images/webonly/page-7-image-5.svg" alt="">
                    <div class="c-grain grain-overlay"
                         style="--grain-mask: url(/dist/images/webonly/page-7-image-5-grain.svg)"></div>
                </CardImage>
                <CardTitle>
                </CardTitle>
            </LandingImageCard>
        }
        <LandingImageCard>
            <CardImage>
                <img draggable="false" src="/dist/images/webonly/page-7-image-6.svg" alt="">
                <div class="c-grain grain-overlay"
                     style="--grain-mask: url(/dist/images/webonly/page-7-image-6-grain.svg)"></div>
            </CardImage>
            <CardTitle>
                File uploads
            </CardTitle>
        </LandingImageCard>
    </div>

    @* Row 3 *@
    <div class="c-row">
        <LandingImageCard>
            <CardImage>
                <img draggable="false" src="/dist/images/webonly/page-7-image-7.svg" alt="">
                <div class="c-grain grain-overlay"
                     style="--grain-mask: url(/dist/images/webonly/page-7-image-7-grain.svg)"></div>
            </CardImage>
            <CardTitle>
                Video & Screenshare
            </CardTitle>
        </LandingImageCard>
        <LandingImageCard>
            <CardImage>
                <img draggable="false" src="/dist/images/webonly/page-7-image-8.svg" alt="">
                <div class="c-grain grain-overlay"
                     style="--grain-mask: url(/dist/images/webonly/page-7-image-8-grain.svg)"></div>
            </CardImage>
            <CardTitle>
                UI customization
            </CardTitle>
        </LandingImageCard>
        <LandingImageCard>
            <CardImage>
                <img draggable="false" src="/dist/images/webonly/page-7-image-9.svg" alt="">
                <div class="c-grain grain-overlay"
                     style="--grain-mask: url(/dist/images/webonly/page-7-image-9-grain.svg)"></div>
            </CardImage>
            <CardTitle>
                Custom notifications
            </CardTitle>
        </LandingImageCard>
    </div>
</div>

@code {
    [CascadingParameter] public ScreenSize ScreenSize { get; set; }
}
