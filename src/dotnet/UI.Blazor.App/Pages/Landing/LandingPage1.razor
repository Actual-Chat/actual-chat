@using ActualChat.Hosting
@inherits ComponentBase<AppUIHub>
@{
    var isMaui = HostInfo.HostKind.IsMauiApp();
    var signinText = isMaui ? L.SignIn_SignIn : L.Landing_SignInToWebApp;
}

<div class="bg-wrapper">
    @if (!ScreenSize.IsNarrow()) {
        <img draggable="false" class="wide-image" src="/dist/images/voxt-galaxy-horizontal.svg" alt="voxt">
    } else {
        <img draggable="false" class="narrow-image" src="/dist/images/voxt-galaxy-vertical.svg" alt="voxt">
    }
</div>

<div class="c-content">
    <div class="main-text">
        <div class="main-text-wrapper">
            <div class="c-title">
                <span>@L.Landing_Title</span>
                <span class="c-title-accent-line">@L.Landing_TitleAccent_Prefix<span class="page-1-handwrite"
                    >@L.Landing_TitleAccentTarget</span>@L.Landing_TitleAccent_Suffix</span>
            </div>
            <ul class="custom-list">
                <li>@L.Landing_SocialWithoutMedia</li>
                <li>@L.Landing_YourCircle</li>
                <li>@L.Landing_MadeForTalking</li>
            </ul>
            <p class="c-description">
                <span>@L.Landing_Description_Format(CoreConstants.AppName)</span>
            </p>
        </div>
        <div class="c-btn-group">
            @if (!IsGuest) {
                <button class="btn-download btn-to-chats" @onclick="@(() => NavigateTo(Links.Chats))">
                    <div class="c-content">
                        <span class="gradient-span">
                            <i class="icon-message-ellipse text-2xl"></i>
                            <span>@L.Landing_GoToChats</span>
                        </span>
                    </div>
                </button>
            }
            @if (IsGuest) {
                <button class="btn-download transparent md:light lg-icon" @onclick="@SignInClick">
                    <span>@signinText</span>
                    @if (!isMaui) {
                        <i class="icon-monitor text-2xl font-thin"></i>
                    }
                </button>
            }
            @if (!isMaui) {
                <DownloadButton
                    Click="@DownloadClick"
                    Class="download-app lg-icon"/>
            }
            @if (IsGuest && ScreenSize.IsNarrow()) {
                <button class="btn-download transparent" @onclick="@ShowVideoClick">
                    <i class="icon-play-fill text-2xl"></i>
                    <span>@L.Landing_WatchInAction_Format(CoreConstants.AppName)</span>
                </button>
            }
        </div>
    </div>
    @if (ScreenSize.IsWide()) {
        <div class="main-image">
            <video controls hidden muted preload="none" playsinline loop class="landing-video"
                   data-src-webm="/dist/images/webonly/landing-tutorial.webm"
                   data-src-mp4="/dist/images/landing/landing-tutorial.mp4">
            </video>
            <img draggable="false"
                 src="/dist/images/landing/landing-tutorial-plug.png"
                 alt="@L.Landing_LoadingIntroVideo_Format(CoreConstants.AppName)"
                 class="landing-video-plug flex">
            <div class="hover-plug">
                <div class="play-btn">
                    <i class="icon-play-fill play-btn-icon text-2xl"></i>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [CascadingParameter] public ScreenSize ScreenSize { get; set; }

    [Parameter] public bool IsGuest { get; set; }
    [Parameter] public EventCallback SignInClick { get; set; }
    [Parameter] public EventCallback ShowVideoClick { get; set; }
    [Parameter] public EventCallback DownloadClick { get; set; }

    private void NavigateTo(string url)
        => _ = History.NavigateTo(url);
}
