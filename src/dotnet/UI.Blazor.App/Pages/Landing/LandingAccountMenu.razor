@using ActualChat.UI.Blazor.Events
@inherits ComputedMenuBase<AppUIHub, AccountFull>
@{
    var m = State.Value;
}

<div class="landing-account-menu">
    <MenuEntry
        Icon="icon-message-ellipse"
        Text="@L.Landing_GoToChats"
        Click="@(_ => NavigateTo(Links.Chats))">
    </MenuEntry>
    <MenuEntry
        Icon="icon-settings"
        Text="@L.Common_Settings"
        Click="@OnSettingsClick">
    </MenuEntry>
    <a class="ac-menu-item" href="mailto:@Constants.Team.SupportEmail" target="_blank">
        <div class="ac-menu-content">
            <div class="ac-menu-icon">
                <i class="icon-question-mark-circle"></i>
            </div>
            <div class="ac-menu-text">
                @L.Landing_Support
            </div>
        </div>
    </a>
    @if (m.IsGuest) {
        <MenuEntry
            Icon="icon-log-in"
            Text="@L.SignIn_SignIn"
            Click="@(_ => ModalUI.Show(new SignInModal.Model()))">
        </MenuEntry>
    } else {
        <MenuEntry
            Icon="icon-log-out"
            Text="@L.SignIn_SignOut"
            Click="@(_ => AccountUI.SignOut())">
        </MenuEntry>
    }
</div>

@code {
    protected override ComputedState<AccountFull>.Options GetStateOptions()
        => new() {
            InitialValue = AccountUI.OwnAccount.Value,
            Category = GetStateCategory(GetType()),
        };

    protected override Task<AccountFull> ComputeState(CancellationToken cancellationToken)
        => AccountUI.OwnAccount.Use(cancellationToken);

    private void OnSettingsClick()
        => _ = UIEventHub.Publish(new ShowSettingsEvent());
}
