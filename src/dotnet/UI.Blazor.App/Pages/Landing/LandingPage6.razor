<div class="landing-page-noise">
    <img draggable="false" src="/dist/images/landing/landing-page-noise.svg" alt="">
</div>
<div class="c-content">
    <div class="title-text">Security & Privacy</div>

    @* Row 1 *@
    <div class="c-row c-first">
        <LandingImageCard>
            <CardImage>
                <img draggable="false" src="/dist/images/landing/page-6-image-1.svg" alt="">
            </CardImage>
            <CardTitle>
                Always encrypted in transit.
            </CardTitle>
        </LandingImageCard>
        <LandingImageCard>
            <CardImage>
                <img draggable="false" src="/dist/images/landing/page-6-image-2.svg" alt="">
            </CardImage>
            <CardTitle>
                Invite-only groups & places.
            </CardTitle>
        </LandingImageCard>
        <LandingImageCard>
            <CardImage>
                <img draggable="false" src="/dist/images/landing/page-6-image-3.svg" alt="">
            </CardImage>
            <CardTitle>
                No ads. No algorithmic feed.
            </CardTitle>
        </LandingImageCard>
    </div>
    <div class="c-description">
        @if (ScreenSize.IsNarrow()) {
            <span class="c-text page-6-handwrite">
                No followers.
            </span>
            <span class="c-text page-6-handwrite">
                No feeds.
            </span>
            <span class="c-text page-6-handwrite">
                No noise.
            </span>
        } else {
            <span class="c-text page-6-handwrite">
                No followers. No feeds. No noise.
            </span>
        }
        <div class="c-text">
            Voxt is built for people you actually know and trust.
        </div>
    </div>
</div>

@code {
    [CascadingParameter] public ScreenSize ScreenSize { get; set; }
}
