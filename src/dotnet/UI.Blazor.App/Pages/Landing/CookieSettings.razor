@inherits ComputedStateComponent<AppUIHub, CookieSettings.Model?>
@{
    if (State.IsInitial(out var m) || m is null)
        return;
    if (m.AreCookiesAccepted)
        return;
}

<div class="cookie-settings theme-dark @(_isExpanded ? "is-expanded" : "is-collapsed")">
    @if (_isExpanded) {
        <div class="c-head">
            <div class="c-icon"><i class="icon-cookie text-2xl"></i></div>
            <span class="c-title">@L.Cookie_Settings</span>
            <button type="button" class="c-collapse" @onclick="Collapse">
                <i class="icon-chevron-compact-down"></i>
            </button>
        </div>
        <p class="c-subtitle">@L.Cookie_SettingsSubtitle_Format(CoreConstants.AppName)</p>
        <div class="c-rows">
            <div class="c-row">
                <div class="c-row-text">
                    <div class="c-row-title">@L.Cookie_Necessary</div>
                    <div class="c-row-caption">@L.Cookie_NecessaryCaption</div>
                </div>
                <div class="c-row-control">
                    <span class="c-always">@L.Cookie_AlwaysOn</span>
                    <Toggle IsChecked="true" IsDisabled="true"/>
                </div>
            </div>
            <div class="c-row">
                <div class="c-row-text">
                    <div class="c-row-title">@L.Cookie_Analytics</div>
                    <div class="c-row-caption">@L.Cookie_AnalyticsCaption</div>
                </div>
                <Toggle IsChecked="_isDataCollectionEnabled" IsCheckedChanged="OnDataCollectionChanged"/>
            </div>
        </div>
        <div class="c-foot">
            <a class="c-link" href="/docs/cookies">
                <span class="c-link-wide">@L.Cookie_Policy</span>
                <span class="c-link-narrow">@L.Cookie_PolicyFull</span>
            </a>
            <div class="c-foot-buttons">
                <Button Class="btn-modal" IsDisabled="_isDataCollectionEnabled" Click="@OnAcceptSelectedClick">
                    @L.Cookie_AcceptSelected
                </Button>
                <Button Class="btn-primary" Click="@OnAllCookiesClick">@L.Cookie_AcceptAll</Button>
            </div>
        </div>
    } else {
        <div class="c-pill-main">
            <div class="c-icon"><i class="icon-cookie text-2xl"></i></div>
            <span class="c-text">
                @L.Cookie_PillText_Format(CoreConstants.AppName)
                <button type="button" class="c-learn" @onclick="Expand">@L.Cookie_LearnMore</button>
            </span>
        </div>
        <div class="c-pill-buttons">
            <Button Class="btn-modal" Click="@OnNecessaryOnlyClick">@L.Cookie_NecessaryOnly</Button>
            <Button Class="btn-primary" Click="@OnAllCookiesClick">@L.Cookie_AcceptAll</Button>
        </div>
    }
</div>

@code {
    private bool _isExpanded;
    private bool _isDataCollectionEnabled;

    private OnboardingUI OnboardingUI => Hub.OnboardingUI;
    private IDataCollectionSettingsUI DataCollectionSettingsUI => Hub.DataCollectionSettingsUI;

    protected override async Task<Model?> ComputeState(CancellationToken cancellationToken) {
        if (Hub.IsPrerendering)
            return null;

        await OnboardingUI.WhenLocalSettingsRead.ConfigureAwait(false);
        var settings = await OnboardingUI.LocalSettings.Use(cancellationToken).ConfigureAwait(false);
        return new(settings.AreCookiesAccepted);
    }

    private void Expand() {
        _isExpanded = true;
        StateHasChanged();
    }

    private void Collapse() {
        _isExpanded = false;
        StateHasChanged();
    }

    private void OnDataCollectionChanged(bool value) {
        _isDataCollectionEnabled = value;
        StateHasChanged();
    }

    private Task OnNecessaryOnlyClick()
        => AcceptCookies();

    private async Task OnAllCookiesClick() {
        await AcceptCookies().ConfigureAwait(false);
        await DataCollectionSettingsUI.UpdateState(true, CancellationToken.None);
    }

    private async Task OnAcceptSelectedClick() {
        await AcceptCookies().ConfigureAwait(false);
        await DataCollectionSettingsUI.UpdateState(_isDataCollectionEnabled, CancellationToken.None);
    }

    private async Task AcceptCookies() {
        var settings = await OnboardingUI.LocalSettings.Use(CancellationToken.None).ConfigureAwait(false);
        OnboardingUI.UpdateLocalSettings(settings with { AreCookiesAccepted = true });
    }

    // Nested types

    public sealed record Model(bool AreCookiesAccepted = false);
}
