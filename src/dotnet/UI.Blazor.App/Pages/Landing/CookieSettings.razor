@inherits ComputedStateComponent<CookieSettings.Model>
@{
    var m = State.LastNonErrorValue;
    if (ReferenceEquals(m, Model.Loading))
        return;

    if (m.AreCookiesAccepted)
        return;
}

<div class="cookie-settings">
    <div class="c-top">
        <div class="c-icon">
            <i class="icon-cookie text-2xl"></i>
        </div>
        <span class="c-text">Cookie Settings</span>

    </div>
    <div class="c-content">
        <p>
            Our website uses essential cookies to ensure accessibility, security, and to manage your website access.
            You can control these through your browser settings, though disabling them may affect the website’s functionality.
        </p>
        <p>
            With your consent, Actual Chat may also use cookies to personalize your experience, in line with our
            <a href="/docs/privacy">Privacy Policy</a> and <a href="/docs/terms">Terms of Use</a>.
            Additionally, we may use cookies to collect telemetry data, such as user actions leading up to errors and crashes.
            The data we capture via cookies may be processed by trusted third-party providers,
            such as <a href="https://marketingplatform.google.com/about/analytics/" target="_blank">Google Analytics</a>,
            <a href="https://firebase.google.com/docs/analytics" target="_blank">Firebase Analytics</a>,
            and <a href="https://sentry.io/" target="_blank">Sentry</a>.
        </p>
    </div>
    <div class="c-bottom">
        <a class="c-link" href="/docs/cookies">Read Cookie Policy</a>
        <div class="c-buttons">
            <Button Class="cookie-btn" Click="@OnNecessaryOnlyClick">Necessary cookies only</Button>
            <Button Class="cookie-btn" Click="@OnAllCookiesClick">Accept all cookies</Button>
        </div>
    </div>
</div>


@code {
    [Inject] private UIHub Hub { get; init; } = null!;
    private OnboardingUI OnboardingUI => (OnboardingUI)Hub.OnboardingUI;
    private IDataCollectionSettingsUI DataCollectionSettingsUI => Hub.DataCollectionSettingsUI;

    protected override ComputedState<Model>.Options GetStateOptions() {
        return new() {
            InitialValue = Model.Loading,
            Category = ComputedStateComponent.GetStateCategory(GetType()),
        };
    }

    protected override async Task<Model> ComputeState(CancellationToken cancellationToken) {
        if (Hub.IsPrerendering)
            return Model.Loading;

        await OnboardingUI.WhenLocalSettingsRead.ConfigureAwait(false);
        var settings = await OnboardingUI.LocalSettings.Use(cancellationToken).ConfigureAwait(false);
        return new(settings.AreCookiesAccepted);
    }

    private Task OnNecessaryOnlyClick()
        => AcceptCookies();

    private async Task OnAllCookiesClick() {
        await AcceptCookies().ConfigureAwait(false);
        await DataCollectionSettingsUI.UpdateState(true, CancellationToken.None);
    }

    private async Task AcceptCookies() {
        var settings = await OnboardingUI.LocalSettings.Use(CancellationToken.None).ConfigureAwait(false);
        OnboardingUI.UpdateLocalSettings(settings with { AreCookiesAccepted = true });
    }

    // Nested types

    public sealed record Model(bool AreCookiesAccepted = false) {
        public static Model Loading { get; } = new();
    }
}
