<div class="c-content">
    <div class="title-text">How @CoreConstants.AppName feels for your closest space</div>

    @* Row 1 *@
    <div class="c-row c-first">
        <LandingImageCard>
            <CardImage>
                <img draggable="false" src="/dist/images/landing/card-family-chats.svg" alt="">
                <div class="landing-page-noise">
                    <img draggable="false" src="/dist/images/landing/landing-page-noise-small.svg" alt="">
                </div>
                <div class="image-bg">
                    <img draggable="false" src="/dist/images/landing/card-family-chats-bg.svg" alt="">
                </div>
            </CardImage>
            <CardTitle>
                Family chats
            </CardTitle>
            <CardText>
                <LandingImageCardItem>
                    Share updates, coordinate, or just talk — even when you can’t listen.
                </LandingImageCardItem>
                <LandingImageCardItem>
                    Grandparents can read what you say.
                </LandingImageCardItem>
                <LandingImageCardItem>
                    Kids can replay what they missed.
                </LandingImageCardItem>
            </CardText>
        </LandingImageCard>
        <LandingImageCard>
            <CardImage>
                <img draggable="false" src="/dist/images/landing/card-classmate-chats.svg" alt="">
                <div class="landing-page-noise">
                    <img draggable="false" src="/dist/images/landing/landing-page-noise-small.svg" alt="">
                </div>
                <div class="image-bg">
                    <img draggable="false" src="/dist/images/landing/card-classmate-chats-bg.svg" alt="">
                </div>
            </CardImage>
            <CardTitle>
                Friends
            </CardTitle>
            <CardText>
                <LandingImageCardItem>
                    Send a voice message. Read it later. Catch up instantly.
                </LandingImageCardItem>
                <LandingImageCardItem>
                    No awkward calls. No unread message overload.
                </LandingImageCardItem>
            </CardText>
        </LandingImageCard>
        <LandingImageCard>
            <CardImage>
                <img draggable="false" src="/dist/images/landing/card-remote-team.svg" alt="">
                <div class="landing-page-noise">
                    <img draggable="false" src="/dist/images/landing/landing-page-noise-small.svg" alt="">
                </div>
                <div class="image-bg">
                    <img draggable="false" src="/dist/images/landing/card-remote-team-bg.svg" alt="">
                </div>
            </CardImage>
            <CardTitle>
                Remote Teams, Startups
            </CardTitle>
            <CardText>
                <LandingImageCardItem>
                    Make quick decisions with full context — without long meetings.
                </LandingImageCardItem>
                <LandingImageCardItem>
                    Speak up to 5x faster than typing, with clean transcripts saved automatically.
                </LandingImageCardItem>
                <LandingImageCardItem>
                    Boost employee happiness.
                </LandingImageCardItem>
            </CardText>
        </LandingImageCard>
    </div>
</div>
