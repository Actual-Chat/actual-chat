@namespace ActualChat.UI.Blazor.App.Pages
@page "/test/audio-blob-download"

<RequireAccount MustBeAdmin="true"/>
<MainHeader>Audio Blob Download Test Page</MainHeader>

<div class="test-page-wrapper">
<Form Model="@_form">
    <DataAnnotationsValidator/>
    <FormBlock>
        <FormSection For="() => _form.Input" Label="Chat entry link" IsLabelInsideInput="true" IsRequired="true">
            <ChildContent>
                <TextBox
                    @bind-Value="@_form.Input"
                    Placeholder="https://dev.voxt.ai/chat/<chatId>?n=<lid>"
                    ClearButton="true"/>
            </ChildContent>
            <ValidationMessage>
                @if (!string.IsNullOrEmpty(_status)) {
                    <div class="form-section-validation invalid">@_status</div>
                }
            </ValidationMessage>
        </FormSection>
    </FormBlock>



    <div class="flex-x gap-x-2 mb-3">
        <Button Class="btn-primary" Click="@OnResolveClick" IsDisabled="@_isBusy">Resolve</Button>
        @if (_resolved is { BlobId: var blobId } && !string.IsNullOrEmpty(blobId)) {
            <a class="btn btn-primary" href="@_downloadHref" download="@_downloadFileName">
                <span class="btn-content">Download .webm</span>
            </a>
        }
    </div>

    @if (_resolved is { } r) {
        <div class="flex-y gap-y-1 select-text">
            <div><b>ChatId:</b> @r.ChatId</div>
            <div><b>LocalId:</b> @r.LocalId</div>
            <div><b>EntryId:</b> @r.EntryId</div>
            <div><b>BlobId:</b> @r.BlobId</div>
            <div><b>MediaId:</b> @r.MediaId</div>
            <div><b>BeginsAt:</b> @r.BeginsAt</div>
            <div><b>EndsAt:</b> @r.EndsAt</div>
            <div><b>Duration:</b> @r.Duration</div>
            <div><b>IsStreaming:</b> @r.IsStreaming</div>
        </div>
    }
</Form>
</div>
