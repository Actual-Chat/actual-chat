@page "/settings/{SettingsOption}"
@page "/settings"
@using ActualChat.UI.Blazor.App.Components.Settings
@inherits ComponentBase<AppUIHub>

<div class="flex-x h-full">
    <ChatPanelSkeleton/>
    <RightPanelSkeleton/>
</div>

@code {
    [Parameter] public string? SettingsOption { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (!firstRender)
            return;

        var modalRef = await ModalUI.Show(SettingsModal.Model.Instance, ModalOptions.FullScreen);
        if ((SettingsOption ?? "").StartsWith("delete-account", StringComparison.OrdinalIgnoreCase))
            _ = ModalUI.Show(OwnAccountEditorModal.Model.Default);
        _ = NavigateToChatsWhen(modalRef.WhenClosed);
    }

    private async Task NavigateToChatsWhen(Task when) {
        await when;
        // Settings tab shortcuts (Notes, Test Pages, ...) navigate on close themselves - don't override them.
        await History.WhenNavigationCompletedOrTimeout();
        if (History.LocalUrl.Value.StartsWith("/settings"))
            _ = History.NavigateTo(Links.Chats, false, false, true);
    }
}
