@page "/u"
@page "/u/{PageRoute}"
@inherits ComponentBase<AppUIHub>

@code {
    private IAccounts Accounts => Hub.Accounts;
    private IAliases Aliases => Hub.Aliases;
    private ChatListUI ChatListUI => Hub.ChatListUI;

    [Parameter] public string? PageRoute { get; set; }

    protected override async Task OnParametersSetAsync() {
        var userId = await UserLinks.GetUserIdByRoute(Aliases, PageRoute, default);
        if (userId.IsGuestOrNull()) {
            _ = History.NavigateTo(Links.NotFound, true);
            return;
        }

        var ownAccount = await Accounts.GetOwn(Session, default);
        var account = await Accounts.Get(Session, userId, default);
        if (account == null || account.IsGuestOrNull()) {
            _ = History.NavigateTo(Links.NotFound, true);
            return;
        }

        if (ownAccount.Id == account.Id) { // Own account
            var url = Links.Chats;
            var notesChatInfo = ChatListUI.NotesChat.Value;
            if (notesChatInfo is not null)
                url = Links.Chat(notesChatInfo.Id);
            _ = History.NavigateTo(url, true);
            return;
        }

        var chatId = PeerChatId.New(ownAccount.Id, account.Id);
        _ = History.NavigateTo(Links.Chat(chatId), true);
    }
}
