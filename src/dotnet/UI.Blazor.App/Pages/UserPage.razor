@page "/u"
@page "/u/{PageRoute}"

@code {
    [Inject] private ChatUIHub Hub { get; init; } = null!;
    private Session Session => Hub.Session();
    private IAccounts Accounts => Hub.Accounts;
    private History History => Hub.History;
    private IUserLinks UserLinks => Hub.UserLinks;

    [Parameter] public string? PageRoute { get; set; }

    protected override async Task OnParametersSetAsync() {
        var userId = await GetUserIdFromPageRoute(PageRoute, default);
        if (userId.IsGuestOrNone) {
            _ = History.NavigateTo(Links.NotFound);
            return;
        }

        var ownAccount = await Accounts.GetOwn(Session, default);
        var account = await Accounts.Get(Session, userId, default);
        if (account == null || account.IsGuestOrNone) {
            _ = History.NavigateTo(Links.NotFound);
            return;
        }

        if (ownAccount.Id == account.Id) { // Own account
            _ = History.NavigateTo(Links.Chats);
            return;
        }

        var chatId = new PeerChatId(ownAccount.Id, account.Id);
        _ = History.NavigateTo(Links.Chat(chatId));
    }

    private async Task<UserId> GetUserIdFromPageRoute(string? pageRoute, CancellationToken cancellationToken) {
        if (pageRoute.IsNullOrEmpty())
            return UserId.None;

        if (!pageRoute.StartsWith(Links.UserLinkPrefix))
            return UserId.ParseOrNone(pageRoute);

        if (!UserLinkId.TryParse(pageRoute.Substring(1), out var userLinkId))
            return UserId.None;

        return await UserLinks.GetUserIdByUserLink(userLinkId, cancellationToken).ConfigureAwait(false);
    }
}
