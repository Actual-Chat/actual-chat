@using ActualChat.Chat
@using ActualChat.Flows
@inherits ComputedStateComponent<AppUIHub, FlowsTestPage.Model>
@page "/test/flows"

<RequireAccount MustBeAdmin="true"/>
<MainHeader>Flows Dashboard</MainHeader>

@{
    var details = State.Value.Details;
}
<div class="test-page-wrapper">
    <div class="flex-y h-full overflow-y-auto select-text p-4 gap-y-2">
        <div class="flex-x items-center gap-x-4">
            <Button Click="OnRefresh">Refresh</Button>
            <label class="flex-x items-center gap-x-1 cursor-pointer">
                <input type="checkbox" checked="@_problematicOnly" @onchange="OnToggleProblematic"/>
                <span>Problematic only</span>
            </label>
            @if (_stats is null) {
                <span class="text-gray-500">Loading…</span>
            }
            else if (_rows is not null) {
                <span class="text-gray-500 text-sm">@_rows.Length row(s)</span>
            }
        </div>

        @if (_stats is { } stats) {
            <h2 class="mt-3 text-lg font-semibold">Summary by flow type</h2>
            <p class="text-gray-500 text-sm">Counts per registered flow type. Click a row to filter the instances below.</p>
            <div class="shrink-0 max-h-80 overflow-y-auto border rounded">
                <table class="w-full border-collapse text-sm">
                    <thead>
                        <tr class="border-b text-gray-500 bg-white sticky top-0">
                            <th class="text-left p-2">Type</th>
                            <th class="text-right p-2 w-24">Total</th>
                            <th class="text-right p-2 w-24">Completed</th>
                            <th class="text-right p-2 w-24">Suspended</th>
                            <th class="text-right p-2 w-24">Idle/Stuck</th>
                            <th class="text-right p-2 w-24">Failed</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var t in stats) {
                        <tr class="border-b cursor-pointer hover:bg-gray-100 @(t.Name == _name ? "bg-blue-50" : "")"
                            @onclick="@(() => SelectType(t.Name == _name ? null : t.Name))">
                            <td class="p-2 font-medium">@t.Name</td>
                            <td class="text-right p-2 text-gray-500">@t.Total</td>
                            <td class="text-right p-2">@t.Completed</td>
                            <td class="text-right p-2">@t.Suspended</td>
                            <td class="text-right p-2 @(t.Stuck > 0 ? "text-amber-600 font-semibold" : "")">@(t.Idle + t.Stuck)</td>
                            <td class="text-right p-2 @(t.Failed > 0 ? "text-red-600 font-semibold" : "")">@t.Failed</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>

            <h2 class="mt-3 text-lg font-semibold">
                Flow instances@(_name.IsNullOrEmpty() ? "" : $" — {_name}")
            </h2>
            <p class="text-gray-500 text-sm">Click a row to view its console log and error.</p>
            <label class="flex-x items-center gap-x-1 cursor-pointer w-fit">
                <input type="checkbox" checked="@_hideCompleted" @onchange="OnToggleHideCompleted"/>
                <span>Hide completed</span>
            </label>
            @if (!ShowRows) {
                <p class="text-gray-500 text-sm italic">Select a flow type above, or check “Problematic only” to list instances.</p>
            }
            else {
            <div class="shrink-0 border rounded overflow-hidden">
            <table class="w-full border-collapse text-sm">
                <thead>
                    <tr class="border-b text-gray-500 bg-white sticky top-0">
                        <th class="text-left p-2 w-1/2">Id</th>
                        <th class="text-left p-2">Status</th>
                        <th class="text-left p-2">Updated</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var row in _rows ?? []) {
                    <tr class="border-b cursor-pointer hover:bg-gray-100" @onclick="@(() => ToggleRow(row.FlowId))">
                        <td class="p-2 font-mono break-all">@row.FlowId</td>
                        <td class="p-2"><span class="@StatusClass(row.Status)">@row.Status</span></td>
                        <td class="p-2 text-gray-500">@row.UpdatedAt.ToDateTime().ToString("yyyy-MM-dd HH:mm:ss")</td>
                    </tr>
                    @if (_expanded.Contains(row.FlowId)) {
                        <tr class="border-b bg-gray-50">
                            <td colspan="3" class="p-2">
                                @if (!details.TryGetValue(row.FlowId, out var d)) {
                                    <span class="text-gray-500">Loading…</span>
                                }
                                else if (d is null) {
                                    <span class="text-gray-500">No data.</span>
                                }
                                else {
                                    @if (!d.Error.IsNullOrEmpty()) {
                                        <div class="text-red-600 font-mono text-xs mb-2 whitespace-pre-wrap">@d.Error</div>
                                    }
                                    <pre class="font-mono text-xs whitespace-pre-wrap">@d.Console</pre>
                                }
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
            </div>
            }
        }
    </div>
</div>

@code {
    private bool _problematicOnly;
    private bool _hideCompleted = true;
    private string? _name;
    private FlowTypeStat[]? _stats;
    private FlowSummary[]? _rows;
    private int _rowsGen;
    private readonly HashSet<string> _expanded = new(StringComparer.Ordinal);

    private IDiagnostics Diagnostics => field ??= Hub.Services.GetRequiredService<IDiagnostics>();

    private bool ShowRows => !_name.IsNullOrEmpty() || _problematicOnly;

    protected override ComputedState<Model>.Options GetStateOptions()
        => ComputedStateComponent.GetStateOptions(GetType(),
            static t => new ComputedState<Model>.Options() {
                InitialValue = Model.Loading,
                Category = GetStateCategory(t),
            });

    protected override async Task OnInitializedAsync() {
        await base.OnInitializedAsync();
        await LoadStats();
        await LoadRows();
    }

    // Only GetFlowDetails is a compute method, so the State exists to keep expanded rows' console
    // logs live; stats and instances are plain polling snapshots loaded outside it.
    protected override async Task<Model> ComputeState(CancellationToken cancellationToken) {
        if (_expanded.Count == 0)
            return Model.Loading;

        var details = new Dictionary<string, FlowDetails?>(StringComparer.Ordinal);
        foreach (var flowId in _expanded)
            details[flowId] = await Diagnostics.GetFlowDetails(Session, flowId, cancellationToken).ConfigureAwait(false);
        return new Model { Details = details };
    }

    private async Task LoadStats() {
        _stats = await Diagnostics.GetFlowStats(Session, default);
        StateHasChanged();
    }

    private async Task LoadRows() {
        var gen = ++_rowsGen;
        var query = new FlowsQuery(_name, _problematicOnly, Limit: ShowRows ? 200 : 0, HideCompleted: _hideCompleted);
        var rows = await Diagnostics.GetFlows(Session, query, default);
        if (gen != _rowsGen)
            return; // A newer LoadRows superseded this one

        _rows = rows;
        StateHasChanged();
    }

    private void OnRefresh() {
        _ = LoadStats();
        _ = LoadRows();
    }

    private void OnToggleProblematic(ChangeEventArgs e) {
        _problematicOnly = e.Value is true;
        OnFilterChanged();
    }

    private void OnToggleHideCompleted(ChangeEventArgs e) {
        _hideCompleted = e.Value is true;
        OnFilterChanged();
    }

    private void SelectType(string? name) {
        _name = name;
        OnFilterChanged();
    }

    private void OnFilterChanged() {
        _expanded.Clear();
        _ = State.Recompute();
        _ = LoadRows();
    }

    private void ToggleRow(string flowId) {
        if (!_expanded.Add(flowId))
            _expanded.Remove(flowId);
        _ = State.Recompute();
    }

    private static string StatusClass(FlowStatus status)
        => status switch {
            FlowStatus.Failed => "text-red-600 font-semibold",
            FlowStatus.Stuck => "text-amber-600 font-semibold",
            _ => "text-gray-500",
        };

    // Nested types

    public sealed record Model {
        public static readonly Model Loading = new();

        // Console log / error of currently expanded flow instances, keyed by FlowId.
        public IReadOnlyDictionary<string, FlowDetails?> Details { get; init; }
            = new Dictionary<string, FlowDetails?>(StringComparer.Ordinal);
    }
}
