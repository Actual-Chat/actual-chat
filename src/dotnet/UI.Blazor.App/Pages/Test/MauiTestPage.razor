@page "/test/maui"
@using ActualChat.Hosting

<RequireAccount MustBeAdmin="true"/>
<h2>MAUI Test Page</h2>

<BackendStatusTest />
<ExternalImageTest />

<div>
    <Button Click="OnSimulateAppCrashClicked">Simulate App crash</Button>
    @if (Hub.HostInfo.AppKind == AppKind.Android) {
        <Button Click="OnSimulateActivityDestroyClicked">Simulate Activity Destroy</Button>
    }
</div>

@code {
    [Inject] private UIHub Hub { get; set; } = null!;

    private void OnSimulateAppCrashClicked()
        => Hub.Services.GetService<IMauiTestPageBackend>()?.SimulateAppCrash();

    private void OnSimulateActivityDestroyClicked()
        => Hub.Services.GetService<IMauiTestPageBackend>()?.SimulateActivityDestroy();

    public interface IMauiTestPageBackend {
        void SimulateAppCrash();
        void SimulateActivityDestroy();
    }
}
