@page "/chat"
@page "/chat/{*Route}"
@layout ListViewLayout
@using ActualChat.Hosting
@using RightPanel = ActualChat.UI.Blazor.App.Components.RightPanel
@inherits ComputedStateComponent<AppUIHub, ChatPage.Model?>
@{
    var m = Rendered = State.Value;
    if (_isVeryFirstLoad && !PanelsUI.Middle.IsVisible.Value)
        return;

    var account = m?.OwnAccount;
    var route = m?.Route;
    var chatId = route?.ChatId;
    var chatKey = chatId?.Value ?? "";
    var chatContext = m?.ChatContext;
    var footerModel = m?.FooterModel;
    Log.LogDebug("Rendered for #{ChatId}", chatId);
}

@if (chatContext is null && m is { CanSendJoinPlaceRequest: true, EnableIncompleteUI: true }) {
     <RenderIntoSlot Name="@LayoutSlots.MainLeftDrawer">
         <LeftPanel IsSkeletonWidePanel="@true">
             <WidePanelBottomContent>
                 <SendJoinPlaceRequestWidget/>
             </WidePanelBottomContent>
         </LeftPanel>
     </RenderIntoSlot>
}

<RenderIntoSlot Name="@LayoutSlots.MainHeader">
    @if (chatContext is not null) {
        <CascadingValue Value="@chatContext">
            <ChatHeader/>
        </CascadingValue>
    } else if (route?.ChatId is not null) {
        <CascadingValue Value="@chatContext">
            <ChatHeader NoChatTitle="@UnavailableChatTitle"/>
        </CascadingValue>
    } else {
        <ChatHeaderSkeleton/>
    }
</RenderIntoSlot>

<RenderIntoSlot Name="@LayoutSlots.MainFooter">
    <CascadingValue Value="@chatContext">
        <ChatFooter Model="@footerModel"/>
    </CascadingValue>
</RenderIntoSlot>

<RenderIntoStack Name="@LayoutSlots.SubHeader" Order="1000_000" Key="BannersSubHeader">
    <CascadingValue Value="@chatContext">
        <Banners/>
        @if (chatContext is not null) {
            <TranslationSubHeader/>
        }
    </CascadingValue>
</RenderIntoStack>

<RenderIntoSlot Name="@LayoutSlots.MainRightDrawer">
    <CascadingValue Value="@chatContext">
        <RightPanel/>
    </CascadingValue>
</RenderIntoSlot>

@if (m is null) {
    <chat-view-skeleton count="15" class="chat-view-skeleton-list no-scrollbar"/>
} else if (chatContext is not null) {
    <CascadingValue Value="@chatContext">
        <ChatView @key="@chatKey"/>
    </CascadingValue>
} else if (m is { CanSendJoinPlaceRequest: true, EnableIncompleteUI: true }) {
    <InaccessiblePlace ShowSignIn="@account.IsGuestOrNull()"/>
} else if (route?.ChatId is not null) {
    <ChatNotFound ShowSignIn="@account.IsGuestOrNull()"/>
} else {
    <NoChatSelected/>
}

@code {
    protected const string UnavailableChatTitle = "This chat is unavailable";

    protected static TimeSpan VeryFirstLoadDelay = TimeSpan.FromSeconds(1.5);
    protected static TimeSpan LoadTimeout = TimeSpan.FromSeconds(1);
    protected static TimeSpan LoadTimeoutToReloadDelay = TimeSpan.FromSeconds(2);
    private static bool _isVeryFirstLoad = true;

    private MutableState<RouteState> _routeState = null!;
    protected Model? Rendered;

    protected IChats Chats => Hub.Chats;
    protected IPlaces Places => Hub.Places;
    protected IAccounts Accounts => Hub.Accounts;
    protected IAvatars Avatars => Hub.Avatars;
    protected IAliases Aliases => Hub.Aliases;
    protected ChatUI ChatUI => Hub.ChatUI;
    protected ChatAudioUI ChatAudioUI => Hub.ChatAudioUI;
    protected LoadingUI LoadingUI => Hub.LoadingUI;
    protected BrowserInfo BrowserInfo => Hub.BrowserInfo;

    protected ILogger Log => field ??= Hub.LogFor(GetType());

    [Parameter] public string? Route { get; set; }

    protected override void OnInitialized() {
        ChatAudioUI.Enable();
        _routeState = StateFactory.NewMutable(RouteState.None);
    }

    protected override Task OnParametersSetAsync()
        => SetRoute(Route);

    protected override bool ShouldRender()
        => ReferenceEquals(Rendered, null)
           || State.HasError
           || State.Value != Rendered;

    protected override async Task<Model?> ComputeState(CancellationToken cancellationToken) {
        var lastState = State.ValueOrDefault;
        var hostInfo = HostInfo;
        var routeState = await _routeState.Use(cancellationToken).ConfigureAwait(false);
        var parsedRoute = routeState.Parsed;
        var fixedRoute = routeState.Fixed;
        if (fixedRoute is null)
            return lastState; // Synchronizing

        if (!ChatUI.WhenReady.IsCompleted)
            await ChatUI.WhenReady.WaitAsync(cancellationToken).ConfigureAwait(false);
        var chatId = await ChatUI.SelectedChatId.Use(cancellationToken).ConfigureAwait(false);

        if (chatId != fixedRoute.ChatId)
            return lastState; // Synchronizing

        if (_isVeryFirstLoad) {
            _isVeryFirstLoad = false;
            if (hostInfo.HostKind.IsApp()) {
                Log.LogInformation("Delaying display for chat #{ChatId}", chatId);
                var delayTask = Task.Delay(VeryFirstLoadDelay, cancellationToken);
                await Task.WhenAny(delayTask, LoadingUI.WhenChatListLoaded).ConfigureAwait(false);
            }
        }

        var account = await AccountUI.OwnAccount.Use(cancellationToken).ConfigureAwait(false);
        if (chatId is null)
            return Model.NewUnavailable(account, fixedRoute, false);

        var canSendJoinPlaceRequest = false;
        var enableIncompleteUITask = Features.IsIncompleteUIEnabled(cancellationToken);
        // Log.LogDebug("ComputeState(), ChatId: #{ChatId}", chatId);

        try {
#if false // NOTE(AY): Let's try to disable this for now, maybe it works better after rendering changes
            if (OSInfo.IsAndroid) {
                // Postponing chat change to let the left panel slide smoothly - don't change this delay!
                var isChatChange = !lastChatId.IsNone && chatId != lastChatId;
                if (isChatChange && PanelsUI.ScreenSize.Value.IsNarrow())
                    await Task.Delay(TimeSpan.FromSeconds(0.2), cancellationToken).ConfigureAwait(false);
            }
#endif

            var chat = await Chats
                .Get(Session, chatId, cancellationToken)
                .WaitAsync(LoadTimeout, cancellationToken)
                .ConfigureAwait(false);
            var chatContext = chat is not null
                ? new ChatContext(Hub, chat)
                : null;
            if (chat is null && chatId is PlaceChatId placeChatId) {
                var place = await Places.Get(Session, placeChatId.PlaceId, cancellationToken).ConfigureAwait(false);
                if (place is null) {
                    // Place does not exist or user is not member of the place.
                    // TODO: Check if user can request place invitation.
                    // Result should contain the following details:
                    //  - if it's possible to send request,
                    //  - if there is a pending request,
                    //  - last request was declined.
                    canSendJoinPlaceRequest = false;
                }
            }
            var footerModel = await GetFooterModel(chat, account, cancellationToken).ConfigureAwait(false);
            var enableIncompleteUI = await enableIncompleteUITask.ConfigureAwait(false);
            return new(account, fixedRoute, chatContext, footerModel, canSendJoinPlaceRequest, enableIncompleteUI);
        }
        catch (TimeoutException) {
            Computed.Current?.Invalidate(LoadTimeoutToReloadDelay);
            return lastState != null && chatId == lastState.Route.ChatId
                ? lastState
                : null;
        }
        catch (Exception e) when (e is not OperationCanceledException) {
            Log.LogWarning(e, "Failed to get Chat #{ChatId}", chatId);
            return Model.NewUnavailable(account, fixedRoute, false);
        }
    }

    protected async ValueTask<FooterModel> GetFooterModel(Chat? chat, Account account, CancellationToken cancellationToken) {
        var session = Session;
        if (chat?.Id is not { } chatId)
            return FooterModel.None;

        var canPost = chat.Rules.CanWrite();
        var canJoin = !canPost && chat.Rules.CanJoin();
        var shouldJoinPlaceFirst = false;
        Place? place = null;
        if (!canPost && chatId is PlaceChatId placeChatId) {
            shouldJoinPlaceFirst = chat.IsPublic;
            place = await Places.Get(session, placeChatId.PlaceId, cancellationToken).ConfigureAwait(false);
            if (place == null) {
                Log.LogWarning(
                    "Can't read Place #Id='{PlaceId}' while it should be possible to join to it",
                    placeChatId.PlaceId);
                canJoin = false;
            }
        }

        var otherUserId = chatId is PeerChatId peerChatId
            ? peerChatId.UserIds.OtherThan(account.Id)
            : null;
        var hasMultipleAvatars = false;
        var canJoinWithGuestAccount = false;
        var canJoinAnonymously = false;
        if (canJoin) {
            if (account.IsGuestOrNull()) {
                canJoinWithGuestAccount = chat.AllowGuestAuthors;
            } else {
                canJoinAnonymously = Features_EnableAnonymousChat.IsEnabled && chat.AllowAnonymousAuthors;
                var avatars = await Avatars
                    .ListOwnAvatarIds(session, cancellationToken)
                    .WaitAsync(LoadTimeout, cancellationToken)
                    .ConfigureAwait(false);
                hasMultipleAvatars = avatars.Count > 1;
            }
        }

        return new() {
            Place = place,
            PeerId = otherUserId,
            IsGuest = account.IsGuestOrNull(),
            CanPost = canPost,
            CanJoin = canJoin,
            ShouldJoinPlaceFirst = shouldJoinPlaceFirst,
            HasMultipleAvatars = hasMultipleAvatars,
            CanJoinWithGuestAccount = canJoinWithGuestAccount,
            CanJoinAnonymously = canJoinAnonymously,
        };
    }

    protected async Task SetRoute(string? route) {
        _routeState.Value = new RouteState(null, null);
        ChatId? chatId;

        RouteResult parsedRoute;
        if (route.IsNullOrEmpty())
            parsedRoute = RouteResult.Empty;
        else if (route.StartsWith(Links.AliasPrefix))
            parsedRoute = await ResolveAliasRoute(route);
        else {
            chatId = ChatId.TryParse(route);
            parsedRoute = chatId is not null
                ? new RouteResult(chatId)
                : RouteResult.Invalid;
        }

        chatId = parsedRoute.ChatId;
        if (parsedRoute == RouteResult.Empty) {
            if (!ChatUI.WhenReady.IsCompleted)
                await ChatUI.WhenReady;
            chatId = ChatUI.SelectedChatId.Value;
            if (chatId is null && ChatUI.SelectedPlaceId.Value is { } placeId) {
                // If the SelectedPlaceId is there, let's try to display its Welcome chat
                chatId = await Places.GetWelcomeChatId(Session, placeId, CancellationToken.None);
            }

            chatId ??= Constants.Chat.AnnouncementsChatId;
        }

        // A place's root chat isn't navigable — redirect to the place's welcome chat.
        if (chatId is PlaceChatId { IsRoot: true } rootChatId) {
            var welcomeChatId = await Places.GetWelcomeChatId(Session, rootChatId.PlaceId, CancellationToken.None);
            if (welcomeChatId is not null) {
                _routeState.Value = new RouteState(RouteResult.Redirect, RouteResult.Redirect);
                await Hub.History.NavigateTo(Links.Chat(welcomeChatId), true);
                return;
            }
        }

        var fixedRoute = chatId is null ? parsedRoute : new RouteResult(chatId);
        _routeState.Value = new RouteState(parsedRoute, fixedRoute);
        ChatUI.SelectChatOnNavigation(chatId);
    }

    protected async ValueTask<RouteResult> ResolveAliasRoute(string? route) {
        if (route.IsNullOrEmpty())
            return RouteResult.Empty;

        var parts = route[1..].Split("/");
        if (parts.Length is < 1 or > 2)
            return RouteResult.Invalid;

        ChatId targetChatId;
        if (parts.Length == 1) {
            // ChatId or alias
            var chatAliasSid = parts[0];
            if (!AliasId.TryParse(chatAliasSid, out var chatAliasId))
                return RouteResult.InvalidAlias;

            var aliasTarget = await Hub.Aliases.GetTarget(chatAliasId);
            if (aliasTarget is null || aliasTarget.Kind != AliasKind.Chat)
                return RouteResult.InvalidAlias;

            if (!ChatId.TryParse(aliasTarget.TargetId, out var chatId))
                return RouteResult.Invalid;

            targetChatId = chatId;
        } else {
            // If the page route consists of 2 parts, the first one should always be a PlaceId alias
            var placeAliasSid = parts[0];
            if (!AliasId.TryParse(placeAliasSid, out var placeAliasId))
                return RouteResult.InvalidAlias;

            var aliasTarget = await Hub.Aliases.GetTarget(placeAliasId);
            if (aliasTarget is null || aliasTarget.Kind != AliasKind.Place)
                return RouteResult.InvalidAlias;

            if (!PlaceId.TryParse(aliasTarget.TargetId, out var placeId))
                return RouteResult.Invalid;

            var chatSidPart = parts[1];
            if (chatSidPart.IsNullOrEmpty())
                return RouteResult.Invalid;

            PlaceChatId? placeChatId;
            if (!chatSidPart.StartsWith("@")) {
                if (!PlaceChatId.TryParse(chatSidPart, out var localChatId) || localChatId.Kind != ChatKind.Group)
                    return RouteResult.Invalid;
                if (!PlaceChatId.TryParse(PlaceChatId.Format(placeId, localChatId.Value), out var placeChatId1))
                    return RouteResult.Invalid;

                placeChatId = placeChatId1;
            } else {
                var chatAliasSid = chatSidPart[1..];
                if (!AliasId.TryParse(chatAliasSid, out var chatAliasId))
                    return RouteResult.InvalidAlias;

                placeChatId = await Hub.Aliases
                    .GetPlaceChatIdByAlias(placeId, chatAliasId)
                    .ConfigureAwait(false);
                if (placeChatId is null)
                    return RouteResult.InvalidAlias;
            }
            targetChatId = placeChatId;
        }

        await Hub.History.NavigateTo(Links.Chat(targetChatId), true);
        return RouteResult.Redirect;
    }

    // Nested types

    public sealed record Model(
        AccountFull OwnAccount,
        RouteResult Route,
        ChatContext? ChatContext,
        FooterModel FooterModel,
        bool CanSendJoinPlaceRequest,
        bool EnableIncompleteUI
    ) {
        public static Model NewUnavailable(AccountFull ownAccount, RouteResult route, bool canSendJoinPlaceRequest)
            => new(ownAccount, route, null, FooterModel.None, canSendJoinPlaceRequest, false);

        // This record relies on referential equality
        public bool Equals(Model? other) => ReferenceEquals(this, other);
        public override int GetHashCode() => RuntimeHelpers.GetHashCode(this);
    };

    [ParameterComparer(typeof(ByRefParameterComparer))]
    public sealed record FooterModel {
        public static readonly FooterModel None = new();

        public Place? Place { get; init; }
        public UserId? PeerId { get; init; }
        public bool IsGuest { get; init; }
        public bool HasMultipleAvatars { get; init; }
        public bool CanPost { get; init; }
        public bool CanJoin { get; init; }
        public bool CanJoinWithGuestAccount { get; init; }
        public bool CanJoinAnonymously { get; init; }
        public bool ShouldJoinPlaceFirst { get; init; }

        // This record relies on referential equality
        public bool Equals(FooterModel? other) => ReferenceEquals(this, other);
        public override int GetHashCode() => RuntimeHelpers.GetHashCode(this);
    }

    public sealed record RouteResult(ChatId? ChatId = null) {
        public static readonly RouteResult Empty = new();
        public static readonly RouteResult Invalid = new();
        public static readonly RouteResult InvalidAlias = new();
        public static readonly RouteResult Redirect = new();

        // This record relies on referential equality
        public bool Equals(RouteResult? other) => ReferenceEquals(this, other);
        public override int GetHashCode() => RuntimeHelpers.GetHashCode(this);
    }

    public record RouteState(RouteResult? Parsed, RouteResult? Fixed) {
        public static readonly RouteState None = new (null, null);
    }
}
