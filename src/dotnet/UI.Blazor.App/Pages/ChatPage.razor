@page "/chat"
@page "/chat/{*Route}"
@layout ListViewLayout
@using ActualChat.Hosting
@inherits ComputedStateComponent<ChatPage.Model>
@{
    var m = Rendered = State.Value;
    if (_isVeryFirstLoad && !PanelsUI.Middle.IsVisible.Value)
        return;

    var chat = m.Chat;
    var account = m.OwnAccount;
    var chatId = chat.Id.IsNone ? ChatId : chat.Id;
    var chatKey = chatId.Value;
    Log.LogDebug("Rendered for #{ChatId}", chatId);
}

@if (ReferenceEquals(chat, SpecialChat.Unavailable) && m is { CanSendJoinPlaceRequest: true, EnableIncompleteUI: true }) {
     <RenderIntoSlot Name="MainLeftDrawer">
         <LeftPanel IsSkeletonWidePanel="@true">
             <WidePanelBottomContent>
                 <SendJoinPlaceRequestWidget/>
             </WidePanelBottomContent>
         </LeftPanel>
     </RenderIntoSlot>
}

<RenderIntoSlot Name="MainHeader">
    @if (ReferenceEquals(chat, SpecialChat.Unavailable)) {
        <SkeletonChatHeader/>
    } else {
        <ChatHeader Chat="@chat"/>
    }
</RenderIntoSlot>

<RenderIntoSlot Name="MainFooter">
    <ChatFooter Chat="@chat" Model="m.FooterModel" />
</RenderIntoSlot>

<RenderIntoStack Name="SubHeader" Order="1000_000" Key="BannersSubHeader">
    <Banners Chat="@chat"/>
</RenderIntoStack>

<RenderIntoSlot Name="MainRightDrawer">
    <ChatRightPanel Chat="@chat"/>
</RenderIntoSlot>

@if (ReferenceEquals(chat, SpecialChat.NoChatSelected)) {
    <NoChatSelected/>
} else if (ReferenceEquals(chat, SpecialChat.Unavailable)) {
    if (m is { CanSendJoinPlaceRequest: true, EnableIncompleteUI: true }) {
        <InaccessiblePlace ShowSignIn="@(!account.IsActive())"/>
    } else {
        <ChatNotFound ShowSignIn="@(!account.IsActive())"/>
    }
}

<ChatView @key="@chatKey" ChatId="@chatId"/>

@code {
    protected static TimeSpan VeryFirstLoadDelay = TimeSpan.FromSeconds(1.5);
    protected static TimeSpan LoadTimeout = TimeSpan.FromSeconds(1);
    protected static TimeSpan LoadTimeoutToReloadDelay = TimeSpan.FromSeconds(2);
    private static bool _isVeryFirstLoad = true;

    protected Model? Rendered;
    protected PageRouteState RouteState = PageRouteState.Resolving;
    protected ChatId ChatId = ChatId.None;

    [Inject] protected ChatUIHub Hub { get; init; } = null!;
    protected Features Features => Hub.Features();
    protected Session Session => Hub.Session();
    protected HostInfo HostInfo => Hub.HostInfo();
    protected IChats Chats => Hub.Chats;
    protected IPlaces Places => Hub.Places;
    protected IAccounts Accounts => Hub.Accounts;
    protected IAvatars Avatars => Hub.Avatars;
    protected IUserLinks UserLinks => Hub.UserLinks;
    protected ChatUI ChatUI => Hub.ChatUI;
    protected ChatAudioUI ChatAudioUI => Hub.ChatAudioUI;
    protected AccountUI AccountUI => Hub.AccountUI;
    protected PanelsUI PanelsUI => Hub.PanelsUI;
    protected BrowserInfo BrowserInfo => Hub.BrowserInfo;
    protected UICommander UICommander => Hub.UICommander();

    [field: AllowNull, MaybeNull]
    protected ILogger Log => field ??= Hub.LogFor(GetType());

    [Parameter] public string? Route { get; set; }

    protected override void OnInitialized() {
        ChatAudioUI.Enable();
    }

    protected override void OnParametersSet() {
        RouteState = PageRouteState.Resolving;
        var pageRoute = Route;
        if (pageRoute.IsNullOrEmpty()) {
            RouteState = PageRouteState.ChatSid;
            _ = SelectChat(null);
            return;
        }

        if (pageRoute.StartsWith(Links.UserLinkPrefix))
            return;

        RouteState = PageRouteState.ChatSid;
        _ = ChatId.TryParse(pageRoute, out var chatId)
            ? SelectChat(chatId)
            : SelectChat(null);
    }

    protected override async Task OnParametersSetAsync() {
        var pageRoute = Route;
        if (RouteState != PageRouteState.Resolving)
            return;

        var result = await HandleUserLink(pageRoute, default).ConfigureAwait(false);
        if (ReferenceEquals(result, PageRoute.Redirect)) {
            RouteState = PageRouteState.Redirect;
            return;
        }

        if (ReferenceEquals(result, PageRoute.UnknownUserLink)) {
            RouteState = PageRouteState.UnknownUserLink;
            return;
        }

        RouteState = PageRouteState.ChatSid;
        await SelectChat(result.ChatId.IsNone ? null : result.ChatId);
    }

    protected override ComputedState<Model>.Options GetStateOptions()
        => new() {
            InitialValue = Model.Loading,
            Category = ComputedStateComponent.GetStateCategory(GetType()),
        };

    protected override async Task<Model> ComputeState(CancellationToken cancellationToken) {
        // We intentionally use ChatUI.SelectedChatId rather than ChatSid here,
        // coz OnSetParametersAsync anyway propagates ChatSid to SelectedChatId,
        // and moreover, we want to make sure ComputeState gets invalidated
        // specifically when SelectedChatId changes (vs when ChatSid changes).

        var hostInfo = HostInfo;
        var isEmptyPageRoute = Route.IsNullOrEmpty();

        var pageRouteState = RouteState;
        if (pageRouteState is PageRouteState.Redirect or PageRouteState.Resolving)
            return Model.Loading;

        if (pageRouteState == PageRouteState.UnknownUserLink)
            return Model.Unavailable(false);

        await ChatUI.WhenLoaded.WaitAsync(cancellationToken).ConfigureAwait(false);

        var chatId = await ChatUI.SelectedChatId.Use(cancellationToken).ConfigureAwait(false);
        ChatId = chatId;
        var lastState = State.ValueOrDefault;
        var lasChat = lastState?.Chat;
        var lastChatId = lasChat?.Id ?? ChatId.None;

        var canSendJoinPlaceRequest = false;
        var enableIncompleteUITask = Features.EnableIncompleteUI(cancellationToken);
        // Log.LogDebug("ComputeState(), ChatId: #{ChatId}", chatId);

        if (_isVeryFirstLoad) {
            _isVeryFirstLoad = false;
            var mustDelayVeryFirstLoad =
                hostInfo.HostKind.IsApp()
                && isEmptyPageRoute
                && BrowserInfo.ScreenSize.Value.IsNarrow();
            if (mustDelayVeryFirstLoad) {
                // Postpone chat loading when it's invisible
                Log.LogDebug("Delay loading for chat #{ChatId}", chatId);
                await Task.Delay(VeryFirstLoadDelay, cancellationToken).ConfigureAwait(false);
                this.NotifyStateHasChanged();
            }
        }

        try {
            if (!AccountUI.WhenLoaded.IsCompleted)
                await AccountUI.WhenLoaded.WaitAsync(LoadTimeout, cancellationToken).ConfigureAwait(false);
            var account = await AccountUI.OwnAccount.Use(cancellationToken).ConfigureAwait(false);
            var chat = SpecialChat.NoChatSelected;
            if (!chatId.IsNone) {
#if false // NOTE(AY): Let's try to disable this for now, maybe it works better after rendering changes
                if (OSInfo.IsAndroid) {
                    // Postponing chat change to let left panel slide smoothly - don't change this delay!
                    var isChatChange = !lastChatId.IsNone && chatId != lastChatId;
                    if (isChatChange && PanelsUI.ScreenSize.Value.IsNarrow())
                        await Task.Delay(TimeSpan.FromSeconds(0.2), cancellationToken).ConfigureAwait(false);
                }
#endif

                chat = await Chats
                    .Get(Session, chatId, cancellationToken)
                    .WaitAsync(LoadTimeout, cancellationToken)
                    .ConfigureAwait(false);
                if (chat is null && chatId.IsPlaceChat) {
                    var place = await Places.Get(Session, chatId.PlaceId, cancellationToken).ConfigureAwait(false);
                    if (place is null) {
                        // Place does not exist or user is not member of the place.
                        // TODO: Check if user can request place invitation.
                        // Result should contain the following details:
                        //  - if it's possible to send request,
                        //  - if there is a pending request,
                        //  - last request was declined.
                        canSendJoinPlaceRequest = false;
                    }
                }
                chat ??= SpecialChat.Unavailable;
            }
            var footerModel = await GetFooterModel(chat, account, cancellationToken).ConfigureAwait(false);
            var enableIncompleteUI = await enableIncompleteUITask.ConfigureAwait(false);
            return new(chat, account, footerModel, canSendJoinPlaceRequest, enableIncompleteUI);
        }
        catch (TimeoutException) {
            Computed.Current?.Invalidate(LoadTimeoutToReloadDelay);
            this.NotifyStateHasChanged();
            return lastState != null && chatId == lastChatId
                ? lastState
                : Model.Loading;
        }
        catch (Exception e) when (e is not OperationCanceledException) {
            Log.LogWarning(e, "Failed to get Chat #{ChatId}", chatId);
            this.NotifyStateHasChanged();
            return Model.Unavailable(false);
        }
    }

    protected async ValueTask<FooterModel> GetFooterModel(Chat chat, Account account, CancellationToken cancellationToken) {
        var chatId = chat.Id;
        var session = Session;
        if (chatId.IsNone)
            return FooterModel.None;

        var otherUserId = chatId.IsPeerChat(out var peerChatId)
            ? peerChatId.UserIds.OtherThan(account.Id)
            : default;
        var canPost = chat.Rules.CanWrite();
        var canJoin = !canPost && chat.Rules.CanJoin();
        var shouldJoinPlaceFirst = false;
        Place? place = null;
        if (!canPost && chatId.IsPlaceChat) {
            shouldJoinPlaceFirst = chat.IsPublic;
            place = await Places.Get(session, chatId.PlaceId, cancellationToken).ConfigureAwait(false);
            if (place == null) {
                Log.LogWarning("Can't read Place #Id='{PlaceId}' while it should be possible to join to it", chatId.PlaceId);
                canJoin = false;
            }
        }
        var hasMultipleAvatars = false;
        var canJoinWithGuestAccount = false;
        var canJoinAnonymously = false;
        if (canJoin) {
            if (account.IsGuestOrNone) {
                canJoinWithGuestAccount = chat.AllowGuestAuthors;
            } else {
                canJoinAnonymously = chat.AllowAnonymousAuthors;
                var avatars = await Avatars
                    .ListOwnAvatarIds(session, cancellationToken)
                    .WaitAsync(LoadTimeout, cancellationToken)
                    .ConfigureAwait(false);
                hasMultipleAvatars = avatars.Count > 1;
            }
        }

        return new() {
            OtherUserId = otherUserId,
            IsGuest = account.IsGuestOrNone,
            CanPost = canPost,
            CanJoin = canJoin,
            ShouldJoinPlaceFirst = shouldJoinPlaceFirst,
            HasMultipleAvatars = hasMultipleAvatars,
            CanJoinWithGuestAccount = canJoinWithGuestAccount,
            CanJoinAnonymously = canJoinAnonymously,
            Place = place,
        };
    }

    protected override bool ShouldRender()
        => ReferenceEquals(Rendered, null)
            || State.HasError
            || State.Value != Rendered;

    protected async ValueTask SelectChat(ChatId? chatId1) {
        ChatId chatId;
        if (chatId1.HasValue && !chatId1.Value.IsNone)
            chatId = chatId1.Value;
        else {
            await ChatUI.WhenLoaded;
            chatId = ChatUI.SelectedChatId.Value;
            // If Selected place is defined and chat id is not specified, then apparently place has no chats,
            // and we want to display a blank chat screen. Do not show Announcements chat.
            if (chatId.IsNone && Hub.ChatUI.SelectedPlaceId.Value.IsNone)
                chatId = Constants.Chat.AnnouncementsChatId;
        }

        ChatId = chatId;
        ChatUI.SelectChatOnNavigation(chatId);
    }

    private async Task<PageRoute> HandleUserLink(string? pageRoute, CancellationToken cancellationToken) {
        if (pageRoute.IsNullOrEmpty())
            return PageRoute.Empty;

        var parts = pageRoute[1..].Split("/");
        if (parts.Length is < 1 or > 2)
            return PageRoute.InvalidRoute;

        ChatId targetChatId;
        if (parts.Length == 1) {
            // Chat user link
            var sChatUserLink = parts[0];
            if (!UserLinkId.TryParse(sChatUserLink, out var chatUserLinkId))
                return PageRoute.UnknownUserLink;

            var userLinkRef = await Hub.UserLinks.GetUserLinkRef(chatUserLinkId.ToLower(), cancellationToken);
            if (userLinkRef.IsNone || userLinkRef.Kind != UserLinkKind.Chat)
                return PageRoute.UnknownUserLink;

            if (!ChatId.TryParse(userLinkRef.TargetId, out var chatId))
                return PageRoute.InvalidRoute;

            targetChatId = chatId;
        } else {
            // If page route consists of 2 parts. The first one should always be a place user link id.
            var sPlaceUserLink = parts[0];
            if (!UserLinkId.TryParse(sPlaceUserLink, out var placeUserLinkId))
                return PageRoute.UnknownUserLink;

            var userLinkRef = await Hub.UserLinks.GetUserLinkRef(placeUserLinkId.ToLower(), cancellationToken);
            if (userLinkRef.IsNone || userLinkRef.Kind != UserLinkKind.Place)
                return PageRoute.UnknownUserLink;

            if (!PlaceId.TryParse(userLinkRef.TargetId, out var placeId))
                return PageRoute.InvalidRoute;

            var chatIdPart = parts[1];
            if (chatIdPart.IsNullOrEmpty())
                return PageRoute.InvalidRoute;

            ChatId placeChatId;
            if (!chatIdPart.StartsWith("@")) {
                if (!ChatId.TryParse(chatIdPart, out var localChatId) || localChatId.Kind != ChatKind.Group)
                    return PageRoute.InvalidRoute;

                if (!PlaceChatId.TryParse(PlaceChatId.Format(placeId, localChatId.Value), out var placeChatId1))
                    return PageRoute.InvalidRoute;
                placeChatId = placeChatId1;
            } else {
                var sChatUserLink = chatIdPart[1..];
                if (!UserLinkId.TryParse(sChatUserLink, out var chatUserLinkId))
                    return PageRoute.UnknownUserLink;

                placeChatId = await Hub.UserLinks.GetPlaceChatIdByUserLink(placeId, chatUserLinkId.ToLower(), cancellationToken).ConfigureAwait(false);
                if (placeChatId.IsNone)
                    return PageRoute.UnknownUserLink;
            }
            targetChatId = placeChatId;
        }

        await Hub.History.NavigateTo(Links.Chat(targetChatId), true);
        return PageRoute.Redirect;
    }

    // Nested types

    public sealed record Model(
        Chat Chat,
        AccountFull OwnAccount,
        FooterModel FooterModel,
        bool CanSendJoinPlaceRequest,
        bool EnableIncompleteUI
    ) {
        public static Model Loading { get; } = new(SpecialChat.Loading, AccountFull.Loading, FooterModel.None, false, false);

        public static Model Unavailable(bool canSendJoinPlaceRequest)
            => new(SpecialChat.Unavailable, AccountFull.None, new (), canSendJoinPlaceRequest, false);
    }

    public sealed record FooterModel {
        public static readonly FooterModel None = new();

        public UserId OtherUserId { get; init; }
        public bool IsGuest { get; init; }
        public bool CanPost { get; init; }
        public bool CanJoin { get; init; }
        public bool HasMultipleAvatars { get; init; }
        public bool CanJoinWithGuestAccount { get; init; }
        public bool CanJoinAnonymously { get; init; }
        public bool ShouldJoinPlaceFirst { get; init; }
        public Place? Place { get; init; }
    }

    public enum PageRouteState { Resolving, ChatSid, UnknownUserLink, Redirect }

    public record PageRoute(ChatId ChatId) {
        public static readonly PageRoute Empty = new (ChatId.None);
        public static readonly PageRoute InvalidRoute = new (ChatId.None);
        public static readonly PageRoute UnknownUserLink = new (ChatId.None);
        public static readonly PageRoute Redirect = new (ChatId.None);
    }
}
