@namespace ActualChat.UI.Blazor.App.Components
@using ActualChat.UI.Blazor.Components.SideNav
@inherits ComputedStateComponent<bool>

@{
    var showSkeletonsOnly = Chat.Id.IsNone;
    var isOpen = State.LastNonErrorValue;
    // Log.LogDebug("RightPanel IsOpen={IsOpen}", isOpen);
}

@if (showSkeletonsOnly && isOpen) {
    <SkeletonRightPanel/>
    return;
}

<SideNav
    Side="SideNavSide.Right"
    IsOpen="@isOpen"
    VisibilityChanged="@(NoStateHasChanged.EventCallback<bool>(b => PanelsUI.Right.SetIsVisible(b)))">
    <ChatRightPanelContent Chat="@Chat" />
</SideNav>

@code {
    [Inject] private ChatUIHub Hub { get; init; } = null!;
    private PanelsUI PanelsUI => Hub.PanelsUI;
    private ILogger Log => Hub.LogFor<ChatRightPanel>();

    [ParameterComparer(typeof(ByRefParameterComparer))]
    [Parameter, EditorRequired] public Chat Chat { get; set; } = null!;

    protected override ComputedState<bool>.Options GetStateOptions()
        => ComputedStateComponent.GetStateOptions(GetType(),
            t => new ComputedState<bool>.Options {
                InitialValue = PanelsUI.Right.IsVisible.Value,
                UpdateDelayer = FixedDelayer.NextTick,
                Category = GetStateCategory(t),
            });

    protected override Task<bool> ComputeState(CancellationToken cancellationToken)
        => PanelsUI.Right.IsVisible.Use(cancellationToken);
}
