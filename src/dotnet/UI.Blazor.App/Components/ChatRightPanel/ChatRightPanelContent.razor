@namespace ActualChat.UI.Blazor.App.Components
@inherits ComputedStateComponent<AppUIHub, ChatRightPanelContent.Model>
@{
    var m = State.Value;
}

<div class="right-chat-panel">
    <ErrorBarrier Name="RightPanelContent" Kind="@ErrorBarrierKind.Full">
        @if (m.ShowSearchPanel) {
            <AISearchPanel Chat="@Chat"/>
        }
        <RightPanelHeader Chat="@Chat" />
        <div class="c-panel-content">
            <RightPanelChatInfo Chat="@Chat"/>
            <div class="c-panel-tabs">
                @if (m.ShowTabs) {
                    <TabPanel
                        @key="@Chat.Id.Value"
                        TabsClass="left-panel-tabs wide-left-panel-tabs"
                        BottomHill="true">

                        @if (m.ShowMembersTab) {
                            <Tab @key="@("members")" Id="members" Title="Members" Order="0">
                                <AuthorList ChatId="@Chat.Id"/>
                            </Tab>
                        }
                        @if (m.ShowThreads) {
                            <Tab @key="@("threads")" Id="threads" Title="Threads" Order="1">
                                <ThreadList ChatId="@Chat.Id"/>
                            </Tab>
                        }
                        @if (m.EnableIncompleteUI) {
                            <Tab @key="@("media")" Id="media" Title="Media" Order="3">
                                <ToBeDone/>
                            </Tab>
                            <Tab @key="@("files")" Id="files" Title="Files" Order="6">
                                <ToBeDone/>
                            </Tab>
                            <Tab @key="@("links")" Id="links" Title="Links" Order="9">
                                <ToBeDone/>
                            </Tab>
                        }
                    </TabPanel>
                }
            </div>
        </div>
    </ErrorBarrier>
</div>

@code {
    private IChats Chats => Hub.Chats;

    [ParameterComparer(typeof(ByRefParameterComparer))]
    [Parameter, EditorRequired] public Chat Chat { get; set; } = null!;

    protected override ComputedState<Model>.Options GetStateOptions()
        => ComputedStateComponent.GetStateOptions(GetType(),
            static t => new ComputedState<Model>.Options() {
                InitialValue = Model.Loading,
                UpdateDelayer = FixedDelayer.NextTick,
                Category = GetStateCategory(t),
            });

    protected override async Task<Model> ComputeState(CancellationToken cancellationToken) {
        var chat = Chat;
        var chatId = chat.Id;
        var enableIncompleteUI = await Features.IsIncompleteUIEnabled(cancellationToken).ConfigureAwait(false);
        var rules = await Chats.GetRules(Session, chatId, cancellationToken).ConfigureAwait(false);
        // Disable 'members' tab for the announcements chat
        var showMemberTab = chat.Id != Constants.Chat.AnnouncementsChatId && rules.CanSeeMembers() && !chat.IsAiSearchChat();
        var showSearchPanel = await PanelsUI.Right.IsSearchMode.Use(cancellationToken).ConfigureAwait(false);

        return new () {
            EnableIncompleteUI = enableIncompleteUI,
            ShowMembersTab = showMemberTab,
            ShowThreads = chatId.Kind is ChatKind.Group or ChatKind.Place,
            ShowSearchPanel = showSearchPanel && enableIncompleteUI,
        };
    }

    // Nested types

    public sealed record Model {
        public static Model Loading = new();

        public bool EnableIncompleteUI { get; init; }
        public bool ShowTabs => ShowMembersTab || EnableIncompleteUI || ShowThreads;
        public bool ShowMembersTab { get; init; }
        public bool ShowThreads { get; init; }
        public bool ShowSearchPanel { get; init; }
    }
}
