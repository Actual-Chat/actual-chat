@page "/chat-roulette"
@layout ListViewLayout
@using ActualChat.Roulette
@inherits ComputedStateComponent<ChatUIHub, ChatRoulettePage.Model>
@{
    var m = State.Value;
    var isRightPanelVisible = m.IsRightPanelVisible;
}

<RenderIntoSlot Name="@LayoutSlots.MainHeader">
    <ChatRouletteHeader
        IsRightPanelButtonVisible="@isRightPanelVisible"
        OnHeaderClick="@(() => OnToggleRightPanelClick())"
        OnBackButtonClick="@(() => OnOpenLeftPanelClick())"/>
</RenderIntoSlot>

<RenderIntoSlot Name="@LayoutSlots.MainFooter">
    <ChatRouletteFooter
        Profile="@m.SelectedProfile"
        OnOptionsClick="@(() => OnToggleRightPanelClick())"/>
</RenderIntoSlot>

<RenderIntoSlot Name="@LayoutSlots.MainRightDrawer">
    <ChatRouletteRightPanel/>
</RenderIntoSlot>

<ChatRouletteCenter/>

@code {
    private Task _whenRenewed = null!;

    private RouletteUI RouletteUI => Hub.RouletteUI;

    protected override void OnInitialized()
        => _whenRenewed = RouletteUI.ReviewState();

    protected override ComputedState<Model>.Options GetStateOptions()
        => ComputedStateComponent.GetStateOptions(GetType(),
            t => new ComputedState<Model>.Options() {
                UpdateDelayer = FixedDelayer.NextTick,
                Category = GetStateCategory(t),
            });

    protected override async Task<Model> ComputeState(CancellationToken cancellationToken) {
        await _whenRenewed.ConfigureAwait(false);
        var isRightPanelVisible = await PanelsUI.Right.IsVisible.Use(cancellationToken);
        var profile = await RouletteUI.SelectedProfile.Use(cancellationToken).ConfigureAwait(false);
        return new Model {
            IsRightPanelVisible = isRightPanelVisible,
            SelectedProfile = profile,
        };
    }

    private void OnToggleRightPanelClick()
        => PanelsUI.Right.Toggle();

    private void OnOpenLeftPanelClick()
        => PanelsUI.Left.SetIsVisible(true);

    // Nested types

    public sealed record Model {
        public bool IsRightPanelVisible { get; init; }
        public Profile? SelectedProfile { get; init; }
    }
}
