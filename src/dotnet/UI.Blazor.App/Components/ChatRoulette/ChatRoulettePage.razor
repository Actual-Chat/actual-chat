@inherits ComputedStateComponent<bool>
@{
    var isRightPanelVisible = State.Value;
}

<RenderIntoSlot Name="MainHeader">
    <ChatRouletteHeader
        IsRightPanelButtonVisible="@isRightPanelVisible"
        OnHeaderClick="@(() => OnToggleRightPanelClick())"
        OnBackButtonClick="@(() => OnOpenLeftPanelClick())"/>
</RenderIntoSlot>

<RenderIntoSlot Name="MainFooter">
    <div class="cr-footer">
        <ButtonRound
            Class="post-panel-btn btn-transparent btn-xxs mobile"
            Click="@OnToggleRightPanelClick">
            <i class="icon-options-2 text-2xl"></i>
        </ButtonRound>
        <span class="c-filter mobile">Filters</span>

        @* Absolute elements *@
        <div class="rounded-sub-footer"></div>
        <div class="c-center">
            <div class="c-profile-container desktop" @onclick=@OnProfileClick>
                <span class="c-profile-incut"></span>
                <span>George Black</span>
            </div>
            <div class="refresh-wrapper">
                <ButtonRound
                    Class="cr-refresh-btn"
                    Tooltip="Refresh"
                    TooltipPosition="FloatingPosition.Top"
                    Click="OnToggleRightPanelClick">
                    <div class="c-content">
                        <i class="icon-refresh c-icon"></i>
                        <span class="c-text">Refresh</span>
                    </div>
                </ButtonRound>
            </div>
        </div>
        <div class="c-incut"></div>
        <div class="c-profile mobile" @onclick="@OnProfileClick">
            <span>Profile</span>
            <span class="c-profile-incut"></span>
        </div>
    </div>
</RenderIntoSlot>

<RenderIntoSlot Name="MainRightDrawer">
    <ChatRouletteRightPanel/>
</RenderIntoSlot>

<ChatRouletteCenter/>

@code {
    [Inject] private UIHub Hub { get; init; } = null!;

    private PanelsUI PanelsUI => Hub.PanelsUI;
    private ModalUI ModalUI => Hub.ModalUI;

    protected override ComputedState<bool>.Options GetStateOptions()
        => ComputedStateComponent.GetStateOptions(GetType(),
            t => new ComputedState<bool>.Options() {
                InitialValue = PanelsUI.Right.IsVisible.Value,
                UpdateDelayer = FixedDelayer.NextTick,
                Category = ComputedStateComponent.GetStateCategory(t),
            });

    protected override Task<bool> ComputeState(CancellationToken cancellationToken)
        => PanelsUI.Right.IsVisible.Use(cancellationToken).AsTask();

    private void OnToggleRightPanelClick()
        => PanelsUI.Right.Toggle();

    private void OnOpenLeftPanelClick()
        => PanelsUI.Left.SetIsVisible(true);

    private void OnProfileClick()
        => ModalUI.Show(new ChatRouletteProfileModal.Model());
}
