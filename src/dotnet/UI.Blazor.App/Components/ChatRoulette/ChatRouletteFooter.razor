@using ActualChat.Roulette
@inherits ComponentBase<ChatUIHub>

<div class="cr-footer">
    <ButtonRound
        Class="post-panel-btn btn-transparent btn-xxs mobile"
        Click="@OnOptionsClick">
        <i class="icon-options-2 text-2xl"></i>
    </ButtonRound>
    <span class="c-filter mobile">Filters</span>

    @* Absolute elements *@
    <div class="rounded-sub-footer"></div>
    <div class="c-center">
        <div class="c-profile-container desktop" @onclick=@OnProfileClick>
            <AvatarCircle Avatar="@Profile.Avatar" />
            <span class="c-name">@Profile.Avatar.Name</span>
        </div>
        <div class="refresh-wrapper">
            <ButtonRound
                Class="cr-refresh-btn"
                Tooltip="Refresh"
                TooltipPosition="FloatingPosition.Top"
                Click="OnRefreshClick">
                <div class="c-content">
                    <i class="icon-refresh c-icon"></i>
                    <span class="c-text">Refresh</span>
                </div>
            </ButtonRound>
        </div>
    </div>
    <div class="c-incut"></div>
    <div class="c-profile mobile" @onclick="@OnProfileClick">
        <span>Profile</span>
        <AvatarCircle Avatar="@Profile.Avatar"  />
    </div>
</div>

@code {
    private RouletteUI RouletteUI => Hub.RouletteUI;

    [Parameter, EditorRequired] public Profile Profile { get; set; } = null!;
    [Parameter] public EventCallback OnOptionsClick { get; set; }

    private void OnRefreshClick()
        => _ = RouletteUI.UpdateSearchResult();

    private void OnProfileClick()
        => ModalUI.Show(new ChatRouletteProfileModal.Model());
}
