@using ActualChat.Roulette
@namespace ActualChat.UI.Blazor.Components

<ChatRouletteItem Profile="Profile" HighlightMatchWithProfile="@HighlightMatchWithProfile" Click="@StartChatClick">
    <ActionsTemplate>
        <div
            class="c-start-chat"
            data-tooltip="Start chat"
            data-tooltip-position="@(FloatingPosition.Top.ToPositionString())">
            <i class="icon-message-ellipse text-xl"></i>
        </div>
    </ActionsTemplate>
</ChatRouletteItem>

@code {
    [Parameter] public Profile Profile { get; set; } = null!;
    [Parameter] public Profile? HighlightMatchWithProfile { get; set; }
    [Parameter] public EventCallback StartChatClick { get; set; }
}
