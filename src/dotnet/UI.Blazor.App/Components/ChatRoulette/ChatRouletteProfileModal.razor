@namespace ActualChat.UI.Blazor.Components
@implements IModalView<ChatRouletteProfileModal.Model>

<DialogFrame
    Class="cr-choose-avatar-modal"
    Title="Choose avatar"
    HasCloseButton="true"
    NarrowViewSettings="DialogFrameNarrowViewSettings.Stretch">
    <Body>
    <ChatRouletteProfileModalContent/>
    </Body>
    <Buttons>
        <Button Class="cr-cancel">Cancel</Button>
        <Button Class="cr-apply">Apply</Button>
    </Buttons>
</DialogFrame>

@code {
    [CascadingParameter] public Modal Modal { get; set; } = null!;
    [Parameter] public Model ModalModel { get; set; } = null!;

    public sealed record Model;
}
