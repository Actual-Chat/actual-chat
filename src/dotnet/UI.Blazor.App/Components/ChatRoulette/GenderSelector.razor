@using ActualChat.Roulette
@namespace ActualChat.UI.Blazor.App.Components

<div class="gender-selector cr-badge-selector c-content">
    @foreach (var gender in AllGenders) {
        var isSelected = gender == Gender;
        var onclickHandler = !isSelected ? EventCallback.Factory.Create(this, () => Select(gender)) : default;
        var cls = isSelected ? "selected" : "clickable";
        <div class="cr-badge profile-badge @cls" @onclick="@onclickHandler">@GetTitle(gender)</div>
    }
</div>

@code {
    private static readonly Gender[] AllGenders = [Gender.NotSpecified, Gender.Male, Gender.Female, Gender.Other];

    [Parameter] public Gender Gender { get; set; } = Gender.NotSpecified;
    [Parameter] public EventCallback<Gender> GenderChanged { get; set; }

    private static string GetTitle(Gender gender) =>
        gender switch {
            Gender.NotSpecified => "Not Specified",
            Gender.Male => "Male",
            Gender.Female => "Female",
            Gender.Other => "Other",
            _ => "Unknown"
        };

    private Task Select(Gender gender)
        => GenderChanged.InvokeAsync(gender);
}
