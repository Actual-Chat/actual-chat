@namespace ActualChat.UI.Blazor.Components
@using ActualChat.Roulette
@inherits ComputedStateComponent<ChatRouletteCenter.Model?>
@{
    var m = State.Value;
    if (m is null)
        return;

    var candidates = m.ChatCandidates;
    var profile = m.OwnProfile;
}

<div class="cr-center">
    @if (m.SearchState == SearchState.Completed) {
        @if (candidates.Count == 0) {
            <div class="cr-main-title">No people found to chat. Try to change filter criteria.</div>
        } else {
            <div class="cr-main-title">Here are some people ready to chat:</div>
            @foreach (var candidate in candidates) {
                <ChatRouletteCandidate
                    Profile="@candidate.Profile"
                    HighlightMatchWithProfile="@profile"
                    StartChatClick="@(() => OnStartChatClick(profile, candidate.Profile))"/>
            }
        }
    }
    else if (m.SearchState == SearchState.Started) {
        <div class="cr-main-title">Search is in progress...</div>
    } else {
        @if (profile is null || profile.Preferences.Preferences.IsEmpty) {
            <div class="cr-main-title">Select and fill in chat roulette profile or create a new one.</div>
        } else if (!m.SearchCriteria.IsSufficientForFiltering) {
            <div class="cr-main-title">Check search filter.</div>
        } else {
            <div class="cr-main-title">Ready to talk? Push Start!</div>
        }
    }

</div>

@code {
    [Inject] ChatUIHub Hub { get; init; } = null!;
    private RouletteUI RouletteUI => Hub.RouletteUI;

    protected override async Task<Model?> ComputeState(CancellationToken cancellationToken) {
        var selectedProfile = await RouletteUI.SelectedProfile.Use(cancellationToken).ConfigureAwait(false);
        var searchCriteria = await RouletteUI.SearchCriteria.Use(cancellationToken).ConfigureAwait(false);
        var search = await RouletteUI.ActiveSearch.Use(cancellationToken).ConfigureAwait(false);
        if (search is not null) {
            return new Model {
                SearchState = search.IsCompleted ? SearchState.Completed : SearchState.Started,
                ChatCandidates = search.Results,
                SearchCriteria = search.Request.Criteria,
                OwnProfile = selectedProfile,
            };
        }

        return new Model {
            OwnProfile = selectedProfile,
            SearchCriteria = searchCriteria
        };
    }

    private void OnStartChatClick(Profile ownProfile, Profile peerProfile)
        => _ = RouletteUI.StartChat(ownProfile.Id, peerProfile.Id);

    // Nested types

    public enum SearchState { None, Started, Completed }

    public sealed record Model {
        public required Profile OwnProfile { get; init; }
        public SearchState SearchState { get; init; } = SearchState.None;
        public Preferences SearchCriteria { get; init; } = Preferences.Empty;
        public IReadOnlyList<ChatCandidate> ChatCandidates { get; init; } = [];

        // This record relies on referential equality
        public bool Equals(Model? other) => ReferenceEquals(this, other);
        public override int GetHashCode() => RuntimeHelpers.GetHashCode(this);
    }
}
