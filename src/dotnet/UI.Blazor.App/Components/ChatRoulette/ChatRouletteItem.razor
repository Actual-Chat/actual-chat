@using ActualChat.Roulette
@namespace ActualChat.UI.Blazor.Components
@{
    var avatar = Profile.Avatar;
    var preferences = Profile.Preferences.Preferences;
    var country = preferences.Country;
    var countryName = country.Title.NullIfEmpty() ?? "---";
    var languages = string.Join(", ", preferences.Languages.Select(c => c.Title)).NullIfEmpty() ?? "---";
}

<div class="cr-item">
    <div class="c-top">
        <AvatarCircle
            Avatar="@avatar"
            Size="@SquareSize.Size10"/>
        <div class="c-description">
            <span class="c-name">@avatar.Name</span>
            <span class="c-bio">@avatar.Bio</span>
        </div>
        <div class="c-ending">
            @ActionsTemplate
        </div>
    </div>
    <div class="c-center">
        <div class="cr-badge c-location">
            <i class="icon-map-point"></i>
            <span>@countryName</span>
        </div>
        <div class="cr-badge c-languages">
            <i class="icon-globe"></i>
            <span>@languages</span>
        </div>
    </div>
    <div class="c-bottom">
        @{
            var matchInterests = HighlightMatchWithProfile?.Preferences.Preferences.Interests ?? ImmutableArray<Interest>.Empty;
        }
        @foreach (var interest in preferences.Interests) {
            var match = matchInterests.Contains(interest);
            <div class="cr-badge @(match ? "selected" : "")">
                <span>@(Interests.GetTitle(interest))</span>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public Profile Profile { get; set; } = null!;
    [Parameter] public Profile? HighlightMatchWithProfile { get; set; }
    [Parameter] public RenderFragment ActionsTemplate { get; set; } = null!;
}
