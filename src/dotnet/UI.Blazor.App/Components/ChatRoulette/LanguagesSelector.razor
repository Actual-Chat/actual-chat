@using System.Linq.Expressions
@namespace ActualChat.UI.Blazor.App.Components
@inherits ComputedStateComponent<LanguagesSelector.Model>
@{
    var m = State.Value;
    var availableLanguages = m.AvailableLanguages;
    foreach (var language in Languages)
        availableLanguages = availableLanguages.Remove(language);
    if (_renderedLanguages.HasValue && !_renderedLanguages.Value.Equals(Languages))
        _renderedLanguagesHasChanged = true;
    _renderedLanguages = Languages;
}

<div class="languages-selector cr-badge-selector c-content">
    @foreach (var option in Languages) {
        <div class="cr-badge profile-badge selected">
            <span>@option.Title</span>
            <span class="clickable"><i class="icon-close" @onclick="@(() => Remove(option))"></i></span>
        </div>
    }
    @if (availableLanguages.Length > 0) {
        <div class="cr-badge profile-badge special clickable" @onclick="@(() => OnAddLanguageClick(availableLanguages))">Add</div>
    }
</div>

@code {
    [Inject] private ChatUIHub Hub { get; init; } = null!;
    private ModalUI ModalUI => Hub.ModalUI;
    private FieldIdentifier? _fieldIdentifier;
    private ImmutableArray<Language>? _renderedLanguages;
    private bool _renderedLanguagesHasChanged;


    [CascadingParameter] private EditContext? CascadedEditContext { get; set; }
    [Parameter] public ImmutableArray<Language> Languages { get; set; } = ImmutableArray<Language>.Empty;
    [Parameter] public EventCallback<ImmutableArray<Language>> LanguagesChanged { get; set; }
    [Parameter] public Expression<Func<ImmutableArray<Language>>>? ValueExpression { get; set; }

    protected override void OnInitialized()
        => _fieldIdentifier = ValueExpression is not null ? FieldIdentifier.Create(ValueExpression) : null;

    protected override ComputedState<Model>.Options GetStateOptions()
        => ComputedStateComponent.GetStateOptions(GetType(),
            static t => new ComputedState<Model>.Options() {
                InitialValue = new Model(),
                Category = ComputedStateComponent.GetStateCategory(t),
            });

    protected override async Task<Model> ComputeState(CancellationToken cancellationToken) {
        var languages = await Hub.LanguageUI.Settings.Use(cancellationToken).ConfigureAwait(false);
        var possibleLanguages = new List<Language>();
        AddPossibleLanguage(possibleLanguages, languages.Primary);
        AddPossibleLanguage(possibleLanguages, languages.Secondary);
        AddPossibleLanguage(possibleLanguages, languages.Tertiary);
        return new Model { AvailableLanguages = possibleLanguages.ToImmutableArray()};
    }

    protected override void OnAfterRender(bool firstRender) {
        if (_renderedLanguagesHasChanged) {
            CascadedEditContext?.Validate();
            _renderedLanguagesHasChanged = false;
        }
    }

    private void AddPossibleLanguage(List<Language> list, Language? languageOpt) {
        if (!languageOpt.HasValue)
            return;

        var language = languageOpt.Value;
        if (language.ShortTitle.Value.Length > 2 && ActualChat.Languages.IdToLanguage.TryGetValue(language.ShortTitle.Value.Substring(0, 2), out var alternative) && alternative != language)
            language = alternative;

        if (!list.Contains(language))
            list.Add(language);
    }

    private void Add(Language language) {
        var languages = Languages;
        if (languages.Contains(language))
            return;

        languages = languages.Add(language);
        OnChange(languages);
    }

    private void Remove(Language language) {
        var languages = Languages;
        if (!languages.Contains(language))
            return;

        languages = languages.Remove(language);
        OnChange(languages);
    }

    private void OnChange(ImmutableArray<Language> languages)
    {
        _ = LanguagesChanged.InvokeAsync(languages);
        if (CascadedEditContext is not null && _fieldIdentifier is not null)
            CascadedEditContext.NotifyFieldChanged(_fieldIdentifier.Value);
    }

    private void OnAddLanguageClick(ImmutableArray<Language> availableLanguages) {
        if (availableLanguages.Length == 1) {
            Add(availableLanguages[0]);
            return;
        }

        ModalUI.Show(new LanguagesSelectorPopup.Model(availableLanguages, Add));
    }

    // Nested types
    public record Model {
        public ImmutableArray<Language> AvailableLanguages { get; init; } = ImmutableArray<Language>.Empty;
    }
}
