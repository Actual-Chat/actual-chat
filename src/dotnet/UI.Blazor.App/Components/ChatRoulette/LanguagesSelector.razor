@using System.Linq.Expressions
@namespace ActualChat.UI.Blazor.App.Components
@inherits ComputedStateComponent<AppUIHub, LanguagesSelector.Model>
@{
    var m = State.Value;
    var availableLanguages = m.AvailableLanguages;
    foreach (var language in Languages)
        availableLanguages = availableLanguages.Without(language);
    if (!ReferenceEquals(_renderedLanguages, Languages) && _renderedLanguages != null)
        _renderedLanguagesHasChanged = true;
    _renderedLanguages = Languages;
}

<div class="languages-selector cr-badge-selector c-content">
    @foreach (var option in Languages) {
        <div class="cr-badge profile-badge selected">
            <span>@option.Title</span>
            <span class="clickable"><i class="icon-close" @onclick="@(() => Remove(option))"></i></span>
        </div>
    }
    @if (availableLanguages.Count > 0) {
        <div class="cr-badge profile-badge special clickable"
             @onclick="@(() => OnAddLanguageClick(availableLanguages))">Add</div>
    }
</div>

@code {
    private FieldIdentifier? _fieldIdentifier;
    private IReadOnlyList<Language>? _renderedLanguages;
    private bool _renderedLanguagesHasChanged;

    [CascadingParameter] private EditContext? CascadedEditContext { get; set; }
    [Parameter] public IReadOnlyList<Language> Languages { get; set; } = [];
    [Parameter] public EventCallback<IReadOnlyList<Language>> LanguagesChanged { get; set; }
    [Parameter] public Expression<Func<IReadOnlyList<Language>>>? ValueExpression { get; set; }

    protected override void OnInitialized()
        => _fieldIdentifier = ValueExpression is not null ? FieldIdentifier.Create(ValueExpression) : null;

    protected override ComputedState<Model>.Options GetStateOptions()
        => ComputedStateComponent.GetStateOptions(GetType(),
            static t => new ComputedState<Model>.Options() {
                InitialValue = new Model(),
                Category = GetStateCategory(t),
            });

    protected override async Task<Model> ComputeState(CancellationToken cancellationToken) {
        var languages = await Hub.LanguageUI.Settings.Use(cancellationToken).ConfigureAwait(false);
        var availableLanguages = new List<Language>();
        AddAvailableLanguage(availableLanguages, languages.Primary);
        AddAvailableLanguage(availableLanguages, languages.Secondary);
        AddAvailableLanguage(availableLanguages, languages.Tertiary);
        return new Model {
            AvailableLanguages = availableLanguages,
        };
    }

    protected override void OnAfterRender(bool firstRender) {
        if (_renderedLanguagesHasChanged) {
            CascadedEditContext?.Validate();
            _renderedLanguagesHasChanged = false;
        }
    }

    private void AddAvailableLanguage(List<Language> list, Language? language) {
        if (language == null)
            return;

        if (language.ShortTitle.Length > 2
            && ActualChat.Languages.SupportedById.TryGetValue(language.ShortTitle[..2], out var alternative)
            && alternative != language)
            language = alternative;

        if (!list.Contains(language))
            list.Add(language);
    }

    private void Add(Language language) {
        var languages = Languages;
        if (languages.Contains(language))
            return;

        languages = languages.With(language);
        OnChange(languages);
    }

    private void Remove(Language language) {
        var languages = Languages;
        if (!languages.Contains(language))
            return;

        languages = languages.Without(language);
        OnChange(languages);
    }

    private void OnChange(IReadOnlyList<Language> languages)
    {
        _ = LanguagesChanged.InvokeAsync(languages);
        if (CascadedEditContext is not null && _fieldIdentifier is not null)
            CascadedEditContext.NotifyFieldChanged(_fieldIdentifier.Value);
    }

    private void OnAddLanguageClick(IReadOnlyList<Language> availableLanguages) {
        if (availableLanguages.Count == 1) {
            Add(availableLanguages[0]);
            return;
        }

        ModalUI.Show(new LanguagesSelectorPopup.Model(availableLanguages, Add));
    }

    // Nested types
    public record Model {
        public IReadOnlyList<Language> AvailableLanguages { get; init; } = [];
    }
}
