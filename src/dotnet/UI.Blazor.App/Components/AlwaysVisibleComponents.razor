@using ActualChat.Hosting
@inherits ComponentBase<AppUIHub>

<ModalHost />
<MenuHost />
<BubbleHost />
<SpoilerFilterDefs />
<Hotkey Keys="ctrl+k" AriaLabel="Quick chat navigation" OnTrigger="OnQuickNav"/>
<Hotkey Keys="ctrl+/" AriaLabel="Keyboard shortcuts" OnTrigger="OnShortcutsHelp"/>
@if (!BrowserInfo.IsTouchCapable) {
    <TooltipHost />
}

<RenderIntoSlot Name="@LayoutSlots.MainLeftDrawer">
    <LeftPanel/>
</RenderIntoSlot>

<RenderIntoStack Name="@LayoutSlots.SubHeader" Order="-1000_000" Key="ReplaySubHeader">
    <GrantFileUploadsSubHeader />
    <AudioSubHeader/>
    <RecordingSubHeader/>
</RenderIntoStack>

@if (!HostInfo.HostKind.IsMauiApp()) {
    <PageHeader />
}

@code {
    private static readonly ModalOptions QuickNavModalOptions = new() {
        Class = "chat-quick-nav-modal",
        OverlayClass = "modal-overlay chat-quick-nav-overlay",
        UseFocusTrap = true,
    };

    private bool _isQuickNavOpen;
    private bool _isShortcutsHelpOpen;

    private BrowserInfo BrowserInfo => Hub.BrowserInfo;
    private LoadingUI LoadingUI => Hub.LoadingUI;
    private ModalUI ModalUI => Hub.ModalUI;

    protected override void OnAfterRender(bool firstRender) {
        if (firstRender)
            LoadingUI.MarkRendered();
    }

    private async Task OnQuickNav() {
        if (_isQuickNavOpen)
            return;

        _isQuickNavOpen = true;
        try {
            var modalRef = await ModalUI.Show(new ChatQuickNavModal.Model(), QuickNavModalOptions);
            await modalRef.WhenClosed;
        }
        finally {
            _isQuickNavOpen = false;
        }
    }

    private async Task OnShortcutsHelp() {
        if (_isShortcutsHelpOpen)
            return;

        _isShortcutsHelpOpen = true;
        try {
            var modalRef = await ModalUI.Show(new KeyboardShortcutsModal.Model());
            await modalRef.WhenClosed;
        }
        finally {
            _isShortcutsHelpOpen = false;
        }
    }
}
