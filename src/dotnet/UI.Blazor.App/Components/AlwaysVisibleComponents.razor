@using ActualChat.Hosting
@inherits ComponentBase<AppUIHub>

<ModalHost />
<MenuHost />
<BubbleHost />
@if (!BrowserInfo.IsTouchCapable) {
    <TooltipHost />
}

<RenderIntoSlot Name="@LayoutSlots.MainLeftDrawer">
    <LeftPanel/>
</RenderIntoSlot>

<RenderIntoStack Name="@LayoutSlots.SubHeader" Order="-1000_000" Key="ReplaySubHeader">
    <GrantFileUploadsSubHeader />
    <AudioSubHeader/>
    <RecordingSubHeader/>
</RenderIntoStack>

@if (!HostInfo.HostKind.IsMauiApp()) {
    <PageHeader />
}

@code {
    private BrowserInfo BrowserInfo => Hub.BrowserInfo;
    private LoadingUI LoadingUI => Hub.LoadingUI;

    protected override void OnAfterRender(bool firstRender) {
        if (firstRender)
            LoadingUI.MarkRendered();
    }
}
