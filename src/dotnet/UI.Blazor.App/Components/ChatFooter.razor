@using ActualChat.Contacts
@using ActualChat.UI.Blazor.App.Pages
@inherits FusionComponentBase<AppUIHub>
@{
    var m = Model;
    var chat = Chat;
}

<div class="writable-chat-footer">
    @if (m is null) {
        <chat-view-footer-skeleton/>
    } else if (chat is null) {
        <ReadOnlyChatFooter Text="" />
    } else if (m.IsBlocked) {
        <div class="chat-footer readonly">
            <div class="c-content">
                <span>You blocked this user.</span>
                <Button Class="btn-sm btn-primary ml-2" Click="@OnUnblock">Unblock</Button>
            </div>
        </div>
    } else if (m.IsBlockedByPeer) {
        <ReadOnlyChatFooter Text="This user has blocked you."/>
    } else {
        @if (m.CanPost) {
            <ChatMessageEditor @key="@chat.Id.Value"/>
        } else if (m.CanJoin || m.ShouldJoinPlaceFirst) {
            <div class="chat-footer">
                @if (!m.IsGuest) {
                    <div class="join-footer">
                        <span class="c-text">To post or talk,&nbsp;</span>
                        @if (m.ShouldJoinPlaceFirst) {
                            <Button Click="@(() => OnJoinPlace(m.Place!))" Class="btn-sm btn-primary">Join '@m.Place!.Title' place</Button>
                        } else {
                            <Button Click="@OnJoin" Class="btn-sm btn-primary">Join this chat</Button>
                        }
                    </div>
                } else {
                    <div class="signin-footer">
                        <div class="inline-flex">
                            <SignInButton ButtonClass="w-full"/>
                        </div>
                        @if (m.PeerId is { } otherUserId) {
                            <span class="inline-flex mx-2 mr-1 items-center">to chat with</span>
                            <AccountName UserId="@otherUserId"/>
                        } else if (m.CanJoinWithGuestAccount) {
                            <span class="inline-flex mx-2 items-center">or</span>
                            <Button Click="@OnJoin" Class="inline-flex btn-outline">Join anonymously</Button>
                        } else {
                            <span class="inline-flex ml-2 items-center">to join this chat</span>
                        }
                    </div>
                }
            </div>
        } else {
            <ReadOnlyChatFooter/>
        }
    }
</div>

@code {
    private Chat? Chat => ChatContext?.Chat;
    private ChatUI ChatUI => Hub.ChatUI;

    [CascadingParameter] public ChatContext? ChatContext { get; set; }
    [Parameter, EditorRequired] public ChatPage.FooterModel? Model { get; set; }

    private async Task OnJoin() {
        if (Chat?.Id is not { } chatId || Model is not { } model)
            return;

        var avatarSelectionRequired = model.HasMultipleAvatars || model.CanJoinAnonymously;
        if (!avatarSelectionRequired) {
            var command = new Authors_Join(Session, chatId);
            await UICommander.Run(command);
            return;
        }

        await ModalUI.Show(new AvatarSelectModal.Model(null, model.CanJoinAnonymously, JoinWithAvatar));
        return;

        async Task JoinWithAvatar(AvatarFull avatar) {
            var command = new Authors_Join(Session, chatId, avatar.Id, JoinAnonymously: avatar.IsAnonymous);
            await UICommander.Run(command);
        }
    }

    private void OnJoinPlace(Place place)
        => _ = ChatUI.JoinPlace(place.Id);

    private Task OnUnblock() {
        if (Model?.PeerContactId is not { } contactId)
            return Task.CompletedTask;

        return Hub.PeerBlockUI.SetBlocked(contactId, false);
    }
}
