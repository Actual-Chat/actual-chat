@namespace ActualChat.UI.Blazor.App.Components
@inherits SimpleStep<AppUIHub>;
@if (CurrentStep != this) {
    return;
}

<div class="onboarding-tutorial tutorial-1">
    <img draggable="false" src="/dist/images/onboarding/tutorial-1.png" alt="Tutorial slide #1">
    <div class="c-title">
        <p>
            @L.Onboarding_Tutorial1Title1
        </p>
        <p>
            @L.Onboarding_Tutorial1Title2
        </p>
    </div>
    <p class="c-description">
        @L.Onboarding_Tutorial1Description
    </p>
</div>

@code {
    private OnboardingUI OnboardingUI => Hub.OnboardingUI;

    public override bool CanSkip => true;

    public override bool IsCompleted => OnboardingUI.UserSettings.Value.IsTranscriptionTutorialStepCompleted;

    protected override void MarkCompleted()
        => OnboardingUI.UpdateUserSettings(OnboardingUI.UserSettings.Value with { IsTranscriptionTutorialStepCompleted = true });

    protected override Task<bool> Validate()
        => Task.FromResult(true);

    protected override ValueTask OnSkip()
        => ValueTask.CompletedTask;

    protected override Task<bool> Save()
        => Task.FromResult(true);
}
