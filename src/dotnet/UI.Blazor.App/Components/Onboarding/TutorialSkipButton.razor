@namespace ActualChat.UI.Blazor.App.Components
@{
    var cls = Stepper.CurrentStep switch {
        TranscriptPlaybackStep => "step-2",
        PlacesFeatureStep => "step-3",
        JoinPlaceStep => "step-4",
        _ => "",
    };
}

<div class="tutorial-btn-wrapper @cls">
    <button type="button" class="tutorial-btn" @onclick="@Click">
        <i class="icon-arrow-right text-2xl"></i>
    </button>
</div>

@code {
    [Parameter] public Stepper Stepper { get; set; } = null!;
    [Parameter] public EventCallback<MouseEventArgs> Click { get; set; }
}
