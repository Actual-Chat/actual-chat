@namespace ActualChat.UI.Blazor.App.Components
@inherits ActualChat.UI.Blazor.ComponentBase<AppUIHub>
@{
    var cls = Stepper.CurrentStep switch {
        // TranscriptReplayTutorialStep => "step-2", // Disabled
        PlacesTutorialStep => "step-2",
        SummarizationTutorialStep => "step-3",
        _ => "",
    };
}

<div class="tutorial-btn-wrapper @cls">
    <button type="button" class="tutorial-btn" @onclick="@OnClick">
        <i class="icon-arrow-right text-2xl"></i>
    </button>
</div>

@code {
    [Parameter] public Stepper Stepper { get; set; } = null!;
    [Parameter] public EventCallback<MouseEventArgs> Click { get; set; }

    private async Task OnClick(MouseEventArgs e) {
        _ = TuneUI.Play(Tune.ClickButton);
        await Click.InvokeAsync(e);
    }
}
