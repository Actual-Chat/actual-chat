@namespace ActualChat.UI.Blazor.App.Components
@using ActualChat.UI.Blazor.App.Components.Settings
@inherits SimpleStep<AppUIHub>;
@{
    var m = _model;
    if (CurrentStep != this || m is null)
        return;
}

<div class="permissions-step">
    <p class="step-subtitle">@L.Onboarding_RequiredPermissions</p>
    <div class="step-tiles">
        @if (m.SkipEverything) {
            <div class="step-tile">
                <div class="step-tile-body">
                    <div class="step-tile-subtitle">
                        @L.Onboarding_AllPermissionsGranted
                    </div>
                </div>
            </div>
        }
        @foreach (var row in m.Rows) {
            if (!row.IsVisible)
                continue;

            var r = row;
            <div class="step-tile" @onclick="() => OnToggle(r, true)">
                <i class="step-tile-icon @r.Icon @(r.IsGranted ? "on" : "")"></i>
                <div class="step-tile-body">
                    <div class="step-tile-title">@r.Title</div>
                    <div class="step-tile-subtitle">@r.Rationale</div>
                </div>
                <Toggle
                    IsChecked="@r.IsGranted"
                    IsDisabled="@(r.IsGranted || _isRequesting)"
                    IsCheckedChanged="isOn => OnToggle(r, isOn)"/>
            </div>
        }
        <div class="step-tile">
            <div class="c-docs">
                <div class="c-doc-wrapper">
                    <a class="c-doc" @onclick="() => OnDocumentClick(DocumentsTabId.PrivacyPolicy)">
                        @L.Onboarding_PrivacyPolicy
                    </a>
                    <i class="icon-chevron-right text-xl"></i>
                </div>
                <div class="c-doc-wrapper">
                    <a class="c-doc" @onclick="() => OnDocumentClick(DocumentsTabId.TermsConditions)">
                        @L.Onboarding_TermsOfService
                    </a>
                    <i class="icon-chevron-right text-xl"></i>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private PermissionStepModel? _model;
    private bool _isRequesting;

    private OnboardingUI OnboardingUI => Hub.OnboardingUI;
    private IRecordingPermissionRequester RecordingPermissionRequester
        => field ??= Services.GetRequiredService<IRecordingPermissionRequester>();
    private INotificationsPermission NotificationsPermission
        => field ??= Services.GetRequiredService<INotificationsPermission>();
    private SystemSettingsUI SystemSettingsUI => field ??= Services.GetRequiredService<SystemSettingsUI>();

    public override bool IsCompleted => OnboardingUI.LocalSettings.Value.IsPermissionsStepCompleted;

    protected override async Task OnInitializedAsync()
        => _model = await PermissionStepModel.New(Services);

    protected override Task<bool> Validate()
        => Task.FromResult(_model != null);

    protected override void MarkCompleted()
        => _model?.MarkCompleted();

    protected override Task<bool> Save()
        => Task.FromResult(_model != null);

    private async Task OnToggle(PermissionRow row, bool isOn) {
        if (!isOn || row.IsGranted || _isRequesting)
            return;

        _isRequesting = true;
        StateHasChanged();
        try {
            // The OS won't prompt for a denied permission again, only its settings can grant it now
            if (await IsNotificationsDenied(row)) {
                await SystemSettingsUI.Open(SystemSettingsPane.Notifications);
                return;
            }

            row.IsGranted = await row.Request();
            // Android refuses a blocked microphone without a prompt, and reports it just like
            // a never-requested one, so a refusal is the only signal there
            if (!row.IsGranted && row.Kind == PermissionKind.Microphone && RecordingPermissionRequester.CanRequest)
                await RecordingPermissionRequester.TryRequest();
        }
        finally {
            _isRequesting = false;
            StateHasChanged();
        }
    }

    private async Task<bool> IsNotificationsDenied(PermissionRow row)
        // Android reports a never-requested notifications permission as denied too
        => row.Kind == PermissionKind.Notifications
            && HostInfo.AppKind != AppKind.Android
            && await NotificationsPermission.IsGranted() == false;

    private Task OnDocumentClick(string tabId)
        => ModalUI.Show(new DocumentsModal.Model(tabId));
}
