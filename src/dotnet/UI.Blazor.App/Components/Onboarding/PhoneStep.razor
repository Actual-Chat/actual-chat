@namespace ActualChat.UI.Blazor.App.Components
@inherits SimpleStep<AppUIHub>;

@if (CurrentStep != this) {
    return;
}

<div class="phone-verifier">
    @if (Stepper.CurrentStepIndex == 0) {
        <p class="text-title-1 text-center">Welcome to @CoreConstants.AppName!</p>
    }
    <p class="text-headline-1 mt-6">
        Please verify your phone number.
    </p>
    <p class="text-text-1 mt-2">
        We collect this information to help you find friends in your contacts list who are already using @CoreConstants.AppName.
    </p>
    <CascadingValue Value="_editContext">
        <EditForm EditContext="_editContext" class="form form-y mt-6">
            <FormSection
                For="() => _model.Phone"
                InputId="phone"
                Label="Phone"
                Class="grow"
                IsLabelInsideInput="true"
                IsRequired="true">
                <ChildContent>
                    <TextBox
                        Id="phone"
                        @bind-Value="_model.Phone"
                        @oninput="OnPhoneInput"
                        Autocomplete="tel"
                        type="tel"
                        inputmode="tel"/>
                </ChildContent>
                <Right>
                    @if (_showVerificationStatus) {
                        <VerificationStatus
                            IsVerified="_isVerified ?? false"
                            Class="w-8 h-8"/>
                    }
                </Right>
            </FormSection>
            <div class="c-incut">
                <Button
                    Class="verify-btn btn-w-full"
                    IsDisabled="@(IsVerifyButtonDisabled)"
                    Click="@OnVerifyClick">
                    Verify
                </Button>
                <div class="c-info">
                    You can skip this step. The phone number can be filled in later.
                </div>
            </div>

            @if (CaptchaUI.IsConfigured) {
                <div class="c-recaptcha-info">
                    This site is protected by reCAPTCHA and the Google
                    <a class="recaptcha-link" href="https://policies.google.com/privacy">Privacy Policy</a> and
                    <a class="recaptcha-link" href="https://policies.google.com/terms">Terms of Service</a> apply.
                </div>
            }
        </EditForm>
        </CascadingValue>
</div>

@code {
    private readonly Model _model = new();
    private FieldIdentifier _phoneFieldIdentifier;
    private EditContext? _editContext;
    private ValidationMessageStore? _validationMessageStore;
    private ValidationState _validationState = ValidationState.None;
    private bool _showVerificationStatus;
    private bool? _isVerified;
    private bool? _skipped;

    private IAccounts Accounts => Hub.Accounts;
    private IPhones Phones => Hub.Phones;
    private ICaptcha Captcha => Hub.Captcha;
    private TotpUI TotpUI => Hub.TotpUI;
    private CaptchaUI CaptchaUI => Hub.CaptchaUI;
    private OnboardingUI OnboardingUI => Hub.OnboardingUI;

    [Parameter, EditorRequired] public AccountFull Account { get; set; } = null!;
    [Parameter] public EventCallback OnVerifyClick { get; set; }

    public override bool CanSkip => false;

    public override bool IsCompleted {
        get {
            if (Account.HasVerifiedPhone())
                return true;

            // Can move forward if already verified in case when Skip and Back were pressed
            if (_isVerified is true)
                return true;

            // Can't move forward if skipped in case when Skip and Back were pressed
            if (_skipped is true)
                return false;

            return OnboardingUI.UserSettings.Value.IsVerifyPhoneStepCompleted;
        }
    }

    protected override void MarkCompleted()
        => OnboardingUI.UpdateUserSettings(OnboardingUI.UserSettings.Value with { IsVerifyPhoneStepCompleted = true });

    protected override async Task OnInitializedAsync() {
        var account = await Accounts.GetOwn(Session, default);
        _showVerificationStatus = !account.HasVerifiedPhone();

        if (account.Phone != null)
            _model.Phone = account.Phone.ToReadable();
        else
            _model.Phone = PhoneCodes.Default.DisplayCode;

        _editContext = new EditContext(_model);
        _validationMessageStore = new ValidationMessageStore(_editContext);
        _phoneFieldIdentifier = FieldIdentifier.Create(() => _model.Phone);

        await CaptchaUI.EnsureInitialized();
    }

    protected override Task<bool> Validate() {
        return Task.FromResult(_validationState == ValidationState.Valid);
    }

    protected override ValueTask OnSkip() {
        _skipped = true;
        return ValueTask.CompletedTask;
    }

    protected override async Task<bool> Save() {
        var phone = await Phones.Parse(_model.Phone, default);
        if (phone is null)
            return false;

        var account = await Accounts.GetOwn(Session, default);
        var command = new Accounts_Update(Session, account with { Phone = phone }, account.Version);
        var (_, error) = await UICommander.Run(command);
        if (error is not null)
            return false;

        if (!account.HasVerifiedPhone()) {
            var hasSentCodeRecently = await TotpUI.HasSentCodeRecently(CancellationToken.None);
            if (hasSentCodeRecently) {
                _validationState = ValidationState.CodeSentRecently;
                StateHasChanged();
                return await ShowTotpVerificationModal();
            }

            if (CaptchaUI.IsConfigured) {
                _validationState = ValidationState.Validating;
                StateHasChanged();
                try {
                    var captchaToken = await CaptchaUI.GetActionToken(Constants.Recaptcha.Actions.PhoneSignIn, CancellationToken.None);
                    var validationResult = await Captcha.Validate(captchaToken, Constants.Recaptcha.Actions.PhoneSignIn, CancellationToken.None);
                    _validationState = validationResult.Success
                        ? ValidationState.Valid
                        : ValidationState.Invalid;
                }
                catch {
                    _validationState = ValidationState.Invalid;
                }
                finally {
                    StateHasChanged();
                }
            }

            return await ShowTotpVerificationModal();
        }

        return true;

        async Task<bool> ShowTotpVerificationModal() {
            if (_validationState == ValidationState.Invalid)
                return false;

            var verificationModel = new PhoneVerificationModal.Model(phone);
            var modalRef = await ModalUI.Show(verificationModel);
            await modalRef.WhenClosed;
            _showVerificationStatus = verificationModel.IsVerified;
            _isVerified = verificationModel.IsVerified;
            if (verificationModel is { IsVerified: false, CanSkip: false })
                return false;
            _showVerificationStatus = true;
            return true;
        }
    }

    private bool IsVerifyButtonDisabled =>
        string.IsNullOrWhiteSpace(_model.Phone) ||
        _validationState == ValidationState.Invalid ||
        _editContext?.GetValidationMessages(_phoneFieldIdentifier).Any() == true;

    private void OnPhoneInput(ChangeEventArgs e) {
        if (_editContext == null || _validationMessageStore == null)
            return;

        var phone = (e.Value?.ToString() ?? "").Trim();

        _validationMessageStore.Clear(_phoneFieldIdentifier);
        _validationState = ValidationState.None;

        if (string.IsNullOrEmpty(phone)) {
            _validationMessageStore.Add(_phoneFieldIdentifier, "Phone number is required");
            _validationState = ValidationState.Invalid;
        } else if (!phone.StartsWith("+")) {
            _validationMessageStore.Add(_phoneFieldIdentifier, "Phone number must start with '+'");
            _validationState = ValidationState.Invalid;
        } else {
            var digits = new string(phone.Skip(1).Where(char.IsDigit).ToArray());
            if (digits.Length < 8) {
                _validationMessageStore.Add(_phoneFieldIdentifier, "Phone number is too short");
                _validationState = ValidationState.Invalid;
            } else if (digits.Length > 15) {
                _validationMessageStore.Add(_phoneFieldIdentifier, "Phone number is too long");
                _validationState = ValidationState.Invalid;
            } else {
                _validationState = ValidationState.Valid;
            }
        }

        _editContext.NotifyValidationStateChanged();
        StateHasChanged();
    }

    public class Model {
        public string Phone { get; set; } = PhoneCodes.Default.DisplayCode;
    }
}
