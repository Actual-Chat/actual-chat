@namespace ActualChat.UI.Blazor.App.Components
@inherits SimpleStep<AppUIHub>;
@{
    if (CurrentStep != this)
        return;
    var showVerificationStatus = !_model.Phone.IsNullOrWhiteSpace() && _showVerificationStatus;
}

<div class="phone-verifier">
    <p class="step-title">@L.Onboarding_Welcome_Format(CoreConstants.AppName)</p>
    <p class="step-subtitle">
        @L.Onboarding_PleaseVerifyPhone
    </p>
    <p class="step-comment">
        @L.Onboarding_PhoneCollectionReason_Format(CoreConstants.AppName)
    </p>
    <Form
        @ref="@_formRef"
        Class="mt-6"
        Model="@_model">
        <AsyncDataAnnotationsValidator @ref="_validator"/>
        <FormSection
            For="() => _model.Phone"
            InputId="phone"
            Label="@L.Form_Phone"
            Class="grow"
            IsLabelInsideInput="true">
            <ChildContent>
                <TextBox
                    Id="phone"
                    @bind-Value="_model.Phone"
                    Autocomplete="tel"
                    readonly="@_isVerified"
                    type="tel"
                    inputmode="tel"/>
            </ChildContent>
            <Right>
                @if (showVerificationStatus) {
                    <VerificationStatus
                        IsVerified="@_isVerified"
                        Class="w-8 h-8" />
                }
            </Right>
        </FormSection>
        @if (!_isVerified) {
            <div class="c-incut">
                <Button
                    Class="verify-btn btn-w-full"
                    IsDisabled="@(_validationState is ValidationState.Invalid || !_formRef.IsValid || _model.Phone.IsNullOrWhiteSpace())"
                    Click="@OnVerifyClick">
                    @(_validationState is ValidationState.Invalid ? L.SignIn_Unavailable : L.Common_Verify)
                </Button>
                <div class="c-info">
                    @L.Onboarding_PhoneSkipHint
                </div>
            </div>
        }

        <CaptchaView />
    </Form>
</div>

@code {
    private Form _formRef = null!;
    private readonly Model _model = new();
    private ValidationState _validationState = ValidationState.None;
    private bool _showVerificationStatus;
    private bool _isVerified;
    private AsyncDataAnnotationsValidator _validator = null!;

    private IAccounts Accounts => Hub.Accounts;
    private IPhones Phones => Hub.Phones;
    private ICaptcha Captcha => Hub.Captcha;
    private TotpUI TotpUI => Hub.TotpUI;
    private CaptchaUI CaptchaUI => Hub.CaptchaUI;
    private OnboardingUI OnboardingUI => Hub.OnboardingUI;

    [Parameter, EditorRequired] public AccountFull Account { get; set; } = null!;

    public override bool CanSkip => false;

    public override bool IsCompleted
        => Account.IsPhoneVerified() || OnboardingUI.UserSettings.Value.IsVerifyPhoneStepCompleted;

    protected override void MarkCompleted()
        => OnboardingUI.UpdateUserSettings(OnboardingUI.UserSettings.Value with { IsVerifyPhoneStepCompleted = true });

    protected override async Task OnInitializedAsync() {
        var account = await Accounts.GetOwn(Session, default);
        _isVerified = account.IsPhoneVerified();
        if (account.Phone != null) {
            _showVerificationStatus = true;
            _model.Phone = account.Phone.ToReadable();
        }
        await CaptchaUI.WhenReady;
    }

    protected override Task<bool> Validate()
        => Task.FromResult(true);

    protected override Task<bool> Save()
        => Task.FromResult(true);

    private async Task OnVerifyClick() {
        var isValid = await InnerValidate();
        if (!isValid)
            return;

        var isSaved = await InnerSave();
        if (!isSaved)
            return;

        await Stepper.TryMoveForward();
    }

    private async Task<bool> InnerValidate() {
        var isValid = _validationState != ValidationState.Invalid // reCaptcha blocks verification
                      && await _validator.Validate().ConfigureAwait(false);
        return isValid;
    }

    private async Task<bool> InnerSave() {
        var phone = await Phones.ParseWithCountryFallback(Session, _model.Phone, default);
        if (phone is null)
            return false;

        var account = await Accounts.GetOwn(Session, default);
        var command = new Accounts_Update {
            Session = Session,
            Account = account with { Phone = phone },
            ExpectedVersion = account.Version,
        };
        var (_, error) = await UICommander.Run(command);
        if (error is not null)
            return false;

        if (account.IsPhoneVerified())
            return true;

        var hasSentCodeRecently = await TotpUI.HasSentCodeRecently(CancellationToken.None);
        if (hasSentCodeRecently) {
            _validationState = ValidationState.CodeSentRecently;
            StateHasChanged();
            return await ShowTotpVerificationModal();
        }

        if (CaptchaUI.IsAvailable) {
            _validationState = ValidationState.Validating;
            StateHasChanged();
            try {
                var captchaToken = await CaptchaUI.GetActionToken(Constants.Recaptcha.Actions.PhoneSignIn, CancellationToken.None);
                var validationResult = await Captcha.Validate(captchaToken, Constants.Recaptcha.Actions.PhoneSignIn, CancellationToken.None);
                _validationState = validationResult.Success
                    ? ValidationState.Valid
                    : ValidationState.Invalid;
            }
            catch {
                _validationState = ValidationState.Invalid;
            }
            finally {
                StateHasChanged();
            }
        } else {
            _validationState = ValidationState.Valid;
        }

        return await ShowTotpVerificationModal();

        async Task<bool> ShowTotpVerificationModal() {
            if (_validationState == ValidationState.Invalid)
                return false;

            var verificationModel = new PhoneVerificationModal.Model(phone);
            var modalRef = await ModalUI.Show(verificationModel);
            await modalRef.WhenClosed;
            _showVerificationStatus = verificationModel.IsVerified;
            _isVerified = verificationModel.IsVerified;
            if (verificationModel is { IsVerified: false, CanSkip: false })
                return false;
            _showVerificationStatus = true;
            return true;
        }
    }

    public class Model {
        [PhoneNumber]
        public string Phone { get; set; } = PhoneCodes.Default.DisplayCode;
    }
}
