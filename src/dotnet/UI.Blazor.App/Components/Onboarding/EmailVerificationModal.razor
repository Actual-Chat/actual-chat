@namespace ActualChat.UI.Blazor.App.Components
@implements IModalView<EmailVerificationModal.Model>
@inherits ComponentBase<AppUIHub>

<DialogFrame
    Class="onboarding-modal fixed-height email-verification-modal"
    HasHeader="true"
    Title="@L.Onboarding_EmailVerificationTitle"
    HasCloseButton="true"
    NarrowViewSettings="DialogFrameNarrowViewSettings.Default">
    <Body>
    <div class="c-content">
        <div class="c-image">
            <phone-verification-cat-svg/>
        </div>
        <div class="c-code">
            <div class="font-bold text-2xl text-02">@L.Onboarding_EnterCode</div>
            <TotpVerifier
                Purpose="TotpPurpose.VerifyEmail"
                Email="@ModalModel.Email"
                Verified="@(_ => Complete(true))"
                Error="@(_ => Complete(false))"/>
        </div>
    </div>
    </Body>
</DialogFrame>

@code {
    [CascadingParameter] public Modal Modal { get; set; } = null!;
    [Parameter] public Model ModalModel { get; set; } = null!;

    private void Complete(bool isVerified) {
        ModalModel.IsVerified = isVerified;
        Modal.Close();
    }

    public sealed record Model(ActualChat.Email Email) {
        public bool IsVerified { get; set; }
    }
}
