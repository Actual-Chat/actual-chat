@namespace ActualChat.UI.Blazor.App.Components
@implements IModalView<OnboardingModal.Model>
@inherits ComputedStateComponent<AppUIHub, OnboardingModal.ViewModel?>
@{
    var m = State.Value;
    if (m is null)
        return;

    if (m.AccountFull.IsGuest) {
        Modal.Close(true);
        return;
    }
}

<DialogFrame
    Class="onboarding-modal"
    HasHeader="false"
    NarrowViewSettings="DialogFrameNarrowViewSettings.Stretch">
    <Body>
    <Stepper Context="stepper" CurrentStepChanged="@OnCurrentStepChanged" Class="onboarding-stepper">
        <Filler>
            @if (stepper.CurrentStep is PhoneStep) {
                <div class="stepper-image-filler">
                    <img draggable="false" src="/dist/images/landing/voice-and-text.svg" alt="">
                </div>
            } else {
                <div class="stepper-filler"></div>
            }
        </Filler>
        <Steps>
            <SpeechTranscriptionStep/>
            <TranscriptPlaybackStep/>
            <PlacesFeatureStep/>
            <JoinPlaceStep/>
            <PhoneStep Account="m.AccountFull" OnVerifyClick="@(() => OnNext(stepper))"/>
            <EmailStep Account="m.AccountFull"/>
            <TimeZoneStep Account="m.AccountFull"/>
            <AvatarStep/>
            <PermissionsStep NextButtonRef="@_nextButtonRef"/>
            <DataCollectionStep IsConfigured="m.IsDataCollectionConfigured"/>
            <CreateChatsStep/>
            @if (m.EnableChatRouletteUI) {
                <ChatRouletteStep/>
            }
        </Steps>
        <Header>
            @if (stepper.CanMoveBack) {
                <HeaderButton Click="@(_ => stepper.MoveBack())">
                    <i class="icon-arrow-left text-2xl"></i>
                </HeaderButton>
                <div class="text-headline-7 text-02">Back</div>
            }
            <div class="grow"></div>
            @if (ModalModel.CanBeClosed) {
                <HeaderButton Click="() => Modal.Close()">
                    <i class="icon-close"></i>
                </HeaderButton>
            }
        </Header>
        <Footer>
            <div class="onboarding-footer">
                @if (stepper.CurrentStep is not (SpeechTranscriptionStep or TranscriptPlaybackStep or PlacesFeatureStep or JoinPlaceStep)) {
                    <LineProgress
                        StepCount="@(stepper.StepCount - 4)"
                        CurrentStepIndex="@(stepper.CurrentStepIndex - 4)"
                        Decoration="LineProgress.LineProgressDecoration.Gray">
                    </LineProgress>
                }
                <div class="btn-group">
                    @if (stepper.CanSkip) {
                        if (stepper.CurrentStep is SpeechTranscriptionStep or TranscriptPlaybackStep or PlacesFeatureStep or JoinPlaceStep) {
                            <TutorialSkipButton Stepper="@stepper" Click="@(() => OnSkip(stepper))"/>
                        } else {
                            <Button
                                Class="btn-cancel"
                                Click="@(() => OnSkip(stepper))">
                                @stepper.SkipTitle
                            </Button>
                        }
                    }
                    @if (stepper.CurrentStep is not (SpeechTranscriptionStep or TranscriptPlaybackStep or PlacesFeatureStep or JoinPlaceStep)) {
                        @if (stepper.CurrentStep is PhoneStep) {
                            <Button
                                Class="btn-primary"
                                ButtonRef="@_nextButtonRef"
                                Click="@(() => OnSkip(stepper))">
                                <span>@stepper.NextTitle</span>
                            </Button>
                        } else {
                            <Button
                                Class="btn-primary"
                                ButtonRef="@_nextButtonRef"
                                Click="@(() => OnNext(stepper))">
                                @if (stepper.CurrentStep is PhoneStep or EmailStep or DataCollectionStep) {
                                    <span>@stepper.NextTitle</span>
                                } else if (stepper.IsLastStep) {
                                    <span>Start messaging</span>
                                } else if (stepper.CanMoveForward) {
                                    <span>@stepper.NextTitle</span>
                                } else {
                                    Modal.Close(true);
                                }
                            </Button>
                        }
                    }
                </div>
            </div>
        </Footer>
    </Stepper>
    </Body>
</DialogFrame>

@code {
    private readonly Mutable<ElementReference> _nextButtonRef = new();

    private IDataCollectionSettingsUI DataCollectionSettingsUI => Hub.DataCollectionSettingsUI;

    [CascadingParameter] public Modal Modal { get; set; } = null!;
    [Parameter] public Model ModalModel { get; set; } = null!;

    protected override async Task<ViewModel?> ComputeState(CancellationToken cancellationToken) {
        var account = await AccountUI.OwnAccount.Use(cancellationToken).ConfigureAwait(false);
        var isDataCollectionConfigured = await DataCollectionSettingsUI.IsConfigured(cancellationToken).ConfigureAwait(false);
        var enableChatRouletteUI = await Features.Get<Features_EnableChatRouletteUI>(cancellationToken);
        return new() {
            AccountFull = account,
            IsDataCollectionConfigured = isDataCollectionConfigured,
            EnableChatRouletteUI = enableChatRouletteUI,
        };
    }

    private async Task OnSkip(Stepper stepper) {
        await stepper.Skip();
    }

    private async Task OnNext(Stepper stepper) {
        try {
            await stepper.TryMoveForward();
        }
        finally {
            StateHasChanged();
        }
    }

    // Event handlers

    private void OnCurrentStepChanged(bool isCompleted) {
        if (!isCompleted)
            return;

        ModalModel.CanBeClosed = true;
        Modal.Close(true);
    }

    // Nested types

    public sealed record ViewModel {
        public AccountFull AccountFull { get; init; } = null!;
        public bool IsDataCollectionConfigured { get; init; }
        public bool EnableChatRouletteUI { get; init; }
    }

    public sealed record Model : IOptionallyClosable {
        public bool CanBeClosed { get; set; }
    }
}
