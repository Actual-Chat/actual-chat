@namespace ActualChat.UI.Blazor.App.Components
@implements IModalView<OnboardingModal.Model>
@inherits ComputedStateComponent<AppUIHub, OnboardingModal.ViewModel?>
@{
    var m = State.Value;
    if (m is null)
        return;

    if (m.AccountFull.IsGuest) {
        Modal.Close(true);
        return;
    }
}

<DialogFrame
    Class="onboarding-modal theme-light"
    HasHeader="false"
    NarrowViewSettings="DialogFrameNarrowViewSettings.Default">
    <Body>
    <Stepper Context="stepper" CurrentStepChanged="@OnCurrentStepChanged"
        Class="onboarding-stepper" ContentClass="no-scrollbar" ShowNoise="@true" SkipCompletedSteps="@true">
        <Filler>
            @if (stepper.CurrentStep is PhoneStep) {
                <div class="stepper-image-filler">
                    <img draggable="false" src="/dist/images/onboarding/voice-and-text.svg" alt="">
                </div>
            } else {
                <div class="stepper-filler"></div>
            }
        </Filler>
        <Steps>
            <TranscriptionTutorialStep/>
            @* <TranscriptReplayTutorialStep/> *@ @* Disabled *@
            <PlacesTutorialStep/>
            <SummarizationTutorialStep/>
            <PhoneStep Account="m.AccountFull"/>
            <EmailStep Account="m.AccountFull"/>
            @* <TimeZoneStep Account="m.AccountFull"/> *@ @* Disabled *@
            <AvatarStep/>
            <PermissionsStep/>
            <LanguagesStep/>
            <DataCollectionStep IsConfigured="m.IsDataCollectionConfigured"/>
            @* <CreateChatsStep/> *@ @* Disabled *@
        </Steps>
        <Header>
            @if (stepper.CanMoveBack) {
                <HeaderButton Click="@(_ => stepper.MoveBack())">
                    <i class="icon-arrow-left text-2xl"></i>
                </HeaderButton>
                <div class="text-headline-7 text-02">@L.Common_Back</div>
            }
            <div class="grow"></div>
            @if (ModalModel.CanBeClosed) {
                <HeaderButton Click="() => Modal.Close()">
                    <i class="icon-close"></i>
                </HeaderButton>
            }
        </Header>
        <Footer>
            @{
                var isTutorial = stepper.CurrentStep
                    is TranscriptionTutorialStep
                    // or TranscriptReplayTutorialStep // Disabled
                    or PlacesTutorialStep
                    or SummarizationTutorialStep;
            }
            <div class="onboarding-footer">
                @if (!isTutorial) {
                    <LineProgress
                        StepCount="@stepper.VisibleStepCount"
                        CurrentStepIndex="@stepper.CurrentVisibleStepIndex">
                    </LineProgress>
                }
                <div class="btn-group">
                    @if (stepper.CanSkip) {
                        if (isTutorial) {
                            <TutorialSkipButton Stepper="@stepper" Click="@(() => OnSkip(stepper))"/>
                        } else {
                            <Button
                                Class="btn-cancel"
                                Click="@(() => OnSkip(stepper))">
                                @stepper.SkipTitle
                            </Button>
                        }
                    }
                    @if (!isTutorial) {
                        <Button
                            Class="btn-primary"
                            Click="@(() => OnNext(stepper))">
                            @if (stepper.CurrentStep is PhoneStep or EmailStep or DataCollectionStep) {
                                <span>@stepper.NextTitle</span>
                            } else if (stepper.IsLastStep) {
                                <span>@L.Onboarding_StartMessaging</span>
                            } else if (stepper.CanMoveForward) {
                                <span>@stepper.NextTitle</span>
                            } else {
                                Modal.Close(true);
                            }
                        </Button>
                    }
                </div>
            </div>
        </Footer>
    </Stepper>
    </Body>
</DialogFrame>

@code {
    private IDataCollectionSettingsUI DataCollectionSettingsUI => Hub.DataCollectionSettingsUI;

    [CascadingParameter] public Modal Modal { get; set; } = null!;
    [Parameter] public Model ModalModel { get; set; } = null!;

    protected override async Task<ViewModel?> ComputeState(CancellationToken cancellationToken) {
        var account = await AccountUI.OwnAccount.Use(cancellationToken).ConfigureAwait(false);
        var isDataCollectionConfigured = await DataCollectionSettingsUI.IsConfigured(cancellationToken)
            .ConfigureAwait(false);
        return new() {
            AccountFull = account,
            IsDataCollectionConfigured = isDataCollectionConfigured,
        };
    }

    private async Task OnSkip(Stepper stepper) {
        await stepper.Skip();
    }

    private async Task OnNext(Stepper stepper) {
        try {
            await stepper.TryMoveForward();
        }
        finally {
            StateHasChanged();
        }
    }

    // Event handlers

    private void OnCurrentStepChanged(bool isCompleted) {
        if (!isCompleted)
            return;

        ModalModel.CanBeClosed = true;
        Modal.Close(true);
    }

    // Nested types

    public sealed record ViewModel {
        public AccountFull AccountFull { get; init; } = null!;
        public bool IsDataCollectionConfigured { get; init; }
    }

    public sealed record Model : IOptionallyClosable {
        public bool CanBeClosed { get; set; }
    }
}
