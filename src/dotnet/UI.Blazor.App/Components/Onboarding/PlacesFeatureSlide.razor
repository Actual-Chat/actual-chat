@namespace ActualChat.UI.Blazor.App.Components
@inherits SimpleStep<AppUIHub>;
@if (CurrentStep != this) {
    return;
}

<div class="onboarding-tutorial tutorial-3">
    <img draggable="false" src="/dist/images/onboarding/tutorial-3.svg" alt="Tutorial slide #3">
    <div class="c-title">
        <p>
            More than chats.
        </p>
        <p>
            Explore Places
        </p>
    </div>
    <p class="c-description">
        A Place brings together multiple chats and a shared community, creating a hub user interaction.
    </p>
</div>

@code {
    private OnboardingUI OnboardingUI => Hub.OnboardingUI;

    [Parameter] public EventCallback OnVerifyClick { get; set; }

    public override bool CanSkip => true;

    public override bool IsCompleted => OnboardingUI.UserSettings.Value.IsPlacesFeatureSlideCompleted;

    protected override void MarkCompleted()
        => OnboardingUI.UpdateUserSettings(OnboardingUI.UserSettings.Value with { IsPlacesFeatureSlideCompleted = true });

    protected override Task<bool> Validate()
        => Task.FromResult(true);

    protected override ValueTask OnSkip()
        => ValueTask.CompletedTask;

    protected override Task<bool> Save()
        => Task.FromResult(true);
}
