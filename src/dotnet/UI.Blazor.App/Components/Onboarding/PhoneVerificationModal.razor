@namespace ActualChat.UI.Blazor.App.Components
@implements IModalView<PhoneVerificationModal.Model>

<DialogFrame
    Class="onboarding-modal fixed-height phone-verification-modal"
    HasHeader="true"
    Title="Phone number verification"
    HasCloseButton="true"
    NarrowViewSettings="DialogFrameNarrowViewSettings.Stretch">
    <Body>
        <div class="c-image">
            <phone-verification-cat-svg/>
        </div>
        <div class="c-content">
            <div class="c-title">Enter code</div>
            <div class="c-text">Please verify your phone number to be able to sign in with it and to allow your friends to find your account in their list of contacts on @CoreConstants.AppName.</div>
            <TotpVerifier
                Purpose="TotpPurpose.VerifyPhone"
                Phone="@ModalModel.Phone"
                Verified="@(_ => Complete(true))"
                Error="@(_ => Complete(false, true))"/>
        </div>
    </Body>
</DialogFrame>

@code {
    [CascadingParameter] public Modal Modal { get; set; } = null!;
    [Parameter] public Model ModalModel { get; set; } = null!;

    private void Complete(bool isVerified, bool canSkip = false) {
        ModalModel.IsVerified = isVerified;
        ModalModel.CanSkip = canSkip;
        Modal.Close();
    }

    public sealed record Model(Phone Phone) {
        public bool IsVerified { get; set; }
        public bool CanSkip { get; set; }
    }
}
