@namespace ActualChat.UI.Blazor.App.Components
@using ActualChat.Media
@using ActualChat.UI.Blazor.Components.FileUpload
@using ActualLab.Generators
@inherits SimpleStep<AppUIHub>;

@if (CurrentStep != this) {
    return;
}

<div class="avatar-step">
    <p class="step-subtitle">@L.Onboarding_NameAndAvatar</p>
    <Form
        @ref="_formRef"
        Model="@_model">
        <DataAnnotationsValidator/>
        <div class="c-upload">
            <Pic
                Title="@_model.Name"
                Picture="@_model.Picture"
                Size="SquareSize.Size24"/>

            <div class="c-buttons">
                <Button Class="btn-modal btn-sm btn-transparent" Click="OnGenerateAvatarClick">
                    <Icon><i class="icon-sync text-xl text-primary"></i></Icon>
                    <Title>@L.Onboarding_GenerateAvatar</Title>
                </Button>
                <FileUpload
                    @key="@_model.AvatarId.Value"
                    id="fileUpload"
                    Scope="@MediaUploadScopes.ForAccount(AccountUI.OwnAccount.Value)"
                    MediaKind="@MediaKind.UserAvatarPicture"
                    Uploaded="OnImagePicked"
                    MaxSize="Constants.Attachments.AvatarPictureFileSizeLimit"
                    accept="@Constants.Attachments.AvatarPictureAccept"
                    hidden>
                </FileUpload>
                <Button Class="btn-modal btn-sm btn-transparent">
                    <Icon><i class="icon-image text-xl text-primary"></i></Icon>
                    <Title>
                        <label for="fileUpload" class="upload-label">@L.Onboarding_UploadPhoto</label>
                    </Title>
                </Button>
            </div>
        </div>
        <FormSection
            For="() => _model.Name"
            InputId="name"
            Label="@L.Form_Name"
            IsLabelInsideInput="true"
            IsRequired="true">
            <TextBox Id="name" @bind-Value="_model.Name" Autocomplete="name"/>
        </FormSection>
    </Form>
</div>

@code {
    private static RandomStringGenerator IdGenerator { get; } = new(10, Alphabet.AlphaNumeric);
    private readonly Model _model = new();
    private Form? _formRef;

    private IAccounts Accounts => Hub.Accounts;
    private IAvatars Avatars => Hub.Avatars;
    private OnboardingUI OnboardingUI => Hub.OnboardingUI;

    public override bool IsCompleted => OnboardingUI.UserSettings.Value.IsAvatarStepCompleted;

    protected override void MarkCompleted()
        => OnboardingUI.UpdateUserSettings(OnboardingUI.UserSettings.Value with { IsAvatarStepCompleted = true });

    protected override async Task OnInitializedAsync() {
        var account = await Accounts.GetOwn(Session, CancellationToken.None);
        _model.Name = account.Name;

        if (!account.Avatar.Id.IsEmpty) {
            _model.OriginalAvatar = await Avatars.GetOwn(Session, account.Avatar.Id, CancellationToken.None).Require();
            _model.Picture = account.Avatar.Picture!;
            _model.AvatarId = account.Avatar.Id;
            return;
        }

        var createAvatarCommand = new Avatars_Change {
            Session = Session,
            AvatarId = Symbol.Empty,
            ExpectedVersion = null,
            Change = Change.Create(AvatarDiff.FromFull(
            new AvatarFull(account.Id).WithMissingPropertiesFrom(account.Avatar))),
        };
        var (newAvatar, error) = await UICommander.Run(createAvatarCommand);
        if (error != null)
            return;

        _model.OriginalAvatar = newAvatar;
        _model.AvatarId = newAvatar.Id;
        _model.Picture = newAvatar.Picture! with { ExternalUrl = account.Avatar.PictureUrl };
        var setDefaultAvatarCommand = new Avatars_SetDefault { Session = Session, AvatarId = newAvatar.Id };
        await UICommander.Run(setDefaultAvatarCommand);
    }

    protected override Task<bool> Validate() {
        var isValid = _formRef?.EditContext?.Validate() ?? false;
        return Task.FromResult(isValid);
    }

    protected override async Task<bool> Save() {
        var account = await Accounts.GetOwn(Session, default);
        var updateAccountCommand = new Accounts_Update {
            Session = Session,
            Account = account with {
                Name = _model.Name,
            },
            ExpectedVersion = account.Version,
        };
        await UICommander.Run(updateAccountCommand);

        var updated = _model.OriginalAvatar.WithPicture(_model.Picture) with { Name = _model.Name.Trim() };
        var diff = DiffEngine.Diff<AvatarFull, AvatarDiff>(_model.OriginalAvatar, updated);
        var updateAvatarCommand = new Avatars_Change {
            Session = Session,
            AvatarId = _model.AvatarId,
            ExpectedVersion = null,
            Change = Change.Update(diff),
        };
        var (_, error) = await UICommander.Run(updateAvatarCommand);
        return error is null;
    }

    private void OnImagePicked(MediaRef mediaRef) {
        _model.Picture = new (mediaRef);
    }

    private void OnGenerateAvatarClick() {
        _model.Picture = new(null, null, DefaultUserPicture.GetAvatarKey(IdGenerator.Next()));
    }

    public class Model {
        [Required] public string Name { get; set; } = "";
        public Symbol AvatarId { get; set; } = "";
        public Picture Picture { get; set; } = null!;
        public AvatarFull OriginalAvatar { get; set; } = null!;
    }
}
