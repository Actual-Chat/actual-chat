@namespace ActualChat.UI.Blazor.App.Components
@inherits SimpleStep<AppUIHub>;

@if (CurrentStep != this) {
    return;
}

<div>
    @if (Stepper.CurrentStepIndex == 0) {
        <p class="step-title">@L.Onboarding_Welcome_Format(CoreConstants.AppName)</p>
    }
    <div class="analytics-step">
        <p class="c-subtitle">
            @* Telemetry Consent Request - the modal looks better w/o this title *@
        </p>
        <div class="c-content">
            <div>
                @L.Onboarding_Telemetry_Prefix(CoreConstants.AppName)<a
                    href="https://firebase.google.com/docs/analytics"
                    target="_blank">Firebase Analytics</a>@L.Onboarding_Telemetry_Middle<a
                    href="https://sentry.io/"
                    target="_blank">Sentry</a>@L.Onboarding_Telemetry_Suffix
            </div>
            <div><br/></div>
            <div>
                @L.Onboarding_TelemetryConsent_Format(CoreConstants.AppName)
            </div>
        </div>
    </div>

</div>

@code {
    private OnboardingUI OnboardingUI => Hub.OnboardingUI;
    private IDataCollectionSettingsUI DataCollectionSettingsUI => Hub.DataCollectionSettingsUI;

    [Parameter, EditorRequired] public bool IsConfigured { get; set; }

    public override bool CanSkip => true;
    public override string SkipTitle => L.Onboarding_DeclineTelemetry;
    public override string NextTitle => L.Onboarding_EnableTelemetry;
    public override bool IsCompleted
        => OnboardingUI.UserSettings.Value.IsDataCollectionStepCompleted || IsConfigured;

    protected override void MarkCompleted() {
        var settings = OnboardingUI.UserSettings.Value with { IsDataCollectionStepCompleted = true };
        OnboardingUI.UpdateUserSettings(settings);
    }

    protected override Task<bool> Validate()
        => Task.FromResult(true);

    protected override async Task<bool> Save() {
        await UpdateState(true);
        return true;
    }

    protected override async ValueTask OnSkip() {
        await UpdateState(false);
    }

    private async Task UpdateState(bool isEnabled) {
        var settings = await UserSettingsUI.UserAppSettings().Get(CancellationToken.None);
        settings = settings with { IsDataCollectionEnabled = isEnabled };
        await UserSettingsUI.UserAppSettings().Set(settings, CancellationToken.None);
        await DataCollectionSettingsUI.UpdateState(isEnabled, CancellationToken.None);
    }
}
