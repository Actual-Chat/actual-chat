@namespace ActualChat.UI.Blazor.App.Components
@inherits SimpleStep<AppUIHub>;
@if (CurrentStep != this) {
    return;
}

<div class="onboarding-tutorial tutorial-4">
    <img draggable="false" src="/dist/images/onboarding/tutorial-4.png" alt="Tutorial slide #4">
    <div class="c-title">
        <p>
            Surf and Chat
        </p>
        <p>
            easier with summarization
        </p>
    </div>
    <p class="c-description">
        Catch the key points of conversations and know what’s going on anytime
    </p>
</div>

@code {
    private OnboardingUI OnboardingUI => Hub.OnboardingUI;

    public override bool CanSkip => true;

    public override bool IsCompleted => OnboardingUI.UserSettings.Value.IsSummarizationStepCompleted;

    protected override void MarkCompleted()
        => OnboardingUI.UpdateUserSettings(OnboardingUI.UserSettings.Value with { IsSummarizationStepCompleted = true });

    protected override Task<bool> Validate()
        => Task.FromResult(true);

    protected override ValueTask OnSkip()
        => ValueTask.CompletedTask;

    protected override Task<bool> Save()
        => Task.FromResult(true);
}
