@namespace ActualChat.UI.Blazor.App.Components
@inherits ComponentBase<AppUIHub>
@{
    var pttCls = IsPttArmed ? "on" : "";
}

@* The text truncates on its own, so the PTT icon stays visible right after the ellipsis *@
<span class="chat-title @Class">
    <span class="c-text isolated-text" dir="auto">@Chat.Title</span>
    @if (PttState != PttChatState.Off) {
        <i class="c-ptt icon-push-to-talk @pttCls" data-tooltip="@GetPttTooltip()"></i>
    }
</span>

@code {
    [Parameter, EditorRequired] public Chat Chat { get; set; } = null!;
    [Parameter] public PttChatState PttState { get; set; }
    [Parameter] public bool IsPttArmed { get; set; }
    [Parameter] public bool IsPttOffOnDevice { get; set; }
    [Parameter] public string Class { get; set; } = "";

    private string GetPttTooltip()
        => PttState switch {
            PttChatState.Paused => L.Ptt_TooltipPaused,
            PttChatState.NotInList => L.Ptt_TooltipNotInList,
            _ when IsPttArmed => L.Ptt_TooltipInList,
            _ when IsPttOffOnDevice => L.Ptt_TooltipDeviceOff,
            _ => L.Ptt_TooltipMuted,
        };
}
