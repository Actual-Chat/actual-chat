@using ActualChat.Media
@using ActualChat.UI.Blazor.App.Module
@using ActualLab.Generators
@namespace ActualChat.UI.Blazor.App.Components
@inherits ComponentBase<AppUIHub>

<div class="c-top">
    <Pic
        Title="@Title"
        Picture="@Picture"
        Size="@SquareSize.SizeFull"
        IsSquare="@true"
        IsBlurred="@true"/>

    @if (CloseRequested.HasDelegate) {
        <ButtonRound Click="@CloseRequested" Class="btn-sm right-panel-close-btn close-btn">
            <i class="icon-close text-2xl"></i>
        </ButtonRound>
    }
</div>

<div class="c-center">
    <PicUpload
        Scope="@mediaScope"
        MediaKind="@MediaKind.UserAvatarPicture"
        IsSquare="false"
        Size="@SquareSize.Size16"
        Title="@Title"
        Picture="@Picture"
        Picked="@OnImagePicked"/>

    <div class="c-buttons">
        <PicUploadButton
            Scope="@mediaScope"
            MediaKind="@MediaKind.UserAvatarPicture"
            Picked="@OnImagePicked">
            <Icon>
                <i class="icon-image text-2xl"></i>
            </Icon>
        </PicUploadButton>

        <ButtonRound Class="btn-modal btn-sm" Click="@OnGenerateAvatarClick">
            <i class="icon-sync text-2xl"></i>
        </ButtonRound>
    </div>
</div>

@code {
    private static RandomStringGenerator IdGenerator { get; } = new(10, Alphabet.AlphaNumeric);

    private string mediaScope => MediaUploadScopes.ForAccount(AccountUI.OwnAccount.Value);

    [Parameter] public string Title { get; set; } = "";
    [Parameter] public Picture? Picture { get; set; }
    [Parameter] public EventCallback<Picture> ImagePicked { get; set; }
    [Parameter] public EventCallback CloseRequested { get; set; }

    private void OnImagePicked(MediaRef mediaRef)
        => ImagePicked.InvokeAsync(new Picture(mediaRef));

    private void OnGenerateAvatarClick()
        => ImagePicked.InvokeAsync(new Picture(null, null, DefaultUserPicture.GetAvatarKey(IdGenerator.Next())));
}
