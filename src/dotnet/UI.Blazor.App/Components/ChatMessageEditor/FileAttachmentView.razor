@namespace ActualChat.UI.Blazor.App.Components
@{
    var kind = FileTypeHelper.GetKind(FileName, FileType);
    var fileCls = FileTypeHelper.GetCssClass(kind);
    var iconCls = FileTypeHelper.GetIconClass(kind);
    var fileExtension = FileTypeHelper.GetDisplayExtension(FileName, FileType);
}

<div class="c-file">
    <div class="c-icon @fileCls">
        <i class="@iconCls text-2xl"></i>
        <span class="c-extension">@fileExtension.ToUpperInvariant()</span>
    </div>
</div>

@code {
    [Parameter] public string FileName { get; set; } = "";
    [Parameter] public string FileType { get; set; } = "";
}
