@using ActualChat.Media
@namespace ActualChat.UI.Blazor.App.Components
@{
    MediaMimeTypes.TryGetExtension(FileType, out var extension);
    var fileExtension = extension?.Replace(".", "") ?? "";
    var fileCls = FileTypeHelper.FileColors.GetValueOrDefault(fileExtension, "file-default");
}

<div class="c-file">
    <div class="c-icon @fileCls">
        @if (fileCls == FileTypeHelper.FileClasses[ActualChat.UI.Blazor.App.Components.FileType.Multimedia]) {
            <i class="icon-play-fill text-2xl"></i>
        } else {
            <i class="icon-file text-xl"></i>
        }
    </div>
    <span class="c-extension">@fileExtension.ToUpper()</span>
</div>

@code {
    [Parameter] public string FileType { get; set; } = "";
}
