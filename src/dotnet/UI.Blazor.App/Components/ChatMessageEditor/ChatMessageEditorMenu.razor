@namespace ActualChat.UI.Blazor.App.Components
@using ActualChat.Hosting
@using ActualChat.UI.Blazor.App.Events
@inherits MenuBase<ChatUIHub>

<div class="chat-message-editor-menu">
    @if (HostInfo.HostKind.IsMauiApp() && HostInfo.AppKind == AppKind.Android) {
        <MenuEntry
            Icon="icon-image"
            Text="Choose Photo"
            Click="@(() => OnAttachClick("image/*"))"/>

        <MenuEntry
            Icon="icon-video"
            Text="Select Video"
            Click="@(() => OnAttachClick("video/*"))"/>
    }
    <MenuEntry
        Icon="icon-file"
        Text="Attach File"
        Click="@(() => OnAttachClick())">
    </MenuEntry>
    <MenuEntry
        Icon="icon-at"
        Text="Mention Author"
        Click="@OnMentionClick">
    </MenuEntry>
</div>

@code {
    private async Task OnAttachClick(string acceptTypes = "") {
        await WhenClosed;
        _ = UIEventHub.Publish(new AttachButtonClickEvent(acceptTypes));
    }

    private async Task OnMentionClick() {
        await WhenClosed;
        _ = UIEventHub.Publish(new MentionButtonClickEvent());
    }
}
