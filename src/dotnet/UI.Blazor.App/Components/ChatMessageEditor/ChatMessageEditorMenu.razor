@namespace ActualChat.UI.Blazor.App.Components
@using ActualChat.Hosting
@using ActualChat.UI.Blazor.App.Events
@inherits Menu<AppUIHub>

<div class="chat-message-editor-menu">
    @if (HostInfo.HostKind.IsMauiApp()
        && HostInfo.AppKind is AppKind.Android or AppKind.Ios or AppKind.MacOS) {
        <MenuEntry
            Icon="icon-image"
            Text="@L.Editor_ChoosePhoto"
            Click="@(() => OnAttachClick("image/*"))"/>

        <MenuEntry
            Icon="icon-video"
            Text="@L.Editor_SelectVideo"
            Click="@(() => OnAttachClick("video/*"))"/>
    }
    <MenuEntry
        Icon="icon-status"
        Text="@L.Editor_AddEmoji"
        Click="@OnEmojiClick"/>

    <MenuEntry
        Icon="icon-gif"
        Text="@L.Editor_AddGif"
        Click="@OnGifClick"/>

    <MenuEntry
        Icon="icon-file"
        Text="@L.Editor_AttachFile"
        Click="@(() => OnAttachClick())"/>

    <MenuEntry
        Icon="icon-map-point"
        Text="@L.Editor_Location"
        Click="@OnShareLocationClick"/>

    <MenuEntry
        Icon="icon-at"
        Text="@L.Editor_Mention"
        Click="@OnMentionClick"/>
</div>

@code {
    private string EditorId => Arguments.Length > 0 ? Arguments[0] : "";

    private async Task OnAttachClick(string acceptTypes = "") {
        await WhenClosed.ConfigureAwait(false);
        _ = UIEventHub.Publish(new AttachButtonClickEvent(acceptTypes, EditorId));
    }

    private async Task OnMentionClick() {
        await WhenClosed.ConfigureAwait(false);
        _ = UIEventHub.Publish(new MentionButtonClickEvent(EditorId));
    }

    private async Task OnEmojiClick() {
        await WhenClosed.ConfigureAwait(false);
        _ = UIEventHub.Publish(new EmojiButtonClickEvent(EditorId));
    }

    private async Task OnGifClick() {
        await WhenClosed.ConfigureAwait(false);
        _ = UIEventHub.Publish(new EmojiButtonClickEvent(EditorId, "gif"));
    }

    private async Task OnShareLocationClick() {
        await WhenClosed.ConfigureAwait(false);
        _ = UIEventHub.Publish(new ShareLocationButtonClickEvent(EditorId));
    }
}
