@namespace ActualChat.UI.Blazor.App.Components

@if (IsPending) {
    <div class="image-quality-selector">
        @if (!_estimatesLoaded) {
            <div class="quality-chip quality-badge">
                <span class="quality-label">&nbsp;</span>
            </div>
        } else if (_options.Length <= 1) {
            <div class="quality-chip quality-badge">
                <span class="quality-label">Original only</span>
            </div>
        } else {
            @foreach (var option in _options) {
                var isSelected = option.Preset == Attachment.SelectedQuality;
                <button class="quality-chip @(isSelected ? "selected" : "")"
                        @onclick="() => SelectPreset(option.Preset)">
                    <span class="quality-label">@option.Label</span>
                    @if (option.EstimatedSize > 0) {
                        <span class="quality-size">@FormatSize(option.EstimatedSize)</span>
                    }
                </button>
            }
        }
    </div>
}

@code {
    private QualityOption[] _options = [];
    private CancellationTokenSource? _estimateCts;
    private Timer? _estimateTimer;
    private bool _estimatesLoaded;
    private AttachmentId _lastAttachmentId;

    [Parameter, EditorRequired] public Attachment Attachment { get; set; } = null!;
    [Parameter] public EventCallback<QualitySelection> OnPresetChanged { get; set; }

    private bool IsPending => Attachment is { IsResizableImage: true, IsUploadPending: true };

    protected override void OnParametersSet() {
        if (!IsPending)
            return;

        if (_lastAttachmentId != Attachment.Id) {
            _lastAttachmentId = Attachment.Id;
            if (Attachment.EstimatedSizes is { } cached && cached.Length == 3) {
                _options = BuildOptions(cached[0], cached[1], cached[2]);
                _estimatesLoaded = true;
                _estimateTimer?.Dispose();
                _estimateTimer = null;
            }
            else {
                _options = [];
                _estimatesLoaded = false;
                _estimateTimer?.Dispose();
                _estimateTimer = new Timer(
                    _ => _ = InvokeAsync(() => _ = EstimateSizes()),
                    null,
                    TimeSpan.FromMilliseconds(300),
                    System.Threading.Timeout.InfiniteTimeSpan);
            }
        }
        else if (!_estimatesLoaded && Attachment.EstimatedSizes is { } lateCached && lateCached.Length == 3) {
            _options = BuildOptions(lateCached[0], lateCached[1], lateCached[2]);
            _estimatesLoaded = true;
            _estimateTimer?.Dispose();
            _estimateTimer = null;
        }
    }

    private async Task EstimateSizes() {
        _estimateCts?.Cancel();
        _estimateCts = new CancellationTokenSource();

        if (Attachment.FileProvider is not WebFileProvider webFileProvider)
            return;

        try {
            var presets = new ImageResizePreset[] {
                new((int)ImageQualityPreset.Maximum),
                new((int)ImageQualityPreset.Medium),
                new((int)ImageQualityPreset.Small),
            };
            var results = await webFileProvider.EstimateResizedSizes(presets);
            if (_estimateCts.IsCancellationRequested)
                return;

            _options = BuildOptions(results[0], results[1], results[2]);
        }
        catch {
            // Estimation failed — show original only.
        }
        _estimatesLoaded = true;
        StateHasChanged();
    }

    private static QualityOption[] BuildOptions(
        ImageResizeResult maximum, ImageResizeResult medium, ImageResizeResult small)
    {
        var options = new[] {
            new QualityOption(ImageQualityPreset.Maximum, "Maximum", maximum.Size),
            new QualityOption(ImageQualityPreset.Medium, "Medium", medium.Size),
            new QualityOption(ImageQualityPreset.Small, "Small", small.Size),
        };
        return options.Where(o =>
            o.Preset == ImageQualityPreset.Maximum || o.EstimatedSize < options[0].EstimatedSize * 0.9
        ).ToArray();
    }

    private async Task SelectPreset(ImageQualityPreset preset) {
        var estimatedSize = _options.FirstOrDefault(o => o.Preset == preset)?.EstimatedSize ?? 0;
        await OnPresetChanged.InvokeAsync(new QualitySelection(preset, estimatedSize));
    }

    private static string FormatSize(long bytes) => bytes switch {
        < 1024 => $"{bytes} B",
        < 1024 * 1024 => $"{bytes / 1024.0:F0} KB",
        _ => $"{bytes / (1024.0 * 1024.0):F1} MB",
    };

    private record QualityOption(ImageQualityPreset Preset, string Label, long EstimatedSize);

    public record QualitySelection(ImageQualityPreset Preset, long EstimatedSize);
}
