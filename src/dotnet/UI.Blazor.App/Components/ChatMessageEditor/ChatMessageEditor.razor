@namespace ActualChat.UI.Blazor.App.Components
@using ActualChat.UI.Blazor.App.Events
@using ActualChat.UI.Blazor.App.Module
@using ActualChat.Kvas
@using ActualLab.Locking
@using ActualChat.Pooling
@using System.Diagnostics.CodeAnalysis
@inherits ComponentBase<AppUIHub>
@implements IAttachmentWebFilePickerBackend
@implements IAsyncDisposable
@{
    var placeholder = ScreenSize.IsNarrow() ? "Message..." : "Write a message - or simply record one!";

    RenderFragment RenderAttachmentListView() =>
        @<AttachmentListView
             @key="AttachmentListKey"
             AttachmentListHolder="@_attachmentListHolder"
             OnSendClick="@(() => Post())"
             OnAddClick="@(() => OnAttachClick(""))"/>;
}

<OnUIEvent TEvent="@FocusChatMessageEditorEvent" Handler="OnFocusChatMessageEditorEvent" />
<OnUIEvent TEvent="@EditChatMessageEvent" Handler="OnEditChatMessageEvent" />
<OnUIEvent TEvent="@CancelChatMessageEditEvent" Handler="OnCancelChatMessageEditEvent" />
<OnUIEvent TEvent="@AttachButtonClickEvent" Handler="OnAttachButtonClickEvent" />
<OnUIEvent TEvent="@MentionButtonClickEvent" Handler="OnMentionButtonClickEvent" />
<div @ref="Ref" class="chat-message-editor">
    <input class="attachment-web-file-picker" type="file" hidden multiple/>
    <MentionListManager @key="@MentionListManagerKey" SearchProvider="@ChatMarkupHub.MentionSearchProvider">
        @if (ScreenSize.IsWide()) {
            @RenderAttachmentListView()
            <RelatedChatEntryPanel/>
        }
        <div class="c-content">
            <div class="post-panel"
                 data-bubble="@(BubbleRef.New<TextMessagePanelBubble>())"
                 data-bubble-priority="150"
                 data-bubble-placement="@(FloatingPosition.Top.ToPositionString())">
                <div class="c-left-buttons">
                    <ButtonRound
                        data-menu="@(MenuRef.New<ChatMessageEditorMenu>())"
                        data-menu-trigger="@MenuTrigger.Primary"
                        data-menu-placement="@(FloatingPosition.Top.ToPositionString())"
                        Class="post-panel-btn attach-btn btn-transparent btn-xxs">
                        <i class="icon-plus-circle text-2.5xl"></i>
                    </ButtonRound>
                </div>
                <label for="message-input" class="message-input-label">
                    <MarkupEditor
                        @key="MarkupEditorKey"
                        @ref="MarkupEditorRef"
                        MentionNamer="@ChatMarkupHub.MentionNamer"
                        HtmlConverter="@ChatMarkupHub.EditorHtmlConverter"
                        Id="message-input"
                        Class="message-input -flex-y"
                        Autofocus="Autofocus"
                        Placeholder="@placeholder"
                        Post="text => Post(text)"
                        Cancel="@(() => OnCancel())"
                        OpenPrevious="OnOpenPrevious"/>
                </label>
                <div class="c-right-buttons">
                    <NotifyAllButton Chat="@Chat"/>
                    <div class="c-incut"></div>
                    <button class="post-panel-btn post-message btn btn-round btn-transparent btn-xs"
                            @onmousedown="@(_ => Post())"
                            @onmousedown:preventDefault="true">
                        <i class="icon-paper-plane"></i>
                    </button>
                </div>
            </div>
            @if (ScreenSize.IsNarrow()) {
                @RenderAttachmentListView()
                <div class="rounded-sub-footer"></div>
                <RelatedChatEntryPanel/>
            }
            <ChatAudioPanel Chat="@Chat"/>
        </div>
    </MentionListManager>
</div>

@code {
    private static readonly string JSCreateMethod = $"{BlazorUIAppModule.ImportName}.ChatMessageEditor.create";

    private static object MentionListManagerKey { get; } = new();
    private static object AttachmentListKey { get; } = new();
    private static object MarkupEditorKey { get; } = new();

    private readonly AsyncLock _postLock = new(LockReentryMode.CheckedFail);
    private AttachmentListHolder _attachmentListHolder = null!;
    private bool _hasAttachments;
    private bool Autofocus => ScreenSize.IsWide() && !BrowserInfo.IsTouchCapable;
    private IJSObjectReference JSRef { get; set; } = null!;
    private DotNetObjectReference<IAttachmentWebFilePickerBackend> BlazorRef { get; set; } = null!;
    private ElementReference Ref { get; set; }
    private MarkupEditor MarkupEditorRef { get; set; } = null!;
    private IChatMarkupHub ChatMarkupHub { get; set; } = null!;
    private SharedResourcePool<ChatId, SyncedState<ReadPosition>>.Lease? ReadPositionStateLease { get; set; }
    private SentAttachmentsStorage? AttachmentsStorage { get; set; }

    private KeyedFactory<IChatMarkupHub, ChatId> ChatMarkupHubFactory => Hub.ChatMarkupHubFactory;
    private ChatUI ChatUI => Hub.ChatUI;
    private ChatEditorUI ChatEditorUI => Hub.ChatEditorUI;
    private SearchUI SearchUI => Hub.SearchUI;
    private BrowserInfo BrowserInfo => Hub.BrowserInfo;
    private SendingMessages SendingMessages => Hub.SendingMessages;
    private FileAttachments FileAttachments { get; set; } = null!;
    private IAttachmentFilePicker? AttachmentFilePicker { get; set; }

    [Parameter, EditorRequired] public Chat Chat { get; set; } = null!;
    [CascadingParameter] public ScreenSize ScreenSize { get; set; }

    [DynamicDependency(DynamicallyAccessedMemberTypes.All, typeof(ChatMessageEditor))]
    public ChatMessageEditor() { }

    protected override void OnInitialized() {
        _attachmentListHolder = new AttachmentListHolder(Hub, Chat.Id);
        _attachmentListHolder.Changed += OnAttachmentListChanged;
        FileAttachments =  new FileAttachments(Hub);
        AttachmentFilePicker = Hub.Services.GetService<IAttachmentFilePicker>();
    }

    public async ValueTask DisposeAsync() {
        if (AttachmentsStorage != null)
            AttachmentsStorage.AttachmentsStored -= OnAttachmentsStored;
        AttachmentsStorage = null;
        await JSRef.DisposeSilentlyAsync("dispose");
        JSRef = null!;
        ReadPositionStateLease.DisposeSilently();
        ReadPositionStateLease = null!;
        BlazorRef.DisposeSilently();
        BlazorRef = null!;
    }

    protected override async Task OnParametersSetAsync() {
        var chatId = Chat.Id;
        var oldChatId = ((IChatMarkupHub?)ChatMarkupHub)?.ChatId ?? default; // ChatMarkupHub == null on the very first call
        if (oldChatId == chatId)
            return;

        ChatMarkupHub = ChatMarkupHubFactory[chatId];
        ReadPositionStateLease.DisposeSilently();
        ReadPositionStateLease = null;
        ReadPositionStateLease = await ChatUI.LeaseReadPositionState(chatId, default);

        if (JSRef != null!) {
            // Only when rendered
            await _attachmentListHolder.Attachments.Clear();
            await UpdateChatId();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (firstRender) {
            BlazorRef = DotNetObjectReference.Create<IAttachmentWebFilePickerBackend>(this);
            JSRef = await JS.InvokeAsync<IJSObjectReference>(JSCreateMethod, Ref, BlazorRef);
            await MarkupEditorRef.WhenReady;
            if (JSRef == null! || MarkupEditorRef.JSRef == null!)
                return; // Dispose may happen during await above

            await JSRef.InvokeVoidAsync("onNestedControlsReady", MarkupEditorRef.JSRef);
            await UpdateChatId();
            await ChatEditorUI.RestoreRelatedEntry(Chat.Id);
            if (JSRef == null! || MarkupEditorRef.JSRef == null!)
                return; // Dispose may happen during await above

            AttachmentsStorage = Hub.Services.GetRequiredService<SentAttachmentsStorage>();
            if (AttachmentsStorage.ChatId == Chat.Id && AttachmentsStorage.HasFiles)
                await SetAttachments(AttachmentsStorage);
            AttachmentsStorage.AttachmentsStored += OnAttachmentsStored;
        }
    }

    [JSInvokable]
    public async Task OnFilePicked(WebFileInfo[] fileInfos) {
        foreach (var fileInfo in fileInfos) {
            _ = await FileAttachments.TryAddWebFileAttachment(
                _attachmentListHolder,
                fileInfo.Id,
                fileInfo.FileName,
                fileInfo.FileType,
                fileInfo.Size);
        }
    }

    // Private methods

    private async Task Post(string? text = null) {
        using var releaser = await _postLock.Lock();
        releaser.MarkLockedLocally();

        text ??= await MarkupEditorRef.GetText();
        text = text.Trim();

        var attachmentListSnapshot = _attachmentListHolder.PopSnapshot();
        if (text.IsNullOrEmpty() && attachmentListSnapshot.Attachments.Count == 0) {
            await attachmentListSnapshot.DisposeAsync();
            return;
        }

        _ = TuneUI.Play(Tune.SendMessage);
        var clearMarkupTask = MarkupEditorRef.Clear();
        try {
            var relatedChatEntry = ChatEditorUI.RelatedEntryRef.Value;
            var relatedChatEntryId = relatedChatEntry?.EntryId;
            await ChatEditorUI.HideRelatedEntry(false);

            PostMessageRequest cmd;
            if (relatedChatEntry is { Kind: RelatedEntryKind.Edit }) {
                if (relatedChatEntryId is null)
                    throw new InternalError("Invalid ChatUI.RelatedChatEntry value.");
                cmd = new PostMessageRequest(relatedChatEntryId.ChatId, relatedChatEntryId.LocalId, text);
            } else {
                var repliedEntryLid = relatedChatEntryId?.LocalId;
                cmd = new PostMessageRequest(Chat.Id, null, text) {
                    RepliedEntryLid = repliedEntryLid,
                    Attachments = attachmentListSnapshot.Attachments,
                };
            }
            var postTask = await SendingMessages.Post(cmd, CancellationToken.None);
            _ = ForegroundTask.Run(async () => {
                try {
                    var chatEntry = await postTask.ConfigureAwait(true);
                    var readEntryLid = chatEntry.LocalId;
                    var readPositionState = ReadPositionStateLease?.Resource;
                    if (readPositionState != null && readPositionState.Value.EntryLid < readEntryLid)
                        readPositionState.Value = new ReadPosition(Chat.Id, readEntryLid);
                }
                catch (OperationCanceledException) {
                    // Ignore send message cancellation.
                }
                catch (Exception e) {
                    UICommander.ShowError(e);
                    await attachmentListSnapshot.Rollback();
                    await MarkupEditorRef.SetText(text);
                }
                finally {
                    await attachmentListSnapshot.DisposeAsync();
                }
            });
            //await AttachmentListRef.Clear();
            SearchUI.Clear();
            await clearMarkupTask;
        }
        catch (Exception e) {
            UICommander.ShowError(e);
            await clearMarkupTask.SilentAwait();
            await attachmentListSnapshot.Rollback();
            await MarkupEditorRef.SetText(text);
            await attachmentListSnapshot.DisposeAsync();
        }
    }

    private async Task Edit(ChatEntry chatEntry, CancellationToken cancellationToken)
    {
        await ChatEditorUI.ShowRelatedEntry(RelatedEntryKind.Edit, chatEntry, focusOnEditor: true);
        await MarkupEditorRef.SetText(chatEntry.Content, mustFocus: false);
    }

    private ValueTask UpdateChatId()
        => JSRef.InvokeVoidAsync("setChatId", Chat.Id.Value);

    private async Task OnMentionButtonClick() {
        await MarkupEditorRef.WhenReady;
        await MarkupEditorRef.JSRef.InvokeVoidAsync("beginMention");
    }

    private async Task OnAttachClick(string acceptTypes) {
        if (AttachmentFilePicker is not null) {
            var files = await AttachmentFilePicker.PickFiles(acceptTypes);
            await OnAttachFilesPicked(files);
        } else {
            await JSRef.InvokeVoidAsync("showWebFilePickerDialog", acceptTypes);
        }
    }

    private void OnAttachmentListChanged(object? sender, EventArgs e) {
        var lastHasAttachments = _hasAttachments;
        var hasAttachments = _attachmentListHolder.Attachments.Count > 0;
        _hasAttachments = hasAttachments;
        if (hasAttachments != lastHasAttachments)
            _ = NotifyAttachmentListChanged(hasAttachments);
    }

    private async Task NotifyAttachmentListChanged(bool hasAttachments)
        => await JSRef.InvokeVoidAsync("notifyAttachmentListChanged", hasAttachments);

    // Event handlers

    private Task OnOpenPrevious()
        => ChatEditorUI.EditLast(Chat.Id);

    private async Task OnCancel(CancellationToken cancellationToken = default)
    {
        await ChatEditorUI.HideRelatedEntry();
        await MarkupEditorRef.Clear(mustFocus: true);
    }

    private void OnAttachmentsStored(object? sender, EventArgs e) {
        var attachmentsStorage = AttachmentsStorage;
        if (attachmentsStorage != null && attachmentsStorage.ChatId == Chat.Id && attachmentsStorage.HasFiles)
            _ = Handle();

        async Task Handle() {
            await SetAttachments(attachmentsStorage);
            PanelsUI.HidePanels();
        }
    }

    private async Task SetAttachments(SentAttachmentsStorage attachmentsStorage)
    {
        var fileInfos = attachmentsStorage.Pop();
        foreach (var fileInfo in fileInfos) {
            await FileAttachments.TryAddFileAttachment(_attachmentListHolder, fileInfo);
        }
    }

    private async Task OnAttachFilesPicked(AttachFileInfo[] files) {
        foreach (var fileInfo in files) {
            await FileAttachments.TryAddFileAttachment(_attachmentListHolder, fileInfo);
        }
    }

    // UIEventHub event handlers

    private async Task OnFocusChatMessageEditorEvent(FocusChatMessageEditorEvent @event, CancellationToken cancellationToken)
        => await MarkupEditorRef.Focus();

    private async Task OnEditChatMessageEvent(EditChatMessageEvent @event, CancellationToken cancellationToken) {
        var chatEntry = @event.Entry;
        if (chatEntry.IsStored()) {
            var chatSendingMessages = SendingMessages.GetSendingMessages(chatEntry.ChatId);
            chatEntry = await chatSendingMessages.GetSelfOrEdited(chatEntry);
        }
        await Edit(chatEntry, cancellationToken);
    }

    private Task OnCancelChatMessageEditEvent(CancelChatMessageEditEvent @event, CancellationToken cancellationToken)
        => OnCancel(cancellationToken);

    private Task OnAttachButtonClickEvent(AttachButtonClickEvent @event, CancellationToken cancellationToken)
        => OnAttachClick(@event.AcceptTypes);

    private Task OnMentionButtonClickEvent(MentionButtonClickEvent @event, CancellationToken cancellationToken)
        => OnMentionButtonClick();
}
