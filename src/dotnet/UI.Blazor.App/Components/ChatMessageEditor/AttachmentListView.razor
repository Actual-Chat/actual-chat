@inherits ComponentBase<AppUIHub>
@implements IDisposable
@namespace ActualChat.UI.Blazor.App.Components
@{
    var attachments = Attachments;
    var selectedId = attachments.SelectedId;
    var selectedAttachment = attachments.Items.FirstOrDefault(a => a.Id == selectedId && a.IsUploadPending)
        ?? attachments.Items.FirstOrDefault(a => a.IsUploadPending);
    selectedId = selectedAttachment?.Id ?? default;
}

@if (attachments.Count > 0) {
    <div class="attachment-list-wrapper">
        <div class="c-btn-group">
            <Button Class="attachment-list-btn btn-danger btn-transparent unhovered c-remove" Click="_ => Clear()">
                Remove all
            </Button>
            <Button Class="attachment-list-btn btn-primary btn-transparent unhovered c-send" Click="OnSendClick">
                Send @attachments.Count @("file".Pluralize(attachments.Count))
            </Button>
        </div>
        <HeaderButton Class="remove-all-btn" Click="_ => Clear()">
            <i class="icon-trash03 text-xl text-danger"></i>
        </HeaderButton>
        <ul class="attachment-list">
            @foreach (var attachment in attachments.Items) {
                <AttachmentItem
                    @key="attachment.Id"
                    Attachment="@attachment"
                    IsSelected="@(attachment.Id == selectedId)"
                    OnClick="@(() => OnItemClick(attachment))"
                    RestartClick="@(() => OnRestartClick(attachment))"
                    RemoveClick="@(() => OnRemoveClick(attachment))"/>
            }
            @if (attachments.Count < 10) {
                <li class="attachment-wrapper last-element">
                    <ButtonRound Class="add-attachment" Click="@OnAddClick">
                        <i class="icon-plus text-2xl"></i>
                    </ButtonRound>
                </li>
            }
        </ul>
        @if (selectedAttachment != null) {
            <ImageQualitySelector @ref="_qualitySelector"
                Attachment="@selectedAttachment"
                OnPresetChanged="@OnPresetChanged"/>
        }
        @if (attachments.Count > 1) {
            <div class="attachment-total-size">
                Total: @FormatSize(attachments.Items.Sum(a => a.Length))
            </div>
        }
        <HeaderButton Class="close-keyboard-btn">
            <i class="icon-chevron-up text-2xl text-03"></i>
        </HeaderButton>
    </div>
}

@code {
    private AttachmentListHolder? _holder;
    private ImageQualitySelector? _qualitySelector;

    [Parameter] public EventCallback OnSendClick { get; set; }
    [Parameter] public EventCallback OnAddClick { get; set; }
    [Parameter] public AttachmentListHolder AttachmentListHolder { get; set; } = null!;
    [Parameter] public FileAttachments? FileAttachments { get; set; }

    private AttachmentList Attachments => _holder!.Attachments;

    [DynamicDependency(DynamicallyAccessedMemberTypes.All, typeof(AttachmentListView))]
    public AttachmentListView() { }

    protected override void OnParametersSet() {
        if (_holder is null) {
            _holder = AttachmentListHolder;
            _holder.Changed += OnAttachmentListChanged;
        }
        else if (_holder != AttachmentListHolder)
            throw StandardError.Constraint("Holder can't be changed");
    }

    public void Dispose() {
        if (_holder is not null)
            _holder.Changed -= OnAttachmentListChanged;
    }

    private void OnAttachmentListChanged(object? sender, EventArgs e)
        => StateHasChanged();

    public Task Clear()
        => Attachments.Clear();

    private Task OnRemoveClick(Attachment attachment)
        => Attachments.Remove(attachment);

    private Task OnRestartClick(Attachment attachment)
        => Attachments.Restart(attachment);

    private void OnItemClick(Attachment attachment) {
        if (attachment.IsUploadPending)
            Attachments.Select(attachment.Id);
    }

    private void OnPresetChanged(ImageQualitySelector.QualitySelection selection) {
        var selected = Attachments.Items.FirstOrDefault(a => a.Id == Attachments.SelectedId);
        if (selected is { IsUploadPending: true }) {
            var newLength = selection.Preset == ImageQualityPreset.Original
                ? selected.OriginalLength
                : selection.EstimatedSize > 0 ? selection.EstimatedSize : selected.Length;
            var updated = selected with {
                SelectedQuality = selection.Preset,
                Length = newLength,
            };
            Attachments.Replace(selected, updated);
        }
    }

    private static string FormatSize(long bytes) => bytes switch {
        < 1024 => $"{bytes} B",
        < 1024 * 1024 => $"{bytes / 1024.0:F0} KB",
        _ => $"{bytes / (1024.0 * 1024.0):F1} MB",
    };
}
