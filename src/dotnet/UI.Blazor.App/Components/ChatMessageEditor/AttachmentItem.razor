@namespace ActualChat.UI.Blazor.App.Components
@using ActualChat.Time
@inherits AttachmentItemBase

@{
    var m = State.Value;
    var attachment = m.Attachment;
    var progress = m.Progress;
    // NOTE: For attachment item preview state should always be in OK state, so we can use previewUrl.
    var previewUrl = m.Preview.PreviewUrl;
    var isUploading = progress.IsInProgress;
    var isFailed = progress.IsFailed;
    var plugClass = progress.IsReady ? "" : "blurred-plug";
    var isFile = !(attachment.IsSupportedImage || m.HasCustomPreview || attachment.IsSupportedVideo);
}
<li class="attachment-wrapper @(isFailed ? "attachment-failed" : "")">
    <div class="c-content">
        <div class="attachment-item">
            <ButtonSquare Click="@RemoveClick" Class="remove-attachment-btn btn-danger btn-sm">
                <i class="icon-close text-lg"></i>
            </ButtonSquare>
            @if (attachment.IsSupportedImage || m.HasCustomPreview) {
                <img src="@previewUrl" alt="@L.Editor_Attachment" class="@plugClass"/>
            } else if (attachment.IsSupportedVideo) {
                <video preload="metadata" class="@plugClass">
                    <source src="@previewUrl#t=0.5"/>
                </video>
                @if (attachment.DurationMs > 0) {
                    <div class="c-duration">@TimeSpan.FromMilliseconds(attachment.DurationMs).Format(TimeSpanFormat.Clock)</div>
                }
            } else {
                <FileAttachmentView FileName="@attachment.FileName" FileType="@attachment.FileType"/>
            }
            @if (!progress.IsReady) {
                <span class="spinner-icon-wrapper">
                    @if (isUploading) {
                        <img src="/dist/images/loading-spinner.svg" class="spinner-icon animate-spin" alt="loading"/>
                    } else if (progress.IsFailed && !m.NoAccess && RestartClick.HasDelegate) {
                        <ButtonRound Click="@RestartClick">
                            <i class="icon-sync text-2xl"></i>
                        </ButtonRound>
                    }
                </span>
            }
            @if (progress.IsInProgress && progress.UploadSize > 0) {
                <div class="attachment-upload-size">@FileSizeFormatter.FormatProgress(progress.UploadProgress, progress.UploadSize)</div>
            }
            @if (isFailed) {
                <span class="attachment-error">Error</span>
            }
        </div>
        @if (isFile) {
            <div class="attachment-filename" title="@attachment.FileName">
                @if (attachment.FileName.Length > 0) {
                    <span>@attachment.FileName</span>
                } else {
                    <span>&nbsp;</span>
                }
            </div>
        }
    </div>
</li>
