@using ActualChat.Contacts
@using ActualChat.UI.Blazor.Events
@namespace ActualChat.UI.Blazor.App.Components
@implements IModalView<AuthorModal.Model>
@inherits ComputedStateComponent<AppUIHub, AuthorModal.ComputedModel?>
@{
    var m = State.Value;
    if (m is null)
        return;

    if (m.Author is not { } author) {
        // No author = we need to close the modal
        if (!_isAutoClosed) {
            _isAutoClosed = true;
            Modal.Close();
        }
        return;
    }

    var cls = "author-modal modal-sm";
    var title = "User profile";
    if (m.IsOwnAuthor)
        title = "Your profile";
    else if (author.IsAnonymous)
        title = "Anonymous profile";
    else
        cls += " wide-dialog-buttons";

    var tileCls = "anonymous-chat-toggle";
    if (m.OnlyAnonymousChatAllowed)
        tileCls += " unhovered tile-selected";
    var toggleValue = m.OnlyAnonymousChatAllowed || _anonymousChat;
    EventCallback onEditClick = default;
    if (m.IsOwnAuthor) {
        if (!author.IsAnonymous)
            onEditClick = EventCallback.Factory.Create(this, OnSettingsClick);
    } else if (m.PeerChatContact is { IsRegular: true }) {
        onEditClick = EventCallback.Factory.Create(this, _ => OnEditPeerContactClick(m.PeerChatContact));
    }
}

<DialogFrame Title="@title" Class="@cls" HasCloseButton="true">
    <Body>
    <AuthorModalHeader
        Author="author"
        IsOwn="m.IsOwnAuthor"
        OnEditClick="@onEditClick"/>
    <FormBlock>
        <AuthorModalContent
            Author="@author"
            IsOwn="@m.IsOwnAuthor"
            UsePlaceSettingsToEditMember="@m.UsePlaceSettingsToEditMember"
            EditMemberModel="@m.EditMemberModel"/>
    </FormBlock>
    </Body>
    <Buttons>
        @if (m.IsOwnAuthor) {
            if (!author.IsAnonymous) {
                <Button Class="btn-modal btn-primary" Click="OnChangeAvatarClicked">
                    <Icon><i class="icon-sync text-lg"></i></Icon>
                    <Title>Change avatar</Title>
                </Button>
            } else {
                <Button Class="btn-modal" Click="@(_ => OnEditAvatarClick(author))">
                    <Icon><i class="icon-sync text-lg md:hidden"></i></Icon>
                    <Title>Edit avatar</Title>
                </Button>
                <Button Class="btn-modal btn-danger" Click="OnRevealClicked">
                    <Icon><i class="icon-eye text-xl md:hidden"></i></Icon>
                    <Title>Reveal</Title>
                </Button>
            }
        } else if (author.IsAnonymous) {
            <Button Class="btn-modal btn-primary" Click="OnCancel">OK</Button>
        } else {
            @if (m.CanStartPeerChat) {
                var authorName = author?.Avatar.Name ?? "";
                if (!m.OnlyAnonymousChatAllowed) {
                    if (Features_EnableAnonymousChat.IsEnabled && _anonymousChat) {
                        <Button Class="btn-modal btn-primary anonymous-chat-btn" Click="OnStartAnonymousPeerChat">
                            <i class="icon-question-mark-bubble text-xl"></i>
                            <span class="c-title">
                                <span>Chat with</span>
                                <span class="c-name">@authorName</span>
                            </span>
                        </Button>
                    } else {
                        <Button
                            Class="btn-modal btn-primary start-chat-btn"
                            Click="OnStartPeerChat">
                            <i class="icon-message-ellipse text-xl"></i>
                            <span class="c-title">
                                <span>Chat with</span>
                                <span class="c-name">@authorName</span>
                            </span>
                        </Button>
                    }
                } else {
                    if (Features_EnableAnonymousChat.IsEnabled && m.EnableIncompleteUI) {
                        <Button Class="btn-modal btn-primary anonymous-chat-btn" Click="OnStartAnonymousPeerChat">
                            <i class="icon-question-mark-bubble text-xl"></i>
                            <span class="c-title">
                                <span>Chat with</span>
                                <span class="c-name">@authorName</span>
                            </span>
                        </Button>
                    }
                }

                @if (Features_EnableAnonymousChat.IsEnabled && m.EnableIncompleteUI) {
                    <div class="tile-wrapper">
                        <div class="c-incut @(toggleValue ? "show" : "")">
                            <div class="c-info">
                                <i class="icon-alert-triangle text-lg text-warning"></i>
                                <span>
                                    Anonymous chats hide user identities and don't transmit or record your voice, though still
                                    show real-time transcription. And you can reveal you real identity there at any moment.
                                </span>
                            </div>
                        </div>

                        <TileItem Click="@OnChatTypeChanged" Class="@tileCls">
                            <Content>
                                Anonymous chat
                            </Content>
                            <Caption>
                                Chat can be direct or anonymous.
                            </Caption>
                            <Right>
                                <Toggle Class="mr-2"
                                        IsChecked="@toggleValue"
                                        IsDisabled="@m.OnlyAnonymousChatAllowed"
                                        IsCheckedChanged="@(_ => OnChatTypeChanged())"/>
                            </Right>
                        </TileItem>
                    </div>
                }
            } else {
                <Button Class="btn-modal" Click="OnCancel">Close</Button>
            }
        }
    </Buttons>
</DialogFrame>

@code {
    private bool _isAutoClosed;
    private bool _anonymousChat;

    private IChats Chats => Hub.Chats;
    private IAuthors Authors => Hub.Authors;
    private IContacts Contacts => Hub.Contacts;
    private AuthorUI AuthorUI => Hub.AuthorUI;

    private AuthorId AuthorId => ModalModel.AuthorId;  // Shortcut
    private ChatId ChatId => AuthorId.ChatId; // Shortcut

    [CascadingParameter] public Modal Modal { get; set; } = null!;
    [Parameter] public Model ModalModel { get; set; } = null!;

    protected override async Task<ComputedModel?> ComputeState(CancellationToken cancellationToken) {
        var authorId = AuthorId;
        var chatId = ChatId;

        var session = Session;
        var author = await Authors.Get(session, chatId, authorId, cancellationToken).ConfigureAwait(false);
        if (author == null)
            return ComputedModel.None;

        var chat = await Chats.Get(session, chatId, cancellationToken).ConfigureAwait(false);
        var ownAuthor = await Authors.GetOwn(session, chatId, cancellationToken).ConfigureAwait(false);
        var account = await Authors.GetAccount(session, chatId, authorId, cancellationToken).ConfigureAwait(false);
        var peerChatId = await AuthorUI.GetPeerChatId(authorId, cancellationToken).ConfigureAwait(false);
        Contact? peerChatContact = null;
        if (peerChatId is not null)
            peerChatContact = await Contacts.GetForChat(session, peerChatId, cancellationToken).ConfigureAwait(false);

        var enableIncompleteUI = await Features.IsIncompleteUIEnabled(cancellationToken).ConfigureAwait(false);

        var onlyAnonymousChatAllowed = chat is { Kind: ChatKind.Peer };

        EditChatMemberModel? editMemberModel = null;
        var usePlaceSettingsToEditMember = false;
        if (chat != null && chat.Rules.CanEditMembers()) {
            if (chat.IsPublicPlaceChat())
                usePlaceSettingsToEditMember = true;
            else
                editMemberModel = await EditChatMemberCommands.ComputeState(Hub, authorId, cancellationToken).ConfigureAwait(false);
        }

        return new() {
            Author = author,
            Account = account,
            IsOwnAuthor = ownAuthor is not null && ownAuthor.Id == author.Id,
            PeerChatId = peerChatId,
            PeerChatContact = peerChatContact,
            OnlyAnonymousChatAllowed = onlyAnonymousChatAllowed,
            UsePlaceSettingsToEditMember = usePlaceSettingsToEditMember,
            EditMemberModel = editMemberModel,
            EnableIncompleteUI = enableIncompleteUI,
        };
    }

    private void OnCancel()
        => Modal.Close();

    private async Task OnRevealClicked() {
        var revealed = false;
        var modelRef = await ModalUI.Show(new AvatarSelectModal.RevealModel(ChatId, SetAvatar));
        await modelRef.WhenClosed;
        if (revealed)
            Modal.Close();

        async Task SetAvatar(AvatarFull avatar) {
            var command = new Authors_SetAvatar(Session, ChatId, avatar.Id);
            await UICommander.Run(command);
            revealed = true;
        }
    }

    private async Task OnChangeAvatarClicked() {
        Modal.Close();
        await ModalUI.Show(new AvatarSelectModal.Model(AuthorId.ChatId, false, OnAvatarSelected));
    }

    private void OnChatTypeChanged() {
        _anonymousChat = !_anonymousChat;
        StateHasChanged();
    }

    private Task OnStartPeerChat()
        => AuthorUI.StartPeerChat(AuthorId);

    private Task OnStartAnonymousPeerChat()
        => AuthorUI.StartAnonymousPeerChat(AuthorId);

    private async Task OnAvatarSelected(AvatarFull avatar) {
        var command = new Authors_SetAvatar(Session, AuthorId.ChatId.GetThreadOutermostParentOrSelf(), avatar.Id);
        await UICommander.Run(command);
    }

    private void OnSettingsClick() {
        Modal.Close();
        _ = UIEventHub.Publish(new ShowSettingsEvent());
    }

    private void OnEditAvatarClick(Author author) {
        Modal.Close();
        _ = ModalUI.Show(new OwnAvatarEditorModal.Model(author.Avatar.Id, author.ChatId, "Edit avatar"));
    }

    private void OnEditPeerContactClick(Contact contact) {
        Modal.Close();
        _ = ModalUI.Show(new PeerContactEditorModal.Model(contact.Id));
    }

    // Nested types

    public sealed record ComputedModel {
        public static readonly ComputedModel None = new();

        public Author? Author { get; init; }
        public Account? Account { get; init; }
        public bool IsOwnAuthor { get; init; }
        public PeerChatId? PeerChatId { get; init; }
        public bool CanStartPeerChat => PeerChatId is not null;
        public Contact? PeerChatContact { get; init; }
        public bool OnlyAnonymousChatAllowed { get; init; }
        public EditChatMemberModel? EditMemberModel { get; init; }
        public bool UsePlaceSettingsToEditMember { get; init; }
        public bool EnableIncompleteUI { get; init; }
    }

    public sealed record Model(AuthorId AuthorId);
}
