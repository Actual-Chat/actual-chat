@namespace ActualChat.UI.Blazor.App.Components
@inherits ComponentBase<AppUIHub>

<div class="c-header">
    <ButtonRound Click="@OnClose" Class="author-modal-close-btn close-btn btn-sm">
        <i class="icon-close text-2xl"></i>
    </ButtonRound>

    <div class="c-top">
        <AuthorCircle
            AuthorId="@Author.Id"
            Size="SquareSize.SizeFull"
            IsBlurred="@true"
            IsSquare="@true" />
    </div>

    <div class="c-center">
        <AuthorCircle
            AuthorId="@Author.Id"
            Size="SquareSize.Size16">
            <BadgeContent>
                @if (!Author.IsAnonymous) {
                    <AuthorPresenceIndicator AuthorId="@Author.Id" ShowRecording="true"></AuthorPresenceIndicator>
                }
            </BadgeContent>
        </AuthorCircle>
        <div class="c-buttons">
            @if (OnEditClick.HasDelegate) {
                <ButtonRound
                    Class="btn-sm"
                    Tooltip="@L.Common_Edit"
                    TooltipPosition="FloatingPosition.Top"
                    Click="@OnEditClick">
                    <i class="icon-edit text-2xl"></i>
                </ButtonRound>
            }

            @if (_shareModalModel is not null) {
                <ButtonRound
                    Class="btn-sm"
                    Tooltip="@L.Common_Share"
                    TooltipPosition="FloatingPosition.Top"
                    Click="@OnShareClick">
                    <i class="icon-share text-2xl"></i>
                </ButtonRound>
            }
        </div>
    </div>

    <div class="c-bottom">
        <div class="c-title">
            <AuthorName AuthorId="@Author.Id" Class="text-02 text-headline-7" ShowDetailsOnClick="false"/>
        </div>
        @if (!_peerOwnName.IsNullOrEmpty()) {
            <span class="c-public no-scrollbar">
                @_peerOwnName
            </span>
        }
        <div class="c-public no-scrollbar">
            @if (!Author.Avatar.Bio.IsNullOrEmpty()) {
                @Author.Avatar.Bio
            }
        </div>
    </div>
</div>

@code {
    private ShareModalModel? _shareModalModel;
    private string? _peerOwnName;

    private IAuthors Authors => Hub.Authors;
    private IAvatars Avatars => Hub.Avatars;

    [CascadingParameter] public Modal Modal { get; set; } = null!;
    [Parameter, EditorRequired] public Author Author { get; set; } = null!;
    [Parameter, EditorRequired] public bool IsOwn { get; set; }
    [Parameter] public EventCallback OnEditClick { get; set; }

    protected override async Task OnParametersSetAsync() {
        var cancellationToken = CancellationToken.None;
        _shareModalModel = await GetShareModalModel(cancellationToken).ConfigureAwait(true);
        _peerOwnName = await GetPeerOwnName(cancellationToken).ConfigureAwait(true);
    }

    private async Task<string?> GetPeerOwnName(CancellationToken cancellationToken) {
        var avatar = await Avatars.Get(Session, Author.Avatar.Id, cancellationToken).ConfigureAwait(false);
        var peerOwnName = avatar?.Name ?? "";
        return Author.Avatar.Name != peerOwnName ? peerOwnName : "";
    }

    private async Task<ShareModalModel?> GetShareModalModel(CancellationToken cancellationToken) {
        if (Author.IsAnonymous)
            return null;

        if (IsOwn)
            return await ShareUI.GetOwnAccountModel(cancellationToken).ConfigureAwait(false);

        var account = await Authors.GetAccount(Session, Author.ChatId, Author.Id, default).ConfigureAwait(true);
        if (account == null)
            return null;

        return await ShareUI
            .GetModel(account.Id, cancellationToken)
            .ConfigureAwait(false); // Ok (pre-exit)
    }

    private Task OnShareClick()
        => _shareModalModel is not null ? ShareUI.Share(_shareModalModel) : Task.CompletedTask;

    private void OnClose()
        => Modal.Close();
}
