@namespace ActualChat.UI.Blazor.App.Components

<div class="c-header">
    <ButtonRound Click="@OnClose" Class="author-modal-close-btn close-btn btn-sm">
        <i class="icon-close text-2xl"></i>
    </ButtonRound>

    <div class="c-top">
        <AuthorCircle
            AuthorSid="@Author.Id"
            Size="SquareSize.SizeFull"
            IsBlurred="@true"
            IsSquare="@true" />
    </div>

    <div class="c-center">
        <AuthorCircle
            AuthorSid="@Author.Id"
            Size="SquareSize.Size16">
            <BadgeContent>
                @if (!Author.IsAnonymous) {
                    <AuthorPresenceIndicator AuthorSid="@Author.Id" ShowRecording="true"></AuthorPresenceIndicator>
                }
            </BadgeContent>
        </AuthorCircle>
        <div class="c-buttons">
            @if (OnEditClick.HasDelegate) {
                <ButtonRound
                    Class="btn-sm"
                    Tooltip="Edit"
                    TooltipPosition="FloatingPosition.Top"
                    Click="@OnEditClick">
                    <i class="icon-edit text-2xl"></i>
                </ButtonRound>
            }
            @if (!IsOwn) {
                <AddToContactsButton Author="@Author"/>
            }
            @if (_shareModalModel is not null) {
                <ButtonRound
                    Class="btn-sm"
                    Tooltip="Share"
                    TooltipPosition="FloatingPosition.Top"
                    Click="@OnShareClick">
                    <i class="icon-share text-2xl"></i>
                </ButtonRound>
            }
        </div>
    </div>

    <div class="c-bottom">
        <div class="c-title">
            <AuthorName AuthorSid="@Author.Id" Class="text-02 text-headline-7" ShowDetailsOnClick="false"/>
        </div>
        <div class="c-public">
            @if (!Author.Avatar.Bio.IsNullOrEmpty()) {
                @Author.Avatar.Bio
            }
        </div>
    </div>
</div>

@code {
    private ShareModalModel? _shareModalModel;

    [Inject] private ChatUIHub Hub { get; set; } = null!;
    private Session Session => Hub.Session();
    private IAuthors Authors => Hub.Authors;
    private ShareUI ShareUI => Hub.ShareUI;

    [CascadingParameter] public Modal Modal { get; set; } = null!;
    [Parameter, EditorRequired] public Author Author { get; set; } = null!;
    [Parameter, EditorRequired] public bool IsOwn { get; set; }
    [Parameter] public EventCallback OnEditClick { get; set; }

    protected override async Task OnParametersSetAsync()
        => _shareModalModel = await GetShareModalModel(default);

    private async Task<ShareModalModel?> GetShareModalModel(CancellationToken cancellationToken) {
        if (Author.IsAnonymous)
            return null;

        if (IsOwn)
            return await ShareUI.GetOwnAccountModel(cancellationToken).ConfigureAwait(false);

        var account = await Authors.GetAccount(Session, Author.ChatId, Author.Id, default);
        if (account == null)
            return null;

        return await ShareUI.GetModel(account.Id, cancellationToken).ConfigureAwait(true);
    }

    private Task OnShareClick()
        => _shareModalModel is not null ? ShareUI.Share(_shareModalModel) : Task.CompletedTask;

    private void OnClose()
        => Modal.Close();
}
