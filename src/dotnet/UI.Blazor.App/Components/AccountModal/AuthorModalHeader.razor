@namespace ActualChat.UI.Blazor.App.Components
@inherits ComponentBase<AppUIHub>

<div class="c-header">
    <ButtonRound Click="@OnClose" Class="author-modal-close-btn close-btn btn-sm">
        <i class="icon-close text-2xl"></i>
    </ButtonRound>

    <div class="c-top">
        <AuthorCircle
            AuthorId="@Author.Id"
            Size="SquareSize.SizeFull"
            IsBlurred="@true"
            IsSquare="@true" />
    </div>

    <div class="c-center">
        <AuthorCircle
            AuthorId="@Author.Id"
            Size="SquareSize.Size16">
            <BadgeContent>
                @if (!Author.IsAnonymous) {
                    <AuthorPresenceIndicator AuthorId="@Author.Id" ShowRecording="true"></AuthorPresenceIndicator>
                }
            </BadgeContent>
        </AuthorCircle>
        <div class="c-buttons">
            @if (IsOwn) {
                @if (OnEditClick.HasDelegate) {
                    <ButtonRound
                        Class="btn-sm"
                        Tooltip="Edit"
                        TooltipPosition="FloatingPosition.Top"
                        Click="@OnEditClick">
                        <i class="icon-edit text-2xl"></i>
                    </ButtonRound>
                }
                @if (_shareModalModel is not null) {
                    <ButtonRound
                        Class="btn-sm"
                        Tooltip="Share"
                        TooltipPosition="FloatingPosition.Top"
                        Click="@OnShareClick">
                        <i class="icon-share text-2xl"></i>
                    </ButtonRound>
                }
            } else {
                @if (_enableIncompleteUI) {
                    <ButtonRound
                        Class="btn-sm"
                        Tooltip="Show call"
                        TooltipPosition="FloatingPosition.Top"
                        Click="OnCallClick">
                        <i class="icon-phone text-2xl"></i>
                    </ButtonRound>
                }
                @if (_peerChatId is { } peerChatId) {
                    @if (!_isActivePeerChat) {
                        <ButtonRound
                            Class="btn-sm"
                            Tooltip="Start chat"
                            TooltipPosition="FloatingPosition.Top"
                            Click="@OnStartPeerChat">
                            <i class="icon-message-ellipse text-2xl"></i>
                        </ButtonRound>
                    }
                    <ButtonRound
                        Class="btn-sm"
                        data-menu="@(MenuRef.New<ContactActionMenu>(peerChatId.Value).ToString())"
                        data-menu-trigger="@MenuTrigger.Primary"
                        data-menu-placement="@(FloatingPosition.BottomEnd.ToPositionString())">
                        <i class="icon-more-vertical text-2xl"></i>
                    </ButtonRound>
                }
            }
        </div>
    </div>

    <div class="c-bottom">
        <div class="c-title">
            <AuthorName AuthorId="@Author.Id" Class="text-02 text-headline-7" ShowDetailsOnClick="false"/>
        </div>
        @if (!_peerOwnName.IsNullOrEmpty()) {
            <span class="c-public no-scrollbar">
                @_peerOwnName
            </span>
        }
        <div class="c-public no-scrollbar">
            @if (!Author.Avatar.Bio.IsNullOrEmpty()) {
                @Author.Avatar.Bio
            }
        </div>
    </div>
</div>

@code {
    private ShareModalModel? _shareModalModel;
    private string? _peerOwnName;
    private bool _enableIncompleteUI;
    private PeerChatId? _peerChatId;
    private bool _isActivePeerChat;

    private IAuthors Authors => Hub.Authors;
    private IAvatars Avatars => Hub.Avatars;
    private AuthorUI AuthorUI => Hub.AuthorUI;
    private ChatUI ChatUI => Hub.ChatUI;

    [CascadingParameter] public Modal Modal { get; set; } = null!;
    [Parameter, EditorRequired] public Author Author { get; set; } = null!;
    [Parameter, EditorRequired] public bool IsOwn { get; set; }
    [Parameter] public EventCallback OnEditClick { get; set; }

    protected override async Task OnInitializedAsync() {
        _enableIncompleteUI = await Features.IsIncompleteUIEnabled(CancellationToken.None);
    }

    protected override async Task OnParametersSetAsync() {
        var cancellationToken = CancellationToken.None;
        _shareModalModel = await GetShareModalModel(cancellationToken);
        _peerOwnName = await GetPeerOwnName(cancellationToken);
        _peerChatId = IsOwn ? null : await AuthorUI.GetPeerChatId(Author.Id, cancellationToken).ConfigureAwait(false);
        _isActivePeerChat = _peerChatId is not null && ChatUI.SelectedChatId.Value == _peerChatId;
    }

    private async Task<string?> GetPeerOwnName(CancellationToken cancellationToken) {
        var avatar = await Avatars.Get(Session, Author.Avatar.Id, cancellationToken).ConfigureAwait(false);
        var peerOwnName = avatar?.Name ?? "";
        return Author.Avatar.Name != peerOwnName ? peerOwnName : "";
    }

    private async Task<ShareModalModel?> GetShareModalModel(CancellationToken cancellationToken) {
        if (Author.IsAnonymous)
            return null;

        if (IsOwn)
            return await ShareUI.GetOwnAccountModel(cancellationToken).ConfigureAwait(false);

        var account = await Authors.GetAccount(Session, Author.ChatId, Author.Id, default);
        if (account == null)
            return null;

        return await ShareUI
            .GetModel(account.Id, cancellationToken)
            .ConfigureAwait(false); // Ok (pre-exit)
    }

    private Task OnShareClick()
        => _shareModalModel is not null ? ShareUI.Share(_shareModalModel) : Task.CompletedTask;

    private async Task OnCallClick() {
        Modal.Close();
        await ModalUI.Show(new IncomingCallModal.Model(Author.Id));
    }

    private Task OnStartPeerChat()
        => AuthorUI.StartPeerChat(Author.Id);

    private void OnClose()
        => Modal.Close();
}
