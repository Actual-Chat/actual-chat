@using ActualChat.Media
@using System.ComponentModel.DataAnnotations
@inherits FusionComponentBase<AppUIHub>
@namespace ActualChat.UI.Blazor.App.Components
@{
#pragma warning disable IL2091

    var isPlaceChat = PlaceId is not null;
    var canChangeChatType = PlaceId is null || _place != null && _place.Rules.CanApplyPublicChatType();
    var publicChatLabel = !isPlaceChat ? L.Chat_PublicChat : L.Chat_PlaceChat;
    var publicChatHint = !isPlaceChat ? L.Chat_PublicChatHint : L.Chat_PlaceChatHint;
}

<Form @ref="_formRef" Model="@_form" Id="@_form.FormId">
    <FormBlock>
        <DataAnnotationsValidator/>

        <PicUpload
            Scope="@MediaUploadScopes.ForAccount(AccountUI.OwnAccount.Value)"
            MediaKind="@MediaKind.ChatPicture"
            Size="@SquareSize.Size24"
            Title="@_form.Title"
            Picture="@_form.Picture"
            AvatarKind="@AvatarKind"
            AvatarKey="@AvatarKey"
            Picked="@OnImagePicked"/>

        <FormSection
            For="() => _form.Title"
            Label="@L.Form_Title"
            InputId="@_form.TitleId"
            IsLabelInsideInput="true"
            Class="!mt-0 grow"
            IsRequired="true">
            <TextBox
                @bind-Value="@_form.Title"
                Id="@_form.TitleId"
                Autofocus="@ShouldAutoFocusField"
                Autocomplete="off"/>
        </FormSection>
        <FormSection
            For="() => _form.Description"
            Label="@L.Form_Description"
            InputId="@_form.DescriptionId"
            IsLabelInsideInput="true"
            Class="!mt-0 grow">
            <TextBox
                @bind-Value="@_form.Description"
                Id="@_form.DescriptionId"
                Autofocus="false"
                Autocomplete="off"/>
        </FormSection>
    </FormBlock>
    <FormBlock Title="@L.Chat_TypeTitle" Class="with-input-radio">
        <InputRadioGroup Name="chat_type" DisplayName="@L.Chat_TypeTitle" @bind-Value="_form.IsPublic">
            <TileItem
                Class="@(_form.IsPublic ? "transparent selected" : "transparent")"
                Click="@(() => OnPublicChatClick(true))">
                <Icon>
                    <FormRadio Id="@_form.IsPublicTrueFormId" IsDisabled="@(!canChangeChatType)" Value="@true"/>
                </Icon>
                <Content>
                    <Label InputId="@_form.IsPublicTrueFormId" Text="@publicChatLabel" IsRequired="true"></Label>
                </Content>
                <Caption>
                    @publicChatHint
                </Caption>
            </TileItem>
            <TileItem
                Class="@(!_form.IsPublic ? "transparent selected" : "transparent")"
                Click="@(() => OnPublicChatClick(false))">
                <Icon>
                    <FormRadio Id="@_form.IsPublicFalseFormId" IsDisabled="@(!canChangeChatType)" Value="@false"/>
                </Icon>
                <Content>
                    <Label InputId="@_form.IsPublicFalseFormId" Text="@L.Chat_PrivateChat" IsRequired="true"></Label>
                </Content>
                <Caption>
                    @L.Chat_PrivateChatHint
                </Caption>
            </TileItem>
        </InputRadioGroup>
    </FormBlock>
    @if (PlaceId is null) {
        <FormBlock>
            @if (_isAdmin && _form.IsPublic) {
                <TileItem Class="field-allow-guest clickable" Click="OnAllowGuestAuthorsClick">
                    <Icon>
                        <i class="icon-guest"></i>
                    </Icon>
                    <Content>
                        <Label InputId="@_form.AllowGuestAuthorsFormId" Text="@L.Chat_AllowGuests" IsRequired="true"></Label>
                    </Content>
                    <Caption>
                        @L.Chat_AllowGuestsHint
                    </Caption>
                    <Right>
                        <ToggleEdit Id="@_form.AllowGuestAuthorsFormId" @bind-Value="_form.AllowGuestAuthors"/>
                    </Right>
                </TileItem>
            }
            @if (Features_EnableAnonymousChat.IsEnabled) {
                <TileItem Class="field-allow-anonym clickable" Click="@OnAllowAnonymousAuthorsClick">
                    <Icon>
                        <i class="icon-question-mark-bubble"></i>
                    </Icon>
                    <Content>
                        <Label InputId="@_form.AllowAnonymousAuthorsFormId" Text="@L.Chat_AllowAnonymous" IsRequired="true"></Label>
                    </Content>
                    <Caption>
                        @L.Chat_AllowAnonymousHint
                    </Caption>
                    <Right>
                        <ToggleEdit Id="@_form.AllowAnonymousAuthorsFormId" @bind-Value="_form.AllowAnonymousAuthors"/>
                    </Right>
                </TileItem>
            }
        </FormBlock>
    }

    <RenderIntoSlot Name="@ButtonsSlotName">
        @if (ScreenSize.IsWide()) {
            <Button
                Click="@(() => Cancelled())"
                Class="btn-modal">
                Cancel
            </Button>
        }
        <Button
            Click="@OnCreate"
            Type="@ButtonType.Button"
            IsDisabled="@(!context.Validate())"
            Class="btn-modal btn-primary">
            Create
        </Button>
    </RenderIntoSlot>
</Form>

@code {
    private static readonly AvatarKind AvatarKind = AvatarKind.Marble;
    private static readonly string AvatarKey = "a-random-string";
    private Form _formRef = null!;
    private FormModel _form = null!;
    private bool _isAdmin;
    private Place? _place;

    [CascadingParameter] public ScreenSize ScreenSize { get; set; }
    [Parameter, EditorRequired] public PlaceId? PlaceId { get; set; }
    [Parameter, EditorRequired] public string ButtonsSlotName { get; set; } = "";
    [Parameter, EditorRequired] public Action<Chat> ChatCreated { get; set; } = null!;
    [Parameter, EditorRequired] public Action Cancelled { get; set; } = null!;

    protected override void OnInitialized() {
        _form = new(ComponentIdGenerator);
        _isAdmin = Hub.AccountUI.OwnAccount.Value.IsAdmin;
    }

    protected override async Task OnInitializedAsync() {
        if (PlaceId is not null) {
            _place = await Hub.Places.Get(Hub.Session, PlaceId, default).Require().ConfigureAwait(false);
            if (!_place.Rules.CanApplyPublicChatType())
                _form.IsPublic = false;
        }
    }

    private void OnImagePicked(MediaRef mediaRef) {
        _form.Picture = new(mediaRef);
        StateHasChanged();
    }

    private void OnPublicChatClick(bool isPublic) {
        if (_form!.IsPublic == isPublic)
            return;
        _form!.IsPublic = isPublic;
        StateHasChanged();
    }

    private void OnAllowGuestAuthorsClick()
    {
        _form.AllowGuestAuthors = !_form.AllowGuestAuthors;
        StateHasChanged();
    }

    private void OnAllowAnonymousAuthorsClick()
    {
        _form.AllowAnonymousAuthors = !_form.AllowAnonymousAuthors;
        StateHasChanged();
    }

    private async Task OnCreate() {
        if (!_formRef.IsValid)
            return;
        try {
            var command = new Chats_Change {
                Session = Hub.Session,
                ChatId = null,
                ExpectedVersion = null,
                Change = new() {
                    Create = new ChatDiff {
                        Title = _form.Title,
                        Description = _form.Description,
                        Kind = null,
                        IsPublic = _form.IsPublic,
                        MediaId = _form.Picture?.MediaRef?.MediaId,
                        AllowGuestAuthors = PlaceId is null ? _form.AllowGuestAuthors : null,
                        AllowAnonymousAuthors = PlaceId is null ? _form.AllowAnonymousAuthors : null,
                        PlaceId = PlaceId
                    },
                },
            };
            var (chat, createChatError) = await Hub.UICommander.Run(command, CancellationToken.None);
            if (createChatError != null)
                return;

            chat.Require();
            ChatCreated(chat);
        }
        catch { // Intended: command errors are shown in the UI anyway
        }
    }

    [UnconditionalSuppressMessage("ReflectionAnalysis", "IL2026:RequiresUnreferencedCode", Justification = "String.Count should be preserved.")]
    public sealed class FormModel {
        [Required]
        public string Title { get; set; } = "";

        public string Description { get; set; } = "";
        public Picture? Picture { get; set; }
        public bool IsPublic { get; set; }
        public bool AllowGuestAuthors { get; set; }
        public bool AllowAnonymousAuthors { get; set; }

        public string FormId { get; }
        public string TitleId { get; }
        public string DescriptionId { get; }
        public string IsPublicTrueFormId { get; }
        public string IsPublicFalseFormId { get; }
        public string AllowGuestAuthorsFormId { get; }
        public string AllowAnonymousAuthorsFormId { get; }

        public FormModel(ComponentIdGenerator componentIdGenerator) {
            FormId = componentIdGenerator.Next("new-chat-form");
            TitleId = $"{FormId}-title";
            DescriptionId = $"{FormId}-description";
            var isPublicFormId = $"{FormId}-is-public";
            IsPublicTrueFormId = isPublicFormId + "-true";
            IsPublicFalseFormId = isPublicFormId + "-false";
            AllowGuestAuthorsFormId = $"{FormId}-allows-guests";
            AllowAnonymousAuthorsFormId = $"{FormId}-allows-anonymous";
        }
    }
}
