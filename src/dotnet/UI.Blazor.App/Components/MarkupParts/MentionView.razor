@inherits ComputedMarkupViewBase<MentionMarkup, MentionView.Model>
@{
    var m = State.Value;
    var cls = "";
    if (m.HasRead != null) {
        cls = !m.HasRead.Value ? "dim" : "";
    }

    var tooltip = m.HasRead == null
        ? ""
        : m.HasRead.Value
            ? "Has read"
            : "Has not read";
}

<AuthorBadgeTemplate AuthorSid="@(_authorId?.Value ?? "")">
    @if (context?.Author is not { } author) {
        <div class="mention-markup mention-markup-invalid">@Markup.NameOrNotAvailable</div>
        return;
    }

    <div
        class="mention-markup mention-markup-valid @(context.IsOwn ? "mention-markup-own" : "") @cls cursor-pointer"
        data-tooltip="@tooltip"
        data-tooltip-position="@FloatingPosition.Top.ToPositionString()"
        @onclick="@(_ => AuthorUI.Show(author.Id))">
        <div class="truncate">
            @author.Avatar.Name
        </div>
    </div>
</AuthorBadgeTemplate>

@code {
    private AuthorId? _authorId;
    private bool? _hasRead;

    [Inject] private ChatUIHub Hub { get; init; } = null!;
    private Session Session => Hub.Session();
    private IChats Chats => Hub.Chats;
    private AuthorUI AuthorUI => Hub.AuthorUI;

    protected override void OnParametersSet()
        => _authorId = Markup.Id.PrincipalId as AuthorId;

    protected override ComputedState<Model>.Options GetStateOptions()
        => ComputedStateComponent.GetStateOptions(GetType(),
            static t => new ComputedState<Model>.Options() {
                InitialValue = new Model(false),
                UpdateDelayer = FixedDelayer.NextTick,
                Category = GetStateCategory(t),
            });

    protected override async Task<Model> ComputeState(CancellationToken cancellationToken) {
        var chatEntry = Entry;
        _hasRead = chatEntry.IsSystemEntry ? null : false;

        if (_hasRead == null)
            return new(null); // Do not track hasRead status for mentions inside system messages.

        var chat = await Chats.Get(Session, chatEntry.ChatId, cancellationToken).ConfigureAwait(false);
        if (chat?.Rules.Author?.Id == _authorId)
            return new(true);

        if (!_hasRead.Value)
            _hasRead = await Chats.IsEntryReadByMentionedUser(Session, chatEntry.Id.ToTextEntryId(), Markup.Id, cancellationToken).ConfigureAwait(false);
        return new(_hasRead);
    }

    // Nested types

    public sealed record Model(bool? HasRead);
}
