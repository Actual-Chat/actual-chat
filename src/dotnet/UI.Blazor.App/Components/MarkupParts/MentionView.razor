@inherits ComputedMarkupViewBase<MentionMarkup, MentionView.Model>
@{
    var m = State.Value;
}

<AuthorBadgeTemplate AuthorSid="@_authorId">
    @if (context.Author.Id.IsNone) {
        <div class="mention-markup mention-markup-invalid">@Markup.NameOrNotAvailable</div>
        return;
    }

    <div
        class="mention-markup mention-markup-valid @(context.IsOwn ? "mention-markup-own" : "") cursor-pointer"
        @onclick="@(_ => AuthorUI.Show(_authorId))">
        <div class="truncate">
            @context.Author.Avatar.Name
        </div>
        @if (m.HasRead) {
            <i class="icon-checkmark-simple"></i>
        }
    </div>
</AuthorBadgeTemplate>

@code {
    private AuthorId _authorId;
    private bool _hasRead;

    [Inject] private ChatUIHub Hub { get; init; } = null!;
    private Session Session => Hub.Session();
    private IChats Chats => Hub.Chats;
    private AuthorUI AuthorUI => Hub.AuthorUI;

    protected override void OnParametersSet()
        => Markup.Id.IsAuthor(out _authorId);

    protected override ComputedState<Model>.Options GetStateOptions()
        => ComputedStateComponent.GetStateOptions(GetType(),
            static t => new ComputedState<Model>.Options() {
                InitialValue = new Model(false),
                UpdateDelayer = FixedDelayer.NextTick,
                Category = ComputedStateComponent.GetStateCategory(t),
            });

    protected override async Task<Model> ComputeState(CancellationToken cancellationToken) {
        if (Entry.IsSystemEntry)
            return new Model(false); // Do not track hasRead status for mentions inside system messages.

        var chat = await Chats.Get(Session, Entry.ChatId, cancellationToken).ConfigureAwait(false);
        var isOwnMessage = Entry.AuthorId == chat?.Rules.Author?.Id;
        if (!isOwnMessage)
            return new Model(false); // Show HasRead status only to message author.

        if (!_hasRead)
            _hasRead = await Chats.IsEntryReadByMentionedUser(Session, Entry.Id.ToTextEntryId(), Markup.Id, cancellationToken).ConfigureAwait(false);
        return new Model(_hasRead);
    }

    // Nested types
    public record Model(bool HasRead);
}
