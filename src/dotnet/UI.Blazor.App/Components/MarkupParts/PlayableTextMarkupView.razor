@using ActualChat.MediaPlayback
@using ActualChat.UI.Blazor.App.Module
@inherits ComputedMarkupViewBase<PlayableTextMarkup, PlayableTextMarkupView.Model>
@{
    var m = _rendered = State.Value;
    var colorCls = "playable-text-color-" + (AuthorColors.GetIndex(Entry.AuthorId) + 1);
    var playOnClickIsEnabled = !m.HasSelection;
    var containerCls = "playable-text-markup" + (playOnClickIsEnabled ? " cursor-pointer" : " play-disabled");
}

<span @ref="Ref" class="@containerCls @colorCls">
    @if (m.Map == null) {
        @Markup.Text
    } else {
        foreach (var run in BuildRuns(m.Map, Markup.Words.Length)) {
            var c0 = Markup.Words[run.Start].TextRange.Start;
            var c1 = Markup.Words[run.End].TextRange.End;
            <span class="@RunClass(run)" data-c0="@c0">@Markup.Text[c0..c1]</span>
        }
    }
</span>

@code {
    private static readonly string JSCreateMethod = $"{BlazorUIAppModule.ImportName}.PlayableTextMarkupView.create";

    private Model? _rendered;

    private ILogger Log => field ??= Services.LogFor(GetType());

    private ChatAudioUI ChatAudioUI => Hub.ChatAudioUI;
    private ActivePlaybackInfo ActivePlaybackInfo => Hub.ActivePlaybackInfo;

    private ElementReference Ref { get; set; }
    private IJSObjectReference JSRef { get; set; } = null!;
    private DotNetObjectReference<PlayableTextMarkupView> BlazorRef { get; set; } = null!;

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (firstRender) {
            BlazorRef = DotNetObjectReference.Create(this);
            JSRef = await JS.InvokeAsync<IJSObjectReference>(
                JSCreateMethod,
                BlazorRef,
                Ref,
                Markup.Words.ToArray());
        }
    }

    protected override ComputedState<Model>.Options GetStateOptions()
        => ComputedStateComponent.GetStateOptions(GetType(),
            static t => new ComputedState<Model>.Options() {
                InitialValue = Model.None,
                UpdateDelayer = FixedDelayer.NextTick,
                Category = GetStateCategory(t),
            });

    protected override async Task<Model> ComputeState(CancellationToken cancellationToken) {
        // Let's store everything locally to make sure we can safely "leave" Blazor dispatcher's "thread"
        var chatId = Entry.ChatId;
        var hasAudio = Entry.HasAudio;
        var markup = Markup;
        var rendered = _rendered;
        var entryId = Entry.Id;
        var entryLocalId = Entry.LocalId;

        var hasSelection = await SelectionUI.HasSelection.Use(cancellationToken).ConfigureAwait(false);
        var model = await InnerComputeState(cancellationToken).ConfigureAwait(false);
        var highlightedWords = await HighlightUI.GetWordSet(entryId, cancellationToken).ConfigureAwait(false);
        if (rendered is not { Map: not null })
            return model with { // Never rendered
                HasSelection = hasSelection,
                HighlightedWords = highlightedWords,
            };

        var map = EnrichMapWithPlayedStatus(model.Map, rendered.Map);
        return new() {
            Map = map,
            HasSelection = hasSelection,
        };

        async Task<Model> InnerComputeState(CancellationToken cancellationToken1)
        {
            if (!hasAudio)
                return Model.None;

            if (markup.TimeRange.IsEmptyOrNegative)
                return Model.None;

            var replayState = await ChatAudioUI.ReplayState.Use(cancellationToken1).ConfigureAwait(false);
            if (replayState is null || replayState.ChatId != chatId)
                return Model.None;

            var trackId = ChatAudioTrackInfo.ComposeTrackId(chatId, entryLocalId);
            if (await ActivePlaybackInfo.GetTrackInfo(trackId, cancellationToken1).ConfigureAwait(false) is not ChatAudioTrackInfo trackInfo)
                return Model.None;

            var playbackState = await ActivePlaybackInfo.GetTrackPlaybackState(trackId, cancellationToken1).ConfigureAwait(false);
            if (playbackState == null || playbackState.IsEnded)
                return Model.None;

            var playingAt = (float) (trackInfo.RecordedAt + playbackState.PlayingAt - trackInfo.AudioEntry!.BeginsAt)
                .TotalSeconds;
            var playingAtNearbyRange = new Range<float>(playingAt - 2f, playingAt + 2f);
            if (!playingAtNearbyRange.Overlaps(markup.TimeRange))
                return Model.None;

            var map1 = new WordPlayback[markup.Words.Length];
            for (var i = 0; i < markup.Words.Length; i++) {
                var word = markup.Words[i];
                var isWordPlaying = word.TimeRange.Move(-0.5f, 0.3f).Contains(playingAt);
                map1[i] = isWordPlaying ? WordPlayback.Playing : WordPlayback.None;
            }

            var isEmpty = map1.All(c => c == WordPlayback.None);
            if (isEmpty)
                return Model.None;

            return new() { Map = map1 };
        }
    }

    [JSInvokable]
    public Task OnMarkupClick(Range<int> textRange) {
        // Let's store everything locally to make sure we can safely "leave" Blazor dispatcher's "thread"
        var markup = Markup;
        var entry = Entry;
        var chatId = entry.ChatId;

        var startIndex = textRange.Start;
        var startTimeOpt = markup.TimeMap.TryMap(startIndex);
        if (startTimeOpt is not { } startTime)
            return Task.CompletedTask;

        var startAt = entry.BeginsAt + TimeSpan.FromSeconds(startTime - 0.25);
        return Hub.ChatAudioUI.StartReplay(chatId, startAt);
    }

    private static WordPlayback[] EnrichMapWithPlayedStatus(WordPlayback[]? map, WordPlayback[] lastMap)
    {
        if (map == null)
            return lastMap
                .Select(c => c == WordPlayback.None ? WordPlayback.None : WordPlayback.Played)
                .ToArray();

        return lastMap.Zip(map,
            (last, current) => current != WordPlayback.None
                ? current
                : last == WordPlayback.None
                    ? WordPlayback.None
                    : WordPlayback.Played)
            .ToArray();
    }

    private List<Run> BuildRuns(WordPlayback[] map, int count) {
        var runs = new List<Run>();
        var i = 0;
        while (i < count) {
            var fill = map[i];
            var highlighted = IsHighlighted(i);
            var j = i + 1;
            while (j < count && map[j] == fill && IsHighlighted(j) == highlighted)
                j++;
            runs.Add(new Run(fill, highlighted, i, j - 1));
            i = j;
        }
        return runs;
    }

    private static string RunClass(Run run) {
        var fillCls = run.Fill switch {
            WordPlayback.Playing => "playing-run",
            WordPlayback.Played => "played-run",
            _ => "",
        };
        if (!run.Highlighted)
            return fillCls;
        return fillCls.Length == 0 ? "highlight" : fillCls + " highlight";
    }

    private bool IsHighlighted(int index) {
        var m = _rendered;
        return m is { HighlightedWords.Count: > 0 }
            && m.HighlightedWords.Contains(Markup.Words[index].Value.TrimNonLetterOrDigits(), StringComparer.OrdinalIgnoreCase);
    }

    public override async ValueTask DisposeAsync() {
        await JSRef.DisposeSilentlyAsync("dispose");
        BlazorRef.DisposeSilently();
        await base.DisposeAsync();
    }

    // Nested types

    public enum WordPlayback { None, Playing, Played }

    private readonly record struct Run(WordPlayback Fill, bool Highlighted, int Start, int End);

    public sealed record Model {
        public static readonly Model None = new();

        public WordPlayback[]? Map { get; init; }
        public bool HasSelection { get; init; }
        public IReadOnlySet<string> HighlightedWords { get; init; } = new ApiSet<string>();
    }
}
