@using ActualChat.Search
@inherits ComputedMarkupViewBase<TextMarkup, PlainTextMarkupView.Model>
@{
    var m = State.Value;
}

@if (m.Emoji is { } emoji) {
    <span class="emoji-message">
        <EmojiIcon Emoji="@emoji" Class="c-emoji" HasPreview="false" InlineAnimate="true"/>
    </span>
    @if (LastFragment != null)
        @LastFragment
} else if (m.MustHighlight) {
    <SearchMatchHighlighter
        Match="m.SearchMatch"
        PlainTextClass="plain-text-markup"
        HighlightedClass="plain-text-markup highlight" />
    @if(LastFragment != null)
        @LastFragment
} else {
    @if (LastFragment != null) {
        var (head, lastWord) = m.MarkupText.SplitLastWord();
        if (lastWord != null) {
            <span class="plain-text-markup">@head</span>
            <span class="plain-text-markup last-word">@lastWord @LastFragment</span>
            return;
        }
    }
    <span class="plain-text-markup">@m.MarkupText</span>
    @if (LastFragment != null)
        @LastFragment
}

@code {
    protected override ComputedState<Model>.Options GetStateOptions()
        => ComputedStateComponent.GetStateOptions(GetType(),
            t => new ComputedState<Model>.Options() {
                InitialValue = new(Markup.Text, Entry.Content, SearchMatch.Empty),
                Category = GetStateCategory(t),
            });

    protected override async Task<Model> ComputeState(CancellationToken cancellationToken) {
        var entryId = Entry.Id;
        var markupText = Markup.Text;
        var searchMatch = await HighlightUI.GetMatch(entryId, markupText, cancellationToken).ConfigureAwait(false);
        return new(markupText, Entry.Content, searchMatch);
    }

    // Nested types

    public sealed record Model(string MarkupText, string EntryContent, SearchMatch SearchMatch) {
        public Emoji? Emoji { get; } = Emojis.TryGetByIdOrSymbol(EntryContent.Trim());
        public bool MustHighlight => !SearchMatch.IsEmpty;
    }
}
