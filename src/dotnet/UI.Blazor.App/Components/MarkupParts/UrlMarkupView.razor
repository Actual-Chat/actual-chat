@inherits MarkupViewBase<UrlMarkup>
@{
    var cls = Classes.GetValueOrDefault(Markup.Kind) ?? "url-markup url-markup-unknown";
    var url = Markup.Url;
}

@if (_isGifImage) {
    <div class="gif-message-wrapper">
        <img class="gif-message" src="@_gifSrc" alt="" loading="lazy"/>
        <img class="gif-watermark" src="/dist/images/klipy/klipy-light-text.png" alt="KLIPY" draggable="false" aria-hidden="true"/>
    </div>
    return;
}

@if (Markup.Kind is UrlMarkupKind.Email) {
    @* NOTE(DF): Do not use target="_blank" for emails. It crashes Android app. *@
    <a class="@cls" href="@_hrefUrl"
       data-menu="@(MenuRef.New<MessageMenu>(Entry.Id.Value, bool.FalseString, url, ""))">
        @url
    </a>
    return;
}

@if (_linkRenderMode is LinkRenderMode.LinkPreview)
    return;

@if (_linkRenderMode is LinkRenderMode.Local) {
    <a class="@cls" href="@_hrefUrl"
       @onclick="@OnNavigateClick"
       @onclick:preventDefault="true"
       data-menu="@(MenuRef.New<MessageMenu>(Entry.Id.Value, bool.FalseString, url, ""))">
        @url
    </a>
    return;
}

<a class="@cls" href="@_hrefUrl" target="_blank"
   data-menu="@(MenuRef.New<MessageMenu>(Entry.Id.Value, bool.FalseString, url, ""))">
    @url
</a>

@code {
    private static readonly Dictionary<UrlMarkupKind, string> Classes = new[] {
        UrlMarkupKind.Www,
        UrlMarkupKind.Email,
    }.ToDictionary(x => x, x => $"url-markup url-markup-{x.ToString().ToLower()}");

    private string _hrefUrl = "";
    private LocalUrl? _localUrl;
    private LinkRenderMode _linkRenderMode = LinkRenderMode.Default;
    private bool _isGifImage;
    private string _gifSrc = "";

    private LinkPreviewUI LinkPreviewUI => Hub.LinkPreviewUI;

    protected override async Task OnParametersSetAsync() {
        var url = Markup.Url;
        _hrefUrl = url;
        _isGifImage = false;
        _gifSrc = "";
        if (Markup.Kind is UrlMarkupKind.Www && UrlMapper.IsTrustedGifUrl(url)) {
            // Route through imageproxy: hides viewer IP from origin, caches, validates content-type.
            // Falls back to plain link if proxy isn't available in this deployment.
            var proxied = UrlMapper.GifProxyUrl(url);
            if (!proxied.IsNullOrEmpty()) {
                _isGifImage = true;
                _gifSrc = proxied;
            }
        }
        switch (Markup.Kind) {
            case UrlMarkupKind.Www:
                var isRenderedAsLocal = await LinkPreviewUI.IsRenderedAsLocal(url, CancellationToken.None);
                if (isRenderedAsLocal)
                    _linkRenderMode = !Entry.IsSending ? LinkRenderMode.LinkPreview : LinkRenderMode.Local;
                else {
                    _localUrl = TryGetLocalUrl(url);
                    if (_localUrl is not null)
                        _linkRenderMode = LinkRenderMode.Local;
                }
                break;
            case UrlMarkupKind.Email:
                _hrefUrl = url.StartsWith("mailto:") ? url : "mailto:" + url;
                break;
        }
    }

    private LocalUrl? TryGetLocalUrl(string url)
    {
        url = url.EnsureSuffix("/");
        if (url.StartsWith(Nav.BaseUri))
            return new LocalUrl(Nav.ToBaseRelativePath(url));
        if (url.StartsWith(UrlMapper.BaseUrl))
            return new LocalUrl(UrlMapper.ToBaseRelativePath(url));
        return null;
    }

    private void OnNavigateClick() {
        if (_localUrl is null)
            return;

        _ = History.NavigateTo(_localUrl.Value);
    }

    // Nested types
    private enum LinkRenderMode { Default, LinkPreview, Local }
}
