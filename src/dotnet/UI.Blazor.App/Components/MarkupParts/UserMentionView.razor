@namespace ActualChat.UI.Blazor.App.Components.MarkupParts
@inherits MarkupViewBase<UserMention>
@{
    var name = Markup.Account?.Avatar.Name.NullIfEmpty() ?? Markup.NameOrNotAvailable;
    var isMember = Markup.IsChatMember;
    var cls = isMember
        ? "mention-markup mention-markup-valid cursor-pointer"
        : "mention-markup mention-markup-valid mention-markup-non-member cursor-pointer line-through";
    var tooltip = isMember ? null : "Not a member of this chat";
}

<span class="@cls"
      data-tooltip="@tooltip"
      data-tooltip-position="@(tooltip is null ? null : FloatingPosition.Top.ToPositionString())"
      @onclick="OnClick">
    <div class="truncate">@@@name</div>
</span>

@code {
    private void OnClick() {
        // TODO: open the "author info + invite" modal — for members, show profile;
        // for non-members, show profile + Invite-to-chat button (when allowed).
        if (!Markup.UserId.IsGuestOrNull())
            _ = History.NavigateTo(Links.User(Markup.UserId));
    }
}
