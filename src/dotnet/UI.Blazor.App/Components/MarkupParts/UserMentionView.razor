@namespace ActualChat.UI.Blazor.App.Components.MarkupParts
@using ActualChat.UI.Blazor.App.Components
@using ActualChat.UI.Blazor.App.Services
@inherits ComputedMarkupViewBase<UserMention, UserMentionView.Model>
@{
    var m = State.Value;
    var name = m.Name.NullIfEmpty()
        ?? Markup.Account?.Avatar.Name.NullIfEmpty()
        ?? Markup.NameOrNotAvailable;
    var isMember = m.IsMember;
    var tooltip = !isMember
        ? "Not a member of this chat"
        : m.HasRead == null
            ? null
            : m.HasRead.Value
                ? "Has read"
                : "Has not read";
}

<MentionBadge
    Label="@name"
    IsMember="@isMember"
    HasRead="@m.HasRead"
    Tooltip="@tooltip"
    OnClick="OnClick"/>

@code {
    private EditMembersUI EditMembersUI => Hub.Services.GetRequiredService<EditMembersUI>();

    protected override ComputedState<Model>.Options GetStateOptions()
        => ComputedStateComponent.GetStateOptions(GetType(),
            static t => new ComputedState<Model>.Options() {
                InitialValue = new Model("", true, null),
                UpdateDelayer = FixedDelayer.NextTick,
                Category = GetStateCategory(t),
            });

    protected override async Task<Model> ComputeState(CancellationToken cancellationToken) {
        var chatEntry = Entry;
        var chatId = chatEntry.ChatId.GetThreadOutermostParentOrSelf();
        var userId = Markup.UserId;
        var author = await Authors.GetByUserId(Session, chatId, userId, cancellationToken).ConfigureAwait(false);
        var isMember = author is { HasLeft: false };
        var name = await AuthorUI.GetUserName(chatId, userId, cancellationToken).ConfigureAwait(false);
        if (chatEntry.IsSystemEntry || !isMember)
            return new(name, isMember, null); // No read-tracking for system entries or non-members.

        var hasRead = await Chats.IsEntryReadByMentionedUser(Session, chatEntry.Id, Markup.Id, cancellationToken).ConfigureAwait(false);
        return new(name, isMember, hasRead);
    }

    private async Task OnClick() {
        var userId = Markup.UserId;
        if (userId.IsGuestOrNull())
            return;

        var chatId = Entry.ChatId;
        var author = await Authors.GetByUserId(Session, chatId, userId, CancellationToken.None).ConfigureAwait(false);
        if (author is not null) {
            await AuthorUI.Show(author.Id).ConfigureAwait(false);
            return;
        }

        // Non-member: invite to this chat when allowed, otherwise open their profile.
        var chat = await Chats.Get(Session, chatId, CancellationToken.None).ConfigureAwait(false);
        if (chat is not null && EditMembersUI.CanAddMembers(chat))
            _ = Hub.ModalUI.Show(new AddMemberModal.Model(chatId));
        else
            _ = Hub.History.NavigateTo(Links.User(userId));
    }

    // Nested types

    public sealed record Model(string Name, bool IsMember, bool? HasRead);
}
