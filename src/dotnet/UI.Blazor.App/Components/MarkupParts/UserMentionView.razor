@namespace ActualChat.UI.Blazor.App.Components.MarkupParts
@using ActualChat.UI.Blazor.App.Components
@using ActualChat.UI.Blazor.App.Services
@using ActualChat.UI.Blazor.Components
@using ActualChat.Notifications
@inherits ComputedMarkupViewBase<UserMention, UserMentionView.Model>
@{
    var m = State.Value;
    var name = m.Name.NullIfEmpty()
        ?? Markup.Account?.Avatar.Name.NullIfEmpty()
        ?? Markup.NameOrNotAvailable;
    var isMember = m.IsMember;
    var tooltip = !isMember
        ? L.Markup_NotAMember
        : m.HasRead == null
            ? null
            : m.HasRead.Value
                ? L.Markup_HasRead
                : L.Markup_HasNotRead;
}

<MentionBadge
    Label="@name"
    IsMember="@isMember"
    HasRead="@m.HasRead"
    IsInOwnMessage="@m.IsInOwnMessage"
    IsNotified="@m.IsNotified"
    AlertMenuRef="@GetAlertMenuRef(m)"
    Tooltip="@tooltip"
    OnClick="OnClick"/>

@code {
    private EditMembersUI EditMembersUI => Hub.Services.GetRequiredService<EditMembersUI>();
    private INotifications Notifications => Hub.Notifications;

    protected override ComputedState<Model>.Options GetStateOptions()
        => ComputedStateComponent.GetStateOptions(GetType(),
            static t => new ComputedState<Model>.Options() {
                InitialValue = new Model("", true, null, false, false, null),
                UpdateDelayer = FixedDelayer.NextTick,
                Category = GetStateCategory(t),
            });

    protected override async Task<Model> ComputeState(CancellationToken cancellationToken) {
        var chatEntry = Entry;
        var chatId = chatEntry.ChatId.GetThreadOutermostParentOrSelf();
        var userId = Markup.UserId;
        var author = await Authors.GetByUserId(Session, chatId, userId, cancellationToken).ConfigureAwait(false);
        var isMember = author is { HasLeft: false };
        var name = await AuthorUI.GetUserName(chatId, userId, cancellationToken).ConfigureAwait(false);
        if (chatEntry.IsSystemEntry || !isMember)
            return new(name, isMember, null, false, false, null); // No tracking for system entries or non-members.

        var alerts = await Notifications
            .ListMentionedMemberAlerts(Session, chatEntry.Id, cancellationToken)
            .ConfigureAwait(false);
        var alert = alerts.FirstOrDefault(a => a.UserId == userId);
        if (alert is not null)
            return new(name, isMember, alert.IsRead, true, alert.IsNotified, alert.AuthorId); // Own message.

        var hasRead = await Chats
            .IsEntryReadByMentionedUser(Session, chatEntry.Id, Markup.Id, cancellationToken)
            .ConfigureAwait(false);
        return new(name, isMember, hasRead, false, false, null);
    }

    private string GetAlertMenuRef(Model m)
        => m is { IsInOwnMessage: true, IsNotified: false, HasRead: not true } && m.MenuAuthorId is { } authorId
            ? MenuRef.New<MentionAlertMenu>(Entry.Id.Value, authorId.Value).ToString()
            : "";

    private async Task OnClick() {
        var userId = Markup.UserId;
        if (userId.IsGuestOrNull())
            return;

        var chatId = Entry.ChatId;
        var author = await Authors.GetByUserId(Session, chatId, userId, CancellationToken.None).ConfigureAwait(false);
        if (author is not null) {
            await AuthorUI.Show(author.Id).ConfigureAwait(false);
            return;
        }

        // Non-member: invite to this chat when allowed, otherwise open their profile.
        var chat = await Chats.Get(Session, chatId, CancellationToken.None).ConfigureAwait(false);
        if (chat is not null && EditMembersUI.CanAddMembers(chat))
            _ = Hub.ModalUI.Show(new AddMemberModal.Model(chatId));
        else
            _ = Hub.History.NavigateTo(Links.User(userId));
    }

    // Nested types

    public sealed record Model(
        string Name, bool IsMember, bool? HasRead, bool IsInOwnMessage, bool IsNotified, AuthorId? MenuAuthorId);
}
