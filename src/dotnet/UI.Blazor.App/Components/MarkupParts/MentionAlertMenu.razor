@namespace ActualChat.UI.Blazor.App.Components
@using ActualChat.Notifications
@inherits Menu<AppUIHub>
@{
    var chatEntryId = ChatEntryId.TryParse(Arguments.ElementAtOrDefault(0));
    var authorId = AuthorId.TryParse(Arguments.ElementAtOrDefault(1));
}

<div class="mention-alert-menu">
    <MenuEntry
        Icon="icon-bell"
        Text="@L.Alert_Alert"
        Click="@(() => OnAlert(chatEntryId, authorId))">
    </MenuEntry>
    <MenuEntry
        Icon="icon-megaphone"
        Text="@L.Alert_AlertAll"
        Click="@(() => OnAlertAll(chatEntryId))">
    </MenuEntry>
    <MenuEntry
        Icon="icon-person"
        Text="@L.Alert_Profile"
        Click="@(() => OnShowInfo(authorId))">
    </MenuEntry>
</div>

@code {
    private Task OnAlert(ChatEntryId? chatEntryId, AuthorId? authorId) {
        if (chatEntryId is not { } entryId || authorId is not { } aid)
            return Task.CompletedTask;

        var command = new Notifications_NotifyMentionedMembers {
            Session = Hub.Session,
            ChatEntryId = entryId,
            AuthorIds = ApiArray.New(aid),
        };
        return UICommander.Run(command);
    }

    private async Task OnAlertAll(ChatEntryId? chatEntryId) {
        if (chatEntryId is not { } entryId)
            return;

        var alerts = await Hub.Notifications
            .ListMentionedMemberAlerts(Hub.Session, entryId, CancellationToken.None)
            .ConfigureAwait(true);
        var alertable = alerts
            .Where(a => a is { IsNotified: false, IsRead: false })
            .Select(a => a.AuthorId)
            .ToApiArray();
        if (alertable.Count == 0)
            return;

        var command = new Notifications_NotifyMentionedMembers {
            Session = Hub.Session,
            ChatEntryId = entryId,
            AuthorIds = alertable,
        };
        await UICommander.Run(command).ConfigureAwait(true);
    }

    private Task OnShowInfo(AuthorId? authorId) {
        if (authorId is { } aid)
            return Hub.AuthorUI.Show(aid);

        return Task.CompletedTask;
    }
}
