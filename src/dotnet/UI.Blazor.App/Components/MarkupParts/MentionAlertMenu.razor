@namespace ActualChat.UI.Blazor.App.Components
@using ActualChat.Notifications
@inherits ComputedMenuBase<AppUIHub, ApiArray<AuthorId>>
@{
    var chatEntryId = ChatEntryId.TryParse(Arguments.ElementAtOrDefault(0));
    var authorId = AuthorId.TryParse(Arguments.ElementAtOrDefault(1));
    var alertable = State.Value;
}

<div class="mention-alert-menu">
    <MenuEntry
        Icon="icon-bell"
        Text="@L.Alert_Alert"
        Click="@(() => OnAlert(chatEntryId, authorId))">
    </MenuEntry>
    @if (alertable.Count > 1) {
        <MenuEntry
            Icon="icon-megaphone"
            Text="@L.Alert_AlertAll"
            Click="@(() => Notify(chatEntryId, alertable))">
        </MenuEntry>
    }
    <MenuEntry
        Icon="icon-person"
        Text="@L.Alert_Profile"
        Click="@(() => OnShowInfo(authorId))">
    </MenuEntry>
</div>

@code {
    protected override ComputedState<ApiArray<AuthorId>>.Options GetStateOptions()
        => ComputedStateComponent.GetStateOptions(GetType(),
            static t => new ComputedState<ApiArray<AuthorId>>.Options() {
                InitialValue = default,
                Category = GetStateCategory(t),
            });

    protected override async Task<ApiArray<AuthorId>> ComputeState(CancellationToken cancellationToken) {
        if (ChatEntryId.TryParse(Arguments.ElementAtOrDefault(0)) is not { } entryId)
            return default;

        var alerts = await Hub.Notifications
            .ListMentionedMemberAlerts(Hub.Session, entryId, cancellationToken)
            .ConfigureAwait(false);
        return alerts
            .Where(a => a is { IsNotified: false, IsRead: false })
            .Select(a => a.AuthorId)
            .ToApiArray();
    }

    private Task OnAlert(ChatEntryId? chatEntryId, AuthorId? authorId) {
        if (chatEntryId is not { } entryId || authorId is not { } aid)
            return Task.CompletedTask;

        return Notify(entryId, ApiArray.New(aid));
    }

    private Task Notify(ChatEntryId? chatEntryId, ApiArray<AuthorId> authorIds) {
        if (chatEntryId is not { } entryId || authorIds.Count == 0)
            return Task.CompletedTask;

        var command = new Notifications_NotifyMentionedMembers {
            Session = Hub.Session,
            ChatEntryId = entryId,
            AuthorIds = authorIds,
        };
        return UICommander.Run(command);
    }

    private Task OnShowInfo(AuthorId? authorId) {
        if (authorId is { } aid)
            return Hub.AuthorUI.Show(aid);

        return Task.CompletedTask;
    }
}
