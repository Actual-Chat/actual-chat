@namespace ActualChat.UI.Blazor.App.Components
@{
    var text = Text;
    var interval = Math.Max(1, Interval);
}
@for (var i = 0; i < text.Length; i += interval) {
    if (i > 0) {
        <wbr/>
    }
    @(text.Substring(i, Math.Min(interval, text.Length - i)))
}

@code {
    [Parameter] public string Text { get; set; } = "";
    [Parameter] public int Interval { get; set; } = 10;
}
