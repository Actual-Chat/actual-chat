@namespace ActualChat.UI.Blazor.App.Components.MarkupParts
@inherits MarkupViewBase<ChatMention>
@{
    // Markup.Name is set by the resolver — it already carries the "Place › Title"
    // prefix for cross-place chats, so use it rather than the raw Chat.Title.
    var name = Markup.NameOrNotAvailable;
    var url = Links.Chat(Markup.ChatId).Value;
}

<a href="@url" class="mention-markup mention-markup-chat mention-markup-valid cursor-pointer">
    <div class="truncate">"@name"</div>
</a>
