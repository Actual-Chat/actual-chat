@using ActualChat.UI.Blazor.App.Module
@inherits MarkupViewBase<CodeBlockMarkup>
@{
    var preCls = $"code-block-language-{Markup.Language}";
    if (!Markup.Language.IsNullOrEmpty())
        preCls += " language-" + Markup.Language;
    var title = Markup.Language.IsNullOrEmpty() ? "" : $"Language: {Markup.Language}";
    var menuRef = MenuRef.New<MessageMenu>(Entry.Id.Value, bool.FalseString, "", Markup.Code).ToString();
}

<div @ref="_rootRef" class="code-block-markup" data-menu="@menuRef">
    <div class="code-block-header">
        <div class="code-block-language"></div>
        <div class="code-block-actions">
            <HeaderButton Class="code-block-wrap-toggle btn-sm" Tooltip="@L.Markup_Wrap">
                <i class="icon-wrap"></i>
            </HeaderButton>
            <CopyTrigger Tooltip="" CopyText="@Markup.Code">
                <HeaderButton Class="btn-sm" Tooltip="@L.Markup_CopyCode">
                    <i class="icon-copy"></i>
                </HeaderButton>
            </CopyTrigger>
        </div>
    </div>
    <pre class="@preCls" title="@title">
        <code>@Markup.Code</code>
    </pre>
</div>

@code {
    private static readonly string JSHighlightCodeMethod = $"{BlazorUIAppModule.ImportName}.highlightCode";

    private ElementReference _rootRef;

    protected override Task OnAfterRenderAsync(bool firstRender)
        => JS.InvokeVoidAsync(JSHighlightCodeMethod, _rootRef, Markup.Language.NullIfWhiteSpace(), Markup.Code).AsTask();
}
