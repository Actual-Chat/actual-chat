@inherits ComputedMarkupViewBase<MentionMarkup, AuthorMentionView.Model>
@{
    var m = State.Value;
    var tooltip = m.HasRead == null
        ? ""
        : m.HasRead.Value
            ? "Has read"
            : "Has not read";
}

<AuthorBadgeTemplate AuthorId="@_authorId">
    @if (context?.Author is not { } author) {
        <div class="mention-markup mention-markup-invalid">@Markup.NameOrNotAvailable</div>
        return;
    }

    <MentionBadge
        Label="@author.Avatar.Name"
        IsOwn="@context.IsOwn"
        HasRead="@m.HasRead"
        Tooltip="@tooltip"
        OnClick="@(() => AuthorUI.Show(author.Id))"/>
</AuthorBadgeTemplate>

@code {
    private AuthorId? _authorId;
    private bool? _hasRead;

    protected override void OnParametersSet()
        => _authorId = Markup.Id.Target as AuthorId;

    protected override ComputedState<Model>.Options GetStateOptions()
        => ComputedStateComponent.GetStateOptions(GetType(),
            static t => new ComputedState<Model>.Options() {
                InitialValue = new Model(false),
                UpdateDelayer = FixedDelayer.NextTick,
                Category = GetStateCategory(t),
            });

    protected override async Task<Model> ComputeState(CancellationToken cancellationToken) {
        var chatEntry = Entry;
        _hasRead = chatEntry.IsSystemEntry ? null : false;

        if (_hasRead == null)
            return new(null); // Do not track hasRead status for mentions inside system messages.

        var chat = await Chats.Get(Session, chatEntry.ChatId, cancellationToken).ConfigureAwait(false);
        if (chat?.Rules.Author?.Id == _authorId)
            return new(true);

        if (!_hasRead.Value)
            _hasRead = await Chats.IsEntryReadByMentionedUser(Session, chatEntry.Id, Markup.Id, cancellationToken).ConfigureAwait(false);
        return new(_hasRead);
    }

    // Nested types

    public sealed record Model(bool? HasRead);
}
