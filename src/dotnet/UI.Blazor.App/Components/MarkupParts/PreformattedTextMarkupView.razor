@using ActualChat.Search
@inherits ComputedMarkupViewBase<PreformattedTextMarkup, PreformattedTextMarkupView.Model>
@{
    var m = State.Value;
}

<code class="preformatted-text-markup"
      title="Click to copy"
      @onclick="OnClick"
      @onclick:stopPropagation="true">
    @if (m.MustHighlight) {
        <SearchMatchHighlighter
            Match="m.SearchMatch"
            HighlightedClass="highlight"/>
    } else {
        @m.MarkupText
    }
</code>

@code {
    private ClipboardUI ClipboardUI => Hub.ClipboardUI;

    protected override ComputedState<Model>.Options GetStateOptions()
        => ComputedStateComponent.GetStateOptions(GetType(),
            t => new ComputedState<Model>.Options() {
                InitialValue = new(Markup.Text, SearchMatch.Empty),
                Category = GetStateCategory(t),
            });

    protected override async Task<Model> ComputeState(CancellationToken cancellationToken) {
        var entryId = Entry.Id;
        var markupText = Markup.Text;
        var searchMatch = await HighlightUI.GetMatch(entryId, markupText, cancellationToken).ConfigureAwait(false);
        return new(markupText, searchMatch);
    }

    private async Task OnClick() {
        await ClipboardUI.WriteText(Markup.Text);
        ToastUI.Show("Copied to clipboard", "icon-checkmark-circle-2", ToastDismissDelay.Short);
    }

    // Nested types

    public sealed record Model(string MarkupText, SearchMatch SearchMatch) {
        public bool MustHighlight => !SearchMatch.IsEmpty;
    }
}
