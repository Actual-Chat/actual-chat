@using ActualChat.Search
@namespace ActualChat.UI.Blazor.App.Components

<ChatIcon Chat="ContactInfo.Chat" ShowPresence="true"/>
<div class="contact-view-content">
    <span class="contact-view-headline">
        <SearchMatchHighlighter Match="@GetMatch(ContactInfo.Chat.Title)"/>
    </span>
</div>

@code {
    [Parameter, EditorRequired] public ContactInfo ContactInfo { get; set; } = null!;
    [Parameter] public SearchQuery SearchQuery { get; set; }

    private SearchMatch GetMatch(string text)
        => new(text, SearchQuery);
}
