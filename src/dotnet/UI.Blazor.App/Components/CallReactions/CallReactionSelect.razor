@namespace ActualChat.UI.Blazor.App.Components
@inherits ComponentBase<AppUIHub>

@if (_isShowingAll) {
    <AllReactionsSelect HasPreview="false" Click="@OnEmojiClick"/>
} else {
    <ul class="reaction-select">
        @foreach (var emoji in QuickEmojis) {
            <MenuEntry @key="emoji"
                Class="reaction-select-reaction"
                Click="@(() => OnEmojiClick(emoji))">
                <IconContent>
                    <EmojiIcon Emoji="@emoji" HasPreview="false" Class="reaction-select-reaction-emoji"/>
                </IconContent>
            </MenuEntry>
        }
        <li class="reaction-select-toggle" data-menu-keep-open @onclick="@ShowAll" @onclick:stopPropagation>
            <i class="icon-chevron-right text-3.5xl"></i>
        </li>
    </ul>
}

@code {
    private static readonly Emoji[] QuickEmojis = [
        Emojis.ThumbsUp,
        Emojis.Love,
        Emojis.Lol,
        Emojis.Surprise,
        Emojis.Party,
        Emojis.Fire,
    ];

    private bool _isShowingAll;

    [Parameter, EditorRequired] public ChatId ChatId { get; set; }

    private Task OnEmojiClick(Emoji emoji)
        => Hub.LiveSessionUI.SendReaction(ChatId, emoji, CancellationToken.None);

    private void ShowAll()
        => _isShowingAll = true;
}
