@namespace ActualChat.UI.Blazor.App.Components
@inherits ComputedMenuBase<AppUIHub, CallReactionsMenu.Model>
@{
    var m = State.Value;
    if (m.ChatId is not { } chatId)
        return;
}

<div class="call-reactions-menu">
    <MenuEntry
        Icon="icon-hand"
        Class="@(m.IsOwnHandRaised ? "on" : "")"
        Text="@(m.IsOwnHandRaised ? L.Call_LowerHand : L.Call_RaiseHand)"
        Click="@(() => OnHandClick(chatId, !m.IsOwnHandRaised))"/>
    <MenuEntrySeparator/>
    @if (_isShowingAll) {
        <AllReactionsSelect HasPreview="false" Click="@(emoji => OnEmojiClick(chatId, emoji))"/>
    } else {
        <ul class="reaction-select">
            @foreach (var emoji in QuickEmojis) {
                <MenuEntry @key="emoji"
                    Class="reaction-select-reaction"
                    Click="@(() => OnEmojiClick(chatId, emoji))">
                    <IconContent>
                        <EmojiIcon Emoji="@emoji" HasPreview="false" Class="reaction-select-reaction-emoji"/>
                    </IconContent>
                </MenuEntry>
            }
            <li class="reaction-select-toggle" data-menu-keep-open @onclick="@ShowAll" @onclick:stopPropagation>
                <i class="icon-chevron-right text-3.5xl"></i>
            </li>
        </ul>
    }
</div>

@code {
    private static readonly Emoji[] QuickEmojis = [
        Emojis.ThumbsUp,
        Emojis.Love,
        Emojis.Lol,
        Emojis.Surprise,
        Emojis.Party,
        Emojis.Fire,
    ];

    private ChatId? _chatId;
    private bool _isShowingAll;

    private LiveSessionUI LiveSessionUI => Hub.LiveSessionUI;

    protected override void OnParametersSet() {
        if (Arguments is not [ var sChatId ])
            throw new ArgumentOutOfRangeException(nameof(Arguments));

        _chatId = ChatId.TryParse(sChatId);
    }

    protected override ComputedState<Model>.Options GetStateOptions()
        => ComputedStateComponent.GetStateOptions(GetType(),
            static t => new ComputedState<Model>.Options() {
                InitialValue = Model.None,
                Category = GetStateCategory(t),
            });

    protected override async Task<Model> ComputeState(CancellationToken cancellationToken) {
        if (_chatId is not { } chatId)
            return Model.None;

        var isOwnHandRaised = await LiveSessionUI.IsOwnHandRaised(chatId, cancellationToken).ConfigureAwait(false);
        return new Model(chatId, isOwnHandRaised);
    }

    private Task OnHandClick(ChatId chatId, bool isRaised)
        => LiveSessionUI.SetOwnHandRaised(chatId, isRaised, CancellationToken.None);

    private Task OnEmojiClick(ChatId chatId, Emoji emoji)
        => LiveSessionUI.SendReaction(chatId, emoji, CancellationToken.None);

    private void ShowAll()
        => _isShowingAll = true;

    // Nested types

    public sealed record Model(ChatId? ChatId, bool IsOwnHandRaised) {
        public static readonly Model None = new(null, false);
    }
}
