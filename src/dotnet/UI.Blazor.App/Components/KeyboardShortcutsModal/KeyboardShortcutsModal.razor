@namespace ActualChat.UI.Blazor.App.Components
@inherits ComponentBase<AppUIHub>
@implements IModalView<KeyboardShortcutsModal.Model>

@* The global ctrl+/ Hotkey is inert while this modal is open, so this one takes
   over and turns the second press into a toggle-off. *@
<Hotkey Keys="ctrl+/" AriaLabel="@L.Shortcuts_CloseAriaLabel" OnTrigger="@(() => Modal.Close())"/>
<DialogFrame
    Class="keyboard-shortcuts-modal"
    Title="@L.Shortcuts_Title"
    HasCloseButton="true"
    NarrowViewSettings="@DialogFrameNarrowViewSettings.Bottom">
    <Body>
        <div class="keyboard-shortcuts">
            @foreach (var sec in _sections) {
                <TileTopic Topic="@sec.Title"/>
                <Card>
                    @for (var s = 0; s < sec.Shortcuts.Length; s++) {
                        if (s > 0) {
                            <Divider/>
                        }
                        var shortcut = sec.Shortcuts[s];
                        if (shortcut.Caption != null) {
                            <CardItem>
                                <Title>@shortcut.Description</Title>
                                <Caption>@shortcut.Caption</Caption>
                                <Right>@RenderKeys(shortcut)</Right>
                            </CardItem>
                        }
                        else {
                            <CardItem>
                                <Title>@shortcut.Description</Title>
                                <Right>@RenderKeys(shortcut)</Right>
                            </CardItem>
                        }
                    }
                </Card>
            }
        </div>
    </Body>
</DialogFrame>

@code {
    private Section[] _sections = [];
    [CascadingParameter] public Modal Modal { get; set; } = null!;
    [Parameter] public Model ModalModel { get; set; } = null!;

    protected override void OnInitialized() {
        var mod = Hub.BrowserInfo.IsMacOS ? "⌘" : "Ctrl";
        _sections = [
            new(L.Shortcuts_General, [
                new(L.Shortcuts_JumpToChat, [[mod, "K"]]),
                new(L.Shortcuts_SearchChats, [[mod, "F"]]),
                new(L.Shortcuts_FocusEditor, [[mod, "E"]]),
                new(L.Shortcuts_KeyboardShortcuts, [[mod, "/"]]),
                new(L.Shortcuts_CloseDialog, [["Esc"]]),
            ]),
            new(L.Shortcuts_Messages, [
                new(L.Shortcuts_SendMessage, [["Enter"]]),
                new(L.Shortcuts_NewLine, [["Shift", "Enter"]]),
                new(L.Shortcuts_EditLastMessage, [["↑"]], L.Shortcuts_EditLastMessageCaption),
                new(L.Shortcuts_CancelEditing, [["Esc"]]),
            ]),
            new(L.Shortcuts_Chat, [
                new(L.Shortcuts_ScrollChat, [["PgUp"], ["PgDn"]]),
                new(L.Shortcuts_PrevNextMedia, [["←"], ["→"]]),
            ]),
            new(L.Shortcuts_Navigation, [
                new(L.Shortcuts_MoveFocus, [["Tab"], ["Shift", "Tab"]]),
                new(L.Shortcuts_NavigateLists, [["↑"], ["↓"]]),
                new(L.Shortcuts_FirstLastItem, [["Home"], ["End"]]),
                new(L.Shortcuts_PressControl, [["Enter"], ["Space"]]),
                new(L.Shortcuts_ToggleSelection, [["Space"], ["X"]]),
            ]),
        ];
    }

    // Private methods

    private RenderFragment RenderKeys(Shortcut shortcut) => @<div class="c-keys">
        @for (var i = 0; i < shortcut.Combos.Length; i++) {
            if (i > 0) {
                <span class="c-sep">/</span>
            }
            var combo = shortcut.Combos[i];
            for (var j = 0; j < combo.Length; j++) {
                if (j > 0) {
                    <span class="c-sep">+</span>
                }
                <kbd>@combo[j]</kbd>
            }
        }
    </div>;

    // Nested types

    public sealed record Model;

    private sealed record Section(string Title, Shortcut[] Shortcuts);
    private sealed record Shortcut(string Description, string[][] Combos, string? Caption = null);
}
