@namespace ActualChat.UI.Blazor.App.Components
@using ActualChat.Search
@using ActualChat.Media
@inherits ComponentBase<AppUIHub>
@implements IModalView<IncomingShareModal.Model>
@{
    var selectedChatIds = SelectedChatIds;
    var destinationSelected = selectedChatIds.Count > 0;
    var shareButtonClass = !destinationSelected ? "hidden" : "";
    shareButtonClass += " btn-modal btn-primary share-button";
    var showFilePreview = selectedChatIds.Count == 1 && ModalModel.Files.Length <= Constants.Attachments.FileCountLimit;
    var showCommentEditor = destinationSelected && (!ModalModel.HasFiles || !showFilePreview);
}

<DialogFrame
    Class="share-incoming-modal"
    HasCloseButton="true"
    Title="Share to"
    NarrowViewSettings="@DialogFrameNarrowViewSettings.Stretch">
    <Body>
        <ContactSelector
            @ref="@_contactSelectorRef"
            Changed="StateHasChanged"
            ChatListPreOrder="@ChatListPreOrder.ChatList"
            SearchPhrase="@_searchPhrase">
            <SearchBoxNew
                Placeholder="Who would you like to share with"
                MaxLength="@Constants.Chat.MaxSearchFilterLength"
                TextChanged="@OnFilter"/>
            <ContactSelectorPlacePicker/>
            <ContactSelectorListView/>
        </ContactSelector>
    </Body>
    <Footer>
        @if (showCommentEditor) {
            <EmbeddedMessageEditor
                Text="@_comment"
                Placeholder="Add your comment (optional)"
                TextChanged="OnCommentChanged"/>
        }
    </Footer>
    <Buttons>
        @if (ModalModel.HasFiles) {
            <Button
                Class="@shareButtonClass"
                IsDisabled="@(!destinationSelected)"
                Click="@(() => ShareFiles(showFilePreview))">
                <span>@(showFilePreview ? "Next" : "Send")</span>
            </Button>
        } else {
            <Button
                Class="@shareButtonClass"
                IsDisabled="@(!destinationSelected)"
                Click="@(() => ShareText(_comment))">
                <span>Send</span>
            </Button>
        }
    </Buttons>
</DialogFrame>

@code {
    private ContactSelector? _contactSelectorRef;
    private SearchPhrase _searchPhrase = SearchPhrase.None;
    private string _comment = "";

    private SendingMessages SendingMessages => Hub.SendingMessages;
    private ILogger Log => field ??= Hub.LogFor(GetType());
    private VisualMediaDimensions VisualMediaDimensions => field ??= new VisualMediaDimensions(Hub.JS);

    private ImmutableHashSet<ChatId> SelectedChatIds
        => _contactSelectorRef?.SelectedChatIds.Value ?? ImmutableHashSet<ChatId>.Empty;

    [CascadingParameter] public Modal Modal { get; set; } = null!;
    [Parameter] public Model ModalModel { get; set; } = null!;

    private void OnFilter(string filter) {
        _searchPhrase = filter.ToSearchPhrase(true, false);
        StateHasChanged();
    }

    private Task OnCommentChanged(string text) {
        _comment = text;
        return Task.CompletedTask;
    }

    private async Task ShareText(string comment)
    {
        var selectedChatIds = SelectedChatIds;
        if (selectedChatIds.Count == 0)
            return;

        var text = ModalModel.Text;
        CancellationToken cancellationToken = default;
        foreach (var chatId in selectedChatIds) {
            if (!comment.IsNullOrEmpty()) {
                var cmd2 = new SendMessageRequest(chatId, null, comment);
                _ = SendingMessages.Post(cmd2, cancellationToken);
            }

            var cmd = new SendMessageRequest(chatId, null, text);
            _ = SendingMessages.Post(cmd, cancellationToken);
        }

        Modal.Close(true);
        await Services.GetRequiredService<History>()
            .NavigateTo(Links.Chat(selectedChatIds.First()));
    }

    private async Task ShareFiles(bool showFilePreview)
    {
        var selectedChatIds = SelectedChatIds;
        if (selectedChatIds.Count == 0)
            return;

        if (showFilePreview) {
            var chatId = SelectedChatIds.First();
            Services.GetRequiredService<SentAttachmentsStorage>()
                .Push(chatId, ModalModel.Files);
            Modal.Close(true);
            await Hub.History.NavigateTo(Links.Chat(chatId));
            return;
        }

        Modal.Close(true);
        try {
            var postTasks = new List<(Task, ChatId, int)>();
            foreach (var chatId in selectedChatIds) {
                var comment = _comment;
                foreach (var filesChunk in ModalModel.Files.Chunk(Constants.Attachments.FileCountLimit)) {
                    var attachmentList = await CreateAttachmentList(filesChunk);
                    var postTask = PostMessage(chatId, comment, attachmentList);
                    comment = "";
                    postTasks.Add((postTask, chatId, filesChunk.Length));
                }
            }

            await Task.WhenAll(postTasks.Select(c => c.Item1));
            var failedTasks = postTasks
                .Where(c => !c.Item1.IsCompletedSuccessfully)
                .ToArray();
            if (failedTasks.Length == 0)
                return;

            var failedToUploadFilesNumber = failedTasks
                .Sum(c => c.Item3); // Failed to arrange message sending.
            var info = $"Failed to share {failedToUploadFilesNumber} files";
            ToastUI.Show(info, "icon-alert-circle", ToastDismissDelay.Long);
        }
        catch (Exception e) {
            Log.LogError(e, "Failed to share files");
            ToastUI.Show("Failed to share files", "icon-alert-circle", ToastDismissDelay.Long);
        }
    }

    private async Task<ReadonlyAttachmentList> CreateAttachmentList(IEnumerable<AttachFileInfo> fileInfos) {
        Exception? fileSizeLimitError = null;
        var attachments = new List<Attachment>();
        foreach (var fileInfo in fileInfos) {
            var fileProvider = fileInfo.FileProvider;
            var fileMetadata = fileProvider.Metadata;
            if (fileMetadata.Length > Constants.Attachments.FileSizeLimit) {
                Log.LogWarning("File size limit exceeded for '{Url}'. Actual size is {FileSize}", fileMetadata.FileName, fileMetadata.Length);
                fileSizeLimitError ??= AttachmentList.FileTooBigError();
                continue;
            }
            // TODO: Do not request preview url here, because we are not going to display attachment,
            // but rather post a message immediately.
            var previewUrl = "";
            var width = 0;
            var height = 0;
            if (MediaTypeExt.IsVisualMedia(fileMetadata.FileType)) {
                previewUrl = await fileProvider.GetPreviewUrl();
                var dimensions = await VisualMediaDimensions.GetVisualMediaDimensions(previewUrl, fileMetadata.FileType);
                width = dimensions.width;
                height = dimensions.height;
            }
            var attachment = new Attachment(fileMetadata.FileName, fileMetadata.FileType, fileMetadata.Length, previewUrl, width, height) {
                FileProvider = fileProvider,
            };
            attachment.Cleanups.Add(AttachmentCleanupFactory.ForFile(fileProvider));
            attachments.Add(attachment);
        }
        if (fileSizeLimitError != null)
            Services.UICommander().ShowError(fileSizeLimitError);
        return new ReadonlyAttachmentList(attachments);
    }

    private async Task PostMessage(ChatId chatId, string comment, IAttachmentList attachments)
    {
        var cmd = new SendMessageRequest(chatId, null, comment) {
            RepliedEntryLid = null,
            Attachments = attachments,
            AfterSendMessageHandlerKey = SendingMessages.AfterSendMessageHandlerKeys.IncomingShare,
            AfterSendMessageHandlerArgs = attachments.Count.ToInvariantString(),
        };
        var postTask = await SendingMessages.Post(cmd, default).ConfigureAwait(false);
        await postTask.SilentAwait(); // IncomingShareAfterSendMessageHandler will handle a send result.
    }

    // Nested types

    public sealed record Model {
        public AttachFileInfo[] Files { get; } = [];
        public string Text { get; } = "";
        public bool HasFiles => Files.Length > 0;

        public Model(string plainText)
            => Text = plainText;

        public Model(AttachFileInfo[] files)
            => Files = files;
    }
}
