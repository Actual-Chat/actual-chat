@namespace ActualChat.UI.Blazor.App.Components
@inherits ComputedMenuBase<AppUIHub, ChatState?>
@{
    var m = State.Value;
    if (m == null)
        return;

    var chat = m.Chat;
    var rules = chat.Rules;
    var shareChatTitle = chat.Id is PeerChatId
        ? "Share contact"
        : chat.IsPublic
            ? "Share chat"
            : "Share chat join link";
}

<CascadingValue Value="m">
    <MenuEntry
        Icon="icon-layout"
        Class="important-item"
        Text="Open right panel"
        Click="@OnOpenRightPanelClick">
    </MenuEntry>
@*
    <MenuEntry
        Icon="icon-phone-call"
        Text="Start Voice call">
    </MenuEntry>
    <MenuEntry
        Icon="icon-video"
        Text="Start Video call">
    </MenuEntry>
    <MenuEntry
        Icon="icon-ai-search"
        Text="Search in chat">
    </MenuEntry>
    <MenuEntry
        Icon="icon-translation">
        <TextContent>
            <div class="translation-menu-entry">
                <span>Translate to</span>
                <span class="menu-entry-selected-language">Russian</span>
            </div>
        </TextContent>
    </MenuEntry>
*@
    <MenuEntry
        Icon="icon-share"
        Text="@shareChatTitle"
        Click="@OnShareClick">
    </MenuEntry>
    <ChatMenuAddMember/>
    @if (rules.CanLeave()) {
        <ChatMenuLeave/>
    }
</CascadingValue>

@code {
    private ChatId _chatId = null!;

    private ChatUI ChatUI => Hub.ChatUI;
    private ChatAudioUI ChatAudioUI => Hub.ChatAudioUI;
    private ChatVideoUI ChatVideoUI => Hub.ChatVideoUI;

    [CascadingParameter] public ScreenSize ScreenSize { get; set; }

    protected override async Task OnParametersSetAsync() {
        if (Arguments is not [ var sChatId])
            throw new ArgumentOutOfRangeException(nameof(Arguments));

        _chatId = ChatId.Parse(sChatId);
        await base.OnParametersSetAsync();
    }

    protected override Task<ChatState?> ComputeState(CancellationToken cancellationToken)
        => ChatUI.GetState(_chatId, false, cancellationToken);

    private void OnOpenRightPanelClick()
        => Hub.PanelsUI.Right.Toggle();

    private Task OnShareClick()
        => Hub.ShareUI.Share(_chatId);

    private void OnScreenShareClick()
    {
        ChatVideoUI.StartScreenCasting(_chatId);
        _ = ChatAudioUI.SetListeningState(_chatId, true);
    }
}
