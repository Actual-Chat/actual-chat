@namespace ActualChat.UI.Blazor.App.Components
@using ActualChat.UI.Blazor.App.Module
@inherits ComponentBase<AppUIHub>
@implements GrantFileUploadsSubHeader.IGrantFileUploadsSubHeader

<SubHeader Class="grant-file-upload-permissions-subheader" IsVisible="@_isVisible">
    @if (!ScreenSize.IsNarrow()) {
        <div class="c-icon">
            <i class="icon-alert-circle"></i>
        </div>
    }
    <div class="c-content">
        <span>@L.Uploads_Pending</span>
    </div>
    <div class="c-buttons">
        <Button Class="btn-transparent btn-primary" Click="InvokeGrantFilePermissions">@L.Uploads_Resume</Button>
    </div>
</SubHeader>

@code {
    private bool _isVisible;
    private DotNetObjectReference<IGrantFileUploadsSubHeader>? BlazorRef { get; set; }

    [CascadingParameter] public ScreenSize ScreenSize { get; set; }

    private Task InvokeGrantFilePermissions()
        => JS.InvokeVoidAsync($"{BlazorUIAppModule.ImportName}.WebFileProviders.grantFileUploadPermissions").AsTask();

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (!firstRender)
            return;

        BlazorRef = DotNetObjectReference.Create<IGrantFileUploadsSubHeader>(this);
        await JS.InvokeVoidAsync($"{BlazorUIAppModule.ImportName}.WebFileProviders.startMonitorGrantPermissionsRequests", BlazorRef);
    }

    [JSInvokable]
    public void OnPendingRequestsHaveChanged(bool hasPendingRequests) {
        _isVisible = hasPendingRequests;
        StateHasChanged();
    }

    // Nested types
    public interface IGrantFileUploadsSubHeader {
        void OnPendingRequestsHaveChanged(bool hasPendingRequests);
    }
}
