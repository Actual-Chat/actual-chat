@namespace ActualChat.UI.Blazor.App.Components
@inherits ComponentBase<AppUIHub>

<div class="author-modal-header">
    <ButtonRound Click="@OnCollapse" Class="author-modal-close-btn close-btn btn-sm">
        <i class="icon-close text-2xl"></i>
    </ButtonRound>

    <div class="c-top">
        <AuthorCircle
            AuthorId="@Author.Id"
            Size="SquareSize.SizeFull"
            IsBlurred="@true"
            IsSquare="@true" />
    </div>

    <div class="c-center">
        <AuthorCircle
            AuthorId="@Author.Id"
            Size="SquareSize.Size16" />
    </div>

    <div class="c-bottom">
        <div class="c-title">
            <span class="call-text">@CallText</span>
            <AuthorName AuthorId="@Author.Id" Class="text-02 text-title-500" ShowDetailsOnClick="false"/>
        </div>
        @* A ring says it all in its title *@
        @if (Stage is not (CallStage.None or CallStage.Incoming)) {
            <CallStatus
                Text="@Hub.CallScreensUI.GetStatusText(Stage)"
                IsAnswered="@(Stage is CallStage.Connecting or CallStage.Connected)"
                IsInProgress="@Stage.IsInProgress()"/>
        }
    </div>
</div>

@code {
    [CascadingParameter] public Modal Modal { get; set; } = null!;
    [Parameter, EditorRequired] public Author Author { get; set; } = null!;
    [Parameter, EditorRequired] public bool IsOwn { get; set; }
    [Parameter] public CallStage Stage { get; set; }
    [Parameter] public EventCallback OnCollapse { get; set; }

    private string CallText => IsOwn ? L.Call_OutgoingTo : L.Call_IncomingFrom;
}
