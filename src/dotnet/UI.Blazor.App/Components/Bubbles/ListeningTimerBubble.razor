@namespace ActualChat.UI.Blazor.App.Components
@inherits BubbleBase
@using ActualChat.UI.Blazor.Events
@inject UIEventHub UIEventHub

<div class="bubble-content">
    <div class="c-body">
        <div class="c-content">
            <div class="bubble-body">
                Listening will automatically stop once the timer runs out.
            </div>
        </div>
    </div>
    <div class="bubble-buttons flex justify-end">
        <Button Class="btn-bubble" Click="@OnSetListeningTime">Listening settings</Button>
        <Button Class="btn-bubble btn-next" Click="@OnOk">Ok</Button>
    </div>
</div>

@code {
    private void OnSetListeningTime() {
        _ = UIEventHub.Publish(new ShowSettingsEvent(SettingsTabId.Transcription));
        _ = Host.ReadBubble(this);
    }

    private Task OnOk()
        => Host.ReadBubble(this);
}
