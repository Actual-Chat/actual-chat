@namespace ActualChat.UI.Blazor.App.Components
@inherits BubbleBase
@using ActualChat.UI.Blazor.Events

<div class="bubble-content">
    <div class="c-body">
        <div class="c-content">
            <div class="bubble-body">
                @L.Bubble_ListeningTimerBody
            </div>
        </div>
    </div>
    <div class="bubble-buttons flex justify-end">
        <Button Class="btn-bubble" Click="@OnSetListeningTime">@L.Bubble_ListeningTimerSettings</Button>
        <Button Class="btn-bubble btn-next" Click="@OnOk">@L.Common_OK</Button>
    </div>
</div>

@code {
    private void OnSetListeningTime() {
        _ = UIEventHub.Publish(new ShowSettingsEvent(SettingsTabId.Transcription));
        _ = Host.ReadBubble(this);
    }

    private Task OnOk()
        => Host.ReadBubble(this);
}
