@namespace ActualChat.UI.Blazor.App.Components
@inherits BubbleBase

<BubbleContent Bubble="@(this)">
    <Title>@L.Bubble_PrivacyTitle</Title>
    <Body>
    <p>
        @L.Bubble_PrivacyBelieve_Prefix<strong
            >@L.Bubble_PrivacyBelieveTarget</strong>@L.Bubble_PrivacyBelieve_Suffix(CoreConstants.AppName)
    </p>
    <p>
        @L.Bubble_PrivacyRecording_Prefix<strong
            >@L.Bubble_PrivacyRecordingTarget</strong>@L.Bubble_PrivacyRecording_Suffix
    </p>
    </Body>
</BubbleContent>
