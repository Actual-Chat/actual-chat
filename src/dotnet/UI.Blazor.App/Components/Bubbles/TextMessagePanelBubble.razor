@namespace ActualChat.UI.Blazor.App.Components
@inherits BubbleBase

<BubbleContent Bubble="@(this)">
    <Title>@L.Bubble_TextMessagePanelTitle</Title>
    <Body>
    <p>
        @L.Bubble_TextMessagePanelBody
    </p>
    <ul>
        <li>@L.Bubble_TextMessagePanelMention_Prefix<pre>@@</pre>@L.Bubble_TextMessagePanelMention_Suffix</li>
        <li><pre>*</pre><em>@L.Bubble_TextMessagePanelItalic</em><pre>*</pre>,
            <pre>**</pre><strong>@L.Bubble_TextMessagePanelBold</strong><pre>**</pre>,
            <pre>`</pre>@L.Bubble_TextMessagePanelFixedWidth<pre>`</pre></li>
        <li>@L.Bubble_TextMessagePanelCodeBlock_Prefix<pre>```</pre>@L.Bubble_TextMessagePanelCodeBlock_Suffix</li>
    </ul>
    </Body>
</BubbleContent>
