@namespace ActualChat.UI.Blazor.App.Components

<div class="c-hero">
    <img draggable="false" src="/dist/images/guide/loc-access.svg" alt="Location access is blocked">
</div>
<div class="c-title">
    Location access is blocked, but you can fix this!
</div>
<div class="c-intro">
    @CoreConstants.AppName needs access to your location to share it with others.
    To enable it in Safari or any other browser on iOS:
</div>
<ol class="c-steps">
    <li>Open iOS Settings app, then "Safari" section</li>
    <li>Go to "Settings for websites" (section) &gt; Location</li>
    <li>Change "Location access on all websites" to "Ask"</li>
</ol>
