@namespace ActualChat.UI.Blazor.App.Components

<div class="c-hero">
    <img draggable="false" src="/dist/images/guide/loc-access.svg" alt="Location access is blocked">
</div>
<div class="c-title">
    Location access is blocked, but you can fix this!
</div>
<div class="c-intro">
    @CoreConstants.AppName needs access to your location to share it with others.
    To enable it in Microsoft Edge:
</div>
<ol class="c-steps">
    <li>Click "⋯" &gt; "Settings" on Windows, or "Microsoft Edge" &gt; "Preferences" on MacOS</li>
    <li>Choose "Cookies and Site Permissions"</li>
    <li>Select "Location"</li>
    <li>Delete "@Constants.Hosts.Voxt" from "Block" list</li>
    <li>Reopen @CoreConstants.AppName and allow it to use location</li>
</ol>
