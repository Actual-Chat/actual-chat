@namespace ActualChat.UI.Blazor.App.Components
@inherits ComponentBase<UIHub>

<div class="c-hero">
    <img draggable="false" src="/dist/images/guide/loc-access.svg" alt="@L.LocationGuide_BlockedImageAlt">
</div>
<div class="c-title">
    @L.LocationGuide_Title
</div>
<div class="c-intro">
    @L.LocationGuide_Intro_Format(CoreConstants.AppName)
    @L.Guide_EnableInWebChrome
</div>
<ol class="c-steps">
    <li>@L.LocationGuide_WebChromeStep1</li>
    <li>@L.LocationGuide_WebChromeStep2</li>
    <li>@L.LocationGuide_WebChromeStep3</li>
    <li>@L.LocationGuide_WebChromeStep4</li>
    <li>@L.LocationGuide_WebChromeStep5</li>
    <li>@L.LocationGuide_WebChromeStep6_Format(Constants.Hosts.Voxt)</li>
    <li>@L.LocationGuide_WebChromeStep7</li>
</ol>
