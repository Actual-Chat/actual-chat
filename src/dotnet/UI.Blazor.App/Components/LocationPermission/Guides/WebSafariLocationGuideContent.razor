@namespace ActualChat.UI.Blazor.App.Components

<div class="c-hero">
    <img draggable="false" src="/dist/images/guide/loc-access.svg" alt="Location access is blocked">
</div>
<div class="c-title">
    Location access is blocked, but you can fix this!
</div>
<div class="c-intro">
    @CoreConstants.AppName needs access to your location to share it with others.
    To enable it in Apple Safari:
</div>
<ol class="c-steps">
    <li>Go to Safari Preferences</li>
    <li>Choose "Websites" category</li>
    <li>Select "Location" on the left</li>
    <li>Change "@Constants.Hosts.Voxt" entry's value from "Deny" to "Allow" or "Ask"</li>
</ol>
