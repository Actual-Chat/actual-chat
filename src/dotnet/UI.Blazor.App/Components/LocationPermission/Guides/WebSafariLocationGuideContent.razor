@namespace ActualChat.UI.Blazor.App.Components
@inherits ComponentBase<UIHub>

<div class="c-hero">
    <img draggable="false" src="/dist/images/guide/loc-access.svg" alt="@L.LocationGuide_BlockedImageAlt">
</div>
<div class="c-title">
    @L.LocationGuide_Title
</div>
<div class="c-intro">
    @L.LocationGuide_Intro_Format(CoreConstants.AppName)
    @L.Guide_EnableInWebSafari
</div>
<ol class="c-steps">
    <li>@L.LocationGuide_WebSafariStep1</li>
    <li>@L.LocationGuide_WebSafariStep2</li>
    <li>@L.LocationGuide_WebSafariStep3</li>
    <li>@L.LocationGuide_WebSafariStep4_Format(Constants.Hosts.Voxt)</li>
</ol>
