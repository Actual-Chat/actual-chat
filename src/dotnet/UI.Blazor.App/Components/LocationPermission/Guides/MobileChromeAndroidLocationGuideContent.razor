@namespace ActualChat.UI.Blazor.App.Components
@inherits ComponentBase<UIHub>

<div class="c-hero">
    <img draggable="false" src="/dist/images/guide/loc-access.svg" alt="@L.LocationGuide_BlockedImageAlt">
</div>
<div class="c-title">
    @L.LocationGuide_Title
</div>
<div class="c-intro">
    @L.LocationGuide_Intro_Format(CoreConstants.AppName)
    @L.Guide_EnableInMobileChrome
</div>
<ol class="c-steps">
    <li>@L.LocationGuide_MobileChromeStep1</li>
    <li>@L.LocationGuide_MobileChromeStep2</li>
    <li>@L.LocationGuide_MobileChromeStep3</li>
    <li>@L.LocationGuide_MobileChromeStep4</li>
    <li>@L.LocationGuide_MobileChromeStep5</li>
</ol>
