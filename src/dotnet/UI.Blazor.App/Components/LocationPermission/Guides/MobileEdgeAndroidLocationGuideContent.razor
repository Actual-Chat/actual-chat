@namespace ActualChat.UI.Blazor.App.Components
@inherits ComponentBase<UIHub>

<div class="c-hero">
    <img draggable="false" src="/dist/images/guide/loc-access.svg" alt="@L.LocationGuide_BlockedImageAlt">
</div>
<div class="c-title">
    @L.LocationGuide_Title
</div>
<div class="c-intro">
    @L.LocationGuide_Intro_Format(CoreConstants.AppName)
    @L.Guide_EnableInMobileEdge
</div>
<ol class="c-steps">
    <li>@L.LocationGuide_MobileEdgeStep1</li>
    <li>@L.LocationGuide_MobileEdgeStep2</li>
    <li>@L.LocationGuide_MobileEdgeStep3</li>
    <li>@L.LocationGuide_MobileEdgeStep4</li>
    <li>@L.LocationGuide_MobileEdgeStep5</li>
    <li>@L.LocationGuide_MobileEdgeStep6</li>
    <li>@L.LocationGuide_MobileEdgeStep7</li>
    <li>@L.LocationGuide_MobileEdgeStep8</li>
</ol>
