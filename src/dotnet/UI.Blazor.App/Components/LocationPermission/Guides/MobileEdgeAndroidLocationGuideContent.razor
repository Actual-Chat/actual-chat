@namespace ActualChat.UI.Blazor.App.Components

<div class="c-hero">
    <img draggable="false" src="/dist/images/guide/loc-access.svg" alt="Location access is blocked">
</div>
<div class="c-title">
    Location access is blocked, but you can fix this!
</div>
<div class="c-intro">
    @CoreConstants.AppName needs access to your location to share it with others.
    To enable it in Microsoft Edge (mobile):
</div>
<ol class="c-steps">
    <li>Tap middle button on the navigation bar</li>
    <li>Go to "Settings"</li>
    <li>Choose "Privacy and security"</li>
    <li>Go to "Site permissions"</li>
    <li>Choose "Location"</li>
    <li>Enable "Ask first before allowing sites to use your location" option</li>
    <li>Check if Edge itself has location access permission</li>
    <li>If not, allow Edge to use location</li>
</ol>
