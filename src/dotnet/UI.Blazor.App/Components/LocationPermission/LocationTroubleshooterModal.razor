@using ActualChat.Hosting
@using ActualChat.UI
@namespace ActualChat.UI.Blazor.App.Components
@inherits ComponentBase<AppUIHub>
@implements IModalView<LocationTroubleshooterModal.Model>
@{
    var isMaui = HostInfo.HostKind.IsMauiApp();
    GuideType type;
    if (ModalModel.TestGuideType is { } testGuideType) {
        type = testGuideType;
    } else if (isMaui) {
        type = HostInfo.AppKind switch {
            AppKind.Ios => GuideType.IosApp,
            AppKind.Android => GuideType.AndroidApp,
            _ => GuideType.WebChrome,
        };
    } else {
        if (ScreenSize.IsNarrow()) {
            if (BrowserInfo.IsEdge) {
                type = GuideType.MobileEdgeAndroid;
            } else if (BrowserInfo.IsWebKit)
                type = GuideType.MobileSafariIos;
            else
                type = GuideType.MobileChromeAndroid;
        } else {
            if (BrowserInfo.IsEdge) {
                type = GuideType.WebEdge;
            } else if (BrowserInfo.IsWebKit)
                type = GuideType.WebSafari;
            else
                type = GuideType.WebChrome;
        }
    }
    var primaryButtonTitle = isMaui ? "Settings" : "OK";
}

<DialogFrame
    Class="guide-modal"
    BodyClass="no-scrollbar"
    Title="Location access"
    HasCloseButton="true"
    NarrowViewSettings="@DialogFrameNarrowViewSettings.ForSubmitButton(OnPrimaryClick, primaryButtonTitle)">
    <Body>
    <FormBlock>
        @switch (type) {
            case GuideType.MobileSafariIos:
                <MobileSafariIosLocationGuideContent/>
                break;
            case GuideType.WebEdge:
                <WebEdgeLocationGuideContent/>
                break;
            case GuideType.WebSafari:
                <WebSafariLocationGuideContent/>
                break;
            case GuideType.MobileChromeAndroid:
                <MobileChromeAndroidLocationGuideContent/>
                break;
            case GuideType.MobileEdgeAndroid:
                <MobileEdgeAndroidLocationGuideContent/>
                break;
            case GuideType.AndroidApp:
                <AndroidAppLocationGuideContent/>
                break;
            case GuideType.IosApp:
                <IosAppLocationGuideContent/>
                break;
            default:
                <WebChromeLocationGuideContent/>
                break;
        }
    </FormBlock>
    <div class="safe-area-bottom safe-area-bottom-overlay"></div>
    </Body>
    <Buttons>
        @if (isMaui) {
            <Button Class="btn-modal" Click="@(() => Modal.Close())">
                Later
            </Button>
            <Button Class="btn-modal btn-primary" Click="OnPrimaryClick">
                Settings
            </Button>
        } else {
            <Button Class="btn-modal btn-primary" Click="@(() => Modal.Close())">
                OK
            </Button>
        }
    </Buttons>
</DialogFrame>

@code {
    private SystemSettingsUI SystemSettingsUI => field ??= Hub.Services.GetRequiredService<SystemSettingsUI>();
    private BrowserInfo BrowserInfo => Hub.BrowserInfo;

    [CascadingParameter] public ScreenSize ScreenSize { get; set; }
    [CascadingParameter] public Modal Modal { get; set; } = null!;

    [Parameter] public Model ModalModel { get; set; } = null!;

    private async Task OnPrimaryClick() {
        if (HostInfo.HostKind.IsMauiApp())
            await SystemSettingsUI.Open();
        Modal.Close();
    }

    public sealed record Model(GuideType? TestGuideType = null);
}
