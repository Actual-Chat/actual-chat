@namespace ActualChat.UI.Blazor.App.Components
@inherits ComputedStateComponent<AppUIHub, RecordingSubHeader.Model?>
@{
    var rows = State.Value?.Rows ?? [];
}

@* The first slot stays mounted so the common single-row banner keeps its exit animation *@
@for (var i = 0; i < Math.Max(1, rows.Count); i++) {
    var row = i < rows.Count ? rows[i] : null;
    var cls = "recording-sub-header";
    if (row?.Chat != null)
        cls += " recording-elsewhere";
    <SubHeader @key="i" Class="@cls" IsVisible="@(row is not null)">
        <div class="c-round-container">
            @if (row is { Chat: not null, IsCamera: true }) {
                <i class="c-live-icon icon-video"></i>
            } else if (row is { Chat: not null, IsScreenCast: true }) {
                <i class="c-live-icon icon-screen-share"></i>
            } else if (row?.Chat != null) {
                <div class="c-round"></div>
            } else {
                <i class="icon-alert-triangle text-banner-warning"></i>
            }
        </div>

        <div class="c-container">
            @* One flowing sentence; with a countdown the whole tail switches, so the name reads as part
               of "<chat> ... stops in <n>s". A flex row (css), so whitespace between these items is dropped.
               @key on the countdown flag re-mounts the line once per switch, replaying its opacity fade -
               the per-second ticks keep the same key, so they never re-trigger it *@
            <div class="c-line-1 composed-sentence" @key="@(row?.StopRecordingAt is not null)">
                @if (row is { StopRecordingAt: not null, Chat: not null }) {
                    <span class="c-text c-part">@L.Recording_InChat_CountdownPrefix</span>
                    <a class="c-text c-value highlight" href="@Links.Chat(row.Chat.Id)">@row.Chat.Title</a>
                    <span class="c-text c-part">@L.Recording_InChat_CountdownMid</span>
                    <Countdown EndsAt="@row.StopRecordingAt.Value" Clock="@Clocks.CpuClock"
                        Format="Seconds" Class="c-text highlight c-countdown"/>
                    <span class="c-text c-part">@L.Recording_SecondsUnit</span>
                    <span class="c-text c-part">@L.Recording_InChat_CountdownTail</span>
                } else if (row?.Chat != null) {
                    <span class="c-text c-part">@L.Recording_InChat_Prefix</span>
                    <a class="c-text c-value highlight" href="@Links.Chat(row.Chat.Id)">@row.Chat.Title</a>
                    <span class="c-text c-part">@L.Recording_InChat_Suffix</span>
                } else if (row?.StopRecordingAt != null) {
                    <span class="c-text c-part">@L.Recording_WillStopIn</span>
                    <Countdown EndsAt="@row.StopRecordingAt.Value" Clock="@Clocks.CpuClock"
                        Format="Seconds" Class="c-text highlight c-countdown"/>
                    <span class="c-text c-part">@L.Recording_SecondsUnit</span>
                }
                @* The leading icon shows the camera, so a parallel screencast needs its own mark *@
                @if (row is { Chat: not null, IsCamera: true, IsScreenCast: true }) {
                    <span class="c-video-kinds"><i class="icon-screen-share"></i></span>
                }
            </div>
        </div>

        <Button
            Class="btn-transparent unhovered recording-in-chat on"
            Click="@(_ => OnStop(row))"
            Tooltip="@L.Recording_StopRecording"
            TooltipPosition="FloatingPosition.Top">
            @L.Common_Stop
        </Button>
    </SubHeader>
}

@code {
    private IChats Chats => Hub.Chats;
    private ChatUI ChatUI => Hub.ChatUI;
    private ChatAudioUI ChatAudioUI => Hub.ChatAudioUI;
    private ChatVideoUI ChatVideoUI => Hub.ChatVideoUI;

    protected override ComputedState<Model?>.Options GetStateOptions()
        => ComputedStateComponent.GetStateOptions(GetType(),
            static t => new ComputedState<Model?>.Options() {
                UpdateDelayer = FixedDelayer.NextTick,
                Category = GetStateCategory(t),
            });

    protected override async Task<Model?> ComputeState(CancellationToken cancellationToken) {
        var audioChatId = await ChatAudioUI.GetRecordingChatId();
        var cameraChatId = await ChatVideoUI.GetCameraChatId(cancellationToken).ConfigureAwait(false);
        var screenCastChatId = await ChatVideoUI.GetScreenCastChatId(cancellationToken).ConfigureAwait(false);
        var stopRecordingAt = await ChatAudioUI.StopRecordingAt.Use(cancellationToken).ConfigureAwait(false);
        var selectedChatId = await ChatUI.SelectedChatId.Use(cancellationToken).ConfigureAwait(false);

        var rows = new List<Row>(2);
        var isAudioRowAdded = false;
        foreach (var chatId in new[] { audioChatId, cameraChatId, screenCastChatId }.SkipNullItems().Distinct()) {
            if (chatId == selectedChatId)
                continue;

            var chat = await Chats.Get(Session, chatId, cancellationToken).ConfigureAwait(false);
            if (chat is null)
                continue;

            var isAudio = chatId == audioChatId;
            isAudioRowAdded |= isAudio;
            rows.Add(new Row(chat, isAudio, chatId == cameraChatId, chatId == screenCastChatId) {
                StopRecordingAt = isAudio ? stopRecordingAt : null,
            });
        }
        // Recording in the selected chat is about to idle out
        if (stopRecordingAt != null && !isAudioRowAdded)
            rows.Insert(0, new Row(null, true, false, false) { StopRecordingAt = stopRecordingAt });

        return rows.Count == 0 ? null : new Model(rows);
    }

    private void OnStop(Row? row) {
        if (row is null)
            return;

        if (row.IsAudio)
            _ = ChatAudioUI.SetRecordingChatId(default);
        if (row.IsCamera)
            ChatVideoUI.StopRecording();
        if (row.IsScreenCast)
            ChatVideoUI.StopScreenCasting();
    }

    // Nested types

    public sealed record Model(IReadOnlyList<Row> Rows)
    {
        // This record relies on referential equality
        public bool Equals(Model? other) => ReferenceEquals(this, other);
        public override int GetHashCode() => RuntimeHelpers.GetHashCode(this);
    }

    // Chat is null for the idle countdown of the recording in the selected chat
    public sealed record Row(Chat? Chat, bool IsAudio, bool IsCamera, bool IsScreenCast)
    {
        public Moment? StopRecordingAt { get; init; }
    }
}
