@namespace ActualChat.UI.Blazor.App.Components
@using ActualChat.Chat
@using ActualChat.UI.Blazor.App.Module
@inherits ComputedStateComponent<AppUIHub, MentionSearchResult[]>
@{
    var mentions = State.Value;
    var listCls = "";
    if (mentions.Length == 0)
        listCls += " non-visible";
    var selection = Selection;
    var kindFilter = Manager.KindFilter.Value;
}

<div @ref="Ref" class="@Class @listCls mention-list custom-scrollbar">
    <div class="mention-list-chips" data-editor-focus="true">
        @foreach (var chip in Chips) {
            var isActive = kindFilter == chip.Filter;
            var chipCls = isActive ? "mention-list-chip active" : "mention-list-chip";
            <button type="button"
                    class="@chipCls"
                    data-editor-focus="true"
                    title="@chip.Tooltip"
                    @onclick="@(_ => OnChipClick(chip.Filter))">
                @chip.Label
            </button>
        }
    </div>
    @foreach (var mention in mentions) {
        var cls = mention == selection ? "selected" : "";
        var description = GetDescription(mention);
        <div class="@cls mention-list-item"
             data-editor-focus="true"
             @onmouseover="@(_ => Selection = mention)"
             @onclick="@(_ => Manager.SelectMention(mention))">
            <div class="c-content">
                @if (mention.MentionId.PrincipalId is AuthorId authorId) {
                    <AuthorCircle
                        @key="@authorId"
                        AuthorId="@authorId"
                        Size="SquareSize.Size7"/>
                } else if (mention.MentionId.Target is EmojiRef emojiRef) {
                    var emoji = Emojis.ById.GetValueOrDefault(emojiRef.Text);
                    <span class="mention-list-emoji">
                        @if (emoji is not null) {
                            <EmojiIcon Emoji="@emoji" Class="mention-list-emoji-icon" HasPreview="false" InlineAnimate="true"/>
                        }
                    </span>
                } else {
                    var iconUrl = UrlMapper.IconUrl(GetIconQuery(mention));
                    <image-skeleton class="flex-none w-7 h-7 rounded-full" src="@iconUrl"/>
                }
                <div class="c-center">
                    <SearchMatchHighlighter Match="@mention.SearchMatch"/>
                    @if (mention.PlaceTitleSuffix is { Length: > 0 } suffix) {
                        <span class="c-place-suffix">&nbsp;| @suffix</span>
                    }
                </div>
                @if (description is not null) {
                    <div class="c-description">— @description</div>
                }
            </div>
        </div>
    }
</div>

@code {
    private static readonly string JSCreateMethod = $"{BlazorUIAppModule.ImportName}.MentionList.create";
    private static readonly (MentionKindFilter Filter, string Label, string Tooltip)[] Chips = [
        (MentionKindFilter.All, "All", "All categories"),
        (MentionKindFilter.User, "U", "Users only"),
        (MentionKindFilter.Chat, "C", "Chats only"),
        (MentionKindFilter.Emoji, "E", "Emoji only"),
    ];

    private string? _lastFilter;
    private MentionSearchResult? _selection;
    private IJSObjectReference JSRef { get; set; } = null!;
    private ElementReference Ref { get; set; }

    [CascadingParameter] public MentionListManager Manager { get; set; } = null!;
    [Parameter] public string Class { get; set; } = "";

    public MutableState<string?> Filter { get; private set; } = null!;
    public MentionSearchResult? Selection {
        get => _selection;
        set {
            if (_selection == value)
                return;
            _selection = FixSelection(value, State.Value);
            StateHasChanged();
            _ = JSRef.InvokeVoidAsync("scrollSelectedIntoView");
        }
    }

    protected override void OnInitialized()
        => Filter = StateFactory.NewMutable(
            (string?)null,
            StateCategories.Get(GetType(), nameof(Filter)));

    public override async ValueTask DisposeAsync() {
        await JSRef.DisposeSilentlyAsync("dispose");
        JSRef = null!;
        await base.DisposeAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (firstRender) {
            JSRef = await JS.InvokeAsync<IJSObjectReference>(JSCreateMethod, Ref);
        }
    }

    protected override ComputedState<MentionSearchResult[]>.Options GetStateOptions()
        => ComputedStateComponent.GetStateOptions(GetType(),
            static t => new ComputedState<MentionSearchResult[]>.Options() {
                InitialValue = [],
                UpdateDelayer = FixedDelayer.NextTick,
                Category = GetStateCategory(t),
            });

    protected override async Task<MentionSearchResult[]> ComputeState(CancellationToken cancellationToken) {
        var managerLimit = Manager.Limit;
        var lastFilter = _lastFilter;
        var selection = _selection;

        var filter = await Filter.Use(cancellationToken).ConfigureAwait(false);
        // Subscribe to the chip state so the list re-runs when the user picks a category.
        _ = await Manager.KindFilter.Use(cancellationToken).ConfigureAwait(false);
        var mentions = filter != null
            ? await Manager.Find(filter, managerLimit, cancellationToken).ConfigureAwait(false)
            : [];

        var fixedSelection = FixSelection(filter == lastFilter ? selection : null, mentions);
        await InvokeAsync(() => {
            _selection = fixedSelection;
            _lastFilter = filter;
        }).ConfigureAwait(false);

        return mentions;
    }

    public void MoveSelection(int offset) {
        var mentions = State.Value;
        var selection = FixSelection(_selection, mentions);
        var selectionIndex = Array.IndexOf(mentions, selection) + offset;
        if (selectionIndex < 0 || selectionIndex >= mentions.Length)
            return;
        _selection = mentions[selectionIndex];
        StateHasChanged();
        _ = JSRef.InvokeVoidAsync("scrollSelectedIntoView");
    }

    // Private methods

    private void OnChipClick(MentionKindFilter filter)
        => Manager.KindFilter.Value = Manager.KindFilter.Value == filter
            ? MentionKindFilter.All
            : filter;

    private static string? GetDescription(MentionSearchResult mention) {
        var target = mention.MentionId.Target;
        return target switch {
            EmojiRef => "emoji",
            PlaceId => "place",
            ChatId => mention.IsInHostPlace ? "this place's chat" : "chat",
            UserId or AuthorId => mention.IsChatMember ? null : "not in this chat",
            _ => null,
        };
    }

    private static IconQuery GetIconQuery(MentionSearchResult mention) {
        var picture = mention.Picture;
        var target = mention.MentionId.Target;
        // Marble for chats/places (matches the chat-list rendering),
        // Beam for users/everyone else.
        var avatarKind = target is ChatId or PlaceId
            ? AvatarKind.Marble
            : AvatarKind.Beam;
        var avatarKey = picture.AvatarKey.NullIfEmpty() ?? mention.MentionId.Value;
        return new IconQuery(picture, new AvatarQuery {
            Kind = avatarKind,
            Key = avatarKey,
            Format = AvatarFormat.Png,
            Size = 128,
        });
    }

    private MentionSearchResult? FixSelection(MentionSearchResult? selection, MentionSearchResult[] mentions) {
        if (mentions.Length == 0)
            return null;

        var firstMention = mentions[0];
        selection ??= firstMention;
        return mentions.FirstOrDefault(o => o.MentionId == selection.MentionId) ?? firstMention;
    }
}
