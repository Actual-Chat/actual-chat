@namespace ActualChat.UI.Blazor.App.Components
@using ActualChat.UI.Blazor.App.Module
@inherits ComputedStateComponent<AppUIHub, FoundMention[]>
@{
    var mentions = State.Value;
    var isPickerActive = _isOpen;
    var hasNoMatch = !_loading && isPickerActive && mentions.Length == 0;
    var listCls = isPickerActive ? "" : " non-visible";
    var selection = Selection;
    var categoryFilter = Manager.Filter.Value;
    // Drives the explicit list height (CSS transitions it): skeletons while loading,
    // a single row for the "No matches" placeholder, else the result count.
    var rowCount = _loading ? DefaultSkeletonCount : hasNoMatch ? 1 : mentions.Length;
}

<div class="mention-list-wrapper @listCls">
    <div class="mention-list-chips" data-editor-focus="true">
        @foreach (var chip in Chips) {
            var isActive = categoryFilter == chip.Filter;
            var chipCls = isActive ? "mention-list-chip active" : "mention-list-chip";
            chipCls += " btn-xs btn-transparent";
            <ButtonRound
                Class="@chipCls"
                Tooltip="@ChipTooltip(chip.Filter)"
                data-editor-focus="true"
                PointerDownPreventDefault="true"
                Click="@(_ => OnChipClick(chip.Filter))">
                <i class="@chip.Icon text-xl"></i>
            </ButtonRound>
        }
        <div class="mention-list-chip-divider"></div>
        <ButtonRound
            Class="mention-list-close-btn btn-xs btn-transparent"
            Tooltip="@L.Common_Close"
            data-editor-focus="true"
            PointerDownPreventDefault="true"
            Click="@(_ => Manager.Dismiss())">
            <i class="icon-close text-2xl"></i>
        </ButtonRound>
    </div>
    <div @ref="Ref" class="@Class mention-list custom-scrollbar" style="--row-count: @rowCount">
        @if (_loading) {
            for (var i = 0; i < DefaultSkeletonCount; i++) {
                <div class="mention-list-item mention-list-skeleton" data-editor-focus="true" aria-hidden="true">
                    <div class="c-content">
                        <div class="c-avatar animated-skeleton"></div>
                        <div class="c-center">
                            <div class="c-line animated-skeleton"
                                 style="width: @(SkeletonWidths[i % SkeletonWidths.Length])%"></div>
                        </div>
                    </div>
                </div>
            }
        }
        @if (hasNoMatch) {
            <div class="mention-list-item mention-list-no-match" data-editor-focus="true">@L.MentionList_NoMatches</div>
        }
        @if (!_loading) {
            foreach (var mention in mentions) {
                var cls = mention == selection ? "selected" : "";
                var targetId = mention.MentionRef.Target;
                var isQuoted = targetId is ChatId or PlaceId;
                <div @key="@mention.MentionRef.Value"
                     class="@cls mention-list-item"
                     data-editor-focus="true"
                     data-mention-ref="@mention.MentionRef.Value"
                     @onclick="@(_ => Manager.SelectMention(mention))">
                    <div class="c-content">
                        @if (targetId is AuthorId authorId) {
                            <AuthorCircle
                                @key="@authorId"
                                AuthorId="@authorId"
                                Size="SquareSize.Size7"/>
                        } else if (targetId is EmojiRef emojiRef) {
                            var emoji = Emojis.ById.GetValueOrDefault(emojiRef.Text);
                            <span class="mention-list-emoji">
                                @if (emoji is not null) {
                                    <EmojiIcon
                                        Emoji="@emoji"
                                        Class="mention-list-emoji-icon"
                                        HasPreview="false"
                                        InlineAnimate="true"/>
                                }
                            </span>
                        } else {
                            var avatarKey = mention.Picture.AvatarKey.NullIfEmpty() ?? mention.MentionRef.Value;
                            var avatarKind = targetId is ChatId or PlaceId ? AvatarKind.Marble : AvatarKind.Beam;
                            <Pic
                                Title="@mention.Match.Text"
                                Picture="@mention.Picture"
                                Size="SquareSize.Size7"
                                AvatarKind="@avatarKind"
                                AvatarKey="@avatarKey"/>
                        }
                        <div class="c-center">
                            @if (isQuoted) {
                                <span class="c-quote">"</span>
                            }
                            <SearchMatchHighlighter Match="@mention.Match"/>
                            @if (isQuoted) {
                                <span class="c-quote">"</span>
                            }
                            @if (mention.Description is { Length: > 0 } description) {
                                <span class="c-description">&nbsp;@description</span>
                            }
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

@code {
    private static readonly string JSCreateMethod = $"{BlazorUIAppModule.ImportName}.MentionList.create";
    private static readonly (Func<MentionCandidate, bool> Filter, string Icon)[] Chips = [
        (MentionCandidateFilters.All, "icon-star-2"),
        (MentionCandidateFilters.User, "icon-person"),
        (MentionCandidateFilters.Chat, "icon-message-ellipse"),
        (MentionCandidateFilters.Emoji, "icon-emoji-2"),
    ];

    private string ChipTooltip(Func<MentionCandidate, bool> filter)
        // The filters are static readonly fields, so reference equality is what the chip
        // loop already matches the active filter with.
        => filter == MentionCandidateFilters.User ? L.MentionList_FilterUsers
            : filter == MentionCandidateFilters.Chat ? L.MentionList_FilterChats
            : filter == MentionCandidateFilters.Emoji ? L.MentionList_FilterEmoji
            : L.MentionList_FilterAll;

    private const int DefaultSkeletonCount = 8;
    private static readonly int[] SkeletonWidths = [72, 54, 63, 45, 68, 50, 60, 57];

    private string? _lastFilter;
    private FoundMention? _selection;
    private bool _loading;
    private bool _isOpen;
    private readonly GatedUpdateDelayer _updateDelayer = new(FixedDelayer.NextTick);
    private DotNetObjectReference<MentionList>? _blazorRef;
    private IJSObjectReference JSRef { get; set; } = null!;
    private ElementReference Ref { get; set; }

    [CascadingParameter] public MentionListManager Manager { get; set; } = null!;
    [Parameter] public string Class { get; set; } = "";

    public MutableState<string?> Filter { get; private set; } = null!;
    public FoundMention? Selection => _selection;

    protected override void OnInitialized() {
        // Render the loading skeletons even while the computed state is being (re)computed -
        // otherwise ShouldRender() drops the skeleton frame and only the final result shows.
        Options |= ComputedStateComponentOptions.RenderInconsistentState;
        Filter = StateFactory.NewMutable(
            (string?)null,
            StateCategories.Get(GetType(), nameof(Filter)));
        Manager.SetList(this);
    }

    public override async ValueTask DisposeAsync() {
        await JSRef.DisposeSilentlyAsync("dispose");
        JSRef = null!;
        _blazorRef?.Dispose();
        _blazorRef = null;
        await base.DisposeAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (firstRender) {
            _blazorRef = DotNetObjectReference.Create(this);
            JSRef = await JS.InvokeAsync<IJSObjectReference>(JSCreateMethod, Ref, _blazorRef);
        }
    }

    protected override ComputedState<FoundMention[]>.Options GetStateOptions()
        // Per-instance options: the gated delayer pauses recomputation while the list is hidden.
        => new() {
            InitialValue = [],
            UpdateDelayer = _updateDelayer,
            Category = GetStateCategory(GetType()),
        };

    protected override async Task<FoundMention[]> ComputeState(CancellationToken cancellationToken) {
        var managerLimit = Manager.Limit;
        var lastFilter = _lastFilter;
        var selection = _selection;

        var filter = await Filter.Use(cancellationToken).ConfigureAwait(false);
        // Subscribe to the chip state so the list re-runs when the user picks a category.
        _ = await Manager.Filter.Use(cancellationToken).ConfigureAwait(false);
        var mentions = filter != null
            ? await Manager.Find(filter, managerLimit, cancellationToken).ConfigureAwait(false)
            : [];

        var fixedSelection = FixSelection(filter == lastFilter ? selection : null, mentions);
        await InvokeAsync(() => {
            _selection = fixedSelection;
            _lastFilter = filter;
            _loading = false;
        }).ConfigureAwait(false);

        return mentions;
    }

    public void Open(bool isFirstOpen) {
        // Skeletons show only until the first-ever compute in this chat; reopens render the
        // still-mounted rows instantly, and the opened gate lets a stale value refresh in place.
        _isOpen = true;
        _updateDelayer.Open();
        if (isFirstOpen)
            _loading = true;
        StateHasChanged();
    }

    public void Close() {
        // Keeps the default view mounted and its Computed<T> referenced, but pauses updates:
        // invalidations while hidden don't recompute anything until the next Open().
        _isOpen = false;
        _updateDelayer.Close();
        if (Filter.Value != null)
            Filter.Value = "";
        StateHasChanged();
    }

    public void MoveSelection(int offset) {
        var mentions = State.Value;
        var selection = FixSelection(_selection, mentions);
        var selectionIndex = Array.IndexOf(mentions, selection) + offset;
        if (selectionIndex < 0 || selectionIndex >= mentions.Length)
            return;

        SetSelection(mentions[selectionIndex]);
    }

    [JSInvokable]
    public void OnHoverSelect(string mentionRef) {
        var mention = State.Value.FirstOrDefault(o => o.MentionRef.Value == mentionRef);
        if (mention == null || mention == _selection)
            return;

        SetSelection(mention);
    }

    // Private methods

    private void SetSelection(FoundMention mention) {
        // Scrolling is safe here: HoverSelect ignores pointer events with unchanged coordinates.
        _selection = mention;
        StateHasChanged();
        _ = JSRef.InvokeVoidAsync("scrollSelectedIntoView");
    }

    private void OnChipClick(Func<MentionCandidate, bool> filter)
        => Manager.Filter.Value = Manager.Filter.Value == filter
            ? MentionCandidateFilters.All
            : filter;

    private FoundMention? FixSelection(FoundMention? selection, FoundMention[] mentions) {
        if (mentions.Length == 0)
            return null;

        var firstMention = mentions[0];
        selection ??= firstMention;
        return mentions.FirstOrDefault(o => o.MentionRef == selection.MentionRef) ?? firstMention;
    }
}
