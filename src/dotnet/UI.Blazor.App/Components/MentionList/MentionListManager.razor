@namespace ActualChat.UI.Blazor.App.Components

<CascadingValue TValue="MentionListManager" Value="@this" IsFixed="true">
    @ChildContent
</CascadingValue>

@code {
    private bool _isShown;
    private bool _hasOpened;

    [Inject] protected StateFactory StateFactory { get; init; } = null!;
    [Inject] protected LocalSearchUI LocalSearchUI { get; init; } = null!;

    [CascadingParameter] public ChatContext? ChatContext { get; set; }
    [Parameter] public int Limit { get; set; } = 100;
    [Parameter] public RenderFragment? ChildContent { get; set; }

    public MentionList? ListRef { get; private set; }
    public MutableState<Func<MentionCandidate, bool>> Filter { get; private set; } = null!;
    public event Action<FoundMention>? MentionSelected;
    public event Action? Dismissed;

    protected override void OnInitialized()
        => Filter = StateFactory.NewMutable(
            MentionCandidateFilters.All,
            StateCategories.Get(GetType(), nameof(Filter)));

    // MentionList renders inside the consumer's markup (e.g. the post-panel top container)
    // and registers itself here so the manager keeps driving Show/Hide/keyboard nav.
    internal void SetList(MentionList list)
        => ListRef = list;

    public Task<FoundMention[]> Find(string query, int limit, CancellationToken cancellationToken)
        => LocalSearchUI.FindMentions(ChatContext?.Chat.Id, Filter.Value, query, limit, cancellationToken);

    public void SelectMention(FoundMention mention)
        => MentionSelected?.Invoke(mention);

    public void Show(string filter) {
        if (ListRef == null)
            return;

        if (!_isShown)
            Filter.Value = MentionCandidateFilters.All;
        _isShown = true;
        // The filter is set before Open() so the very first visible frame renders with it.
        ListRef.Filter.Value = filter;
        ListRef.Open(isFirstOpen: !_hasOpened);
        _hasOpened = true;
    }

    public void Hide() {
        if (ListRef == null)
            return;

        ListRef.Close();
        _isShown = false;
    }

    public void Dismiss() {
        // Unlike Hide(), this one tells the editor to keep the picker closed for the current "@".
        Hide();
        Dismissed?.Invoke();
    }
}
