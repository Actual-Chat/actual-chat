@namespace ActualChat.UI.Blazor.App.Components
@using ActualChat.UI.Blazor.App.Module
@inherits ComputedStateComponent<AppUIHub, CollapsedCallView.ComputedModel>
@{
    var m = State.Value;
    if (m.ChatId is null)
        return;
}

<div class="collapsed-call-view" @ref="Ref">
    <div class="c-av" @onclick="@OnExpandClick">
        <AuthorCircle AuthorId="@m.PeerId" Size="SquareSize.Size10"/>
    </div>
    <div class="c-name" @onclick="@OnExpandClick">
        <AuthorName AuthorId="@m.PeerId" Class="c-peer-name" ShowDetailsOnClick="false"/>
    </div>
    @if (m.IsIncoming) {
        <ButtonRound Class="c-decline" Click="@OnDeclineClick">
            <i class="icon-close text-2xl"></i>
        </ButtonRound>
        <ButtonRound Class="c-accept" Click="@OnAcceptClick">
            <i class="icon-phone-take text-2xl"></i>
        </ButtonRound>
    } else {
        <ButtonRound Class="c-hang-up" Click="@OnHangUpClick">
            <i class="icon-phone-off text-2xl"></i>
        </ButtonRound>
    }
</div>

@code {
    private static readonly string JSCreateMethod = $"{BlazorUIAppModule.ImportName}.DraggableCallIsland.create";

    private ElementReference Ref { get; set; }
    private IJSObjectReference? _jsRef;

    private CallScreensUI CallScreensUI => Hub.CallScreensUI;

    protected override ComputedState<ComputedModel>.Options GetStateOptions()
        => ComputedStateComponent.GetStateOptions(GetType(),
            static t => new ComputedState<ComputedModel>.Options() {
                InitialValue = ComputedModel.None,
                UpdateDelayer = FixedDelayer.NextTick,
                Category = GetStateCategory(t),
            });

    protected override async Task<ComputedModel> ComputeState(CancellationToken cancellationToken) {
        var view = await CallScreensUI.GetCallView(cancellationToken).ConfigureAwait(false);
        if (view is not { Kind: CallViewKind.Collapsed, Call: { } call })
            return ComputedModel.None;

        if (await CallScreensUI.GetCallPeerId(cancellationToken).ConfigureAwait(false) is not { } peerId)
            return ComputedModel.None;

        var isIncoming = call.Origin == CallOrigin.Incoming;
        return new ComputedModel { ChatId = call.ChatId, PeerId = peerId, IsIncoming = isIncoming };
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        // Attach / detach the drag controller as the island appears and disappears.
        var isShowing = State.Value.ChatId is not null;
        if (isShowing && _jsRef is null)
            _jsRef = await Hub.JS.InvokeAsync<IJSObjectReference>(JSCreateMethod, Ref).ConfigureAwait(true);
        else if (!isShowing && _jsRef is not null) {
            await _jsRef.DisposeAsync().ConfigureAwait(true);
            _jsRef = null;
        }
    }

    public override async ValueTask DisposeAsync() {
        if (_jsRef is not null) {
            await _jsRef.DisposeAsync().ConfigureAwait(true);
            _jsRef = null;
        }
        await base.DisposeAsync().ConfigureAwait(true);
    }

    private void OnExpandClick() {
        if (State.Value.ChatId is { } chatId)
            CallScreensUI.Expand(chatId);
    }

    private Task OnAcceptClick()
        => State.Value.ChatId is { } chatId ? CallScreensUI.Accept(chatId) : Task.CompletedTask;

    private Task OnDeclineClick()
        => State.Value.ChatId is { } chatId ? CallScreensUI.Decline(chatId) : Task.CompletedTask;

    private Task OnHangUpClick()
        => State.Value.ChatId is { } chatId ? CallScreensUI.HangUp(chatId) : Task.CompletedTask;

    // Nested types

    public sealed record ComputedModel {
        public static readonly ComputedModel None = new();
        public ChatId? ChatId { get; init; }
        // The caller of a ring, or whoever I'm calling.
        public AuthorId PeerId { get; init; }
        public bool IsIncoming { get; init; }
    }
}
