@namespace ActualChat.UI.Blazor.App.Components
@inherits ComputedStateComponent<AppUIHub, List<Chat>>
@{
    DebugLog?.LogDebug("Rendered: {List}", ChatListKind.Active);
    if (State.IsInitial(out var chats) || chats.Count == 0)
        return;
}

<div class="c-delimiter"></div>
<div class="active-chats" data-child="active-chats">
    <div class="c-title" data-tooltip="@L.ChatList_ActiveChatsTooltip">@L.ChatList_ActiveChats</div>

    <div class="chat-list chat-list-active">
        @foreach(var chat in chats) {
            <ChatListItem @key="@chat.Id" ListKind="@ChatListKind.Active" Chat="@chat"/>
        }
    </div>
</div>

@code {
    private IChats Chats => Hub.Chats;
    private ActiveChatsUI ActiveChatsUI => Hub.ActiveChatsUI;
    private ChatAudioUI ChatAudioUI => Hub.ChatAudioUI;
    private ILogger Log => field ??= Hub.LogFor(GetType());
    private ILogger? DebugLog => Constants.DebugMode.ChatListRelated ? Log : null;

    protected override void OnInitialized()
        => DebugLog?.LogDebug("OnInitialized: {List}", ChatListKind.Active);

    protected override void OnParametersSet()
        => DebugLog?.LogDebug("OnParametersSet: {List}", ChatListKind.Active);

    protected override async Task<List<Chat>> ComputeState(CancellationToken cancellationToken) {
        DebugLog?.LogDebug("-> ComputeState: {List}", ChatListKind.Active);
        var activeChats = await ActiveChatsUI.ActiveChats.Use(cancellationToken).ConfigureAwait(false);
        // A PTT chat always listens in the background, so it's listed only while someone talks in it or
        // the user listens or records in it - muted or not (a mute stops auto-playing, not voice activity).
        var pttChatIds = await ChatAudioUI.GetPttChatIds(cancellationToken).ConfigureAwait(false);
        var mutedPttChatIds = await ChatAudioUI.GetMutedPttChatIds(cancellationToken).ConfigureAwait(false);
        var pttSet = pttChatIds.Concat(mutedPttChatIds).ToHashSet();
        var liveStreamUI = Hub.LiveStreamUI;
        var chatIds = new List<ChatId>();
        foreach (var activeChat in activeChats) {
            var chatId = activeChat.ChatId;
            if (!pttSet.Contains(chatId) || activeChat.IsRecording || activeChat.IsListeningExplicitly)
                chatIds.Add(chatId);
        }
        // A muted chat may have no active-chat entry at all, so every PTT chat is checked for talk
        foreach (var chatId in pttSet) {
            if (chatIds.Contains(chatId))
                continue;

            var isTalking = await liveStreamUI
                .IsAnyoneStreamingAudio(chatId, cancellationToken)
                .ConfigureAwait(false);
            if (isTalking)
                chatIds.Add(chatId);
        }
        var chats = (await chatIds
                .Select(chatId => Chats.Get(Session, chatId, cancellationToken))
                .Collect(cancellationToken)
                .ConfigureAwait(false))
            .SkipNullItems()
            .ToList();
        DebugLog?.LogDebug("<- ComputeState: {List}", ChatListKind.Active);
        return chats;
    }
}
