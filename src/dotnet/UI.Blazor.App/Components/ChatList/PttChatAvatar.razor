@namespace ActualChat.UI.Blazor.App.Components
@inherits ComputedStateComponent<AppUIHub, PttChatAvatar.Model>
@{
    var (isPlaying, isRecording) = State.Value;
    var cls = isRecording ? "ptt-chat-avatar recording" : isPlaying ? "ptt-chat-avatar playing" : "ptt-chat-avatar";
}

<div class="@cls" style="z-index: @ZIndex">
    <ChatIcon Chat="@Chat" Size="SquareSize.Size8"/>
</div>

@code {
    private LiveStreamUI LiveStreamUI => Hub.LiveStreamUI;
    private ChatAudioUI ChatAudioUI => Hub.ChatAudioUI;

    [Parameter, EditorRequired] public Chat Chat { get; set; } = null!;
    // Ascending per item: a later avatar paints entirely over its left neighbour, ring included,
    // instead of the neighbour's inner image leaking over it.
    [Parameter] public int ZIndex { get; set; }

    protected override ComputedState<Model>.Options GetStateOptions()
        => ComputedStateComponent.GetStateOptions(GetType(),
            static t => new ComputedState<Model>.Options() {
                InitialValue = default,
                UpdateDelayer = FixedDelayer.NextTick,
                Category = GetStateCategory(t),
            });

    protected override async Task<Model> ComputeState(CancellationToken cancellationToken) {
        var chatId = Chat.Id;
        var liveStreamUI = LiveStreamUI;
        var chatAudioUI = ChatAudioUI;
        var isPlaying = await liveStreamUI.IsAnyoneStreamingAudio(chatId, cancellationToken).ConfigureAwait(false);
        var recordingChatId = await chatAudioUI.GetRecordingChatId().ConfigureAwait(false);
        return new Model(isPlaying, recordingChatId == chatId);
    }

    public readonly record struct Model(bool IsPlaying, bool IsRecording);
}
