@namespace ActualChat.UI.Blazor.App.Components
@inherits ComputedRenderStateComponent<AppUIHub, ChatListItem.Model>
@{
    var m = State.Value;
    var listKind = m.ListKind ?? ListKind;
    var chat = m.Chat ?? Chat;
    DebugLog?.LogDebug("Rendered: {ListKind} #{ChatTitle}, ChatId='{ChatId}'", listKind, chat.Title, chat.Id);
    var isHoverable = BrowserInfo.IsHoverable.Value;
    var isActiveChatList = listKind == ChatListKind.Active;
    var audioState = m.AudioState;
    var isListeningOrRecording = audioState is not null && (audioState.IsListening || audioState.IsRecording);
    var hasButtons = isActiveChatList || isListeningOrRecording;
    var lastTextEntry = m.LastTextEntry;
    var attributes = listKind == ChatListKind.All && m.IsFirstItem
        ? FirstItemAttributes
        : NoneAttributes;
    _renderedModel = m;
    var showEnding = isListeningOrRecording || isActiveChatList;
    var navbarItemCls = showEnding ? "visible-ending" : "";
}

<NavbarItem
    Url="@($"/chat/{chat.Id}")"
    ReplaceOnPrefix="/chat/"
    IsSelected="@(m.IsSelected && listKind != ChatListKind.Active)"
    Class="@navbarItemCls"
    data-menu="@(MenuRef.New<ChatMenu>(chat.Id.Value, listKind.Format()).ToString())"
    data-menu-placement="@(FloatingPosition.BottomStart.ToPositionString())"
    @attributes="@attributes">
    <ChildContent>
        <div class="c-container">
            <ChatIcon Chat="@chat" ShowPresence="@true"/>
            <div class="c-description">
                <span class="c-chat-title">
                    <span>@chat.Title</span>
                    <span class="c-incut"></span>
                    @if (lastTextEntry != null && !showEnding) {
                        @Hub.MarkupHelpers.LastEntryTime(m.LastBeginsAt)
                    }
                </span>
                @if (lastTextEntry != null) {
                    <div class="c-last-message">
                        @if (chat.Kind != ChatKind.Peer && !lastTextEntry.IsSystemEntry) {
                            <span class="hidden last-entry-id">@m.LastTextEntry?.Id.Value</span>
                            <span class="c-name">
                                <AuthorName
                                    AuthorId="@m.LastAuthorId"
                                    ShowDetailsOnClick="false"
                                    ShowAsOwn="true"/>
                            </span>
                            <span class="c-colon">:</span>
                        }
                        @if (m.CallActivity.HasLiveConversation) {
                            var activity = m.CallActivity;
                            <span class="c-live-talking">
                                <chat-activity-svg size="4" isActive="true"/>
                                @(activity.IsLiveSession ? $"{activity.ParticipantCount} · live" : "talking")
                            </span>
                        }
                        else if (lastTextEntry.IsContentStreaming) {
                            <chat-activity-svg size="4" isActive="true"/>
                        }
                        else {
                            <span class="c-text">
                                @((MarkupString)m.LastTextEntryIcons) @m.LastTextEntryText
                            </span>
                        }
                        <div class="c-incut"></div>
                        @if (!showEnding) {
                            <UnreadCount
                                Value="@m.UnreadCount"
                                NotificationMode="@m.NotificationMode"
                                HasMentions="m.HasUnreadMentions"/>
                        }
                        @if (m.IsUnreadByOthers && !showEnding) {
                            <ChatMessageSendingStatus
                                Status="@ChatMessageSendingStatus.MessageStatus.Unread"
                                IsDotOnly="@true"/>
                        }
                    </div>
                }
            </div>
        </div>
    </ChildContent>
    <Ending>
        @if (isActiveChatList) {
            // Active ChatList
            <div class="slot c-active">
                @if (audioState?.IsRecording == true) {
                    <ChatListRecordingToggle Chat="@chat" IsRecording="@audioState.IsRecording" Class="ending-btn"/>
                }
                <div class="listen-wrapper ending-btn">
                    <ChatListListenToggle AudioState="@audioState"/>
                </div>
            </div>
        } else {
            // Not active ChatList
            @if (!isHoverable) {
                // Touch capable and not hoverable
                <div class="slot c-touch">
                    @if (showEnding) {
                        <UnreadCount
                            Value="@m.UnreadCount"
                            NotificationMode="@m.NotificationMode"
                            HasMentions="@m.HasUnreadMentions"/>
                    }
                    @if (hasButtons) {
                        @if (audioState?.IsRecording == true) {
                            <ChatListRecordingToggle Chat="@chat" IsRecording="@audioState.IsRecording" Class="ending-btn"/>
                        }
                        <div class="listen-wrapper ending-btn">
                            <ChatListListenToggle AudioState="@audioState"/>
                        </div>
                    }
                </div>
            } else {
                // Hoverable
                <div class="slot c-hoverable">
                    <UnreadCount
                        Value="@m.UnreadCount"
                        NotificationMode="@m.NotificationMode"
                        HasMentions="@m.HasUnreadMentions"/>
                    @if (audioState?.IsRecording == true) {
                        <ChatListRecordingToggle Chat="@chat" IsRecording="@audioState.IsRecording" Class="ending-btn"/>
                    }
                    <div class="listen-wrapper ending-btn">
                        <ChatListListenToggle AudioState="@audioState"/>
                    </div>
                    <div
                        class="menu ending-btn"
                        data-menu="@(MenuRef.New<ChatMenu>(chat.Id.Value, listKind.Format()).ToString())"
                        data-menu-trigger="@MenuTrigger.Primary"
                        data-menu-placement="@(FloatingPosition.RightStart.ToPositionString())">
                        <HeaderButton>
                            <i class="icon-more-vertical text-2xl"></i>
                        </HeaderButton>
                    </div>
                </div>
            }
        }
    </Ending>
</NavbarItem>
@if (m.IsLastItemInBlock) {
    <Divider Class="mx-1 my-1.5"/>
}

@code {
    // Setting data-bubble attributes inside a component instead of providing them from ChatList as additional attributes
    // allows avoiding unnecessary OnParametersSet calls during ChatList rendering
    // and thus allows avoiding extra ComputeState calls and re-renders.
    private static readonly Dictionary<string, object> FirstItemAttributes = new() {
        { "data-bubble", BubbleRef.New<HasContextMenuBubble>() },
        { "data-bubble-priority", 204 },
        { "data-bubble-placement", FloatingPosition.Bottom.ToPositionString() },
    };
    private static readonly Dictionary<string, object> NoneAttributes = [];

    private Model? _renderedModel;
    private ChatEntryId? _hasBeenReadEntryId;

    private IChats Chats => Hub.Chats;
    private IAuthors Authors => Hub.Authors;
    private ChatUI ChatUI => Hub.ChatUI;
    private BrowserInfo BrowserInfo => Hub.BrowserInfo;

    private ILogger Log => field ??= Hub.LogFor(GetType());
    private ILogger? DebugLog => Constants.DebugMode.ChatListRelated ? Log : null;

    [CascadingParameter] public ScreenSize ScreenSize { get; set; }
    [Parameter, EditorRequired] public ChatListKind ListKind { get; set; } = ChatListKind.All;
    [Parameter, EditorRequired] public Chat Chat { get; set; } = null!;
    [Parameter] public bool IsLastItemInBlock { get; set; }
    [Parameter] public bool IsFirstItem { get; set; }

    // protected override void OnInitialized() {
    //     DebugLog?.LogDebug("OnInitialized: {ListKind} #{Index}", ListKind, Index);
    // }
    //
    // protected override void OnParametersSet() {
    //     DebugLog?.LogDebug("OnParametersSet: {ListKind} #{Index}", ListKind, Index);
    // }

    protected override bool ShouldRender() {
        if (_renderedModel == null)
            return true;

        var m = State.LastNonErrorValue;
        var isTheSame = m == _renderedModel;
        return !isTheSame;
    }

    protected override ComputedState<Model>.Options GetStateOptions()
        => ComputedStateComponent.GetStateOptions(GetType(),
            t => new ComputedState<Model>.Options {
                InitialValue = Model.None,
                UpdateDelayer = FixedDelayer.NextTick,
                Category = GetStateCategory(t),
            });

    protected override async Task<Model> ComputeState(CancellationToken cancellationToken)
    {
        // We intentionally use .ConfigureAwait(false) here: this is one of the most frequently called methods.
        // Properties are copied to local vars because of this.
        var listKind = ListKind;
        var chat = Chat;
        var chatTitle = chat.Title;
        var chatId = chat.Id;
        var isLastItemInBlock = IsLastItemInBlock;
        var isFirstItem = IsFirstItem;
        var ownAuthor = chat.Rules.Author;
        var ownAuthorId = ownAuthor?.Id;
        DebugLog?.LogDebug("-> ComputeState: {ListKind} #{ChatTitle}", listKind, chatTitle);
        var chatState = await ChatUI.GetState(chatId, false, cancellationToken).ConfigureAwait(false);
        if (chatState == null) {
            DebugLog?.LogDebug("<- ComputeState: {ListKind} #{ChatTitle}, No ChatState", listKind, chatTitle);
            return Model.None;
        }
        DebugLog?.LogDebug("<- ComputeState: {ListKind} #{ChatTitle}, OK, ChatId={ChatId}", listKind, chatTitle, chatId);
        var chatInfo = chatState.Info;
        var lastEntry = chatInfo.LastTextEntry;
        var isUnreadByOthers = false;
        var lastTextEntryIcons = "";
        if (lastEntry != null) {
            isUnreadByOthers = ownAuthorId is not null
                && await IsUnreadByOthers(lastEntry, ownAuthorId, cancellationToken).ConfigureAwait(false);
            lastTextEntryIcons = GetIcons(lastEntry);
        }
        var callActivity = await Hub.ChatActivityUI.GetCallActivity(chatId, cancellationToken).ConfigureAwait(false);

        return new() {
            ListKind = listKind,
            Chat = chatState.Chat,
            AudioState = chatState.AudioState,
            CallActivity = callActivity,
            NotificationMode = chatInfo.ChatUserSettings.NotificationMode,
            IsSelected = chatState.IsSelected,
            UnreadCount = chatInfo.UnreadCount,
            HasUnreadMentions = chatInfo.HasUnreadMentions,
            LastTextEntry = lastEntry,
            LastTextEntryText = chatInfo.LastTextEntryText,
            LastTextEntryIcons = lastTextEntryIcons,
            IsLastItemInBlock = isLastItemInBlock,
            IsFirstItem = isFirstItem,
            IsUnreadByOthers = isUnreadByOthers,
            LastThread = chatInfo.LastThread,
            LastThreadCreator = chatInfo.LastThreadCreator,
        };
    }

    private async Task<bool> IsUnreadByOthers(
        ChatEntry entry, AuthorId ownAuthorId, CancellationToken cancellationToken) {
        var chat = Chat;
        if (_hasBeenReadEntryId == entry.Id)
            return false;

        var isOwnMessage = ownAuthorId == entry.AuthorId;
        if (!isOwnMessage)
            return false;

        if (!await ChatSupportsUnreadStatus(chat, cancellationToken).ConfigureAwait(false))
            return false;

        var readPositionsStat = await Chats.GetReadPositionsStat(Session, entry.ChatId, cancellationToken)
            .ConfigureAwait(false);
        var canCalculateHasRead = readPositionsStat.CanCalculateHasReadByAnotherAuthor(entry);
        // Do not show `Unread` label for old messages (before the feature was introduced)
        // until we have at least more or less good enough read positions stat.
        if (!canCalculateHasRead)
            return false;

        var hasBeenRead = readPositionsStat.HasReadByAnotherAuthor(entry, ownAuthorId);
        if (hasBeenRead) {
            // Remember that message has been read, so we don't need to recalculate it on next ComputeState cycle.
            _hasBeenReadEntryId = entry.Id;
        }
        return !hasBeenRead;
    }

    private async Task<bool> ChatSupportsUnreadStatus(Chat chat, CancellationToken cancellationToken) {
        // NOTE(DF): move this check to ChatContext to share among all message views.
        // ChatContext and Chat can be considered as immutable and used from any thread.
        if (chat.HasSingleAuthor)
            return false;

        var authors = await Authors.ListAuthorIds(Session, chat.Id, cancellationToken).ConfigureAwait(false);
        if (authors.Length < 2) {
            // It seems the current user is the only member in the chat hence it has no sense to check unread status.
            return false;
        }

        return true;
    }

    private string GetIcons(ChatEntry entry) {
        if (entry.HasLocation)
            return "<i class=\"icon-map-point\"></i>";

        var attachments = entry.Attachments;
        if (attachments.Length == 0)
            return "";

        var containsImage = false;
        var containsVideo = false;
        var containsFile = false;

        foreach (var x in attachments) {
            if (x.IsSupportedImage()) {
                containsImage = true;
            } else if (x.IsSupportedVideo()) {
                containsVideo = true;
            } else {
                containsFile = true;
            }

            if (containsImage && containsVideo && containsFile)
                break;
        }

        var sb = ActualLab.Text.StringBuilderExt.Acquire();
        if (containsImage)
            sb.Append("<i class=\"icon-image-2\"></i>");
        if (containsVideo)
            sb.Append("<i class=\"icon-video\"></i>");
        if (containsFile)
            sb.Append("<i class=\"icon-file\"></i>");

        return sb.ToStringAndRelease();
    }

    // Nested types

    public sealed record Model {
        public static readonly Model None = new();

        public ChatListKind? ListKind { get; init; }
        public Chat? Chat { get; init; }
        public string LastTextEntryText { get; init; } = "";
        public string LastTextEntryIcons { get; init; } = "";
        public ChatEntry? LastTextEntry { get; init; }
        public ChatAudioState? AudioState { get; init; }
        public CallActivity CallActivity { get; init; }
        public ChatNotificationMode NotificationMode { get; init; }
        public Trimmed<int> UnreadCount { get; init; }
        public bool HasUnreadMentions { get; init; }
        public bool IsSelected { get; init; }
        public bool IsLastItemInBlock { get; init; }
        public bool IsFirstItem { get; init; }
        public bool IsUnreadByOthers { get; init; }
        public Chat? LastThread { get; init; }
        public Author? LastThreadCreator { get; init; }
        public Moment LastBeginsAt => LastThread?.CreatedAt ?? LastTextEntry?.BeginsAt ?? Moment.EpochStart;
        public AuthorId? LastAuthorId => LastThreadCreator?.Id ?? LastTextEntry?.AuthorId;
    }
}
