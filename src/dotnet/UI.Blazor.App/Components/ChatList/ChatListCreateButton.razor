@namespace ActualChat.UI.Blazor.App.Components
@inherits ComputedStateComponent<AppUIHub, AccountFull>
@{
    var account = State.Value;
    if (!account.IsActive())
        return;
}

<ButtonRound Class="chat-list-fab"
            Tooltip="New chat or place"
            TooltipPosition="FloatingPosition.Top"
            data-bubble="@(BubbleRef.New<CreateChatOrPlaceBubble>())"
            data-bubble-priority="201"
            data-bubble-placement="@(FloatingPosition.TopEnd.ToPositionString())"
            data-menu="@(MenuRef.New<CreateMenu>().ToString())"
            data-menu-trigger="@MenuTrigger.Primary"
            data-menu-placement="@(FloatingPosition.TopEnd.ToPositionString())">
    <i class="icon-plus"></i>
</ButtonRound>

@code {
    protected override ComputedState<AccountFull>.Options GetStateOptions()
        => new() {
            InitialValue = AccountUI.OwnAccount.Value,
            Category = GetStateCategory(GetType()),
        };

    protected override Task<AccountFull> ComputeState(CancellationToken cancellationToken)
        => AccountUI.OwnAccount.Use(cancellationToken);
}
