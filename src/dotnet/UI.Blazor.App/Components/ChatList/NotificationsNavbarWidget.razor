@namespace ActualChat.UI.Blazor.App.Components
@inherits ComputedStateComponent<AppUIHub, NotificationsNavbarWidget.Model>
@{
    var m = State.Value;
    RenderFragment RenderTab(double order, ChatListFilter filter, string title) {
        var contentVersion = (filter.Id.Value, title);
        return @<Tab
                    @key="@filter.Id.Value"
                    Id="@filter.Id.Value"
                    Title="@title"
                    ContentVersion="@contentVersion"
                    Order="@order"
                    Class="chats-tab">
                   <TitleContent>
                       <span>@title</span>
                       <NotificationsTabUnreadCount ChatListFilter="@filter"/>
                   </TitleContent>
               </Tab>;
    }
}

<div class="c-container">
    <div class="c-all-chats">
        @if (!m.HasAll && !m.HasDMs && !m.HasMentions) {
            <div class="c-empty">
                <i class="icon-checkmark-circle"></i>
                <span>You're all caught up</span>
            </div>
        } else {
            <TabPanel
                BottomHill="true"
                TabsClass="left-panel-tabs"
                SelectedTabIdChanged="@OnSelectedTabIdChanged">
                <ChildContent>
                    @if (m.HasAll) {
                        @RenderTab(0, ChatListFilter.Unread, "All")
                    }
                    @if (m.HasDMs) {
                        @RenderTab(1, ChatListFilter.UnreadDMs, "DMs")
                    }
                    @if (m.HasMentions) {
                        @RenderTab(2, ChatListFilter.UnreadMentions, "Mentions")
                    }
                </ChildContent>
            </TabPanel>
            <ChatList @key="@_settings.FilterId.Value" PlaceId="@null" UsePlaceChatListSettings="@false" Settings="@_settings"/>
        }
    </div>
</div>

@code {
    private ChatListSettings _settings = new() { FilterId = ChatListFilter.Unread.Id };

    private ChatListUI ChatListUI => Hub.ChatListUI;
    private NotificationsPanelUI NotificationsPanelUI => Hub.NotificationsPanelUI;

    protected override void OnInitialized() {
        NotificationsPanelUI.Open();
        base.OnInitialized();
    }

    public override ValueTask DisposeAsync() {
        NotificationsPanelUI.Close();
        return base.DisposeAsync();
    }

    protected override ComputedState<Model>.Options GetStateOptions()
        => ComputedStateComponent.GetStateOptions(GetType(),
            static t => new ComputedState<Model>.Options() {
                InitialValue = new(),
                UpdateDelayer = FixedDelayer.Get(0.1),
                Category = GetStateCategory(t),
            });

    protected override async Task<Model> ComputeState(CancellationToken cancellationToken) {
        var hasAll = await HasTab(ChatListFilter.Unread, cancellationToken).ConfigureAwait(false);
        var hasDMs = await HasTab(ChatListFilter.UnreadDMs, cancellationToken).ConfigureAwait(false);
        var hasMentions = await HasTab(ChatListFilter.UnreadMentions, cancellationToken).ConfigureAwait(false);
        return new(hasAll, hasDMs, hasMentions);
    }

    // A tab stays visible while the panel session keeps its (possibly already-read) chats,
    // not only while there are actually-unread ones.
    private async Task<bool> HasTab(ChatListFilter filter, CancellationToken cancellationToken) {
        var stickyIds = await NotificationsPanelUI.GetSessionSet(filter.Id, cancellationToken).ConfigureAwait(false);
        if (!stickyIds.IsEmpty)
            return true;
        var count = await ChatListUI.GetUnreadChatCount(null, filter, cancellationToken).ConfigureAwait(false);
        return count > 0;
    }

    private void OnSelectedTabIdChanged(string? tabId) {
        if (tabId.IsNullOrEmpty())
            return;
        _settings = new ChatListSettings { FilterId = tabId };
        StateHasChanged();
    }

    // Nested types

    public sealed record Model(bool HasAll = false, bool HasDMs = false, bool HasMentions = false);
}
