@namespace ActualChat.UI.Blazor.App.Components
@inherits ComputedStateComponent<AppUIHub, NotificationsNavbarWidget.Model>
@{
    var m = State.Value;
    TabDef NewTab(ChatListFilter filter, string title)
        => new(filter.Id.Value, title) {
            Class = "chats-tab",
            TitleContent = @<text>
                               <span>@title</span>
                               <NotificationsTabUnreadCount ChatListFilter="@filter"/>
                           </text>,
        };

    var tabs = new List<TabDef>();
    if (m.HasAll)
        tabs.Add(NewTab(ChatListFilter.Unread, L.ChatList_TabAll));
    if (m.HasPeople)
        tabs.Add(NewTab(ChatListFilter.UnreadPeople, L.ChatList_TabPeople));
    if (m.HasMentions)
        tabs.Add(NewTab(ChatListFilter.UnreadMentions, L.ChatList_TabMentions));
}

<div class="c-container">
    <div class="c-all-chats">
        @if (!m.HasAll && !m.HasPeople && !m.HasMentions) {
            <div class="c-empty">
                <i class="icon-checkmark-circle"></i>
                <span>@L.Notifications_AllCaughtUp</span>
            </div>
            <ContentSwapDisplay/>
        } else {
            <TabPanel
                Tabs="@tabs"
                BottomHill="true"
                TabsClass="left-panel-tabs"
                SelectedTabIdChanged="@OnSelectedTabIdChanged"/>
            <ContentSwap
                LayerKey="@_settings.FilterId.Value"
                Class="c-list-swap"
                Effect="@_swapDirection.Swipe(GetTabIndex(_settings.FilterId))"
                MustPropagateDisplay="true">
                <ChildContent>
                    <ChatList
                        @key="@ChatList.GetKey(null, false, _settings)"
                        PlaceId="@null"
                        UsePlaceChatListSettings="@false"
                        Settings="@_settings"/>
                </ChildContent>
            </ContentSwap>
        }
    </div>
</div>

@code {
    private static readonly ChatListFilter[] Filters =
        [ChatListFilter.Unread, ChatListFilter.UnreadPeople, ChatListFilter.UnreadMentions];

    private readonly ContentSwapDirection _swapDirection = new();
    private ChatListSettings _settings = new() { FilterId = ChatListFilter.Unread.Id };

    private ChatListUI ChatListUI => Hub.ChatListUI;
    private NotificationsPanelUI NotificationsPanelUI => Hub.NotificationsPanelUI;
    private NotificationsUI NotificationsUI => Hub.NotificationsUI;

    protected override ComputedState<Model>.Options GetStateOptions()
        => ComputedStateComponent.GetStateOptions(GetType(),
            static t => new ComputedState<Model>.Options() {
                InitialValue = new(),
                UpdateDelayer = FixedDelayer.Get(0.1),
                Category = GetStateCategory(t),
            });

    protected override async Task<Model> ComputeState(CancellationToken cancellationToken) {
        var hasAll = await HasTab(ChatListFilter.Unread, cancellationToken).ConfigureAwait(false);
        var hasPeople = await HasTab(ChatListFilter.UnreadPeople, cancellationToken).ConfigureAwait(false);
        var hasMentions = await HasTab(ChatListFilter.UnreadMentions, cancellationToken).ConfigureAwait(false);
        return new(hasAll, hasPeople, hasMentions);
    }

    // Private methods

    private async Task<bool> HasTab(ChatListFilter filter, CancellationToken cancellationToken) {
        // A tab stays visible while it still holds recently-read chats, not only while there are unread ones.
        var expiring = await NotificationsPanelUI.GetExpiring(filter.Id, cancellationToken).ConfigureAwait(false);
        if (expiring.Count > 0)
            return true;

        var count = await ChatListUI.GetUnreadChatCount(null, filter, cancellationToken).ConfigureAwait(false);
        if (count > 0)
            return true;
        if (filter == ChatListFilter.UnreadMentions)
            return false;

        var reactedChatIds = await NotificationsUI.ListReactedChatIds(cancellationToken).ConfigureAwait(false);
        return reactedChatIds.Count > 0;
    }

    private void OnSelectedTabIdChanged(string? tabId) {
        if (tabId.IsNullOrEmpty())
            return;

        _settings = new ChatListSettings { FilterId = tabId };
        StateHasChanged();
    }

    private static int GetTabIndex(Symbol filterId) {
        for (var i = 0; i < Filters.Length; i++)
            if (Filters[i].Id == filterId)
                return i;

        return 0;
    }

    // Nested types

    public sealed record Model(bool HasAll = false, bool HasPeople = false, bool HasMentions = false);
}
