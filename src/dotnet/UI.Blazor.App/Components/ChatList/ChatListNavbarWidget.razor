@namespace ActualChat.UI.Blazor.App.Components
@inherits FusionComponentBase<AppUIHub>
@{
    var showFilters = true; // Chats and regular Places.
    var supportThreads = PlaceId is null || Constants.Place.SystemPlaceIds.All(c => PlaceId.Value != c.Value);

    RenderFragment RenderChatListTab(double order, ChatListFilter filter)
        => RenderTab(order, filter.Id.Value, filter.Title, filter);
    RenderFragment RenderThreadsTab(double order)
        => RenderTab(order, ThreadsTabId, "Threads", null);
    RenderFragment RenderTab(double order, string id, string title, ChatListFilter? filter) {
        var contentVersion = (id, title);
        return @<Tab
                    @key="@id"
                    Id="@id"
                    Title="@title"
                    ContentVersion="@contentVersion"
                    Order="@order"
                    Class="chats-tab">
                   <TitleContent>
                       <span>@title</span>
                       @if (filter is not null) {
                           <ChatListTabUnreadCount PlaceChatListSettings="@_placeChatListSettings" ChatListFilter="@filter" />
                       }
                   </TitleContent>
               </Tab>;
    }
}

<div class="c-container">
    <div class="c-all-chats">
        @if (showFilters) {
            <TabPanel
                @ref="@_tabPanel"
                BottomHill="true"
                TabsClass="left-panel-tabs"
                AutoSelectInitialTab="false"
                SelectedTabIdChanged="@OnSelectedTabIdChanged">
                <AdditionalButton>
                    <ChatListSortButton PlaceChatListSettings="@_placeChatListSettings"/>
                </AdditionalButton>
                <ChildContent>
                    @{ var i1 = 0; }
                    @for (var i = 0; i < ChatListFilter.All.Length; i++) {
                        var filter = ChatListFilter.All[i];
                        i1 = i + 1;
                        @RenderChatListTab(i, filter)
                    }
                    @if (supportThreads) {
                        @RenderThreadsTab(i1);
                    }
                </ChildContent>
            </TabPanel>
        }
        @if (_showThreadsList) {
            <ThreadList PlaceId="@PlaceId" />
        } else {
            <ChatList @key="@(PlaceId?.Value ?? "")" PlaceId="@PlaceId" UsePlaceChatListSettings="@true"/>
        }
    </div>
    <div class="c-active-chats">
        <ActiveChats/>
        <ChatListCreateButton/>
    </div>
</div>

@code {
    private const string ThreadsTabId = "threads";
    private TabPanel? _tabPanel;
    private bool _showThreadsList;
    private PlaceChatListSettings? _placeChatListSettings;
    private string? _tabPanelSelectedTabId;

    private ChatListUI ChatListUI => Hub.ChatListUI;

    [Parameter, EditorRequired] public PlaceId? PlaceId { get; set; }

    protected override async Task OnParametersSetAsync() {
        if (_placeChatListSettings is not null && PlaceId == _placeChatListSettings.PlaceId)
            return;

        var placeId = PlaceId;
        var placeChatListSettings = ChatListUI.GetPlaceChatListSettings(placeId);
        _placeChatListSettings ??= placeChatListSettings; // Ensure the field is initialized before the first render.
        var chatListSettings = await placeChatListSettings.Get();
        if (placeId != PlaceId)
            return; // PlaceId was changed while we were reading settings

        _placeChatListSettings = placeChatListSettings;
        _tabPanelSelectedTabId = chatListSettings.FilterId;
    }

    protected override void OnAfterRender(bool firstRender) {
        if (_tabPanelSelectedTabId == null || _tabPanel is null)
            return;

        _tabPanel.SelectedTabId = _tabPanelSelectedTabId;
        _tabPanelSelectedTabId = null;
    }

    private void OnSelectedTabIdChanged(string? tabId) {
        tabId ??= "";
        _showThreadsList = tabId == ThreadsTabId;
        if (!_showThreadsList) { // Show ChatList
            var filterId = tabId;
            _placeChatListSettings?.SetFilter(filterId);
        }
    }
}
