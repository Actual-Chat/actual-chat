@namespace ActualChat.UI.Blazor.App.Components
@inherits FusionComponentBase<AppUIHub>
@{
    var mustShowFilters = true; // Chats and regular Places.
    var isThreadsSupported = PlaceId is null || Constants.Place.SystemPlaceIds.All(c => PlaceId.Value != c.Value);

    TabDef NewTab(string id, string title, ChatListFilter? filter)
        => new(id, title) {
            Class = "chats-tab",
            TitleContent = @<text>
                               <span>@title</span>
                               @if (filter is not null) {
                                   <ChatListTabUnreadCount
                                       PlaceChatListSettings="@_placeChatListSettings"
                                       ChatListFilter="@filter"/>
                               } else if (id == ThreadsTabId) {
                                   <ThreadListTabUnreadCount PlaceId="@PlaceId"/>
                               } else if (id == ArchiveTabId) {
                                   <ArchiveTabUnreadCount PlaceId="@PlaceId"/>
                               }
                           </text>,
        };

    var tabs = ChatListFilter.All.Select(x => NewTab(x.Id.Value, GetFilterTitle(x), x)).ToList();
    if (isThreadsSupported)
        tabs.Add(NewTab(ThreadsTabId, L.ChatList_TabThreads, null));
    tabs.Add(NewTab(ArchiveTabId, L.ChatList_TabArchive, null));
}

<div class="chat-list-widget" data-children="active-chats ptt-chats">
    <div class="c-all-chats">
        @if (mustShowFilters) {
            <TabPanel
                @ref="@_tabPanel"
                Tabs="@tabs"
                BottomHill="true"
                TabsClass="left-panel-tabs"
                AutoSelectInitialTab="false"
                SelectedTabIdChanged="@OnSelectedTabIdChanged">
                <AdditionalButton>
                    @if (_mustShowArchive) {
                        <ButtonRound
                            Class="chat-list-sort-btn btn-xs btn-transparent unhovered"
                            data-menu="@(MenuRef.New<ChatListArchiveSortMenu>())"
                            data-menu-trigger="@MenuTrigger.Primary"
                            data-menu-placement="@(FloatingPosition.BottomStart.ToPositionString())">
                            <i class="icon-sort-by-recent text-2xl"></i>
                        </ButtonRound>
                    } else {
                        <ChatListSortButton PlaceChatListSettings="@_placeChatListSettings"/>
                    }
                </AdditionalButton>
            </TabPanel>
        }
        @* The place's own filter arrives a render after the switch, and the panel around it already
           animates that - so only a tab the user picked gets a layer of its own to slide. *@
        <ContentSwap
            LayerKey="@_swapIndex"
            Class="c-list-swap"
            Effect="@_swapDirection.Swipe(GetTabIndex(_selectedTabId))"
            MustPropagateDisplay="true"
            IsEnabled="@(_tabPanel?.IsUserSelection == true)">
            <ChildContent>
                @if (_mustShowArchive) {
                    <ArchiveEmptyHint @key="@PlaceId" PlaceId="@PlaceId"/>
                    <ChatList
                        @key="@ChatList.GetKey(PlaceId, false, null, default, true)"
                        PlaceId="@PlaceId"
                        UsePlaceChatListSettings="@false"
                        IsArchive="@true"/>
                } else if (_mustShowThreadsList) {
                    <ThreadList PlaceId="@PlaceId" />
                } else {
                    <ChatList @key="@ChatList.GetKey(PlaceId, true, null)" PlaceId="@PlaceId" UsePlaceChatListSettings="@true"/>
                }
            </ChildContent>
        </ContentSwap>
    </div>
    <div class="chat-list-dock" data-children="active-chats ptt-chats">
        <ActiveChats/>
        <PttChats/>
        <ChatListCreateButton/>
    </div>
</div>

@code {
    private const string ThreadsTabId = "threads";
    private const string ArchiveTabId = "archive";

    private readonly ContentSwapDirection _swapDirection = new();
    private string _selectedTabId = "";
    private int _swapIndex;
    private TabPanel? _tabPanel;
    private bool _mustShowThreadsList;
    private bool _mustShowArchive;
    private PlaceChatListSettings? _placeChatListSettings;
    private string? _tabPanelSelectedTabId;

    private ChatListUI ChatListUI => Hub.ChatListUI;

    [Parameter, EditorRequired] public PlaceId? PlaceId { get; set; }

    protected override async Task OnParametersSetAsync() {
        if (_placeChatListSettings is not null && PlaceId == _placeChatListSettings.PlaceId)
            return;

        var placeId = PlaceId;
        var placeChatListSettings = ChatListUI.GetPlaceChatListSettings(placeId);
        _placeChatListSettings ??= placeChatListSettings; // Ensure the field is initialized before the first render.
        var chatListSettings = await placeChatListSettings.Get();
        if (placeId != PlaceId)
            return; // PlaceId was changed while we were reading settings

        _placeChatListSettings = placeChatListSettings;
        _tabPanelSelectedTabId = chatListSettings.FilterId;
    }

    protected override void OnAfterRender(bool firstRender) {
        if (_tabPanelSelectedTabId == null || _tabPanel is null)
            return;

        _tabPanel.SelectedTabId = _tabPanelSelectedTabId;
        _tabPanelSelectedTabId = null;
    }

    private void OnSelectedTabIdChanged(string? tabId) {
        // _swapIndex rather than the tab id keys the swap: the id also settles from "" to the place's
        // stored filter, and "All" is itself "", so an id key both over- and under-swaps
        tabId ??= "";
        if (_tabPanel?.IsUserSelection == true)
            _swapIndex++;
        _selectedTabId = tabId;
        _mustShowThreadsList = tabId == ThreadsTabId;
        _mustShowArchive = tabId == ArchiveTabId;
        if (!_mustShowThreadsList && !_mustShowArchive) { // Show ChatList
            var filterId = tabId;
            _placeChatListSettings?.SetFilter(filterId);
        }
    }

    private string GetFilterTitle(ChatListFilter filter)
        => filter == ChatListFilter.People ? L.ChatList_TabPeople
            : filter == ChatListFilter.Groups ? L.ChatList_TabGroups
            : L.ChatList_TabAll;

    private static int GetTabIndex(string tabId) {
        // The Threads tab is rendered after every filter, so it is the one index past them
        if (tabId == ArchiveTabId)
            return ChatListFilter.All.Length + 1;
        if (tabId == ThreadsTabId)
            return ChatListFilter.All.Length;

        for (var i = 0; i < ChatListFilter.All.Length; i++)
            if (ChatListFilter.All[i].Id.Value == tabId)
                return i;

        return 0;
    }
}
