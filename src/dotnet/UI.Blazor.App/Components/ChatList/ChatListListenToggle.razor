@namespace ActualChat.UI.Blazor.App.Components
@inherits FusionComponentBase<AppUIHub>
@{
    var m = AudioState ?? ChatAudioState.None;
    var replayingClass = m.IsReplaying ? "opacity-60" : "";
    var cls = $"play {(m.IsListening ? "on" : "off")} {replayingClass} {Class}";
}

<HeaderButton
    Class="@cls"
    Click="@OnListenClick"
    Tooltip="@(m.IsListening ? L.Common_Mute : L.Common_Listen)"
    TooltipPosition="FloatingPosition.Top"
    MustKeepAwake="@(!m.IsListening)">
    <i class="icon-listen text-2xl"></i>
</HeaderButton>

@code {
    private ChatAudioUI ChatAudioUI => Hub.ChatAudioUI;

    [Parameter, EditorRequired] public ChatAudioState? AudioState { get; set; }
    [Parameter] public string Class { get; set; } = "";

    private void OnListenClick() {
        if (AudioState is { ChatId: { } chatId, IsListening: var isListening })
            _ = ChatAudioUI.SetListeningState(chatId, !isListening);
    }
}
