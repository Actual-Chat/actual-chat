@namespace ActualChat.UI.Blazor.App.Components
@using ActualChat.Kvas
@using ActualChat.UI.Blazor.App.Components.Settings
@using ActualChat.UI.Blazor.Events
@inherits ComputedStateComponent<AppUIHub, List<Chat>>
@{
    var chats = State.Value;
    var hasChats = chats is { Count: > 0 };
    var total = hasChats ? chats!.Count : 0;
    // At most MaxSlots circles in the row; when the chats overflow, the last slot becomes the "+N" counter.
    var showCount = total <= MaxSlots ? total : MaxSlots - 1;
    var previewChats = hasChats ? chats!.Take(showCount).ToList() : [];
    var moreCount = total - showCount;
    var itemCount = showCount + (moreCount > 0 ? 1 : 0) + 1;
    var cls = $"ptt-chats {(hasChats ? "open" : "")}";
}

<div class="@cls" data-child="@(hasChats ? "ptt-chats" : null)">
    <div class="c-inner">
        @if (hasChats) {
            @* The whole panel opens PTT settings via this backing layer: everything above it is
               pointer-events-none so clicks fall through to it. *@
            <div class="c-settings-hit" @onclick="@OnOpenSettings"></div>
            <div class="c-preview">
                <div class="c-stack" style="--ptt-count: @itemCount">
                    @for (var i = 0; i < previewChats.Count; i++) {
                        var chat = previewChats[i];
                        <PttChatAvatar Chat="@chat" ZIndex="@(i + 1)" @key="@chat.Id"/>
                    }
                    @if (moreCount > 0) {
                        <div class="c-more">+@moreCount</div>
                    }
                    <div class="c-ptt-circle">
                        <i class="icon-push-to-talk"></i>
                    </div>
                </div>
                <i class="icon-chevron-right c-chevron"></i>
            </div>
        }
    </div>
</div>

@code {
    private const int MaxSlots = 10;
    private const string MruKey = "PttChats.RecordedOrder";

    // Chat ids most-recently-recorded-in first: recording in a chat moves it to the front (left) and
    // it holds there afterwards. Persisted to local settings so the order survives a page refresh.
    private List<ChatId> _mru = [];
    private bool _mruLoaded;

    private IChats Chats => Hub.Chats;
    private ChatAudioUI ChatAudioUI => Hub.ChatAudioUI;

    protected override async Task<List<Chat>> ComputeState(CancellationToken cancellationToken) {
        if (!_mruLoaded) {
            _mru = (await LocalSettings.Get<ChatId[]>(MruKey, cancellationToken).ConfigureAwait(false))?.ToList() ?? [];
            _mruLoaded = true;
        }
        var chatIds = new List<ChatId>(await ChatAudioUI.GetPttChatIds(cancellationToken).ConfigureAwait(false));
        var mutedPttChatIds = await ChatAudioUI.GetMutedPttChatIds(cancellationToken).ConfigureAwait(false);
        chatIds.AddRange(mutedPttChatIds.Where(id => !chatIds.Contains(id)));
        var chats = (await chatIds
                .Select(chatId => Chats.Get(Session, chatId, cancellationToken))
                .Collect(cancellationToken)
                .ConfigureAwait(false))
            .SkipNullItems()
            .ToList();
        var recordingChatId = await ChatAudioUI.GetRecordingChatId().ConfigureAwait(false);
        // The chat being recorded in moves to the front of the recency list and holds there afterwards.
        // Drop ids that have left the PTT set. Persist on change.
        var changed = false;
        if (recordingChatId is { } recordingId
            && chats.Any(c => c.Id == recordingId)
            && (_mru.Count == 0 || _mru[0] != recordingId)) {
            _mru.Remove(recordingId);
            _mru.Insert(0, recordingId);
            changed = true;
        }
        var liveIds = chats.Select(c => c.Id).ToHashSet();
        changed |= _mru.RemoveAll(id => !liveIds.Contains(id)) > 0;
        if (changed)
            _ = LocalSettings.Set(MruKey, _mru.ToArray(), CancellationToken.None);
        return chats
            .OrderBy(chat => chat.Id != recordingChatId)
            .ThenBy(chat => MruIndex(chat.Id))
            .ThenBy(chat => chat.Title)
            .ToList();
    }

    private int MruIndex(ChatId chatId) {
        var index = _mru.IndexOf(chatId);
        return index < 0 ? int.MaxValue : index;
    }

    private void OnOpenSettings()
        => _ = UIEventHub.Publish(new ShowSettingsEvent(SettingsTabId.Ptt));
}
