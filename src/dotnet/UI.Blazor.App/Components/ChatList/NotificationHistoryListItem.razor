@namespace ActualChat.UI.Blazor.App.Components
@inherits ComputedRenderStateComponent<AppUIHub, NotificationHistoryListItem.Model>
@{
    var isInitial = State.IsInitial(out var m);
    var chat = m.Chat;
    var newest = Group.Newest;
    var link = newest.NotificationId is { } notificationId
        ? Links.Notification(notificationId, newest.EntryId?.LocalId ?? 0)
        : newest.EntryId is { } entryId ? Links.Chat(entryId)
        : Links.Chat(Group.ChatId);
    // An empty Url makes NavbarItem render plain content: a chat the reader can no longer open
    // keeps its stored title but stops navigating, while a still-loading row stays clickable.
    var url = isInitial || chat is not null ? link.Value : "";
}

<NavbarItem
    Url="@url"
    ReplaceOnPrefix="/chat/"
    IsSelected="false"
    Class="c-history">
    <ChildContent>
        <div class="c-container">
            @if (m.Place is { } place) {
                <PlaceIcon Place="@place"/>
            } else {
                <ChatIcon Chat="@chat" ShowPresence="false"/>
            }
            <div class="c-description">
                <span class="c-chat-title">
                    <span>@(m.Place?.Title ?? chat?.Title ?? newest.Title)</span>
                    <span class="c-incut"></span>
                    <LiveTimeDeltaText Class="c-timestamp" Moment="@newest.SentAt"/>
                </span>
                <div class="c-last-message">
                    <span class="c-text">@newest.Text</span>
                    <div class="c-incut"></div>
                    @if (Group.OlderCount > 0) {
                        <Badge
                            Class="message-counter-badge c-history-count"
                            Color="bg-counter">+@Group.OlderCount</Badge>
                    }
                </div>
            </div>
        </div>
    </ChildContent>
</NavbarItem>

@code {
    private IChats Chats => Hub.Chats;
    private IPlaces Places => Hub.Places;

    [Parameter, EditorRequired] public NotificationHistoryGroup Group { get; set; } = null!;

    protected override ComputedState<Model>.Options GetStateOptions()
        => ComputedStateComponent.GetStateOptions(GetType(),
            static t => new ComputedState<Model>.Options {
                InitialValue = Model.None,
                UpdateDelayer = FixedDelayer.Get(0.1),
                Category = GetStateCategory(t),
            });

    protected override async Task<Model> ComputeState(CancellationToken cancellationToken) {
        // A place invitation is about the place's root chat, so its row stands for the place
        var chatId = Group.ChatId;
        var chat = await Chats.Get(Session, chatId, cancellationToken).ConfigureAwait(false);
        if (chatId is not PlaceChatId { IsRoot: true } rootChatId)
            return new Model(chat);

        var place = await Places.Get(Session, rootChatId.PlaceId, cancellationToken).ConfigureAwait(false);
        return new Model(chat, place);
    }

    // Nested types

    public sealed record Model(Chat? Chat, Place? Place = null)
    {
        public static readonly Model None = new((Chat?)null);
    }
}
