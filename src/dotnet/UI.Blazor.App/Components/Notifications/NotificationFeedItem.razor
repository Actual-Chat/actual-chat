@namespace ActualChat.UI.Blazor.App.Components
@using ActualChat.Notifications
@using Notification = ActualChat.Notifications.Notification
@inherits ComponentBase<AppUIHub>

<div class="notification-item @(IsUnread ? "unread" : "")" role="option" tabindex="0"
    @onclick="OnOpen" @onkeydown="OnKeyDown">
    <div class="c-avatar">
        @if (Chat is not null) {
            <ChatIcon Chat="@Chat" Size="SquareSize.Size10"/>
        }
        else {
            <div class="c-system-avatar"><i class="icon-bell"></i></div>
        }
    </div>
    <div class="c-description">
        <div class="c-top">
            <span class="c-title">@Notification.Title</span>
            <div class="c-incut"></div>
            @if (IsUnread) {
                <span class="c-unread-dot"></span>
            }
            <span class="c-time">@Hub.MarkupHelpers.LastEntryTime(Notification.SentAt)</span>
        </div>
        <div class="c-bottom">
            <span class="c-text">@Notification.Text</span>
        </div>
        @if (Notification.Actions.Count > 0) {
            <div class="c-actions" @onclick:stopPropagation="true">
                @foreach (var action in Notification.Actions) {
                    <Button Class="btn-sm btn-primary" Click="@(() => OnAction(action))">@action.Title</Button>
                }
            </div>
        }
    </div>
    <div class="c-ending" @onclick:stopPropagation="true">
        <ButtonSquare Class="c-dismiss" Click="OnDismissClick" aria-label="dismiss">
            <i class="icon-close"></i>
        </ButtonSquare>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public Notification Notification { get; set; } = null!;
    [Parameter] public Chat? Chat { get; set; }
    [Parameter] public bool IsUnread { get; set; }
    [Parameter] public EventCallback Dismissed { get; set; }

    private void OnOpen()
        => _ = Hub.History.NavigateTo(Notification.GetChatLink());

    private void OnKeyDown(KeyboardEventArgs e) {
        if (e.Key is "Enter" or "NumpadEnter" or " " or "Spacebar")
            OnOpen();
    }

    private Task OnDismissClick()
        => Dismissed.InvokeAsync();

    private async Task OnAction(NotificationAction action) {
        switch (action.Kind) {
        case NotificationActionKind.Open:
            LocalUrl url = action.Target.IsNullOrEmpty() ? Notification.GetChatLink() : action.Target;
            _ = Hub.History.NavigateTo(url);
            break;
        case NotificationActionKind.Dismiss:
            await Dismissed.InvokeAsync();
            break;
        }
    }
}
