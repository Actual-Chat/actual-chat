@using ActualChat.Notifications
@namespace ActualChat.UI.Blazor.App.Components
@inherits Menu<AppUIHub>

<MenuEntry
    Icon="icon-checkmark-circle"
    Text="@L.Notifications_DismissAll"
    Click="OnDismissAllClick">
</MenuEntry>

@code {
    private NotificationsPanelUI NotificationsPanelUI => Hub.NotificationsPanelUI;
    private Task OnDismissAllClick() {
        // Before the command, so the chats it reads are never seen leaving the panel's list.
        NotificationsPanelUI.DismissAll();

        return UICommander.Run(new Notifications_DismissAll { Session = Session });
    }
}
