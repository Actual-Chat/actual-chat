@namespace ActualChat.UI.Blazor.App.Components
@using ActualChat.Media
@using ActualChat.WebHooks
@inherits ComputedStateComponent<AppUIHub, PlaceSettingsStartModalPage.ComputedModel>
@{
    if (State.IsInitial(out var m))
        return;
    if (m.Place == null) {
        Context.Close();
        return;
    }

    Context.ContextItems.Set(nameof(ComputedModel.MemberCount), m.MemberCount);
    var status = m.Place.IsPublic ? L.Place_Public : L.Place_Private;
    _place = m.Place;
    _isOwner = m.IsOwner;
    _enableIncompleteUI = m.EnableIncompleteUI;
    Context.Header = RenderHero;
    // Context.Header only re-renders the frame on a null<->non-null flip, so after an edit (e.g. a new
    // wallpaper/avatar saved in the owner step) the hero would stay stale. Nudge the frame when the place changes.
    if (_heroVersion != m.Place.Version) {
        _heroVersion = m.Place.Version;
        _ = InvokeAsync(Context.Refresh);
    }
}

<div class="chat-settings-subheader">
    <div class="c-title">@m.Place.Title</div>
    <div class="status-badge public">
        @if (m.Place.IsPublic) {
            <i class="icon-globe text-sm"></i>
        } else {
            <i class="icon-lock text-sm"></i>
        }
        @status
    </div>
</div>

@{
    var tabs = new List<TabDef> {
        new("members", L.Place_TabMembers) { Content = @<AuthorList PlaceId="@PlaceId"/> },
    };
    if (_isOwner && _enableIncompleteUI)
        tabs.Add(new("integrations", L.Integrations_Title) {
            Content = @<div class="place-integrations">
                          <WebHookList Scope="WebHookScope.Place" ScopeId="@PlaceId.Value"/>
                      </div>,
        });
}

<div class="c-panel-content">
    <div class="c-panel-tabs">
        <TabPanel
            @key="@PlaceId.Value"
            Tabs="@tabs"
            TabsClass="left-panel-tabs wide-left-panel-tabs"
            BottomHill="true"
            SwapKind="@TabContentSwap.Swipe"/>
    </div>
</div>

@code {
    private IPlaces Places => Hub.Places;

    [CascadingParameter] public DiveInModalPageContext Context { get; set; } = null!;

    private PlaceId PlaceId { get; set; } = null!;

    private Place _place = null!;
    private bool _isOwner;
    private bool _enableIncompleteUI;
    private long _heroVersion = -1;

    private RenderFragment RenderHero => @<div class="chat-settings-header place">
        <div class="c-top">
            @if (_place.Background != null) {
                <Pic
                    Picture="@_place.Background.ToPicture()"
                    ImageSkeletonClass="image-cover"
                    Size="@SquareSize.SizeFull"
                    IsSquare="true"
                    AvatarKind="@AvatarKind.Marble"
                    AvatarKey="@PlaceId.Value"
                    ShowFullSizeImage="true"/>
            } else {
                <Pic
                    Picture="@_place.Picture.ToPicture()"
                    ImageSkeletonClass="image-cover"
                    Size="@SquareSize.SizeFull"
                    IsSquare="true"
                    IsBlurred="true"
                    AvatarKind="@AvatarKind.Marble"
                    AvatarKey="@PlaceId.Value"/>
            }
            @if (!Context.IsInnerStep) {
                <ButtonRound
                    Click="@(() => Context.Close())"
                    Class="btn-sm right-panel-close-btn close-btn">
                    <i class="icon-close text-2xl"></i>
                </ButtonRound>
            }
        </div>
        <div class="c-center">
            <Pic
                IsSquare="true"
                Size="@SquareSize.Size16"
                Picture="@_place.Picture.ToPicture()"
                AvatarKind="@AvatarKind.Marble"
                AvatarKey="@PlaceId.Value"/>

            <div class="c-buttons">
                @if (_enableIncompleteUI) {
                    <ButtonRound
                        Class="btn-sm"
                        TooltipPosition="@FloatingPosition.Bottom"
                        Tooltip="@L.Place_Notifications">
                        <i class="icon-bell text-2xl"></i>
                    </ButtonRound>
                }
                @if (_isOwner) {
                    <ButtonRound
                        Class="btn-sm"
                        TooltipPosition="@FloatingPosition.Bottom"
                        Tooltip="@L.Place_AddMember"
                        Click="@OnInviteMembersClick">
                        <i class="icon-person-add text-2xl"></i>
                    </ButtonRound>
                }
                @if (_isOwner) {
                    <ButtonRound
                        Class="btn-sm"
                        TooltipPosition="@FloatingPosition.Bottom"
                        Tooltip="@L.Place_EditPlace"
                        Click="@OnOwnerSettingsClick">
                        <i class="icon-edit text-2xl"></i>
                    </ButtonRound>
                }
            </div>
        </div>
    </div>;

    protected override void OnInitialized() {
        PlaceId = Context.GetModel<PlaceId>();
        Context.Title = L.Place_InfoTitle;
    }

    protected override ComputedState<ComputedModel>.Options GetStateOptions()
        => ComputedStateComponent.GetStateOptions(GetType(),
            static t => new ComputedState<ComputedModel>.Options() {
                UpdateDelayer = FixedDelayer.NextTick,
                Category = GetStateCategory(t),
            });

    protected override async Task<ComputedModel> ComputeState(CancellationToken cancellationToken) {
        var placeId = PlaceId;
        var place = await Places.Get(Session, placeId, cancellationToken).ConfigureAwait(false);
        if (place == null || !place.Rules.CanEditProperties())
            return new() { Place = place };

        var allAuthorIds = await Places.ListAuthorIds(Session, place.Id, cancellationToken).ConfigureAwait(false);
        var enableIncompleteUI = await Hub.Features.IsIncompleteUIEnabled(cancellationToken);

        return new() {
            Place = place,
            MemberCount = allAuthorIds.Length,
            IsOwner = place.Rules.IsOwner(),
            EnableIncompleteUI = enableIncompleteUI,
        };
    }

    private void OnInviteMembersClick()
        => Context.StepIn(DiveInDialogPage.New<AddMemberModalPage>(PlaceId));

    private void OnOwnerSettingsClick()
        => Context.StepIn(DiveInDialogPage.New<PlaceSettingsOwnerModalPage>(PlaceId));

    // Nested types

    public sealed record ComputedModel {
        public Place? Place { get; init; }
        public int MemberCount { get; init; }
        public bool IsOwner { get; init; }
        public bool EnableIncompleteUI { get; init; }
    }
}
