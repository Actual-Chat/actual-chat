@namespace ActualChat.UI.Blazor.App.Components
@implements IModalView<CopyChatToPlaceErrorModal.Model>
@inherits ComponentBase<AppUIHub>

<DialogFrame Class="confirm-modal modal-sm" Title="@L.Place_CopyErrorTitle">
    <Body>
    <FormBlock>
        <div class="c-text">
            <p>@L.Place_CopyErrorText_Format(ModalModel.Chat, ModalModel.Place)</p>
            @if (ModalModel.HasChanges) {
                <p>@L.Place_CopyPartialSuccess</p>
            }
            <p>@L.Place_CopyErrorHelp</p>
            <CopyToClipboard ShowInput="true" IsSquare="true" ButtonClass="btn-sm" Text="@ModalModel.CorrelationId" />
        </div>
    </FormBlock>
    </Body>
    <Buttons>
        <Button Class="btn-modal" Click="@(_ => Modal.Close())">@L.Common_Close</Button>
    </Buttons>
</DialogFrame>

@code {
    [CascadingParameter] public Modal Modal { get; set; } = null!;
    [Parameter] public Model ModalModel { get; set; } = null!;

    public sealed record Model(string CorrelationId, bool HasChanges, string Chat, string Place);
}
