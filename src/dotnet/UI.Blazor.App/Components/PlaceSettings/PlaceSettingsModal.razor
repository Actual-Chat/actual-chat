@namespace ActualChat.UI.Blazor.App.Components
@implements IModalView<PlaceSettingsModal.Model>

<DiveInDialogFrame
    HasCloseButton="true"
    Class="edit-settings-modal edit-place-settings-modal fixed-height"
    BodyClass="no-scrollbar"
    StartPage="@StartPage" />

@code {
    [Parameter] public Model ModalModel { get; set; } = null!;

    private DiveInDialogPage StartPage => ModalModel.IsOwnerHandover
        ? DiveInDialogPage.New<PlaceSettingsEditMembersModalPage>(ModalModel.PlaceId)
        : DiveInDialogPage.New<PlaceSettingsStartModalPage>(ModalModel.PlaceId);

    public sealed record Model(PlaceId PlaceId) {
        public bool IsOwnerHandover { get; init; }
    }
}
