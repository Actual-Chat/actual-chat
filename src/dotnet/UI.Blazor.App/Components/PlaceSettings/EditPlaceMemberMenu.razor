@namespace ActualChat.UI.Blazor.App.Components
@inherits ComputedMenuBase<AppUIHub, EditPlaceMemberModel?>
@{
    var m = State.Value;
    if (m == null)
        return;

    var statusText = m.IsOwner ? "Owner" : m.IsModerator ? "Moderator" : null;
}

<div class="edit-member-menu edit-place-member-menu">

    <AuthorBadge
        AuthorId="@AuthorId"
        ShowPresence="true"
        StatusText="@statusText"/>

    @if (m.CanPromoteToOwner) {
        <MenuEntry
            Icon="icon-crown"
            Text="@L.Account_PromoteToOwner"
            Click="@(() => OnPromoteToOwnerClick(m.Author))">
        </MenuEntry>
    }

    @if (m.CanSetModerator) {
        <MenuEntry
            Icon="icon-shield"
            Text="@(m.IsModerator ? "Remove Moderator" : "Make Moderator")"
            Click="@(() => OnSetModeratorClick(m.Author, !m.IsModerator))">
        </MenuEntry>
    }

    @if (m.CanRemoveFromGroup) {
        <MenuEntrySeparator/>
        <MenuEntry
            Class="warning-item"
            Icon="icon-minus-circle"
            Text="@L.Place_RemoveFromPlace"
            Click="@(() => OnRemoveFromPlaceClick(m.Author))">
        </MenuEntry>
    }

</div>

@code {
    private AuthorId AuthorId { get; set; } = null!;

    protected override async Task OnParametersSetAsync() {
        if (Arguments is not [ var sAuthorId ])
            throw new ArgumentOutOfRangeException(nameof(Arguments));

        AuthorId = AuthorId.Parse(sAuthorId);
        await base.OnParametersSetAsync();
    }

    protected override Task<EditPlaceMemberModel?> ComputeState(CancellationToken cancellationToken)
        => EditPlaceMemberCommands.ComputeState(Hub, AuthorId, cancellationToken);

    private Task OnRemoveFromPlaceClick(Author author)
        => EditPlaceMemberCommands.OnRemoveFromPlaceClick(Hub, author);

    private async Task OnPromoteToOwnerClick(Author author) {
        await WhenClosed;
        await EditPlaceMemberCommands.OnPromoteToOwnerClick(Hub, author);
    }

    private async Task OnSetModeratorClick(Author author, bool isModerator) {
        await WhenClosed;
        await EditPlaceMemberCommands.OnSetModeratorClick(Hub, author, isModerator);
    }
}
