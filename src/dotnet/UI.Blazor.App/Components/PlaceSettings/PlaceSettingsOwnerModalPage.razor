@namespace ActualChat.UI.Blazor.App.Components
@using System.ComponentModel.DataAnnotations
@using ActualChat.Media
@using ActualChat.WebHooks
@inherits ComputedStateComponent<AppUIHub, PlaceSettingsOwnerModalPage.ComputedModel>
@{
    if (State.IsInitial(out var m))
        return;
    if (m.Place == null || !m.Place.Rules.CanEditProperties()) {
        Context.Close();
        return;
    }
    if (_form == null)
        return;

    Context.ContextItems.Set(nameof(ComputedModel.MemberCount), m.MemberCount);
    var canEditMembers = m.Place.Rules.CanEditMembers();
    var isOwner = m.IsOwner;
    Context.Header = RenderHero;
    // Context.Header only re-renders the frame on a null<->non-null flip, so a fresh instance (after
    // stepping back from an inner step) or an edit wouldn't refresh the hero. Force it when the place
    // version changes; a new instance starts at -1 and refreshes once, adopting its own live hero.
    if (_heroVersion != m.Place.Version) {
        _heroVersion = m.Place.Version;
        _ = InvokeAsync(Context.Refresh);
    }
}

<Form Class="h-full" @ref="@_formRef" Model="@_form">
    @{
        _submitButtonInfo.CanExecute = _formRef?.IsValid ?? false;
    }
    <FormBlock>
        <DataAnnotationsValidator/>

        <FormSection Class="field-chat-title" For="() => _form.Title" InputId="@_form.TitleId" IsLabelInsideInput="true" Label="@L.Form_PlaceTitle">
            <TextBox
                @bind-Value="@_form.Title"
                Id="@_form.TitleId"
                ClearButton="true"/>
        </FormSection>
        <FormSection Class="field-chat-title" For="() => _form.Description" InputId="@_form.DescriptionId" IsLabelInsideInput="true" Label="@L.Form_Description">
            <TextBox
                @bind-Value="@_form.Description"
                Id="@_form.DescriptionId"
                ClearButton="true"/>
        </FormSection>
    </FormBlock>

    <div class="chat-settings-container">
        <TileItem Click="OnManagePlaceTypeClick" Class="chat-type-tile-item">
            <Icon>
                <i class="icon-key text-xl"></i>
            </Icon>
            <Content>
                @L.Place_TypeTitle
            </Content>
            <Right>
                @(m.Place.IsPublic ? L.Place_Public : L.Place_Private)
            </Right>
        </TileItem>
        @if (canEditMembers) {
            <TileItem Class="item-manage-members" Click="OnManageMembersClick">
                <Icon>
                    <i class="icon-people"></i>
                </Icon>
                <Content>
                    @L.Place_MembersLabel(m.MemberCount, m.MemberCount)
                </Content>
                <Right>
                    <i class="icon-chevron-right text-xl"></i>
                </Right>
            </TileItem>
        }
        @if (isOwner) {
            <TileItem Click="OnCopyChatClick" Class="copy-chat-item">
                <Icon>
                    <i class="icon-copy-in-place text-xl"></i>
                </Icon>
                <Content>
                    @L.Place_CopyChatInto
                </Content>
            </TileItem>
            @if (m.EnableIncompleteUI) {
                <TileItem Class="item-integrations" Click="OnIntegrationsClick">
                    <Icon>
                        <i class="icon-link-2"></i>
                    </Icon>
                    <Content>
                        @L.Integrations_Title
                    </Content>
                    <Right>
                        <span class="c-count">@L.Integrations_Hooks_Format(m.WebHookCount, m.WebHookCount)</span>
                        <i class="icon-chevron-right text-xl"></i>
                    </Right>
                </TileItem>
            }
            <TileItem Class="item-danger" Click="@(() => OnPlaceDeleteClick())">
                <Icon><i class="icon-trash02"></i></Icon>
                <Content>@L.LeaveConfirm_DeletePlaceTitle</Content>
            </TileItem>
        }
    </div>
</Form>

@* Pickers render nothing and live in the page body, not the hero fragment: a @ref inside a fragment the
   frame renders can fail to rebind on a fresh instance, leaving these null so the hero buttons NRE. *@
<ImageCropPicker @ref="_avatarPicker"
    Scope="@_form!.ImageScope"
    IsSquare="true"
    CurrentPicture="@_form.Picture"
    CurrentAvatarKey="@PlaceId.Value"
    CurrentAvatarTitle="@_form.Title"
    AvatarKind="AvatarKind.Marble"
    OnCropped="@OnImagePicked" />
<ImageCropPicker @ref="_wallpaperPicker"
    Scope="@_form!.ImageScope"
    IsSquare="true"
    ViewportAspectRatio="@WallpaperAspectRatio"
    HasBlur="true"
    CurrentPicture="@_form.Background"
    OnCropped="@OnBackgroundPicked" />

@code {
    // Crop viewport is a bit taller than the panel's ~316x104 band so there's vertical headroom for
    // object-cover when the panel grows; the modal renders it around 350x130.
    private const float WallpaperAspectRatio = 350f / 130f;

    private Form?_formRef;
    private FormModel? _form;
    private DialogButtonInfo _submitButtonInfo = null!;
    private ImageCropPicker? _avatarPicker;
    private ImageCropPicker? _wallpaperPicker;
    private long _heroVersion = -1;

    // The hero lingers as the backdrop on deeper steps and its Context then points at the topmost step, so
    // gate on the frame's live top page type: the pictures are editable only while owner itself is on top.
    private EventCallback<MouseEventArgs> EditPicClick => Context.IsTopmostPage(GetType())
        ? EventCallback.Factory.Create<MouseEventArgs>(this, () => _avatarPicker!.Pick())
        : default;

    private IPlaces Places => Hub.Places;
    private ChatUI ChatUI => Hub.ChatUI;

    [CascadingParameter] public DiveInModalPageContext Context { get; set; } = null!;

    private PlaceId PlaceId { get; set; } = null!;

    private RenderFragment RenderHero => @<div class="chat-settings-header place">
        <div class="c-top">
            @if (_form!.Background != null) {
                <Pic
                    Picture="@_form.Background"
                    ImageSkeletonClass="image-cover"
                    Size="@SquareSize.SizeFull"
                    IsSquare="true"
                    AvatarKind="@AvatarKind.Marble"
                    AvatarKey="@PlaceId.Value"
                    ShowFullSizeImage="true"/>
            } else {
                <Pic
                    Picture="@_form.Picture"
                    ImageSkeletonClass="image-cover"
                    Size="@SquareSize.SizeFull"
                    IsSquare="true"
                    IsBlurred="true"
                    AvatarKind="@AvatarKind.Marble"
                    AvatarKey="@PlaceId.Value"/>
            }
            @if (!Context.IsInnerStep) {
                <ButtonRound
                    Click="@(() => Context.Close())"
                    Class="btn-sm right-panel-close-btn close-btn">
                    <i class="icon-close text-2xl"></i>
                </ButtonRound>
            }
        </div>
        <div class="c-center">
            <Pic
                Title="@_form!.Title"
                Picture="@_form.Picture"
                Size="@SquareSize.Size16"
                IsSquare="true"
                AvatarKind="@AvatarKind.Marble"
                AvatarKey="@PlaceId.Value"
                Click="@EditPicClick"/>

            @* Buttons show only while owner is the topmost step; drop them once a deeper step (type,
               members, ...) is on top. Gated on the frame's live top page type - see EditPicClick. *@
            @if (Context.IsTopmostPage(GetType())) {
                <div class="c-buttons">
                    <ButtonRound Class="btn-modal btn-sm" Click="@(() => _avatarPicker!.Pick())">
                        <i class="icon-person-add-2 text-2xl"></i>
                    </ButtonRound>
                    <ButtonRound Class="btn-modal btn-sm" Click="@(() => _wallpaperPicker!.Pick())">
                        <i class="icon-image text-2xl"></i>
                    </ButtonRound>
                </div>
            }
        </div>
    </div>;

    protected override void OnInitialized() {
        PlaceId = Context.GetModel<PlaceId>();
        Context.Title = L.Place_SettingsTitle;
        _submitButtonInfo = DialogButtonInfo.CreateSubmitButton(L.Common_Save, OnSubmit);
        Context.Buttons = [_submitButtonInfo];
    }

    protected override async Task OnInitializedAsync() {
        _form = Context.Items.KeylessGet<FormModel>();
        if (_form is not null)
            return;

        var place = await Places.Get(Session, PlaceId, default).Require();
        _form = new FormModel(ComponentIdGenerator) {
            Title = place.Title,
            Description = place.Description,
            Picture = place.Picture?.ToPicture(),
            Background = place.Background?.ToPicture(),
            ImageScope = @MediaUploadScopes.ForPlace(place.Id),
        };
        Context.Items.KeylessSet(_form);
    }

    protected override ComputedState<ComputedModel>.Options GetStateOptions()
        => ComputedStateComponent.GetStateOptions(GetType(),
            static t => new ComputedState<ComputedModel>.Options() {
                UpdateDelayer = FixedDelayer.NextTick,
                Category = GetStateCategory(t),
            });

    protected override async Task<ComputedModel> ComputeState(CancellationToken cancellationToken) {
        var placeId = PlaceId;
        var place = await Places.Get(Session, placeId, cancellationToken).ConfigureAwait(false);
        if (place == null || !place.Rules.CanEditProperties())
            return new() { Place = place };

        var allAuthorIds = await Places.ListAuthorIds(Session, place.Id, cancellationToken).ConfigureAwait(false);
        var enableIncompleteUI = await Hub.Features.IsIncompleteUIEnabled(cancellationToken).ConfigureAwait(false);
        var webHookCount = enableIncompleteUI
            ? (await Hub.WebHooks.List(Session, WebHookScope.Place, placeId.Value, cancellationToken)
                .ConfigureAwait(false)).Count
            : 0;

        return new() {
            Place = place,
            MemberCount = allAuthorIds.Length,
            IsOwner = place.Rules.IsOwner(),
            EnableIncompleteUI = enableIncompleteUI,
            WebHookCount = webHookCount,
        };
    }

    private void OnImagePicked(MediaRef mediaRef) {
        _form!.Picture = new (mediaRef);
        Context.Refresh();
    }

    private void OnBackgroundPicked(MediaRef mediaRef) {
        _form!.Background = new(mediaRef);
        Context.Refresh();
    }

    private void OnManagePlaceTypeClick()
        => Context.StepIn(DiveInDialogPage.New<PlaceSettingsEditTypeModalPage>(PlaceId));

    private void OnCopyChatClick()
        => Context.StepIn(DiveInDialogPage.New<PlaceSettingsCopyChatModalPage>(PlaceId));

    private void OnManageMembersClick()
        => Context.StepIn(DiveInDialogPage.New<PlaceSettingsEditMembersModalPage>(new PlaceSettingsEditMembersModalPage.Model(PlaceId)));

    private void OnIntegrationsClick()
        => Context.StepIn(DiveInDialogPage.New<PlaceIntegrationsModalPage>(PlaceId));

    private async Task OnSubmit() {
        if (_formRef == null)
            return;
        if (!_formRef.IsValid)
            return;
        await Save();
        Context.Close();
    }

    private async Task Save() {
        var place = await Places.Get(Session, PlaceId, default).Require();
        var newPlace = place with {
            Title = _form!.Title,
            Description = _form!.Description,
            MediaId = _form.Picture?.MediaRef?.MediaId,
            BackgroundMediaId = _form.Background?.MediaRef?.MediaId,
        };
        var command = new Places_Change {
            Session = Session,
            PlaceId = place.Id,
            ExpectedVersion = place.Version,
            Change = new() {
                Update = DiffEngine.Diff<Place, PlaceDiff>(place, newPlace),
            },
        };
        await UICommander.Run(command);
    }

    private void OnPlaceDeleteClick()
        => ChatUI.DeletePlace(
            PlaceId,
            () => {
                Context.Close();
                return Task.CompletedTask;
            });

    // Nested types

    [UnconditionalSuppressMessage("ReflectionAnalysis", "IL2026:RequiresUnreferencedCode", Justification = "String.Count should be preserved.")]
    public sealed class FormModel {
        [Required]
        public string Title { get; set; } = "";

        public string Description { get; set; } = "";
        public Picture? Picture { get; set; }
        public Picture? Background { get; set; }
        public string ImageScope { get; init; } = "";

        public string FormId { get; }
        public string TitleId { get; }
        public string DescriptionId { get; }
        public string PictureFormId { get; }
        public string BackgroundFormId { get; }

        public FormModel(ComponentIdGenerator componentIdGenerator) {
            FormId = componentIdGenerator.Next("edit-place-form");
            TitleId = $"{FormId}-title";
            DescriptionId = $"{FormId}-description";
            PictureFormId = $"{FormId}-picture";
            BackgroundFormId = $"{FormId}-background";
        }
    }

    public sealed record ComputedModel {
        public Place? Place { get; init; }
        public int MemberCount { get; init; }
        public bool IsOwner { get; init; }
        public bool EnableIncompleteUI { get; init; }
        public int WebHookCount { get; init; }
    }
}
