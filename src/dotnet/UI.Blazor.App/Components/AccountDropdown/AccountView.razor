@namespace ActualChat.UI.Blazor.App.Components
@inherits ComputedStateComponent<AppUIHub, AccountView.Model>
@{
    var m = State.Value;
    var account = m.Account;
}

<AvatarBadge
    Avatar="@account.Avatar"
    Size="@SquareSize.Size9"
    NameClass="hidden">
    <BadgeContent>
        <AccountPresenceIndicator UserId="@account?.Id" />
        @if (m.HasPermissionWarning) {
            <WarningBadge Class="c-permission-warning"/>
        }
    </BadgeContent>
</AvatarBadge>

@code {
    private PermissionsUI PermissionsUI => field ??= Hub.Services.GetRequiredService<PermissionsUI>();

    protected override ComputedState<Model>.Options GetStateOptions()
        => new() {
            InitialValue = new(AccountUI.OwnAccount.Value),
            Category = GetStateCategory(GetType()),
        };

    protected override async Task<Model> ComputeState(CancellationToken cancellationToken) {
        var account = await AccountUI.OwnAccount.Use(cancellationToken).ConfigureAwait(false);
        var permissions = await PermissionsUI.GetState(cancellationToken).ConfigureAwait(false);
        return new(account) {
            HasPermissionWarning = permissions is { HasMissing: true, IsWarningDismissed: false },
        };
    }

    // Nested types

    public sealed record Model(AccountFull Account) {
        public bool HasPermissionWarning { get; init; }
    }
}
