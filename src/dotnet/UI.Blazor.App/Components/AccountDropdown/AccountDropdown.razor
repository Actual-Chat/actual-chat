@namespace ActualChat.UI.Blazor.App.Components
@using ActualChat.UI.Blazor.Events
@inherits ComputedStateComponent<AppUIHub, AccountFull>
@{
    var account = State.Value;
    var floatingPlacement = NavbarPlacement switch {
        NavbarPlacement.Top => FloatingPosition.BottomEnd,
        NavbarPlacement.Bottom => FloatingPosition.TopEnd,
        _ => FloatingPosition.RightEnd,
    };
    if (!account.IsGuest) {
        <NavbarButton
            Class="settings-btn"
            ButtonClass="account-btn"
            IsRound="true"
            Tooltip="Settings"
            Click="@OnSettingsClick"
            data-bubble="@(BubbleRef.New<ManageAccountSettingsBubble>())"
            data-bubble-priority="205"
            data-bubble-placement="@(floatingPlacement.ToPositionString())">
            <ChildContent>
                <AccountView/>
            </ChildContent>
            <Ending>
                <LeftLine/>
                <div class="right-line"></div>
            </Ending>
        </NavbarButton>
    } else {
        <NavbarButton
            Class="settings-btn"
            ButtonClass="account-btn"
            IsRound="true"
            Tooltip="Sign in"
            data-menu="@(MenuRef.New<GuestAccountMenu>().ToString())"
            data-menu-trigger="@MenuTrigger.Primary"
            data-menu-placement="@(floatingPlacement.ToPositionString())">
            <ChildContent>
                <i class="icon-anonym text-2xl"></i>
            </ChildContent>
            <Ending>
                <LeftLine/>
                <div class="right-line"></div>
            </Ending>
        </NavbarButton>
    }
}

@code {
    [CascadingParameter] public NavbarPlacement NavbarPlacement { get; set; }

    protected override ComputedState<AccountFull>.Options GetStateOptions()
        => new() {
            InitialValue = AccountUI.OwnAccount.Value,
            Category = GetStateCategory(GetType()),
        };

    protected override Task<AccountFull> ComputeState(CancellationToken cancellationToken)
        => AccountUI.OwnAccount.Use(cancellationToken);

    private void OnSettingsClick()
        => _ = UIEventHub.Publish(new ShowSettingsEvent());
}
