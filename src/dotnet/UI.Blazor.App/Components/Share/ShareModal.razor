@namespace ActualChat.UI.Blazor.App.Components
@using ActualChat.Search
@inherits ComponentBase<AppUIHub>
@implements IModalView<ShareModalModel>
@{
    var canSend = HasSelectedItems;
    var cls = "share-modal fixed-height";
    if (_selectorKind == SelectorKind.Contact)
        cls += " share-modal-with-contact-selector";
    else if (_selectorKind == SelectorKind.Members)
        cls += " share-modal-with-member-selector";
}

<DialogFrame
    Class="@cls"
    HasCloseButton="true"
    Title="@(ModalModel.Title.NullIfEmpty() ?? L.Common_Share)"
    NarrowViewSettings="@DialogFrameNarrowViewSettings.Default">
    <Body>
    <FormBlock Class="with-contact-list">
        @if (_selectorKind == SelectorKind.Contact) {
            <ContactSelector
                @ref="@_contactSelectorRef"
                SearchQuery="_searchQuery"
                ChatListPreOrder="@ChatListPreOrder.ChatList"
                Changed="@StateHasChanged">
                <SearchBox
                    Placeholder="@L.Share_WhoToShareWith"
                    MaxLength="@Constants.Chat.MaxSearchFilterLength"
                    TextChanged="@OnFilter"/>
                <ContactSelectorPlacePicker/>
                <ContactSelectorListView/>
            </ContactSelector>
        }
        else if (_selectorKind == SelectorKind.Members) {
            <MemberSelector
                @ref="_memberSelectorRef"
                ListSource="@_memberListSource"
                SearchBoxPlaceholder="@L.Share_WhoToShareWith"
                Changed="@(() => StateHasChanged())" />
        }
    </FormBlock>
    </Body>
    <Footer>
        <EmbeddedMessageEditor
            Text="@_comment"
            IsTransparent="@true"
            Placeholder="@L.Share_AddComment"
            PlaceholderIcon="icon-message-ellipse"
            TextChanged="OnCommentChanged" />
    </Footer>
    <Buttons>
        @if (canSend) {
            <Button Class="btn-modal btn-primary btn-share-action" Click="OnSendClicked">
                <Icon><i class="icon-share text-2xl"></i></Icon>
                <Title>@L.Share_SendToSelected</Title>
            </Button>
        } else if (_mustShowActions) {
            <ShareActions Model="@ModalModel" Request="@RequestWithComment"/>
        }
    </Buttons>
</DialogFrame>


@code {
    private ContactSelector? _contactSelectorRef;
    private MemberSelector? _memberSelectorRef;
    private SearchQuery _searchQuery;
    private string _comment = "";
    private SelectorKind _selectorKind = SelectorKind.Contact;
    private IMemberListSource? _memberListSource;
    private bool _mustShowActions;

    private bool HasSelectedItems
        => (_contactSelectorRef?.SelectedChatIds.Value.Count
            ?? _memberSelectorRef?.SelectedUserIds.Value.Count ?? 0) > 0;
    private ShareRequest RequestWithComment => ModalModel.Request with { Text = _comment };

    private SendingMessages SendingMessages => Hub.SendingMessages;
    private AccountFull OwnAccount => Hub.AccountUI.OwnAccount.Value;

    [CascadingParameter] public Modal Modal { get; set; } = null!;
    [Parameter] public ShareModalModel ModalModel { get; set; } = null!;

    protected override void OnInitialized() {
        _comment = ModalModel.Request.Text;
        // A private place's invite is for its members only, so it has no business outside the app
        _mustShowActions = ModalModel.Request.HasLink()
            && ModalModel.SelectorPrefs is not ShareWithPlaceMembersOnly;
        if (ModalModel.SelectorPrefs is ShareWithPlaceMembersOnly selector) {
            _memberListSource = new PlaceMemberListSource(Hub, selector.PlaceId, [OwnAccount.Id]);
            _selectorKind = SelectorKind.Members;
        }
    }

    // Event handlers

    private void OnFilter(string filter) {
        _searchQuery = new SearchQuery(filter);
        StateHasChanged();
    }

    private async Task OnSendClicked() {
        var request = RequestWithComment;
        var text = request.GetShareTextAndLink(UrlMapper);
        IEnumerable<ChatId> selectedChatIds = ImmutableHashSet<ChatId>.Empty;
        if (_selectorKind == SelectorKind.Contact)
            selectedChatIds = _contactSelectorRef?.SelectedChatIds.Value ?? ImmutableHashSet<ChatId>.Empty;
        else if (_selectorKind == SelectorKind.Members) {
            var ownUserId = OwnAccount.Id;
            var selectedUserIds = _memberSelectorRef?.SelectedUserIds.Value ?? ImmutableHashSet<UserId>.Empty;
            selectedChatIds = selectedUserIds.Select(userId => PeerChatId.New(ownUserId, userId));
        }

        foreach (var chatId in selectedChatIds) {
            var sendRequest = SendMessageRequest.NewMessage(
                chatId, text,
                existingMedia: request.HasMedia() ? request.Media : null);
            _ = await SendingMessages.Send(sendRequest, CancellationToken.None);
        }
        Modal.Close(true);
    }

    private void OnCommentChanged(string text)
        => _comment = text;

    private enum SelectorKind { Contact, Members }
}
