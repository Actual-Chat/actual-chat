@using ActualChat.UI.Blazor.Module
@namespace ActualChat.UI.Blazor.App.Components
@inherits ComponentBase<AppUIHub>
@{
    var hasMedia = Request.HasMedia();
    var canShareExternally = MauiShare != null || (hasMedia ? _canShareFile : _canUseWebShare);
}
@if (!canShareExternally && (HideWhenCopyLink || hasMedia))
    return;

<div class="btn-share-action share-externally-button @Class">
    @if (MauiShare != null) {
        <Button Class="@ButtonClass" Click="OnMauiShareClick" IsDisabled="@_isSharing">
            <Icon>
                @if (_isSharing) {
                    <Spinner/>
                } else {
                    <i class="icon-share-external"></i>
                }
            </Icon>
            <Title>@(_isSharing ? L.Share_Preparing_Format(_percent) : Title ?? L.Share_ShareExternally)</Title>
        </Button>
    } else if (hasMedia) {
        <Button Class="@ButtonClass"
                data-share-title="@Request.Text"
                data-share-text="@Request.Text"
                >
            <Icon><i class="icon-share-external text-2xl"></i></Icon>
            <Title>@(Title ?? L.Share_ShareExternally)</Title>
        </Button>
        @* The files to share, picked up by share.ts on click *@
        @foreach (var media in Request.Media) {
            <span class="c-share-file"
                  hidden
                  data-url="@UrlMapper.ContentUrl(media.Ref.BlobId)"
                  data-file-name="@media.GetFileName()"
                  data-content-type="@media.ContentType"></span>
        }
    } else if (_canUseWebShare) {
        var textAndLink = Request.GetShareTextAndLink(UrlMapper);
        var link = Request.GetShareLink(UrlMapper);
        <Button Class="@ButtonClass"
                data-share-title="@Request.Text"
                data-share-text="@textAndLink"
                data-share-link="@link"
                >
            <Icon><i class="icon-share-external text-2xl"></i></Icon>
            <Title>@(Title ?? L.Share_ShareExternally)</Title>
        </Button>
    } else {
        var text = Request.HasAnyLink() ? L.MessageMenu_CopyLink : L.LogView_CopyToClipboard;
        <CopyTrigger Class="w-full" Tooltip="@L.Common_Copy" CopyText="@Request.GetShareTextAndLink(UrlMapper)">
            <Button Class="btn-modal">
                <Icon>
                    <i class="hide-on-copied-hint icon-copy text-xl" aria-hidden="true"></i>
                    <i class="copied-hint icon-checkmark-simple text-xl" aria-hidden="true"></i>
                </Icon>
                <Title>@text</Title>
            </Button>
        </CopyTrigger>
    }
</div>

@code {
    private bool _canUseWebShare;
    private bool _canShareFile;
    private bool _mustRegisterHandler;
    private bool _isSharing;
    private int _percent;

    private IMauiShare? MauiShare { get; set; }

    [Parameter] public string Class { get; set; } = "";
    [Parameter] public string ButtonClass { get; set; } = "btn-modal";
    [Parameter] public bool HideWhenCopyLink { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter, EditorRequired] public ShareRequest Request { get; set; } = null!;

    protected override async Task OnInitializedAsync() {
        MauiShare = Hub.Services.GetService<IMauiShare>();
        if (MauiShare != null) {
            // The file is what's shared, so it's fetched while the user is still picking
            if (Request.HasMedia())
                _ = MauiShare.Prefetch(Request);
            return;
        }

        var webShareInfo = Hub.Services.GetRequiredService<WebShareInfo>();
        _canUseWebShare = await webShareInfo.CanShare();
        _canShareFile = await webShareInfo.CanShareFile();
        _mustRegisterHandler = _canUseWebShare || _canShareFile;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        // Not `firstRender`: CanShare is async, so the button often appears on a later render.
        if (!_mustRegisterHandler)
            return;

        _mustRegisterHandler = false;
        await JS.InvokeVoidAsync($"{BlazorUICoreModule.ImportName}.Share.registerHandler");
    }

    private async Task OnMauiShareClick() {
        _isSharing = true;
        _percent = 0;
        var progress = new Progress<double>(x => _ = InvokeAsync(() => {
            var percent = (int)x;
            if (percent == _percent)
                return;

            _percent = percent;
            StateHasChanged();
        }));
        try {
            await MauiShare!.Share(Request, progress);
        }
        finally {
            _isSharing = false;
        }
    }
}
