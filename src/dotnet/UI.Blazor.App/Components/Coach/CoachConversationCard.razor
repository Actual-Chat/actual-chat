@namespace ActualChat.UI.Blazor.App.Components
@using ActualChat.UI.Blazor.App.Services
@using ActualChat.Users
@inherits ComponentBase<AppUIHub>
@{
    var c = Conversation;
    var minutes = Math.Max(1, (int)Math.Round(c.SpeechSeconds / 60));
    var when = DateFormatter.FormatTimestamp(
        DateTimeConverter.ToLocalTime(c.StartedAt),
        DateTimeConverter.ToLocalTime(Clocks.SystemClock.Now));
}

<Card Class="@("coach-conversation" + (c.IsExcluded ? " excluded" : ""))">
    <div class="c-head">
        <span class="c-title text-01">@Title</span>
        <span class="c-when">@when · @L.Coach_SpokeMinutes_Format(minutes)</span>
    </div>
    @if (c.IsExcluded) {
        <div class="c-excluded">@L.Coach_NotCounted</div>
    }
    else {
        @foreach (var f in Findings) {
            <div class="c-finding">
                <span class="c-dot band-@f.Band.ToString().ToLowerInvariant()"></span>
                <span>@Labels.Finding(c, f, IsWeeksBest)</span>
            </div>
        }
    }
    <div class="c-links">
        <a href="@Links.Chat(c.ChatId, c.StartEntryLid)">@L.Coach_MarkedTranscript</a>
        <a class="c-exclude" @onclick="@OnToggleExcluded">
            <i class="@(c.IsExcluded ? "icon-refresh" : "icon-close")"></i>
            @(c.IsExcluded ? L.Coach_CountAgain : L.Coach_DontCount)
        </a>
    </div>
</Card>

@code {
    [Parameter, EditorRequired] public CoachConversation Conversation { get; set; } = null!;
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public IReadOnlyList<CoachFinding> Findings { get; set; } = [];
    [Parameter] public bool IsWeeksBest { get; set; }

    private Task OnToggleExcluded()
        => UICommander.Run(new Coach_ExcludeConversation {
            Session = Session,
            ChatId = Conversation.ChatId,
            StartEntryLid = Conversation.StartEntryLid,
            Language = Conversation.Language,
            IsExcluded = !Conversation.IsExcluded,
        });

    private CoachLabels Labels => field ??= new CoachLabels(L);
}
