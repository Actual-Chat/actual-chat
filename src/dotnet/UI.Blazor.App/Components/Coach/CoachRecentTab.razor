@namespace ActualChat.UI.Blazor.App.Components
@using ActualChat.UI.Blazor.App.Services
@using ActualChat.Users
@inherits ComputedStateComponent<AppUIHub, CoachRecentTab.Model>
@{
    var m = State.Value;
}

<div class="coach-recent">
    @if (m.Language is not null) {
        <CoachRecentSkillSummary Deltas="@m.Deltas" Language="@m.Language" Summary="@m.ComparisonSummary"/>
    }
    @foreach (var c in m.Conversations) {
        var level = m.Settings.LevelOf(c.Language);
        var isBest = c.StartEntryLid == m.BestLid && c.ChatId == m.BestChatId;
        var focus = m.Settings.FocusByLanguage.TryGetValue(c.Language, out var chosen)
            ? chosen
            : (CoachMetricKind?)null;
        <CoachConversationCard
            @key="@(c.ChatId.Value + ":" + c.StartEntryLid)"
            Conversation="@c"
            Title="@m.Titles.GetValueOrDefault(c.ChatId, "")"
            Findings="@CoachFindings.Pick(c, focus, level, isBest)"
            IsWeeksBest="@isBest"/>
    }
</div>

@code {
    protected override ComputedState<Model>.Options GetStateOptions()
        => new() { InitialValue = Model.None, Category = GetStateCategory(GetType()) };

    protected override async Task<Model> ComputeState(CancellationToken cancellationToken) {
        var language = await Hub.CoachUI.GetSelectedLanguage(cancellationToken).ConfigureAwait(false);
        var conversations = await Hub.Coach
            .ListOwnConversations(Session, 20, language, cancellationToken)
            .ConfigureAwait(false);
        var comparisonLanguage = await Hub.CoachUI.GetComparisonLanguage(cancellationToken).ConfigureAwait(false);
        var deltas = await Hub.Coach
            .GetOwnWeekDeltas(Session, comparisonLanguage, cancellationToken).ConfigureAwait(false);
        var summary = await Hub.Coach
            .GetOwnSummary(Session, CoachWindow.Days7, comparisonLanguage, cancellationToken).ConfigureAwait(false);
        var settings = await Hub.UserSettingsUI.UserCoachSettings().Get(cancellationToken).ConfigureAwait(false);
        var titles = new Dictionary<ChatId, string>();
        foreach (var chatId in conversations.Select(c => c.ChatId).Distinct()) {
            var chat = await Hub.Chats.Get(Session, chatId, cancellationToken).ConfigureAwait(false);
            titles[chatId] = chat?.Title ?? "";
        }
        var weekAgo = Clocks.SystemClock.Now - TimeSpan.FromDays(7);
        var best = conversations
            .Where(c => !c.IsExcluded && c.StartedAt >= weekAgo && c.SpeechSeconds >= 60 && c.Words > 0)
            .OrderBy(c => (double)c.Fillers / c.Words)
            .FirstOrDefault();
        return new Model(
            conversations, titles, settings, best?.ChatId, best?.StartEntryLid ?? 0,
            comparisonLanguage, deltas, summary);
    }

    public sealed record Model(
        ApiArray<CoachConversation> Conversations,
        Dictionary<ChatId, string> Titles,
        UserCoachSettings Settings,
        ChatId? BestChatId,
        long BestLid,
        string? Language,
        ApiArray<CoachWeekDelta> Deltas,
        CoachSummary ComparisonSummary) {
        public static readonly Model None = new(
            ApiArray<CoachConversation>.Empty, new (), new UserCoachSettings(), null, 0,
            null, ApiArray<CoachWeekDelta>.Empty, CoachSummary.None);
    }
}
