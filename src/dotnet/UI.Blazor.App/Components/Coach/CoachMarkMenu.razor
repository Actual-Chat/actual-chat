@namespace ActualChat.UI.Blazor.App.Components
@using ActualChat.Chat
@inherits Menu<AppUIHub>
@{
    var hint = new CoachMarkHint(L).For(CoachMarkHint.FromArguments(Arguments));
    var replayPoint = CoachMarkHint.GetReplayPoint(Arguments);
}

<div class="coach-mark-menu">
    <div class="c-title">@hint.Title</div>
    <div class="c-body">@hint.Body</div>
    @if (hint.Synonyms.Count > 0) {
        <div class="c-synonyms">
            @foreach (var synonym in hint.Synonyms) {
                <span class="coach-chip">@synonym</span>
            }
        </div>
    }
</div>

@if (replayPoint is { } point) {
    <MenuEntry
        Icon="icon-play-fill"
        Text="@L.Coach_MarkPlayFromHere"
        Click="@(() => Hub.ChatAudioUI.StartReplay(point.ChatId, point.StartAt))">
    </MenuEntry>
}
