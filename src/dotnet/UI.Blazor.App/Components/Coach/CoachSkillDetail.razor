@namespace ActualChat.UI.Blazor.App.Components
@using ActualChat.Chat
@using ActualChat.Users
@inherits ComputedStateComponent<AppUIHub, CoachSkillDetail.Model>
@{
    var m = State.Value;
    var metric = m.Summary.Metrics.FirstOrDefault(x => x.Kind == Kind);
    var labels = Labels;
}

<div class="coach-skill-detail" data-metric="@Kind">
    @if (m.Word is { } word) {
        <CoachOccurrences Word="@word" Language="@m.Language" Kind="@Kind"
                          PeriodRange="@m.History.Range" Back="@OnWordBack"/>
    } else {
        <div class="c-head">
            <ButtonRound Click="@(() => Back.InvokeAsync())" Class="btn-sm" Title="@L.Common_Back">
                <i class="icon-arrow-left text-2xl" aria-hidden="true"></i>
            </ButtonRound>
            <h2>@labels.MetricTitle(Kind)</h2>
        </div>
        <div class="c-scope">@(m.Language is null ? L.Coach_AllLanguages : labels.LanguageName(m.Language))</div>
        <div class="c-periods">
            @foreach (var period in Enum.GetValues<CoachHistoryPeriod>()) {
                <button type="button" class="chip @(period == m.Selection.Period ? "on" : "")"
                        aria-pressed="@(period == m.Selection.Period)" @onclick="@(() => OnPeriod(period))">
                    @PeriodLabel(period)
                </button>
            }
        </div>
        <div class="c-calendar">
            <ButtonRound Click="@(() => OnMove(-1))" Class="btn-sm" Title="@L.Coach_PreviousPeriod">
                <i class="icon-arrow-left" aria-hidden="true"></i>
            </ButtonRound>
            <span>@PeriodDates(m.History.Range) · UTC</span>
            <ButtonRound Click="@(() => OnMove(1))" Class="btn-sm" Title="@L.Coach_NextPeriod"
                         IsDisabled="@(!m.CanMoveForward)">
                <i class="icon-arrow-right" aria-hidden="true"></i>
            </ButtonRound>
        </div>
        <Card Class="c-overview">
            <div class="c-value">@(metric?.Value is null ? L.Coach_NotEnoughSpeech : labels.Value(metric))</div>
            @if (metric?.Rate is not null) {
                <div class="c-rate">@labels.Rate(metric)</div>
            }
            @if (Kind is CoachMetricKind.Fillers or CoachMetricKind.WeakWords) {
                @if (m.Summary.TaggedWords > 0) {
                    <div class="c-coverage">@L.Coach_DetailCount_Format(metric?.Value ?? 0, m.Summary.TaggedWords)</div>
                }
                <div class="c-explanation">@labels.Explain(Kind, m.Language, m.Summary)</div>
            } else {
                <div class="c-explanation">@L.Coach_PaceDetailExplanation</div>
            }
        </Card>
        <Card Class="c-history">
            <h3>@L.Coach_SpeakingDays</h3>
            @if (m.History.MinimumWords > 0) {
                <div class="c-coverage">@L.Coach_HistoryMinimumWords_Format(m.History.MinimumWords)</div>
            }
            @if (m.History.Value is { } value) {
                <div class="c-history-value">@HistoryValue(value)</div>
                @if (Kind == CoachMetricKind.Pace) {
                    <div class="c-coverage">@L.Coach_SegmentPace</div>
                }
                <div class="c-coverage">@L.Coach_Words(m.History.MeasuredWords, m.History.MeasuredWords)</div>
            }
            @if (m.History.Days.Count == 0) {
                <div class="c-coverage">@L.Coach_NotEnoughSpeech · @L.Coach_HistorySparse</div>
            } else {
                <div class="c-chart">
                    <BarChart Items="@HistoryItems(m)" ShowValues="true" ShowZeroValues="true"
                              ValueFormat="0.#" ItemClick="@OnDay" Class="c-speaking-chart"/>
                </div>
                <div class="c-coverage">@L.Coach_HistoryDates</div>
            }
        </Card>
        @if (Kind is CoachMetricKind.Fillers or CoachMetricKind.WeakWords) {
            <Card Class="c-words">
                @if (m.Words.Count == 0) {
                    <div>@L.Coach_OccurrencesEmpty</div>
                } else {
                    @foreach (var chip in m.Words) {
                        <button type="button" class="btn-word-detail" @onclick="@(() => OnWord(chip.Word))">
                            <span>@chip.Word</span>
                            <span>@chip.Count</span>
                        </button>
                    }
                }
            </Card>
        } else if (m.Pace.Summary is { } coverage) {
            <Card Class="c-distribution">
                <div>@L.Coach_ComfortableRange_Format(m.Pace.Slow, m.Pace.Fast)</div>
                @if (m.Pace.Distribution.WithinRate is { } rate) {
                    <div class="c-value">@L.Coach_Percent_Format((100 * rate).ToString("0.#", null))</div>
                    <BarChart Items="@DistributionItems(m.Pace)" ShowValues="true" ValueFormat="0.#"/>
                    <div class="c-ranges">
                        <span>@L.Coach_PaceBelow · @Percent(m.Pace.Distribution.BelowMilliseconds, m.Pace)</span>
                        <span>@L.Coach_PaceWithin · @Percent(m.Pace.Distribution.WithinMilliseconds, m.Pace)</span>
                        <span>@L.Coach_PaceAbove · @Percent(m.Pace.Distribution.AboveMilliseconds, m.Pace)</span>
                    </div>
                } else {
                    <div>@L.Coach_PaceUnavailable</div>
                }
                <div class="c-coverage">@L.Coach_PaceCoverage_Format(coverage.MeasuredEntries,
                    Percent(m.Pace.Distribution.TotalMilliseconds, coverage.AudioMilliseconds))</div>
                @if (m.Pace.IsTruncated) {
                    <div class="c-coverage">@L.Coach_PacePartial</div>
                }
            </Card>
            @if (m.Pace.Moments.Count == ICoach.MaxOccurrences) {
                <div class="c-coverage">@L.Coach_OccurrencesLimit_Format(ICoach.MaxOccurrences)</div>
            }
            @foreach (var item in m.Moments) {
                <Card Class="c-moment">
                    <div class="c-moment-head">
                        <span>@item.ChatTitle</span>
                        <span>@L.Coach_Wpm_Format(Math.Round(item.Moment.Segment.WordsPerMinute))</span>
                    </div>
                    <div class="c-coverage">
                        @DateTimeConverter.ToLocalTime(item.Moment.Occurrence.At).ToString("g", DateFormatter)
                        · @CoachLabels.Clock(item.Moment.Segment.TimeRange.Start / 1_000d)–@CoachLabels.Clock(
                            item.Moment.Segment.TimeRange.End / 1_000d)
                    </div>
                    <p>@item.Text</p>
                    <Button Click="@(() => OnMoment(item))" Class="btn-text btn-open-occurrence">
                        @(item.CanReplay ? L.MessageMenu_Play : L.Content_GoToMessage)
                    </Button>
                </Card>
            }
        } else {
            <Card Class="c-distribution">
                <div>@L.Coach_PaceUnavailable</div>
                @if (m.Pace.IsTruncated) {
                    <div class="c-coverage">@L.Coach_PacePartial</div>
                }
            </Card>
        }
    }
</div>

@code {
    [Parameter] public CoachMetricKind Kind { get; set; }
    [Parameter] public CoachWindow Window { get; set; }
    [Parameter] public string? Language { get; set; }
    [Parameter] public EventCallback Back { get; set; }

    private MutableState<string?> _word = null!;
    private MutableState<Selection> _selection = null!;
    private CoachLabels Labels => field ??= new CoachLabels(L);

    protected override void OnInitialized() {
        _word = StateFactory.NewMutable((string?)null);
        var period = Window is CoachWindow.Days30 or CoachWindow.Month or CoachWindow.AllTime
            ? CoachHistoryPeriod.Month
            : CoachHistoryPeriod.Week;
        _selection = StateFactory.NewMutable(new Selection(period,
            UsageDay.DayOf(Clocks.SystemClock.Now)));
    }

    protected override ComputedState<Model>.Options GetStateOptions()
        => new() { InitialValue = Model.None, Category = GetStateCategory(GetType()) };

    protected override async Task<Model> ComputeState(CancellationToken cancellationToken) {
        var kind = Kind;
        var language = Language;
        var wordState = _word;
        var selectionState = _selection;
        var now = Clocks.SystemClock.Now;
        await ThreadPoolExt.Yield();
        language ??= await Hub.CoachUI.GetComparisonLanguage(cancellationToken).ConfigureAwait(false);
        var word = await wordState.Use(cancellationToken).ConfigureAwait(false);
        var selection = await selectionState.Use(cancellationToken).ConfigureAwait(false);
        var history = await Hub.Coach.GetOwnSkillHistory(Session, kind, language,
            selection.Period, selection.Anchor, cancellationToken).ConfigureAwait(false);
        var pace = history.Pace;
        var moments = new List<MomentItem>();
        foreach (var moment in pace.Moments) {
            var occurrence = moment.Occurrence;
            var chat = await Hub.Chats.Get(Session, occurrence.ChatId, cancellationToken).ConfigureAwait(false);
            var id = ChatEntryId.New(occurrence.ChatId, occurrence.EntryLid);
            var entry = await Hub.ChatUI.GetEntry(id, cancellationToken).ConfigureAwait(false);
            var textRange = moment.Segment.TextRange;
            if (chat is null || entry is null || entry.IsRemoved || textRange.End > entry.Content.Length)
                continue;

            var map = entry.Audio?.TimeMap;
            var canReplay = map?.TryMap(textRange.Start) is { } start
                && Math.Abs(start * 1_000 - moment.Segment.TimeRange.Start) < 1
                && map?.TryMap(textRange.End) is { } end
                && Math.Abs(end * 1_000 - moment.Segment.TimeRange.End) < 1;
            moments.Add(new MomentItem(moment, chat.Title,
                entry.Content.Substring(textRange.Start, textRange.End - textRange.Start), canReplay));
        }
        var canMoveForward = CoachHistoryRanges.Move(selection.Period, selection.Anchor, 1) <= now;
        return new Model(language, word, selection, history, moments, canMoveForward);
    }

    private void OnPeriod(CoachHistoryPeriod period) {
        var selection = _selection.Value;
        var now = Clocks.SystemClock.Now;
        var isCurrent = CoachHistoryRanges.Start(selection.Period, selection.Anchor)
            == CoachHistoryRanges.Start(selection.Period, now);
        var anchor = isCurrent ? UsageDay.DayOf(now) : selection.Anchor;
        _selection.Value = new Selection(period, anchor);
    }

    private void OnMove(int offset) {
        var selection = _selection.Value;
        var anchor = CoachHistoryRanges.Move(selection.Period, selection.Anchor, offset);
        if (anchor <= Clocks.SystemClock.Now)
            _selection.Value = selection with { Anchor = anchor };
    }

    private void OnDay(ChartItem item) {
        var m = State.Value;
        var index = HistoryItems(m).ToList().IndexOf(item);
        if (index >= 0)
            _selection.Value = new Selection(CoachHistoryPeriod.Day, m.History.Days[index].Day);
    }

    private string PeriodLabel(CoachHistoryPeriod period)
        => period switch {
            CoachHistoryPeriod.Day => L.Coach_CalendarDay,
            CoachHistoryPeriod.Week => L.Coach_CalendarWeek,
            _ => L.Coach_CalendarMonth,
        };

    private string PeriodDates(Range<Moment> range) {
        var end = range.End > range.Start ? range.End - TimeSpan.FromTicks(1) : range.Start;
        return range.Start.ToDateTime().ToString("d MMM yyyy", DateFormatter)
            + " – " + end.ToDateTime().ToString("d MMM yyyy", DateFormatter);
    }

    private string HistoryValue(double value)
        => Kind == CoachMetricKind.Pace
            ? L.Coach_Wpm_Format(value.ToString("0.#", null))
            : L.Coach_Percent_Format((100 * value).ToString("0.#", null));

    private IReadOnlyList<ChartItem> HistoryItems(Model m)
        => m.History.Days.Select(day => {
            var date = day.Day.ToDateTime().ToString("d MMM", DateFormatter);
            var hint = day.Day.ToDateTime().ToString("d MMM yyyy", DateFormatter) + " · " + HistoryValue(day.Value);
            if (day.GapDays > 0)
                hint += " · " + L.Coach_HistoryGap_Format(day.GapDays);

            return new ChartItem(date, Kind == CoachMetricKind.Pace ? day.Value : day.Value * 100,
                "text-primary", hint, day.GapDays > 0);
        }).ToList();

    private void OnWord(string word)
        => _word.Value = word;

    private void OnWordBack()
        => _word.Value = null;

    private Task OnMoment(MomentItem item)
        => item.CanReplay
            ? Hub.CoachUI.JumpTo(item.Moment, CancellationToken.None)
            : Hub.CoachUI.JumpTo(item.Moment.Occurrence, CancellationToken.None, play: false);

    private string Percent(long milliseconds, CoachPaceDetails pace)
        => Percent(milliseconds, pace.Distribution.TotalMilliseconds);

    private string Percent(long milliseconds, long total)
        => L.Coach_Percent_Format((total > 0 ? 100d * milliseconds / total : 0).ToString("0.#", null));

    private IReadOnlyList<ChartItem> DistributionItems(CoachPaceDetails pace)
        => [
            new ChartItem(L.Coach_PaceBelow, 100d * pace.Distribution.BelowMilliseconds
                / pace.Distribution.TotalMilliseconds, "text-03"),
            new ChartItem(L.Coach_PaceWithin, 100d * pace.Distribution.WithinMilliseconds
                / pace.Distribution.TotalMilliseconds, "text-success"),
            new ChartItem(L.Coach_PaceAbove, 100d * pace.Distribution.AboveMilliseconds
                / pace.Distribution.TotalMilliseconds, "text-warning"),
        ];

    public sealed record MomentItem(CoachPaceMoment Moment, string ChatTitle, string Text, bool CanReplay);

    public sealed record Selection(CoachHistoryPeriod Period, Moment Anchor);

    public sealed record Model(
        string? Language, string? Word, Selection Selection, CoachSkillHistory History,
        List<MomentItem> Moments, bool CanMoveForward) {
        public static readonly Model None = new(null, null,
            new Selection(CoachHistoryPeriod.Week, Moment.EpochStart), CoachSkillHistory.None, [], false);

        public CoachSummary Summary => History.Summary;
        public CoachPaceDetails Pace => History.Pace;
        public ApiArray<CoachChip> Words => History.Words;
    }
}
