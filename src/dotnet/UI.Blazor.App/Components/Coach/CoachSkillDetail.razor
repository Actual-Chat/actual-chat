@namespace ActualChat.UI.Blazor.App.Components
@using ActualChat.Chat
@using ActualChat.Users
@inherits ComputedStateComponent<AppUIHub, CoachSkillDetail.Model>
@{
    var m = State.Value;
    var metric = m.Summary.Metrics.FirstOrDefault(x => x.Kind == Kind);
    var labels = Labels;
    var paceValue = m.History.Value ?? (m.History.MeasuredWords > 0 && m.History.MeasuredSeconds > 0
        ? 60d * m.History.MeasuredWords / m.History.MeasuredSeconds : (double?)null);
    var hasSmallSample = m.History.MeasuredWords > 0 && m.History.MeasuredWords < m.History.MinimumWords;
    var largestWordCount = m.Words.Count > 0 ? Math.Max(1, m.Words.Max(x => x.Count)) : 1;
}

<div class="coach-skill-detail" data-metric="@Kind">
    @if (m.Word is { } word) {
        <CoachOccurrences Word="@word" Language="@m.Language" Kind="@Kind"
                          PeriodRange="@m.History.Range" Back="@OnWordBack"/>
    } else {
        <div class="c-head">
            <ButtonRound Click="@(() => Back.InvokeAsync())" Class="btn-sm" Title="@L.Common_Back">
                <i class="icon-arrow-left text-2xl" aria-hidden="true"></i>
            </ButtonRound>
            <h2>@labels.MetricTitle(Kind)</h2>
        </div>
        <div class="c-scope">@(m.Language is null ? L.Coach_AllLanguages : labels.LanguageName(m.Language))</div>
        <div class="c-periods">
            @foreach (var period in Enum.GetValues<CoachHistoryPeriod>()) {
                <button type="button" class="chip @(period == m.Selection.Period ? "on" : "")"
                        aria-pressed="@(period == m.Selection.Period)" @onclick="@(() => OnPeriod(period))">
                    @PeriodLabel(period)
                </button>
            }
        </div>
        <div class="c-calendar">
            <ButtonRound Click="@(() => OnMove(-1))" Class="btn-sm" Title="@L.Coach_PreviousPeriod">
                <i class="icon-arrow-left" aria-hidden="true"></i>
            </ButtonRound>
            <span>@PeriodDates(m.SelectedRange) · UTC</span>
            <ButtonRound Click="@(() => OnMove(1))" Class="btn-sm" Title="@L.Coach_NextPeriod"
                         IsDisabled="@(!m.CanMoveForward)">
                <i class="icon-arrow-right" aria-hidden="true"></i>
            </ButtonRound>
        </div>
        @if (m.IsBaselineMode && m.Comparison.Baseline is { } reference) {
            <div class="c-coverage">@L.Coach_SinceBaseline_Format(
                reference.CapturedAt.ToDateTime().ToString("d MMM yyyy HH:mm:ss", DateFormatter))</div>
            <div class="c-baseline-change @CoachLabels.DeltaClass(m.Delta)">@labels.RecentDeltaBadge(m.Delta)</div>
            @if (m.Comparison.OmittedSeconds > 0) {
                <div class="c-coverage">@L.Coach_BaselineOmitted_Format(
                    m.Comparison.OmittedSeconds.ToString("0.#", null))</div>
            }
        }
        @if (Kind is CoachMetricKind.Fillers or CoachMetricKind.WeakWords) {
            <Card Class="c-words">
                @if (m.Words.Count == 0) {
                    <div>@L.Coach_OccurrencesEmpty</div>
                } else {
                    @foreach (var chip in m.Words) {
                        <button type="button" class="btn-word-detail" @onclick="@(() => OnWord(chip.Word))">
                            <span class="c-word-bar" aria-hidden="true"
                                  style="width: @((100d * chip.Count / largestWordCount).ToString("0.####", null))%">
                            </span>
                            <span class="c-word-label">@chip.Word</span>
                            <span class="c-word-count">@chip.Count</span>
                        </button>
                    }
                }
            </Card>
        } else if (m.Pace.Summary is { } coverage) {
            <Card Class="c-distribution">
                <div>@L.Coach_ComfortableRange_Format(m.Pace.Slow, m.Pace.Fast)</div>
                @if (m.Pace.Distribution.WithinRate is not null) {
                    <div class="c-distribution-explanation">@L.Coach_PaceDistributionExplanation</div>
                    <HistogramChart Bins="@coverage.Durations" BinWidth="@coverage.BinWidth"
                                    TargetRange="@PaceTargetRange(m.Pace)" XUnit="@L.Coach_Wpm_Format("")"
                                    MaximumValue="@m.Pace.Distribution.TotalMilliseconds"
                                    ValueLabel="@(x => L.Coach_Percent_Format(
                                        (100 * x / m.Pace.Distribution.TotalMilliseconds).ToString("0.#", null)))"
                                    BinHint="@((bin, duration) => PaceBinHint(
                                        bin, duration, coverage.BinWidth, m.Pace.Distribution.TotalMilliseconds))"/>
                    <div class="c-ranges c-distribution-ranges">
                        <div>
                            <span>@L.Coach_PaceBelow · @Percent(m.Pace.Distribution.BelowMilliseconds, m.Pace)</span>
                            <span>@L.Coach_Wpm_Format("< " + m.Pace.Slow.ToString("0.#", null))</span>
                            <span>@DistributionDuration(m.Pace.Distribution.BelowMilliseconds)</span>
                        </div>
                        <div>
                            <span>@L.Coach_PaceWithin · @Percent(m.Pace.Distribution.WithinMilliseconds, m.Pace)</span>
                            <span>@L.Coach_Wpm_Format(m.Pace.Slow + "–" + m.Pace.Fast)</span>
                            <span>@DistributionDuration(m.Pace.Distribution.WithinMilliseconds)</span>
                        </div>
                        <div>
                            <span>@L.Coach_PaceAbove · @Percent(m.Pace.Distribution.AboveMilliseconds, m.Pace)</span>
                            <span>@L.Coach_Wpm_Format("> " + m.Pace.Fast.ToString("0.#", null))</span>
                            <span>@DistributionDuration(m.Pace.Distribution.AboveMilliseconds)</span>
                        </div>
                    </div>
                } else {
                    <div>@L.Coach_PaceUnavailable</div>
                }
                <div class="c-coverage">@L.Coach_PaceCoverage_Format(coverage.MeasuredEntries,
                    Percent(m.Pace.Distribution.TotalMilliseconds, coverage.AudioMilliseconds))</div>
                @if (m.Pace.IsTruncated) {
                    <div class="c-coverage">@L.Coach_PacePartial</div>
                }
            </Card>
        } else {
            <Card Class="c-distribution">
                <div>@L.Coach_PaceUnavailable</div>
                @if (m.Pace.IsTruncated) {
                    <div class="c-coverage">@L.Coach_PacePartial</div>
                }
            </Card>
        }
        <Card Class="c-overview">
            <div class="c-value">@(Kind == CoachMetricKind.Pace
                ? paceValue is { } current ? HistoryValue(current) : L.Coach_PaceUnavailable
                : m.IsBaselineMode
                    ? (m.History.Value ?? metric?.Rate) is { } rate ? HistoryValue(rate) : L.Coach_NotEnoughSpeech
                    : m.History.MeasuredWords == 0 || metric?.Value is null
                        ? L.Coach_NotEnoughSpeech : labels.Value(metric))</div>
            @if (hasSmallSample) {
                <div class="c-provisional">@L.Coach_ProvisionalResult</div>
                <div class="c-sample-progress">@SampleProgress(m.History)</div>
            }
            @if (Kind == CoachMetricKind.Pace && m.History.MeasuredWords > 0) {
                <div class="c-coverage">@L.Coach_Words(m.History.MeasuredWords, m.History.MeasuredWords)</div>
            }
            @if (metric?.Rate is not null) {
                <div class="c-rate">@labels.Rate(metric)</div>
            }
            @if (Kind is CoachMetricKind.Fillers or CoachMetricKind.WeakWords) {
                @if (m.Summary.TaggedWords > 0) {
                    <div class="c-coverage">@L.Coach_DetailCount_Format(metric?.Value ?? 0, m.Summary.TaggedWords)</div>
                }
                @if (metric?.Chips.Count > 0) {
                    <div class="c-explanation">@labels.Explain(Kind, m.Language, m.Summary)</div>
                }
            } else {
                <div class="c-explanation">@L.Coach_PaceDetailExplanation</div>
            }
        </Card>
        <Card Class="c-history">
            <h3>@L.Coach_SpeakingDays</h3>
            @if (m.History.MinimumWords > 0) {
                <div class="c-coverage">@L.Coach_HistoryMinimumWords_Format(m.History.MinimumWords)</div>
            }
            @if (m.History.MeasuredWords > 0) {
                <div class="c-coverage">@L.Coach_Words(m.History.MeasuredWords, m.History.MeasuredWords)</div>
            }
            @if (m.History.Value is { } value) {
                <div class="c-history-value">@HistoryValue(value)</div>
                @if (Kind == CoachMetricKind.Pace) {
                    <div class="c-coverage">@L.Coach_SegmentPace</div>
                }
            }
            @if (m.History.Days.Count == 0) {
                <div class="c-coverage">
                    @if (Kind == CoachMetricKind.Pace && m.Pace.Summary is null) {
                        @L.Coach_PaceUnavailable
                    } else {
                        @if (m.Selection.Period == CoachHistoryPeriod.Day && hasSmallSample) {
                            @SampleProgress(m.History)
                        } else {
                            @L.Coach_NotEnoughSpeech <span>· @L.Coach_HistorySparse</span>
                        }
                    }
                </div>
            }
            @if (m.History.Days.Count > 0 || Kind == CoachMetricKind.Pace && PaceTargetRange(m.Pace) is not null) {
                <div class="c-chart">
                    @if (Kind == CoachMetricKind.Pace) {
                        <LineChart Items="@HistoryItems(m)" ItemClick="@OnDay" Class="c-pace-chart" ScaleStep="50"
                                   TargetRange="@PaceTargetRange(m.Pace)" ReferenceValue="@BaselineChartValue(m)"/>
                        @if (PaceTargetRange(m.Pace) is not null) {
                            <div class="c-range-legend c-coverage">
                                <span class="c-target-key" aria-hidden="true"></span>
                                @L.Coach_ComfortableRange_Format(m.Pace.Slow, m.Pace.Fast)
                            </div>
                        }
                    } else {
                        <BarChart Items="@HistoryItems(m)" ShowValues="true" ShowZeroValues="true"
                                  ValueFormat="0.#" ItemClick="@OnDay" Class="c-speaking-chart"
                                  ReferenceValue="@BaselineChartValue(m)" Maximum="@BaselineChartValue(m)"/>
                    }
                    @if (m.Comparison.Baseline is { InvalidatedAt: null, MeasurementVersion: 1 } chartBaseline) {
                        <div class="c-range-legend c-coverage">
                            <span class="c-baseline-key" aria-hidden="true"></span>
                            @L.Coach_PersonalBaseline · @PeriodDates(chartBaseline.SourceRange)
                            · @HistoryValue(chartBaseline.Value)
                        </div>
                    }
                </div>
                <div class="c-coverage">@L.Coach_HistoryDates</div>
            }
        </Card>
        <Card Class="c-baseline">
            <h3>@L.Coach_PersonalBaseline</h3>
            <div class="c-coverage">@L.Coach_BaselineReference</div>
            @if (m.Comparison.Baseline is { } baseline) {
                <div>@PeriodDates(baseline.SourceRange) · @HistoryValue(baseline.Value)</div>
                <div class="c-coverage">@L.Coach_Words(baseline.History.MeasuredWords,
                    baseline.History.MeasuredWords)</div>
                <div class="c-coverage">@L.Coach_SpeakingDays · @baseline.History.SpeakingDays
                    · @L.Coach_Seconds_Format(baseline.History.MeasuredSeconds.ToString("0.#", null))</div>
                @if (baseline.OmittedSeconds > 0) {
                    <div class="c-coverage">@L.Coach_BaselineOmitted_Format(
                        baseline.OmittedSeconds.ToString("0.#", null))</div>
                }
                @if (baseline.InvalidatedAt is not null || baseline.MeasurementVersion != 1) {
                    <div class="c-coverage">@L.Coach_BaselineInvalid</div>
                } else {
                    <button type="button" class="chip @(m.BaselineSelection.IsEnabled ? "on" : "")"
                            aria-pressed="@m.BaselineSelection.IsEnabled" @onclick="@OnBaselineMode">
                        @L.Coach_CompareBaseline
                    </button>
                }
                @if (m.Comparison.HasRangeChanged) {
                    <div class="c-coverage">@L.Coach_BaselineRangeChanged</div>
                }
                <Button Click="@(() => OnSaveBaseline(mustClear: true))" Class="btn-text btn-clear-baseline">
                    @L.Common_Clear
                </Button>
            }
            @if (m.BaselineSelection.IsPreview) {
                <div>@PeriodDates(m.History.Range) · @(m.History.Value is { } preview
                    ? HistoryValue(preview) : L.Coach_NotEnoughSpeech)</div>
                <div class="c-coverage">@L.Coach_Words(m.History.MeasuredWords, m.History.MeasuredWords)</div>
                <div class="c-coverage">@L.Coach_SpeakingDays · @m.History.SpeakingDays
                    · @L.Coach_Seconds_Format(m.History.MeasuredSeconds.ToString("0.#", null))</div>
                <Button Click="@(() => OnSaveBaseline())" Class="btn-primary btn-save-baseline"
                        IsDisabled="@(!m.CanSaveBaseline)">@L.Common_Save</Button>
                <Button Click="@OnCancelBaseline" Class="btn-text">@L.Common_Cancel</Button>
            } else {
                @if (!m.CanSaveBaseline && m.History.MinimumWords > 0 && !m.IsBaselineMode) {
                    <div class="c-sample-progress">@SampleProgress(m.History)</div>
                }
                <Button Click="@OnPreviewBaseline" Class="btn-text btn-preview-baseline"
                        IsDisabled="@(!m.CanSaveBaseline)">
                    @(m.Comparison.Baseline is null ? L.Coach_UseMeasurements : L.Coach_ReplaceBaseline)
                </Button>
            }
        </Card>
        @if (Kind == CoachMetricKind.Pace && m.Pace.Summary is not null) {
            @if (m.Pace.Moments.Count == ICoach.MaxOccurrences) {
                <div class="c-coverage">@L.Coach_OccurrencesLimit_Format(ICoach.MaxOccurrences)</div>
            }
            @foreach (var item in m.Moments) {
                <Card Class="c-moment">
                    <div class="c-moment-head">
                        <span>@item.ChatTitle</span>
                        <span>@L.Coach_Wpm_Format(Math.Round(item.Moment.Segment.WordsPerMinute))</span>
                    </div>
                    <div class="c-coverage">
                        @DateTimeConverter.ToLocalTime(item.Moment.Occurrence.At).ToString("g", DateFormatter)
                        · @CoachLabels.Clock(item.Moment.Segment.TimeRange.Start / 1_000d)–@CoachLabels.Clock(
                            item.Moment.Segment.TimeRange.End / 1_000d)
                    </div>
                    <p>@item.Text</p>
                    <Button Click="@(() => OnMoment(item))" Class="btn-text btn-open-occurrence">
                        @(item.CanReplay ? L.MessageMenu_Play : L.Content_GoToMessage)
                    </Button>
                </Card>
            }
        }

    }
</div>

@code {
    [Parameter] public CoachMetricKind Kind { get; set; }
    [Parameter] public CoachWindow Window { get; set; }
    [Parameter] public string? Language { get; set; }
    [Parameter] public EventCallback Back { get; set; }

    private MutableState<string?> _word = null!;
    private MutableState<Selection> _selection = null!;
    private MutableState<BaselineSelection> _baselineSelection = null!;
    private CoachLabels Labels => field ??= new CoachLabels(L);

    protected override void OnInitialized() {
        _word = StateFactory.NewMutable((string?)null);
        _baselineSelection = StateFactory.NewMutable(new BaselineSelection(true, false));
        var period = Window is CoachWindow.Days30 or CoachWindow.Month or CoachWindow.AllTime
            ? CoachHistoryPeriod.Month
            : CoachHistoryPeriod.Week;
        _selection = StateFactory.NewMutable(new Selection(period,
            UsageDay.DayOf(Clocks.SystemClock.Now)));
    }

    protected override ComputedState<Model>.Options GetStateOptions()
        => new() { InitialValue = Model.None, Category = GetStateCategory(GetType()) };

    protected override async Task<Model> ComputeState(CancellationToken cancellationToken) {
        var kind = Kind;
        var language = Language;
        var wordState = _word;
        var selectionState = _selection;
        var baselineState = _baselineSelection;
        var now = Clocks.SystemClock.Now;
        await ThreadPoolExt.Yield();
        language ??= await Hub.CoachUI.GetComparisonLanguage(cancellationToken).ConfigureAwait(false);
        var word = await wordState.Use(cancellationToken).ConfigureAwait(false);
        var selection = await selectionState.Use(cancellationToken).ConfigureAwait(false);
        var baselineSelection = await baselineState.Use(cancellationToken).ConfigureAwait(false);
        var historyTask = Hub.Coach.GetOwnSkillHistory(Session, kind, language,
            selection.Period, selection.Anchor, cancellationToken);
        var comparisonTask = Hub.Coach.GetOwnBaselineComparison(Session, kind, language,
            selection.Period, selection.Anchor, cancellationToken);
        var history = await historyTask.ConfigureAwait(false);
        var comparison = await comparisonTask.ConfigureAwait(false);
        var selectedRange = history.Range;
        var canSaveBaseline = history.Value is not null;
        var isBaselineMode = baselineSelection.IsEnabled && !baselineSelection.IsPreview
            && comparison.Baseline is { InvalidatedAt: null, MeasurementVersion: 1 };
        if (isBaselineMode)
            history = comparison.History;

        var pace = history.Pace;
        var moments = new List<MomentItem>();
        foreach (var moment in pace.Moments) {
            var occurrence = moment.Occurrence;
            var chat = await Hub.Chats.Get(Session, occurrence.ChatId, cancellationToken).ConfigureAwait(false);
            var id = ChatEntryId.New(occurrence.ChatId, occurrence.EntryLid);
            var entry = await Hub.ChatUI.GetEntry(id, cancellationToken).ConfigureAwait(false);
            var textRange = moment.Segment.TextRange;
            if (chat is null || entry is null || entry.IsRemoved || textRange.End > entry.Content.Length)
                continue;

            var map = entry.Audio?.TimeMap;
            var canReplay = map?.TryMap(textRange.Start) is { } start
                && Math.Abs(start * 1_000 - moment.Segment.TimeRange.Start) < 1
                && map?.TryMap(textRange.End) is { } end
                && Math.Abs(end * 1_000 - moment.Segment.TimeRange.End) < 1;
            moments.Add(new MomentItem(moment, chat.Title,
                entry.Content.Substring(textRange.Start, textRange.End - textRange.Start), canReplay));
        }
        var canMoveForward = CoachHistoryRanges.Move(selection.Period, selection.Anchor, 1) <= now;
        return new Model(language, word, selection, history, moments, canMoveForward,
            comparison, baselineSelection, selectedRange, canSaveBaseline, isBaselineMode);
    }

    private void OnPreviewBaseline()
        => _baselineSelection.Value = new BaselineSelection(false, true);

    private void OnCancelBaseline()
        => _baselineSelection.Value = new BaselineSelection(true, false);

    private void OnBaselineMode()
        => _baselineSelection.Value = _baselineSelection.Value with {
            IsEnabled = !_baselineSelection.Value.IsEnabled,
        };

    private async Task OnSaveBaseline(bool mustClear = false) {
        var m = State.Value;
        if (m.Language is null)
            return;

        var command = new Coach_SetBaseline {
            Session = Session, Language = m.Language, Kind = Kind,
            Period = mustClear ? null : m.Selection.Period, Anchor = m.Selection.Anchor,
        };
        var (_, error) = await UICommander.Run(command).ConfigureAwait(true);
        if (error is null)
            _baselineSelection.Value = new BaselineSelection(true, false);
    }

    private void OnPeriod(CoachHistoryPeriod period) {
        var selection = _selection.Value;
        var now = Clocks.SystemClock.Now;
        var isCurrent = CoachHistoryRanges.Start(selection.Period, selection.Anchor)
            == CoachHistoryRanges.Start(selection.Period, now);
        var anchor = isCurrent ? UsageDay.DayOf(now) : selection.Anchor;
        _selection.Value = new Selection(period, anchor);
    }

    private void OnMove(int offset) {
        var selection = _selection.Value;
        var anchor = CoachHistoryRanges.Move(selection.Period, selection.Anchor, offset);
        if (anchor <= Clocks.SystemClock.Now)
            _selection.Value = selection with { Anchor = anchor };
    }

    private void OnDay(ChartItem item) {
        var m = State.Value;
        var index = HistoryItems(m).ToList().IndexOf(item);
        if (index >= 0)
            _selection.Value = new Selection(CoachHistoryPeriod.Day, m.History.Days[index].Day);
    }

    private string PeriodLabel(CoachHistoryPeriod period)
        => period switch {
            CoachHistoryPeriod.Day => L.Coach_CalendarDay,
            CoachHistoryPeriod.Week => L.Coach_CalendarWeek,
            _ => L.Coach_CalendarMonth,
        };

    private string PeriodDates(Range<Moment> range) {
        var end = range.End > range.Start ? range.End - TimeSpan.FromTicks(1) : range.Start;
        return range.Start.ToDateTime().ToString("d MMM yyyy", DateFormatter)
            + " – " + end.ToDateTime().ToString("d MMM yyyy", DateFormatter);
    }

    private string HistoryValue(double value)
        => Kind == CoachMetricKind.Pace
            ? L.Coach_Wpm_Format(value.ToString("0.#", null))
            : L.Coach_Percent_Format((100 * value).ToString("0.#", null));

    private double? BaselineChartValue(Model m)
        => m.Comparison.Baseline is { InvalidatedAt: null, MeasurementVersion: 1 } baseline
            ? Kind == CoachMetricKind.Pace ? baseline.Value : baseline.Value * 100
            : null;

    private IReadOnlyList<ChartItem> HistoryItems(Model m)
        => m.History.Days.Select(day => {
            var date = day.Day.ToDateTime().ToString("d MMM", DateFormatter);
            var hint = day.Day.ToDateTime().ToString("d MMM yyyy", DateFormatter) + " · " + HistoryValue(day.Value);
            if (day.GapDays > 0)
                hint += " · " + L.Coach_HistoryGap_Format(day.GapDays);

            return new ChartItem(date, Kind == CoachMetricKind.Pace ? day.Value : day.Value * 100,
                "text-primary", hint, day.GapDays > 0);
        }).ToList();

    private void OnWord(string word)
        => _word.Value = word;

    private void OnWordBack()
        => _word.Value = null;

    private Task OnMoment(MomentItem item)
        => item.CanReplay
            ? Hub.CoachUI.JumpTo(item.Moment, CancellationToken.None)
            : Hub.CoachUI.JumpTo(item.Moment.Occurrence, CancellationToken.None, play: false);

    private string SampleProgress(CoachSkillHistory history)
        => L.Coach_MeasurementProgress_Format(history.MeasuredWords, history.MinimumWords,
            Math.Max(0, history.MinimumWords - history.MeasuredWords));

    private string Percent(long milliseconds, CoachPaceDetails pace)
        => Percent(milliseconds, pace.Distribution.TotalMilliseconds);

    private string Percent(long milliseconds, long total)
        => L.Coach_Percent_Format((total > 0 ? 100d * milliseconds / total : 0).ToString("0.#", null));

    private static Range<double>? PaceTargetRange(CoachPaceDetails pace)
        => pace.Fast > pace.Slow ? new Range<double>(pace.Slow, pace.Fast) : null;

    private string PaceBinHint(int bin, long milliseconds, int width, long total)
        => L.Coach_Wpm_Format((long)bin * width + "–<" + ((long)bin + 1) * width)
            + " · " + Percent(milliseconds, total) + " · " + DistributionDuration(milliseconds);

    private string DistributionDuration(long milliseconds)
        => milliseconds >= 60_000
            ? L.Duration_Minutes_Format((milliseconds / 60_000d).ToString("0.#", null))
            : L.Coach_Seconds_Format((milliseconds / 1_000d).ToString("0.#", null));

    public sealed record MomentItem(CoachPaceMoment Moment, string ChatTitle, string Text, bool CanReplay);

    public sealed record Selection(CoachHistoryPeriod Period, Moment Anchor);

    public sealed record BaselineSelection(bool IsEnabled, bool IsPreview);

    public sealed record Model(
        string? Language, string? Word, Selection Selection, CoachSkillHistory History,
        List<MomentItem> Moments, bool CanMoveForward, CoachBaselineComparison Comparison,
        BaselineSelection BaselineSelection, Range<Moment> SelectedRange,
        bool CanSaveBaseline, bool IsBaselineMode) {
        public static readonly Model None = new(null, null,
            new Selection(CoachHistoryPeriod.Week, Moment.EpochStart), CoachSkillHistory.None, [], false,
            new CoachBaselineComparison(), new BaselineSelection(true, false), default, false, false);

        public CoachWeekDelta Delta => new(Comparison.Baseline?.Kind ?? CoachMetricKind.Fillers,
            Comparison.Baseline?.Value, History.Value, CoachBand.None, Comparison.IsBetter);
        public CoachSummary Summary => History.Summary;
        public CoachPaceDetails Pace => History.Pace;
        public ApiArray<CoachChip> Words => History.Words;
    }
}
