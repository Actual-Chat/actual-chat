@namespace ActualChat.UI.Blazor.App.Components
@inherits ComputedStateComponent<AppUIHub, LiveLocationMapModal.ComputedModel>
@implements IModalView<LiveLocationMapModal.Model>
@{
    var m = State.Value;
}

<DialogFrame
    Class="live-location-map-modal"
    Title="Live location"
    HasCloseButton="true">
    <Body>
        <div class="c-map-host">
            @if (m.Markers.Count == 0) {
                <div class="c-empty">No one is sharing their location right now.</div>
            } else {
                <MapView
                    Class="c-map"
                    Markers="@m.Markers"
                    CenterLatitude="@m.CenterLatitude"
                    CenterLongitude="@m.CenterLongitude"/>
            }
        </div>
    </Body>
</DialogFrame>

@code {
    private const string OwnMarkerColor = "#16a34a";
    private const string OthersMarkerColor = "#2563eb";

    private IAuthors Authors => Hub.Authors;
    private ILiveLocations LiveLocations => Hub.LiveLocations;

    [CascadingParameter] public Modal Modal { get; set; } = null!;
    [Parameter] public Model ModalModel { get; set; } = null!;

    protected override ComputedState<ComputedModel>.Options GetStateOptions()
        => ComputedStateComponent.GetStateOptions(GetType(),
            static t => new ComputedState<ComputedModel>.Options() {
                InitialValue = ComputedModel.None,
                UpdateDelayer = FixedDelayer.NextTick,
                Category = GetStateCategory(t),
            });

    protected override async Task<ComputedModel> ComputeState(CancellationToken cancellationToken) {
        var chatId = ModalModel.ChatId;
        var locations = await LiveLocations.List(Session, chatId, cancellationToken).ConfigureAwait(false);
        if (locations.Count == 0)
            return ComputedModel.None;

        var ownAuthor = await Authors.GetOwn(Session, chatId, cancellationToken).ConfigureAwait(false);
        var markers = new List<MapMarker>(locations.Count);
        foreach (var location in locations) {
            var author = await Authors.Get(Session, chatId, location.AuthorId, cancellationToken).ConfigureAwait(false);
            var isOwn = ownAuthor != null && location.AuthorId == ownAuthor.Id;
            markers.Add(new MapMarker(
                location.AuthorId.Value,
                location.Point.Latitude,
                location.Point.Longitude,
                isOwn ? "You" : author?.Avatar.Name,
                isOwn ? OwnMarkerColor : OthersMarkerColor));
        }
        var center = locations[0].Point;
        return new ComputedModel(markers.ToApiArray(), center.Latitude, center.Longitude);
    }

    // Nested types

    public sealed record ComputedModel(ApiArray<MapMarker> Markers, double CenterLatitude, double CenterLongitude) {
        public static readonly ComputedModel None = new([], 0, 0);
    }

    public sealed record Model(ChatId ChatId);
}
