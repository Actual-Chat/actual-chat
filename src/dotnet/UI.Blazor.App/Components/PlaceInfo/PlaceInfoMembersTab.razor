@inherits ComponentBase<AppUIHub>
@{
    var m = Data;
}

<div class="member-list no-scrollbar">
    @foreach (var authorId in m.AuthorIds) {
        var isOwn = m.IsOwn(authorId);
        var isOwner = m.IsOwner(authorId);
        var statusText = FormatStatusText(isOwner, m.IsModerator(authorId), isOwn);
        var showMenu = !(isOwn || isOwner);
        var dataMenuAttr = showMenu ? MenuRef.New<EditPlaceMemberMenu>(authorId.Value).ToString() : null;
        <li @key="@authorId"
            data-menu="@dataMenuAttr"
            data-menu-placement="@(FloatingPosition.BottomStart.ToPositionString())">
            <div class="grow">
                <AuthorBadge
                    AuthorId="@authorId"
                    ShowPresence="true"
                    StatusText="@statusText" />
            </div>
        </li>
    }
</div>

@code {
    [Parameter, EditorRequired] public PlaceInfo.Model Data { get; set; } = null!;

    private string? FormatStatusText(bool isOwner, bool isModerator, bool isOwn) {
        var statusText = isOwner ? L.Members_Owner : isModerator ? L.Members_Moderator : null;
        if (isOwn)
            statusText = statusText != null
                ? L.Members_StatusOwn_Format(statusText)
                : L.Members_YourProfile;
        return statusText;
    }
}
