@page "/place/{PlaceSid}"
@inherits ComputedStateComponent<AppUIHub, PlaceInfoPage.Model?>
@layout ListViewLayout
@{
    var m = _rendered = State.Value;
    if (m is null) {
        <chat-view-skeleton class="no-scrollbar" count="15" />
        return;
    }

    var place = m.Place;
}

@if (place is null) {
    if (m == Model.NoPlaceSelected) {
        <div class="no-chat-body">
            @L.Place_SelectPlace
        </div>
    } else if (m.JoinTarget is { } joinTarget) {
        <JoinLanding Target="@joinTarget"/>
    } else {
        <ChatNotFound ShowSignIn="@false" Target="@ChatNotFound.TargetKind.Place" />
    }
    return;
}

<PlaceInfo PlaceId="@place.Id" />

@code {
    private Model? _rendered;

    private IPlaces Places => Hub.Places;
    private IJoinRequests JoinRequests => field ??= Hub.Services.GetRequiredService<IJoinRequests>();
    private ILogger Log => field ??= Hub.LogFor(GetType());

    [Parameter] public string? PlaceSid { get; set; }

    protected override bool ShouldRender()
        => (ReferenceEquals(_rendered, null)
                || State.HasError
                || State.Value != _rendered)
            && base.ShouldRender();

    protected override ComputedState<Model?>.Options GetStateOptions()
        => new() {
            InitialValue = PlaceSid.IsNullOrEmpty()
                ? Model.NoPlaceSelected
                : null, // Loading
            Category = GetStateCategory(GetType()),
        };

    protected override async Task<Model?> ComputeState(CancellationToken cancellationToken) {
        var placeSid = PlaceSid;
        if (placeSid.IsNullOrEmpty())
            return Model.NoPlaceSelected;

        if (!PlaceId.TryParse(placeSid, out var placeId))
            return Model.Unavailable;

        try {
            var place = await Places.Get(Session, placeId, cancellationToken).ConfigureAwait(false);
            if (place is not null)
                return new Model(place);

            // A private Place may still take join requests by its plain link
            var joinTarget = await JoinRequests
                .GetTarget(Session, placeId.RootChatId, cancellationToken)
                .ConfigureAwait(false);
            return joinTarget is null ? Model.Unavailable : new Model(null) { JoinTarget = joinTarget };
        }
        catch (Exception e) when (e is not OperationCanceledException) {
            Log.LogWarning(e, "Failed to get Place #{PlaceId}", placeId);
            return Model.Unavailable;
        }
    }

    // Nested types

    public sealed record Model(Place? Place) {
        public static readonly Model Unavailable = new((Place?)null);
        public static readonly Model NoPlaceSelected = new((Place?)null);

        public JoinTarget? JoinTarget { get; init; }

        // This record relies on referential equality
        public bool Equals(Model? other) => ReferenceEquals(this, other);
        public override int GetHashCode() => RuntimeHelpers.GetHashCode(this);
    }
}
