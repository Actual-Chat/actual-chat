@namespace ActualChat.UI.Blazor.App.Components
@using ActualChat.MediaPlayback
@using Timer = System.Timers.Timer;
@inherits ComputedStateComponent<AppUIHub, ReplaySubHeader.Model?>
@{
    var m = State.Value;
    var isNarrow = ScreenSize.IsNarrow();
    var size = isNarrow ? SquareSize.Size8 : SquareSize.Size6;
    var maxAvatars = isNarrow ? 3 : 4;
    var participantCount = m?.ParticipantCount ?? 0;
    var slotCount = participantCount switch {
        <= 2 => 2,
        3 => 3,
        _ => maxAvatars,
    };
    var isLoading = m?.IsLoading == true;
    var showDivider = participantCount > 0 && participantCount <= 3;
    var showSkeletons = isLoading || participantCount > 2;
    var slotsCls = $"c-slots-{slotCount}";
    var speed = m?.Speed ?? ChatAudioUI.ReplaySettings.Value.Speed;
    var speedLabel = Math.Abs(speed - 1.0) < 0.01 ? "1x" : $"{speed:0.##}x";

    var titleLabel = m?.ShowChatTitle == true ? m.ChatTitle : "Replaying";
    var dateLabel = "";
    if (m?.PlayingAt is { } playingAt) {
        var now = DateTimeConverter.ToLocalTime(Hub.Clocks.SystemClock.Now);
        var localTime = DateTimeConverter.ToLocalTime(playingAt);
        var delta = (now.Date - localTime.Date).Days;
        dateLabel = delta switch {
            0 => $"Today, {localTime:HH:mm}",
            1 => $"Yesterday, {localTime:HH:mm}",
            < 8 => $"{localTime:ddd}, {localTime:HH:mm}",
            _ => now.Year == localTime.Year
                ? $"{localTime:MMM dd}, {localTime:HH:mm}"
                : $"{localTime:MMM dd, yyyy}, {localTime:HH:mm}",
        };
    }
}

@if (m is not null) {
    <div class="replay-subheader">
        <div class="c-authors-block @slotsCls">
            @if (showSkeletons) {
                <div class="c-skeletons" aria-hidden="true">
                    @for (var i = 0; i < slotCount; i++) {
                        <div class="replay-skeleton"></div>
                    }
                </div>
            }
            <AuthorCircleGroup
                Class="c-authors"
                MaxCount="@slotCount"
                Size="@size"
                AuthorIds="@m?.AuthorIds"
                IsListening="true"/>
        </div>
        @if (showDivider) {
            <div class="c-divider" aria-hidden="true"></div>
        }
        <div class="c-info">
            @if (m?.ShowChatTitle == true) {
                <a class="c-title" href="@Links.Chat(m.ChatId)">@titleLabel</a>
            } else {
                <div class="c-title">@titleLabel</div>
            }
            @if (isLoading) {
                <div class="c-date-skeleton" aria-hidden="true"></div>
            } else if (dateLabel.Length > 0) {
                <div class="c-date">@dateLabel</div>
            }
        </div>
        <div class="c-playback">
            @if (isLoading) {
                <div class="replay-spinner animate-spin"></div>
            } else {
            @if (ScreenSize.IsWide()) {
                <ButtonRound Tooltip="Backward" Click="@OnBackward" Class="btn-xs btn-transparent hover-primary-icon">
                    <i class="icon-rewind-left-fill text-2xl"></i>
                </ButtonRound>
            }
            @if (m?.IsPaused ?? false) {
                <ButtonRound Tooltip="Play" Click="@OnResume" Class="btn-xs btn-transparent btn-primary" MustKeepAwake="true">
                    <i class="icon-play-fill text-2xl"></i>
                </ButtonRound>
            } else {
                <ButtonRound Tooltip="Pause" Click="@OnPause" Class="btn-xs btn-transparent btn-primary">
                    <i class="icon-pause-fill text-2xl"></i>
                </ButtonRound>
            }
            @if (ScreenSize.IsWide()) {
                <ButtonRound Tooltip="Forward" Click="@OnForward" Class="btn-xs btn-transparent hover-primary-icon">
                    <i class="icon-rewind-right-fill text-2xl"></i>
                </ButtonRound>
                <ButtonRound Tooltip="Stop" Click="@OnStop" Class="btn-xs btn-transparent hover-primary-icon">
                    <i class="icon-stop-fill text-2xl"></i>
                </ButtonRound>
            }
            }
        </div>
        <div class="c-actions">
            <HeaderButton
                Class="c-speed-btn btn-lg hover-primary-icon"
                Tooltip="Speed"
                data-menu="@(MenuRef.New<ReplaySpeedMenu>())"
                data-menu-trigger="@MenuTrigger.Primary"
                data-menu-placement="@(FloatingPosition.TopEnd.ToPositionString())">
                <span class="c-speed-label">@speedLabel</span>
            </HeaderButton>
            <HeaderButton Click="@OnStop">
                <i class="icon-close-fill text-2xl"></i>
            </HeaderButton>
        </div>
    </div>
}

@code {
    private RewindDelayer? _rewindController;

    private IChats Chats => Hub.Chats;
    private IAuthors Authors => Hub.Authors;
    private ChatUI ChatUI => Hub.ChatUI;
    private ChatAudioUI ChatAudioUI => Hub.ChatAudioUI;
    private ActivePlaybackInfo ActivePlaybackInfo => Hub.ActivePlaybackInfo;

    [CascadingParameter] public ScreenSize ScreenSize { get; set; }

    protected override ComputedState<Model?>.Options GetStateOptions()
        => ComputedStateComponent.GetStateOptions(GetType(),
            static t => new ComputedState<Model?>.Options() {
                UpdateDelayer = FixedDelayer.NextTick,
                Category = GetStateCategory(t),
            });

    protected override async Task<Model?> ComputeState(CancellationToken cancellationToken) {
        var lastState = State.Value;
        var selectedChatId = await ChatUI.SelectedChatId.Use(cancellationToken).ConfigureAwait(false);
        var replayState = await ChatAudioUI.ReplayState.Use(cancellationToken).ConfigureAwait(false);
        if (replayState is not { ChatId: var chatId })
            return null;

        var chat = await Chats.Get(Session, chatId, cancellationToken).ConfigureAwait(false);
        var chatTitle = chat?.Title ?? "";
        var participantCount = await GetParticipantCount(chatId, cancellationToken).ConfigureAwait(false);

        Model Loading() => new() {
            ChatId = chatId,
            IsLoading = true,
            ChatTitle = chatTitle,
            ShowChatTitle = chatId != selectedChatId,
            Speed = replayState.Speed,
            ParticipantCount = participantCount,
            AuthorIds = [],
        };

        // Paused state: player is stopped, but we still show the banner
        if (replayState.PausedAt is { } pausedAt)
            return new() {
                ChatId = chatId,
                PlayingAt = pausedAt,
                Player = null,
                IsPaused = true,
                Speed = replayState.Speed,
                ChatTitle = chatTitle,
                ShowChatTitle = chatId != selectedChatId,
                AuthorIds = lastState?.AuthorIds ?? [],
                ParticipantCount = participantCount,
            };

        var player = await ChatAudioUI.GetReplayPlayer(chatId, cancellationToken).ConfigureAwait(false);
        if (player is null) {
            // This happens when player is being disposed, which means this method
            // will soon recompute anyway.
            return lastState ?? Loading(); // Keep the last state to avoid blinking
        }
        var isPaused = await player.Playback.IsPaused.Use(cancellationToken).ConfigureAwait(false);
        var playback = player.Playback;
        var playingTracks = await playback.PlayingTracks.Use(cancellationToken).ConfigureAwait(false);
        var authorIds = new HashSet<AuthorId>();
        Moment? playingAt = null;
        foreach (var playingTrack in playingTracks) {
            var trackInfo = playingTrack.TrackInfo;
            if (trackInfo is ChatAudioTrackInfo { AudioEntry: { } audioEntry }) {
                var authorId = audioEntry.AuthorId;
                authorIds.Add(authorId);
            }
            var actualPlaybackState = await ActivePlaybackInfo.GetTrackPlaybackState(trackInfo.TrackId, cancellationToken).ConfigureAwait(false);
            if (actualPlaybackState == null)
                continue;

            playingAt ??= trackInfo.RecordedAt + actualPlaybackState.PlayingAt;
        }
        if (playingAt.HasValue)
            return new() {
                ChatId = chatId,
                PlayingAt = playingAt,
                Player = player,
                IsPaused = isPaused,
                Speed = replayState.Speed,
                ChatTitle = chatTitle,
                ShowChatTitle = chatId != selectedChatId,
                AuthorIds = authorIds.ToList(),
                ParticipantCount = participantCount,
            };

        // No playing tracks yet (e.g. resuming) — keep last state to avoid blinking
        if (lastState is not null && lastState.ChatId == chatId)
            return lastState with { Player = player, IsPaused = isPaused };
        return Loading();
    }

    private async Task<int> GetParticipantCount(ChatId chatId, CancellationToken cancellationToken) {
        if (chatId.Kind == ChatKind.Peer)
            return 2;
        var allAuthorIds = await Authors.ListAuthorIds(Session, chatId, cancellationToken).ConfigureAwait(false);
        return allAuthorIds.Length;
    }

    private void OnStop()
        => ChatAudioUI.StopReplay();

    private async Task OnResume() {
        var m = State.Value;
        if (m is null)
            return;

        var replayState = ChatAudioUI.ReplayState.Value;
        if (replayState is null || replayState.ChatId != m.ChatId)
            return;

        // Restart replay from paused position
        var resumeAt = replayState.PausedAt ?? m.PlayingAt ?? replayState.StartAt;
        await ChatAudioUI.StartReplay(m.ChatId, resumeAt);
    }

    private void OnPause() {
        var m = State.Value;
        if (m is null)
            return;

        // Stop the stream and remember current position
        var pausedAt = m.PlayingAt ?? ChatAudioUI.ReplayState.Value?.StartAt ?? default;
        ChatAudioUI.PauseReplay(pausedAt);
    }

    private void OnForward()
        => Rewind(TimeSpan.FromSeconds(15));

    private void OnBackward()
        => Rewind(TimeSpan.FromSeconds(-15));

    private void Rewind(TimeSpan offset) {
        var m = State.Value;
        if (m?.Player is null || m.PlayingAt is not { } playingAt)
            return;

        _rewindController ??= new RewindDelayer(OnRewindRequested);
        _rewindController.Rewind(m.ChatId, playingAt, offset);
    }

    private void OnRewindRequested(ChatId chatId, Moment origin, TimeSpan offset) {
        _ = InvokeAsync(async () => {
            var m = State.Value;
            if (m?.Player != null && m.Player.ChatId == chatId)
                await ChatAudioUI.StartReplay(chatId, origin, offset);
        });
    }

    // Nested types

    public sealed record Model
    {
        public Moment? PlayingAt { get; init; }
        public bool IsLoading { get; init; }
        public bool IsPaused { get; init; }
        public double Speed { get; init; } = 1.0;
        public ChatReplayPlayer? Player { get; init; }
        public string ChatTitle { get; init; } = "";
        public required ChatId ChatId { get; init; }
        public bool ShowChatTitle { get; init; }
        public IReadOnlyList<AuthorId> AuthorIds { get; init; } = [];
        public int ParticipantCount { get; init; }

        // This record relies on referential equality
        public bool Equals(Model? other) => ReferenceEquals(this, other);
        public override int GetHashCode() => RuntimeHelpers.GetHashCode(this);
    }

    private sealed class RewindDelayer
    {
        private readonly Timer _delayTimer;
        private ChatId? _chatId;
        private Moment _origin;
        private TimeSpan _offset;

        public RewindDelayer(Action<ChatId, Moment, TimeSpan> rewinder)
        {
            _delayTimer = new Timer(300) { AutoReset = false };
            _delayTimer.Elapsed += (_, _) => {
                if (_chatId is { } chatId)
                    rewinder.Invoke(chatId, _origin, _offset);
            };
        }

        public void Rewind(ChatId chatId, Moment origin, TimeSpan delta)
        {
            if (_chatId != chatId) {
                _delayTimer.Stop();
                _chatId = chatId;
            }

            if (!_delayTimer.Enabled) {
                _origin = origin;
                _offset = delta;
                _delayTimer.Start();
            } else {
                _delayTimer.Stop();
                _offset += delta;
                _delayTimer.Start();
            }
        }
    }
}
