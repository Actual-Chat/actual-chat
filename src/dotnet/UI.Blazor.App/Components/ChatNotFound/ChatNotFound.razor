@namespace ActualChat.UI.Blazor.App.Components
@inherits ComponentBase<AppUIHub>

<div class="chat-not-found-container">
    <div class="c-wrapper">
        <chat-not-found-svg/>
        <div class="text-wrapper">
            @if (Target is TargetKind.Chat) {
                <p>@L.ChatNotFound_Chat</p>
                <p>@L.ChatNotFound_ChooseAnother</p>
            } else {
                <p>@L.ChatNotFound_Place</p>
                <p>@L.ChatNotFound_ChooseAnother</p>
            }
        </div>
    </div>
</div>

@if (ShowSignIn) {
    <RenderIntoSlot Name="@LayoutSlots.MainFooter">
        <div class="flex-x items-center justify-center gap-x-2">
            <span>@L.ChatNotFound_SignIn</span>
            <SignInButton/>
        </div>
    </RenderIntoSlot>
}

@code {
    [Parameter] public bool ShowSignIn { get; set; }
    [Parameter] public TargetKind Target { get; set; } = TargetKind.Chat;

    public enum TargetKind { Chat, Place }
}
