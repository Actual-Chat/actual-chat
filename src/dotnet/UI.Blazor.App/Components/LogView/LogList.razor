@namespace ActualChat.UI.Blazor.App.Components
@inherits FusionComponentBase<AppUIHub>

<VirtualList
    @key="nameof(LogList)"
    Class="log-list"
    DataSource="@this"
    Identity="logs"
    DefaultEdge="@VirtualListEdge.End"
    ExpandMultiplier="2"
    SkeletonCount="@_skeletonCount"
    ItemVisibilityChanged="@OnItemVisibilityChanged">
    <Item>
        <LogItem Entry="@context" />
    </Item>
    <SkeletonBatch>
        <chat-view-skeleton count="@context" />
    </SkeletonBatch>
</VirtualList>

@code {
    private int _skeletonCount;

    private LogUI LogUI => Hub.LogUI;

    [CascadingParameter] public ScreenSize ScreenSize { get; set; }

    protected override void OnInitialized()
        => _skeletonCount = ScreenSize.IsNarrow() ? 10 : 15;
}
