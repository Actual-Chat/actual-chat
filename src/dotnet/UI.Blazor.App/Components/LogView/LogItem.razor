@namespace ActualChat.UI.Blazor.App.Components
@inherits FusionComponentBase<AppUIHub>
@{
    var levelCls = Entry.LogLevel switch {
        LogLevel.Trace => "trace",
        LogLevel.Debug => "debug",
        LogLevel.Information => "info",
        LogLevel.Warning => "warning",
        LogLevel.Error => "error",
        LogLevel.Critical => "critical",
        _ => "",
    };
    var sTime = Entry.Timestamp.ToString("HH:mm:ss.fff");
    var sLevel = Entry.LogLevel.ToString()[0];
    var header = $"{sTime} {sLevel} [{Entry.CategoryName}]";
    var body = Entry.Exception is null
        ? Entry.Message
        : $"{Entry.Message}\n{Entry.Exception}";
    var text = string.IsNullOrEmpty(body) ? header : $"{header}\n{body}";
}

<CopyTrigger CopyText="@text" Tooltip="Copy to clipboard">
    <div class="log-item @levelCls">
        <div class="c-header">
            <div class="c-timestamp">@sTime</div>
            <div class="c-level" data-tooltip="@Entry.LogLevel">@Entry.LogLevel.ToString()[0]</div>
            <div class="c-category" data-tooltip="@Entry.CategoryName">@Entry.CategoryName.Suffix(".")</div>
            <div class="c-id">#@Entry.Id</div>
        </div>
        <div class="c-body">
            <div class="c-message">@Entry.Message</div>
            <div class="c-exception">@Entry.Exception</div>
        </div>
    </div>
</CopyTrigger>
@code {
    [Parameter] public LogEntry Entry { get; set; } = null!;
}
