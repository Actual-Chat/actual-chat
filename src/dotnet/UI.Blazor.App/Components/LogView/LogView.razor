@namespace ActualChat.UI.Blazor.App.Components
@using ActualChat.UI.Blazor.Events
@inherits ComputedStateComponent<AppUIHub, bool>
@{
    if (State.IsInitial(out var isEnabled))
        return;
    if (!isEnabled) {
        <div>Local logs are disabled. To enable go to
            <Button Class="btn-transparent unhovered compact" Click="@OnSettingsClick">settings</Button>
        </div>
        return;
    }
}

<LogList />

@code {
    private LogUI LogUI => Hub.LogUI;

    protected override Task<bool> ComputeState(CancellationToken cancellationToken)
        => LogUI.IsEnabled.Use(cancellationToken);

    private Task OnSettingsClick()
        => UIEventHub.Publish(new ShowSettingsEvent(SettingsTabId.App));
}
