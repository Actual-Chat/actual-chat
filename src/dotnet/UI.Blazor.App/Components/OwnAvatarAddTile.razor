@namespace ActualChat.UI.Blazor.App.Components
@inherits ComponentBase<UIHub>

<ButtonTile Class="btn-outline"
        Click="OnClick"
        data-bubble="@(BubbleRef.New<AddAvatarBubble>())"
        data-bubble-priority="302"
        data-bubble-placement="@(FloatingPosition.LeftStart.ToPositionString())">
    <Icon><i class="icon-plus text-xl"></i></Icon>
    <Content>
        <div class="c-text">@L.Avatar_AddAvatar</div>
    </Content>
</ButtonTile>

@code{

    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }
}
