@namespace ActualChat.UI.Blazor.App.Components
@inherits ComputedStateComponent<AppUIHub, AudioAttachmentSubHeader.Model?>
@{
    var m = State.Value;
    var iconCls = m?.IsPlaying == true ? "icon-pause-fill" : "icon-play-fill";
    var positionLabel = FormatTime(m?.Position ?? TimeSpan.Zero);
    var durationLabel = m?.Duration is { } d ? FormatTime(d) : "--:--";
    var fraction = m?.Duration is { } dur && dur.TotalSeconds > 0
        ? Math.Clamp(m.Position.TotalSeconds / dur.TotalSeconds, 0, 1)
        : 0;
    var speed = m?.Speed ?? 1.0;
}

@if (m is not null) {
<div class="audio-attachment-subheader">
    <PlaybackRunningBorder IsPlaying="@m.IsPlaying"/>
    <div class="c-row-main">
        <ButtonRound Tooltip="@(m?.IsPlaying == true ? L.Common_Pause : L.MessageMenu_Play)"
                     Click="@OnToggle"
                     Class="c-play-btn btn-xs">
            <i class="@iconCls text-xl"></i>
        </ButtonRound>
        <div class="c-info">
            <div class="c-title"><span class="c-title-inner">@m?.FileName</span></div>
        </div>
        <div class="c-actions">
            <PlaybackSpeedButton Speed="@speed" Menu="@(MenuRef.New<AudioAttachmentSpeedMenu>())"/>
            @if (ScreenSize.IsWide()) {
                <HeaderButton Tooltip="@L.AudioPlayer_Backward" Click="@OnBackward">
                    <i class="icon-media-backward-10"></i>
                </HeaderButton>
                <HeaderButton Tooltip="@L.AudioPlayer_Forward" Click="@OnForward">
                    <i class="icon-media-forward-10"></i>
                </HeaderButton>
            }
            <HeaderButton Click="@OnStop">
                <i class="icon-close-fill text-2xl"></i>
            </HeaderButton>
        </div>
    </div>
    <div class="c-row-scrubber">
        <span class="c-elapsed">@positionLabel</span>
        <div class="c-progress" style="--progress: @fraction.ToString("0.######")">
            <div class="c-progress-track"></div>
            <div class="c-progress-fill"></div>
            <div class="c-progress-thumb"></div>
            <input type="range"
                   class="c-progress-input"
                   min="0" max="1" step="0.001"
                   value="@fraction.ToString("0.######")"
                   disabled="@(m?.Duration is null)"
                   aria-label="@L.AudioPlayer_Seek"
                   @oninput="OnSeek" />
        </div>
        <span class="c-total">@durationLabel</span>
    </div>
</div>
}

@code {
    // The seek slider fires @oninput continuously while dragging. Its thumb is the native range
    // input and everything else here is State-driven, so a render per event is pure overhead.
    public AudioAttachmentSubHeader()
        => MustRenderAfterEvent = false;

    private AudioAttachmentPlayer Player => Hub.AudioAttachmentPlayer;

    [CascadingParameter] public ScreenSize ScreenSize { get; set; }

    protected override ComputedState<Model?>.Options GetStateOptions()
        => ComputedStateComponent.GetStateOptions(GetType(),
            static t => new ComputedState<Model?>.Options() {
                UpdateDelayer = FixedDelayer.NextTick,
                Category = GetStateCategory(t),
            });

    protected override async Task<Model?> ComputeState(CancellationToken cancellationToken) {
        var state = await Player.State.Use(cancellationToken).ConfigureAwait(false);
        if (state is null)
            return null;

        return new Model {
            FileName = state.FileName,
            IsPlaying = state.IsPlaying,
            Position = state.Position,
            Duration = state.Duration,
            Speed = state.Speed,
        };
    }

    private Task OnToggle() {
        var m = State.Value;
        if (m is null)
            return Task.CompletedTask;

        return (m.IsPlaying ? Player.Pause() : Player.Resume()).AsTask();
    }

    private Task OnBackward()
        => Player.SkipBy(TimeSpan.FromSeconds(-10)).AsTask();

    private Task OnForward()
        => Player.SkipBy(TimeSpan.FromSeconds(10)).AsTask();

    private Task OnStop()
        => Player.Stop().AsTask();

    private Task OnSeek(ChangeEventArgs e) {
        if (e.Value is not string s || !double.TryParse(s, out var fraction))
            return Task.CompletedTask;

        var m = State.Value;
        if (m?.Duration is not { } d)
            return Task.CompletedTask;

        return Player.Seek(d * fraction).AsTask();
    }

    private static string FormatTime(TimeSpan t) {
        if (t < TimeSpan.Zero)
            t = TimeSpan.Zero;
        return t.TotalHours >= 1
            ? $"{(int)t.TotalHours}:{t.Minutes:00}:{t.Seconds:00}"
            : $"{t.Minutes:00}:{t.Seconds:00}";
    }

    // Nested types

    public sealed record Model
    {
        public required string FileName { get; init; }
        public bool IsPlaying { get; init; }
        public TimeSpan Position { get; init; }
        public TimeSpan? Duration { get; init; }
        public double Speed { get; init; } = 1.0;
    }
}
