@namespace ActualChat.UI.Blazor.App.Components
@inherits ComputedStateComponent<AppUIHub, AudioFileAttachment.Model>
@{
    var m = State.Value;
    var fileSize = Attachment.Media.Length;
    var iconCls = m.IsPlaying ? "icon-pause-fill text-2xl" : "icon-note text-xl";
    var fraction = m.Duration is { } d && d.TotalSeconds > 0
        ? Math.Clamp(m.Position.TotalSeconds / d.TotalSeconds, 0, 1)
        : 0;
    var positionLabel = FormatTime(m.Position);
    var durationLabel = m.Duration is { } dur ? FormatTime(dur) : "--:--";
}

<div class="audio-file-attachment file-attachment unfocusable">
    <button class="c-play-btn" type="button" @onclick="@OnToggle" @onclick:stopPropagation>
        <i class="@iconCls"></i>
    </button>
    <div class="c-file-info">
        <FileAttachmentTitle Title="@Attachment.Media.FileName"/>
        <div class="c-bottom">
            @if (m.IsCurrent) {
                <div class="c-time">
                    <span>@positionLabel / @durationLabel</span>
                </div>
            } else {
                <div class="c-size">
                    <span>@FileSizeFormatter.Format(fileSize)</span>
                </div>
            }
        </div>
        @if (m.IsCurrent) {
            <div class="c-progress" style="--progress: @fraction.ToString("0.######")">
                <div class="c-progress-track"></div>
                <div class="c-progress-fill"></div>
                <div class="c-progress-thumb"></div>
                <input type="range"
                       class="c-progress-input"
                       min="0" max="1" step="0.001"
                       value="@fraction.ToString("0.######")"
                       disabled="@(m.Duration is null)"
                       aria-label="@L.AudioPlayer_Seek"
                       @oninput="OnSeek"
                       @onclick:stopPropagation />
            </div>
        }
    </div>
    <ButtonRound
        Class="btn-sm btn-transparent"
        data-menu="@(MenuRef.New<AudioFileAttachmentMenu>(Attachment.EntryId.Value, Attachment.Index.ToString()).ToString())"
        data-menu-trigger="@MenuTrigger.Primary"
        data-menu-placement="@(FloatingPosition.TopEnd.ToPositionString())">
        <i class="icon-more-vertical text-xl"></i>
    </ButtonRound>
</div>

@code {
    private AudioAttachmentPlayer Player => Hub.AudioAttachmentPlayer;

    [Parameter, EditorRequired]
    public ChatEntryAttachment Attachment { get; set; } = null!;

    protected override ComputedState<Model>.Options GetStateOptions()
        => ComputedStateComponent.GetStateOptions(GetType(),
            static t => new ComputedState<Model>.Options() {
                UpdateDelayer = FixedDelayer.NextTick,
                Category = GetStateCategory(t),
                InitialValue = Model.Empty,
            });

    protected override async Task<Model> ComputeState(CancellationToken cancellationToken) {
        var state = await Player.State.Use(cancellationToken).ConfigureAwait(false);
        var isCurrent = state is not null && state.AttachmentId == Attachment.Id;
        if (!isCurrent || state is null)
            return Model.Empty;

        return new Model {
            IsCurrent = true,
            IsPlaying = state.IsPlaying,
            Position = state.Position,
            Duration = state.Duration,
        };
    }

    private async Task OnToggle() {
        var m = State.Value;
        if (m.IsCurrent) {
            if (m.IsPlaying)
                await Player.Pause();
            else
                await Player.Resume();
        } else {
            await Player.Play(Attachment);
        }
    }

    private Task OnSeek(ChangeEventArgs e) {
        if (e.Value is not string s || !double.TryParse(s, out var fraction))
            return Task.CompletedTask;

        var m = State.Value;
        if (m.Duration is not { } d)
            return Task.CompletedTask;

        return Player.Seek(d * fraction).AsTask();
    }

    private static string FormatTime(TimeSpan t) {
        if (t < TimeSpan.Zero)
            t = TimeSpan.Zero;
        return t.TotalHours >= 1
            ? $"{(int)t.TotalHours}:{t.Minutes:00}:{t.Seconds:00}"
            : $"{t.Minutes:00}:{t.Seconds:00}";
    }

    // Nested types

    public sealed record Model
    {
        public static readonly Model Empty = new();
        public bool IsCurrent { get; init; }
        public bool IsPlaying { get; init; }
        public TimeSpan Position { get; init; }
        public TimeSpan? Duration { get; init; }
    }
}
