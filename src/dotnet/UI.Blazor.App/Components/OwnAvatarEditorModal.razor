@namespace ActualChat.UI.Blazor.App.Components
@inherits ComponentBase<AppUIHub>
@implements IModalView<OwnAvatarEditorModal.Model>
@{
    // The form is rendered only once its model is fully loaded: the EditContext validates the model on first
    // render, so a still-loading (empty Name) model would stick a false "required" error on the prefilled field.
    if (!_isLoaded)
        return;
    var bioFieldAttrs = new Dictionary<string, object> { { "maxLength", 160 } };
}

<Form @ref="_formRef" Class="h-full" Model="@_form" OnSubmit="@OnSave">
    <DataAnnotationsValidator/>
    <DialogFrame
        Class="edit-settings-modal edit-avatar-modal"
        Title="@_form.Title"
        HasCloseButton="true"
        HeaderMode="HeaderMode.Custom"
        NarrowViewSettings="@DialogFrameNarrowViewSettings.Default"
        ButtonsClass="full-width">
        <Header>
            <div class="own-avatar-edit-header">
                <AvatarPicFormBlock
                    Title="@_form.Title"
                    Picture="@_form.Picture"
                    ImagePicked="@OnImagePicked"
                    CloseRequested="@(() => Modal.Close())" />
            </div>
        </Header>
        <Body>
        <FormBlock>
            <FormSection For="() => _form.Name" InputId="@_form.NameFieldId" Label="@L.Form_Name" IsLabelInsideInput="true">
                <TextBox @bind-Value="@_form.Name" Id="@_form.NameFieldId" ClearButton="true"/>
            </FormSection>

            <FormSection For="() => _form.Bio" InputId="@_form.BioFieldId" Label="@L.Form_Bio" IsLabelInsideInput="true">
                <TextBox @bind-Value="@_form.Bio" Id="@_form.BioFieldId" ClearButton="true" AdditionalAttributes="@bioFieldAttrs"/>
            </FormSection>
        </FormBlock>

        @if (!_isAnonymous) {
            <FormBlock Class="avatar-buttons">
                <Card>
                    <ButtonTile Click="@ChangeDefaultAvatar">
                        <Icon>
                            <i class="icon-star text-xl @(_form.IsDefault ? "text-primary" : "text-03")"></i>
                        </Icon>
                        <Content>
                            <div class="c-text text-02">
                                @L.Avatar_MakeDefault
                            </div>
                            <div class="c-caption">
                                @L.Avatar_MakeDefaultHint
                            </div>
                        </Content>
                    </ButtonTile>
                    <Divider/>
                    <ButtonTile Class="btn-danger" Click="@OnDeleteAvatarClick">
                        <Icon>
                            <i class="icon-trash03 text-xl text-danger"></i>
                        </Icon>
                        <Content>
                            <div class="c-text text-danger">
                                @L.Avatar_Delete
                            </div>
                        </Content>
                    </ButtonTile>
                </Card>

                @if (ModalModel.ChatId is not null) {
                    <FormSection For="() => _form.IsActive" InputId="@_form.IsActiveFieldId">
                        <ToggleEdit @bind-Value="@_form.IsActive" Id="@_form.IsActiveFieldId"
                                    Label="@L.Avatar_UsedInThisChat"/>
                    </FormSection>
                }
            </FormBlock>
        }
        </Body>
        <Buttons>
            <FormButtons>
                @{
                    var submitClass = $"btn-modal btn-primary {_formRef.IsValid.ToEnabledClass()}";
                }
                <Button Type="@ButtonType.Submit" Class="@submitClass">@L.Common_Save</Button>
            </FormButtons>
        </Buttons>
    </DialogFrame>
</Form>

@code {
    private Form _formRef = null!;
    private FormModel _form = null!;
    private bool _isLoaded;
    private bool _isAnonymous;

    private IAvatars Avatars => Hub.Avatars;
    private IAuthors Authors => Hub.Authors;
    private IAccounts Accounts => Hub.Accounts;

    [CascadingParameter] public Modal Modal { get; set; } = null!;
    [Parameter] public Model ModalModel { get; set; } = null!;

    protected override async Task OnParametersSetAsync() {
        // Re-renders (e.g. when a nested modal closes) must not rebuild the form and discard a picked picture.
        if (_form is { OriginalAvatar: { } currentAvatar } && currentAvatar.Id == ModalModel.AvatarId)
            return;

        // Build the model fully before assigning _form: the EditContext validates on first render, so a
        // partially-built model (empty Name) would stick a false "required" error on the prefilled field.
        // Render is gated on _isLoaded until everything below is loaded.
        var form = new FormModel(ComponentIdGenerator) {
            OriginalAvatar = await Avatars.GetOwn(Session, ModalModel.AvatarId, default),
        };

        var account = await Accounts.GetOwn(Session, default);
        var isDefault = ModalModel.AvatarId == account.Avatar.Id;
        var isActive = false;
        if (ModalModel.ChatId is not null) {
            var author = await Authors.GetOwn(Session, ModalModel.ChatId, default);
            isActive = ModalModel.AvatarId == (author?.AvatarId ?? Symbol.Empty);
        }

        form.Picture = form.OriginalAvatar?.Picture;
        form.Name = form.OriginalAvatar?.Name ?? "";
        form.Bio = form.OriginalAvatar?.Bio ?? "";
        form.IsDefault = isDefault;
        form.IsActive = isActive;
        form.Title = ModalModel.Title;
        form.CopyToBase();

        _isAnonymous = form.OriginalAvatar?.IsAnonymous ?? false;
        _form = form;
        _isLoaded = true;
    }

    private async Task OnSave() {
        var (avatarId, chatId, _) = ModalModel;
        if (_form.OriginalAvatar == null) {
            _ = UICommander.Run(LocalCommand.New(static () => throw StandardError.NotFound<Avatar>()));
            return;
        }
        var updated = _form.OriginalAvatar.WithPicture(_form.Picture) with { Name = _form.Name, Bio = _form.Bio };
        var diff = DiffEngine.Diff<AvatarFull, AvatarDiff>(_form.OriginalAvatar, updated);
        var command = new Avatars_Change {
            Session = Session,
            AvatarId = avatarId,
            ExpectedVersion = null,
            Change = Change.Update(diff),
        };
        var (_, error) = await UICommander.Run(command);
        if (error != null)
            return;

        if (!_form.OriginalAvatar.IsAnonymous) {
            if (_form is { IsDefault: true, Base.IsDefault: false })
                await SetDefaultAvatar(_form.IsDefault ? avatarId : default);
            if (chatId is not null && _form is { IsActive: true, Base.IsActive: false })
                await SetActiveAvatar(_form.IsActive ? avatarId : default);
        }

        _form.CopyToBase();
        CloseModal();
    }

    private void OnImagePicked(Picture picture) {
        _form.Picture = picture;
        _form.CopyToBase();
    }

    private async Task SetDefaultAvatar(Symbol avatarId)
    {
        var command = new Avatars_SetDefault { Session = Session, AvatarId = avatarId };
        await UICommander.Run(command);
    }

    private async Task SetActiveAvatar(Symbol avatarId) {
        var chatId = ModalModel.ChatId;
        if (chatId is null)
            return;

        var author = await Authors.GetOwn(Session, chatId, default);
        if (author == null)
            return;

        var command = new Authors_SetAvatar { Session = Session, ChatId = chatId, AvatarId = avatarId };
        await UICommander.Run(command);
    }

    private async Task OnDeleteAvatarClick() {
        var command = new Avatars_Change {
            Session = Session,
            AvatarId = ModalModel.AvatarId,
            ExpectedVersion = null,
            Change = Change.Remove<AvatarDiff>(),
        };
        await UICommander.Run(command);
        Modal.Close();
    }

    private void CloseModal()
        => Modal.Close();

    private void ChangeDefaultAvatar()
        => _form.IsDefault = !_form.IsDefault;

    [UnconditionalSuppressMessage("ReflectionAnalysis", "IL2026:RequiresUnreferencedCode", Justification = "String.Count should be preserved.")]
    public sealed class FormModel(ComponentIdGenerator? componentIdGenerator)
        : FormModel<FormModel>("avatar-editor", componentIdGenerator)
    {
        [Required] public string Name { get; set; } = "";
        public string NameFieldId { get; set; } = "";
        public string Bio { get; set; } = "";
        public string BioFieldId { get; set; } = "";
        public bool IsDefault { get; set; }
        public string IsDefaultFieldId { get; set; } = "";
        public bool IsActive { get; set; }
        public string IsActiveFieldId { get; set; } = "";
        public string Title { get; set; } = "";
        public Picture? Picture { get; set; }
        public AvatarFull? OriginalAvatar { get; set; }
    }

    // Nested types

    public sealed record Model(Symbol AvatarId, ChatId? ChatId, string Title);
}
