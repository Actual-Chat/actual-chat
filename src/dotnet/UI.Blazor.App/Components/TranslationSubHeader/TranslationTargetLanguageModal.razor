@namespace ActualChat.UI.Blazor.App.Components
@implements IModalView<TranslationTargetLanguageModal.Model>
@using ActualChat.UI.Blazor.Events
@inherits ComputedStateComponent<AppUIHub, TranslationTargetLanguageModal.ComputedModel>
@{
    if (State.IsInitial(out var m))
        return;

    var ownMessagesStatus = m.TranslateOwnMessages ? L.RightPanel_On : L.RightPanel_Off;
    var translatedVoiceStatus = m.TranslatedVoiceOverride switch {
        true => L.Translation_TranslatedVoiceOnInChat,
        false => L.Translation_TranslatedVoiceOffInChat,
        null => m.IsTranslatedVoiceOn ? L.RightPanel_On : L.RightPanel_Off,
    };
}

<DialogFrame
    Title="@L.Translation_ModalTitle"
    Class="translation-language-modal modal-sm"
    NarrowViewSettings="DialogFrameNarrowViewSettings.Bottom">
    <Body>
    <FormBlock Class="first last c-languages">
        <div class="language-btn-group">
            <div class="c-title">
                @L.Translation_TranslateToColon
                <span @onclick="@OnOpenLanguageSettings" class="c-edit" role="button" tabindex="0"> @L.Translation_Setup</span>
            </div>
            <SegmentedSwitch
                Class="pill"
                Items="@BuildItems(m.Languages)"
                SelectedId="@m.Selected.Value"
                SelectedIdChanged="@OnLanguageIdChanged"/>
        </div>

        <TileItem Click="@OnTranslateOwnMessagesClick">
            <Content>@L.Translation_TranslateOwnMessages</Content>
            <Caption>@ownMessagesStatus</Caption>
            <Right>
                <Toggle
                    IsChecked="@m.TranslateOwnMessages"
                    IsCheckedChanged="@(_ => OnTranslateOwnMessagesClick())" />
            </Right>
        </TileItem>
        <TileItem Click="@OnTranslatedVoiceClick">
            <Content>@L.Transcription_TranslatedVoice</Content>
            <Caption>@translatedVoiceStatus</Caption>
            <Right>
                <Toggle
                    IsChecked="@m.IsTranslatedVoiceOn"
                    IsCheckedChanged="@(_ => OnTranslatedVoiceClick())" />
            </Right>
        </TileItem>
    </FormBlock>
    </Body>
</DialogFrame>

@code {
    private LanguageUI LanguageUI => Hub.LanguageUI;
    private TranslationUI TranslationUI => Hub.TranslationUI;

    [CascadingParameter] public Modal Modal { get; set; } = null!;
    [Parameter] public Model ModalModel { get; set; } = null!;

    protected override async Task<ComputedModel> ComputeState(CancellationToken cancellationToken) {
        var chatId = ModalModel.ChatId;
        var languages = await LanguageUI.ListSpoken(cancellationToken).ConfigureAwait(false);
        var translationLanguage = await TranslationUI
            .GetTranslationLanguage(chatId, cancellationToken)
            .ConfigureAwait(false);
        var translateOwnMessages = await TranslationUI
            .MustTranslateOwnMessages(chatId, cancellationToken)
            .ConfigureAwait(false);
        var isTranslatedVoiceOn = await TranslationUI.IsTranslatedVoiceOn(chatId, cancellationToken).ConfigureAwait(false);
        var translatedVoiceOverride = await TranslationUI
            .GetTranslatedVoiceOverride(chatId, cancellationToken)
            .ConfigureAwait(false);
        return new(languages, translationLanguage, chatId, translateOwnMessages, isTranslatedVoiceOn, translatedVoiceOverride);
    }

    private IReadOnlyList<SegmentedSwitchItem> BuildItems(IReadOnlyCollection<Language> languages) {
        var useShortTitle = languages.Count > 2;
        return languages.Select(l => new SegmentedSwitchItem(l.Value, useShortTitle ? l.ShortTitle : l.Title)).ToList();
    }

    private async Task OnLanguageIdChanged(string id) {
        if (State.Value is { } m) {
            await TranslationUI.SetTargetLanguage(m.ChatId, Language.Parse(id), CancellationToken.None);
            Modal.Close();
        }
    }

    private async Task OnTranslateOwnMessagesClick() {
        if (State.Value is { } m) {
            await TranslationUI.SetMustTranslateOwnMessages(m.ChatId, !m.TranslateOwnMessages, CancellationToken.None);
        }
    }

    private Task OnTranslatedVoiceClick()
        => State.Value is { } m
            ? TranslationUI.ToggleTranslatedVoice(m.ChatId, CancellationToken.None)
            : Task.CompletedTask;

    private Task OnOpenLanguageSettings()
        => UIEventHub.Publish(new ShowSettingsEvent(SettingsTabId.Transcription));

    // Nested types

    public sealed record ComputedModel(
        IReadOnlyCollection<Language> Languages,
        Language Selected,
        ChatId ChatId,
        bool TranslateOwnMessages,
        bool IsTranslatedVoiceOn,
        bool? TranslatedVoiceOverride);

    public sealed record Model(ChatId ChatId);
}
