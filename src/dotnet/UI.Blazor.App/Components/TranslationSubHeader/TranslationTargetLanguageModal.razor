@namespace ActualChat.UI.Blazor.App.Components
@implements IModalView<TranslationTargetLanguageModal.Model>
@using ActualChat.UI.Blazor.Events
@inherits ComputedStateComponent<AppUIHub, TranslationTargetLanguageModal.ComputedModel>
@{
    if (State.IsInitial(out var m))
        return;

    var ownMessagesStatus = m.TranslateOwnMessages ? "On" : "Off";
}

<DialogFrame
    Title="Translation language"
    Class="translation-language-modal modal-sm"
    NarrowViewSettings="DialogFrameNarrowViewSettings.Bottom">
    <Body>
    <FormBlock Class="first last c-languages">
        <div class="language-btn-group">
            <div class="c-title">
                Translate to:
                <span @onclick="@OnOpenLanguageSettings" class="c-edit" role="button" tabindex="0"> (setup)</span>
            </div>
            <div class="c-languages" role="listbox">
                @foreach (var l in m.Languages) {
                    <button
                        class="@(l == m.Selected ? "active" : "")"
                        role="option"
                        aria-selected="@((l == m.Selected) ? "true" : "false")"
                        @onclick="@(() => OnClick(l))">
                        @l.Title
                    </button>
                }
            </div>
        </div>

        <TileItem Click="@OnTranslateOwnMessagesClick">
            <Content>Translate own messages</Content>
            <Caption>@ownMessagesStatus</Caption>
            <Right>
                <Toggle
                    IsChecked="@m.TranslateOwnMessages"
                    IsCheckedChanged="@(_ => OnTranslateOwnMessagesClick())" />
            </Right>
        </TileItem>
    </FormBlock>
    </Body>
</DialogFrame>

@code {
    private LanguageUI LanguageUI => Hub.LanguageUI;
    private TranslationUI TranslationUI => Hub.TranslationUI;

    [CascadingParameter] public Modal Modal { get; set; } = null!;
    [Parameter] public Model ModalModel { get; set; } = null!;

    protected override async Task<ComputedModel> ComputeState(CancellationToken cancellationToken) {
        var chatId = ModalModel.ChatId;
        var languages = await LanguageUI.ListSpoken(cancellationToken).ConfigureAwait(false);
        var translationLanguage = await TranslationUI
            .GetTranslationLanguage(chatId, cancellationToken)
            .ConfigureAwait(false);
        var translateOwnMessages = await TranslationUI
            .MustTranslateOwnMessages(chatId, cancellationToken)
            .ConfigureAwait(false);
        return new(languages, translationLanguage, chatId, translateOwnMessages);
    }

    private async Task OnClick(Language language) {
        if (State.Value is { } m) {
            await TranslationUI.SetTargetLanguage(m.ChatId, language, CancellationToken.None);
            Modal.Close();
        }
    }

    private async Task OnTranslateOwnMessagesClick() {
        if (State.Value is { } m) {
            await TranslationUI.SetMustTranslateOwnMessages(m.ChatId, !m.TranslateOwnMessages, CancellationToken.None);
        }
    }

    private Task OnOpenLanguageSettings()
        => UIEventHub.Publish(new ShowSettingsEvent(SettingsTabId.Transcription));

    // Nested types

    public sealed record ComputedModel(
        IReadOnlyCollection<Language> Languages,
        Language Selected,
        ChatId ChatId,
        bool TranslateOwnMessages);

    public sealed record Model(ChatId ChatId);
}
