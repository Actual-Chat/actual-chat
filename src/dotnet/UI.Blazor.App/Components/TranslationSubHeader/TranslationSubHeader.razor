@namespace ActualChat.UI.Blazor.App.Components
@inherits ComputedStateComponent<AppUIHub, TranslationSubHeader.Model?>
@{
    var m = State.Value;
}

<SubHeader Class="translation-sub-header" IsVisible="@(m is not null)">
    <div class="c-content">
        <div class="c-left">
            <i class="icon-translation text-xl"></i>
        </div>

        <div class="c-center">
            <div class="c-text">
                Translate to
                <span class="c-language" @onclick="@OnLanguageClick">@m?.TranslationLanguage.Title</span>
            </div>
            <div class="c-toggle" @onclick="@OnToggleClick">
                <Toggle IsChecked="@(m?.IsOn ?? false)" IsCheckedChanged="@(_ => OnToggleClick())"/>
            </div>
        </div>

        <div class="c-right">
            <HeaderButton Click="@OnHideClick">
                <i class="icon-close-fill"></i>
            </HeaderButton>
        </div>
    </div>
</SubHeader>

@code {
    private TranslationUI TranslationUI => Hub.TranslationUI;
    private Chat Chat => ChatContext.Chat;

    [CascadingParameter] public ChatContext ChatContext { get; set; } = null!;

    protected override async Task<Model?> ComputeState(CancellationToken cancellationToken) {
        var chat = Chat;
        var isVisible = await TranslationUI.IsSubHeaderVisible(chat.Id, cancellationToken).ConfigureAwait(false);
        if (!isVisible)
            return null;

        var isOn = await TranslationUI.IsEnabled(chat.Id, cancellationToken).ConfigureAwait(false);
        var translationLanguage = await TranslationUI
            .GetTranslationLanguage(chat.Id, cancellationToken)
            .ConfigureAwait(false);
        return new(isOn ?? false, translationLanguage, chat);
    }

    private Task OnToggleClick()
        => State.Value is { } m
            ? TranslationUI.SetIsOn(m.Chat.Id, !m.IsOn)
            : Task.CompletedTask;

    private Task OnHideClick()
        => State.Value is { } m
            ? TranslationUI.SetIsSubHeaderVisible(m.Chat.Id, false)
            : Task.CompletedTask;

    private Task OnLanguageClick()
        =>  State.Value is { } m
            ? ModalUI.Show(new TranslationTargetLanguageModal.Model(State.Value.Chat.Id))
            : Task.CompletedTask;

    // Nested types

    public sealed record Model(
        bool IsOn,
        Language TranslationLanguage,
        Chat Chat);
}
