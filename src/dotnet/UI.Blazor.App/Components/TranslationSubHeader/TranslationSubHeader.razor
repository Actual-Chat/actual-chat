@namespace ActualChat.UI.Blazor.App.Components
@inherits ComputedStateComponent<AppUIHub, TranslationSubHeader.Model?>
@{
    if (State.IsInitial(out var m) || m is null)
        return;
}

<div class="translation-sub-header">
    <div class="c-content">
        <div class="c-left">
            <i class="icon-language text-xl"></i>
        </div>

        <div class="c-center">
            <div class="c-text">
                Translate to
                <span class="c-language">@m.TargetLanguage.Title</span>
            </div>
            <div class="c-toggle" @onclick="@OnToggleClick">
                <Toggle IsChecked="@m.IsOn"/>
            </div>
        </div>

        <div class="c-right">
            <HeaderButton Click="@OnClick">
                <i class="icon-more-vertical"></i>
            </HeaderButton>
        </div>
    </div>
</div>

@code {
    private TranslationUI TranslationUI => Hub.TranslationUI;

    [Parameter, EditorRequired] public Chat Chat { get; set; } = null!;

    protected override async Task<Model?> ComputeState(CancellationToken cancellationToken) {
        var chat = Chat;
        var isIncompleteUIEnabled = await Features.IsIncompleteUIEnabled(cancellationToken).ConfigureAwait(false);
        if (!isIncompleteUIEnabled)
            return null;

        var mustSuggest = await TranslationUI.MustSuggest(chat.Id, cancellationToken).ConfigureAwait(false);
        if (!mustSuggest)
            return null;

        var isOn = await TranslationUI.IsOn(chat.Id, cancellationToken).ConfigureAwait(false);
        var targetLanguage = await TranslationUI.GetTargetLanguage(chat.Id, cancellationToken).ConfigureAwait(false);
        return new(isOn ?? false, targetLanguage, chat);
    }

    private Task OnToggleClick()
        => State.Value is { } m
            ? TranslationUI.SetIsOn(m.Chat.Id, !m.IsOn)
            : Task.CompletedTask;

    private void OnClick() {
        if (State.Value is { } m)
            ModalUI.Show(new TranslationSettingsModal.Model(m.Chat.Id));
    }

    // Nested types

    public sealed record Model(
        bool IsOn,
        Language TargetLanguage,
        Chat Chat);
}
