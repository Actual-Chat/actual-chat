@namespace ActualChat.UI.Blazor.App.Components
@inherits ComponentBase<AppUIHub>
@{
    var place = Place;
    var hasSearch = !IsNotifications;
}

@if (place != null) {
    <LeftPanelPlaceContentHeader Place="@place"/>
    @* The place variant's results cover the place header too, which nothing below the header can
       do - so they stay a full-panel overlay instead of a swap in the main area. *@
    @if (hasSearch) {
        <div class="left-search-panel">
            <LeftChatSearchInput Place="@place"/>
            <LeftPlaceSearchOverlayPanel Place="@place"/>
        </div>
    }
} else {
    <LeftPanelChatContentHeader
        Title="@(IsNotifications ? L.Navbar_Notifications : L.Navbar_Chats)"
        Menu="@(IsNotifications ? MenuRef.New<NotificationsMenu>() : null)">
        @if (hasSearch) {
            <LeftChatSearchInput/>
        }
    </LeftPanelChatContentHeader>
}

@code {
    [Parameter] public Place? Place { get; set; }
    [Parameter] public bool IsNotifications { get; set; }
}
