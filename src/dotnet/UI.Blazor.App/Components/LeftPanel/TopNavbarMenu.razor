@namespace ActualChat.UI.Blazor.App.Components
@using ActualChat.UI.Blazor.Events
@using ActualChat.Contacts
@inherits ComputedMenuBase<AccountFull>
@{
    var m = State.Value;
}

@if (!_notesChatId.IsNone) {
    <MenuEntry
        Icon="icon-file-text"
        Text="Notes"
        Click="@OnNotesClick">
    </MenuEntry>
}
<MenuEntry
    Icon="icon-settings"
    Text="Settings"
    Click="@OnSettingsClick">
</MenuEntry>
<MenuEntry
    Icon="icon-log-out"
    Text="Log out"
    Click="@SignOut">
</MenuEntry>
@if (m.IsAdmin) {
    <Separator Title="For Admins" WithLine="true" />
    <MenuEntry
        Icon="icon-alert-triangle"
        Text="Test Pages"
        Click="@OnTestPagesClick">
    </MenuEntry>
    <MenuEntry
        Icon="icon-adminx-1"
        Text="Administration"
        Click="@OnAdminPagesClick">
    </MenuEntry>
    <MenuEntry
        Icon="icon-refresh"
        Text="Reload UI"
        Click="@OnReloadUIClick">
    </MenuEntry>
}

@code {
    private ChatId _notesChatId = ChatId.None;

    [Inject] protected ChatUIHub Hub { get; init; } = null!;

    private UIEventHub UIEventHub => Hub.UIEventHub();
    private NavbarUI NavbarUI => Hub.NavbarUI;
    private AccountUI AccountUI => Hub.AccountUI;
    private Session Session => Hub.Session();
    private IContacts Contacts => Hub.Contacts;
    private IChats Chats => Hub.Chats;
    private History History => Hub.History;
    private TuneUI TuneUI => Hub.TuneUI;

    protected override ComputedState<AccountFull>.Options GetStateOptions()
        => new() {
            InitialValue = AccountUI.OwnAccount.Value,
            Category = ComputedStateComponent.GetStateCategory(GetType()),
        };

    protected override async Task<AccountFull> ComputeState(CancellationToken cancellationToken) {
        var ownAccount = await AccountUI.OwnAccount.Use(cancellationToken).ConfigureAwait(false);
        if (_notesChatId.IsNone) {
            var contactIds = await Contacts.ListIds(Session, PlaceId.None, cancellationToken).ConfigureAwait(false);
            var contactList = await contactIds
                .Select(x => Contacts.Get(Session, x, cancellationToken))
                .Collect(cancellationToken)
                .ConfigureAwait(false);

            foreach (var contact in contactList) {
                if (contact == null)
                    continue;
                var chatId = contact.ChatId;
                if (chatId.IsPeerChat(out _))
                    continue;
                var chat = await Chats.Get(Session, contact.ChatId, cancellationToken).ConfigureAwait(false);
                if (chat != null && chat.SystemTag == Constants.Chat.SystemTags.Notes)
                    _notesChatId = chat.Id;
            }
        }
        return ownAccount;
    }

    private async Task OnNotesClick() {
        await WhenClosed;
        _ = History.NavigateTo(Links.Chat(_notesChatId));
    }

    private async Task OnSettingsClick() {
        await WhenClosed;
        _ = UIEventHub.Publish(new ShowSettingsEvent());
    }

    private async Task SignOut() {
        await WhenClosed;
        _ = Hub.AccountUI.SignOut();
    }

    private async Task OnTestPagesClick() {
        await WhenClosed;
        NavbarUI.SelectGroup(NavbarGroupIds.TestPages, true);
        _ = TuneUI.Play(Tune.SelectNavbarItem).SilentAwait();
    }

    private async Task OnAdminPagesClick() {
        await WhenClosed;
        NavbarUI.SelectGroup(NavbarGroupIds.Administration, true);
        _ = TuneUI.Play(Tune.SelectNavbarItem).SilentAwait();
    }

    private async Task OnReloadUIClick() {
        await WhenClosed;
        Services.GetRequiredService<ReloadUI>().Reload();
    }
}
