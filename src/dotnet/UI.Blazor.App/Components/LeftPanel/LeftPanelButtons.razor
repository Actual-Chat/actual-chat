@namespace ActualChat.UI.Blazor.App.Components
@inherits ComputedStateComponent<AppUIHub, LeftPanelButtons.Model>
@{
    var m = State.Value;
}

<div class="left-panel-buttons">
    <div class="c-spacer"></div>
    <div class="c-content">
        <div class="safe-area-top"></div>
        <NavbarButton
            Class="settings-btn"
            data-menu="@(MenuRef.New<NavbarLogoMenu>())"
            data-menu-trigger="@MenuTrigger.Primary"
            data-menu-placement="@(FloatingPosition.RightStart.ToPositionString())">
            <ChildContent>
                <img draggable="false" src="/dist/images/voxt-icon-color.svg" alt="voxt-icon" class="voxt-btn">
            </ChildContent>
            <Ending>
                <LeftLine/>
                <div class="right-line"></div>
            </Ending>
        </NavbarButton>
        <div class="c-buttons">
            <NavbarButtons/>
        </div>
        @if (m.IsActive && (m.HasUnread || m.HasRetained || m.HasReactions)) {
            <NavbarGroupSelectionButton
                Class="create-btn"
                Id="@NavbarGroupIds.Unread"
                Title="@L.Navbar_Unread"
                Tooltip="@L.Navbar_Notifications">
                <ChildContent>
                    <i class="icon-notify-bell text-2xl font-medium"></i>
                </ChildContent>
                <BadgeContent>
                    @if (m.HasUnread || m.HasReactions) {
                        <Badge Class="c-unread-dot" Color="bg-danger"/>
                    }
                </BadgeContent>
            </NavbarGroupSelectionButton>
        }
        <AccountDropdown/>
        <div class="safe-area-bottom"></div>
    </div>
</div>

@code {
    private bool _hadAny;

    private ChatListUI ChatListUI => Hub.ChatListUI;
    private NavbarUI NavbarUI => Hub.NavbarUI;
    private NotificationsPanelUI NotificationsPanelUI => Hub.NotificationsPanelUI;
    private NotificationsUI NotificationsUI => Hub.NotificationsUI;

    protected override ComputedState<Model>.Options GetStateOptions()
        => new() {
            InitialValue = new(AccountUI.OwnAccount.Value is { IsGuest: false } a && a.IsActive()),
            Category = GetStateCategory(GetType()),
        };

    protected override async Task<Model> ComputeState(CancellationToken cancellationToken) {
        var account = await AccountUI.OwnAccount.Use(cancellationToken).ConfigureAwait(true);
        // IsActive() alone lets a guest through - a guest account is Active - and a signed-out
        // visitor has no notifications to show.
        if (account.IsGuest || !account.IsActive())
            return new(false);

        var chatById = await ChatListUI
            .ListUnordered(null, ChatListFilter.Unread, cancellationToken)
            .ConfigureAwait(true);
        var expiring = await NotificationsPanelUI
            .GetExpiring(ChatListFilter.Unread.Id, cancellationToken)
            .ConfigureAwait(true);
        var reactedChatIds = await NotificationsUI
            .ListReactedChatIds(cancellationToken)
            .ConfigureAwait(true);
        return new(true, chatById.Count > 0, expiring.Count > 0, reactedChatIds.Count > 0);
    }

    protected override void OnAfterRender(bool firstRender) {
        var m = State.Value;
        // The Unread group stays selected while the panel still retains recently-read chats;
        // once there's nothing unread, retained, or reacted, we fall back to Chats.
        if (_hadAny && !m.HasUnread && !m.HasRetained && !m.HasReactions
            && NavbarUI.SelectedGroupId == NavbarGroupIds.Unread)
            NavbarUI.SelectGroup(NavbarGroupIds.Chats, false);

        _hadAny = m.IsActive && (m.HasUnread || m.HasRetained || m.HasReactions);
    }

    // Nested types

    public sealed record Model(
        bool IsActive = false,
        bool HasUnread = false,
        bool HasRetained = false,
        bool HasReactions = false);
}
