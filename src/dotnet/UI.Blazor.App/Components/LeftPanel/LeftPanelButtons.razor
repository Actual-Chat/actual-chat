@namespace ActualChat.UI.Blazor.App.Components

<div class="left-panel-buttons">
    <div class="c-spacer"></div>
    <div class="c-content">
        <div class="safe-area-top"></div>
        <NavbarButton
            Class="settings-btn"
            data-menu="@(MenuRef.New<NavbarLogoMenu>())"
            data-menu-trigger="@MenuTrigger.Primary"
            data-menu-placement="@(FloatingPosition.RightStart.ToPositionString())">
            <ChildContent>
                <img draggable="false" src="/dist/images/voxt-icon-color.svg" alt="voxt-icon" class="voxt-btn">
            </ChildContent>
            <Ending>
                <LeftLine/>
                <div class="right-line"></div>
            </Ending>
        </NavbarButton>
        <div class="c-buttons">
            <NavbarButtons/>
        </div>
        <AccountDropdown/>
        <div class="safe-area-bottom"></div>
    </div>
</div>
