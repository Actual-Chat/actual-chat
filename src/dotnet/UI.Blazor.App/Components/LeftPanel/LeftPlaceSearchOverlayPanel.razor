@namespace ActualChat.UI.Blazor.App.Components
@inherits ComputedStateComponent<AppUIHub, LeftPlaceSearchOverlayPanel.Model>
@{
    var m = State.Value;
    var cls = m.IsOpen ? "open" : "closed";
    _shouldRenderContent |= m.IsOpen;
    var tabs = new TabDef[] {
        new("chats", L.Navbar_Chats) {
            Content = @<div class="c-container"><ChatSearchTab Place="@Place"/></div>,
        },
        new("ai-search", L.Common_Search) {
            Content = @<div class="c-container">
                           <RecentlyViewedGroups
                               Title="@L.Search_RecentSearches"
                               ListKind="@ChatUsageListKind.SearchChats"
                               Place="@Place"/>
                       </div>,
        },
        new("Threads", L.RightPanel_TabThreads) { Content = @<ToBeDone/> },
        new("tags", L.Search_TabTags) { Content = @<ToBeDone/> },
        new("media", L.RightPanel_TabMedia) { Content = @<ToBeDone/> },
    };
}

<div class="left-search-overlay-panel left-place-search-overlay-panel @cls" inert="@(!m.IsOpen)" @onmousedown:preventDefault="true">
    <ErrorBarrier Name="LeftPanelContentOverlay" Kind="@ErrorBarrierKind.Full">
        @if (_shouldRenderContent) {
            @if (m.EnableIncompleteUI) {
                <TabPanel
                    @key="@("left-place-search-panel")"
                    Tabs="@tabs"
                    TabsClass="left-panel-tabs wide-left-panel-tabs"
                    BottomHill="true"
                    SwapKind="@TabContentSwap.Swipe"/>
            } else {
                // TODO: remove when migrated to markup above
                <div class="c-search-tab c-container">
                    <ChatSearchTab Place="@Place"/>
                </div>
            }
        }
    </ErrorBarrier>
</div>

@code {
    private bool _shouldRenderContent;

    private SearchUI SearchUI => Hub.SearchUI;

    [Parameter] public Place? Place { get; set; }

    protected override ComputedState<Model>.Options GetStateOptions()
        => ComputedStateComponent.GetStateOptions(GetType(),
            t => new ComputedState<Model>.Options() {
                InitialValue = new Model(SearchUI.IsSearchModeOn.ValueOrDefault || SearchUI.IsShowRecentOn.ValueOrDefault, false),
                UpdateDelayer = FixedDelayer.NextTick,
                Category = GetStateCategory(t),
            });

    protected override async Task<Model> ComputeState(CancellationToken cancellationToken) {
        var isOpen = await SearchUI.IsSearchModeOn.Use(cancellationToken).ConfigureAwait(false)
                     || await SearchUI.IsShowRecentOn.Use(cancellationToken).ConfigureAwait(false);
        var enableIncompleteUI = await Features.IsIncompleteUIEnabled(cancellationToken).ConfigureAwait(false);
        return new Model(isOpen, enableIncompleteUI);
    }

    // Nested types

    public sealed record Model(bool IsOpen, bool EnableIncompleteUI);
}
