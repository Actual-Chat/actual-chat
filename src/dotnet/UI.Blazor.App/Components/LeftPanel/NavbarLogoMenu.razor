@namespace ActualChat.UI.Blazor.App.Components
@using ActualChat.UI.Blazor.Events
@inherits ComputedMenuBase<AppUIHub, NavbarLogoMenu.Model>
@{
    var m = State.Value;
}

@if (m.NotesChat != null) {
    <MenuEntry
        Icon="icon-file-text"
        Text="Notes"
        Click="@OnNotesClick">
    </MenuEntry>
}
<MenuEntry
    Icon="icon-settings"
    Text="Settings"
    Click="@OnSettingsClick">
</MenuEntry>
<MenuEntry
    Icon="icon-refresh"
    Text="Reload"
    Click="@OnReloadClick">
</MenuEntry>
@if (m.Account.IsGuest) {
    <MenuEntry
        Icon="icon-log-in"
        Text="Sign in"
        Click="@SignIn">
    </MenuEntry>
} else {
    <MenuEntry
        Icon="icon-log-out"
        Text="Log out"
        Click="@SignOut">
    </MenuEntry>
}
@if (m.Account.IsAdmin) {
    <MenuEntrySeparator/>
    <MenuEntry
        Icon="icon-alert-triangle"
        Text="Test Pages"
        Click="@OnTestPagesClick">
    </MenuEntry>
}

@code {
    private NavbarUI NavbarUI => Hub.NavbarUI;
    private ChatListUI ChatListUI => Hub.ChatListUI;

    protected override ComputedState<Model>.Options GetStateOptions()
        => new() {
            InitialValue = new Model(AccountUI.OwnAccount.Value, ChatListUI.NotesChat.Value),
            Category = GetStateCategory(GetType()),
        };

    protected override async Task<Model> ComputeState(CancellationToken cancellationToken) {
        var ownAccount = await AccountUI.OwnAccount.Use(cancellationToken).ConfigureAwait(false);
        var notesChat = await ChatListUI.NotesChat.Use(cancellationToken).ConfigureAwait(false);
        return new (ownAccount, notesChat);
    }

    private async Task OnNotesClick() {
        await WhenClosed;
        if (State.Value.NotesChat is { } notes)
            _ = History.NavigateTo(Links.Chat(notes.Id));
    }

    private async Task OnSettingsClick() {
        await WhenClosed;
        _ = UIEventHub.Publish(new ShowSettingsEvent());
    }

    private async Task SignIn() {
        await WhenClosed;
        _ = ModalUI.Show(new SignInModal.Model());
    }

    private async Task SignOut() {
        await WhenClosed;
        _ = Hub.AccountUI.SignOut();
    }

    private async Task OnTestPagesClick() {
        await WhenClosed;
        NavbarUI.SelectGroup(NavbarGroupIds.TestPages, true);
        _ = History.NavigateTo(Links.TestPageHome);
        _ = TuneUI.Play(Tune.SelectNavbarItem).SilentAwait();
    }

    private async Task OnReloadClick() {
        await WhenClosed;
        Services.GetRequiredService<ReloadUI>().Reload();
    }

    // Nested types

    public sealed record Model(AccountFull Account, ChatInfo? NotesChat);
}
