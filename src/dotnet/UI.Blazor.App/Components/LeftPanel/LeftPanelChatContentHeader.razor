@namespace ActualChat.UI.Blazor.App.Components

<div class="left-panel-content-header">
    <div class="c-content">
        <div class="c-title">
            @Title
        </div>
        @if (Menu is { } menu) {
            <ButtonRound Class="btn-sm btn-transparent"
                         data-menu="@menu.ToString()"
                         data-menu-trigger="@MenuTrigger.Primary"
                         data-menu-placement="@(FloatingPosition.BottomEnd.ToPositionString())">
                <i class="icon-more-vertical text-2xl"></i>
            </ButtonRound>
        }
    </div>
</div>

@code {
    [Parameter] public string Title { get; set; } = "Chats";
    [Parameter] public MenuRef? Menu { get; set; }
}
