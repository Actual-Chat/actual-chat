@namespace ActualChat.UI.Blazor.App.Components
@inherits ComputedStateComponent<AppUIHub, IReadOnlyList<Chat>>
@{
    if (State.IsInitial(out var chats) || chats.Count == 0)
        return;
}

<div class="recently-viewed-groups">
    <div class="c-header">
        <div class="c-title">@(Title ?? L.Search_RecentlyViewed)</div>
    </div>
    <div class="chat-list">
        @foreach (var chat in chats) {
            // TODO: replace with chat item for search results
            <ChatListItem Chat="@chat" ListKind="ChatListKind.All" />
        }
    </div>
</div>

@code {
    private IChats Chats => Hub.Chats;
    private IChatUsages ChatUsages => Hub.ChatUsages;

    [Parameter] public string? Title { get; set; }
    [Parameter] public ChatUsageListKind ListKind { get; set; } = ChatUsageListKind.ViewedGroupChats;
    [Parameter] public Place? Place { get; set; }

    protected override async Task<IReadOnlyList<Chat>> ComputeState(CancellationToken cancellationToken) {
        var session = Hub.Session;
        var recentChatIds = await ChatUsages.GetRecencyList(session, ListKind, cancellationToken).ConfigureAwait(false);
        var chats = await recentChatIds
            .Select(id => Chats.Get(session, id, cancellationToken))
            .Collect(ApiConstants.Concurrency.High, cancellationToken)
            .ConfigureAwait(false);
        if (Place is not null) {
            chats = chats
                .SkipNullItems()
                .Where(chat => (chat.Id as PlaceChatId)?.PlaceId == Place.Id)
                .ToArray();
        }
        return chats.SkipNullItems().ToList();
    }
}
