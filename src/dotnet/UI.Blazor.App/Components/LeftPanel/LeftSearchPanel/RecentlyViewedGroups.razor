@namespace ActualChat.UI.Blazor.App.Components
@inherits ComputedStateComponent<AppUIHub, IReadOnlyList<Chat>>
@{
    if (State.IsInitial(out var chats) || chats.Count == 0)
        return;
}

<div class="recently-viewed-groups">
    <div class="c-header">
        <div class="c-title">@L.Search_RecentlyViewed</div>
    </div>
    <div class="chat-list">
        @foreach (var chat in chats) {
            // TODO: replace with chat item for search results
            <ChatListItem Chat="@chat" ListKind="ChatListKind.All" />
        }
    </div>
</div>
<ContentSwapDisplay/>

@code {
    [Parameter] public Place? Place { get; set; }

    protected override async Task<IReadOnlyList<Chat>> ComputeState(CancellationToken cancellationToken) {
        var chats = await Hub.ChatListUI
            .ListRecent(Place?.Id, ChatListFilter.Groups, ChatListUI.HalfLoadLimit, cancellationToken)
            .ConfigureAwait(false);
        return chats.Select(c => c.Chat).ToList();
    }
}
