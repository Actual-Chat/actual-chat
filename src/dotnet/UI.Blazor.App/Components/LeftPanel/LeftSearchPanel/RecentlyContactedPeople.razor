@namespace ActualChat.UI.Blazor.App.Components
@inherits ComputedStateComponent<AppUIHub, IReadOnlyList<Chat>>
@{
    var chats = State.ValueOrDefault ?? [];
    if (chats.Count == 0)
        return;
}

<div class="recently-contacted-people no-scrollbar">
    @foreach (var chat in chats) {
        <RecentlyContactedUser Chat="chat"/>
    }
</div>
<Divider Class="mx-4 my-1.5"/>
<ContentSwapDisplay/>

@code {
    [Parameter] public Place? Place { get; set; }

    private IChats Chats => Hub.Chats;
    private IChatUsages ChatUsages => Hub.ChatUsages;

    protected override ComputedState<IReadOnlyList<Chat>>.Options GetStateOptions()
        => ComputedStateComponent.GetStateOptions(GetType(),
            static t => new ComputedState<IReadOnlyList<Chat>>.Options() {
                InitialValue = [],
                Category = GetStateCategory(t),
            });

    protected override async Task<IReadOnlyList<Chat>> ComputeState(CancellationToken cancellationToken) {
        var session = Session;
        var place = Place;
        var recentIds = await ChatUsages.GetRecencyList(session, ChatUsageListKind.PeerChatsWroteTo, cancellationToken).ConfigureAwait(false);
        if (ReferenceEquals(place, null)) {
            var chats = await recentIds
                .Select(id => Chats.Get(session, id, cancellationToken))
                .Collect(ApiConstants.Concurrency.High, cancellationToken)
                .ConfigureAwait(false);
            return chats.SkipNullItems().ToList();
        } else {
            // TODO: need to filter by place id on backend side
            var placeUserIds = await Hub.Places.ListUserIds(session, place.Id, cancellationToken).ConfigureAwait(false);
            var chats = await recentIds
                .Where(id => {
                    if (id is not PeerChatId peerChatId)
                        return false;

                    var peerUserId = peerChatId.AnotherUserIdOrNull(Hub.AccountUI.OwnAccount.Value.Id);
                    return peerUserId is not null && placeUserIds.Contains(peerUserId);
                })
                .Select(id => Chats.Get(session, id, cancellationToken))
                .Collect(ApiConstants.Concurrency.High, cancellationToken)
                .ConfigureAwait(false);
            return chats.SkipNullItems().ToList();
        }
    }
}
