@namespace ActualChat.UI.Blazor.App.Components
@inherits ComputedStateComponent<AppUIHub, IReadOnlyList<Chat>>
@{
    var chats = State.ValueOrDefault ?? [];
    if (chats.Count == 0)
        return;
}

<div class="recently-contacted-people no-scrollbar">
    @foreach (var chat in chats) {
        <RecentlyContactedUser Chat="chat"/>
    }
</div>
<Divider Class="mx-4 my-1.5"/>
<ContentSwapDisplay/>

@code {
    [Parameter] public Place? Place { get; set; }

    protected override ComputedState<IReadOnlyList<Chat>>.Options GetStateOptions()
        => ComputedStateComponent.GetStateOptions(GetType(),
            static t => new ComputedState<IReadOnlyList<Chat>>.Options() {
                InitialValue = [],
                Category = GetStateCategory(t),
            });

    protected override async Task<IReadOnlyList<Chat>> ComputeState(CancellationToken cancellationToken) {
        var chats = await Hub.ChatListUI
            .ListRecent(Place?.Id, ChatListFilter.People, ChatListUI.HalfLoadLimit, cancellationToken)
            .ConfigureAwait(false);
        return chats.Select(c => c.Chat).ToList();
    }
}
