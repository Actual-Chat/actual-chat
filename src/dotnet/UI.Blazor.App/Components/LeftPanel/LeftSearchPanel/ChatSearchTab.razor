@namespace ActualChat.UI.Blazor.App.Components
@using SearchUI = ActualChat.UI.Blazor.App.Services.SearchUI
@inherits ComputedStateComponent<AppUIHub, bool>

@if (!State.Value) {
    <RecentlyContactedPeople Place="@Place"/>
    <RecentlyViewedGroups Place="@Place"/>
} else {
    <FoundChatList Place="@Place"/>
}

@code {
    [Parameter] public Place? Place { get; set; }

    private SearchUI SearchUI => Hub.SearchUI;

    protected override Task<bool> ComputeState(CancellationToken cancellationToken)
        => SearchUI.IsSearchModeOn.Use(cancellationToken);
}
