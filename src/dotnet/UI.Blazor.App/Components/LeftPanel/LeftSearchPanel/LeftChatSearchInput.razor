@namespace ActualChat.UI.Blazor.App.Components
@using ActualChat.UI.Blazor.App.Events
@inherits ComputedStateComponent<AppUIHub, LeftChatSearchInput.Model>
<OnUIEvent TEvent="SearchClearedEvent" Handler="OnSearchCleared" />
@{
    var m = State.Value;
    var cls = m.IsOpen ? "open" : "closed";
    var placeCls = ReferenceEquals(Place, null) ? "" : "place";
    var showLocationBadge = m.LocationFilter != SearchLocationFilter.Anywhere;
    var showTypeBadge = m.TypeFilter != SearchTypeFilter.Anything;
}

<div class="left-chat-search-input @cls @placeCls">
    <Hotkey Keys="ctrl+f" AriaLabel="Search" OnTrigger="OnSearchHotkey"/>
    @if (m.IsOpen) {
        <Hotkey Keys="escape" AriaLabel="Close search" OnTrigger="@(() => OnClick(false))"/>
    }
    <div class="c-search">
        <div class="search-input">
            <label>
                <TextInput
                    @ref="_inputRef"
                    Text="@m.InitialText"
                    Class="w-full dialog-unstyled"
                    Placeholder="@Placeholder"
                    MaxLength="@MaxLength"
                    CloseOnBlurSelector=".left-chat-search-input"
                    OnFocus="@(_ => OnClick(true))"
                    OnBlur="@OnInputBlur"
                    TextChanged="OnSearchInputTextChanged">
                </TextInput>
                <HeaderButton
                    Class="c-filter-btn btn-lg"
                    data-menu="@(MenuRef.New<SearchFilterMenu>())"
                    data-menu-trigger="@MenuTrigger.Primary"
                    data-menu-placement="@(FloatingPosition.BottomStart.ToPositionString())">
                    <i class="icon-options-2 text-xl"></i>
                </HeaderButton>

                <ButtonRound Click="@OnSearchButtonClick" Class="c-ai-btn search-btn btn-transparent">
                    <i class="icon-search text-xl"></i>
                </ButtonRound>
                <HeaderButton Click="@OnCloseClick" Class="c-close-btn">
                    <i class="icon-close text-2xl"></i>
                </HeaderButton>
            </label>
        </div>
    </div>
    @if (m.IsOpen && (showLocationBadge || showTypeBadge)) {
        <div class="c-filter-badges">
            @if (showLocationBadge) {
                <SearchFilterBadge
                    Text="@LocationBadgeText(m.LocationFilter)"
                    Click="@OnLocationBadgeClick" />
            }
            @if (showTypeBadge) {
                <SearchFilterBadge
                    Text="@TypeBadgeText(m.TypeFilter)"
                    Click="@OnTypeBadgeClick" />
            }
        </div>
    }
</div>

@code {
    TextInput? _inputRef;
    bool _hasText;

    private SearchUI SearchUI => Hub.SearchUI;
    private NavbarUI NavbarUI => Hub.NavbarUI;

    [Parameter] public Place? Place { get; set; }
    [Parameter] public string Placeholder { get; set; } = "Search";
    [Parameter] public int? MaxLength { get; set; }

    public override ValueTask DisposeAsync() {
        SearchUI.ShowRecent(false);
        SearchUI.ResetFilters();
        return base.DisposeAsync();
    }

    protected override ComputedState<Model>.Options GetStateOptions()
        => ComputedStateComponent.GetStateOptions(GetType(),
            t => new ComputedState<Model>.Options() {
                InitialValue = new Model(
                    SearchUI.IsSearchModeOn.ValueOrDefault,
                    SearchUI.Text.ValueOrDefault ?? "",
                    SearchUI.LocationFilter.ValueOrDefault,
                    SearchUI.TypeFilter.ValueOrDefault),
                UpdateDelayer = FixedDelayer.NextTick,
                Category = GetStateCategory(t),
            });

    protected override async Task<Model> ComputeState(CancellationToken cancellationToken) {
        var isOpen = await SearchUI.IsSearchModeOn.Use(cancellationToken).ConfigureAwait(false)
                     || await SearchUI.IsShowRecentOn.Use(cancellationToken).ConfigureAwait(false);
        var locationFilter = await SearchUI.LocationFilter.Use(cancellationToken).ConfigureAwait(false);
        var typeFilter = await SearchUI.TypeFilter.Use(cancellationToken).ConfigureAwait(false);
        var initialText = SearchUI.Text.Value; // .Value instead of .Use() is intentional here (AY: why?)
        _hasText = !initialText.IsNullOrEmpty();
        return new Model(isOpen, initialText, locationFilter, typeFilter);
    }

    private void OnClick(bool openPanel) {
        if (!openPanel)
            Cancel();
        var wasOpen = SearchUI.IsShowRecentOn.Value || SearchUI.IsSearchModeOn.Value;
        SearchUI.ShowRecent(openPanel);
        SearchUI.PlaceId.Value = Place?.Id;
        if (openPanel != wasOpen)
            SearchUI.ResetFilters();
        StateHasChanged();
    }

    private void OnSearchButtonClick()
        => _inputRef?.Focus();

    private void OnSearchHotkey() {
        var isOpen = SearchUI.IsShowRecentOn.Value || SearchUI.IsSearchModeOn.Value;
        if (isOpen)
            OnClick(false);
        else
            _ = _inputRef?.Focus();
    }

    private void OnSearchInputTextChanged(string text) {
        // Empty input restores the place filter (a fresh search defaults to in-place);
        // any non-empty input keeps whatever filter the user has set (Place may be null
        // if the badge was removed).
        SearchUI.PlaceId.Value = text.IsNullOrEmpty()
            ? GetNavbarPlaceId()
            : Place?.Id;
        SearchUI.Text.Value = text;
        UpdateHasText(text);
    }

    private PlaceId? GetNavbarPlaceId()
        => NavbarUI.IsPlaceSelected(out var placeId) ? placeId : null;

    private void OnCloseClick() {
        if (_hasText) {
            _ = _inputRef?.Clear();
            UpdateHasText("");
        } else {
            OnClick(false);
        }
    }

    private void OnInputBlur() {
        if (!_hasText)
            OnClick(false);
    }

    private void OnLocationBadgeClick()
        => SearchUI.SetLocationFilter(SearchLocationFilter.Anywhere);

    private void OnTypeBadgeClick()
        => SearchUI.SetTypeFilter(SearchTypeFilter.Anything);

    private static string LocationBadgeText(SearchLocationFilter filter) => filter switch {
        SearchLocationFilter.Chat => "Chat",
        SearchLocationFilter.Place => "Place",
        _ => "",
    };

    private static string TypeBadgeText(SearchTypeFilter filter) => filter switch {
        SearchTypeFilter.People => "People",
        SearchTypeFilter.Groups => "Groups",
        SearchTypeFilter.Messages => "Messages",
        _ => "",
    };

    private void UpdateHasText(string text)
        => _hasText = !text.IsNullOrEmpty();

    private ValueTask Cancel()
        => _inputRef?.Clear() ?? default;

    private Task OnSearchCleared(SearchClearedEvent e, CancellationToken cancellationToken)
        => _inputRef?.Clear().AsTask() ?? Task.CompletedTask;

    // Nested types

    public sealed record Model(
        bool IsOpen,
        string InitialText,
        SearchLocationFilter LocationFilter,
        SearchTypeFilter TypeFilter);
}
