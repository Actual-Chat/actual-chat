@using ActualChat.Search
@namespace ActualChat.UI.Blazor.App.Components
@inherits ComputedStateComponent<AppUIHub, bool>
@{
    var isExpanded = State.Value;
    var btnText = isExpanded ? L.Search_ShowLess : L.Search_ShowMore;
    var isExpandedCls = isExpanded ? "expanded" : "";
    var isCollapsedCls = IsCollapsed ? "collapsed" : "";
    var title = IsGlobalSearchResult ? L.LeftPanel_PublicChatsAndPlaces : GetScopeTitle(Scope);
}

<div class="search-result-group-header @isExpandedCls @isCollapsedCls">
    <button type="button" class="c-title" @onclick="@OnTitleClick">
        <span class="c-title-text">@title</span>
        @if (IsCollapsed) {
            <i class="icon-chevron-right c-collapse-arrow"></i>
        }
    </button>
    @if (!IsCollapsed && CanExpandOrCollapse) {
        <Button Class="show-more-btn btn-transparent unhovered btn-sm" Click="@OnShowMoreClick">
            <i class="icon-chevron-up c-arrow"></i>
            <span class="c-text">@btnText</span>
        </Button>
    }
</div>

@code {
    private SearchUI SearchUI => Hub.SearchUI;

    [Parameter, EditorRequired] public bool CanExpandOrCollapse { get; set; }
    [Parameter, EditorRequired] public SearchScope Scope { get; set; }
    [Parameter, EditorRequired] public bool IsGlobalSearchResult { get; set; }
    [Parameter] public bool IsCollapsed { get; set; }

    private string GetScopeTitle(SearchScope scope)
        => scope switch {
            SearchScope.People => L.Search_TypePeople,
            SearchScope.Groups => L.Search_TypeGroups,
            SearchScope.Places => L.Search_TypePlaces,
            SearchScope.Messages => L.Search_TypeMessages,
            _ => scope.ToString(),
        };

    private Task OnTitleClick()
        => SearchUI.ToggleGroupCollapse(new SearchResultGroupKey(Scope, IsGlobalSearchResult));

    private async Task OnShowMoreClick(MouseEventArgs e) {
        var scope = Scope;
        if (State.ValueOrDefault)
            await SearchUI.ShowLess(scope);
        else
            await SearchUI.ShowMore(scope);
    }

    protected override Task<bool> ComputeState(CancellationToken cancellationToken)
        => SearchUI.IsExpanded(Scope);
}
