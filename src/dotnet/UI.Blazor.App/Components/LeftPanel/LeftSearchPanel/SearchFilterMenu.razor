@namespace ActualChat.UI.Blazor.App.Components
@inherits Menu<AppUIHub>
@{
    var location = SearchUI.LocationFilter.ValueOrDefault;
    var type = SearchUI.TypeFilter.ValueOrDefault;
    var hasPlace = ChatUI.SelectedChatId.ValueOrDefault is PlaceChatId;
}

<div class="search-filter-menu">
    <div class="c-section">
        <div class="c-section-title">@L.Search_LocationTitle</div>
        @RenderLocation(SearchLocationFilter.Anywhere, L.Search_LocationAnywhere)
        @RenderLocation(SearchLocationFilter.Chat, L.Search_LocationInChat)
        @if (hasPlace) {
            @RenderLocation(SearchLocationFilter.Place, L.Search_LocationInPlace)
        }
    </div>
    <div class="c-section">
        <div class="c-section-title">@L.Search_TypeTitle</div>
        @RenderType(SearchTypeFilter.Anything, L.Search_TypeAnything)
        @RenderType(SearchTypeFilter.People, L.Search_TypePeople)
        @RenderType(SearchTypeFilter.Groups, L.Search_TypeGroups)
        @RenderType(SearchTypeFilter.Messages, L.Search_TypeMessages)
        @RenderType(SearchTypeFilter.MyMessages, L.Search_TypeMyMessages)
    </div>
</div>

@code {
    private SearchUI SearchUI => Hub.SearchUI;
    private ChatUI ChatUI => Hub.ChatUI;

    private RenderFragment RenderLocation(SearchLocationFilter value, string label)
        => RenderOption(label, SearchUI.LocationFilter.ValueOrDefault == value, () => SelectLocation(value));

    private RenderFragment RenderType(SearchTypeFilter value, string label)
        => RenderOption(label, SearchUI.TypeFilter.ValueOrDefault == value, () => SelectType(value));

    private RenderFragment RenderOption(string label, bool isSelected, Func<Task> onClick)
        => @<button type="button" class="@("c-option" + (isSelected ? " selected" : ""))" @onclick="@(_ => onClick())">
                <span class="c-radio"></span>
                <span class="c-label">@label</span>
            </button>;

    private async Task SelectLocation(SearchLocationFilter value) {
        SearchUI.SetLocationFilter(value);
        await Host.Hide();
    }

    private async Task SelectType(SearchTypeFilter value) {
        SearchUI.SetTypeFilter(value);
        await Host.Hide();
    }
}
