@using ActualChat.Media
@using System.ComponentModel.DataAnnotations
@inherits FusionComponentBase<AppUIHub>
@namespace ActualChat.UI.Blazor.App.Components

@{
#pragma warning disable IL2091
}

<Form @ref="_formRef" Model="@_form" Id="@_form.FormId">
    <FormBlock>
        <DataAnnotationsValidator/>

        <PicUpload
            Scope="@MediaUploadScopes.ForAccount(AccountUI.OwnAccount.Value)"
            MediaKind="@MediaKind.ChatPicture"
            Size="@SquareSize.Size24"
            Title="@_form.Title"
            Picture="@_form.Picture"
            AvatarKind="@AvatarKind"
            AvatarKey="@AvatarKey"
            Picked="@OnImagePicked"/>

        <FormSection
            For="() => _form.Title"
            Label="@L.Form_Title"
            InputId="@_form.TitleId"
            IsLabelInsideInput="true"
            Class="!mt-0 grow"
            IsRequired="true">
            <TextBox
                @bind-Value="@_form.Title"
                Id="@_form.TitleId"
                Autofocus="@ShouldAutoFocusField"
                Autocomplete="off"/>
        </FormSection>
        <FormSection
            For="() => _form.Description"
            Label="@L.Form_Description"
            InputId="@_form.DescriptionId"
            IsLabelInsideInput="true"
            Class="!mt-0 grow">
            <TextBox
                @bind-Value="@_form.Description"
                Id="@_form.DescriptionId"
                Autofocus="false"
                Autocomplete="off"/>
        </FormSection>
    </FormBlock>
    <FormBlock Title="@L.Place_TypeTitle" Class="with-input-radio">
        <InputRadioGroup Name="place_type" DisplayName="@L.Place_TypeTitle" @bind-Value="_form.IsPublic">
            <TileItem
                Class="@(_form.IsPublic ? "transparent selected" : "transparent")"
                Click="@(() => OnPublicChatClick(true))">
                <Icon>
                    <FormRadio Id="@_form.IsPublicTrueFormId" Value="@true"/>
                </Icon>
                <Content>
                    <Label InputId="@_form.IsPublicTrueFormId" Text="@L.Place_PublicPlace" IsRequired="true"></Label>
                </Content>
                <Caption>
                    @L.Place_PublicHint
                </Caption>
            </TileItem>
            <TileItem
                Class="@(!_form.IsPublic ? "transparent selected" : "transparent")"
                Click="@(() => OnPublicChatClick(false))">
                <Icon>
                    <FormRadio Id="@_form.IsPublicFalseFormId" Value="@false"/>
                </Icon>
                <Content>
                    <Label InputId="@_form.IsPublicFalseFormId" Text="@L.Place_PrivatePlace" IsRequired="true"></Label>
                </Content>
                <Caption>
                    @L.Place_PrivateHint
                </Caption>
            </TileItem>
        </InputRadioGroup>
    </FormBlock>

    <RenderIntoSlot Name="@ButtonsSlotName">
        @if (ScreenSize.IsWide()) {
            <Button
                Click="@(() => Cancelled())"
                Class="btn-modal">
                Cancel
            </Button>
        }
        <Button
            Click="@OnCreate"
            Type="@ButtonType.Button"
            IsDisabled="@(!context.Validate())"
            Class="btn-modal btn-primary">
            Create
        </Button>
    </RenderIntoSlot>
</Form>

@code {
    private static readonly AvatarKind AvatarKind = AvatarKind.Marble;
    private static readonly string AvatarKey = "a-random-string";
    private Form _formRef = null!;
    private FormModel _form = null!;
    private bool _isAdmin;

    [CascadingParameter] public ScreenSize ScreenSize { get; set; }
    [Parameter, EditorRequired] public string ButtonsSlotName { get; set; } = "";
    [Parameter, EditorRequired] public Action<Place, Chat?> PlaceCreated { get; set; } = null!;
    [Parameter, EditorRequired] public Action Cancelled { get; set; } = null!;

    protected override void OnInitialized() {
        _form = new(ComponentIdGenerator);
        _isAdmin = Hub.AccountUI.OwnAccount.Value.IsAdmin;
    }

    private void OnImagePicked(MediaRef mediaRef) {
        _form.Picture = new(mediaRef);
    }

    private void OnPublicChatClick(bool isPublic) {
        if (_form!.IsPublic == isPublic)
            return;
        _form!.IsPublic = isPublic;
        StateHasChanged();
    }

    private async Task OnCreate() {
        if (!_formRef.IsValid)
            return;
        try {
            var session = Hub.Session;
            var createPlaceCommand = new Places_Change {
                Session = session,
                PlaceId = default,
                ExpectedVersion = default,
                Change = new Change<PlaceDiff>() {
                    Create = new PlaceDiff {
                        Title = _form.Title,
                        Description = _form.Description,
                        IsPublic = _form.IsPublic,
                        MediaId = _form.Picture?.MediaRef?.MediaId,
                    }
                },
            };

            var (place, createPlaceError) = await Hub.UICommander.Run(createPlaceCommand, CancellationToken.None);
            if (createPlaceError != null)
                return;

            place.Require();

            // Create default chat. Later we should add place templates.
            var description = $"Welcome chat for {place.Title}";
            var createChatCommand = new Chats_Change {
                Session = session,
                ChatId = default,
                ExpectedVersion = null,
                Change = new() {
                    Create = new ChatDiff {
                        Title = Constants.Chat.System.Welcome.DefaultTitle,
                        Description = description,
                        Kind = null,
                        IsPublic = true,
                        MediaId = _form.Picture?.MediaRef?.MediaId,
                        SystemTag = Constants.Chat.System.Welcome,
                        PlaceId = place.Id
                    },
                },
            };
            var (chat, _) = await Hub.UICommander.Run(createChatCommand, CancellationToken.None);

            PlaceCreated(place, chat);
        }
        catch { // Intended: command errors are shown in the UI anyway
        }
    }

    [UnconditionalSuppressMessage("ReflectionAnalysis", "IL2026:RequiresUnreferencedCode", Justification = "String.Count should be preserved.")]
    public sealed class FormModel {
        [Required]
        public string Title { get; set; } = "";

        public string Description { get; set; } = "";
        public Picture? Picture { get; set; }
        public bool IsPublic { get; set; }

        public string FormId { get; }
        public string TitleId { get; }
        public string DescriptionId { get; }
        public string IsPublicTrueFormId { get; }
        public string IsPublicFalseFormId { get; }

        public FormModel(ComponentIdGenerator componentIdGenerator) {
            FormId = componentIdGenerator.Next("new-chat-form");
            TitleId = $"{FormId}-title";
            DescriptionId = $"{FormId}-description";
            var isPublicFormId = $"{FormId}-is-public";
            IsPublicTrueFormId = isPublicFormId + "-true";
            IsPublicFalseFormId = isPublicFormId + "-false";
        }
    }
}
