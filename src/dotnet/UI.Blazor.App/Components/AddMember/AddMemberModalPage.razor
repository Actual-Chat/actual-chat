@namespace ActualChat.UI.Blazor.App.Components
@inherits FusionComponentBase<AppUIHub>
@implements IDisposable

<FormBlock Class="with-contact-list">
    <MemberSelector
        @ref="_memberSelector"
        ListSource="@_backend"
        Changed="OnSelectionChanged" />
</FormBlock>
@if (_shareModel is not null) {
    @* TODO: need invite links for private places (for Alexey K) *@
    <FormBlock Class="share-block">
        <ShareActions Model="@_shareModel" ScanHandler="@OnQrScanned"/>
    </FormBlock>
}

@code {
    private DialogButtonInfo _submitButtonInfo = null!;
    private IMemberSelector _backend = null!;
    private MemberSelector? _memberSelector;
    private ShareModalModel? _shareModel;

    private CancellationTokenSource DisposeTokenSource { get; set; } = null!;
    private CancellationToken DisposeToken { get; set; }
    private bool CanInvite {
        set => _submitButtonInfo.CanExecute = value;
    }
    private IReadOnlySet<UserId> SelectedUserIds
        => _memberSelector?.SelectedUserIds.Value ?? ImmutableHashSet<UserId>.Empty;

    [CascadingParameter] public DiveInModalPageContext Context { get; set; } = null!;

    protected override void OnInitialized() {
        DisposeTokenSource = new();
        DisposeToken = DisposeTokenSource.Token;

        _submitButtonInfo = DialogButtonInfo.CreateSubmitButton(L.Common_Add, OnAdd);
        _submitButtonInfo.CanExecute = false;
        if (Context.Model is ChatId chatId)
            _backend = new NewChatMemberSelector(Hub, chatId);
        else if (Context.Model is PlaceId placeId) {
            _backend = new NewPlaceMemberSelector(Hub, placeId);
            // Stands in until the place's own model arrives: the row is there from the first frame
            _shareModel = new ShareModalModel(
                ShareKind.Place, L.Share_Place, "", new ShareRequest(Links.PlaceInfo(placeId)), null);
        } else
            throw StandardError.NotSupported("Not supported model type");
        Context.Title = L.AddMember_Title;
        Context.Class = "add-member-modal-content";
        Context.Buttons = [DialogButtonInfo.CreateCancelButton(L), _submitButtonInfo];
    }

    protected override async Task OnInitializedAsync() {
        var shareModel = Context.Model switch {
            PlaceId placeId => await Hub.ShareUI.GetModel(placeId, DisposeToken),
            ChatId chatId => await Hub.ShareUI.GetModel(chatId, DisposeToken),
            _ => null,
        };
        if (shareModel is not null)
            _shareModel = shareModel;
    }

    public void Dispose()
        => DisposeTokenSource.CancelAndDisposeSilently();

    private async Task OnAdd() {
        CanInvite = false;

        var userIds = SelectedUserIds.ToArray();
        var error = await _backend.Invite(userIds, DisposeToken);
        if (error != null)
            return;

        OnCancel();
    }

    private void OnCancel()
        => Context.Close();

    private async Task<bool> OnQrScanned(LocalUrl link) {
        // Someone's contact code, scanned from here, means "add them" rather than "open their chat" -
        // but ticked in the list, so the Add button still has the last word.
        var userId = await UserLinks.GetUserId(Hub.Aliases, link, DisposeToken);
        if (userId.IsGuestOrNull() || _memberSelector is null)
            return false;

        return await _memberSelector.Select(userId, DisposeToken);
    }

    private void OnSelectionChanged()
        => CanInvite = SelectedUserIds.Count > 0;
}
