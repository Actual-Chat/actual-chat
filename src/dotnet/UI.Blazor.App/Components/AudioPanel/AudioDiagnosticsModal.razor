@namespace ActualChat.UI.Blazor.App.Components.AudioPanel
@using ActualChat.Hosting
@using ActualChat.UI.Blazor.Services
@inherits ComputedStateComponent<AppUIHub, AudioDiagnosticsModal.ComputedModel>
@implements IModalView<AudioDiagnosticsModal.Model>
@{
    var m = State.Value;
}

<DialogFrame
    Class="audio-diagnostics-modal"
    Title="Audio Diagnostics"
    NarrowViewSettings="@DialogFrameNarrowViewSettings.Default"
    HasCloseButton="true">
    <Buttons>
        @if (_copyTextSourceRef is not null) {
            <CopyTrigger Class="flex-1" Tooltip="Copy diagnostics" CopyTextSourceRef="@_copyTextSourceRef">
                <Button Class="btn-modal">Copy</Button>
            </CopyTrigger>
        }
    </Buttons>
    <Body>
        <div class="diag-tabs">
            <button type="button"
                    class="diag-tab @(_activeTab == Tab.Session ? "diag-tab--active" : "")"
                    @onclick="@(() => OnSelectTab(Tab.Session))">
                Session
            </button>
            @if (!IsMaui) {
                <button type="button"
                        class="diag-tab @(_activeTab == Tab.Playback ? "diag-tab--active" : "")"
                        @onclick="@(() => OnSelectTab(Tab.Playback))">
                    Playback
                </button>
            }
            @if (m.ShowActionsTab) {
                <button type="button"
                        class="diag-tab @(_activeTab == Tab.Actions ? "diag-tab--active" : "")"
                        @onclick="@(() => OnSelectTab(Tab.Actions))">
                    Actions
                </button>
            }
        </div>
        <div @ref="_copyTextSourceRef" class="diag-body-content" data-copy-source="innerText">

        @if (_activeTab == Tab.Session) {
            @if (!IsMaui) {
                <div class="diag-section">
                    <div class="diag-section-header">Web Audio context</div>
                    @if (m.Web?.Context is { } ctx) {
                        <div class="diag-row">
                            <span class="diag-label">State</span>
                            <span class="diag-value">@ctx.State@(ctx.IsRunning ? "" : " (not running)")</span>
                        </div>
                        <div class="diag-row">
                            <span class="diag-label">Ready</span>
                            <span class="diag-value">@YesNo(ctx.IsReady) · maintained @YesNo(ctx.IsMaintained)</span>
                        </div>
                        <div class="diag-row">
                            <span class="diag-label">Refs</span>
                            <span class="diag-value">@ctx.RefCount (used @YesNo(ctx.IsUsed))</span>
                        </div>
                        <div class="diag-row">
                            <span class="diag-label">Background</span>
                            <span class="diag-value">@(ctx.BackgroundActivity is { Length: > 0 } bg ? bg : "—")</span>
                        </div>
                        <div class="diag-row">
                            <span class="diag-label">Sample rate</span>
                            <span class="diag-value">@FormatHz(ctx.SampleRate)</span>
                        </div>
                        <div class="diag-row">
                            <span class="diag-label">Output latency</span>
                            <span class="diag-value">@FormatMs(ctx.OutputLatencyMs)</span>
                        </div>
                    }
                    else {
                        <div class="diag-row">
                            <span class="diag-dim">No context data yet</span>
                        </div>
                    }
                </div>
            }

            <div class="diag-section">
                <div class="diag-section-header">Native audio session</div>
                @if (!m.Focus.IsSupported) {
                    <div class="diag-row">
                        <span class="diag-value diag-dim">Not managed on this platform (web / always focused)</span>
                    </div>
                }
                else {
                    <div class="diag-row">
                        <span class="diag-label">Mode</span>
                        <span class="diag-value">@m.Focus.ActiveMode</span>
                    </div>
                    <div class="diag-row">
                        <span class="diag-label">Interrupted</span>
                        <span class="diag-value @(m.Focus.IsInterrupted ? "diag-error" : "")">@YesNo(m.Focus.IsInterrupted)</span>
                    </div>
                    <div class="diag-row">
                        <span class="diag-label">Suspended</span>
                        <span class="diag-value @(m.Focus.IsSuspended ? "diag-error" : "")">@YesNo(m.Focus.IsSuspended)</span>
                    </div>
                    <div class="diag-row">
                        <span class="diag-label">Configured</span>
                        <span class="diag-value">@YesNo(m.Focus.IsSessionConfigured)</span>
                    </div>
                    @if (m.Focus.Scopes.Count > 0) {
                        <div class="diag-row">
                            <span class="diag-label">Scopes</span>
                            <span class="diag-value">@FormatScopes(m.Focus.Scopes)</span>
                        </div>
                    }
                    @if (m.Focus.Session is { } session) {
                        <div class="diag-group-header">AVAudioSession</div>
                        <div class="diag-row">
                            <span class="diag-label">Category</span>
                            <span class="diag-value">@session.Category</span>
                        </div>
                        <div class="diag-row">
                            <span class="diag-label">Session mode</span>
                            <span class="diag-value">@(session.Mode is { Length: > 0 } sm ? sm : "—")</span>
                        </div>
                        <div class="diag-row">
                            <span class="diag-label">Other audio</span>
                            <span class="diag-value">@YesNo(session.IsOtherAudioPlaying)</span>
                        </div>
                        <div class="diag-row">
                            <span class="diag-label">Output</span>
                            <span class="diag-value multiline">@(session.OutputRoutes.Count > 0 ? string.Join(", ", session.OutputRoutes) : "none")</span>
                        </div>
                    }
                }
            </div>
        }

        @if (_activeTab == Tab.Playback) {
            var players = m.Web?.Players ?? [];
            <div class="diag-section">
                <div class="diag-section-header">
                    Players
                    <span class="diag-badge">@players.Length</span>
                </div>
                @if (players.Length == 0) {
                    <div class="diag-row">
                        <span class="diag-dim">No active players</span>
                    </div>
                }
                else {
                    @foreach (var p in players) {
                        <div class="diag-stream">
                            <div class="diag-stream-header">
                                <span>@(p.AuthorId is { Length: > 0 } a ? a : "#" + p.InternalId)</span>
                                <span class="diag-chip @PlaybackChipClass(p.PlaybackState)">@p.PlaybackState</span>
                            </div>
                            <div class="diag-row">
                                <span class="diag-label">Buffer</span>
                                <span class="diag-value">@p.BufferState (@((p.BufferedDuration * 1000).ToString("0")) ms)</span>
                            </div>
                            <div class="diag-row">
                                <span class="diag-label">Presentation lag</span>
                                <span class="diag-value">@FormatMs(p.PresentationLagMs)</span>
                            </div>
                            <div class="diag-row">
                                <span class="diag-label">Target buffer</span>
                                <span class="diag-value">@(p.TargetBufferSizeMs.ToString("0"))ms</span>
                            </div>
                        </div>
                    }
                }
            </div>
        }

        @if (_activeTab == Tab.Actions && m.ShowActionsTab) {
            <div class="diag-section">
                <div class="diag-section-header">Recovery</div>
                <Tile>
                    <TileItem Click="@OnReactivateSession">
                        <Content>Reactivate audio session</Content>
                        <Caption>
                            Re-runs the native audio-focus recovery
                            (<code>AudioFocusUI.TryRecover</code>). Use when playback is
                            stuck after an interruption.
                        </Caption>
                    </TileItem>
                    @if (!IsMaui) {
                        <TileItem Click="@OnResumeContext">
                            <Content>Resume AudioContext</Content>
                            <Caption>
                                Forces an interactive resume of the Web Audio playback context.
                                Best-effort — iOS may refuse outside a real user gesture.
                            </Caption>
                        </TileItem>
                    }
                </Tile>
                @if (_lastActionResult is { Length: > 0 }) {
                    <div class="diag-row">
                        <span class="diag-label">Last action</span>
                        <span class="diag-value multiline">@_lastActionResult</span>
                    </div>
                }
            </div>
        }

        </div>
    </Body>
</DialogFrame>

@code {
    private enum Tab { Session, Playback, Actions }

    private Tab _activeTab = Tab.Session;
    private ElementReference? _copyTextSourceRef;
    private string? _lastActionResult;

    private AudioDiagnosticsUI Diagnostics => Hub.AudioDiagnosticsUI;
    private ILogger Log => field ??= Services.LogFor<AudioDiagnosticsModal>();

    private bool IsMaui => Hub.HostInfo.AppKind.IsMaui();

    [CascadingParameter] public Modal Modal { get; set; } = null!;
    [Parameter] public Model ModalModel { get; set; } = null!;

    protected override ComputedState<ComputedModel>.Options GetStateOptions()
        => new() {
            InitialValue = ComputedModel.Empty,
            UpdateDelayer = FixedDelayer.NextTick,
            Category = GetStateCategory(GetType()),
        };

    protected override async Task<ComputedModel> ComputeState(CancellationToken cancellationToken) {
        var account = await Hub.AccountUI.OwnAccount.Use(cancellationToken).ConfigureAwait(false);
        var showActionsTab = account.IsAdmin || Hub.HostInfo.IsDevelopmentInstance;
        var diagnostics = await Diagnostics.Get(cancellationToken).ConfigureAwait(false);
        return new ComputedModel(showActionsTab, diagnostics.Focus, diagnostics.Web);
    }

    private void OnSelectTab(Tab tab) {
        if (_activeTab == tab)
            return;
        _activeTab = tab;
        StateHasChanged();
    }

    private async Task OnReactivateSession() {
        try {
            await Diagnostics.Reactivate();
            _lastActionResult = "Reactivate requested";
        }
        catch (Exception e) {
            _lastActionResult = $"Reactivate failed: {e.Message}";
            Log.LogWarning(e, "Reactivate audio session failed");
        }
        StateHasChanged();
    }

    private async Task OnResumeContext() {
        try {
            await Diagnostics.ResumeContext();
            _lastActionResult = "Resume requested";
        }
        catch (Exception e) {
            _lastActionResult = $"Resume failed: {e.Message}";
            Log.LogWarning(e, "Resume AudioContext failed");
        }
        StateHasChanged();
    }

    private static string YesNo(bool value) => value ? "yes" : "no";

    private static string PlaybackChipClass(string playbackState) => playbackState switch {
        "playing" => "diag-chip-good",
        "starving" => "diag-chip-bad",
        "paused" => "diag-chip-marginal",
        _ => "diag-chip-unknown",
    };

    private static string FormatScopes(IReadOnlyList<AudioFocusScopeInfo> scopes)
        => string.Join(", ", scopes.Where(s => s.Count > 0).Select(s => $"{s.Mode}×{s.Count}")) is { Length: > 0 } text
            ? text
            : "none";

    private static string FormatMs(double? ms)
        => ms is null ? "—" : $"{ms.Value:0} ms";

    private static string FormatHz(double? hz)
        => hz is null ? "—" : $"{hz.Value:0} Hz";

    // Nested types

    public sealed class Model(ChatId chatId)
    {
        public ChatId ChatId { get; } = chatId;
    }

    public sealed record ComputedModel(
        bool ShowActionsTab,
        AudioFocusDiagnostics Focus,
        WebAudioDiagnostics? Web)
    {
        public static readonly ComputedModel Empty = new(false, AudioFocusDiagnostics.Unsupported, null);
    }
}
