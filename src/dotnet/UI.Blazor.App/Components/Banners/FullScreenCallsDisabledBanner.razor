@namespace ActualChat.UI.Blazor.App.Components
@using ActualChat.Kvas
@inherits ComputedStateComponent<AppUIHub, FullScreenCallsDisabledBanner.Model>
@{
    var m = State.Value;
    if (ReferenceEquals(m, Model.Loading))
        return;

    var isVisible = m is { Gate: not CallScreenGate.None, IsDismissed: false };
    if (!isVisible)
        return;
}

<RenderIntoSlot Name="@PermissionBannerSwitch.SlotName">
    <Banner
        @key="GetType()"
        Class="lock-screen-calls-banner"
        IsVisible="@isVisible"
        Severity="BannerSeverity.Info"
        ShowDismissButton="true"
        Dismiss="@OnDismiss">
        <Icon>
            <i class="icon-phone"></i>
        </Icon>
        <Body>
            @L.Banner_LockScreenCalls_Prefix(CoreConstants.AppName)<strong
                >@L.Banner_LockScreenCallsTarget</strong>@L.Banner_LockScreenCalls_Suffix
        </Body>
        <Buttons>
            <BannerButton
                Click="@OnConfigureClick">
                @L.Common_Settings
            </BannerButton>
        </Buttons>
    </Banner>
</RenderIntoSlot>

@code {
    private StoredState<Box<Moment>> _dismissedAt = null!;
    private IFullScreenCallsAvailability FullScreenCallsAvailability
        => Hub.Services.GetRequiredService<IFullScreenCallsAvailability>();
    private BackgroundStateTracker BackgroundStateTracker
        => Hub.Services.GetRequiredService<BackgroundStateTracker>();

    // Protected/internal methods

    protected override void OnInitialized()
        => _dismissedAt = StateFactory.NewKvasStored<Box<Moment>>(
            new(LocalSettings, "Permissions.FullScreenCalls.DismissedAt") {
                InitialValue = Box.New(default(Moment)),
            });

    protected override ComputedState<Model>.Options GetStateOptions()
        => ComputedStateComponent.GetStateOptions(GetType(),
            static t => new ComputedState<Model>.Options() {
                InitialValue = Model.Loading,
                UpdateDelayer = FixedDelayer.NextTick,
                Category = GetStateCategory(t),
            });

    protected override async Task<Model> ComputeState(CancellationToken cancellationToken) {
        // Nothing invalidates a platform read, so Use()-ing IsBackground is what re-reads the gate
        // on every return to the app - including the return from the settings screen.
        await BackgroundStateTracker.IsBackground.Use(cancellationToken).ConfigureAwait(false);
        if (!_dismissedAt.WhenRead.IsCompleted)
            await _dismissedAt.WhenRead
                .WaitAsync(TimeSpan.FromSeconds(3), cancellationToken)
                .SilentAwait();

        var gate = await FullScreenCallsAvailability.GetBlockedGate(cancellationToken).ConfigureAwait(false);
        var dismissedAt = await _dismissedAt.Use(cancellationToken).ConfigureAwait(false);
        var dismissPeriod = Clocks.SystemClock.Now - dismissedAt.Value;
        var isDismissed = dismissPeriod < Constants.Notification.PermissionRequestDismissPeriod;
        return new(gate, isDismissed);
    }

    // Private methods

    private void OnDismiss()
        => _dismissedAt.Value = Box.New(Clocks.SystemClock.Now);

    private Task OnConfigureClick()
        => FullScreenCallsAvailability.OpenSettings(State.Value.Gate);

    // Nested types

    public sealed record Model(
        CallScreenGate Gate,
        bool IsDismissed
    ) {
        public static readonly Model Loading = new(CallScreenGate.None, true);
    }
}
