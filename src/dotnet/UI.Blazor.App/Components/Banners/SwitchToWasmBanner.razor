@namespace ActualChat.UI.Blazor.App.Components
@implements IBannerView<SwitchToWasmBanner.Model>
@inherits ComponentBase<UIHub>

<Banner ShowDismissButton="true">
    <Icon>
        <i class="icon-checkmark-circle"></i>
    </Icon>
    <Body>@L.Banner_ReadyToRestart_Format(CoreConstants.AppName)</Body>
    <Buttons>
        <Button Class="btn-transparent on unhovered">@L.Common_Restart</Button>
    </Buttons>
</Banner>

@code {

    [Parameter] public Model BannerModel { get; set; } = null!;

    public sealed record Model;
}
