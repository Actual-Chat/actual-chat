@namespace ActualChat.UI.Blazor.App.Components
@inherits ComputedStateComponent<AppUIHub, bool>

<Banner
    IsVisible="@State.Value"
    Severity="BannerSeverity.Info"
    ShowDismissButton="true"
    Dismiss="@OnDismiss">
    <Icon>
        <i class="icon-push-to-talk text-2xl text-03"></i>
    </Icon>
    <Body>
        @L.Ptt_DeviceOff_Prefix.TrimEnd()
    </Body>
    <Buttons>
        <BannerButton Click="@OnEnableClick">@L.Common_Allow</BannerButton>
    </Buttons>
</Banner>

@code {
    private ChatAudioUI ChatAudioUI => Hub.ChatAudioUI;

    [CascadingParameter] public ChatContext ChatContext { get; set; } = null!;

    protected override ComputedState<bool>.Options GetStateOptions()
        => ComputedStateComponent.GetStateOptions(GetType(),
            static t => new ComputedState<bool>.Options() {
                InitialValue = false,
                UpdateDelayer = FixedDelayer.NextTick,
                Category = GetStateCategory(t),
            });

    protected override async Task<bool> ComputeState(CancellationToken cancellationToken) {
        var chat = ChatContext.Chat;
        if (!chat.IsMember())
            return false;

        if (await ChatAudioUI.IsPttDeviceOffBannerHidden(cancellationToken).ConfigureAwait(false))
            return false;

        var isDeviceEnabled = await ChatAudioUI.IsPttEnabledOnDevice(cancellationToken).ConfigureAwait(false);
        if (isDeviceEnabled)
            return false;

        var state = await ChatAudioUI.GetPttChatState(chat.Id, cancellationToken).ConfigureAwait(false);
        return state == PttChatState.InList;
    }

    private Task OnEnableClick() {
        ChatAudioUI.SetIsPttEnabledOnDevice(true);
        return ChatAudioUI.ShowPttSupportLimits(L.PttSupport_EnabledOnDevice);
    }

    private void OnDismiss() {
        var text = L.Ptt_HideDeviceOffText_Format(L.Common_Settings, L.Settings_Ptt);
        var model = new ConfirmModal.Model(false, text, Hide) {
            Title = L.Ptt_HideDeviceOffTitle,
            ConfirmButtonText = L.Common_Hide,
        };
        _ = ModalUI.Show(model);
    }

    private void Hide()
        => ChatAudioUI.SetIsPttDeviceOffBannerHidden(true);
}
