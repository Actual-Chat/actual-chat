@namespace ActualChat.UI.Blazor.App.Components
@inherits ComputedStateComponent<AppUIHub, Banners.ComputedModel>
@{
    var m = State.Value;
    var chatId = Chat?.Id;
    var hasChat = chatId is not null;
}

<ReconnectBanner/>
@foreach (var banner in m.Banners.Take(MaxCount)) {
    @banner.View
}
@if (hasChat) {
    <ChatCopyBanner Chat="@Chat"/>
    <AddToContactsBanner Chat="@Chat"/>
    <AddChatMembersBanner Chat="@Chat"/>
    @if (Chat.IsChatRoulette()) {
        <ChatRouletteBanner Chat="@Chat"/>
    }
}
<PermissionBannerSwitch/>

@code {
    private const int MaxCount = 2;

    private BannerUI BannerUI => Hub.BannerUI;

    [CascadingParameter] public ScreenSize ScreenSize { get; set; }
    [Parameter, EditorRequired] public Chat? Chat { get; set; }

    protected override ComputedState<ComputedModel>.Options GetStateOptions()
        => ComputedStateComponent.GetStateOptions(GetType(),
            static t => new ComputedState<ComputedModel>.Options() {
                InitialValue = ComputedModel.None,
                UpdateDelayer = FixedDelayer.NextTick,
                Category = GetStateCategory(t),
            });

    protected override async Task<ComputedModel> ComputeState(CancellationToken cancellationToken) {
        var bannerRefs = await BannerUI.Banners.Use(cancellationToken).ConfigureAwait(false);
        return new(bannerRefs);
    }

    // Nested types

    public sealed record ComputedModel(ImmutableList<BannerDef> Banners) {
        public static readonly ComputedModel None = new(ImmutableList<BannerDef>.Empty);
    }
}
