@namespace ActualChat.UI.Blazor.App.Components
@using ActualChat.Kvas
@inherits ComputedStateComponent<AppUIHub, bool>

<Banner
    IsVisible="@State.Value"
    Severity="BannerSeverity.Warning"
    ShowDismissButton="true"
    Dismiss="@OnDismiss">
    <Icon>
        <i class="icon-bell text-2xl"></i>
    </Icon>
    <Body>
        @L.Banner_OnlyPersonInChat
    </Body>
    <Buttons>
        <BannerButton
            Click="@OnInviteClick">@L.Banner_AddMembers</BannerButton>
    </Buttons>
</Banner>

@code {
    private static readonly TimeSpan DismissDuration = TimeSpan.FromDays(7);

    private SyncedState<AddChatMembersBannerUserSettings> _settings = null!;

    private Chat Chat => ChatContext.Chat;
    private IAuthors Authors => Hub.Authors;
    private IRoles Roles => Hub.Roles;

    [CascadingParameter] public ChatContext ChatContext { get; set; } = null!;

    protected override void OnInitialized() {
        var key = AddChatMembersBannerUserSettings.GetKey(Chat.Id);
        _settings = StateFactory.NewUserSettingsSynced(UserSettingsUI, key, new AddChatMembersBannerUserSettings());
    }

    public override async ValueTask DisposeAsync() {
        await base.DisposeAsync();
        _settings.Dispose();
    }

    protected override ComputedState<bool>.Options GetStateOptions()
        => ComputedStateComponent.GetStateOptions(GetType(),
            static t => new ComputedState<bool>.Options() {
                InitialValue = false,
                UpdateDelayer = FixedDelayer.NextTick,
                Category = GetStateCategory(t),
            });

    protected override async Task<bool> ComputeState(CancellationToken cancellationToken) {
        var chat = Chat;
        var chatId = chat.Id;
        if (!_settings.WhenFirstTimeRead.IsCompleted)
            await _settings.WhenFirstTimeRead.ConfigureAwait(false);

        if (!EditMembersUI.CanAddMembers(chat))
            return false;

        var dismissedAt = await _settings.Use(cancellationToken).ConfigureAwait(false);
        if (dismissedAt.DismissedAt + DismissDuration > Clocks.ServerClock.Now)
            return false;

        var allAuthorIds = await Authors.ListAuthorIds(Session, chatId, cancellationToken).ConfigureAwait(false);
        if (allAuthorIds.Length > 1)
            return false;

        var ownerIds = await Roles.ListOwnerIds(Session, chatId, cancellationToken).ConfigureAwait(false);
        var hasRegularMembers = allAuthorIds.Except(ownerIds).Any();
        if (hasRegularMembers)
            return false;

        return true;
    }

    // Event handlers

    private void OnDismiss()
        => _settings.Value = new AddChatMembersBannerUserSettings { DismissedAt = Clocks.ServerClock.Now };

    private void OnInviteClick()
        => ModalUI.Show(new AddMemberModal.Model(Chat.Id));
}
