@namespace ActualChat.UI.Blazor.App.Components
@using ActualChat.Kvas
@inherits ComputedStateComponent<AppUIHub, PttJoinBannerKind>
@{
    var kind = State.Value;
}

<Banner
    IsVisible="@(kind != PttJoinBannerKind.None)"
    Severity="BannerSeverity.Info"
    ShowDismissButton="true"
    Dismiss="@OnDismiss">
    <Icon>
        <i class="icon-push-to-talk text-2xl"></i>
    </Icon>
    <Body>
        @(kind switch {
            PttJoinBannerKind.EnableDevice => L.Banner_PttUseDevice,
            PttJoinBannerKind.AllowChatAndDevice => L.Banner_PttAllowOnDevice,
            _ => L.Banner_PttAllow,
        })
    </Body>
    <Buttons>
        <BannerButton
            Click="@OnJoinClick">@(kind == PttJoinBannerKind.EnableDevice
                ? L.Banner_PttTurnOn
                : L.Common_Allow)</BannerButton>
    </Buttons>
</Banner>

@code {
    private static readonly TimeSpan ShowDelay = TimeSpan.FromSeconds(2);

    private StoredState<PttJoinBannerUserSettings> _settings = null!;

    private Chat Chat => ChatContext.Chat;
    private ChatAudioUI ChatAudioUI => Hub.ChatAudioUI;

    [CascadingParameter] public ChatContext ChatContext { get; set; } = null!;

    protected override void OnInitialized() {
        // Deliberately device-local (unlike most user settings): the device question is per
        // device, so dismissing it on one phone must not silence the ask on another.
        var key = PttJoinBannerUserSettings.GetKey(Chat.Id);
        _settings = StateFactory.NewKvasStored<PttJoinBannerUserSettings>(
            new(LocalSettings, key) {
                InitialValue = new PttJoinBannerUserSettings(),
                Category = GetStateCategory(GetType()),
            });
    }

    protected override ComputedState<PttJoinBannerKind>.Options GetStateOptions()
        => ComputedStateComponent.GetStateOptions(GetType(),
            static t => new ComputedState<PttJoinBannerKind>.Options() {
                InitialValue = PttJoinBannerKind.None,
                UpdateDelayer = FixedDelayer.NextTick,
                Category = GetStateCategory(t),
            });

    protected override async Task<PttJoinBannerKind> ComputeState(CancellationToken cancellationToken) {
        var chat = Chat;
        if (chat.HasSingleAuthor || !chat.IsMember() || chat.Id.IsThread())
            return PttJoinBannerKind.None;
        if (chat.ActivePttEnabledAt is not { } enabledAt)
            return PttJoinBannerKind.None;

        if (!_settings.WhenRead.IsCompleted)
            await _settings.WhenRead.ConfigureAwait(false);

        var kind = await GetKind(enabledAt).ConfigureAwait(false);
        if (kind == PttJoinBannerKind.None || State.Value != PttJoinBannerKind.None)
            return kind;

        // Let pending participation writes settle before showing a new consent prompt.
        await Clocks.CpuClock.Delay(ShowDelay, cancellationToken).ConfigureAwait(false);
        return await GetKind(enabledAt).ConfigureAwait(false);
    }

    // Private methods

    private async Task<PttJoinBannerKind> GetKind(Moment enabledAt) {
        var settings = await _settings.Use(CancellationToken.None).ConfigureAwait(false);
        var pttSettings = await UserSettingsUI.UserPttSettings()
            .Get(CancellationToken.None)
            .ConfigureAwait(false);
        var isDeviceEnabled = await ChatAudioUI.IsPttEnabledOnDevice(CancellationToken.None).ConfigureAwait(false);
        return Ptt.GetJoinBannerKind(
            pttSettings.IsArmedIn(Chat.Id, enabledAt),
            isDeviceEnabled,
            settings.DismissedAt,
            enabledAt);
    }

    // Event handlers

    private async Task OnJoinClick() {
        var chat = Chat;
        if (chat.ActivePttEnabledAt is not { } enabledAt)
            return;

        if (!await ChatAudioUI.ConsentPtt(chat.Id, enabledAt, CancellationToken.None).ConfigureAwait(true))
            return;

        ChatAudioUI.SetIsPttEnabledOnDevice(true);
    }

    private void OnDismiss()
        => _settings.Value = new PttJoinBannerUserSettings { DismissedAt = Clocks.ServerClock.Now };
}
