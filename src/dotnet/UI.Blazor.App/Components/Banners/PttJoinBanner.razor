@namespace ActualChat.UI.Blazor.App.Components
@using ActualChat.Kvas
@inherits ComputedStateComponent<AppUIHub, PttJoinBannerKind>
@{
    var kind = State.Value;
}

<Banner
    IsVisible="@(kind != PttJoinBannerKind.None)"
    Severity="BannerSeverity.Info"
    ShowDismissButton="true"
    Dismiss="@OnDismiss">
    <Icon>
        <i class="icon-talking text-2xl"></i>
    </Icon>
    <Body>
        @(kind == PttJoinBannerKind.EnableDevice ? L.Banner_PttUseDevice : L.Banner_PttAllow)
    </Body>
    <Buttons>
        <Button
            Class="btn-transparent unhovered"
            Click="@OnJoinClick">@L.Common_Allow</Button>
    </Buttons>
</Banner>

@code {
    private StoredState<PttJoinBannerUserSettings> _settings = null!;

    private Chat Chat => ChatContext.Chat;
    private ChatAudioUI ChatAudioUI => Hub.ChatAudioUI;

    [CascadingParameter] public ChatContext ChatContext { get; set; } = null!;

    protected override void OnInitialized() {
        // Deliberately device-local (unlike most user settings): the device question is per
        // device, so dismissing it on one phone must not silence the ask on another.
        var key = PttJoinBannerUserSettings.GetKey(Chat.Id);
        _settings = StateFactory.NewKvasStored<PttJoinBannerUserSettings>(
            new(LocalSettings, key) {
                InitialValue = new PttJoinBannerUserSettings(),
                Category = GetStateCategory(GetType()),
            });
    }

    protected override ComputedState<PttJoinBannerKind>.Options GetStateOptions()
        => ComputedStateComponent.GetStateOptions(GetType(),
            static t => new ComputedState<PttJoinBannerKind>.Options() {
                InitialValue = PttJoinBannerKind.None,
                UpdateDelayer = FixedDelayer.NextTick,
                Category = GetStateCategory(t),
            });

    protected override async Task<PttJoinBannerKind> ComputeState(CancellationToken cancellationToken) {
        var chat = Chat;
        if (chat.HasSingleAuthor || !chat.IsMember() || chat.Id.IsThread())
            return PttJoinBannerKind.None;
        if (chat.PttEnabledAt is not { } enabledAt)
            return PttJoinBannerKind.None;

        var isIncompleteUIEnabled = await Hub.Features.IsIncompleteUIEnabled(cancellationToken).ConfigureAwait(false);
        if (!isIncompleteUIEnabled)
            return PttJoinBannerKind.None;

        if (!_settings.WhenRead.IsCompleted)
            await _settings.WhenRead.ConfigureAwait(false);

        var settings = await _settings.Use(cancellationToken).ConfigureAwait(false);
        var pttSettings = await UserSettingsUI.UserPttSettings()
            .Get(cancellationToken)
            .ConfigureAwait(false);
        var isDeviceEnabled = await ChatAudioUI.IsPttEnabledOnDevice(cancellationToken).ConfigureAwait(false);
        return Ptt.GetJoinBannerKind(
            pttSettings.IsArmedIn(chat.Id, enabledAt),
            isDeviceEnabled,
            settings.DismissedAt,
            enabledAt);
    }

    // Event handlers

    private async Task OnJoinClick() {
        var chat = Chat;
        if (chat.PttEnabledAt is not { } enabledAt)
            return;

        var wasDeviceEnabled = await ChatAudioUI.IsPttEnabledOnDevice(CancellationToken.None).ConfigureAwait(true);
        // Consented, not armed: with the device switch off the armed set is empty, and updating
        // consents against it would wipe every other chat's consent for the user's other devices.
        var consentedChatIds = await ChatAudioUI.GetConsentedPttChatIds(CancellationToken.None).ConfigureAwait(true);
        if (!consentedChatIds.Contains(chat.Id)) {
            if (consentedChatIds.Count >= UserPttSettings.MaxChatCount) {
                ToastUI.Show(
                    L.Ptt_MaxChatsReached_Format(UserPttSettings.MaxChatCount),
                    "icon-alert-circle",
                    ToastDismissDelay.Long);
                return;
            }

            // Never a raw client clock: JoinedAt must land within the current epoch (>= enabledAt).
            var joinedAt = Moment.Max(Clocks.ServerClock.Now, enabledAt);
            await UserSettingsUI.UserPttSettings().Update(
                x => x.WithOnlyPttChats(consentedChatIds.ToHashSet()).WithPttChat(chat.Id, joinedAt),
                CancellationToken.None);
        }

        ChatAudioUI.SetIsPttEnabledOnDevice(true);
        if (!wasDeviceEnabled)
            // The chat-flavored banner enrolls the device implicitly, so confirm it and offer a
            // one-tap way back for someone who only meant to arm their other devices.
            ToastUI.Show(
                L.Ptt_DeviceEnabledToast,
                "icon-talking",
                () => ChatAudioUI.SetIsPttEnabledOnDevice(false),
                L.Ptt_NotOnThisDevice,
                ToastDismissDelay.Long);
    }

    private void OnDismiss()
        => _settings.Value = new PttJoinBannerUserSettings { DismissedAt = Clocks.ServerClock.Now };
}
