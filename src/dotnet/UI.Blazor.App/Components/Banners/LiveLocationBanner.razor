@namespace ActualChat.UI.Blazor.App.Components
@inherits ComputedStateComponent<AppUIHub, LiveLocationBanner.Model>
@{
    var m = State.Value;
}

@* The live-location map panel (MapPanelContent) covers the normal case; the banner
   remains to surface tracking errors and as the compact stand-in while the map is
   hidden via its ⋮ menu — clicking it brings the map back. *@
<Banner
    IsVisible="@(m.Count > 0 && (m.IsTrackingBroken || m.IsPanelHidden))"
    Severity="@(m.IsTrackingBroken ? BannerSeverity.Error : BannerSeverity.Default)"
    Class="live-location-banner">
    <Icon>@*Empty on purpose: a null Icon would render the default SeverityIcon; the icon lives in Body*@</Icon>
    <Body>
        <div class="c-body" @onclick="@OnClick">
            @if (m.IsTrackingBroken) {
                <i class="icon-alert-circle c-alert"
                   data-tooltip="@m.GetErrorText()"
                   data-tooltip-position="@FloatingPosition.Top.ToPositionString()"></i>
            } else {
                <marker-pin-live-svg class="c-pin"></marker-pin-live-svg>
            }
            <AuthorCircleGroup
                Class="c-avatars"
                MaxCount="@MaxAvatars"
                Size="@SquareSize.Size9"
                ShowRing="false"
                AuthorIds="@m.AuthorIds"/>
            <div class="c-text">
                <span class="c-description">@m.GetDescription()</span>
            </div>
        </div>
    </Body>
    <Buttons>
        @if (m.IsOwnSharing) {
            <ButtonRound Class="btn-stop-sharing" Click="@OnStop"
                         Tooltip="Stop sharing" TooltipPosition="FloatingPosition.Top">
                <marker-pin-off-svg></marker-pin-off-svg>
            </ButtonRound>
        } else {
            <Button Class="btn-share-location" Click="@OnShare">Share your location</Button>
        }
    </Buttons>
</Banner>

@code {
    private const int MaxAvatars = Constants.Location.MaxSharingAuthorsPerChat;

    private Chat Chat => ChatContext.Chat;
    private LocationUI LocationUI => field ??= Hub.LocationUI;

    [CascadingParameter] public ChatContext ChatContext { get; set; } = null!;

    protected override ComputedState<Model>.Options GetStateOptions()
        => ComputedStateComponent.GetStateOptions(GetType(),
            static t => new ComputedState<Model>.Options() {
                InitialValue = Model.None,
                UpdateDelayer = FixedDelayer.NextTick,
                Category = GetStateCategory(t),
            });

    protected override async Task<Model> ComputeState(CancellationToken cancellationToken) {
        var chatId = Chat.Id;
        var participants = await LocationUI.ListParticipants(chatId, cancellationToken).ConfigureAwait(false);
        if (participants.Count == 0)
            return Model.None;

        var trackingError = await LocationUI.GetTrackingError(chatId, cancellationToken).ConfigureAwait(false);
        var isPanelVisible = await Hub.ChatActivityUI.IsPanelVisible(chatId, cancellationToken)
            .ConfigureAwait(false);
        return new Model(participants, trackingError, !isPanelVisible);
    }

    // Private methods

    private Task OnClick() {
        var m = State.Value;
        if (m.IsTrackingBroken)
            return ModalUI.Show(new LocationTroubleshooterModal.Model());

        Hub.ChatActivityUI.TogglePanel(Chat.Id, true);
        Hub.ChatActivityUI.SelectTab(Chat.Id, VisualActivityTab.Map);
        return Task.CompletedTask;
    }

    private Task OnStop()
        => LocationUI.StopSharing(Chat.Id, CancellationToken.None);

    private Task OnShare()
        => LocationUI.ShowShareModal(Chat.Id);

    // Nested types

    public sealed record Model(
        IReadOnlyList<LocationParticipant> Participants,
        GeoTrackingError? TrackingError = null,
        bool IsPanelHidden = false) {
        public static readonly Model None = new([]);

        public bool IsTrackingBroken => TrackingError is not null;
        public int Count => Participants.Count;
        public bool IsOwnSharing => Participants.Any(x => x.IsOwn);
        public IReadOnlyList<AuthorId> AuthorIds => [..Participants.Select(x => x.Author.Id)];

        public string GetErrorText()
            => TrackingError switch {
                GeoTrackingError.PermissionDenied => "Location permission denied",
                GeoTrackingError.PositionUnavailable => "Can't determine your location",
                GeoTrackingError.Timeout => "Location request timed out",
                _ => "Location tracking is off",
            };

        public string GetDescription() {
            if (IsTrackingBroken)
                return GetErrorText();

            if (IsOwnSharing) {
                var others = Count - 1;
                return others switch {
                    0 => "You are sharing your location",
                    1 => "You and 1 other are sharing location",
                    _ => $"You and {others} others are sharing location",
                };
            }
            return Count == 1
                ? "1 person is sharing location"
                : $"{Count} people are sharing location";
        }
    }
}
