@namespace ActualChat.UI.Blazor.App.Components
@using ActualChat.Hosting
@inherits ComponentBase<AppUIHub>
@{
    var isMauiApp = HostInfo.HostKind.IsMauiApp();
    var isAndroidApp = isMauiApp && HostInfo.AppKind == AppKind.Android;
    var isIosApp = isMauiApp && HostInfo.AppKind == AppKind.Ios;
}

@* We want only one permission banner at a time; the last visible one below wins *@
<RenderSlot Name="@SlotName"/>
@if (isAndroidApp) {
    <FullScreenCallsDisabledBanner/>
}
<NotificationsPermissionBanner/>
@if (isMauiApp) {
    <ContactsPermissionBanner/>
}
@if (isIosApp) {
    <LiveActivitiesDisabledBanner/>
}

@code {
    public const string SlotName = "PermissionBanner";
}
