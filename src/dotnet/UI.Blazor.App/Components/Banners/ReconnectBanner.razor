@namespace ActualChat.UI.Blazor.Components
@inherits StatefulComponentBase<RpcPeerState>
@{
    var m = State.Value;
    if (m.Kind == RpcPeerStateKind.Connected)
        return;

    var isOffline = m.ReconnectsIn >= OfflineThreshold;
    _isVisible = m.Kind is RpcPeerStateKind.Disconnected;
    // Services.LogFor(GetType()).LogInformation("State: {State}", m);
}

<Banner Class="reconnect-banner" IsVisible="@_isVisible" NoWrap="true">
    <Icon>
        <i class="icon-cloud-disconnected"></i>
    </Icon>
    <Body>
        @if (m.Kind == RpcPeerStateKind.JustConnected) {
            <div class="c-main-text">@L.Banner_Connected</div>
        } else { // JustDisconnected or Disconnected
            <div class="c-main-text desktop">@L.Banner_ConnectionLost</div>
            @if (m.ReconnectsIn == default) {
                <div class="c-secondary-text">@L.Banner_Connecting</div>
            } else if (isOffline) {
                <div class="c-secondary-text">@L.Banner_Offline</div>
            } else {
                <div class="c-secondary-text">
                    @L.Banner_WillReconnectIn
                    <Countdown
                        Class="reconnect-countdown"
                        EndsAt="@(ReconnectUI.SystemNow + m.ReconnectsIn)"/>
                </div>
            }
        }
    </Body>
    <Buttons>
        @if (m.ReconnectsIn != default && !isOffline) {
            <BannerButton
                Click="@(_ => ReconnectUI.ReconnectIfDisconnected())">@L.Common_Retry</BannerButton>
        }
    </Buttons>
</Banner>

@code {
    // Adopts ReconnectUI's State, so it can't use our UIHub-aware bases - which set this for us.
    public ReconnectBanner()
        => MustRenderAfterEvent = true;

    private static readonly TimeSpan OfflineThreshold = TimeSpan.FromSeconds(1000);
    private bool _isVisible;

    [Inject] private ReconnectUI ReconnectUI { get; init; } = null!;

    // StatefulComponentBase adopts ReconnectUI's State, so no UIHub base fits; CircuitHub is already injected
    private UIHub Hub => field ??= (UIHub)CircuitHub;
    private IStringLocalizer L => Hub.StringLocalizer;

    protected override void OnInitialized()
        => SetState(ReconnectUI.State);

    public override ValueTask DisposeAsync()
        => default; // Shouldn't dispose State!
}
