@namespace ActualChat.UI.Blazor.App.Components
@inherits ComputedMenuBase<AppUIHub, AudioOutputRoutes>
@{
    var m = State.Value;
    if (m.Routes.Count == 0)
        return;
}

<div class="audio-output-menu">
    @foreach (var route in m.Routes) {
        var isSelected = route.Id == m.CurrentId;
        <MenuEntry
            Class="@(isSelected ? "selected" : "")"
            Icon="@route.GetIcon()"
            Click="@(() => OnClick(route.Id))">
            <TextContent>
                <span class="c-name">@Title(route)</span>
                @if (isSelected) {
                    <i class="icon-checkmark-simple c-check"></i>
                }
            </TextContent>
        </MenuEntry>
    }
</div>

@code {
    protected override ComputedState<AudioOutputRoutes>.Options GetStateOptions()
        => ComputedStateComponent.GetStateOptions(GetType(),
            static t => new ComputedState<AudioOutputRoutes>.Options() {
                InitialValue = AudioOutputRoutes.None,
                Category = GetStateCategory(t),
            });

    protected override async Task<AudioOutputRoutes> ComputeState(CancellationToken cancellationToken) {
        var m = await Hub.CallUI.GetOutputRoutes(cancellationToken).ConfigureAwait(false);
        Hub.LogFor(GetType()).LogInformation("AudioOutputMenu: {Count} route(s), current={CurrentId}",
            m.Routes.Count, m.CurrentId);
        return m;
    }

    private void OnClick(string routeId) {
        _ = Hub.TuneUI.Play(Tune.ClickButton);
        Hub.CallUI.SelectOutputRoute(routeId);
    }

    private string Title(AudioOutputRoute route)
        => route.Kind switch {
            AudioOutputKind.Phone => L.Call_AudioOutputPhone,
            AudioOutputKind.Speaker => L.Call_AudioOutputSpeaker,
            _ when !route.Name.IsNullOrEmpty() => route.Name,
            AudioOutputKind.Bluetooth => L.Call_AudioOutputBluetooth,
            _ => L.Call_AudioOutputHeadphones,
        };
}
