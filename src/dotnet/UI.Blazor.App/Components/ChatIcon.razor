@using ActualChat.Media
@inherits FusionComponentBase<AppUIHub>
@{
    var chat = Chat;
    var chatKind = chat is null
        ? (ChatKind?)null
        : chat.Id.IsThread(out var threadChatId)
            ? threadChatId.ParentChatId.Kind
            : chat.Id.Kind;
}

<div class="hideable">
    @switch (chatKind) {
    case ChatKind.Group or ChatKind.Place:
        <Pic
            Title="@chat!.Title"
            Picture="@chat.Picture.ToPicture()"
            ImageSkeletonClass="image-cover"
            Size="@Size"
            Class="@Class"
            IsSquare="@IsSquare"
            HideTitle="@HideTitle"
            IsBlurred="@IsBlurred"
            ShowFullSizeAvatar="@ShowFullSizeAvatar"
            AvatarKind="@AvatarKind.Marble"
            AvatarKey="@chat.Id.Value"/>
        break;
    case ChatKind.Peer when _peerChatUserId is not null:
        <AccountCircle
            ShowPresence="@ShowPresence"
            UserId="@_peerChatUserId"
            Size="@Size"
            IsBlurred="@IsBlurred"
            IsSquare="@IsSquare"
            Class="@Class"
            ShowFullSizeAvatar="@ShowFullSizeAvatar"/>
        break;
    default:
        <AvatarCircle
            Avatar="@null"
            Size="@Size"
            IsBlurred="@IsBlurred"
            IsSquare="@IsSquare"/>
        break;
    }
</div>

@code {
    private UserId? _peerChatUserId;

    [Parameter, EditorRequired] public Chat? Chat { get; set; }
    [Parameter] public bool ShowPresence { get; set; }
    [Parameter] public SquareSize Size { get; set; } = SquareSize.Size10;
    [Parameter] public bool IsSquare { get; set; }
    [Parameter] public bool HideTitle { get; set; }
    [Parameter] public bool IsBlurred { get; set; }
    [Parameter] public bool ShowFullSizeAvatar { get; set; }
    [Parameter] public string Class { get; set; } = "";

    protected override void OnParametersSet()
        => _peerChatUserId = GetPeerChatUserId();

    private UserId? GetPeerChatUserId() {
        if (Chat?.Id.GetThreadOutermostParentOrSelf() is not PeerChatId peerChatId)
            return null;

        var account = AccountUI.OwnAccount.Value;
        return peerChatId.AnotherUserIdOrNull(account.Id);
    }
}
