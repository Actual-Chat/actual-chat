@namespace ActualChat.UI.Blazor.App.Components
@implements IModalView<EmojiModal.Model>
@implements IDisposable
@inherits ComponentBase<AppUIHub>

<DialogFrame
    Class="emoji-modal"
    HasCloseButton="true"
    HasHeader="false"
    NarrowViewSettings="DialogFrameNarrowViewSettings.Bottom">
    <Body>
        <TabPanel @ref="_tabPanel" BottomHill="true" TabsClass="emoji-modal-tabs">
            <Tab Id="emoji" Title="Emoji" Order="0">
                <div class="c-grid">
                    @foreach (var group in Enum.GetValues<EmojiGroup>()) {
                        <div @key="group" class="c-group">
                            <div class="c-group-title">@group</div>
                            <div class="c-group-items">
                                @foreach (var emoji in Emojis.GetByGroup(group)) {
                                    <button @key="emoji"
                                        class="c-item"
                                        @onclick="@(() => OnEmojiClick(emoji))">
                                        <EmojiIcon Emoji="@emoji" Class="c-emoji" HasPreview="true"/>
                                    </button>
                                }
                            </div>
                        </div>
                    }
                </div>
            </Tab>
            <Tab Id="gif" Title="GIF" Order="1">
                <div class="c-gif-tab">
                    <SearchBox Placeholder="Search GIFs..." ClearButton="true" TextChanged="@OnGifSearch"/>
                    <div class="c-gif-grid">
                        @* Round-robin into two independent columns by index parity.
                           Stable: item N always lands in the same column regardless of how many pages loaded.
                           New pages append strictly at the bottom of each column. *@
                        @for (var col = 0; col < 2; col++) {
                            var columnIndex = col;
                            <div @key="@columnIndex" class="c-gif-col">
                                @foreach (var gif in EnumerateColumn(columnIndex)) {
                                    <button @key="gif.Slug"
                                            class="c-gif-item"
                                            @onclick="@(() => OnGifClick(gif))">
                                        <img class="c-gif-img"
                                             src="@gif.PreviewUrl"
                                             alt=""
                                             loading="lazy"
                                             style="@GetAspectRatioStyle(gif)"/>
                                    </button>
                                }
                            </div>
                        }
                    </div>
                    @if (_isLoading) {
                        <div class="c-gif-status">Loading...</div>
                    } else if (_gifItems.Count == 0 && _showEmpty) {
                        <div class="c-gif-status">No GIFs found</div>
                    } else if (_hasNext && _gifItems.Count > 0) {
                        <button class="c-gif-status" @onclick="@LoadMoreGifs">Load more</button>
                    }
                </div>
            </Tab>
        </TabPanel>
    </Body>
</DialogFrame>

@code {
    private readonly List<GifItem> _gifItems = new();
    private readonly CancellationTokenSource _disposeCts = new();
    private CancellationTokenSource? _searchCts;
    private TabPanel? _tabPanel;
    private string _searchQuery = "";
    private int _page = 1;
    private int _searchVersion;
    private bool _hasNext;
    private bool _isLoading;
    private bool _gifsLoaded;
    private bool _showEmpty;

    private IGifs Gifs => Hub.Gifs;

    [CascadingParameter] public Modal Modal { get; set; } = null!;
    [Parameter] public Model ModalModel { get; set; } = null!;

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (firstRender) {
            if (_tabPanel != null && ModalModel.InitialTabId != "emoji")
                _tabPanel.SelectedTabId = ModalModel.InitialTabId;
            if (!_gifsLoaded)
                await LoadGifs().ConfigureAwait(true);
        }
    }

    private void OnEmojiClick(Emoji emoji) {
        ModalModel.SelectedEmoji = emoji;
        Modal.Close();
    }

    private void OnGifClick(GifItem gif) {
        ModalModel.SelectedGifUrl = gif.Url;
        Modal.Close();
    }

    private async Task OnGifSearch(string query) {
        _searchQuery = query.Trim();
        _page = 1;
        _gifItems.Clear();
        _hasNext = false;
        _showEmpty = false;
        SwapSearchCts();
        var ct = _searchCts!.Token; // capture before await — _searchCts can be swapped again

        try {
            await Task.Delay(300, ct).ConfigureAwait(true);
            await LoadGifs().ConfigureAwait(true);
        }
        catch (OperationCanceledException) { }
    }

    private async Task LoadMoreGifs() {
        if (_isLoading)
            return; // guard against double-click while a request is in flight
        _page++;
        await LoadGifs().ConfigureAwait(true);
    }

    private async Task LoadGifs() {
        // Snapshot per-request state. Anything mutated after `await` must be guarded by
        // `version == _searchVersion` to avoid a stale RPC reply corrupting the active result set.
        var version = ++_searchVersion;
        var query = _searchQuery;
        var page = _page;
        var ct = _searchCts?.Token ?? _disposeCts.Token;

        _isLoading = true;
        _showEmpty = false;
        _gifsLoaded = true;
        SafeStateHasChanged();

        try {
            var result = query.IsNullOrEmpty()
                ? await Gifs.GetTrending(page, ct).ConfigureAwait(true)
                : await Gifs.Search(query, page, ct).ConfigureAwait(true);
            if (version != _searchVersion)
                return;
            var existingSlugs = _gifItems.Select(g => g.Slug).ToHashSet(StringComparer.Ordinal);
            _gifItems.AddRange(result.Items.Where(g => existingSlugs.Add(g.Slug)));
            _hasNext = result.HasNext;
        }
        catch (OperationCanceledException) {
            // Superseded by a newer request (or modal disposed) — leave _isLoading as-is;
            // the new request already set it to true (or the component is gone).
            return;
        }
        catch (Exception) {
            if (version != _searchVersion)
                return;
            // Real error — fall through to the empty-state block.
        }

        _isLoading = false;
        SafeStateHasChanged();

        // Defer empty/error state by 500ms to avoid flicker if user is still typing.
        if (_gifItems.Count == 0) {
            try {
                await Task.Delay(500, ct).ConfigureAwait(true);
                if (version == _searchVersion) {
                    _showEmpty = true;
                    SafeStateHasChanged();
                }
            }
            catch (OperationCanceledException) { }
        }
    }

    private void SwapSearchCts() {
        var old = _searchCts;
        _searchCts = CancellationTokenSource.CreateLinkedTokenSource(_disposeCts.Token);
        if (old is null)
            return;
        try { old.Cancel(); }
        catch (ObjectDisposedException) { }
        old.Dispose();
    }

    private void SafeStateHasChanged() {
        if (_disposeCts.IsCancellationRequested)
            return;
        try { StateHasChanged(); }
        catch (ObjectDisposedException) { }
    }

    private IEnumerable<GifItem> EnumerateColumn(int column)
        => _gifItems.Where((_, i) => i % 2 == column);

    private static string GetAspectRatioStyle(GifItem gif)
        => gif.PreviewWidth > 0 && gif.PreviewHeight > 0
            ? $"aspect-ratio: {gif.PreviewWidth} / {gif.PreviewHeight}"
            : "aspect-ratio: 1 / 1";

    public void Dispose() {
        if (!_disposeCts.IsCancellationRequested) {
            try { _disposeCts.Cancel(); }
            catch (ObjectDisposedException) { }
        }
        _disposeCts.Dispose();
        _searchCts?.Dispose();
    }

    // Nested types

    public sealed class Model {
        public string InitialTabId { get; set; } = "emoji";
        public Emoji? SelectedEmoji { get; set; }
        public string? SelectedGifUrl { get; set; }
    }
}
