@namespace ActualChat.UI.Blazor.App.Components
@implements IModalView<EmojiModal.Model>
@inherits ComponentBase<AppUIHub>

<DialogFrame
    Class="emoji-modal"
    HasCloseButton="true"
    HasHeader="false"
    NarrowViewSettings="DialogFrameNarrowViewSettings.Bottom">
    <Body>
        <TabPanel @ref="_tabPanel" BottomHill="true" TabsClass="emoji-modal-tabs">
            <Tab Id="emoji" Title="Emoji" Order="0">
                <div class="c-grid">
                    @foreach (var group in Enum.GetValues<EmojiGroup>()) {
                        <div @key="group" class="c-group">
                            <div class="c-group-title">@group</div>
                            <div class="c-group-items">
                                @foreach (var emoji in Emojis.GetByGroup(group)) {
                                    <button @key="emoji"
                                        class="c-item"
                                        @onclick="@(() => OnEmojiClick(emoji))">
                                        <EmojiIcon Emoji="@emoji" Class="c-emoji" HasPreview="true"/>
                                    </button>
                                }
                            </div>
                        </div>
                    }
                </div>
            </Tab>
            <Tab Id="gif" Title="GIF" Order="1">
                <div class="c-gif-tab">
                    <SearchBox Placeholder="Search GIFs..." TextChanged="@OnGifSearch"/>
                    <div class="c-gif-grid">
                        @foreach (var gif in _gifItems) {
                            <button @key="gif.Slug"
                                    class="c-gif-item"
                                    @onclick="@(() => OnGifClick(gif))">
                                <img class="c-gif-img"
                                     src="@gif.PreviewUrl"
                                     alt=""
                                     loading="lazy"/>
                            </button>
                        }
                    </div>
                    @if (_isLoading) {
                        <div class="c-gif-status">Loading...</div>
                    } else if (_gifItems.Count == 0 && _showEmpty) {
                        <div class="c-gif-status">No GIFs found</div>
                    } else if (_hasNext && _gifItems.Count > 0) {
                        <button class="c-gif-status" @onclick="@LoadMoreGifs">Load more</button>
                    }
                </div>
            </Tab>
        </TabPanel>
    </Body>
</DialogFrame>

@code {
    private readonly List<GifItem> _gifItems = new();
    private CancellationTokenSource? _searchCts;
    private TabPanel? _tabPanel;
    private string _searchQuery = "";
    private int _page = 1;
    private bool _hasNext;
    private bool _isLoading;
    private bool _gifsLoaded;
    private bool _showEmpty;

    private IGifs Gifs => Hub.Gifs;

    [CascadingParameter] public Modal Modal { get; set; } = null!;
    [Parameter] public Model ModalModel { get; set; } = null!;

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (firstRender) {
            if (_tabPanel != null && ModalModel.InitialTabId != "emoji")
                _tabPanel.SelectedTabId = ModalModel.InitialTabId;
            if (!_gifsLoaded)
                await LoadGifs().ConfigureAwait(true);
        }
    }

    private void OnEmojiClick(Emoji emoji) {
        ModalModel.SelectedEmoji = emoji;
        Modal.Close();
    }

    private void OnGifClick(GifItem gif) {
        ModalModel.SelectedGifUrl = gif.Url;
        Modal.Close();
    }

    private async Task OnGifSearch(string query) {
        _searchQuery = query.Trim();
        _page = 1;
        _gifItems.Clear();
        _hasNext = false;
        _searchCts?.Cancel();
        _searchCts = new CancellationTokenSource();

        try {
            await Task.Delay(300, _searchCts.Token).ConfigureAwait(true);
            await LoadGifs().ConfigureAwait(true);
        }
        catch (OperationCanceledException) { }
    }

    private async Task LoadMoreGifs() {
        _page++;
        await LoadGifs().ConfigureAwait(true);
    }

    private async Task LoadGifs() {
        _isLoading = true;
        _showEmpty = false;
        _gifsLoaded = true;
        StateHasChanged();
        try {
            var result = _searchQuery.IsNullOrEmpty()
                ? await Gifs.GetTrending(_page, CancellationToken.None).ConfigureAwait(true)
                : await Gifs.Search(_searchQuery, _page, CancellationToken.None).ConfigureAwait(true);
            var existingSlugs = _gifItems.Select(g => g.Slug).ToHashSet(StringComparer.Ordinal);
            _gifItems.AddRange(result.Items.Where(g => existingSlugs.Add(g.Slug)));
            _hasNext = result.HasNext;
        }
        catch (Exception) {
            // Ignore - UI shows empty state
        }
        finally {
            _isLoading = false;
            StateHasChanged();
        }
        if (_gifItems.Count == 0 && _searchCts is { } cts) {
            try {
                await Task.Delay(500, cts.Token).ConfigureAwait(true);
                _showEmpty = true;
                StateHasChanged();
            }
            catch (OperationCanceledException) { }
        }
    }

    // Nested types

    public sealed class Model {
        public string InitialTabId { get; set; } = "emoji";
        public Emoji? SelectedEmoji { get; set; }
        public string? SelectedGifUrl { get; set; }
    }
}
