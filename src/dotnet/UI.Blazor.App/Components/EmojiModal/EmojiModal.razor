@namespace ActualChat.UI.Blazor.App.Components
@implements IModalView<EmojiModal.Model>
@inherits ComponentBase<AppUIHub>
@{
    var tabs = new TabDef[] {
        new("emoji", L.Emoji_Title) {
            Class = "no-scrollbar",
            Content = @<div class="c-grid">
                           @if (_recentEmojis.Count > 0) {
                               <div class="c-emoji-recent">
                                   <div class="c-group-title">@L.Emoji_Recent</div>
                                   <div class="c-emoji-recent-list no-scrollbar">
                                       @foreach (var emoji in _recentEmojis) {
                                           @EmojiButton(emoji)
                                       }
                                   </div>
                               </div>
                           }
                           @foreach (var group in Enum.GetValues<EmojiGroup>()) {
                               <div @key="group" class="c-group">
                                   <div class="c-group-title">@group</div>
                                   <div class="c-group-items">
                                       @foreach (var emoji in Emojis.GetByGroup(group)) {
                                           @EmojiButton(emoji)
                                       }
                                   </div>
                               </div>
                           }
                       </div>,
        },
        new("gif", "GIF") {
            Class = "no-scrollbar",
            Content = @<GifPicker GifSelected="@OnGifSelected"/>,
        },
    };
}

<DialogFrame
    Class="emoji-modal"
    HasCloseButton="true"
    HasHeader="false"
    NarrowViewSettings="DialogFrameNarrowViewSettings.Bottom">
    <Body>
        <TabPanel
            @ref="_tabPanel"
            Tabs="@tabs"
            BottomHill="true"
            TabsClass="emoji-modal-tabs"
            SwapKind="@TabContentSwap.Swipe"/>
    </Body>
</DialogFrame>

@code {
    private const int MaxRecentEmojis = 7;
    private const string RecentEmojisKey = "EmojiModal.RecentEmojis";

    private TabPanel? _tabPanel;
    private readonly List<Emoji> _recentEmojis = new();

    private LocalStorage LocalStorage => Hub.LocalStorage;

    [CascadingParameter] public Modal Modal { get; set; } = null!;
    [Parameter] public Model ModalModel { get; set; } = null!;

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (firstRender) {
            if (_tabPanel != null && ModalModel.InitialTabId != "emoji")
                _tabPanel.SelectedTabId = ModalModel.InitialTabId;
            await LoadRecentEmojis().ConfigureAwait(true);
        }
    }

    private RenderFragment EmojiButton(Emoji emoji) => __builder => {
        <button @key="emoji"
            class="c-item"
            @onclick="@(() => OnEmojiClick(emoji))">
            <EmojiIcon Emoji="@emoji" Class="c-emoji" HasPreview="true"/>
        </button>
    };

    private async Task OnEmojiClick(Emoji emoji) {
        await SaveRecentEmoji(emoji).ConfigureAwait(true);
        ModalModel.SelectedEmoji = emoji;
        Modal.Close();
    }

    private void OnGifSelected(string url) {
        ModalModel.SelectedGifUrl = url;
        Modal.Close();
    }

    private async Task LoadRecentEmojis() {
        try {
            var json = await LocalStorage.GetString(RecentEmojisKey).ConfigureAwait(true);
            if (json.IsNullOrEmpty())
                return;
            var ids = SystemJsonSerializer.Default.Read<List<string>>(json);
            _recentEmojis.Clear();
            foreach (var id in ids) {
                if (_recentEmojis.Count >= MaxRecentEmojis)
                    break;
                if (Emojis.ById.TryGetValue(id, out var emoji))
                    _recentEmojis.Add(emoji);
            }
            StateHasChanged();
        }
        catch { /* corrupted data — ignore */ }
    }

    private async Task SaveRecentEmoji(Emoji emoji) {
        _recentEmojis.Remove(emoji);
        _recentEmojis.Insert(0, emoji);
        if (_recentEmojis.Count > MaxRecentEmojis)
            _recentEmojis.RemoveRange(MaxRecentEmojis, _recentEmojis.Count - MaxRecentEmojis);
        var ids = _recentEmojis.Select(e => e.Id.Value).ToList();
        var json = SystemJsonSerializer.Default.Write(ids);
        await LocalStorage.SetString(RecentEmojisKey, json).ConfigureAwait(false);
    }

    // Nested types

    public sealed class Model {
        public string InitialTabId { get; set; } = "emoji";
        public Emoji? SelectedEmoji { get; set; }
        public string? SelectedGifUrl { get; set; }
    }
}
