@using ActualChat.UI.Blazor.App.Module
@namespace ActualChat.UI.Blazor.App.Components
@implements IAsyncDisposable
@inherits ComponentBase<AppUIHub>

<div class="c-gif-tab">
    <SearchBox Placeholder="Search GIFs..." ClearButton="true" TextChanged="@OnSearch"/>
    <div class="c-gif-scroll no-scrollbar">
        @if (_recentGifs.Count > 0 && _searchQuery.IsNullOrEmpty()) {
            <div class="c-gif-recent">
                <div class="c-gif-recent-label">Recent</div>
                <div class="c-gif-recent-list no-scrollbar">
                    @foreach (var gif in _recentGifs) {
                        @GifButton(gif, "c-gif-recent-item", false)
                    }
                </div>
            </div>
        }
        <div class="c-gif-grid">
            @* Each new item is appended to the currently-shorter column (height estimated from aspect ratio).
               Stable: items are only appended, never reshuffled, so positions don't change across loads. *@
            @for (var col = 0; col < 2; col++) {
                var columnIndex = col;
                <div @key="@columnIndex" class="c-gif-col">
                    @foreach (var gif in _columns[columnIndex]) {
                        @GifButton(gif, "c-gif-item", true)
                    }
                    <div @ref="_sentinelRefs[columnIndex]" class="c-gif-sentinel"></div>
                </div>
            }
        </div>
        @if (_gifItems.Count == 0 && _showEmpty) {
            <div class="c-gif-status">No GIFs found</div>
        }
    </div>
</div>

@code {
    private static readonly string JSCreateMethod = $"{BlazorUIAppModule.ImportName}.EmojiModal.create";

    private const int MaxRecentGifs = 20;
    private const string RecentGifsKey = "GifPicker.Recent";

    private readonly List<GifItem> _gifItems = new();
    private readonly List<GifItem>[] _columns = [new(), new()];
    private readonly double[] _columnHeights = new double[2];
    private readonly CancellationTokenSource _disposeCts = new();
    private readonly List<GifItem> _recentGifs = new();
    private CancellationTokenSource? _searchCts;
    private readonly ElementReference[] _sentinelRefs = new ElementReference[2];
    private IJSObjectReference? _jsRef;
    private DotNetObjectReference<GifPicker>? _blazorRef;
    private string _searchQuery = "";
    private int _page = 1;
    private int _searchVersion;
    private bool _hasNext;
    private bool _isLoading;
    private bool _gifsLoaded;
    private bool _jsInitializing;
    private bool _showEmpty;

    private IGifs Gifs => Hub.Gifs;
    private LocalStorage LocalStorage => Hub.LocalStorage;

    [Parameter] public EventCallback<string> GifSelected { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (firstRender) {
            await LoadRecentGifs().ConfigureAwait(true);
            if (!_gifsLoaded)
                await LoadGifs().ConfigureAwait(true);
        }
        await TryInitObserver().ConfigureAwait(true);
    }

    private async Task TryInitObserver() {
        if (_jsRef != null || _jsInitializing || !_gifsLoaded)
            return;
        _jsInitializing = true;
        _blazorRef = DotNetObjectReference.Create(this);
        _jsRef = await JS.InvokeAsync<IJSObjectReference>(JSCreateMethod, _sentinelRefs, _blazorRef)
            .ConfigureAwait(true);
    }

    [JSInvokable]
    public Task OnSentinelVisible()
        => _hasNext ? LoadMoreGifs() : Task.CompletedTask;

    private async Task OnSearch(string query) {
        _searchQuery = query.Trim();
        _page = 1;
        _gifItems.Clear();
        _columns[0].Clear();
        _columns[1].Clear();
        _columnHeights[0] = 0;
        _columnHeights[1] = 0;
        _hasNext = false;
        _showEmpty = false;
        SwapSearchCts();
        var ct = _searchCts!.Token;

        try {
            await Task.Delay(300, ct).ConfigureAwait(true);
            await LoadGifs().ConfigureAwait(true);
        }
        catch (OperationCanceledException) { }
    }

    private async Task LoadMoreGifs() {
        if (_isLoading)
            return;
        _page++;
        await LoadGifs().ConfigureAwait(true);
    }

    private async Task LoadGifs() {
        var version = ++_searchVersion;
        var query = _searchQuery;
        var page = _page;
        var ct = _searchCts?.Token ?? _disposeCts.Token;

        _isLoading = true;
        _showEmpty = false;
        _gifsLoaded = true;
        SafeStateHasChanged();

        try {
            var result = query.IsNullOrEmpty()
                ? await Gifs.GetTrending(page, ct).ConfigureAwait(true)
                : await Gifs.Search(query, page, ct).ConfigureAwait(true);
            if (version != _searchVersion)
                return;
            var existingSlugs = _gifItems.Select(g => g.Slug).ToHashSet(StringComparer.Ordinal);
            foreach (var gif in result.Items) {
                if (!existingSlugs.Add(gif.Slug))
                    continue;
                _gifItems.Add(gif);
                var shorter = _columnHeights[0] <= _columnHeights[1] ? 0 : 1;
                _columns[shorter].Add(gif);
                _columnHeights[shorter] += GetItemHeight(gif);
            }
            _hasNext = result.HasNext;
        }
        catch (OperationCanceledException) {
            return;
        }
        catch (Exception) {
            if (version != _searchVersion)
                return;
        }

        _isLoading = false;
        SafeStateHasChanged();

        if (_gifItems.Count == 0) {
            try {
                await Task.Delay(500, ct).ConfigureAwait(true);
                if (version == _searchVersion) {
                    _showEmpty = true;
                    SafeStateHasChanged();
                }
            }
            catch (OperationCanceledException) { }
        }
    }

    private RenderFragment GifButton(GifItem gif, string cls, bool lazy) => __builder => {
        var src = UrlMapper.GifProxyUrl(gif.PreviewUrl);
        if (src.IsNullOrEmpty())
            src = gif.PreviewUrl;
        <button @key="gif.Slug"
                class="@cls"
                @onclick="@(() => OnGifClick(gif))">
            <img class="c-gif-img"
                 src="@src"
                 alt=""
                 loading="@(lazy ? "lazy" : null)"
                 style="@GetAspectRatioStyle(gif)"/>
        </button>
    };

    private async Task OnGifClick(GifItem gif) {
        await SaveRecentGif(gif).ConfigureAwait(true);
        await GifSelected.InvokeAsync(gif.Url);
    }

    private async Task LoadRecentGifs() {
        try {
            var json = await LocalStorage.GetString(RecentGifsKey).ConfigureAwait(true);
            if (json.IsNullOrEmpty())
                return;
            var items = SystemJsonSerializer.Default.Read<List<RecentGifEntry>>(json);
            _recentGifs.Clear();
            foreach (var e in items)
                _recentGifs.Add(new GifItem(e.Slug, "", e.PreviewUrl, e.PreviewWidth, e.PreviewHeight, e.Url, 0, 0, ""));
            SafeStateHasChanged();
        }
        catch { /* corrupted data — ignore */ }
    }

    private async Task SaveRecentGif(GifItem gif) {
        _recentGifs.RemoveAll(g => string.Equals(g.Slug, gif.Slug, StringComparison.Ordinal));
        _recentGifs.Insert(0, gif);
        if (_recentGifs.Count > MaxRecentGifs)
            _recentGifs.RemoveRange(MaxRecentGifs, _recentGifs.Count - MaxRecentGifs);
        var entries = _recentGifs.Select(g => new RecentGifEntry(g.Slug, g.PreviewUrl, g.PreviewWidth, g.PreviewHeight, g.Url)).ToList();
        var json = SystemJsonSerializer.Default.Write(entries);
        await LocalStorage.SetString(RecentGifsKey, json).ConfigureAwait(false);
    }

    private void SwapSearchCts() {
        var old = _searchCts;
        _searchCts = CancellationTokenSource.CreateLinkedTokenSource(_disposeCts.Token);
        if (old is null)
            return;
        try { old.Cancel(); }
        catch (ObjectDisposedException) { }
        old.Dispose();
    }

    private void SafeStateHasChanged() {
        if (_disposeCts.IsCancellationRequested)
            return;
        try { StateHasChanged(); }
        catch (ObjectDisposedException) { }
    }

    private static double GetItemHeight(GifItem gif)
        => gif.PreviewWidth > 0 && gif.PreviewHeight > 0
            ? (double)gif.PreviewHeight / gif.PreviewWidth
            : 1.0;

    private static string GetAspectRatioStyle(GifItem gif)
        => gif.PreviewWidth > 0 && gif.PreviewHeight > 0
            ? $"aspect-ratio: {gif.PreviewWidth} / {gif.PreviewHeight}"
            : "aspect-ratio: 1 / 1";

    // Nested types

    private sealed record RecentGifEntry(string Slug, string PreviewUrl, int PreviewWidth, int PreviewHeight, string Url);

    public async ValueTask DisposeAsync() {
        if (!_disposeCts.IsCancellationRequested) {
            try { _disposeCts.Cancel(); }
            catch (ObjectDisposedException) { }
        }
        _disposeCts.Dispose();
        _searchCts?.Dispose();
        await _jsRef.DisposeSilentlyAsync("dispose");
        _jsRef = null;
        _blazorRef.DisposeSilently();
        _blazorRef = null;
    }
}
