@namespace ActualChat.UI.Blazor.App.Components
@inherits ComputedStateComponent<AppUIHub, LocationParticipantView.Model>
@{
    var m = State.Value;
}

<div class="c-participant" @onclick="@Click">
    <AvatarCircle Avatar="@Author.Avatar" Size="@SquareSize.Size10"/>
    <div class="c-info">
        <div class="c-name">
            <span>@Author.Avatar.Name</span>
            @if (m.IsOwn) {
                <span class="c-you">(you)</span>
            }
        </div>
        <div class="c-status">
            <span>Updated&nbsp;</span><LiveTimeDeltaText Moment="@Location.ModifiedAt" NullText=""/>
            @if (!m.DistanceText.IsNullOrEmpty()) {
                <span> · @m.DistanceText from you</span>
            }
            @if (!m.RemainingText.IsNullOrEmpty()) {
                <span> · @m.RemainingText left</span>
            }
        </div>
    </div>
</div>

@code {
    private IAuthors Authors => Hub.Authors;
    private LocationUI LocationUI => Hub.LocationUI;

    [Parameter, EditorRequired] public SharedLocation Location { get; set; } = null!;
    [Parameter, EditorRequired] public Author Author { get; set; } = null!;
    [Parameter] public GeoPoint? OwnPoint { get; set; }
    [Parameter] public EventCallback Click { get; set; }

    protected override ComputedState<Model>.Options GetStateOptions()
        => new () {
            InitialValue = Model.None,
            Category = GetStateCategory(GetType()),
        };

    protected override async Task<Model> ComputeState(CancellationToken cancellationToken) {
        var ownAuthor = await Authors.GetOwn(Session, Location.AuthorId.ChatId, cancellationToken).ConfigureAwait(false);
        var isOwn = ownAuthor != null && ownAuthor.Id == Author.Id;
        var distanceText = !isOwn && OwnPoint is { } ownPoint
            ? ToDistanceText(ownPoint.DistanceTo(Location.Point))
            : "";
        var remainingText = await LocationUI.GetTimeLeftText(Location.AuthorId, cancellationToken).ConfigureAwait(false);
        return new Model(isOwn, distanceText, remainingText);
    }

    private static string ToDistanceText(double meters)
        => meters switch {
            < 1 => "1 m",
            < 1000 => $"{meters:F0} m",
            < 10_000 => $"{meters / 1000:F1} km",
            _ => $"{meters / 1000:F0} km",
        };

    // Nested types

    public sealed record Model(bool IsOwn, string DistanceText, string RemainingText) {
        public static readonly Model None = new (false, "", "");
    }
}
