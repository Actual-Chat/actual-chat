@namespace ActualChat.UI.Blazor.App.Components
@inherits ComponentBase<UIHub>
@{
    var location = Participant.Location;
    var menuRef = MenuRef.New<LocationParticipantMenu>(location.AuthorId.ChatId.Value, location.Id.Value).ToString();
    var distanceText = !Participant.IsOwn && OwnPoint is { } ownPoint
        ? ownPoint.DistanceTextTo(Participant.Location.Point)
        : "";
}

<div class="c-participant" @onclick="@Click">
    <AvatarCircle Avatar="@Participant.Author.Avatar" Size="@SquareSize.Size10"/>
    <div class="c-info">
        <div class="c-name">
            <span>@Participant.Author.Avatar.Name</span>
            @if (Participant.IsOwn) {
                <span class="c-you">(you)</span>
            }
        </div>
        <div class="c-status">
            <span>@L.Location_Updated</span><LiveTimeDeltaText Moment="@Participant.Location.ModifiedAt" NullText=""/>
            @if (!distanceText.IsNullOrEmpty()) {
                <span> · @distanceText from you</span>
            }
        </div>
    </div>
    <div class="c-menu-btn" @onclick:stopPropagation="true">
        <ButtonRound
            Class="btn-sm btn-transparent"
            data-menu="@menuRef"
            data-menu-trigger="@MenuTrigger.Primary"
            data-menu-placement="@(FloatingPosition.TopEnd.ToPositionString())">
            <i class="icon-more-vertical"></i>
        </ButtonRound>
    </div>
</div>

@code {

    [Parameter, EditorRequired] public LocationParticipant Participant { get; set; } = null!;
    [Parameter] public GeoPoint? OwnPoint { get; set; }
    [Parameter] public EventCallback Click { get; set; }
}
