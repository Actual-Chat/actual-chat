@namespace ActualChat.UI.Blazor.App.Components
@inherits ComputedStateComponent<AppUIHub, LocationMapModal.ComputedModel>
@implements IModalView<LocationMapModal.Model>
@{
    var m = State.Value;
    var markers = m.Participants.Select(p => p.ToMapMarker(UrlMapper)).ToList();
}

<DialogFrame
    Class="location-map-modal"
    Title="Location"
    HasCloseButton="true"
    NarrowViewSettings="DialogFrameNarrowViewSettings.Default">
    <Body>
        <div class="c-map-host">
            @if (markers.Count == 0) {
                <div class="c-empty">No one is sharing their location right now.</div>
            } else {
                <MapView
                    @ref="_mapView"
                    Class="c-map"
                    Markers="@markers"
                    Center="@m.Center"/>
            }
        </div>
        @if (m.Participants.Count > 0) {
            <div class="c-participants custom-scrollbar">
                @foreach (var p in m.Participants) {
                    <LocationParticipant
                        @key="@p.Location.Id"
                        Location="@p.Location"
                        Author="@p.Author"
                        OwnPoint="@m.OwnPoint"
                        Click="@(() => OnParticipantClick(p))"/>
                }
            </div>
        }
    </Body>
</DialogFrame>

@code {
    private MapView? _mapView;

    private IAuthors Authors => Hub.Authors;
    private ISharedLocations SharedLocations => Hub.SharedLocations;
    private ILocationTracker Tracker => Hub.LocationTracker;
    private LocationUI LocationUI => Hub.LocationUI;

    [CascadingParameter] public Modal Modal { get; set; } = null!;
    [Parameter] public Model ModalModel { get; set; } = null!;

    protected override ComputedState<ComputedModel>.Options GetStateOptions()
        => ComputedStateComponent.GetStateOptions(GetType(),
            static t => new ComputedState<ComputedModel>.Options() {
                InitialValue = ComputedModel.None,
                UpdateDelayer = FixedDelayer.NextTick,
                Category = GetStateCategory(t),
            });

    protected override async Task<ComputedModel> ComputeState(CancellationToken cancellationToken) {
        var chatId = ModalModel.ChatId;
        var participants = await GetParticipants(cancellationToken).ConfigureAwait(false);
        if (participants.Count == 0)
            return ComputedModel.None;

        var ownLocation = await LocationUI.GetOwnLive(chatId, cancellationToken).ConfigureAwait(false);
        var ownPoint = ownLocation?.Point
            ?? await Tracker.LastKnown.Use(cancellationToken).ConfigureAwait(false);
        var clicked = ModalModel.LocationId is { } id ? participants.FirstOrDefault(x => x.Location.Id == id) : null;
        var center = clicked?.Location ?? ownLocation ?? participants[0].Location;
        return new ComputedModel(participants, ownPoint, center.Point);
    }

    private async Task<IReadOnlyList<Participant>> GetParticipants(CancellationToken cancellationToken) {
        var chatId = ModalModel.ChatId;
        var session = Session;
        var locations = await GetLocations(chatId, cancellationToken).ConfigureAwait(false);
        if (locations.Count == 0)
            return [];

        var participants = await locations.Select(x => GetParticipant(x, cancellationToken))
            .Collect(cancellationToken)
            .ConfigureAwait(false);
        var ownAuthor = await Authors.GetOwn(session, chatId, cancellationToken).ConfigureAwait(false);
        return participants
            .SkipNullItems()
            .OrderByDescending(p => ownAuthor != null && p.Author.Id == ownAuthor.Id)
            .ThenBy(p => p.Author.Avatar.Name, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private async Task<Participant?> GetParticipant(SharedLocation sharedLocation, CancellationToken cancellationToken) {
        var author = await Authors.Get(Session, sharedLocation.ChatId, sharedLocation.AuthorId, cancellationToken).ConfigureAwait(false);
        return author is null ? null : new Participant(sharedLocation, author);
    }

    private Task OnParticipantClick(Participant participant)
        => _mapView?.FlyTo(participant.Location.Point).AsTask() ?? Task.CompletedTask;

    private async Task<IReadOnlyList<SharedLocation>> GetLocations(ChatId chatId, CancellationToken cancellationToken) {
        if (ModalModel.LocationId is not { } locationId)
            return await SharedLocations.ListLive(Session, chatId, cancellationToken).ConfigureAwait(false);

        var location = await SharedLocations.Get(Session, chatId, locationId, cancellationToken).ConfigureAwait(false);
        if (location is null)
            return [];

        // A live share opens the shared map with everyone currently sharing (Telegram-style);
        // a stopped/one-shot pin stays a single static marker.
        if (!location.IsLive(Clocks.ServerClock.Now))
            return [location];

        var locations = await SharedLocations.ListLive(Session, chatId, cancellationToken).ConfigureAwait(false);
        return locations.Count > 0 ? locations : [location];
    }

    // Nested types

    public sealed record ComputedModel(
        IReadOnlyList<Participant> Participants,
        GeoPoint? OwnPoint,
        GeoPoint Center) {
        public static readonly ComputedModel None = new([], null, new GeoPoint(0, 0));
    }

    public sealed record Participant(
        SharedLocation Location,
        Author Author) {

        public MapMarker ToMapMarker(UrlMapper urlMapper) {
            var pictureUrl = Author.Avatar.Picture is { } picture ? urlMapper.PicturePreview128Url(picture) : "";
            var avatarKey = pictureUrl.IsNullOrEmpty()
                ? (Author.Avatar.Picture?.AvatarKey).NullIfEmpty() ?? DefaultUserPicture.GetAvatarKey(Author.Id.Value)
                : "";
            return new MapMarker(
                Location.Id.Value,
                Location.Point.Latitude,
                Location.Point.Longitude,
                Author.Avatar.Name,
                pictureUrl.NullIfEmpty(),
                avatarKey.NullIfEmpty());
        }
    }

    public sealed record Model(ChatId ChatId, SharedLocationId? LocationId = null);
}
