@namespace ActualChat.UI.Blazor.App.Components
@inherits ComputedStateComponent<AppUIHub, LocationMapModal.ComputedModel>
@implements IModalView<LocationMapModal.Model>
@{
    var m = State.Value;
}

<DialogFrame
    Class="location-map-modal"
    Title="Location"
    HasCloseButton="true"
    NarrowViewSettings="DialogFrameNarrowViewSettings.Default">
    <Body>
        <div class="c-map-host">
            @if (m.Markers.Count == 0) {
                <div class="c-empty">No one is sharing their location right now.</div>
            } else {
                <MapView
                    @ref="_mapView"
                    Class="c-map"
                    Markers="@m.Markers"
                    CenterLatitude="@m.CenterLatitude"
                    CenterLongitude="@m.CenterLongitude"/>
            }
        </div>
        @if (m.Participants.Count > 0) {
            <div class="c-participants custom-scrollbar">
                @foreach (var p in m.Participants) {
                    <div class="c-participant" @key="@p.LocationId" @onclick="@(() => OnParticipantClick(p))">
                        <AvatarCircle Avatar="@p.Avatar" Size="@SquareSize.Size10"/>
                        <div class="c-info">
                            <div class="c-name">
                                <span>@p.Avatar.Name</span>
                                @if (p.IsOwn) {
                                    <span class="c-you">(you)</span>
                                }
                            </div>
                            <div class="c-status">
                                <span>Updated&nbsp;</span><LiveTimeDeltaText Moment="@p.ModifiedAt" NullText=""/>
                                @if (!p.DistanceText.IsNullOrEmpty()) {
                                    <span> · @p.DistanceText from you</span>
                                }
                                @if (!p.RemainingText.IsNullOrEmpty()) {
                                    <span> · @p.RemainingText left</span>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </Body>
</DialogFrame>

@code {
    private MapView? _mapView;

    private IAuthors Authors => Hub.Authors;
    private ISharedLocations SharedLocations => Hub.SharedLocations;
    private ILocationTracker Tracker => field ??= Hub.Services.GetRequiredService<ILocationTracker>();
    private LocationUI LocationUI => field ??= Hub.LocationUI;

    [CascadingParameter] public Modal Modal { get; set; } = null!;
    [Parameter] public Model ModalModel { get; set; } = null!;

    protected override ComputedState<ComputedModel>.Options GetStateOptions()
        => ComputedStateComponent.GetStateOptions(GetType(),
            static t => new ComputedState<ComputedModel>.Options() {
                InitialValue = ComputedModel.None,
                UpdateDelayer = FixedDelayer.NextTick,
                Category = GetStateCategory(t),
            });

    protected override async Task<ComputedModel> ComputeState(CancellationToken cancellationToken) {
        var chatId = ModalModel.ChatId;
        var locations = await GetLocations(chatId, cancellationToken).ConfigureAwait(false);
        if (locations.Count == 0)
            return ComputedModel.None;

        // Authors.GetOwn, not AuthorUI.GetOwn: the viewer may have no author here
        // (e.g. reading a public chat they haven't joined), and the latter throws.
        var ownAuthor = await Authors.GetOwn(Session, chatId, cancellationToken).ConfigureAwait(false);
        var ownLocation = await LocationUI.GetOwnLiveLocation(chatId, cancellationToken).ConfigureAwait(false);
        var ownPoint = ownLocation?.Point
            ?? await Tracker.LastKnown.Use(cancellationToken).ConfigureAwait(false);
        var ownRemainingText = await LocationUI.GetOwnSharingRemainingText(chatId, cancellationToken).ConfigureAwait(false);
        var now = Clocks.ServerClock.Now;
        var markers = new List<MapMarker>(locations.Count);
        var participants = new List<Participant>(locations.Count);
        foreach (var location in locations) {
            var author = await Authors.Get(Session, location.ChatId, location.AuthorId, cancellationToken)
                .ConfigureAwait(false);
            if (author is null)
                continue;

            markers.Add(ToAvatarMarker(location, author.Avatar));
            var isOwn = ownAuthor != null && location.AuthorId == ownAuthor.Id;
            var distanceText = !isOwn && ownPoint != null
                ? ToDistanceText(ownPoint.DistanceTo(location.Point))
                : "";
            participants.Add(new Participant(
                location.Id,
                author.Avatar,
                isOwn,
                location.Point,
                location.ModifiedAt,
                distanceText,
                isOwn && location.IsLive(now) ? ownRemainingText : ""));
        }
        participants = participants
            .OrderByDescending(p => p.IsOwn)
            .ThenBy(p => p.Avatar.Name, StringComparer.OrdinalIgnoreCase)
            .ToList();
        // Center on the clicked share first, then the viewer's own, then the first one.
        var clicked = ModalModel.LocationId is { } id ? locations.FirstOrDefault(x => x.Id == id) : null;
        var center = (clicked ?? ownLocation ?? locations[0]).Point;
        return new ComputedModel(markers, participants, center.Latitude, center.Longitude);
    }

    private Task OnParticipantClick(Participant participant)
        => _mapView?.FlyTo(participant.Point.Latitude, participant.Point.Longitude).AsTask() ?? Task.CompletedTask;

    private MapMarker ToAvatarMarker(
        SharedLocation location,
        Avatar? avatar) {
        var pictureUrl = avatar?.Picture is { } picture ? UrlMapper.PicturePreview128Url(picture) : "";
        var avatarKey = pictureUrl.IsNullOrEmpty()
            ? (avatar?.Picture?.AvatarKey).NullIfEmpty() ?? DefaultUserPicture.GetAvatarKey(location.AuthorId.Value)
            : "";
        return new MapMarker(
            location.Id.Value,
            location.Point.Latitude,
            location.Point.Longitude,
            avatar?.Name,
            pictureUrl.NullIfEmpty(),
            avatarKey.NullIfEmpty());
    }

    private async Task<IReadOnlyList<SharedLocation>> GetLocations(ChatId chatId, CancellationToken cancellationToken) {
        if (ModalModel.LocationId is not { } locationId)
            return await SharedLocations.ListLive(Session, chatId, cancellationToken).ConfigureAwait(false);

        var location = await SharedLocations.Get(Session, chatId, locationId, cancellationToken).ConfigureAwait(false);
        if (location is null)
            return [];

        // A live share opens the shared map with everyone currently sharing (Telegram-style);
        // a stopped/one-shot pin stays a single static marker.
        if (!location.IsLive(Clocks.ServerClock.Now))
            return [location];

        var locations = await SharedLocations.ListLive(Session, chatId, cancellationToken).ConfigureAwait(false);
        return locations.Count > 0 ? locations : [location];
    }

    private static string ToDistanceText(double meters)
        => meters switch {
            < 1 => "1 m",
            < 1000 => $"{meters:F0} m",
            < 10_000 => $"{meters / 1000:F1} km",
            _ => $"{meters / 1000:F0} km",
        };

    // Nested types

    public sealed record ComputedModel(
        IReadOnlyList<MapMarker> Markers,
        IReadOnlyList<Participant> Participants,
        double CenterLatitude,
        double CenterLongitude) {
        public static readonly ComputedModel None = new([], [], 0, 0);
    }

    public sealed record Participant(
        SharedLocationId LocationId,
        Avatar Avatar,
        bool IsOwn,
        GeoPoint Point,
        Moment ModifiedAt,
        string DistanceText,
        string RemainingText);

    public sealed record Model(ChatId ChatId, SharedLocationId? LocationId = null);
}
