@namespace ActualChat.UI.Blazor.App.Components
@inherits ComputedStateComponent<AppUIHub, LocationMapModal.ComputedModel>
@implements IModalView<LocationMapModal.Model>
@{
    var m = State.Value;
    var markers = m.Participants.Select(ToMapMarker).ToList();
}

<DialogFrame
    Class="location-map-modal"
    Title="Location"
    HasCloseButton="true"
    NarrowViewSettings="DialogFrameNarrowViewSettings.Default">
    <Body>
        <div class="c-map-host">
            @if (markers.Count == 0) {
                <div class="c-empty">No one is sharing their location right now.</div>
            } else {
                <MapView
                    @ref="_mapView"
                    Class="c-map"
                    Markers="@markers"
                    Center="@m.Center"/>
            }
        </div>
        @if (m.Participants.Count > 0) {
            <div class="c-participants custom-scrollbar">
                @foreach (var p in m.Participants) {
                    <LocationParticipantView
                        @key="@p.Location.Id"
                        Location="@p.Location"
                        Author="@p.Author"
                        OwnPoint="@m.OwnPoint"
                        Click="@(() => OnParticipantClick(p))"/>
                }
            </div>
        }
    </Body>
</DialogFrame>

@code {
    private MapView? _mapView;

    private ILocationTracker Tracker => Hub.LocationTracker;
    private LocationUI LocationUI => Hub.LocationUI;

    [CascadingParameter] public Modal Modal { get; set; } = null!;
    [Parameter] public Model ModalModel { get; set; } = null!;

    protected override ComputedState<ComputedModel>.Options GetStateOptions()
        => ComputedStateComponent.GetStateOptions(GetType(),
            static t => new ComputedState<ComputedModel>.Options() {
                InitialValue = ComputedModel.None,
                UpdateDelayer = FixedDelayer.NextTick,
                Category = GetStateCategory(t),
            });

    protected override async Task<ComputedModel> ComputeState(CancellationToken cancellationToken) {
        var chatId = ModalModel.ChatId;
        var participants = await LocationUI.ListParticipants(chatId, ModalModel.LocationId, cancellationToken).ConfigureAwait(false);
        if (participants.Count == 0)
            return ComputedModel.None;

        var ownLocation = await LocationUI.GetOwnLive(chatId, cancellationToken).ConfigureAwait(false);
        var ownPoint = ownLocation?.Point
            ?? await Tracker.LastKnown.Use(cancellationToken).ConfigureAwait(false);
        var clicked = ModalModel.LocationId is { } id ? participants.FirstOrDefault(x => x.Location.Id == id) : null;
        var center = clicked?.Location ?? ownLocation ?? participants[0].Location;
        return new ComputedModel(participants, ownPoint, center.Point);
    }

    private Task OnParticipantClick(LocationParticipant participant)
        => _mapView?.FlyTo(participant.Location.Point).AsTask() ?? Task.CompletedTask;

    private MapMarker ToMapMarker(LocationParticipant participant) {
        var pictureUrl = participant.Author.Avatar.Picture is { } picture ? UrlMapper.PicturePreview128Url(picture) : "";
        var avatarKey = pictureUrl.IsNullOrEmpty()
            ? (participant.Author.Avatar.Picture?.AvatarKey).NullIfEmpty() ?? DefaultUserPicture.GetAvatarKey(participant.Author.Id.Value)
            : "";
        return new MapMarker(
            participant.Location.Id.Value,
            participant.Location.Point.Latitude,
            participant.Location.Point.Longitude,
            participant.Author.Avatar.Name,
            pictureUrl.NullIfEmpty(),
            avatarKey.NullIfEmpty());
    }

    // Nested types

    public sealed record ComputedModel(
        IReadOnlyList<LocationParticipant> Participants,
        GeoPoint? OwnPoint,
        GeoPoint Center) {
        public static readonly ComputedModel None = new([], null, new GeoPoint(0, 0));
    }

    public sealed record Model(ChatId ChatId, SharedLocationId? LocationId = null);
}
