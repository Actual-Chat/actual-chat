@namespace ActualChat.UI.Blazor.App.Components
@inherits ComputedStateComponent<AppUIHub, LocationMapModal.ComputedModel>
@implements IModalView<LocationMapModal.Model>
@{
    var m = State.Value;
    var markers = m.Participants
        // OwnMarker stands in for my own live share and only for that one: a frozen pin — a place,
        // or where I was earlier — keeps its marker, or the point just opened would show nothing.
        .Where(p => !(m.OwnMarker is not null && p.Location.Id == m.OwnLiveId))
        .Select(p => p.MapMarker)
        .ToList();
    if (m.OwnMarker is { } ownMarker)
        markers.Add(ownMarker);
}

<DialogFrame
    Class="location-map-modal"
    HasHeader="false"
    NarrowViewSettings="DialogFrameNarrowViewSettings.Default">
    <Body>
        <div class="c-map-host">
            @if (markers.Count == 0) {
                <div class="c-empty">@L.Location_NoOneSharing</div>
            } else {
                <MapView
                    @ref="_mapView"
                    Class="c-map"
                    Markers="@markers"
                    Center="@m.Center"/>
                <div class="c-map-menu">
                    <button type="button" class="c-map-menu-item" @onclick="@OnOpenMapTypeMenu">
                        <i class="icon-map"></i>
                    </button>
                    <button type="button" class="c-map-menu-item" @onclick="@OnLocate">
                        @if (m.IsLocating) {
                            <Spinner/>
                        } else {
                            <i class="icon-navigation-pointer"></i>
                        }
                    </button>
                </div>
            }
            <ButtonRound Class="c-close" Click="@OnClose">
                <i class="icon-close"></i>
            </ButtonRound>
            @if (m.Participants.Count > 0) {
                <div class="c-participants custom-scrollbar">
                    @foreach (var p in m.Participants) {
                        <LocationParticipantView
                            @key="@p.Location.Id"
                            Participant="@p"
                            OwnPoint="@m.OwnPoint"
                            Click="@(() => OnParticipantClick(p))"/>
                    }
                </div>
            }
        </div>
        @if (m.IsMapTypeMenuOpen) {
            <div class="c-menu-backdrop" @onclick="@OnCloseMapTypeMenu"></div>
            <div class="c-menu c-map-type-menu">
                @foreach (var info in MapTypes.All) {
                    <button
                        type="button"
                        class="c-menu-item"
                        disabled="@(!info.IsSupported)"
                        @onclick="@(() => OnPickMapType(info.Type))">
                        <i class="@info.Icon"></i>
                        <span>@info.Label</span>
                        @if (info.Type == m.MapType) {
                            <i class="c-check icon-checkmark-simple"></i>
                        }
                    </button>
                }
            </div>
        }
    </Body>
</DialogFrame>

@code {
    private MutableState<MapType> _mapType = null!;
    private MutableState<bool> _isMapTypeMenuOpen = null!;
    private MutableState<bool> _isLocating = null!;
    private MapView? _mapView;
    private FuncWorker? _refreshWorker;

    private LocationUI LocationUI => Hub.LocationUI;
    private ExternalMapOpener MapOpener => Hub.MapOpener;

    [CascadingParameter] public Modal Modal { get; set; } = null!;
    [Parameter] public Model ModalModel { get; set; } = null!;

    public override async ValueTask DisposeAsync() {
        await _refreshWorker.DisposeSilentlyAsync();
        _refreshWorker = null;
        await base.DisposeAsync();
    }

    protected override void OnInitialized() {
        _mapType = StateFactory.NewMutable(
            MapType.Map,
            StateCategories.Get(GetType(), nameof(_mapType)));
        _isMapTypeMenuOpen = StateFactory.NewMutable(
            false,
            StateCategories.Get(GetType(), nameof(_isMapTypeMenuOpen)));
        _isLocating = StateFactory.NewMutable(
            false,
            StateCategories.Get(GetType(), nameof(_isLocating)));
        // Merely viewing the map is no reason to pop the troubleshooter up.
        _refreshWorker = FuncWorker.Start(ct => LocationUI.RunLocationRefreshLoop(false, ct), Hub.StopToken);
        // Warms up the list the participant menu needs while the user is picking a participant
        _ = MapOpener.GetApps();
    }

    protected override ComputedState<ComputedModel>.Options GetStateOptions()
        => ComputedStateComponent.GetStateOptions(GetType(),
            static t => new ComputedState<ComputedModel>.Options() {
                InitialValue = ComputedModel.None,
                UpdateDelayer = FixedDelayer.NextTick,
                Category = GetStateCategory(t),
            });

    protected override async Task<ComputedModel> ComputeState(CancellationToken cancellationToken) {
        var mapType = await _mapType.Use(cancellationToken).ConfigureAwait(false);
        var isMapTypeMenuOpen = await _isMapTypeMenuOpen.Use(cancellationToken).ConfigureAwait(false);
        var isLocating = await _isLocating.Use(cancellationToken).ConfigureAwait(false);
        var chatId = ModalModel.ChatId;
        var participants = await LocationUI.ListParticipants(chatId, ModalModel.LocationId, cancellationToken)
            .ConfigureAwait(false);
        if (participants.Count == 0)
            return ComputedModel.None with { MapType = mapType };

        var ownLocation = await LocationUI.GetOwnLive(chatId, cancellationToken).ConfigureAwait(false);
        var ownPoint = await LocationUI.GetOwnCurrentOrSharedLocation(chatId, cancellationToken).ConfigureAwait(false);
        var ownMarker = await LocationUI.GetOwnMarker(chatId, cancellationToken).ConfigureAwait(false);
        var clicked = ModalModel.LocationId is { } id ? participants.FirstOrDefault(x => x.Location.Id == id) : null;
        var center = clicked?.Location ?? ownLocation ?? participants[0].Location;
        return new ComputedModel(participants,
            ownPoint,
            ownMarker,
            center.Point,
            ownLocation?.Id,
            mapType,
            isMapTypeMenuOpen,
            isLocating);
    }

    // Private methods

    private void OnClose()
        => Modal.Close();

    private Task OnParticipantClick(LocationParticipant participant)
        => _mapView?.FlyTo(participant.Location.Point).AsTask() ?? Task.CompletedTask;

    private void OnOpenMapTypeMenu()
        => _isMapTypeMenuOpen.Value = true;

    private void OnCloseMapTypeMenu()
        => _isMapTypeMenuOpen.Value = false;

    private void OnPickMapType(MapType type) {
        _mapType.Value = type;
        _isMapTypeMenuOpen.Value = false;
    }

    private async Task OnLocate() {
        if (_isLocating.Value)
            return;

        _isLocating.Value = true;
        try {
            var location = await LocationUI.RefreshCurrentLocation(true, Hub.StopToken).ConfigureAwait(true);
            if (location is { } point && _mapView is { } mapView)
                await mapView.FlyTo(point).ConfigureAwait(false);
        }
        finally {
            _isLocating.Value = false;
        }
    }

    // Nested types

    public sealed record ComputedModel(
        IReadOnlyList<LocationParticipant> Participants,
        GeoPoint? OwnPoint,
        MapMarker? OwnMarker,
        GeoPoint Center,
        SharedLocationId? OwnLiveId = null,
        MapType MapType = MapType.Map,
        bool IsMapTypeMenuOpen = false,
        bool IsLocating = false
    ) {
        public static readonly ComputedModel None = new([], null, null, new GeoPoint(0, 0));
    }

    public sealed record Model(ChatId ChatId, SharedLocationId? LocationId = null);
}
