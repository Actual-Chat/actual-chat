@inherits ComputedStateComponent<AppUIHub, ChatHeader.Model>
@{
    var m = State.Value;
    var chat = Chat;
    var searchCls = ScreenSize.IsNarrow() ? "btn-sm" : "";
    if (m.IsSearchMode)
        searchCls += " on";
    var isThread = chat?.Id.IsThread() ?? false;
    var showBackBtn = isThread || ScreenSize.IsNarrow();
    var isPanelVisible = IsRecordingHere || IsListeningHere || m.IsAnyoneVideoStreaming || (m.IsAnyoneTalking && m.AudioState?.ChatId == chat?.Id);

    // Show video panel when recording or remote streams exist
    if ((m.VideoState?.IsRecording == true || m.IsAnyoneVideoStreaming) && !_showVideoPanel) {
        _showVideoPanel = true;
        _pendingCameraDeviceId = m.VideoState?.SelectedCameraDeviceId;
    }
    // Hide video panel when recording stopped AND no remote video streams
    else if (_showVideoPanel && m.VideoState?.IsRecording != true && !m.IsAnyoneVideoStreaming) {
        _showVideoPanel = false;
        _pendingCameraDeviceId = null;
    }
}

@if (m.HasSelection) {
    <div class="c-content selection-header">
        <SelectionHeader />
    </div>
    return;
}

<div class="c-content">
    @if (IsLeftNavigateButtonVisible && showBackBtn) {
        <HeaderButton Click="@OnOpenLeftPanelClick" Class="chat-header-back">
            <i class="icon-arrow-left"></i>
        </HeaderButton>
    }
    <div class="chat-header-center" @onclick="@OnToggleRightPanelClick">
        @if (chat is not null) {
            <ChatIcon Chat="@chat"/>
            <div class="chat-header-title">
                <div class="c-title-wrapper">
                    <div class="c-title">
                        @chat.Title
                    </div>
                </div>
                <div class="c-info">
                    @if (chat.Kind != ChatKind.Peer) {
                        @if (chat.Rules.CanJoin()) {
                            <ChatMemberCounter ChatId="@chat.Id"/>
                        }
                    }
                    else { // chat.Kind == ChatKind.Peer
                        <StatusBadge Chat="@chat" IsColorful="@false"/>
                    }
                </div>
            </div>
            @if (!ScreenSize.IsNarrow()) {
                <ChatActivityPanel Chat="@chat"/>
            }
        } else {
            <ChatIcon Chat="@null"/>
            <div class="chat-header-title">
                <div class="c-title-wrapper">
                    <div class="c-title">
                        @NoChatTitle
                    </div>
                </div>
            </div>
        }
    </div>
    @if (chat is not null) {
        <div class="chat-header-control-panel hideable">
        <TranslationButton ChatId="@chat.Id"/>
        @if (chat.Id.IsThread(out var threadChatId)) {
            <ChatHeaderFollowThreadToggle ThreadChatId="@threadChatId"/>
        }
        @if (IsRightNavigateButtonVisible) {
            <ChatHeaderRightPanelToggle Chat="@Chat" Click="@OnToggleRightPanelClick"/>
        }
    </div>
    }
</div>
@if (ScreenSize.IsNarrow() && isPanelVisible) {
    <div class="header-activity-panel-wrapper">
        <ChatActivityPanel Chat="@chat" MaxCount="3" Click="@OnToggleRightPanelClick"/>
        <div class="pin-badge">
            <span class="c-badge-content">
                <i class="icon-arrow-down"></i> Pin Panel
            </span>
        </div>
        <div class="unpin-badge">
            <span class="c-badge-content">
                <i class="icon-arrow-down rotate-180"></i> Unpin Panel
            </span>
        </div>
    </div>
}

<VideoPanel Show="@_showVideoPanel" PendingCameraDeviceId="@_pendingCameraDeviceId"/>

@code {
    private bool _showVideoPanel;
    private string? _pendingCameraDeviceId;

    private IChats Chats => Hub.Chats;
    private LiveStreamUI LiveStreamUI => Hub.LiveStreamUI;
    private ChatAudioUI ChatAudioUI => Hub.ChatAudioUI;
    private ChatVideoUI ChatVideoUI => Hub.ChatVideoUI;
    private ActiveChatsUI ActiveChatsUI => Hub.ActiveChatsUI;

    private ChatId? RecordingChatId {
        get {
            var activeChats = ActiveChatsUI.ActiveChats.Value;
            var recordingChat = activeChats.FirstOrDefault(c => c.IsRecording);
            return recordingChat?.ChatId;
        }
    }

    private bool IsRecordingHere => Chat?.Id is not null && RecordingChatId == Chat.Id;
    private bool IsUpdating => Chat?.Id is not null && State.Value?.Chat?.Id != Chat.Id;
    private bool IsListeningHere => !IsUpdating && State is { Value.AudioState.IsListening: true } && State.Value.AudioState.ChatId == Chat?.Id;

    [CascadingParameter] public ScreenSize ScreenSize { get; set; }
    [ParameterComparer(typeof(ByRefParameterComparer))]
    [Parameter, EditorRequired] public Chat? Chat { get; set; }
    [Parameter] public bool IsLeftNavigateButtonVisible { get; set; } = true;
    [Parameter] public bool IsRightNavigateButtonVisible { get; set; } = true;
    [Parameter] public string NoChatTitle { get; set; } = "Loading...";

    protected override ComputedState<Model>.Options GetStateOptions()
        => ComputedStateComponent.GetStateOptions(GetType(),
            static t => new ComputedState<Model>.Options() {
                InitialValue = Model.None,
                UpdateDelayer = FixedDelayer.NextTick,
                Category = GetStateCategory(t),
            });

    protected override async Task<Model> ComputeState(CancellationToken cancellationToken) {
        var chatId = Chat?.Id;

        Chat? chat = null;
        ChatAudioState? audioState = null;
        ChatVideoState? videoState = null;
        if (chatId is not null)
            chat = await Chats.Get(Session, chatId, cancellationToken).ConfigureAwait(false);

        AuthorId[] authorIds = [];
        if (chatId is not null)
            authorIds = await LiveStreamUI.GetStreamingAuthorIds(chatId, cancellationToken).ConfigureAwait(false);

        if (chatId is not null) {
            audioState = await ChatAudioUI.GetState(chatId).ConfigureAwait(false);
            videoState = await ChatVideoUI.GetState(chatId, cancellationToken).ConfigureAwait(false);
        }

        var isAnyoneVideoStreaming = await ChatVideoUI.IsAnyoneVideoStreaming(chatId, cancellationToken).ConfigureAwait(false);

        var hasSelection = await Hub.SelectionUI.HasSelection.Use(cancellationToken).ConfigureAwait(false);
        var isSearchMode = await Hub.PanelsUI.Right.IsSearchMode.Use(cancellationToken).ConfigureAwait(false);
        var enableIncompleteUI = await Hub.Features.IsIncompleteUIEnabled(cancellationToken).ConfigureAwait(false);
        return new() {
            Chat = chat,
            AudioState = audioState,
            VideoState = videoState,
            IsAnyoneTalking = authorIds.Length > 0,
            IsAnyoneVideoStreaming = isAnyoneVideoStreaming,
            HasSelection = hasSelection,
            IsSearchMode = isSearchMode,
            EnableIncompleteUI = enableIncompleteUI,
        };
    }

    private void OnToggleRightPanelClick()
        => Hub.PanelsUI.Right.Toggle();

    private async Task OnOpenLeftPanelClick() {
        if (Chat is not null && Chat.Id.IsThread(out var threadChatId)) {
            var parentChatId = threadChatId.ParentChatId;
            var parentChatLink = Links.Chat(parentChatId);
            if (History.TryGetStepBackUrl(out var backUrl)) {
                var threadChatLink = Links.Chat(Chat.Id);
                if (backUrl.StartsWith(parentChatLink) && !backUrl.StartsWith(threadChatLink)) {
                    if (await History.TryStepBack())
                        return;
                }
            }

             await History.NavigateTo(parentChatLink, true);
             return;
        }

        if (ScreenSize.IsNarrow())
            Hub.PanelsUI.Left.SetIsVisible(true);
    }

    private void OnSearchClick()
        => Hub.PanelsUI.Right.SearchToggle();

    // Nested types

    public sealed record Model {
        public static readonly Model None = new ();

        public Chat? Chat { get; init; }
        public ChatAudioState? AudioState { get; init; }
        public ChatVideoState? VideoState { get; init; }
        public bool IsAnyoneTalking { get; init; }
        public bool IsAnyoneVideoStreaming { get; init; }
        public bool HasSelection { get; init; }
        public bool IsSearchMode { get; init; }
        public bool EnableIncompleteUI { get; init; }
    }
}
