@using System.ComponentModel.DataAnnotations
@inherits ComponentBase<AppUIHub>
@implements IModalView<OwnAccountEditorModal.Model>
@implements IDisposable
@{
    if (_account == null! || _form == null!)
        return;

    var email = _form.Email ?? "";
    var isEmailEmpty = email.IsNullOrEmpty();
    var isEmailVerified = !isEmailEmpty && _account.Identities.HasEmail(email);
    var phone = _form.ParsedPhone;
    var isPhoneVerified = phone != null && phone.IsNormalized() && _account.Identities.HasPhone(phone);
}

<Form @ref="@_formRef" Class="h-full" Model="@_form" OnSubmit="@OnSave">
    <AsyncDataAnnotationsValidator @ref="_validator"/>
    <DialogFrame
        Class="own-account-editor-modal"
        Title="@L.AccountEditor_Title"
        HasCloseButton="true"
        NarrowViewSettings="@DialogFrameNarrowViewSettings.ForFormSubmitButton()"
        ButtonsClass="full-width">
        <Body>
        <FormBlock>
            <FormSection
                For="() => _form.Name"
                IsRequired="true"
                InputId="@_form.NameFieldId"
                Label="@L.YourAccount_Name"
                IsLabelInsideInput="true">
                <TextBox
                    @bind-Value="@_form.Name"
                    Id="@_form.NameFieldId"
                    Autofocus="@(ModalModel.Field == AccountField.Name)"
                    ClearButton="true"/>
            </FormSection>

            <FormSection Class="form-section-alias"
                         For="() => _form.AliasId"
                         InputId="@_form.AliasIdFormId"
                         Label="@L.YourAccount_UserLink"
                         IsLabelInsideInput="true">
                <ValidationMessage Context="fieldLabel">
                    <AliasValidationMessage
                        For="@(() => _form.AliasId)"
                        Scope="@AliasValidationMessage.AliasScope.Account"
                        FieldLabel="@fieldLabel"
                        CurrentAliasId="@_form.CurrentAliasId"
                        AliasIdReader="@(() => _form.AliasId)"/>
                </ValidationMessage>
                <ChildContent>
                    <TextBox
                        Id="@_form.AliasIdFormId"
                        Prefix="@Links.UserAliasPrefix"
                        @bind-Value="@_form.AliasId"
                        Autofocus="@(ModalModel.Field == AccountField.AliasId)"
                        InputRefCreated="@_aliasTextBoxRefSetter"/>
                </ChildContent>
                <Right>
                    @if (!_copyAliasFormatString.IsNullOrEmpty() && !_aliasTextBoxRef.Id.IsNullOrEmpty()) {
                        <CopyToClipboard
                            IsSquare="true"
                            ButtonClass="btn-transparent btn-sm"
                            Text=""
                            CopyTextSourceRef="@_aliasTextBoxRef"
                            CopyTextFormatString="@_copyAliasFormatString"/>
                    }
                </Right>
            </FormSection>

            <FormSection
                For="() => _form.Email"
                InputId="@_form.EmailFieldId"
                Label="@L.YourAccount_Email"
                IsLabelInsideInput="true">
                <ChildContent>
                    <TextBox
                        @bind-Value="@_form.Email"
                        Id="@_form.EmailFieldId"
                        Autofocus="@(ModalModel.Field == AccountField.Email)"/>
                </ChildContent>
                <Right>
                    <VerificationStatus IsVerified="isEmailVerified"/>
                </Right>
            </FormSection>

            @if (_formRef.IsValid && !isEmailVerified && !isEmailEmpty) {
                <EmailVerifier Email="@email" Class="my-3"/>
            }

            <FormSection
                For="() => _form.Phone"
                InputId="@_form.PhoneFieldId"
                Label="@L.YourAccount_Phone"
                Class="grow"
                IsLabelInsideInput="true">
                <ChildContent>
                    <TextBox
                        Id="@_form.PhoneFieldId"
                        Value="@(!_form.Phone.IsNullOrEmpty() ? _form.Phone : _defaultPhoneValue)"
                        ValueExpression="@(() => _form.Phone)"
                        ValueChanged="@OnPhoneChanged"
                        Autofocus="@(ModalModel.Field == AccountField.Phone)"
                        Autocomplete="tel"
                        type="tel"
                        inputmode="tel"/>
                </ChildContent>
                <Right>
                    @if (phone != null) {
                        <VerificationStatus IsVerified="isPhoneVerified"/>
                    }
                </Right>
            </FormSection>

            @if (phone != null && !isPhoneVerified) {
                <PhoneVerifier Phone="@phone" Class="my-3"/>
            }
        </FormBlock>
        <FormBlock>
            <Card>
                <ButtonTile Class="btn-danger delete-account-tile" Click="@OnDeleteAccountClick">
                    <Icon>
                        <i class="icon-trash03"></i>
                    </Icon>
                    <Content>
                        <div class="c-text">
                            @L.AccountEditor_DeleteAccount
                        </div>
                    </Content>
                </ButtonTile>
            </Card>
        </FormBlock>
        </Body>
        <Buttons>
            <FormButtons>
                <Button
                    Type="@ButtonType.Button"
                    Class="btn-modal"
                    Click="OnCancel">
                    @L.Common_Cancel
                </Button>
                <Button
                    Type="@ButtonType.Submit"
                    Class="btn-modal btn-primary"
                    IsDisabled="@(!_formRef.IsValid)">
                    @L.Common_Save
                </Button>
            </FormButtons>
        </Buttons>
    </DialogFrame>
</Form>

@code {
    private readonly string _defaultPhoneValue = PhoneCodes.Default.DisplayCode;
    private Form _formRef = null!;
    private FormModel _form = null!;
    private AccountFull _account = null!;
    private AsyncDataAnnotationsValidator _validator = null!;
    private ElementReference _aliasTextBoxRef;
    private string _copyAliasFormatString = "";
    private Action<ElementReference> _aliasTextBoxRefSetter = null!;
    private IPhones Phones => Hub.Phones;
    [CascadingParameter] public Modal Modal { get; set; } = null!;
    [Parameter] public Model ModalModel { get; set; } = null!;

    protected override Task OnInitializedAsync() {
        _aliasTextBoxRefSetter = c => {
            _aliasTextBoxRef = c;
            StateHasChanged();
        };
        _copyAliasFormatString = UrlMapper.ToAbsolute(Links.UserAliasPrefix) + "{0}";

        _account = AccountUI.OwnAccount.Value;
        AccountUI.OwnAccount.Updated += OnOwnAccountChanged;
        _form = new FormModel(ComponentIdGenerator).CopyToBase(); // Must be fully initialized in sync part
        _form.Name = _account.Name;
        _form.Email = _account.Email.NullIfEmpty();
        _form.Phone = _account.Phone?.ToReadable() ?? "";
        _form.ParsedPhone = _account.Phone;
        _form.AliasId = _form.CurrentAliasId = _account.AliasId?.Value ?? "";
        _form.CopyToBase();
        return Task.CompletedTask;
    }

    public void Dispose()
        => AccountUI.OwnAccount.Updated -= OnOwnAccountChanged;

    private async Task OnSave() {
        if (!await _validator.Validate())
            return;

        var account = await Hub.Accounts.GetOwn(Session, default);
        var phone = _form.ParsedPhone = await Phones.ParseWithCountryFallback(Session, _form.Phone, default);
        if (phone != account.Phone) {
            if (phone != null)
                return;
        }

        var updateAccountCommand = new Accounts_Update {
            Session = Session,
            Account = account with {
                Name = _form.Name,
                Phone = phone,
                AliasId = AliasId.ParseNullable(_form.AliasId),
            },
            ExpectedVersion = account.Version,
        };
        var (_, error) = await Hub.UICommander.Run(updateAccountCommand);
        if (error != null)
            return;

        _form.CopyToBase();
        Modal.Close();
    }

    private void OnCancel()
        => Modal.Close();

    private async Task OnPhoneChanged(string? value) {
        var newValue = value ?? "";
        if (newValue == _defaultPhoneValue)
            newValue = "";
        _form.Phone = newValue;
        _form.ParsedPhone = await Phones.ParseWithCountryFallback(Session, newValue, default);
    }

    private Task OnDeleteAccountClick()
        => Hub.ModalUI.Show(new DeleteAccountModal.Model());

    private void OnOwnAccountChanged(State state, StateEventKind eventKind) {
        _account = AccountUI.OwnAccount.Value;
        _ = InvokeAsync(StateHasChanged);
    }

    // Nested types

    public sealed class FormModel(ComponentIdGenerator? componentIdGenerator)
        : FormModel<FormModel>("own-account-editor", componentIdGenerator) {
        [Required]
        public string Name { get; set; } = "";
        public string NameFieldId { get; set; } = "";
        [Email]
        public string? Email { get; set; }
        public string EmailFieldId { get; set; } = "";
        [PhoneNumber]
        public string Phone { get; set; } = "";
        public Phone? ParsedPhone { get; set; }
        public string PhoneFieldId { get; set; } = "";
        [AliasId]
        public string AliasId { get; set; } = "";
        public string CurrentAliasId { get; set; } = "";
        public string AliasIdFormId { get; set; } = "";
    }

    public sealed record Model(AccountField Field = AccountField.Name) {
        public static readonly Model Default = new();
    }
    public enum AccountField { Name, AliasId, Phone, Email }
}
