@namespace ActualChat.UI.Blazor.App.Components
@using ActualChat.WebHooks
@inherits ComputedStateComponent<AppUIHub, WebHookList.Model>
@{
    var m = State.Value;
    if (!m.IsEnabled)
        return;

    var isPersonal = Scope == WebHookScope.User;
}

<TileTopic Topic="@(isPersonal ? L.Settings_Webhooks : L.Integrations_Title)"/>

<ButtonTile Class="btn-primary" Filled="true" Click="@OnAddClick">
    <Content>@L.Integrations_Add</Content>
</ButtonTile>

<Tile Class="web-hook-tile">
    @if (m.Rows.Count == 0) {
        <TileItem IsHoverable="false">
            <Content>
                <span class="c-empty">@(isPersonal ? L.Integrations_PersonalEmpty : L.Integrations_Empty)</span>
            </Content>
        </TileItem>
    } else {
        @foreach (var row in m.Rows) {
            @if (row.CanManage) {
                <WebHookRow Row="@row" Click="@(() => OnHookClick(row.Hook.Id))"/>
            } else {
                <WebHookRow Row="@row"/>
            }
            @if (row != m.Rows[^1]) {
                <Divider/>
            }
        }
    }
</Tile>

@code {
    [Parameter, EditorRequired] public WebHookScope Scope { get; set; }
    [Parameter, EditorRequired] public string ScopeId { get; set; } = "";

    protected override ComputedState<Model>.Options GetStateOptions()
        => new() {
            InitialValue = new Model(),
            Category = GetStateCategory(GetType()),
        };

    protected override async Task<Model> ComputeState(CancellationToken cancellationToken) {
        var scope = Scope;
        var scopeId = ScopeId;
        var isEnabled = await Hub.Features.IsIncompleteUIEnabled(cancellationToken).ConfigureAwait(false);
        if (!isEnabled)
            return new Model();

        var hooks = await Hub.WebHooks.List(Session, scope, scopeId, cancellationToken).ConfigureAwait(false);
        var rows = new List<WebHookRow.Model>(hooks.Count);
        foreach (var hook in Sorted(hooks))
            rows.Add(await WebHookRow.ToModel(hook, L, Hub.LiveTime, cancellationToken).ConfigureAwait(false));
        if (scope == WebHookScope.User) {
            // The personal list doubles as "everything I created": chat and place hooks follow the personal ones
            var mine = await Hub.WebHooks.ListMine(Session, cancellationToken).ConfigureAwait(false);
            foreach (var hook in Sorted(mine.Where(x => x.Scope != WebHookScope.User)))
                rows.Add(await ToScopedRow(hook, cancellationToken).ConfigureAwait(false));
        }
        return new Model { IsEnabled = true, Rows = rows };
    }

    private static IEnumerable<WebHook> Sorted(IEnumerable<WebHook> hooks)
        => hooks.OrderBy(x => x.Name).ThenBy(x => x.CreatedAt);

    private async Task<WebHookRow.Model> ToScopedRow(WebHook hook, CancellationToken cancellationToken) {
        var row = await WebHookRow.ToModel(hook, L, Hub.LiveTime, cancellationToken).ConfigureAwait(false);
        // Get runs the same authorization as the detail page, so null means the hook is view-only here
        var canManage = await Hub.WebHooks.Get(Session, hook.Id, cancellationToken).ConfigureAwait(false) != null;
        var scopeText = canManage
            ? await GetScopeText(hook, cancellationToken).ConfigureAwait(false)
            : L.Integrations_NotManageable;
        return row with { ScopeText = scopeText, CanManage = canManage };
    }

    private async Task<string> GetScopeText(WebHook hook, CancellationToken cancellationToken) {
        if (hook.Scope == WebHookScope.Place) {
            var place = await Hub.Places.Get(Session, PlaceId.Parse(hook.ScopeId), cancellationToken)
                .ConfigureAwait(false);
            return L.Integrations_PlaceScope_Format(place?.Title ?? "");
        }

        var chat = await Hub.Chats.Get(Session, ChatId.Parse(hook.ScopeId), cancellationToken).ConfigureAwait(false);
        return L.Integrations_ChatScope_Format(chat?.Title ?? "");
    }

    private Task OnAddClick()
        => Hub.ModalUI.Show(new WebHookCreateModal.Model(Scope, ScopeId));

    private Task OnHookClick(WebHookId id)
        => Hub.ModalUI.Show(new WebHookDetailModal.Model(id));

    // Nested types

    public sealed record Model {
        public bool IsEnabled { get; init; }
        public List<WebHookRow.Model> Rows { get; init; } = [];
    }
}
