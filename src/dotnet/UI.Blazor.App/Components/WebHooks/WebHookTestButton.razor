@namespace ActualChat.UI.Blazor.App.Components
@using ActualChat.WebHooks
@inherits ComponentBase<AppUIHub>

<TileItem Class="tile-item-action web-hook-test-row" Click="@OnClick">
    <Icon><i class="icon-paper-plane"></i></Icon>
    <Content>@(IsIncoming ? L.WebHook_PostTest : L.WebHook_SendTest)</Content>
</TileItem>

@code {
    private bool _isRunning;

    [Parameter, EditorRequired] public WebHookId WebHookId { get; set; } = null!;
    [Parameter] public bool IsIncoming { get; set; }

    private async Task OnClick() {
        if (_isRunning)
            return;

        _isRunning = true;
        try {
            // The outcome shows up in the deliveries list below, so no inline result is needed here.
            await UICommander.Run(new WebHooks_Test { Session = Session, Id = WebHookId });
        }
        finally {
            _isRunning = false;
        }
    }
}
