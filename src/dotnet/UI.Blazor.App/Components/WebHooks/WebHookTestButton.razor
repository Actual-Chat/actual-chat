@namespace ActualChat.UI.Blazor.App.Components
@using ActualChat.WebHooks
@inherits ComponentBase<AppUIHub>

<div class="web-hook-test-button">
    <Button Class="btn-modal btn-outline" IsDisabled="@_isRunning" Click="@OnClick">
        <Icon><i class="icon-call-arrow-out text-xl"></i></Icon>
        <Title>@L.WebHook_SendTest</Title>
    </Button>
    @if (_result is { } result) {
        <span class="@(result.IsSuccess ? "c-result success" : "c-result failure")">
            @(result.IsSuccess
                ? L.WebHook_TestSucceeded_Format(result.StatusCode?.ToString() ?? "", result.LatencyMs)
                : L.WebHook_TestFailed_Format(result.Error ?? result.StatusCode?.ToString() ?? ""))
        </span>
    }
</div>

@code {
    private bool _isRunning;
    private WebHookTestResult? _result;

    [Parameter, EditorRequired] public WebHookId WebHookId { get; set; } = null!;

    private async Task OnClick() {
        _isRunning = true;
        _result = null;
        try {
            var result = await UICommander.Run(new WebHooks_Test { Session = Session, Id = WebHookId });
            if (!result.HasError)
                _result = result.Value;
        }
        finally {
            _isRunning = false;
        }
    }
}
