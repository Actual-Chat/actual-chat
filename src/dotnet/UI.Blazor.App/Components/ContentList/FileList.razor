@namespace ActualChat.UI.Blazor.App.Components
@inherits FusionComponentBase<AppUIHub>
@implements IVirtualListDataSource<ContentListItem>
@using ActualChat.Media

<div class="content-list-with-visor">
<ContentListDateVisor/>
<InfiniteList
    @key="@Identity"
    Class="content-list-tab content-list-rows"
    Identity="@Identity"
    DataSource="@this"
    SkeletonCount="8">
    <Item>
        @{ var item = context; }
        @if (item.IsEmptyPlaceholder) {
            <div class="c-empty">No files yet</div>
        }
        else if (item.IsHeader) {
            <div class="c-group-header">@item.GroupTitle</div>
        }
        else {
            var file = (FileItem)item.Items[0];
            if (MediaTypeExt.IsAudio(file.ContentType)) {
                <AudioFileRow File="@file" VisorDate="@item.VisorDate"/>
            }
            else {
                var url = UrlMapper.ContentUrl(file.BlobId);
                var menuRef = MenuRef.New<ChatContentItemMenu>(file.EntryId.Value, file.LocalIndex.ToString()).ToString();
                var kind = FileTypeHelper.GetKind(file.FileName, file.ContentType);
                var fileCls = FileTypeHelper.GetCssClass(kind);
                var iconCls = FileTypeHelper.GetIconClass(kind);
                <a class="c-file-row" href="@url" target="_blank" rel="noopener" role="button" data-menu="@menuRef" data-visor-date="@item.VisorDate">
                    <div class="c-file-icon @fileCls">
                        <i class="@iconCls"></i>
                    </div>
                    <div class="c-file-info">
                        <FileAttachmentTitle Title="@file.FileName"/>
                        <div class="c-file-size">@FileSizeFormatter.Format(file.Size)</div>
                        <div class="c-file-date">@FormatDate(file.At)</div>
                    </div>
                </a>
            }
        }
    </Item>
    <Skeleton>
        <div class="c-skeleton"></div>
    </Skeleton>
</InfiniteList>
</div>

@code {
    private IChats Chats => Hub.Chats;

    [Parameter, EditorRequired] public ChatId ChatId { get; set; } = null!;

    private string Identity => $"files:{ChatId}";

    public Task<VirtualListData<ContentListItem>> GetData(
        VirtualListDataQuery query,
        VirtualListData<ContentListItem> renderedData,
        CancellationToken cancellationToken)
        => ContentListPlumbing.LoadFromPeriods<FileItem>(
            Hub, Session, ChatId, query, renderedData,
            rowSize: 1,
            groupBy: ContentGrouping.Month,
            loadPage: (block, ct) => Chats.GetFilePeriod(Session, ChatId, block.PeriodKey, block.PageIndex, ct),
            rowFactory: BuildRow,
            prefetch: null,
            cancellationToken);

    private static ContentListItem BuildRow(FileItem[] items, string key, string visorDate)
        => new() {
            Key = key,
            Version = items[0].Version,
            Items = items,
            VisorDate = visorDate,
        };

    private string FormatDate(Moment at) {
        var date = DateTimeConverter.ToLocalTime(at);
        var today = DateTimeConverter.ToLocalTime(Hub.Clocks.SystemClock.Now);
        return date.Year == today.Year
            ? date.ToString("d MMM, HH:mm")
            : date.ToString("d MMM yyyy, HH:mm");
    }
}
