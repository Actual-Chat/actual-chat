@namespace ActualChat.UI.Blazor.App.Components
@inherits FusionComponentBase<AppUIHub>
@implements IVirtualListDataSource<ContentListItem>

<div class="content-list-with-visor">
<ContentListDateVisor/>
<InfiniteList
    @key="@Identity"
    Class="content-list-tab content-list-links"
    Identity="@Identity"
    DataSource="@this"
    SkeletonCount="8">
    <Item>
        @{ var item = context; }
        @if (item.IsEmptyPlaceholder) {
            <div class="c-empty">@L.Content_NoLinks</div>
        }
        else if (item.IsHeader) {
            <div class="c-group-header">@item.GroupTitle</div>
        }
        else {
            var link = (LinkItem)item.Items[0];
            var menuRef = MenuRef.New<ChatContentItemMenu>(link.EntryId.Value).ToString();
            <div class="message-link-preview" data-menu="@menuRef" data-visor-date="@item.VisorDate">
                @if (link.LinkPreview is { IsEmpty: false }) {
                    <LinkRow Entry="@item.LinkEntry" LinkPreview="@link.LinkPreview"/>
                }
                else {
                    var url = link.Url.NullIfEmpty() ?? link.LinkPreview?.Url ?? "";
                    <a class="link-preview no-thumbnail unfocusable c-link-plain" href="@url" target="_blank" rel="noopener">
                        <div class="c-icon"><i class="icon-link-2"></i></div>
                        <div class="c-info">
                            @if (url.Length > 0) {
                                <FileAttachmentTitle Title="@url"/>
                            }
                            else {
                                <span class="c-title">@L.Content_LinkUnavailable</span>
                            }
                        </div>
                    </a>
                }
            </div>
        }
    </Item>
    <Skeleton>
        <div class="c-skeleton"></div>
    </Skeleton>
</InfiniteList>
</div>

@code {
    private IChats Chats => Hub.Chats;

    [Parameter, EditorRequired] public ChatId ChatId { get; set; } = null!;

    private string Identity => $"links:{ChatId}";

    public Task<VirtualListData<ContentListItem>> GetData(
        VirtualListDataQuery query,
        VirtualListData<ContentListItem> renderedData,
        CancellationToken cancellationToken) {
        // Per-GetData scratch — captured by both prefetch (writes) and rowFactory (reads).
        // Holds ChatEntry-s for rich link previews; absent entries fall back to plain URL.
        var entries = new Dictionary<Symbol, ChatEntry>();
        return ContentListPlumbing.LoadFromPeriods<LinkItem>(
            Hub, Session, ChatId, query, renderedData,
            rowSize: 1,
            groupBy: ContentGrouping.Day,
            loadPage: (block, ct) => Chats.GetLinkPeriod(Session, ChatId, block.PeriodKey, block.PageIndex, ct),
            rowFactory: (items, key, visorDate) => {
                var link = items[0];
                entries.TryGetValue(link.Id, out var entry);
                return new ContentListItem {
                    Key = key,
                    Version = link.Version + (entry?.Version ?? 0),
                    Items = items,
                    LinkEntry = entry,
                    VisorDate = visorDate,
                };
            },
            prefetch: (items, ct) => PrefetchEntries(items, entries, ct),
            cancellationToken);
    }

    private async Task PrefetchEntries(
        IReadOnlyList<LinkItem> items,
        Dictionary<Symbol, ChatEntry> sink,
        CancellationToken cancellationToken) {
        var resolved = await items
            .Select(item => Chats.GetEntry(Session, item.EntryId, cancellationToken).AsTask())
            .Collect(cancellationToken)
            .ConfigureAwait(false);
        for (var i = 0; i < items.Count; i++)
            if (resolved[i] is { } entry)
                sink[items[i].Id] = entry;
    }
}
