@namespace ActualChat.UI.Blazor.App.Components
@inherits FusionComponentBase<AppUIHub>
@implements IVirtualListDataSource<ContentListItem>

<VirtualList
    @key="@Identity"
    Class="content-list-tab content-list-links"
    Identity="@Identity"
    DataSource="@this"
    SkeletonCount="8">
    <Item>
        @{ var item = context; }
        @if (item.IsEmptyPlaceholder) {
            <div class="c-empty">No links yet</div>
        }
        else if (item.IsGroup) {
            <div class="c-group-header">@item.GroupTitle</div>
        }
        else {
            var link = (LinkItem)item.Items[0];
            var menuRef = MenuRef.New<ChatContentItemMenu>(link.EntryId.Value).ToString();
            <div class="message-link-preview" data-menu="@menuRef">
                @if (link.LinkPreview is { IsEmpty: false }) {
                    <LinkPreviewView Entry="@item.LinkEntry" LinkPreview="@link.LinkPreview"/>
                }
                else {
                    var url = link.Url.NullIfEmpty() ?? link.LinkPreview?.Url ?? "";
                    <a class="c-link-plain" href="@url" target="_blank" rel="noopener">@(url.Length > 0 ? url : "[link unavailable]")</a>
                }
            </div>
        }
    </Item>
    <Skeleton>
        <div class="c-skeleton"></div>
    </Skeleton>
</VirtualList>

@code {
    private IChats Chats => Hub.Chats;

    [Parameter, EditorRequired] public ChatId ChatId { get; set; } = null!;

    private string Identity => $"links:{ChatId}";

    public Task<VirtualListData<ContentListItem>> GetData(
        VirtualListDataQuery query,
        VirtualListData<ContentListItem> renderedData,
        CancellationToken cancellationToken)
        => ContentListPlumbing.LoadFromPeriods<LinkItem>(
            Hub, Session, ChatId, query, renderedData,
            (periodKey, pageIndex, ct) => Chats.GetLinkPeriod(Session, ChatId, periodKey, pageIndex, ct),
            BuildItems,
            cancellationToken);

    private async Task<List<ContentListItem>> BuildItems(
        IReadOnlyList<ContentListPlumbing.Block> windowBlocks,
        IReadOnlyList<LinkItem[]> contents,
        CancellationToken cancellationToken) {
        // Resolve entries only for the rich-preview rendering path; absent entries are
        // fine — the fallback shows just the URL.
        var linkEntries = await ResolveLinkEntries(contents, cancellationToken).ConfigureAwait(false);
        var result = new List<ContentListItem>();
        string? currentGroupKey = null;

        for (var b = 0; b < windowBlocks.Count; b++) {
            var block = windowBlocks[b];
            var items = contents[b].Cast<IChatContentItem>().ToList();
            var rows = ContentListPlumbing.ChunkPage(items, 1, ContentGrouping.Day, DateTimeConverter);
            for (var r = rows.Count - 1; r >= 0; r--) {
                var (rowIndex, groupKey, rowItems) = rows[r];
                if (groupKey != currentGroupKey) {
                    currentGroupKey = groupKey;
                    var title = ContentListPlumbing.GetLocalGroup(rowItems[0].At, ContentGrouping.Day, DateTimeConverter).Title;
                    if (title.Length > 0)
                        result.Add(new ContentListItem { Key = $"g:{groupKey}", IsGroup = true, GroupTitle = title });
                }

                var link = (LinkItem)rowItems[0];
                linkEntries.TryGetValue(link.Id, out var entry);
                result.Add(new ContentListItem {
                    Key = $"i:{block.PeriodKey}:{block.PageIndex}:{rowIndex}",
                    Version = link.Version + (entry?.Version ?? 0),
                    Items = new IChatContentItem[] { link },
                    LinkEntry = entry,
                });
            }
        }
        return result;
    }

    private async Task<IReadOnlyDictionary<Symbol, ChatEntry>> ResolveLinkEntries(
        IReadOnlyList<LinkItem[]> contents,
        CancellationToken cancellationToken) {
        var items = contents.SelectMany(p => p).ToList();
        if (items.Count == 0)
            return new Dictionary<Symbol, ChatEntry>();
        var entries = await items
            .Select(item => Chats.GetEntry(Session, item.EntryId, cancellationToken).AsTask())
            .Collect(cancellationToken)
            .ConfigureAwait(false);
        var result = new Dictionary<Symbol, ChatEntry>(items.Count);
        for (var i = 0; i < items.Count; i++)
            if (entries[i] is { } entry)
                result[items[i].Id] = entry;
        return result;
    }

}
