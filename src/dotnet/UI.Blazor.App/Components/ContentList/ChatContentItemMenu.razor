@namespace ActualChat.UI.Blazor.App.Components
@using ActualChat.UI.Blazor.App.Module
@inherits ComputedMenuBase<AppUIHub, ChatContentItemMenu.Model>
@{
    var m = State.Value;
}

<div class="message-menu">
    <MenuEntry
        Icon="icon-message-ellipse"
        Text="@L.Content_GoToMessage"
        Click="@OnGoToMessage">
    </MenuEntry>
    @if (m.Attachment is not null) {
        <MenuEntry
            Icon="icon-share-2"
            Text="@L.Common_Share"
            Click="@OnShare">
        </MenuEntry>
        <MenuEntry
            Icon="icon-download"
            Text="@L.MessageMenu_Download"
            Click="@OnDownload">
        </MenuEntry>
    }
</div>

@code {
    private ChatEntryId _entryId = null!;
    private int? _index;

    private ChatUI ChatUI => Hub.ChatUI;
    private IChats Chats => Hub.Chats;

    protected override void OnParametersSet() {
        switch (Arguments) {
        case [var sEntryId]:
            _entryId = ChatEntryId.Parse(sEntryId);
            _index = null;
            break;
        case [var sEntryId, var sIndex]:
            _entryId = ChatEntryId.Parse(sEntryId);
            _index = int.Parse(sIndex);
            break;
        default:
            throw new ArgumentOutOfRangeException(nameof(Arguments));
        }
    }

    protected override ComputedState<Model>.Options GetStateOptions()
        => new() {
            InitialValue = Model.None,
            Category = GetStateCategory(GetType()),
        };

    protected override async Task<Model> ComputeState(CancellationToken cancellationToken) {
        if (_index is not { } index)
            return Model.None;

        var entry = await Chats.GetEntry(Session, _entryId, cancellationToken).ConfigureAwait(false);
        var attachment = entry?.Attachments.FirstOrDefault(a => a.Index == index);
        if (attachment is null)
            return Model.None;

        return new Model { Attachment = attachment };
    }

    private async Task OnGoToMessage() {
        await WhenClosed;
        ChatUI.HighlightEntry(_entryId, navigate: true);
        if (!PanelsUI.IsWide())
            PanelsUI.Right.SetIsVisible(false);
    }

    private Task OnShare()
        => State.Value.Attachment is { } a ? ShareUI.Share(a) : Task.CompletedTask;

    private Task OnDownload() {
        if (State.Value.Attachment is not { } attachment)
            return Task.CompletedTask;

        var media = attachment.Media;
        return Hub.FileDownloadUI.Download(media.BlobId, media.FileName, media.ContentType);
    }

    // Nested types

    public sealed record Model {
        public static readonly Model None = new();
        public ChatEntryAttachment? Attachment { get; init; }
    }
}
