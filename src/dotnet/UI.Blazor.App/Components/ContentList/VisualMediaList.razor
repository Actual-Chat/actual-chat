@namespace ActualChat.UI.Blazor.App.Components
@inherits FusionComponentBase<AppUIHub>
@implements IVirtualListDataSource<ContentListItem>
@implements IAsyncDisposable
@using ActualChat.Media
@using ActualChat.Time
@using ActualChat.UI.Blazor.App.Module

<div class="content-list-with-visor" @ref="Ref">
<ContentListDateVisor/>
<InfiniteList
    @key="@Identity"
    Class="content-list-tab content-list-grid"
    Identity="@Identity"
    DataSource="@this"
    ItemVisibilityChanged="@OnItemVisibilityChanged"
    SkeletonCount="8">
    <Item>
        @{ var item = context; }
        @if (item.IsEmptyPlaceholder) {
            <div class="c-empty">@L.Content_NoMedia</div>
        }
        else if (item.IsHeader) {
            <div class="c-group-header">@item.GroupTitle</div>
        }
        else {
            <div class="c-media-row" data-visor-date="@item.VisorDate">
                @foreach (var media in item.Items.Cast<VisualMediaItem>()) {
                    var url = UrlMapper.ContentUrl(media.BlobId);
                    var menuRef = MenuRef.New<ChatContentItemMenu>(media.EntryId.Value, media.LocalIndex.ToString()).ToString();
                    if (MediaTypeExt.IsSupportedVideo(media.ContentType)) {
                        var thumb = media.ThumbnailBlobId.IsNullOrEmpty() ? "" : UrlMapper.ContentUrl(media.ThumbnailBlobId);
                        <a class="image-attachment c-video" @key="@media.Id"
                           href="@url" role="button" data-menu="@menuRef"
                           @onclick="@(() => OnMediaClick(item.Key, media))" @onclick:preventDefault="true">
                            @if (thumb.Length > 0) {
                                <image-skeleton initial-state="skeleton" src="@thumb"/>
                            }
                            <i class="icon-play-fill c-play-icon"></i>
                            @if (media.DurationMs > 0) {
                                <div class="c-duration">@TimeSpan.FromMilliseconds(media.DurationMs).Format(TimeSpanFormat.Clock)</div>
                            }
                            else {
                                <div class="c-duration" data-duration-url="@url" data-media-id="@media.MediaId.Value"></div>
                            }
                        </a>
                    }
                    else {
                        var previewUrl = UrlMapper.ImagePreviewUrl(url, null, 320);
                        <a class="image-attachment" @key="@media.Id"
                           href="@url" role="button" data-menu="@menuRef"
                           @onclick="@(() => OnMediaClick(item.Key, media))" @onclick:preventDefault="true">
                            <image-skeleton initial-state="skeleton" src="@url" thumbnailSrc="@previewUrl"/>
                        </a>
                    }
                }
            </div>
        }
    </Item>
    <Skeleton>
        <div class="c-skeleton"></div>
    </Skeleton>
</InfiniteList>
</div>

@code {
    private static readonly string JSCreateMethod = $"{BlazorUIAppModule.ImportName}.VisualMediaDuration.create";

    private const int GridColumns = 3;
    private const int GalleryRadius = 12;

    private IChats Chats => Hub.Chats;
    private VisualMediaViewerUI VisualMediaViewerUI => Hub.VisualMediaViewerUI;

    private IJSObjectReference? JSRef { get; set; }
    private ElementReference Ref { get; set; }
    private string[] _lastVisibleKeys = [];

    [Parameter, EditorRequired] public ChatId ChatId { get; set; } = null!;

    private string Identity => $"visualMedia:{ChatId}";

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (!firstRender)
            return;

        JSRef = await Hub.JS.InvokeAsync<IJSObjectReference>(JSCreateMethod, Ref);
        // Visibility may have been reported before JSRef existed (those events are
        // dropped below); flush the last known set so a static first paint resolves
        // without waiting for a scroll to fire the next ItemVisibilityChanged.
        if (_lastVisibleKeys.Length > 0)
            await JSRef.InvokeVoidAsync("setVisibleKeys", (object)_lastVisibleKeys);
    }

    public async ValueTask DisposeAsync() {
        await JSRef.DisposeSilentlyAsync("dispose");
        JSRef = null;
    }

    private void OnItemVisibilityChanged(VirtualListItemVisibility visibility) {
        _lastVisibleKeys = visibility.VisibleKeys.ToArray();
        if (JSRef is {} jsRef)
            _ = jsRef.InvokeVoidAsync("setVisibleKeys", (object)_lastVisibleKeys);
    }

    public Task<VirtualListData<ContentListItem>> GetData(
        VirtualListDataQuery query,
        VirtualListData<ContentListItem> renderedData,
        CancellationToken cancellationToken)
        => ContentListPlumbing.LoadFromPeriods<VisualMediaItem>(
            Hub, Session, ChatId, query, renderedData,
            rowSize: GridColumns,
            groupBy: ContentGrouping.Month,
            loadPage: (block, ct) => Chats.GetVisualMediaPeriod(Session, ChatId, block.PeriodKey, block.PageIndex, ct),
            rowFactory: BuildRow,
            prefetch: null,
            cancellationToken);

    private static ContentListItem BuildRow(VisualMediaItem[] items, string key, string visorDate)
        => new() {
            Key = key,
            Version = ContentListPlumbing.SumVersion(items),
            Items = items,
            VisorDate = visorDate,
        };

    private async Task OnMediaClick(string anchorRowKey, VisualMediaItem media) {
        var view = await MediaIndexCollectionView.Create(Hub, Session, ChatId, media, anchorRowKey, GalleryRadius, CancellationToken.None);
        await VisualMediaViewerUI.Show(view);
    }
}
