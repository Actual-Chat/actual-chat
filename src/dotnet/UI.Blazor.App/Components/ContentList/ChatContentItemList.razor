@namespace ActualChat.UI.Blazor.App.Components
@inherits FusionComponentBase<AppUIHub>
@implements IVirtualListDataSource<ContentListItem>

<VirtualList
    @key="@Identity"
    Class="@($"content-list-tab {ModeClass}")"
    Identity="@Identity"
    DataSource="@this"
    SkeletonCount="8">
    <Item>
        @{ var item = context; }
        @if (item.IsEmptyPlaceholder) {
            <div class="c-empty">@EmptyText</div>
        }
        else if (item.IsGroup) {
            <div class="c-group-header">@item.GroupTitle</div>
        }
        else if (Kind == ChatContentKind.File) {
            @RenderFileRow(item.Items[0])
        }
        else if (Kind == ChatContentKind.Link) {
            @RenderLinkCard(item)
        }
        else {
            <div class="c-media-row">
                @foreach (var media in item.Items) {
                    @RenderMediaTile(media)
                }
            </div>
        }
    </Item>
    <Skeleton>
        <div class="c-skeleton"></div>
    </Skeleton>
</VirtualList>

@code {
    private const int GridColumns = 3;
    private const int InitialWindow = 60;
    private const int MinWindow = 40;
    private static readonly IReadOnlyDictionary<Symbol, ChatEntry> EmptyLinkEntries = new Dictionary<Symbol, ChatEntry>();

    private IChats Chats => Hub.Chats;
    private VisualMediaViewerUI VisualMediaViewerUI => Hub.VisualMediaViewerUI;

    [Parameter, EditorRequired] public ChatId? ChatId { get; set; }
    [Parameter] public ChatContentKind Kind { get; set; } = ChatContentKind.Photo;
    [Parameter] public ContentGrouping GroupBy { get; set; } = ContentGrouping.Month;

    private string Identity => $"content:{ChatId}:{Kind}:{GroupBy}";
    private bool IsGridMode => (Kind & (ChatContentKind.File | ChatContentKind.Link)) == 0;

    private string ModeClass => Kind switch {
        ChatContentKind.Link => "content-list-links",
        ChatContentKind.File => "content-list-rows",
        _ => "content-list-grid",
    };

    private string EmptyText => Kind switch {
        ChatContentKind.Photo => "No photos yet",
        ChatContentKind.Video => "No videos yet",
        ChatContentKind.File => "No files yet",
        ChatContentKind.Link => "No links yet",
        _ => "No media yet",
    };

    public async Task<VirtualListData<ContentListItem>> GetData(
        VirtualListDataQuery query,
        VirtualListData<ContentListItem> renderedData,
        CancellationToken cancellationToken) {
        var chatId = ChatId;
        if (chatId is null)
            return VirtualListData<ContentListItem>.None;

        var periods = await Chats.GetContentPeriods(Session, chatId, Kind, cancellationToken).ConfigureAwait(false);
        if (periods.Length == 0)
            return EmptyData();

        var blocks = BuildBlocks(periods);
        var (first, last) = GetWindow(query, blocks);
        var windowBlocks = blocks.GetRange(first, last - first);
        var contents = await windowBlocks
            .Select(b => Chats.GetContentPeriod(Session, chatId, Kind, b.PeriodKey, b.PageIndex, cancellationToken))
            .Collect(cancellationToken)
            .ConfigureAwait(false);

        var linkEntries = await ResolveLinkEntries(contents, cancellationToken).ConfigureAwait(false);
        var listItems = BuildItems(windowBlocks, contents, linkEntries);
        if (listItems.Count == 0)
            return EmptyData();

        var result = new VirtualListData<ContentListItem>(listItems) {
            Index = renderedData.Index + 1,
            HasVeryFirstItem = last == blocks.Count,
            HasVeryLastItem = first == 0,
        };
        return result.IsSimilarTo(renderedData) ? renderedData : result;
    }

    // Private methods

    private static List<Block> BuildBlocks(IReadOnlyList<ChatContentPeriod> periods) {
        var pageSize = ChatContentPeriod.PageSize;
        var blocks = new List<Block>();
        foreach (var period in periods) {
            var pageCount = Math.Max(1, (period.ItemCount + pageSize - 1) / pageSize);
            for (var p = pageCount - 1; p >= 0; p--) {
                var itemCount = p == pageCount - 1 ? period.ItemCount - p * pageSize : pageSize;
                blocks.Add(new Block(period.PeriodKey, p, itemCount));
            }
        }
        return blocks;
    }

    private static (int First, int Last) GetWindow(VirtualListDataQuery query, List<Block> blocks) {
        int first, last;
        if (query.IsNone)
            (first, last) = (0, 0);
        else {
            var s = FindBlockIndex(blocks, query.KeyRange.Start);
            var e = FindBlockIndex(blocks, query.KeyRange.End);
            if (s < 0 || e < 0)
                (first, last) = (0, 0);
            else {
                first = Math.Max(0, Math.Min(s, e) - 1);
                last = Math.Min(blocks.Count, Math.Max(s, e) + 2);
            }
        }

        var targetCount = first == last ? InitialWindow : MinWindow;
        var sum = 0;
        for (var i = first; i < last; i++)
            sum += blocks[i].ItemCount;
        while (sum < targetCount && last < blocks.Count)
            sum += blocks[last++].ItemCount;
        if (last == first)
            last = Math.Min(blocks.Count, first + 1);
        return (first, last);
    }

    private static int FindBlockIndex(List<Block> blocks, string key) {
        var parts = key.Split(':');
        if (parts.Length < 4 || (parts[0] != "r" && parts[0] != "i"))
            return -1;
        if (!int.TryParse(parts[2], out var pageIndex))
            return -1;

        return blocks.FindIndex(b => b.PeriodKey == parts[1] && b.PageIndex == pageIndex);
    }

    private List<ContentListItem> BuildItems(
        IReadOnlyList<Block> windowBlocks,
        IReadOnlyList<ChatContentItem[]> contents,
        IReadOnlyDictionary<Symbol, ChatEntry> linkEntries) {
        var result = new List<ContentListItem>();
        var isGrid = IsGridMode;
        var isLink = Kind == ChatContentKind.Link;
        var chunkSize = isGrid ? GridColumns : 1;
        string? currentGroupKey = null;

        for (var b = 0; b < windowBlocks.Count; b++) {
            var block = windowBlocks[b];
            var rows = ChunkPage(contents[b], chunkSize, isLink, linkEntries);
            for (var r = rows.Count - 1; r >= 0; r--) {
                var (rowIndex, groupKey, items) = rows[r];
                if (groupKey != currentGroupKey) {
                    currentGroupKey = groupKey;
                    var title = GetLocalGroup(items[0].At).Title;
                    if (title.Length > 0)
                        result.Add(new ContentListItem { Key = $"g:{groupKey}", IsGroup = true, GroupTitle = title });
                }

                var displayItems = new ChatContentItem[items.Length];
                for (var k = 0; k < items.Length; k++)
                    displayItems[k] = items[items.Length - 1 - k];
                if (isGrid)
                    result.Add(new ContentListItem {
                        Key = $"r:{block.PeriodKey}:{block.PageIndex}:{rowIndex}",
                        Version = SumVersion(displayItems),
                        Items = displayItems,
                    });
                else {
                    var item = displayItems[0];
                    var entry = isLink ? linkEntries[item.Id] : null;
                    result.Add(new ContentListItem {
                        Key = $"i:{block.PeriodKey}:{block.PageIndex}:{rowIndex}",
                        Version = item.Version + (entry?.Version ?? 0),
                        Items = displayItems,
                        LinkEntry = entry,
                    });
                }
            }
        }
        return result;
    }

    private List<(int RowIndex, string GroupKey, ChatContentItem[] Items)> ChunkPage(
        ChatContentItem[] pageItems,
        int chunkSize,
        bool skipLinks,
        IReadOnlyDictionary<Symbol, ChatEntry> linkEntries) {
        var visible = new List<ChatContentItem>(pageItems.Length);
        foreach (var item in pageItems) {
            if (skipLinks && (item.LinkPreview is not { IsEmpty: false } || !linkEntries.ContainsKey(item.Id)))
                continue;
            visible.Add(item);
        }

        var rows = new List<(int, string, ChatContentItem[])>();
        var rowIndex = 0;
        var runStart = 0;
        while (runStart < visible.Count) {
            var groupKey = GetLocalGroup(visible[runStart].At).Key;
            var runEnd = runStart;
            while (runEnd < visible.Count && GetLocalGroup(visible[runEnd].At).Key == groupKey)
                runEnd++;

            // visible is oldest-first and BuildItems renders rows bottom-up, so the
            // short row must lead the run to land at the bottom of the group.
            var runLength = runEnd - runStart;
            var leadSize = runLength % chunkSize;
            if (leadSize == 0)
                leadSize = Math.Min(chunkSize, runLength);
            for (var p = runStart; p < runEnd;) {
                var size = Math.Min(p == runStart ? leadSize : chunkSize, runEnd - p);
                rows.Add((rowIndex++, groupKey, visible.GetRange(p, size).ToArray()));
                p += size;
            }
            runStart = runEnd;
        }
        return rows;
    }

    private static long SumVersion(IReadOnlyList<ChatContentItem> items) {
        long version = 0;
        foreach (var item in items)
            version += item.Version;
        return version;
    }

    private static VirtualListData<ContentListItem> EmptyData()
        => new([new ContentListItem { Key = "empty", IsEmptyPlaceholder = true }]) {
            HasVeryFirstItem = true,
            HasVeryLastItem = true,
        };

    private async Task<IReadOnlyDictionary<Symbol, ChatEntry>> ResolveLinkEntries(
        IReadOnlyList<ChatContentItem[]> contents,
        CancellationToken cancellationToken) {
        if (Kind != ChatContentKind.Link)
            return EmptyLinkEntries;

        var result = new Dictionary<Symbol, ChatEntry>();
        foreach (var pageItems in contents)
            foreach (var item in pageItems) {
                var entry = await Chats.GetEntry(Session, item.EntryId, cancellationToken).ConfigureAwait(false);
                if (entry is not null)
                    result[item.Id] = entry;
            }
        return result;
    }

    private async Task OnMediaClick(ChatContentItem item) {
        var entry = await Chats.GetEntry(Session, item.EntryId, CancellationToken.None).ConfigureAwait(false);
        var attachment = entry?.Attachments.FirstOrDefault(x => x.Index == item.LocalIndex);
        if (attachment is null)
            return;

        var url = UrlMapper.ContentUrl(attachment.Media.BlobId);
        await VisualMediaViewerUI.Show(url, [attachment]);
    }

    private (string Key, string Title) GetLocalGroup(Moment at) {
        var d = DateTimeConverter.ToLocalTime(at);
        return GroupBy switch {
            ContentGrouping.Day => ($"{d.Year:D4}-{d.Month:D2}-{d.Day:D2}", d.ToString("MMMM d, yyyy")),
            ContentGrouping.Month => ($"{d.Year:D4}-{d.Month:D2}", d.ToString("MMMM yyyy")),
            _ => ("", ""),
        };
    }

    private string FormatDate(Moment at) {
        var date = DateTimeConverter.ToLocalTime(at);
        var today = DateTimeConverter.ToLocalTime(Hub.Clocks.SystemClock.Now);
        return date.Year == today.Year
            ? date.ToString("d MMM, HH:mm")
            : date.ToString("d MMM yyyy, HH:mm");
    }

    private static string FileExtension(string fileName) {
        var dotIndex = fileName.LastIndexOf('.');
        return dotIndex >= 0 && dotIndex < fileName.Length - 1
            ? fileName[(dotIndex + 1)..].ToLowerInvariant()
            : "";
    }

    // Render fragments

    private RenderFragment RenderMediaTile(ChatContentItem item) {
        var url = UrlMapper.ContentUrl(item.BlobId);
        var menuRef = MenuRef.New<ChatContentItemMenu>(item.EntryId.Value).ToString();
        if (item.Kind == ChatContentKind.Video) {
            var thumb = item.ThumbnailBlobId.IsNullOrEmpty() ? "" : UrlMapper.ContentUrl(item.ThumbnailBlobId);
            return @<a class="image-attachment c-video" @key="@item.Id"
                       href="@url" role="button" data-menu="@menuRef"
                       @onclick="@(() => OnMediaClick(item))" @onclick:preventDefault="true">
                       @if (thumb.Length > 0) {
                           <image-skeleton class="show-image-skeleton" src="@thumb"/>
                       }
                       <i class="icon-play-fill c-play-icon"></i>
                   </a>;
        }
        var previewUrl = UrlMapper.ImagePreviewUrl(url, null, 320);
        return @<a class="image-attachment" @key="@item.Id"
                   href="@url" role="button" data-menu="@menuRef"
                   @onclick="@(() => OnMediaClick(item))" @onclick:preventDefault="true">
                   <image-skeleton class="show-image-skeleton" src="@url" thumbnailSrc="@previewUrl"/>
               </a>;
    }

    private RenderFragment RenderFileRow(ChatContentItem item) {
        var url = UrlMapper.ContentUrl(item.BlobId);
        var menuRef = MenuRef.New<ChatContentItemMenu>(item.EntryId.Value).ToString();
        var ext = FileExtension(item.FileName);
        var fileCls = FileTypeHelper.FileColors.GetValueOrDefault(ext, "file-default");
        var fileIcon = fileCls == FileTypeHelper.FileClasses[FileType.Multimedia] ? "icon-play-fill" : "icon-file";
        return @<a class="c-file-row" href="@url" target="_blank" rel="noopener" role="button" data-menu="@menuRef">
                   <div class="c-file-icon @fileCls">
                       <i class="@fileIcon"></i>
                   </div>
                   <div class="c-file-info">
                       <FileAttachmentTitle Title="@item.FileName"/>
                       <div class="c-file-size">@FileSizeFormatter.Format(item.Size)</div>
                       <div class="c-file-date">@FormatDate(item.At)</div>
                   </div>
               </a>;
    }

    private RenderFragment RenderLinkCard(ContentListItem listItem) {
        var item = listItem.Items[0];
        var menuRef = MenuRef.New<ChatContentItemMenu>(item.EntryId.Value).ToString();
        return @<div class="message-link-preview" data-menu="@menuRef">
                   <LinkPreviewView Entry="@listItem.LinkEntry!" LinkPreview="@item.LinkPreview!"/>
               </div>;
    }

    // Nested types

    private sealed record Block(string PeriodKey, int PageIndex, int ItemCount);
}
