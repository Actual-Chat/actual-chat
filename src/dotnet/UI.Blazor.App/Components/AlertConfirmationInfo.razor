@namespace ActualChat.UI.Blazor.App.Components

<div class="alert-text">
    @L.Alert_InfoIntro_Format(CoreConstants.AppName)
    <span class="font-bold">@L.Alert_InfoHighlight</span>
    @L.Alert_InfoDetails
    @L.Alert_InfoConsider_Prefix<span class="@TargetClass">@Target</span>@L.Alert_InfoConsider_Suffix
</div>

@code {
    [Inject] private IStringLocalizer L { get; init; } = null!;

    [Parameter] public string Target { get; set; } = "";
    [Parameter] public string TargetClass { get; set; } = "";
}
