@namespace ActualChat.UI.Blazor.App.Components

<div class="alert-text">
    @CoreConstants.AppName sends regular notifications for every message, but an
    <span class="font-bold">"Alert" is a notification similar to a phone call</span>
    — it’s louder, and the user must swipe it or open the app to stop the sound.
    If you don’t need to distract <span class="@TargetClass">@Target</span> right now, consider not sending it.
</div>

@code {
    [Parameter] public string Target { get; set; } = "";
    [Parameter] public string TargetClass { get; set; } = "";
}
