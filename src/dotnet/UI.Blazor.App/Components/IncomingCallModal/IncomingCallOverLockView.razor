@namespace ActualChat.UI.Blazor.App.Components
@using ActualChat.Live
@using ActualChat.UI.Blazor.App.Module
@using ActualLab.Diagnostics
@inherits ComputedStateComponent<AppUIHub, IncomingCallOverLockView.ComputedModel>
@{
    var m = State.Value;
    if (m.Chat is not { } chat)
        return;
}

<div class="incoming-call-overlock @(m.Phase == CallPhase.InCall ? "in-call" : "ringing")">
    <div class="c-bg">
        <ChatIcon Chat="@chat" Size="SquareSize.SizeFull"
                  IsSquare="@true" IsBlurred="@true" ShowFullSizeAvatar="@true" HideTitle="@true"/>
    </div>
    <div class="c-scrim"></div>

    @if (m.Phase == CallPhase.Ringing) {
        <div class="c-topbar c-brand">
            <i class="icon-voxt"></i>
            <span>@L.Call_AppIncomingTitle</span>
        </div>
    }
    else {
        <div class="c-topbar c-call-bar">
            <HeaderButton Class="btn-video-panel" Click="@OnGoToChatClick">
                <i class="icon-collapse text-lg"></i>
            </HeaderButton>
            <HeaderButton Class="btn-video-panel talking" Click="@OnHangUpClick">
                <i class="icon-phone-off"></i>
            </HeaderButton>
        </div>
    }

    <div class="c-body">
        <div class="c-avatar">
            <ChatIcon Chat="@chat" Size="SquareSize.Size24" HideTitle="@true"/>
        </div>
        <div class="c-name">
            @if (m is { Phase: CallPhase.InCall, IsMuted: true }) {
                <i class="icon-mic-off c-name-mic"></i>
            }
            <span class="c-name-text">@chat.Title</span>
        </div>
        <div class="c-status">@StatusText(m)</div>
        @if (m is { Phase: CallPhase.InCall, JoinedAt: { } joinedAt }) {
            <div class="c-timer"><LiveDuration StartedAt="@joinedAt"/></div>
        }
    </div>

    <div class="c-footer">
        @if (m.Phase == CallPhase.Ringing) {
            <div class="c-ring-buttons" @ref="_ringButtons">
                <div class="c-btn-cell">
                    <div class="c-hints" aria-hidden="true">
                        <svg class="c-hint-chevron" viewBox="0 0 24 14" fill="none" stroke="currentColor"
                             stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M2 11 12 3l10 8"/>
                        </svg>
                        <svg class="c-hint-chevron" viewBox="0 0 24 14" fill="none" stroke="currentColor"
                             stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M2 11 12 3l10 8"/>
                        </svg>
                        <svg class="c-hint-chevron" viewBox="0 0 24 14" fill="none" stroke="currentColor"
                             stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M2 11 12 3l10 8"/>
                        </svg>
                    </div>
                    <Button Class="c-call-btn c-decline" Click="@OnDeclineClick">
                        <i class="icon-close"></i>
                    </Button>
                    <span class="c-btn-label">@L.Common_Decline</span>
                </div>
                <div class="c-btn-cell">
                    <Button Class="c-call-btn c-mute" Click="@OnMuteClick">
                        <i class="@(m.IsMuted ? "icon-bell" : "icon-bell-off")"></i>
                    </Button>
                    <span class="c-btn-label">@L.Call_Mute</span>
                </div>
                <div class="c-btn-cell">
                    <Button Class="c-call-btn c-message" Click="@OnMessageClick">
                        <i class="icon-message-ellipse"></i>
                    </Button>
                    <span class="c-btn-label">@L.Call_Message</span>
                </div>
                <div class="c-btn-cell">
                    <div class="c-hints" aria-hidden="true">
                        <svg class="c-hint-chevron" viewBox="0 0 24 14" fill="none" stroke="currentColor"
                             stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M2 11 12 3l10 8"/>
                        </svg>
                        <svg class="c-hint-chevron" viewBox="0 0 24 14" fill="none" stroke="currentColor"
                             stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M2 11 12 3l10 8"/>
                        </svg>
                        <svg class="c-hint-chevron" viewBox="0 0 24 14" fill="none" stroke="currentColor"
                             stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M2 11 12 3l10 8"/>
                        </svg>
                    </div>
                    <Button Class="c-call-btn c-accept" Click="@OnAcceptClick">
                        <i class="icon-phone-take"></i>
                    </Button>
                    <span class="c-btn-label">@L.Common_Accept</span>
                </div>
            </div>
        }
        else {
            <div class="c-toolbar">
                @* Mobile switches the front/back camera; anywhere else (incl. a narrow desktop window)
                   keeps screen share, which is where sharing actually makes sense. *@
                @if (Hub.BrowserInfo.IsMobile) {
                    <HeaderButton Class="btn-video-panel" Click="@OnSwitchCameraClick">
                        <i class="icon-camera-switch text-lg"></i>
                    </HeaderButton>
                }
                else {
                    <HeaderButton Class="btn-video-panel" Click="@OnScreenShareClick">
                        <i class="icon-screen-share text-lg"></i>
                    </HeaderButton>
                }
                <HeaderButton Class="btn-video-panel" Click="@OnVideoClick">
                    <i class="icon-video text-lg"></i>
                </HeaderButton>
                <HeaderButton
                    Click="@(() => OnToggleRecordingClick(!m.IsRecording))"
                    IsDisabled="@m.IsDialing"
                    Class="@("btn-video-panel rec-btn " + (m.IsRecording ? "recording" : ""))">
                    @if (m.IsRecording) {
                        <active-recording-svg size="8" isRecording="true"/>
                    } else {
                        <i class="icon-recorder-left-half left"></i>
                        <i class="icon-recorder-right-half right"></i>
                    }
                </HeaderButton>
                <HeaderButton Class="btn-video-panel c-speaker">
                    <i class="icon-volume-up-2 text-lg"></i>
                </HeaderButton>
                <HeaderButton Class="btn-video-panel" Click="@OnOptionsClick">
                    <i class="icon-options-2 text-lg"></i>
                </HeaderButton>
            </div>
        }
    </div>
</div>

@code {
    private static readonly string JSCreateSwipe = $"{BlazorUIAppModule.ImportName}.IncomingCallSwipe.create";

    private bool _shownOverLock;
    private ElementReference _ringButtons;
    private DotNetObjectReference<IncomingCallOverLockView>? _dotNetRef;
    private IJSObjectReference? _swipeRef;
    private IncomingCallUI IncomingCallUI => Hub.IncomingCallUI;
    private LiveSessionUI LiveSessionUI => Hub.LiveSessionUI;
    private ChatVideoUI ChatVideoUI => Hub.ChatVideoUI;
    private ChatAudioUI ChatAudioUI => Hub.ChatAudioUI;
    private CameraUI CameraUI => Hub.CameraUI;
    private ILogger Log => field ??= Hub.LogFor(GetType());
    private ILogger? DebugLog => Log.IfEnabled(LogLevel.Information, Constants.DebugMode.AndroidIncomingCalls);

    protected override void OnAfterRender(bool firstRender) {
        // Bring the app forward over the keyguard only after the call screen is drawn. Gated on
        // IsOverLock: the foreground screen has no cover to hide or keyguard flag to set.
        var m = State.Value;
        var isShowing = m.Chat is not null && m.IsOverLock;
        if (firstRender)
            DebugLog?.LogInformation("CALL_TRACE: OverLockView first render, isShowing={IsShowing}", isShowing);
        if (isShowing && !_shownOverLock) {
            _shownOverLock = true;
            DebugLog?.LogInformation("CALL_TRACE: OverLockView became visible → OnOverLockScreenRendered");
            IncomingCallUI.OnOverLockScreenRendered();
        }
        else if (!isShowing && _shownOverLock)
            _shownOverLock = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        // Attach the swipe-to-answer controller while the ringing buttons are on screen (it no-ops on
        // non-touch, so the buttons keep their native click there), detach otherwise.
        var isRinging = State.Value is { Chat: not null, Phase: CallPhase.Ringing };
        if (isRinging && _swipeRef is null) {
            _dotNetRef ??= DotNetObjectReference.Create(this);
            _swipeRef = await Hub.JS
                .InvokeAsync<IJSObjectReference>(JSCreateSwipe, _ringButtons, _dotNetRef)
                .ConfigureAwait(true);
        }
        else if (!isRinging && _swipeRef is not null) {
            await _swipeRef.DisposeAsync().ConfigureAwait(true);
            _swipeRef = null;
        }
    }

    [JSInvokable]
    public Task SwipeAccept() => OnAcceptClick();

    [JSInvokable]
    public Task SwipeDecline() => OnDeclineClick();

    public override async ValueTask DisposeAsync() {
        if (_swipeRef is not null) {
            await _swipeRef.DisposeAsync().ConfigureAwait(true);
            _swipeRef = null;
        }
        _dotNetRef?.Dispose();
        await base.DisposeAsync().ConfigureAwait(true);
    }

    protected override ComputedState<ComputedModel>.Options GetStateOptions()
        => ComputedStateComponent.GetStateOptions(GetType(),
            static t => new ComputedState<ComputedModel>.Options() {
                InitialValue = ComputedModel.None,
                UpdateDelayer = FixedDelayer.NextTick,
                Category = GetStateCategory(t),
            });

    protected override async Task<ComputedModel> ComputeState(CancellationToken cancellationToken) {
        var overLockChatId = await IncomingCallUI.OverLockChatId.Use(cancellationToken).ConfigureAwait(false);
        var isOverLock = overLockChatId is not null;
        var chatId = overLockChatId
            ?? await IncomingCallUI.ForegroundCallChatId.Use(cancellationToken).ConfigureAwait(false);
        if (chatId is not { } id) {
            DebugLog?.LogInformation("CALL_TRACE: OverLockView.ComputeState → None (no active chat)");
            return ComputedModel.None;
        }

        var chat = await Hub.Chats.Get(Session, id, cancellationToken).ConfigureAwait(false);
        if (chat is null) {
            DebugLog?.LogInformation("CALL_TRACE: OverLockView.ComputeState #{ChatId} → None (chat not loaded)", id);
            return ComputedModel.None;
        }

        var ringing = await IncomingCallUI.GetRingingCall(id, cancellationToken).ConfigureAwait(false);
        if (ringing is not null) {
            var muted = await IncomingCallUI.MutedRingChatId.Use(cancellationToken).ConfigureAwait(false);
            DebugLog?.LogInformation("CALL_TRACE: OverLockView.ComputeState #{ChatId} → Ringing", id);
            return new() {
                Chat = chat, Phase = CallPhase.Ringing, HasVideo = ringing.HasVideo,
                IsMuted = muted == id, IsOverLock = isOverLock,
            };
        }

        var recordingChatId = await ChatAudioUI.GetRecordingChatId().ConfigureAwait(false);
        var isRecording = recordingChatId == id;

        var inCall = await LiveSessionUI.AmIInLiveConversation(id, cancellationToken).ConfigureAwait(false);
        if (inCall) {
            var joinedAt = await GetJoinedAt(id, cancellationToken).ConfigureAwait(false);
            DebugLog?.LogInformation("CALL_TRACE: OverLockView.ComputeState #{ChatId} → InCall, joinedAt={JoinedAt}",
                id, joinedAt);
            return new() {
                Chat = chat, Phase = CallPhase.InCall, JoinedAt = joinedAt,
                IsRecording = isRecording, IsOverLock = isOverLock,
            };
        }

        // My own outgoing call, still dialing (or just answered, before my audio has started): show the
        // same full-screen call view with a "Dialing..." status instead of nothing.
        var callStatus = await LiveSessionUI.GetCallStatus(id, cancellationToken).ConfigureAwait(false);
        if (callStatus is CallStatus.Dialing or CallStatus.Accepted) {
            DebugLog?.LogInformation("CALL_TRACE: OverLockView.ComputeState #{ChatId} → Outgoing ({Status})",
                id, callStatus);
            return new() {
                Chat = chat, Phase = CallPhase.InCall,
                IsDialing = callStatus == CallStatus.Dialing,
                IsRecording = isRecording, IsOverLock = isOverLock,
            };
        }

        DebugLog?.LogInformation(
            "CALL_TRACE: OverLockView.ComputeState #{ChatId} → None (ring not confirmed, not in call)", id);
        return ComputedModel.None;
    }

    private async Task<Moment?> GetJoinedAt(ChatId chatId, CancellationToken cancellationToken) {
        // The session itself can predate the call - an ambient one gets promoted - so the timer
        // counts from my own join, not from LiveSession.StartedAt.
        var live = await LiveSessionUI.Get(chatId, cancellationToken).ConfigureAwait(false);
        if (live is null)
            return null;

        var ownAuthor = await Hub.Authors.GetOwn(Session, chatId, cancellationToken).ConfigureAwait(false);
        if (ownAuthor is null)
            return null;

        var me = live.Members.FirstOrDefault(m => m.AuthorId == ownAuthor.Id);
        return me is null || me.JoinedAt == default ? null : me.JoinedAt;
    }

    private Task OnAcceptClick()
        => State.Value.Chat is { } chat ? IncomingCallUI.Accept(chat.Id) : Task.CompletedTask;

    private Task OnDeclineClick()
        => State.Value.Chat is { } chat ? IncomingCallUI.Decline(chat.Id) : Task.CompletedTask;

    private void OnMuteClick() {
        if (State.Value.Chat is { } chat)
            IncomingCallUI.ToggleMuteRing(chat.Id);
    }

    // Over the lock screen "Message" declines the ring; opening the chat still needs a keyguard dismiss,
    // so the chat only surfaces once the user unlocks.
    private Task OnMessageClick()
        => State.Value.Chat is { } chat ? IncomingCallUI.DeclineAndOpenChat(chat.Id) : Task.CompletedTask;

    private Task OnGoToChatClick() {
        var m = State.Value;
        if (m.Chat is not { } chat)
            return Task.CompletedTask;

        return m.IsOverLock ? IncomingCallUI.GoToChat(chat.Id) : IncomingCallUI.DismissForegroundCall(chat.Id);
    }

    private Task OnHangUpClick() {
        var m = State.Value;
        if (m.Chat is not { } chat)
            return Task.CompletedTask;

        if (m.IsDialing)
            return IncomingCallUI.CancelForegroundCall(chat.Id);

        return m.IsOverLock ? IncomingCallUI.HangUp(chat.Id) : IncomingCallUI.HangUpForegroundCall(chat.Id);
    }

    private void OnVideoClick() {
        if (State.Value.Chat is { } chat)
            ChatVideoUI.ToggleVideoCapture(chat.Id);
    }

    private Task OnSwitchCameraClick()
        => CameraUI.SwitchCamera();

    private void OnScreenShareClick() {
        if (State.Value.Chat is { } chat)
            ChatVideoUI.ToggleScreenCast(chat.Id);
    }

    private void OnToggleRecordingClick(bool enable) {
        if (State.Value.Chat is { } chat)
            _ = ChatAudioUI.SetRecordingChatId(enable ? chat.Id : null);
    }

    private void OnOptionsClick() {
        if (State.Value.Chat is { } chat)
            ChatVideoUI.ShowVoiceSettings(chat.Id);
    }

    private string StatusText(ComputedModel m)
        => m.Phase == CallPhase.InCall
            ? m.IsDialing ? L.Call_Dialing : L.Call_InCall
            : L.Call_IsCallingYou;

    // Nested types

    public enum CallPhase { Ringing, InCall }

    public sealed record ComputedModel {
        public static readonly ComputedModel None = new();
        public Chat? Chat { get; init; }
        public CallPhase Phase { get; init; }
        public bool HasVideo { get; init; }
        public bool IsMuted { get; init; }
        public Moment? JoinedAt { get; init; }
        // True for my own outgoing call that's still dialing (hang-up cancels it).
        public bool IsDialing { get; init; }
        public bool IsRecording { get; init; }
        // False when this is the narrow-layout foreground screen rather than the real over-lock one.
        public bool IsOverLock { get; init; }
    }
}
