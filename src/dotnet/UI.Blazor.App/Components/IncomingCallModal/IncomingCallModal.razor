@using ActualChat.Contacts
@namespace ActualChat.UI.Blazor.App.Components
@implements IModalView<IncomingCallModal.Model>
@inherits ComputedStateComponent<AppUIHub, IncomingCallModal.ComputedModel?>
@{
    var m = State.Value;
    if (m is null)
        return;

    if (m.Author is not { } author || m.Call is not { } call) {
        // The ring ended, or it was collapsed into the island / answered elsewhere — close ourselves.
        // This is a resolved close, so it must NOT re-collapse from Dispose.
        if (!_isAutoClosed) {
            _isAutoClosed = true;
            _handled = true;
            Modal.Close();
        }
        return;
    }
}

<DialogFrame
    Title="@(call.HasVideo ? L.Call_IncomingVideo : L.Call_Incoming)"
    Class="author-modal modal-sm incoming-call-modal"
    HasCloseButton="false">
    <Body>
    <IncomingCallModalHeader
        Author="author"
        IsOwn="false"
        OnCollapse="@OnCollapseClick"/>
    </Body>
    <Buttons>
        <ButtonRound Class="c-call-btn c-decline" Tooltip="@L.Common_Decline" Click="@OnDeclineClick">
            <i class="icon-close text-2xl"></i>
        </ButtonRound>
        <ButtonRound Class="c-call-btn c-mute" Click="@OnMuteClick">
            <i class="@(m.IsMuted ? "icon-bell" : "icon-bell-off") text-2xl"></i>
        </ButtonRound>
        <ButtonRound Class="c-call-btn c-message" Tooltip="@L.Call_Message" Click="@OnMessageClick">
            <i class="icon-message-ellipse text-2xl"></i>
        </ButtonRound>
        <ButtonRound Class="c-call-btn c-accept" Tooltip="@L.Common_Accept" Click="@OnAcceptClick">
            <i class="icon-phone-take text-xl"></i>
        </ButtonRound>
    </Buttons>
</DialogFrame>

@code {
    private bool _isAutoClosed;
    // True once the close was resolved by an explicit action (accept/decline/message/collapse) or the
    // ring ending. A close with this still false means the user dismissed the modal (tap outside / Esc),
    // which must collapse to the island rather than orphan the ongoing ring.
    private bool _handled;

    private IAuthors Authors => Hub.Authors;
    private IncomingCallUI IncomingCallUI => Hub.IncomingCallUI;

    private AuthorId CallerId => ModalModel.CallerId;  // Shortcut
    private ChatId ChatId => CallerId.ChatId; // Shortcut

    [CascadingParameter] public Modal Modal { get; set; } = null!;
    [Parameter] public Model ModalModel { get; set; } = null!;

    protected override async Task<ComputedModel?> ComputeState(CancellationToken cancellationToken) {
        var callerId = CallerId;
        var chatId = ChatId;

        var session = Session;
        var author = await Authors.Get(session, chatId, callerId, cancellationToken).ConfigureAwait(false);
        if (author == null)
            return ComputedModel.None;

        var call = await IncomingCallUI.GetRingingCall(chatId, cancellationToken).ConfigureAwait(false);
        if (call is null)
            return ComputedModel.None;

        // Collapsed into the island → close the modal; the island takes over.
        var collapsed = await IncomingCallUI.CollapsedChatId.Use(cancellationToken).ConfigureAwait(false);
        if (collapsed == chatId)
            return ComputedModel.None;

        var muted = await IncomingCallUI.MutedRingChatId.Use(cancellationToken).ConfigureAwait(false);
        return new() {
            Author = author,
            Call = call,
            IsMuted = muted == chatId,
        };
    }

    // A tap outside the modal (or Esc) closes it via ModalChrome without touching the ring, which would
    // leave the call ringing with no UI. Disposal is the single close hook, so unless an explicit action
    // already resolved it, treat the dismissal as "collapse to the island".
    public override async ValueTask DisposeAsync() {
        if (!_handled)
            IncomingCallUI.Collapse(ChatId);
        await base.DisposeAsync().ConfigureAwait(false);
    }

    private Task OnAcceptClick() {
        _handled = true;
        var chatId = ChatId;
        Modal.Close();
        return IncomingCallUI.Accept(chatId);
    }

    private Task OnDeclineClick() {
        _handled = true;
        var chatId = ChatId;
        Modal.Close();
        return IncomingCallUI.Decline(chatId);
    }

    private Task OnMessageClick() {
        _handled = true;
        var chatId = ChatId;
        Modal.Close();
        return IncomingCallUI.DeclineAndOpenChat(chatId);
    }

    // Collapse to the island: the modal auto-closes because ComputeState reads CollapsedChatId.
    private void OnCollapseClick() {
        _handled = true;
        IncomingCallUI.Collapse(ChatId);
    }

    private void OnMuteClick()
        => IncomingCallUI.ToggleMuteRing(ChatId);

    // Nested types

    public sealed record ComputedModel {
        public static readonly ComputedModel None = new();

        public Author? Author { get; init; }
        public IncomingCall? Call { get; init; }
        public bool IsMuted { get; init; }
    }

    public sealed record Model(AuthorId CallerId);
}
