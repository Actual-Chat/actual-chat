@namespace ActualChat.UI.Blazor.App.Components
@using ActualChat.Contacts
@inherits ComputedMenuBase<AppUIHub, ChatState?>
@{
    var m = State.Value;
    if (m == null)
        return;

    var rules = m.Chat.Rules;
    var isPeerChat = m.Chat.Id is PeerChatId;
}

<CascadingValue Value="m">
    @if (rules.CanWrite() && m.IsRecording) {
        <ChatMenuRecord/>
    }
    @if (m.IsListening) {
        <ChatMenuListen/>
    }
    @if (m.IsRecording || m.IsListening) {
        <MenuEntrySeparator />
    }

    @if (isPeerChat) {
        <ChatMenuStartAnonymous />
        <MenuEntry
            Icon="icon-edit"
            Text="Edit contact"
            Click="@(() => OnEditPeerContact(m.Contact))">
        </MenuEntry>
        <ChatMenuBlock/>
    }
    <ChatMenuPin/>
    <ChatMenuNavbarPin/>
    <ChatMenuAddMember/>
    @if (_listKind == ChatListKind.Active) {
        <ChatMenuRemoveFromActiveChats/>
    }
    @if (rules.CanLeave()) {
        <ChatMenuLeave/>
    }
</CascadingValue>

@code {
    private ChatId _chatId = null!;
    private ChatListKind _listKind;

    private ChatUI ChatUI => Hub.ChatUI;

    protected override async Task OnParametersSetAsync() {
        if (Arguments is not [ var sChatId, var sListKind ])
            throw new ArgumentOutOfRangeException(nameof(Arguments));

        _chatId = ChatId.Parse(sChatId);
        _listKind = Enum.Parse<ChatListKind>(sListKind);
        await base.OnParametersSetAsync();
    }

    protected override Task<ChatState?> ComputeState(CancellationToken cancellationToken)
        => ChatUI.GetState(_chatId, false, cancellationToken);

    private async Task OnEditPeerContact(Contact peerContact) {
        await WhenClosed;
        _ = ModalUI.Show(new PeerContactEditorModal.Model(peerContact.Id));
    }
}
