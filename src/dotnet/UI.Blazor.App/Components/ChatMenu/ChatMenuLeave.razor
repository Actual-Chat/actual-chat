@namespace ActualChat.UI.Blazor.App.Components
@inherits FusionComponentBase<AppUIHub>

<MenuEntrySeparator />
<MenuEntry
    Class="warning-item"
    Icon="icon-trash03"
    Text="@L.ChatMenu_LeaveChat"
    Click="@OnClick">
</MenuEntry>

@code {
    private ChatUI ChatUI => Hub.ChatUI;

    [CascadingParameter] public ChatState ChatState { get; set; } = null!;

    private void OnClick()
        => ChatUI.LeaveChat(ChatState.Chat);
}
