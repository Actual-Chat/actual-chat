@namespace ActualChat.UI.Blazor.App.Components
@inherits FusionComponentBase<AppUIHub>
@if (_peerUserId is null) {
    return;
}

<MenuEntry
    Icon="icon-question-mark-bubble"
    Text="Start anonymous chat"
    Click="@OnStartChatClick">
</MenuEntry>

@code {
    private UserId? _peerUserId;

    [CascadingParameter] public ChatState ChatState { get; set; } = null!;

    protected override void OnParametersSet() {
        var peerChatId = ChatState.Id as PeerChatId;
        _peerUserId = peerChatId?.AnotherUserIdOrNull(Hub.AccountUI.OwnAccount.Value.Id);
    }

    private void OnStartChatClick()
        => _ = Hub.AuthorUI.StartAnonymousPeerChat(_peerUserId!);
}
