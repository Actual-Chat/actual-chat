@using ActualChat.Contacts
@namespace ActualChat.UI.Blazor.App.Components
@inherits FusionComponentBase<AppUIHub>

<MenuEntry
    Class="warning-item"
    Icon="icon-block"
    Text="@(ChatState.Contact.IsBlocked ? "Unblock user" : "Block user")"
    Click="@OnClick">
</MenuEntry>

@code {
    [CascadingParameter] public ChatState ChatState { get; set; } = null!;

    private void OnClick() {
        var contact = ChatState.Contact;
        var command = new Contacts_SetIsBlocked(Session, contact.Id, !contact.IsBlocked);
        _ = UICommander.Run(command);
    }
}
