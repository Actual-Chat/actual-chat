@namespace ActualChat.UI.Blazor.App.Components
@inherits FusionComponentBase<AppUIHub>

<MenuEntry
    Class="warning-item"
    Icon="icon-slash-circle"
    Text="@(ChatState.Contact.IsBlocked ? "Unblock user" : "Block user")"
    Click="@OnClick">
</MenuEntry>

@code {
    [CascadingParameter] public ChatState ChatState { get; set; } = null!;

    private void OnClick() {
        var contact = ChatState.Contact;
        _ = Hub.PeerBlockUI.SetBlocked(contact.Id, !contact.IsBlocked);
    }
}
