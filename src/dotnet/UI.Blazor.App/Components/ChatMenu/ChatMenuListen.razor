@namespace ActualChat.UI.Blazor.App.Components
@inherits FusionComponentBase<AppUIHub>
@{
    var replayingClass = ChatState.IsReplaying ? "opacity-60" : "";
    var listeningClass = ChatState.IsListening ? "on" : "off";
    var cls = $"play {listeningClass} {replayingClass}";
}

@if (!ChatState.IsListening) {
    <MenuEntry
        Class="@cls"
        Icon="icon-listen"
        Text="@L.Common_Listen"
        Click="@OnClick"
        MustKeepAwake="true">
    </MenuEntry>
} else {
    <MenuEntry
        Class="@cls"
        Icon="icon-not-listen"
        Text="@L.Common_Mute"
        Click="@OnClick">
    </MenuEntry>
}

@code {
    private ChatAudioUI ChatAudioUI => Hub.ChatAudioUI;

    [CascadingParameter] public ChatState ChatState { get; set; } = null!;

    private void OnClick()
        => _ = ChatAudioUI.SetListeningState(ChatState.Id, !ChatState.IsListening);
}
