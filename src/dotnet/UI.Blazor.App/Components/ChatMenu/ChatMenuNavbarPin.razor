@namespace ActualChat.UI.Blazor.App.Components
@inherits FusionComponentBase<AppUIHub>

<MenuEntry
    Icon="@(ChatState.Info.IsPinnedToNavbar ? "icon-unpin-from-navbar" : "icon-pin-to-navbar")"
    Text="@(ChatState.Info.IsPinnedToNavbar ? "Unpin from Sidebar" : "Pin to Sidebar")"
    Click="@OnClick">
</MenuEntry>

@code {
    private NavbarUI NavbarUI => Hub.NavbarUI;

    [CascadingParameter] public ChatState ChatState { get; set; } = null!;

    private void OnClick()
        => NavbarUI.SetNavbarPinState(ChatState.Id, !ChatState.Info.IsPinnedToNavbar);
}
