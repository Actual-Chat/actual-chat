@namespace ActualChat.UI.Blazor.App.Components
@inherits FusionComponentBase<AppUIHub>

<MenuEntry
    Icon="icon-close"
    Text="@L.ChatMenu_RemoveFromActiveChats"
    Click="@OnClick">
</MenuEntry>

@code {
    private ActiveChatsUI ActiveChatsUI => Hub.ActiveChatsUI;

    [CascadingParameter] public ChatState ChatState { get; set; } = null!;

    private void OnClick() {
        var chatId = ChatState.Id;
        _ = ActiveChatsUI.RemoveActiveChat(chatId);
        // An armed chat would immediately re-enter the list, so removal also leaves PTT.
        _ = Hub.UserSettingsUI.UserWalkieTalkieSettings().Update(
            x => x.AllPttChats.Any(c => c.ChatId == chatId) ? x.WithoutPttChat(chatId) : x,
            CancellationToken.None);
    }
}
