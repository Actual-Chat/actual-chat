@namespace ActualChat.UI.Blazor.App.Components
@inherits ComputedStateComponent<AppUIHub, VisualActivity>
@{
    var activity = State.Value;
    if (!activity.CanSwitch)
        return;
}

<div class="call-map-switch">
    <button type="button"
            class="c-option @(activity.Tab == VisualActivityTab.Call ? "on" : "")"
            @onclick="@(() => OnSelect(VisualActivityTab.Call))">
        @L.Call_TabCall
    </button>
    <button type="button"
            class="c-option @(activity.Tab == VisualActivityTab.Map ? "on" : "")"
            @onclick="@(() => OnSelect(VisualActivityTab.Map))">
        @L.Call_TabMap
    </button>
</div>

@code {
    private Chat Chat => ChatContext.Chat;
    private ChatActivityUI ChatActivityUI => Hub.ChatActivityUI;

    [CascadingParameter] public ChatContext ChatContext { get; set; } = null!;

    protected override ComputedState<VisualActivity>.Options GetStateOptions()
        => ComputedStateComponent.GetStateOptions(GetType(),
            static t => new ComputedState<VisualActivity>.Options() {
                InitialValue = VisualActivity.None,
                UpdateDelayer = FixedDelayer.NextTick,
                Category = GetStateCategory(t),
            });

    protected override Task<VisualActivity> ComputeState(CancellationToken cancellationToken)
        => ChatActivityUI.Get(Chat.Id, cancellationToken);

    // Private methods

    private void OnSelect(VisualActivityTab tab)
        => ChatActivityUI.SelectTab(Chat.Id, tab);
}
