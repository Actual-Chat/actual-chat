@namespace ActualChat.UI.Blazor.App.Components
@inherits ComputedStateComponent<AppUIHub, VisualActivityPanelTabSwitch.Model>
@{
    var m = State.Value;
    if (!m.Activity.CanSwitch)
        return;
}

<div class="call-map-switch">
    <button type="button"
            class="c-option @(m.Activity.Tab == VisualActivityTab.Call ? "on" : "")"
            @onclick="@(() => OnSelect(VisualActivityTab.Call))">
        Call
    </button>
    <button type="button"
            class="c-option @(m.Activity.Tab == VisualActivityTab.Map ? "on" : "")"
            @onclick="@(() => OnSelect(VisualActivityTab.Map))">
        Map
    </button>
</div>

@code {
    private Chat Chat => ChatContext.Chat;
    private ChatActivityUI ChatActivityUI => Hub.ChatActivityUI;

    [CascadingParameter] public ChatContext ChatContext { get; set; } = null!;

    protected override ComputedState<Model>.Options GetStateOptions()
        => ComputedStateComponent.GetStateOptions(GetType(),
            static t => new ComputedState<Model>.Options() {
                InitialValue = Model.None,
                UpdateDelayer = FixedDelayer.NextTick,
                Category = GetStateCategory(t),
            });

    protected override async Task<Model> ComputeState(CancellationToken cancellationToken) {
        var activity = await ChatActivityUI.Get(Chat.Id, cancellationToken).ConfigureAwait(false);
        return new (activity);
    }

    // Private methods

    private void OnSelect(VisualActivityTab tab)
        => ChatActivityUI.SelectTab(Chat.Id, tab);

    // Nested types

    // TODO: use VisualActivity if it's only property
    public sealed record Model(VisualActivity Activity) {
        public static readonly Model None = new(VisualActivity.None);
    }
}
