@namespace ActualChat.UI.Blazor.App.Components
@using ActualChat.UI.Blazor.App.Module
@inherits ComputedStateComponent<AppUIHub, VisualActivityPanel.Model>
@{
    var m = State.Value;
    var isWatching = m.IsWatching;
    var chatContext = m.ChatContext;
    var isHidden = m.Activity.PanelMode == VisualActivityPanelMode.Hidden;
    // When hidden, the call view stays mounted regardless of the selected tab —
    // unmounting VideoPanel would tear down the streams the pill stands for.
    var showVideo = m.Activity.HasCall && (m.Activity.Tab == VisualActivityTab.Call || isHidden);
    var showMap = !isHidden && m.Activity is { HasMap: true, Tab: VisualActivityTab.Map };
    // The map half of the pill replaces LiveLocationBanner, which was incomplete-UI-only
    var showPill = isHidden && (m.Activity.HasCall || (m.Activity.HasMap && m.EnableIncompleteUI));

    // TODO(DF): move this logic to ChatVideoUI
    // Clear watching when navigating to a different chat.
    // Compare by ChatId, not ChatContext reference: ChatContext is recreated on every
    // ChatPage.ComputeState run (it uses ByRef equality), so a reference change here
    // means "the chat's data updated", not "the user switched chats".
    var chatId = chatContext?.Chat.Id;
    if (_lastWatchingChatId is { } lastChatId && chatId is { } currentChatId && lastChatId != currentChatId)
        ChatVideoUI.CloseVideoPanel();
    _lastWatchingChatId = isWatching ? chatId : null;

    // Handle show/hide transitions based on watching state and the Call/Map tab
    if (!_isRendered && showVideo) {
        _isRendered = true;
        _chatContextToRender = chatContext;
        _isClosing = false;
    } else if (_isRendered && showVideo) {
        _chatContextToRender = chatContext;
        _isClosing = false;
    } else if (_isRendered && !showVideo) {
        if (isWatching) {
            // Still on the call — switched to the Map tab; swap instantly, no closing animation
            _isRendered = false;
            _isClosing = false;
        } else
            _isClosing = true;
    }

    if (!_isRendered)
        _chatContextToRender = null;

    _isPanelRendered = _chatContextToRender is not null || ((showMap || showPill) && chatContext is not null);
}

@if (_isPanelRendered) {
    <div @ref="Ref" class="visual-activity-panel">
        @if (_chatContextToRender is not null) {
            <ErrorBarrier Name="VideoPanel" Kind="ErrorBarrierKind.Medium">
                <CascadingValue Value="_chatContextToRender">
                    <VideoPanel IsClosing="@_isClosing" OnClosed="@OnContentClosed"/>
                </CascadingValue>
            </ErrorBarrier>
        } else if (showMap) {
            <ErrorBarrier Name="MapPanel" Kind="ErrorBarrierKind.Medium">
                <CascadingValue Value="chatContext">
                    <MapPanel/>
                </CascadingValue>
            </ErrorBarrier>
        }
        @if (showPill && chatContext is not null) {
            @* The pill is positioned against the middle panel, not against this panel *@
            <RenderIntoSlot Name="@LayoutSlots.MainBodyOverlay">
                <CascadingValue Value="chatContext">
                    <ActivityPill/>
                </CascadingValue>
            </RenderIntoSlot>
        }
        @if (chatContext is not null) {
            <CascadingValue Value="chatContext">
                <VisualActivityPanelTabSwitch/>
            </CascadingValue>
        }
        @if (!_isClosing && m.Activity.PanelMode == VisualActivityPanelMode.Inline) {
            <div class="c-drag-handle"><div class="c-bar"></div></div>
        }
    </div>
}

@code {
    private static readonly string JSCreateMethod = $"{BlazorUIAppModule.ImportName}.VisualActivityPanel.create";

    private ChatId? _lastWatchingChatId;
    private ChatContext? _chatContextToRender;
    private bool _isRendered;
    private bool _isClosing;
    private bool _isPanelRendered;

    private ChatVideoUI ChatVideoUI => Hub.ChatVideoUI;
    private ChatAudioUI ChatAudioUI => Hub.ChatAudioUI;
    private ChatActivityUI ChatActivityUI => Hub.ChatActivityUI;

    private ElementReference Ref { get; set; }
    private IJSObjectReference? JSRef { get; set; }

    [CascadingParameter] public ChatContext? ChatContext { get; set; }
    [CascadingParameter] public ScreenSize ScreenSize { get; set; }

    public override async ValueTask DisposeAsync() {
        await JSRef.DisposeSilentlyAsync("dispose");
        JSRef = null;
        await base.DisposeAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (!_isPanelRendered) {
            // The panel div isn't rendered, so Ref is stale; drop the JS
            // counterpart and recreate it when the content comes back.
            await JSRef.DisposeSilentlyAsync("dispose");
            JSRef = null;
        } else
            JSRef ??= await JS.InvokeAsync<IJSObjectReference>(JSCreateMethod, Ref);
    }

    protected override ComputedState<Model>.Options GetStateOptions()
        => ComputedStateComponent.GetStateOptions(GetType(),
            t => new ComputedState<Model>.Options {
                InitialValue = Model.None,
                UpdateDelayer = FixedDelayer.NextTick,
                Category = GetStateCategory(t),
            });

    protected override async Task<Model> ComputeState(CancellationToken cancellationToken) {
        var chatContext = ChatContext;
        if (chatContext is null)
            return Model.None;

        var chatId = chatContext.Chat.Id;
        var watchingChatId = await ChatVideoUI.GetWatchingChatId(cancellationToken).ConfigureAwait(false);
        var isWatching = watchingChatId == chatId;

        // Auto-open video panel when user is listening and someone is streaming
        if (!isWatching) {
            var audioState = await ChatAudioUI.GetState(chatId).ConfigureAwait(false);
            if (audioState.IsListening || audioState.IsRecording) {
                var isAnyoneStreaming = await ChatVideoUI.IsAnyoneVideoStreaming(chatId, cancellationToken)
                    .ConfigureAwait(false);
                if (isAnyoneStreaming) {
                    ChatVideoUI.OpenVideoPanel(chatId);
                    isWatching = true;
                }
            }
        }
        var panelState = await ChatActivityUI.Get(chatId, cancellationToken).ConfigureAwait(false);
        var enableIncompleteUI = await Features.IsIncompleteUIEnabled(cancellationToken).ConfigureAwait(false);
        return new Model(chatContext, isWatching, panelState, enableIncompleteUI);
    }

    // Private methods

    private void OnContentClosed() {
        _isRendered = false;
        _isClosing = false;
        StateHasChanged();
    }

    // Nested types

    public sealed record Model(
        ChatContext? ChatContext,
        [property: MemberNotNullWhen(true, nameof(Model.ChatContext))] bool IsWatching,
        VisualActivity Activity,
        bool EnableIncompleteUI
    ) {
        public static readonly Model None = new(null, false, VisualActivity.None, false);
    }
}
