@namespace ActualChat.UI.Blazor.App.Components
@using ActualChat.UI.Blazor.App.Module
@inherits ComputedStateComponent<AppUIHub, VisualActivityPanel.Model>
@{
    var m = State.Value;
    var chatContext = m.ChatContext;
    var isHidden = m.Activity.PanelMode == VisualActivityPanelMode.Hidden;
    // The video itself is the call screen's, which is mounted outside the chat: this panel only
    // keeps the place it moves into while it is inline.
    var showVideoSlot = m.Activity is { HasCall: true, Tab: VisualActivityTab.Call };
    var showMap = !isHidden && m.Activity is { HasMap: true, Tab: VisualActivityTab.Map };
    var showPill = isHidden && (m.Activity.HasCall || m.Activity.HasMap);
    _isPanelRendered = chatContext is not null && (showVideoSlot || showMap || showPill);
}

@if (_isPanelRendered && chatContext is not null) {
    <div @ref="Ref" class="visual-activity-panel">
        @if (showVideoSlot) {
            <RenderNomadSlot Name="@LayoutSlots.CallScreen" Key="@chatContext.Chat.Id.Value"/>
        } else if (showMap) {
            <ErrorBarrier Name="MapPanel" Kind="ErrorBarrierKind.Medium">
                <CascadingValue Value="chatContext">
                    <MapPanel/>
                </CascadingValue>
            </ErrorBarrier>
        }
        @if (showPill) {
            @* The pill is positioned against the middle panel, not against this panel *@
            <RenderIntoSlot Name="@LayoutSlots.MainBodyOverlay">
                <CascadingValue Value="chatContext">
                    <ActivityPill/>
                </CascadingValue>
            </RenderIntoSlot>
        }
        <CascadingValue Value="chatContext">
            <VisualActivityPanelTabSwitch/>
        </CascadingValue>
        @if (m.Activity.PanelMode == VisualActivityPanelMode.Inline) {
            <div class="c-drag-handle" data-child="drag-handle"><div class="c-bar"></div></div>
        }
    </div>
}

@code {
    private static readonly string JSCreateMethod = $"{BlazorUIAppModule.ImportName}.VisualActivityPanel.create";

    private bool _isPanelRendered;

    private ChatActivityUI ChatActivityUI => Hub.ChatActivityUI;

    private ElementReference Ref { get; set; }
    private IJSObjectReference? JSRef { get; set; }

    [CascadingParameter] public ChatContext? ChatContext { get; set; }
    [CascadingParameter] public ScreenSize ScreenSize { get; set; }

    public override async ValueTask DisposeAsync() {
        await JSRef.DisposeSilentlyAsync("dispose");
        JSRef = null;
        await base.DisposeAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (!_isPanelRendered) {
            // The panel div isn't rendered, so Ref is stale; drop the JS
            // counterpart and recreate it when the content comes back.
            await JSRef.DisposeSilentlyAsync("dispose");
            JSRef = null;
        } else
            JSRef ??= await JS.InvokeAsync<IJSObjectReference>(JSCreateMethod, Ref);
    }

    protected override ComputedState<Model>.Options GetStateOptions()
        => ComputedStateComponent.GetStateOptions(GetType(),
            static t => new ComputedState<Model>.Options {
                InitialValue = Model.None,
                UpdateDelayer = FixedDelayer.NextTick,
                Category = GetStateCategory(t),
            });

    protected override async Task<Model> ComputeState(CancellationToken cancellationToken) {
        var chatContext = ChatContext;
        if (chatContext is null)
            return Model.None;

        // Whether the chat's video is up at all is ChatVideoUI's to decide - see its SyncWatching
        var chatId = chatContext.Chat.Id;
        var activity = await ChatActivityUI.Get(chatId, cancellationToken).ConfigureAwait(false);
        return new Model(chatContext, activity);
    }

    // Nested types

    public sealed record Model(ChatContext? ChatContext, VisualActivity Activity)
    {
        public static readonly Model None = new(null, VisualActivity.None);
    }
}
