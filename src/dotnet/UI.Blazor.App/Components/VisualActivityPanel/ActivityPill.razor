@namespace ActualChat.UI.Blazor.App.Components
@using ActualChat.UI.Blazor.App.Module
@inherits ComputedStateComponent<AppUIHub, ActivityPill.Model>
@{
    var m = State.Value;
    var hasOwnActivity = m.IsOwnCameraStreaming || m.IsOwnScreenCasting || m.IsOwnSharingLocation;
}

<div @ref="Ref" class="activity-pill" @onclick="@OnClick" @onclick:stopPropagation="true">
    <span class="c-live-dot"></span>
    <span>Live</span>
    @if (hasOwnActivity) {
        <span class="c-divider"></span>
        @if (m.IsOwnCameraStreaming) {
            <i class="icon-video"></i>
        }
        @if (m.IsOwnScreenCasting) {
            <i class="icon-screen-share"></i>
        }
        @if (m.IsOwnSharingLocation) {
            <i class="icon-marker-pin"></i>
        }
    }
</div>

@code {
    private static readonly string JSCreateMethod = $"{BlazorUIAppModule.ImportName}.ActivityPill.create";

    private Chat Chat => ChatContext.Chat;
    private ChatActivityUI ChatActivityUI => Hub.ChatActivityUI;
    private ChatVideoUI ChatVideoUI => Hub.ChatVideoUI;
    private LocationUI LocationUI => Hub.LocationUI;

    private ElementReference Ref { get; set; }
    private IJSObjectReference? JSRef { get; set; }

    [CascadingParameter] public ChatContext ChatContext { get; set; } = null!;

    public override async ValueTask DisposeAsync() {
        await JSRef.DisposeSilentlyAsync("dispose");
        JSRef = null!;
        await base.DisposeAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (firstRender)
            JSRef = await JS.InvokeAsync<IJSObjectReference>(JSCreateMethod, Ref);
    }

    protected override ComputedState<Model>.Options GetStateOptions()
        => ComputedStateComponent.GetStateOptions(GetType(),
            static t => new ComputedState<Model>.Options {
                InitialValue = Model.None,
                UpdateDelayer = FixedDelayer.NextTick,
                Category = GetStateCategory(t),
            });

    protected override async Task<Model> ComputeState(CancellationToken cancellationToken) {
        var chatId = Chat.Id;
        var activity = await ChatActivityUI.Get(chatId, cancellationToken).ConfigureAwait(false);
        var isOwnCameraStreaming = await ChatVideoUI.IsOwnCameraRecording(chatId, cancellationToken)
            .ConfigureAwait(false);
        var isOwnScreenCasting = await ChatVideoUI.IsOwnScreenCasting(chatId, cancellationToken)
            .ConfigureAwait(false);
        var isOwnSharingLocation =
            await LocationUI.GetOwnLive(chatId, cancellationToken).ConfigureAwait(false) is not null;
        return new Model(activity.HasCall, isOwnCameraStreaming, isOwnScreenCasting, isOwnSharingLocation);
    }

    // Private methods

    private void OnClick() {
        // The call view wins when both activities are on — same choice the old in-panel pill made.
        ChatActivityUI.TogglePanelMode(Chat.Id, VisualActivityPanelMode.Hidden, false);
        ChatActivityUI.SelectTab(Chat.Id, State.Value.HasCall ? VisualActivityTab.Call : VisualActivityTab.Map);
    }

    // Nested types

    public sealed record Model(
        bool HasCall,
        bool IsOwnCameraStreaming,
        bool IsOwnScreenCasting,
        bool IsOwnSharingLocation
    ) {
        public static readonly Model None = new(false, false, false, false);
    }
}
