@namespace ActualChat.UI.Blazor.App.Components
@inherits ComputedStateComponent<AppUIHub, MapPanel.Model?>
@{
    var m = State.Value;
    if (m is null)
        return;
}

<div class="map-panel-host">
    <div class="map-panel">
        <MapView
            @ref="_mapView"
            Class="c-map"
            Markers="@m.Markers"
            Center="@m.Center"/>
        <HeaderButton Class="btn-video-panel c-expand" Click="@OnExpandClick">
            <i class="icon-expand text-lg"></i>
        </HeaderButton>
        @if (!m.DistanceText.IsNullOrEmpty()) {
            <div class="c-distance">@m.DistanceText away</div>
        }
        <HeaderButton Class="btn-video-panel c-menu-btn" Click="@OnOpenMenu">
            <i class="icon-more-vertical text-lg"></i>
        </HeaderButton>
        @if (m.Countdown is { } countdown) {
            <RoundProgress Class="c-countdown" Radius="14.5" Fraction="@countdown.Fraction">
                @if (countdown.IsUnlimited) {
                    <i class="icon-infinity"></i>
                } else {
                    <span>@countdown.Text</span>
                }
            </RoundProgress>
        }
        @if (m.IsOwnSharing) {
            <ButtonRound Class="btn-stop-sharing" Click="@OnStopSharing"
                         Tooltip="Stop sharing" TooltipPosition="FloatingPosition.Top">
                <marker-pin-off-svg></marker-pin-off-svg>
            </ButtonRound>
        } else {
            <Button Class="btn-share-location" Click="@OnShare">Share your location</Button>
        }
    </div>
    @* Outside .map-panel — its overflow-hidden would clip the menu at the panel's bottom edge *@
    @if (m.IsMenuOpen) {
        <div class="c-menu-backdrop" @onclick="@OnCloseMenu"></div>
        <div class="c-menu">
            <button type="button" class="c-menu-item" @onclick="@OnLocate">
                <i class="icon-navigation-pointer"></i>
                <span>Locate me</span>
            </button>
            <button type="button" class="c-menu-item" @onclick="@OnHide">
                <i class="icon-eye-off"></i>
                <span>Hide</span>
            </button>
        </div>
    }
</div>

@code {
    private MutableState<bool> _isMenuOpen = null!;
    private MapView? _mapView;

    private Chat Chat => ChatContext.Chat;
    private LocationUI LocationUI => Hub.LocationUI;
    private ChatActivityUI ChatActivityUI => Hub.ChatActivityUI;

    [CascadingParameter] public ChatContext ChatContext { get; set; } = null!;

    protected override void OnInitialized()
        => _isMenuOpen = StateFactory.NewMutable(
            false,
            StateCategories.Get(GetType(), nameof(_isMenuOpen)));

    protected override ComputedState<Model?>.Options GetStateOptions()
        => ComputedStateComponent.GetStateOptions(GetType(),
            static t => new ComputedState<Model?>.Options() {
                InitialValue = null,
                UpdateDelayer = FixedDelayer.NextTick,
                Category = GetStateCategory(t),
            });

    protected override async Task<Model?> ComputeState(CancellationToken cancellationToken) {
        var chatId = Chat.Id;
        var participants = await LocationUI.ListParticipants(chatId, cancellationToken).ConfigureAwait(false);
        if (participants.Count == 0)
            return null;

        var isMenuOpen = await _isMenuOpen.Use(cancellationToken).ConfigureAwait(false);
        var ownMarker = await LocationUI.GetOwnMarker(chatId, cancellationToken).ConfigureAwait(false);
        var markers = participants
            .Where(p => !(ownMarker is not null && p.IsOwn))
            .Select(p => p.MapMarker)
            .ToList();
        if (ownMarker is not null)
            markers.Add(ownMarker);

        var ownLive = await LocationUI.GetOwnLive(chatId, cancellationToken).ConfigureAwait(false);
        var countdown = ownLive is null
            ? null
            : await LocationUI.GetCountdown(chatId, ownLive.Id, cancellationToken).ConfigureAwait(false);
        var center = ownLive?.Point ?? participants[0].Location.Point;

        // The "1.2 km away" chip makes sense only for a single remote sharer
        var remoteSharers = participants.Where(p => !p.IsOwn).ToList();
        var ownPoint = await LocationUI.GetOwnCurrentOrSharedLocation(chatId, cancellationToken).ConfigureAwait(false);
        var distanceText = remoteSharers.Count == 1 && ownPoint is { } point
            ? point.DistanceTextTo(remoteSharers[0].Location.Point)
            : "";
        return new Model(markers, center, countdown, ownLive is not null, distanceText, isMenuOpen);
    }

    // Private methods

    private Task OnExpandClick()
        => ModalUI.Show(new LocationMapModal.Model(Chat.Id));

    private Task OnStopSharing()
        => LocationUI.StopSharing(Chat.Id, CancellationToken.None);

    private Task OnShare()
        => LocationUI.ShowShareModal(Chat.Id);

    private void OnOpenMenu()
        => _isMenuOpen.Value = true;

    private void OnCloseMenu()
        => _isMenuOpen.Value = false;

    private void OnHide() {
        _isMenuOpen.Value = false;
        // The panel collapses to the ActivityPill (same as the video ⋮ menu's Hide).
        ChatActivityUI.SetPanelMode(Chat.Id, VisualActivityPanelMode.Hidden);
    }

    private async Task OnLocate() {
        _isMenuOpen.Value = false;
        // TODO: show ui loading state while locating cause it might take a while
        var location = await LocationUI.RefreshCurrentLocation(Hub.StopToken).ConfigureAwait(true);
        if (location is { } point && _mapView is { } mapView)
            await mapView.FlyTo(point).ConfigureAwait(false);
    }

    // Nested types

    public sealed record Model(
        IReadOnlyList<MapMarker> Markers,
        GeoPoint Center,
        LocationCountdown? Countdown,
        bool IsOwnSharing,
        string DistanceText = "",
        bool IsMenuOpen = false);
}
