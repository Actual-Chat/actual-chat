@namespace ActualChat.UI.Blazor.App.Components
@inherits ComputedStateComponent<AppUIHub, ShareLocationModal.ComputedModel>
@implements IModalView<ShareLocationModal.Model>
@{
    var m = State.Value;
}

<DialogFrame
    Class="share-location-modal modal-sm"
    HasHeader="false">
    <Body>
        <div class="c-map-area">
            @if (m.OwnMarker is not null) {
                <MapView
                    @ref="_mapView"
                    Class="c-map"
                    Center="@m.OwnMarker.Point"
                    Zoom="15"
                    StyleName="@m.MapStyleName"
                    Markers="@([m.OwnMarker])"/>
            }
            <ButtonRound Class="c-close" Click="@OnClose">
                <i class="icon-close"></i>
            </ButtonRound>
            <div class="c-map-menu">
                <button type="button" class="c-map-menu-item" @onclick="@OnSwitchMapStyle">
                    <i class="icon-map"></i>
                </button>
                <button type="button" class="c-map-menu-item" @onclick="@OnLocate">
                    <i class="icon-navigation-pointer"></i>
                </button>
            </div>
            <ButtonRound Class="c-search">
                <i class="icon-search"></i>
            </ButtonRound>
        </div>
        <div class="c-actions">
            <ButtonTile Class="c-send-current" Click="@OnSendCurrent">
                <Icon><i class="icon-marker-pin"></i></Icon>
                <Content>
                    <div class="c-text">Send my current location</div>
                    <div class="c-caption">Accurate to 10m</div>
                </Content>
            </ButtonTile>
            <ButtonTile Class="c-share-live" Click="@OnShareLive">
                <Icon><i class="icon-marker-pin-live"></i></Icon>
                <Content>
                    <div class="c-text">Share my location for…</div>
                    <div class="c-caption">Updated in real time as you move</div>
                </Content>
            </ButtonTile>
        </div>
        @if (m.IsDurationMenuOpen) {
            <div class="c-duration-backdrop" @onclick="@OnCloseDurationMenu"></div>
            <div class="c-duration-menu">
                @foreach (var (duration, label) in Constants.Location.Durations) {
                    <button type="button" class="c-duration-item" @onclick="@(() => OnPickDuration(duration))">
                        <i class="icon-clock"></i>
                        <span>for @label</span>
                    </button>
                }
                <button type="button"
                        class="c-duration-item"
                        @onclick="@(() => OnPickDuration(Constants.Location.UnlimitedDuration))">
                    <i class="icon-clock"></i>
                    <span>Until I turn it off</span>
                </button>
            </div>
        }
    </Body>
</DialogFrame>

@code {
    // "" = the current theme's default style
    private static readonly string[] MapStyles = ["", "bright", "positron", "fiord", "dark"];

    private MutableState<GeoPoint?> _currentLocation = null!;
    private MutableState<int> _mapStyleIndex = null!;
    private MutableState<bool> _isDurationMenuOpen = null!;
    private MapView? _mapView;

    private ILocationTracker Tracker => Hub.LocationTracker;

    [CascadingParameter] public Modal Modal { get; set; } = null!;
    [Parameter] public Model ModalModel { get; set; } = null!;

    protected override void OnInitialized() {
        _currentLocation = StateFactory.NewMutable(
            (GeoPoint?)null,
            StateCategories.Get(GetType(), nameof(_currentLocation)));
        _mapStyleIndex = StateFactory.NewMutable(
            0,
            StateCategories.Get(GetType(), nameof(_mapStyleIndex)));
        _isDurationMenuOpen = StateFactory.NewMutable(
            false,
            StateCategories.Get(GetType(), nameof(_isDurationMenuOpen)));
        _ = FetchCurrentLocation();
    }

    protected override ComputedState<ComputedModel>.Options GetStateOptions()
        => ComputedStateComponent.GetStateOptions(GetType(),
            static t => new ComputedState<ComputedModel>.Options() {
                InitialValue = ComputedModel.None,
                UpdateDelayer = FixedDelayer.NextTick,
                Category = GetStateCategory(t),
            });

    protected override async Task<ComputedModel> ComputeState(CancellationToken cancellationToken) {
        var livePoint = await Tracker.LastKnown.Use(cancellationToken).ConfigureAwait(false);
        var currentPoint = await _currentLocation.Use(cancellationToken).ConfigureAwait(false);
        var mapStyleIndex = await _mapStyleIndex.Use(cancellationToken).ConfigureAwait(false);
        var isDurationMenuOpen = await _isDurationMenuOpen.Use(cancellationToken).ConfigureAwait(false);
        var ownPoint = livePoint ?? currentPoint;
        var ownMarker = ownPoint is not null
            ? new MapMarker("own-location", ownPoint, IsOwnLocation: true)
            : null;
        return new ComputedModel(ownMarker, MapStyles[mapStyleIndex], isDurationMenuOpen);
    }

    // Private methods

    private async Task FetchCurrentLocation() {
        if (await Tracker.Get(default).ConfigureAwait(false) is { } point)
            _currentLocation.Value = point;
    }

    private void OnClose()
        => Modal.Close();

    private void OnSendCurrent() {
        ModalModel.SendCurrentRequested = true;
        Modal.Close();
    }

    private void OnShareLive()
        => _isDurationMenuOpen.Value = true;

    private void OnCloseDurationMenu()
        => _isDurationMenuOpen.Value = false;

    private void OnPickDuration(TimeSpan duration) {
        ModalModel.SelectedDuration = duration;
        Modal.Close();
    }

    private void OnSwitchMapStyle()
        => _mapStyleIndex.Value = (_mapStyleIndex.Value + 1) % MapStyles.Length;

    private async Task OnLocate() {
        if (await Tracker.Get(CancellationToken.None).ConfigureAwait(true) is not { } point)
            return;

        _currentLocation.Value = point;
        if (_mapView is { } mapView)
            await mapView.FlyTo(point).ConfigureAwait(false);
    }

    // Nested types

    public sealed record ComputedModel(
        MapMarker? OwnMarker,
        string MapStyleName = "",
        bool IsDurationMenuOpen = false
    ) {
        public static readonly ComputedModel None = new((MapMarker?)null);
    }

    public sealed class Model {
        public bool IsSharing { get; init; }
        public bool SendCurrentRequested { get; set; }
        public TimeSpan? SelectedDuration { get; set; }
        public bool StopRequested { get; set; }
    }
}
