@namespace ActualChat.UI.Blazor.Components
@inherits ComputedStateComponent<AppUIHub, VideoPanelContainer.Model>
@{
    var m = State.Value;
    var isWatching = m.IsWatching;
    var chatContext = m.ChatContext;
    var showVideo = m.PanelState is { HasCall: true, Tab: CallMapPanelTab.Call };
    var showMap = m.PanelState is { HasMap: true, Tab: CallMapPanelTab.Map };

    // TODO(DF): move this logic to ChatVideoUI
    // Clear watching when navigating to a different chat.
    // Compare by ChatId, not ChatContext reference: ChatContext is recreated on every
    // ChatPage.ComputeState run (it uses ByRef equality), so a reference change here
    // means "the chat's data updated", not "the user switched chats".
    var chatId = chatContext?.Chat.Id;
    if (_lastWatchingChatId is { } lastChatId && chatId is { } currentChatId && lastChatId != currentChatId)
        ChatVideoUI.CloseVideoPanel();
    _lastWatchingChatId = isWatching ? chatId : null;

    // Handle show/hide transitions based on watching state and the Call/Map tab
    if (!_isRendered && showVideo) {
        _isRendered = true;
        _chatContextToRender = chatContext;
        _isClosing = false;
    } else if (_isRendered && showVideo) {
        _chatContextToRender = chatContext;
        _isClosing = false;
    } else if (_isRendered && !showVideo) {
        if (isWatching) {
            // Still on the call — switched to the Map tab or hid the panel; swap instantly, no closing animation
            _isRendered = false;
            _isClosing = false;
        } else
            _isClosing = true;
    }

    if (!_isRendered)
        _chatContextToRender = null;
}

@if (_chatContextToRender is not null || (showMap && chatContext is not null)) {
    <div class="call-map-panel">
        @if (_chatContextToRender is not null) {
            <ErrorBarrier Name="VideoPanel" Kind="ErrorBarrierKind.Medium">
                <CascadingValue Value="_chatContextToRender">
                    <VideoPanelContent IsClosing="@_isClosing" OnClosed="@OnContentClosed"/>
                </CascadingValue>
            </ErrorBarrier>
        } else if (showMap) {
            <ErrorBarrier Name="MapPanel" Kind="ErrorBarrierKind.Medium">
                <CascadingValue Value="chatContext">
                    <MapPanelContent/>
                </CascadingValue>
            </ErrorBarrier>
        }
        @if (chatContext is not null) {
            <CascadingValue Value="chatContext">
                <CallMapSwitch/>
            </CascadingValue>
        }
    </div>
}

@code {
    private ChatId? _lastWatchingChatId;
    private ChatContext? _chatContextToRender;
    private bool _isRendered;
    private bool _isClosing;

    private ChatVideoUI ChatVideoUI => Hub.ChatVideoUI;
    private ChatAudioUI ChatAudioUI => Hub.ChatAudioUI;
    private ChatActivityUI ChatActivityUI => Hub.ChatActivityUI;

    [CascadingParameter] public ChatContext? ChatContext { get; set; }
    [CascadingParameter] public ScreenSize ScreenSize { get; set; }

    protected override ComputedState<Model>.Options GetStateOptions()
        => ComputedStateComponent.GetStateOptions(GetType(),
            t => new ComputedState<Model>.Options {
                InitialValue = Model.None,
                UpdateDelayer = FixedDelayer.NextTick,
                Category = GetStateCategory(t),
            });

    protected override async Task<Model> ComputeState(CancellationToken cancellationToken) {
        var chatContext = ChatContext;
        if (chatContext is null)
            return Model.None;

        var chatId = chatContext.Chat.Id;
        var watchingChatId = await ChatVideoUI.GetWatchingChatId(cancellationToken).ConfigureAwait(false);
        var isWatching = watchingChatId == chatId;

        // Auto-open video panel when user is listening and someone is streaming
        if (!isWatching) {
            var audioState = await ChatAudioUI.GetState(chatId).ConfigureAwait(false);
            if (audioState.IsListening || audioState.IsRecording) {
                var isAnyoneStreaming = await ChatVideoUI.IsAnyoneVideoStreaming(chatId, cancellationToken)
                    .ConfigureAwait(false);
                if (isAnyoneStreaming) {
                    ChatVideoUI.OpenVideoPanel(chatId);
                    isWatching = true;
                }
            }
        }
        var panelState = await ChatActivityUI.GetPanelState(chatId, cancellationToken).ConfigureAwait(false);
        return new Model(chatContext, isWatching, panelState);
    }

    private void OnContentClosed() {
        _isRendered = false;
        _isClosing = false;
        StateHasChanged();
    }

    // Nested types

    public sealed record Model(
        ChatContext? ChatContext,
        [property: MemberNotNullWhen(true, nameof(Model.ChatContext))] bool IsWatching,
        CallMapPanelState PanelState
    ) {
        public static readonly Model None = new(null, false, CallMapPanelState.None);
    }
}
