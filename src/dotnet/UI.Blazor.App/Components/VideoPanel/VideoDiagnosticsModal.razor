@namespace ActualChat.UI.Blazor.App.Components.VideoPanel
@using ActualChat.Media
@using ActualChat.Streaming
@using ActualChat.UI.Blazor.App.Module
@using ActualChat.UI.Blazor.App.Services
@using System.Text.Json
@inherits ComputedStateComponent<AppUIHub, VideoDiagnosticsModal.ComputedModel>
@implements IModalView<VideoDiagnosticsModal.Model>
@{
    var m = State.Value;
    var own = _ownDiag;
    var playbackSnap = Hub.VideoQualityUI.PlaybackSnapshot;
    var playbackOverride = Hub.VideoQualityUI.PlaybackOverride;
    var recordingSnap = m.OwnStreamingKind is { } ownKind
        ? Hub.VideoQualityUI.GetRecordingSnapshot(ownKind)
        : null;
}

<DialogFrame
    Class="video-diagnostics-modal"
    Title="Video Diagnostics"
    NarrowViewSettings="@DialogFrameNarrowViewSettings.Default"
    HasCloseButton="true">
    <Buttons>
        @if (m.IsAdmin) {
            <Button Class="btn-modal" Click="@OnSettingsClick">Settings</Button>
        }
        <Button Class="btn-modal" Click="@OnCopyClick">Copy</Button>
    </Buttons>
    <Body>
        @* Own streaming *@
        <div class="diag-section">
            @{
                var isStreaming = m.OwnStreamingKind is {};
                var onClickHandler = isStreaming ? OnToggleOwnStreamingDetails : (Action)(() => { });
            }
            <div class="diag-section-header @(isStreaming ? "diag-clickable" : "")" @onclick="@onClickHandler">
                Own Streaming
                @if (isStreaming) {
                    <span class="diag-expand-indicator">@GetShowDetailsIndicator(_showOwnStreamingDetails)</span>
                }
            </div>
            @if (m.OwnStreamingKind is { } kind) {
                <div class="diag-row">
                    <span class="diag-label">Kind</span>
                    <span class="diag-value">@kind</span>
                </div>
            } else {
                <div class="diag-row">
                    <span class="diag-label">Status</span>
                    <span class="diag-value diag-dim">Not streaming</span>
                </div>
            }
            @if (own is not null && own.Value.TryGetProperty("stream", out var stream) && stream.ValueKind == JsonValueKind.Object) {
                <div class="diag-js-details">
                    @* Source *@
                    <div class="diag-group-header">Source</div>
                    <div class="diag-row">
                        <span class="diag-label">Status</span>
                        <span class="diag-value">@GetStr(stream, "status")</span>
                    </div>
                    @if (GetStr(stream, "cameraLabel") is { Length: > 0 } cameraLabel) {
                        <div class="diag-row">
                            <span class="diag-label">Camera</span>
                            <span class="diag-value multiline">@cameraLabel</span>
                        </div>
                    }
                    <div class="diag-row">
                        <span class="diag-label">Input</span>
                        <span class="diag-value">@GetStr(stream, "inputResolution") @@ @(GetNum(stream, "inputFramerate").ToString("0"))fps</span>
                    </div>
                    <div class="diag-row">
                        <span class="diag-label">Duration</span>
                        <span class="diag-value">@(GetNum(stream, "duration").ToString("0"))s</span>
                    </div>

                    @* Encoder *@
                    <div class="diag-group-header">Encoder</div>
                    <div class="diag-row">
                        <span class="diag-label">Codec</span>
                        <span class="diag-value">@GetStr(stream, "codec") (@GetStr(stream, "codecCategory"), @(GetBool(stream, "hardwareAccelerated") ? "HW" : "SW"))</span>
                    </div>
                    @if (GetBool(stream, "blurEnabled")) {
                        <div class="diag-row">
                            <span class="diag-label">Blur</span>
                            <span class="diag-value">@GetStr(stream, "segmentationBackend") (@(GetNum(stream, "segmentationAvgTime").ToString("0.0"))ms)</span>
                        </div>
                    }
                    <div class="diag-row">
                        <span class="diag-label">Available</span>
                        <span class="diag-value">@GetStrArray(stream, "supportedEncoderCategories")</span>
                    </div>

                    @* Selected spatial layer *@
                    @{
                        var spatialLayers = GetArray(stream, "spatialLayers")
                            .OrderBy(GetSpatialLayerId)
                            .ToArray();
                        var selectedLayer = SelectOwnSpatialLayer(spatialLayers);
                    }
                    @if (selectedLayer is { } layer) {
                        var layerId = GetSpatialLayerId(layer);
                        var layerState = GetStr(layer, "encoderState");
                        var isLayerDead = layerState is "closed" or "unconfigured";
                        <div class="diag-group-header">Layer</div>
                        <div class="diag-row">
                            <span class="diag-label">Layer</span>
                            <span class="diag-value diag-layer-picker">
                                @foreach (var l in spatialLayers) {
                                    var id = GetSpatialLayerId(l);
                                    <button type="button" class="diag-layer-link @(id == layerId ? "active" : "")" @onclick="() => OnSelectOwnSpatialLayer(id)">L@(id)</button>
                                }
                            </span>
                        </div>
                        <div class="diag-row">
                            <span class="diag-label">Output</span>
                            <span class="diag-value">@GetStr(layer, "outputResolution")</span>
                        </div>
                        <div class="diag-row">
                            <span class="diag-label">Bitrate</span>
                            <span class="diag-value">@(GetNum(layer, "actualBitrateKbps").ToString("0")) kbps (cfg: @((GetNum(layer, "configuredBitrate") / 1000).ToString("0")) kbps)</span>
                        </div>
                        <div class="diag-row">
                            <span class="diag-label">Encode time</span>
                            <span class="diag-value">@(GetNum(layer, "medianEncodeTime").ToString("0.0"))ms (pure: @(GetNum(layer, "pureMedianEncodeTime").ToString("0.0"))ms)</span>
                        </div>
                        <div class="diag-row">
                            <span class="diag-label">HW accel</span>
                            <span class="diag-value">@GetStr(layer, "encoderHwAccel")</span>
                        </div>
                        <div class="diag-row">
                            <span class="diag-label">Frames</span>
                            <span class="diag-value">@(GetNum(layer, "encodedFrames").ToString("0")) enc, @(GetNum(layer, "droppedFrames").ToString("0")) drop, @(GetNum(layer, "keyFrames").ToString("0")) key</span>
                        </div>
                        <div class="diag-row">
                            <span class="diag-label">State</span>
                            <span class="diag-value @(isLayerDead ? "diag-error" : "")">@layerState</span>
                        </div>
                        <div class="diag-row">
                            <span class="diag-label">Lifecycle</span>
                            <span class="diag-value">@(GetNum(layer, "encoderReconfigureCount").ToString("0")) reconfigure, @(GetNum(layer, "encoderReplaceCount").ToString("0")) replace</span>
                        </div>
                        @if (GetStr(layer, "encoderLastReconfigureSummary") is { Length: > 0 } reconfSummary) {
                            <div class="diag-row">
                                <span class="diag-label">Last reconfig</span>
                                <span class="diag-value multiline">@reconfSummary @(GetNum(layer, "encoderLastReconfigureAgeMs") >= 0 ? $"({GetNum(layer, "encoderLastReconfigureAgeMs"):0}ms ago)" : "")</span>
                            </div>
                        }
                        @if (GetNum(layer, "encoderErrorCount") > 0) {
                            <div class="diag-row">
                                <span class="diag-label">Encoder error</span>
                                <div class="diag-value multiline">
                                    <span class="diag-error">@GetStr(layer, "encoderLastErrorName"): @GetStr(layer, "encoderLastErrorMessage")</span>
                                    <span class="diag-dim">(@(GetNum(layer, "encoderErrorCount").ToString("0")) total@(GetNum(layer, "encoderLastErrorAgeMs") >= 0 ? $", {GetNum(layer, "encoderLastErrorAgeMs"):0}ms ago" : ""))</span>
                                </div>
                            </div>
                        }
                    }

                    @* Orientation *@
                    @if (stream.TryGetProperty("orientation", out var orient) && orient.ValueKind == JsonValueKind.Object) {
                        <div class="diag-group-header">Orientation</div>
                        <div class="diag-row">
                            <span class="diag-label">Display</span>
                            <span class="diag-value">@GetStr(orient, "firstDisplayResolution")</span>
                        </div>
                        <div class="diag-row">
                            <span class="diag-label">Coded</span>
                            <span class="diag-value">@GetStr(orient, "firstCodedResolution")</span>
                        </div>
                        <div class="diag-row">
                            <span class="diag-label">Config</span>
                            <span class="diag-value">@GetStr(orient, "configuredResolution")</span>
                        </div>
                        <div class="diag-row">
                            <span class="diag-label">Rotation</span>
                            <span class="diag-value">@GetStr(orient, "firstRotation") → @GetStr(orient, "lastRotation")</span>
                        </div>
                        <div class="diag-row">
                            <span class="diag-label">Detection</span>
                            <span class="diag-value">@GetStr(orient, "rotationDetection") (@(GetBool(orient, "needsRotation") ? "rot: yes" : "rot: no"))</span>
                        </div>
                        <div class="diag-row">
                            <span class="diag-label">Frames seen</span>
                            <span class="diag-value">@(GetNum(orient, "framesSeen").ToString("0"))</span>
                        </div>
                    }

                    @* Streaming *@
                    @if (stream.TryGetProperty("streaming", out var streaming) && streaming.ValueKind == JsonValueKind.Object) {
                        <div class="diag-group-header">Streaming</div>
                        <div class="diag-row">
                            <span class="diag-label">Send</span>
                            <div class="diag-value multiline">
                                <span class="diag-value">@GetStr(streaming, "status") (@(GetNum(streaming, "sentFrames").ToString("0")) frames)</span>
                            </div>
                        </div>
                        @if (GetNum(streaming, "pendingFrames") > 0) {
                            <div class="diag-row">
                                <span class="diag-label">Pending</span>
                                <span class="diag-value">@(GetNum(streaming, "pendingFrames").ToString("0")) frames</span>
                            </div>
                        }
                        @if (GetNum(streaming, "streamRecreations") > 1) {
                            <div class="diag-row">
                                <span class="diag-label">Reconnects</span>
                                <span class="diag-value">@((GetNum(streaming, "streamRecreations") - 1).ToString("0"))</span>
                            </div>
                        }
                        @if (GetStr(streaming, "lastError") is { Length: > 0 } streamError) {
                            <div class="diag-row">
                                <span class="diag-label">Last Error</span>
                                <div class="diag-value multiline">
                                    <span class="diag-error">@streamError</span>
                                </div>
                            </div>
                        }
                    }

                    @* Quality control *@
                    @if (recordingSnap is { } outboundQc) {
                        <div class="diag-group-header">Quality Control (outbound)</div>
                        <div class="diag-row">
                            <span class="diag-label">Target</span>
                            <span class="diag-value">@FormatRecordingQualityState(outboundQc)</span>
                        </div>
                        <div class="diag-row">
                            <span class="diag-label">Verdict</span>
                            <span class="diag-value">@SignalText(outboundQc.Signal)</span>
                        </div>
                        @if (ShouldShowRecordingAction(outboundQc.Reason)) {
                            <div class="diag-row">
                                <span class="diag-label">Action</span>
                                <span class="diag-value">@outboundQc.Reason</span>
                            </div>
                        }
                        <div class="diag-row">
                            <span class="diag-label">Layer cap</span>
                            <span class="diag-value">@FormatLayerCap(outboundQc.DebugMaxLayerCount)</span>
                        </div>
                        @if (outboundQc.Health is { } health) {
                            <div class="diag-row">
                                <span class="diag-label">Encode cost</span>
                                <span class="diag-value">@FormatRecordingEncodeCostSignal(health)</span>
                            </div>
                            <div class="diag-row">
                                <span class="diag-label">Frame slots</span>
                                <span class="diag-value">@FormatRecordingSlotSignal(health)</span>
                            </div>
                            <div class="diag-row">
                                <span class="diag-label">Sender</span>
                                <span class="diag-value multiline">@FormatRecordingSenderSignal(health)</span>
                            </div>
                        }
                        else {
                            <div class="diag-row">
                                <span class="diag-label">Signals</span>
                                <span class="diag-value diag-dim">no health sample yet</span>
                            </div>
                        }
                    }
                </div>
            }
        </div>

        @* Active streams *@
        <div class="diag-section">
            <div class="diag-section-header">
                Active Streams
                <span class="diag-badge">@m.Streams.Length</span>
                @if (m.MemberCount > 0) {
                    <span class="diag-dim ml-2">(@m.MemberCount members)</span>
                }
            </div>
            @if (m.Streams.Length == 0) {
                <div class="diag-row">
                    <span class="diag-dim">No active streams</span>
                </div>
            } else {
                @foreach (var s in m.Streams) {
                    var sid = s.Info.StreamId.Value;
                    var isExpanded = !s.IsOwn && _expandedStreams.Contains(sid);
                    <div class="diag-stream">
                        @if (s.IsOwn) {
                            <div class="diag-stream-header">
                                <span>@s.Info.StreamId</span>
                                <span class="diag-stream-kind ml-auto">Own</span>
                            </div>
                        } else {
                            <div class="diag-stream-header diag-clickable" @onclick="() => OnToggleStreamDetails(sid)">
                                <span>@s.Info.StreamId</span>
                                <span class="diag-expand-indicator">@GetShowDetailsIndicator(isExpanded)</span>
                            </div>
                        }
                        <div class="diag-row">
                            <span class="diag-label">Kind</span>
                            <span class="diag-value">@s.Info.StreamKind</span>
                        </div>
                        <div class="diag-row">
                            <span class="diag-label">Started</span>
                            <span class="diag-value">@DateTimeConverter.ToLocalTime(s.Info.StartedAt).ToString("HH:mm:ss")</span>
                        </div>
                        <div class="diag-row">
                            <span class="diag-label">Author</span>
                            <span class="diag-value">@s.Author</span>
                        </div>
                        @{
                            var formats = s.Info.Formats;
                            var topFmt = formats.LastOrDefault();
                            // Codec is the same across all simulcast layers; pick the top
                            // tier so the displayed value lines up with the published ladder.
                            var senderCodec = topFmt?.Codec ?? "";
                            var simulcastLayers = FormatSimulcastLayerSizes(formats);
                        }
                        <div class="diag-row">
                            <span class="diag-label">Codec</span>
                            <span class="diag-value">@senderCodec</span>
                        </div>
                        <div class="diag-row">
                            <span class="diag-label">Resolutions</span>
                            <span class="diag-value">@simulcastLayers</span>
                        </div>
                        @{
                            var hasDiag = _streamDiags.TryGetValue(sid, out var rdPeek)
                                && rdPeek.ValueKind == JsonValueKind.Object;
                            var encodedRes = hasDiag
                                && rdPeek.TryGetProperty("decoderStats", out var dsPeek)
                                && dsPeek.ValueKind == JsonValueKind.Object
                                ? GetStr(dsPeek, "resolution")
                                : null;
                            var peekBitrate = hasDiag
                                ? GetNum(rdPeek, "bitrateKbps")
                                : 0;
                            JsonElement? fwdEl = hasDiag
                                && rdPeek.TryGetProperty("forwarded", out var fwd)
                                && fwd.ValueKind == JsonValueKind.Object
                                ? fwd
                                : null;
                        }
                        @if (fwdEl is { } f && GetNum(f, "ForwardedSpatialLayerId") >= 0) {
                            <div class="diag-row">
                                <span class="diag-label">Forwarded</span>
                                <span class="diag-value">L@(GetNum(f, "ForwardedSpatialLayerId").ToString("0")) @(GetNum(f, "ForwardedWidth").ToString("0"))×@(GetNum(f, "ForwardedHeight").ToString("0")) (obsMax=@(GetNum(f, "ObservedMaxSpatialLayer").ToString("0")))</span>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(encodedRes)) {
                            <div class="diag-row">
                                <span class="diag-label">Decoded</span>
                                <span class="diag-value">@encodedRes</span>
                            </div>
                        }
                        @if (peekBitrate > 0) {
                            <div class="diag-row">
                                <span class="diag-label">Bitrate</span>
                                <span class="diag-value">@(peekBitrate.ToString("0")) kbps</span>
                            </div>
                        }
                        @if (isExpanded && _streamDiags.TryGetValue(sid, out var rd) && rd.ValueKind == JsonValueKind.Object) {
                            <div class="diag-js-details">
                                <div class="diag-row">
                                    <span class="diag-label">Resolutions</span>
                                    <span class="diag-value">@FormatSimulcastLayerSizes(formats)</span>
                                </div>

                                @* Decoder *@
                                <div class="diag-group-header">Decoder</div>
                                <div class="diag-row">
                                    <span class="diag-label">Codec</span>
                                    <span class="diag-value">@GetStr(rd, "codec") (@GetStr(rd, "codecCategory"))</span>
                                </div>
                                @if (rd.TryGetProperty("decoderStats", out var ds) && ds.ValueKind == JsonValueKind.Object) {
                                    <div class="diag-row">
                                        <span class="diag-label">Time</span>
                                        <span class="diag-value">@(GetNum(ds, "medianDecodeTime").ToString("0.0"))ms (pure: @(GetNum(ds, "pureMedianDecodeTime").ToString("0.0"))ms)</span>
                                    </div>
                                    <div class="diag-row">
                                        <span class="diag-label">Queue</span>
                                        <span class="diag-value">@(GetNum(ds, "decodeQueueSize").ToString("0")) (peak: @(GetNum(ds, "peakDecodeQueueSize").ToString("0")))</span>
                                    </div>
                                    <div class="diag-row">
                                        <span class="diag-label">Frames</span>
                                        <span class="diag-value">@(GetNum(ds, "decodedFrames").ToString("0")) dec, @(GetNum(ds, "droppedFrames").ToString("0")) drop, @(GetNum(ds, "backpressureDrops").ToString("0")) bp</span>
                                    </div>
                                    <div class="diag-row">
                                        <span class="diag-label">Artifact window</span>
                                        <span class="diag-value">last: @(GetNum(ds, "lastArtifactWindowMs").ToString("0"))ms, count: @(GetNum(ds, "artifactWindowsCount").ToString("0"))</span>
                                    </div>
                                    <div class="diag-row">
                                        <span class="diag-label">HW accel</span>
                                        <span class="diag-value">@GetStr(ds, "hardwareAcceleration")</span>
                                    </div>
                                    <div class="diag-row">
                                        <span class="diag-label">Resolution</span>
                                        <span class="diag-value">@GetStr(ds, "resolution")</span>
                                    </div>
                                }

                                @* Network *@
                                <div class="diag-group-header">Network</div>
                                <div class="diag-row">
                                    <span class="diag-label">Bitrate</span>
                                    <span class="diag-value">@(GetNum(rd, "bitrateKbps").ToString("0")) kbps</span>
                                </div>
                                <div class="diag-row">
                                    <span class="diag-label">E2E latency</span>
                                    <span class="diag-value">@(GetNum(rd, "pipelineLatencyMs").ToString("0"))ms</span>
                                </div>
                                <div class="diag-row">
                                    <span class="diag-label">Jitter buf</span>
                                    <span class="diag-value">@(GetNum(rd, "jitterBufferMs").ToString("0"))ms (est: @(GetNum(rd, "jitterEstimateMs").ToString("0"))ms)</span>
                                </div>
                                <div class="diag-row">
                                    <span class="diag-label">RTT</span>
                                    <span class="diag-value">@(GetNum(rd, "smoothedRttMs").ToString("0"))ms (grad: @(GetNum(rd, "rttGradientMs").ToString("0"))ms)</span>
                                </div>

                                @* Playback *@
                                <div class="diag-group-header">Playback</div>
                                <div class="diag-row">
                                    <span class="diag-label">Rate</span>
                                    <span class="diag-value">@(GetNum(rd, "playbackRate").ToString("0.00"))x, buf=@(GetNum(rd, "bufferSize").ToString("0"))</span>
                                </div>
                                <div class="diag-row">
                                    <span class="diag-label">Received</span>
                                    <span class="diag-value">@(GetNum(rd, "receivedFrameCount").ToString("0")) frm, @(GetNum(rd, "receivedKeyframeCount").ToString("0")) key, @(GetNum(rd, "renderFrameCount").ToString("0")) rend</span>
                                </div>
                                <div class="diag-row">
                                    <span class="diag-label">Skip-to-live</span>
                                    <span class="diag-value">@(GetNum(rd, "skipToLiveCount").ToString("0"))</span>
                                </div>
                                @if (GetNum(rd, "avDriftMs") is var drift && rd.TryGetProperty("avDriftMs", out var driftEl) && driftEl.ValueKind == JsonValueKind.Number) {
                                    <div class="diag-row">
                                        <span class="diag-label">A/V drift</span>
                                        <span class="diag-value">@(drift.ToString("0"))ms</span>
                                    </div>
                                }
                                @if (GetBool(rd, "qualityReductionRequested")) {
                                    <div class="diag-row">
                                        <span class="diag-label">Quality</span>
                                        <span class="diag-value">reduction requested (slow ticks: @(GetNum(rd, "codecSlowTickCount").ToString("0")))</span>
                                    </div>
                                }
                                <div class="diag-row">
                                    <span class="diag-label">Requested</span>
                                    <span class="diag-value">@FormatRequestedReceiveQuality(rd)</span>
                                </div>
                            </div>
                        }
                    </div>
                }
            }
        </div>
        @if (m.Streams.Any(s => !s.IsOwn)) {
            <div class="diag-section">
                <div class="diag-section-header">Quality Control (inbound)</div>
                <div class="diag-row">
                    <span class="diag-label">Capacity</span>
                    <span class="diag-value">@((playbackSnap.EstimatedCapacityBytesPerSec * 8 / 1000).ToString("0")) kbps</span>
                </div>
                <div class="diag-row">
                    <span class="diag-label">Aggregate health</span>
                    <span class="diag-value">@(playbackSnap.AggregateHealth.ToString("F2"))</span>
                </div>
                <div class="diag-row">
                    <span class="diag-label">Playback override</span>
                    <span class="diag-value">@playbackOverride</span>
                </div>
                @foreach (var s in m.Streams.Where(s => !s.IsOwn)) {
                    var sid = s.Info.StreamId.Value;
                    var hasDiag = _streamDiags.TryGetValue(sid, out var rd)
                        && rd.ValueKind == JsonValueKind.Object;
                    int? verdict = playbackSnap.Verdicts.TryGetValue(sid, out var v) ? v : null;
                    <div class="diag-stream">
                        <div class="diag-stream-header">
                            <span>@s.Info.StreamId</span>
                            <span class="diag-stream-kind ml-auto">@s.Info.StreamKind</span>
                        </div>
                        <div class="diag-row">
                            <span class="diag-label">Author</span>
                            <span class="diag-value">@s.Author</span>
                        </div>
                        <div class="diag-row">
                            <span class="diag-label">Verdict</span>
                            <span class="diag-value">@(verdict is { } signal ? SignalText(signal) : "n/a")</span>
                        </div>
                        @if (hasDiag) {
                            <div class="diag-row">
                                <span class="diag-label">Forwarded</span>
                                <span class="diag-value">@FormatForwarded(rd)</span>
                            </div>
                            <div class="diag-row">
                                <span class="diag-label">Requested</span>
                                <span class="diag-value">@FormatRequestedReceiveQuality(rd)</span>
                            </div>
                            <div class="diag-row">
                                <span class="diag-label">Signal inputs</span>
                                <span class="diag-value">rate=@(GetNum(rd, "bitrateKbps").ToString("0"))kbps, buf=@(GetNum(rd, "pipelineLatencyMs").ToString("0"))ms, skips=@(GetNum(rd, "skipToLiveCount").ToString("0"))</span>
                            </div>
                            <div class="diag-row">
                                <span class="diag-label">Stream age</span>
                                <span class="diag-value">@(GetNum(rd, "streamAgeMs").ToString("0"))ms</span>
                            </div>
                            <div class="diag-row">
                                <span class="diag-label">Decode quality</span>
                                <span class="diag-value">@FormatDecodeQualitySignal(rd)</span>
                            </div>
                        }
                        else {
                            <div class="diag-row">
                                <span class="diag-label">Signals</span>
                                <span class="diag-value diag-dim">waiting for diagnostics</span>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </Body>
</DialogFrame>

@code {
    private static readonly string JSCollectOwnMethod = $"{BlazorUIAppModule.ImportName}.collectOwnStreamDiagnostics";
    private static readonly string JSCollectRemoteMethod = $"{BlazorUIAppModule.ImportName}.collectRemoteStreamDiagnostics";

    private Timer? _pollTimer;
    private JsonElement? _ownDiag;
    private readonly Dictionary<string, JsonElement> _streamDiags = new();
    private readonly HashSet<string> _expandedStreams = new();
    private bool _isDisposed;
    private bool _showOwnStreamingDetails;
    private int? _selectedOwnSpatialLayerId;

    private ChatVideoUI ChatVideoUI => Hub.ChatVideoUI;
    private IAuthors Authors => Hub.Authors;

    [CascadingParameter] public Modal Modal { get; set; } = null!;
    [Parameter] public Model ModalModel { get; set; } = null!;

    public override async ValueTask DisposeAsync() {
        _isDisposed = true;
        if (_pollTimer is not null)
            await _pollTimer.DisposeAsync();
        await base.DisposeAsync();
    }

    protected override void OnAfterRender(bool firstRender) {
        // ComputeState may surface remote streams asynchronously after first render.
        // Re-evaluate polling state on every render so the timer kicks in as soon as
        // streams appear and disposes when the list empties.
        EnsurePollingState();
    }

    protected override ComputedState<ComputedModel>.Options GetStateOptions()
        => new() {
            InitialValue = ComputedModel.Empty,
            UpdateDelayer = FixedDelayer.NextTick,
            Category = GetStateCategory(GetType()),
        };

    protected override async Task<ComputedModel> ComputeState(CancellationToken cancellationToken) {
        var chatId = ModalModel.ChatId;

        var ownStreamKind = await ChatVideoUI.GetOwnStreamKind(chatId, cancellationToken).ConfigureAwait(false);
        var activeStreams = await ChatVideoUI.GetActiveVideoStreams(chatId, cancellationToken);
        var memberCount = activeStreams.Count > 0
            ? await ChatVideoUI.GetVideoStreamMemberCount(chatId, cancellationToken).ConfigureAwait(false)
            : 0;

        var ownAuthor = await Authors.GetOwn(Session, chatId, cancellationToken);

        // Resolve author names
        var streams = new StreamEntry[activeStreams.Count];
        for (var i = 0; i < activeStreams.Count; i++) {
            var info = activeStreams[i];
            var author = await Authors.Get(Session, chatId, info.AuthorId, cancellationToken);
            streams[i] = new StreamEntry(info, author?.Avatar.Name ?? info.AuthorId.Value, ownAuthor?.Id == info.AuthorId);
        }

        var account = await Hub.AccountUI.OwnAccount.Use(cancellationToken);
        return new ComputedModel(ownStreamKind, streams, memberCount, account.IsAdmin);
    }

    private void OnToggleOwnStreamingDetails() {
        _showOwnStreamingDetails = !_showOwnStreamingDetails;
        if (!_showOwnStreamingDetails)
            _ownDiag = null;
        EnsurePollingState();
        StateHasChanged();
    }

    private void OnToggleStreamDetails(string streamId) {
        if (!_expandedStreams.Remove(streamId))
            _expandedStreams.Add(streamId);
        // Polling continues for all remote streams regardless of expand state —
        // the always-visible "Forwarded" row needs fresh diagnostics. Don't drop
        // _streamDiags here.
        StateHasChanged();
    }

    private void EnsurePollingState() {
        // Poll whenever the modal has any remote streams to show. We need diagnostics
        // for ALL remote streams (not just expanded) because the always-visible
        // "Forwarded" row reads `forwarded` out of _streamDiags. Cheap: 1 JS call per
        // stream every 1.5s.
        var hasRemoteStreams = State.Value.Streams.Any(s => !s.IsOwn);
        var needsPolling = _showOwnStreamingDetails || hasRemoteStreams;
        if (needsPolling) {
            _pollTimer ??= new Timer(_1 => _ = PollJsDiagnostics(), null, TimeSpan.Zero, TimeSpan.FromMilliseconds(1500));
        } else {
            _pollTimer?.Dispose();
            _pollTimer = null;
            _ownDiag = null;
            _streamDiags.Clear();
        }
    }

    private async Task PollJsDiagnostics() {
        if (_isDisposed) return;
        try {
            if (_showOwnStreamingDetails) {
                var kind = (int)State.Value.OwnStreamingKind.GetValueOrDefault(StreamKind.Webcam);
                _ownDiag = await JS.InvokeAsync<JsonElement>(JSCollectOwnMethod, kind);
            }

            foreach (var entry in State.Value.Streams) {
                if (entry.IsOwn) continue;
                var streamId = entry.Info.StreamId.Value;
                var diag = await JS.InvokeAsync<JsonElement>(JSCollectRemoteMethod, streamId);
                if (diag.ValueKind == JsonValueKind.Object)
                    _streamDiags[streamId] = diag;
            }

            await InvokeAsync(StateHasChanged);
        } catch {
            // Ignore errors during polling (component may be disposed)
        }
    }

    private static string GetStr(JsonElement el, string prop)
        => el.TryGetProperty(prop, out var v) && v.ValueKind == JsonValueKind.String ? v.GetString() ?? "" : "";

    private static double GetNum(JsonElement el, string prop)
        => el.TryGetProperty(prop, out var v) && v.ValueKind == JsonValueKind.Number ? v.GetDouble() : 0;

    private static bool GetBool(JsonElement el, string prop)
        => el.TryGetProperty(prop, out var v) && v.ValueKind is JsonValueKind.True or JsonValueKind.False && v.GetBoolean();

    private static JsonElement[] GetArray(JsonElement el, string prop)
        => el.TryGetProperty(prop, out var v) && v.ValueKind == JsonValueKind.Array
            ? v.EnumerateArray().ToArray()
            : [];

    private static int GetSpatialLayerId(JsonElement layer)
        => (int)GetNum(layer, "spatialLayerId");

    private JsonElement? SelectOwnSpatialLayer(JsonElement[] layers) {
        if (layers.Length == 0)
            return null;
        if (_selectedOwnSpatialLayerId is { } selected) {
            foreach (var layer in layers)
                if (GetSpatialLayerId(layer) == selected)
                    return layer;
        }
        return layers[^1];
    }

    private void OnSelectOwnSpatialLayer(int layerId) {
        _selectedOwnSpatialLayerId = layerId;
        StateHasChanged();
    }

    private static string GetStrArray(JsonElement el, string prop) {
        if (!el.TryGetProperty(prop, out var v) || v.ValueKind != JsonValueKind.Array)
            return "";
        return string.Join(", ", v.EnumerateArray().Select(x => x.GetString()));
    }

    private static string FormatForwarded(JsonElement rd) {
        if (!rd.TryGetProperty("forwarded", out var forwarded)
            || forwarded.ValueKind != JsonValueKind.Object
            || GetNum(forwarded, "ForwardedSpatialLayerId") < 0)
            return "no frames yet";

        return $"L{GetNum(forwarded, "ForwardedSpatialLayerId"):0} "
            + $"{GetNum(forwarded, "ForwardedWidth"):0}×{GetNum(forwarded, "ForwardedHeight"):0} "
            + $"(obsMax={GetNum(forwarded, "ObservedMaxSpatialLayer"):0})";
    }

    private static string FormatRequestedReceiveQuality(JsonElement rd) {
        if (!rd.TryGetProperty("requestedReceiveQuality", out var requested)
            || requested.ValueKind != JsonValueKind.Object)
            return "default (server-driven)";

        return $"maxSpatial={GetNum(requested, "maxSpatialLayer"):0} "
            + $"maxTemporal={FormatMaxTemporal(GetNum(requested, "maxTemporalLayer"))}";
    }

    private static string FormatDecodeQualitySignal(JsonElement rd)
        => GetBool(rd, "qualityReductionRequested")
            ? $"reduction requested (slow ticks: {GetNum(rd, "codecSlowTickCount"):0})"
            : $"ok (slow ticks: {GetNum(rd, "codecSlowTickCount"):0})";

    private static string FormatRecordingQualityState(VideoQualityUI.RecordingQualitySnapshot snapshot)
        => snapshot.State is { } state
            ? $"target={state.TargetLayerCount}, effective={state.EffectiveLayerCount}"
            : "no controller state yet";

    private static bool ShouldShowRecordingAction(RecordingQualityReason reason)
        => reason != RecordingQualityReason.Stable;

    private static string FormatLayerCap(int? layerCount)
        => layerCount is { } count ? $"{count} layers" : "none";

    private static string FormatRecordingEncodeCostSignal(RecorderHealthSnapshot health)
        => $"ema={health.EncodeRatioEma:F2}x budget, p90={health.EncodeRatioP90:F2}x";

    private static string FormatRecordingSlotSignal(RecorderHealthSnapshot health)
        => $"replaceRateEma={health.SlotReplacementRateEma:F2}";

    private static string FormatRecordingSenderSignal(RecorderHealthSnapshot health)
        => $"dropRatioEma={health.SenderFrameDropRatioEma:F2}, "
            + $"ackAge={FormatAckAge(health.LastAckAgeMs)}, connected={(health.IsConnected ? "yes" : "no")}";

    private static string FormatAckAge(double ageMs)
        => ageMs >= 0 ? $"{ageMs:0}ms" : "n/a";

    private static string FormatMaxTemporal(double value)
        => value >= int.MaxValue / 2d ? "inf" : value.ToString("0");

    private static string SignalText(int signal)
        => signal switch {
            < 0 => $"{signal} (bad)",
            > 0 => $"+{signal} (good)",
            _ => "0 (neutral)",
        };

    private static string FormatSimulcastLayerSizes(IEnumerable<ActualChat.Video.VideoFormat> formats, string separator = "×") {
        var items = formats
            .OrderBy(f => f.SpatialLayerId)
            .Where(f => f.Size.Width > 0 && f.Size.Height > 0)
            .Select(f => $"L{f.SpatialLayerId} {f.Size.Width}{separator}{f.Size.Height}");
        return string.Join(", ", items).NullIfEmpty() ?? "n/a";
    }

    private string GetShowDetailsIndicator(bool show)
        => show ? ">---<" : "<->";

    private void OnSettingsClick()
        => _ = Hub.ModalUI.Show(new VideoDiagnosticsSettingsModal.Model());

    private async Task OnCopyClick() {
        var sb = new System.Text.StringBuilder();
        var m = State.Value;

        sb.AppendLine("=== Video Diagnostics ===");
        sb.AppendLine();

        // Own streaming
        sb.AppendLine("-- Own Streaming --");
        if (m.OwnStreamingKind is { } kind)
            sb.AppendLine($"Kind: {kind}");
        else
            sb.AppendLine("Status: Not streaming");

        if (_ownDiag is { } ownVal
            && ownVal.TryGetProperty("stream", out var ownStream)
            && ownStream.ValueKind == JsonValueKind.Object) {
            // Source
            sb.AppendLine($"Status: {GetStr(ownStream, "status")}");
            if (GetStr(ownStream, "cameraLabel") is { Length: > 0 } copyCameraLabel)
                sb.AppendLine($"Camera: {copyCameraLabel}");
            sb.AppendLine($"Input: {GetStr(ownStream, "inputResolution")} @ {GetNum(ownStream, "inputFramerate"):0}fps");
            sb.AppendLine($"Duration: {GetNum(ownStream, "duration"):0}s");

            // Encoder
            sb.AppendLine();
            sb.AppendLine("-- Encoder --");
            sb.AppendLine($"Codec: {GetStr(ownStream, "codec")} ({GetStr(ownStream, "codecCategory")}, {(GetBool(ownStream, "hardwareAccelerated") ? "HW" : "SW")})");
            if (GetBool(ownStream, "blurEnabled"))
                sb.AppendLine($"Blur: {GetStr(ownStream, "segmentationBackend")} ({GetNum(ownStream, "segmentationAvgTime"):0.0}ms)");
            sb.AppendLine($"Available: {GetStrArray(ownStream, "supportedEncoderCategories")}");

            var copyLayers = GetArray(ownStream, "spatialLayers").OrderBy(GetSpatialLayerId).ToArray();
            if (copyLayers.Length > 0) {
                sb.AppendLine();
                sb.AppendLine("-- Encoder Layers --");
                foreach (var layer in copyLayers) {
                    var layerId = GetSpatialLayerId(layer);
                    sb.AppendLine($"L{layerId}: {GetStr(layer, "outputResolution")} @ {GetNum(layer, "actualBitrateKbps"):0} kbps (cfg: {GetNum(layer, "configuredBitrate") / 1000:0} kbps)");
                    sb.AppendLine($"  Encode time: {GetNum(layer, "medianEncodeTime"):0.0}ms (pure: {GetNum(layer, "pureMedianEncodeTime"):0.0}ms)");
                    sb.AppendLine($"  HW accel: {GetStr(layer, "encoderHwAccel")}");
                    sb.AppendLine($"  Frames: {GetNum(layer, "encodedFrames"):0} enc, {GetNum(layer, "droppedFrames"):0} drop, {GetNum(layer, "keyFrames"):0} key");
                    sb.AppendLine($"  State: {GetStr(layer, "encoderState")}");
                    sb.AppendLine($"  Lifecycle: {GetNum(layer, "encoderReconfigureCount"):0} reconfigure, {GetNum(layer, "encoderReplaceCount"):0} replace");
                    if (GetStr(layer, "encoderLastReconfigureSummary") is { Length: > 0 } copyReconfSummary) {
                        var ageMs = GetNum(layer, "encoderLastReconfigureAgeMs");
                        sb.AppendLine($"  Last reconfig: {copyReconfSummary}{(ageMs >= 0 ? $" ({ageMs:0}ms ago)" : "")}");
                    }
                    if (GetNum(layer, "encoderErrorCount") > 0) {
                        var errAgeMs = GetNum(layer, "encoderLastErrorAgeMs");
                        sb.AppendLine($"  Encoder error: {GetStr(layer, "encoderLastErrorName")}: {GetStr(layer, "encoderLastErrorMessage")} ({GetNum(layer, "encoderErrorCount"):0} total{(errAgeMs >= 0 ? $", {errAgeMs:0}ms ago" : "")})");
                    }
                }
            }

            // Orientation
            if (ownStream.TryGetProperty("orientation", out var orient) && orient.ValueKind == JsonValueKind.Object) {
                sb.AppendLine();
                sb.AppendLine("-- Orientation --");
                sb.AppendLine($"Display: {GetStr(orient, "firstDisplayResolution")}");
                sb.AppendLine($"Coded: {GetStr(orient, "firstCodedResolution")}");
                sb.AppendLine($"Config: {GetStr(orient, "configuredResolution")}");
                sb.AppendLine($"Rotation: {GetStr(orient, "firstRotation")} → {GetStr(orient, "lastRotation")}");
                sb.AppendLine($"Detection: {GetStr(orient, "rotationDetection")} (rot: {(GetBool(orient, "needsRotation") ? "yes" : "no")})");
                sb.AppendLine($"Frames seen: {GetNum(orient, "framesSeen"):0}");
            }

            // Streaming
            if (ownStream.TryGetProperty("streaming", out var copyStreaming) && copyStreaming.ValueKind == JsonValueKind.Object) {
                sb.AppendLine();
                sb.AppendLine("-- Streaming --");
                sb.AppendLine($"Send: {GetStr(copyStreaming, "status")} ({GetNum(copyStreaming, "sentFrames"):0} frames)");
                if (GetNum(copyStreaming, "pendingFrames") > 0)
                    sb.AppendLine($"Pending: {GetNum(copyStreaming, "pendingFrames"):0} frames");
                if (GetNum(copyStreaming, "streamRecreations") > 1)
                    sb.AppendLine($"Reconnects: {GetNum(copyStreaming, "streamRecreations") - 1:0}");
                if (GetStr(copyStreaming, "lastError") is { Length: > 0 } copyStreamError)
                    sb.AppendLine($"Last Error: {copyStreamError}");
            }
        }
        if (m.OwnStreamingKind is { } ownCopyKind) {
            var copyRecordingSnap = Hub.VideoQualityUI.GetRecordingSnapshot(ownCopyKind);
            sb.AppendLine();
            sb.AppendLine("-- Quality Control (outbound) --");
            sb.AppendLine($"Target: {FormatRecordingQualityState(copyRecordingSnap)}");
            sb.AppendLine($"Verdict: {SignalText(copyRecordingSnap.Signal)}");
            if (ShouldShowRecordingAction(copyRecordingSnap.Reason))
                sb.AppendLine($"Action: {copyRecordingSnap.Reason}");
            sb.AppendLine($"Layer cap: {FormatLayerCap(copyRecordingSnap.DebugMaxLayerCount)}");
            if (copyRecordingSnap.Health is { } copyHealth) {
                sb.AppendLine($"Encode cost: {FormatRecordingEncodeCostSignal(copyHealth)}");
                sb.AppendLine($"Frame slots: {FormatRecordingSlotSignal(copyHealth)}");
                sb.AppendLine($"Sender: {FormatRecordingSenderSignal(copyHealth)}");
            }
            else
                sb.AppendLine("Signals: no health sample yet");
        }
        sb.AppendLine();

        // Streams
        sb.AppendLine($"-- Active Streams ({m.Streams.Length}, {m.MemberCount} members) --");
        foreach (var s in m.Streams) {
            var sid = s.Info.StreamId.Value;
            sb.AppendLine();
            sb.AppendLine($"[{sid}] {s.Author}{(s.IsOwn ? " (Own)" : "")}");
            sb.AppendLine($"  Kind: {(s.Info.StreamKind == StreamKind.Screencast ? "Screencast" : "Camera")}");
            sb.AppendLine($"  Started: {DateTimeConverter.ToLocalTime(s.Info.StartedAt):HH:mm:ss}");
            var copyFormats = s.Info.Formats;
            var copyTop = copyFormats.LastOrDefault();
            sb.AppendLine($"  Codec: {copyTop?.Codec ?? "?"}");
            sb.AppendLine($"  Resolutions: {FormatSimulcastLayerSizes(copyFormats, "x")}");

            if (_streamDiags.TryGetValue(sid, out var rd) && rd.ValueKind == JsonValueKind.Object) {
                if (rd.TryGetProperty("forwarded", out var copyFwd)
                    && copyFwd.ValueKind == JsonValueKind.Object
                    && GetNum(copyFwd, "ForwardedSpatialLayerId") >= 0)
                    sb.AppendLine(
                        $"  Forwarded: L{GetNum(copyFwd, "ForwardedSpatialLayerId"):0} "
                        + $"{GetNum(copyFwd, "ForwardedWidth"):0}x{GetNum(copyFwd, "ForwardedHeight"):0} "
                        + $"(obsMax={GetNum(copyFwd, "ObservedMaxSpatialLayer"):0})");
                // Decoder
                sb.AppendLine("  -- Decoder --");
                sb.AppendLine($"  Codec: {GetStr(rd, "codec")} ({GetStr(rd, "codecCategory")})");
                if (rd.TryGetProperty("decoderStats", out var copyDs) && copyDs.ValueKind == JsonValueKind.Object) {
                    sb.AppendLine($"  Time: {GetNum(copyDs, "medianDecodeTime"):0.0}ms (pure: {GetNum(copyDs, "pureMedianDecodeTime"):0.0}ms)");
                    sb.AppendLine($"  Queue: {GetNum(copyDs, "decodeQueueSize"):0} (peak: {GetNum(copyDs, "peakDecodeQueueSize"):0})");
                    sb.AppendLine($"  Frames: {GetNum(copyDs, "decodedFrames"):0} dec, {GetNum(copyDs, "droppedFrames"):0} drop, {GetNum(copyDs, "backpressureDrops"):0} bp");
                    sb.AppendLine($"  Artifact window: last {GetNum(copyDs, "lastArtifactWindowMs"):0}ms, count {GetNum(copyDs, "artifactWindowsCount"):0}");
                    sb.AppendLine($"  HW accel: {GetStr(copyDs, "hardwareAcceleration")}");
                    sb.AppendLine($"  Resolution: {GetStr(copyDs, "resolution")}");
                }
                // Network
                sb.AppendLine("  -- Network --");
                sb.AppendLine($"  Bitrate: {GetNum(rd, "bitrateKbps"):0} kbps");
                sb.AppendLine($"  E2E latency: {GetNum(rd, "pipelineLatencyMs"):0}ms");
                sb.AppendLine($"  Jitter buf: {GetNum(rd, "jitterBufferMs"):0}ms (est: {GetNum(rd, "jitterEstimateMs"):0}ms)");
                sb.AppendLine($"  RTT: {GetNum(rd, "smoothedRttMs"):0}ms (grad: {GetNum(rd, "rttGradientMs"):0}ms)");
                // Playback
                sb.AppendLine("  -- Playback --");
                sb.AppendLine($"  Rate: {GetNum(rd, "playbackRate"):0.00}x, buf={GetNum(rd, "bufferSize"):0}");
                sb.AppendLine($"  Received: {GetNum(rd, "receivedFrameCount"):0} frm, {GetNum(rd, "receivedKeyframeCount"):0} key, {GetNum(rd, "renderFrameCount"):0} rend");
                sb.AppendLine($"  Skip-to-live: {GetNum(rd, "skipToLiveCount"):0}");
                if (rd.TryGetProperty("avDriftMs", out var copyDriftEl) && copyDriftEl.ValueKind == JsonValueKind.Number)
                    sb.AppendLine($"  A/V drift: {copyDriftEl.GetDouble():0}ms");
                if (GetBool(rd, "qualityReductionRequested"))
                    sb.AppendLine($"  Quality: reduction requested (slow ticks: {GetNum(rd, "codecSlowTickCount"):0})");
            }
        }

        await Hub.ClipboardUI.WriteText(sb.ToString());
    }

    // Nested types

    public sealed class Model(ChatId chatId)
    {
        public ChatId ChatId { get; } = chatId;
    }

    public sealed record StreamEntry(VideoStreamInfo Info, string Author, bool IsOwn = false);

    public sealed record ComputedModel(
        StreamKind? OwnStreamingKind,
        StreamEntry[] Streams,
        int MemberCount,
        bool IsAdmin
    ) {
        public static readonly ComputedModel Empty = new(null, [], 0, false);
    }
}
