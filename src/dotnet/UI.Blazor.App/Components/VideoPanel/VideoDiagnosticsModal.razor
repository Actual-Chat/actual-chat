@namespace ActualChat.UI.Blazor.App.Components.VideoPanel
@using System.Text.Json
@using ActualChat.Media
@using ActualChat.Bandwidth
@using ActualChat.Streaming
@using ActualChat.UI.Blazor.App.Module
@using ActualChat.Video
@using Microsoft.AspNetCore.Components.Rendering
@inherits ComputedStateComponent<AppUIHub, VideoDiagnosticsModal.ComputedModel>
@implements IModalView<VideoDiagnosticsModal.Model>
@{
    var m = State.Value;
}

<DialogFrame
    Class="video-diagnostics-modal"
    Title="Video Diagnostics"
    NarrowViewSettings="@DialogFrameNarrowViewSettings.Default"
    HasCloseButton="true">
    <Buttons>
        @if (_copyTextSourceRef is not null) {
            <CopyTrigger Class="flex-1" Tooltip="Copy diagnostics" CopyTextSourceRef="@_copyTextSourceRef">
                <Button Class="btn-modal">Copy</Button>
            </CopyTrigger>
        }
    </Buttons>
    <Body>
        <div class="diag-tabs">
            <button type="button"
                    class="diag-tab @(_activeTab == Tab.Inbound ? "diag-tab--active" : "")"
                    @onclick="@(() => OnSelectTab(Tab.Inbound))">
                Inbound
            </button>
            <button type="button"
                    class="diag-tab @(_activeTab == Tab.Outbound ? "diag-tab--active" : "")"
                    @onclick="@(() => OnSelectTab(Tab.Outbound))">
                Outbound
            </button>
            @if (m.ShowSettingsTab) {
                <button type="button"
                        class="diag-tab @(_activeTab == Tab.Settings ? "diag-tab--active" : "")"
                        @onclick="@(() => OnSelectTab(Tab.Settings))">
                    Settings
                </button>
            }
        </div>
        <div @ref="_copyTextSourceRef" class="diag-body-content" data-copy-source="innerText">
        @* All tab content sits inside the selectable wrapper *@

        @if (_activeTab == Tab.Outbound) {
        @* Own streaming *@
        <div class="diag-section">
            @{
                var hasOutbound = m.OwnSourceKinds.Count > 0;
                var headerOnClick = hasOutbound ? OnToggleOwnStreamingDetails : (Action)(() => { });
            }
            <div class="diag-section-header @(hasOutbound ? "diag-clickable" : "")"
                 role="@(hasOutbound ? "button" : null)"
                 tabindex="@(hasOutbound ? 0 : (int?)null)"
                 @onclick="@headerOnClick">
                Streams
                @if (m.OwnSourceKinds.Count > 1) {
                    <span class="diag-badge">@m.OwnSourceKinds.Count</span>
                }
                @if (hasOutbound) {
                    <span class="diag-expand-indicator">@GetShowDetailsIndicator(_showOwnStreamingDetails)</span>
                }
            </div>
            @if (!hasOutbound) {
                <div class="diag-row">
                    <span class="diag-label">Status</span>
                    <span class="diag-value diag-dim">Not streaming</span>
                </div>
            }
            @foreach (var kind in m.OwnSourceKinds) {
                var throughputKey = OwnThroughputKey(kind);
                var hasOwnDiag = _ownDiagByKind.TryGetValue(kind, out var ownDiag);
                JsonElement stream = default;
                var hasStream = hasOwnDiag && ownDiag.TryGetProperty("stream", out stream) && stream.ValueKind == JsonValueKind.Object;
                var recordingSnap = Hub.VideoQualityUI.GetRecordingSnapshot(kind);
                <div class="diag-stream">
                    <div class="diag-stream-header">
                        <span>@kind</span>
                    </div>
                    @if (hasStream) {
                        <div class="diag-js-details">
                            @* Source fields are always shown alongside Kind so the
                               collapsed state stays informative; no subheader needed. *@
                            <div class="diag-row">
                                <span class="diag-label">Status</span>
                                <span class="diag-value">@GetStr(stream, "status")</span>
                            </div>

                            @if (GetStr(stream, "cameraLabel") is { Length: > 0 } cameraLabel) {
                                <div class="diag-row">
                                    <span class="diag-label">Source</span>
                                    <span class="diag-value multiline">@kind: @cameraLabel</span>
                                </div>
                            }

                            <div class="diag-row">
                                <span class="diag-label">Input</span>
                                <span class="diag-value">@GetStr(stream, "inputResolution") @@ @(GetNum(stream, "inputFramerate").ToString("0.##"))fps</span>
                            </div>
                            <div class="diag-row">
                                <span class="diag-label">Duration</span>
                                <span class="diag-value">@(GetNum(stream, "duration").ToString("0"))s</span>
                            </div>

                            @if (_showOwnStreamingDetails) {
                                <div class="diag-js-expanded">
                                    @* Encoder *@
                                    <div class="diag-group-header">Encoder</div>
                                    <div class="diag-row">
                                        <span class="diag-label">Codec</span>
                                        <span class="diag-value">@GetStr(stream, "codec") (@GetStr(stream, "codecCategory"), @(GetBool(stream, "hardwareAccelerated") ? "HW" : "SW"))</span>
                                    </div>

                                    @if (GetBool(stream, "blurEnabled")) {
                                        <div class="diag-row">
                                            <span class="diag-label">Blur</span>
                                            <span class="diag-value">@GetStr(stream, "segmentationBackend") (@(GetNum(stream, "segmentationAvgTime").ToString("0.0"))ms)</span>
                                        </div>
                                    }

                                    <div class="diag-row">
                                        <span class="diag-label">Available</span>
                                        <span class="diag-value">@GetStrArray(stream, "supportedEncoderCategories")</span>
                                    </div>
                                    <div class="diag-row">
                                        <span class="diag-label">Frames</span>
                                        <span class="diag-value">@(GetNum(stream, "encodedFrames").ToString("0")) enc, @(GetNum(stream, "droppedFrames").ToString("0")) drop</span>
                                    </div>
                                    <div class="diag-row">
                                        <span class="diag-label">Encode time</span>
                                        <span class="diag-value">@(GetNum(stream, "medianEncodeTime").ToString("0.0"))ms (@(GetNum(stream, "maxLayerEncodeTime").ToString("0.0"))ms LMax)</span>
                                    </div>
                                    <div class="diag-row">
                                        <span class="diag-label">Bitrate</span>
                                        <span class="diag-value">@(GetNum(stream, "actualBitrateKbps").ToString("0")) kbps (sum across layers)</span>
                                    </div>

                                    @if (_throughputDelta.TryGetValue(throughputKey, out var outDelta)) {
                                        var isThroughputExpanded = _throughputExpanded.Contains(throughputKey);
                                        <div class="diag-row diag-clickable" role="button" tabindex="0" @onclick="@(() => OnToggleThroughputExpanded(throughputKey))">
                                            <span class="diag-label">Throughput</span>
                                            <span class="diag-value">
                                                @($"{outDelta.Fps:0} bundles/s · {outDelta.Kbps:0} kbps")
                                                <span class="diag-expand-indicator">@GetShowDetailsIndicator(isThroughputExpanded)</span>
                                            </span>
                                        </div>
                                        @if (isThroughputExpanded) {
                                            @RenderDropBreakdown(outDelta)
                                        }
                                    }

                                    @* Demand — why the ladder/fps are what they are *@
                                    @{
                                        var dMax = (int)GetNum(stream, "lastMaxLayerId");
                                        var dRecvCap = (int)GetNum(stream, "receiverLayerCap");
                                        var dHealthCap = (int)GetNum(stream, "healthLayerCap");
                                        var dActive = (int)GetNum(stream, "activeLayerCount");
                                        var dFps = (int)GetNum(stream, "targetFps");
                                        var dSpeaking = GetBool(stream, "isSpeaking");
                                        var dIdleCollapse = GetBool(stream, "idleCollapseActive");
                                        var dStats = _demandStatsByKind.GetValueOrDefault(kind);
                                    }
                                    <div class="diag-group-header">Demand</div>
                                    <div class="diag-row">
                                        <span class="diag-label">Requested</span>
                                        <span class="diag-value">@(dMax < 0 ? "none (nobody / all paused)" : $"max L{dMax} across viewers")</span>
                                    </div>
                                    <div class="diag-row">
                                        <span class="diag-label">Viewers</span>
                                        <span class="diag-value">@(dStats is null ? "no aggregate from server yet" : $"{dStats.ViewerCount} reporting ({dStats.PausedCount} paused)")</span>
                                    </div>
                                    <div class="diag-row">
                                        <span class="diag-label">Active layers</span>
                                        <span class="diag-value">@dActive (recvCap @(dRecvCap < 0 ? "—" : dRecvCap.ToString()), healthCap @(dHealthCap < 0 ? "—" : dHealthCap.ToString()))</span>
                                    </div>
                                    @if (dIdleCollapse) {
                                        <div class="diag-row">
                                            <span class="diag-label">Idle</span>
                                            <span class="diag-value">collapsed to L0 (no viewer demand)</span>
                                        </div>
                                    }
                                    <div class="diag-row">
                                        <span class="diag-label">Target fps</span>
                                        <span class="diag-value">@(dFps < 0 ? "full (unpaced)" : dFps.ToString())@(dSpeaking ? " · speaking (VAD full)" : "")</span>
                                    </div>

                                    @* Selected layer *@
                                    @{
                                        var layers = GetArray(stream, "layers")
                                            .OrderBy(GetLayerId)
                                            .ToArray();
                                        var selectedLayer = SelectOwnLayer(kind, layers);
                                    }
                                    @if (selectedLayer is { } layer) {
                                        var layerId = GetLayerId(layer);
                                        var streamCodec = GetStr(stream, "codec");
                                        var estLayerKbps = EstimatedLayerKbps(kind, layerId, streamCodec);
                                        <div class="diag-group-header">Layer</div>
                                        <div class="diag-row">
                                            <span class="diag-label">Layer</span>
                                            <span class="diag-value diag-layer-picker">
                                                @foreach (var l in layers) {
                                                    var id = GetLayerId(l);
                                                    <button type="button" class="diag-layer-link @(id == layerId ? "active" : "")" @onclick="() => OnSelectOwnLayer(kind, id)">L@(id)</button>
                                                }
                                            </span>
                                        </div>
                                        <div class="diag-row">
                                            <span class="diag-label">Output</span>
                                            <span class="diag-value">@GetStr(layer, "outputResolution")</span>
                                        </div>
                                        <div class="diag-row">
                                            <span class="diag-label">Bitrate</span>
                                            <span class="diag-value">@(estLayerKbps.ToString("0")) kbps</span>
                                        </div>

                                        @if (GetStr(layer, "encoderLastReconfigureSummary") is { Length: > 0 } reconfSummary) {
                                            <div class="diag-row">
                                                <span class="diag-label">Last reconfig</span>
                                                <span class="diag-value multiline">@reconfSummary @(GetNum(layer, "encoderLastReconfigureAgeMs") >= 0 ? $"({GetNum(layer, "encoderLastReconfigureAgeMs"):0}ms ago)" : "")</span>
                                            </div>
                                        }

                                        @if (GetNum(layer, "encoderErrorCount") > 0) {
                                            <div class="diag-row">
                                                <span class="diag-label">Encoder error</span>
                                                <div class="diag-value multiline">
                                                    <span class="diag-error">@GetStr(layer, "encoderLastErrorName"): @GetStr(layer, "encoderLastErrorMessage")</span>
                                                    <span class="diag-dim">(@(GetNum(layer, "encoderErrorCount").ToString("0")) total@(GetNum(layer, "encoderLastErrorAgeMs") >= 0 ? $", {GetNum(layer, "encoderLastErrorAgeMs"):0}ms ago" : ""))</span>
                                                </div>
                                            </div>
                                        }
                                    }

                                    @* Orientation *@
                                    @if (stream.TryGetProperty("orientation", out var orient) && orient.ValueKind == JsonValueKind.Object) {
                                        <div class="diag-group-header">Orientation</div>
                                        <div class="diag-row">
                                            <span class="diag-label">Display</span>
                                            <span class="diag-value">@GetStr(orient, "firstDisplayResolution")</span>
                                        </div>
                                        <div class="diag-row">
                                            <span class="diag-label">Coded</span>
                                            <span class="diag-value">@GetStr(orient, "firstCodedResolution")</span>
                                        </div>
                                        <div class="diag-row">
                                            <span class="diag-label">Config</span>
                                            <span class="diag-value">@GetStr(orient, "configuredResolution")</span>
                                        </div>
                                        <div class="diag-row">
                                            <span class="diag-label">Rotation</span>
                                            <span class="diag-value">@GetStr(orient, "firstRotation") → @GetStr(orient, "lastRotation")</span>
                                        </div>
                                        <div class="diag-row">
                                            <span class="diag-label">Detection</span>
                                            <span class="diag-value">@GetStr(orient, "rotationDetection") (@(GetBool(orient, "needsRotation") ? "rot: yes" : "rot: no"))</span>
                                        </div>
                                        <div class="diag-row">
                                            <span class="diag-label">Frames seen</span>
                                            <span class="diag-value">@(GetNum(orient, "framesSeen").ToString("0"))</span>
                                        </div>
                                    }

                                    @* Streaming *@
                                    @if (stream.TryGetProperty("streaming", out var streaming) && streaming.ValueKind == JsonValueKind.Object) {
                                        <div class="diag-group-header">Streaming</div>
                                        <div class="diag-row">
                                            <span class="diag-label">Send</span>
                                            <div class="diag-value multiline">
                                                <span class="diag-value">@GetStr(streaming, "status") (@(GetNum(streaming, "sentFrames").ToString("0")) frames)</span>
                                            </div>
                                        </div>

                                        @if (GetNum(streaming, "pendingFrames") > 0) {
                                            <div class="diag-row">
                                                <span class="diag-label">Pending</span>
                                                <span class="diag-value">@(GetNum(streaming, "pendingFrames").ToString("0")) frames</span>
                                            </div>
                                        }

                                        @if (GetNum(streaming, "streamRecreations") > 1) {
                                            <div class="diag-row">
                                                <span class="diag-label">Reconnects</span>
                                                <span class="diag-value">@((GetNum(streaming, "streamRecreations") - 1).ToString("0"))</span>
                                            </div>
                                        }

                                        @if (GetStr(streaming, "lastError") is { Length: > 0 } streamError) {
                                            <div class="diag-row">
                                                <span class="diag-label">Last Error</span>
                                                <div class="diag-value multiline">
                                                    <span class="diag-error">@streamError</span>
                                                </div>
                                            </div>
                                        }
                                    }

                                    @* Quality control *@
                                    <div class="diag-group-header">Quality Control</div>
                                    <div class="diag-row">
                                        <span class="diag-label">Target</span>
                                        <span class="diag-value">@FormatRecordingQualityState(recordingSnap)</span>
                                    </div>
                                    <div class="diag-row">
                                        <span class="diag-label">Verdict</span>
                                        <span class="diag-value">@SignalText(recordingSnap.Signal)</span>
                                    </div>

                                    @if (ShouldShowRecordingAction(recordingSnap.Reason)) {
                                        <div class="diag-row">
                                            <span class="diag-label">Action</span>
                                            <span class="diag-value">@recordingSnap.Reason</span>
                                        </div>
                                    }

                                    <div class="diag-row">
                                        <span class="diag-label">Caps</span>
                                        <span class="diag-value multiline">@FormatRecordingCaps(recordingSnap)</span>
                                    </div>
                                    <div class="diag-row">
                                        <span class="diag-label">Bandwidth</span>
                                        <span class="diag-value">@FormatRecordingBandwidth(recordingSnap)</span>
                                    </div>
                                    <div class="diag-row">
                                        <span class="diag-label">Probe</span>
                                        <span class="diag-value">@recordingSnap.ProbeStatus</span>
                                    </div>

                                    @if (recordingSnap.Health is { } health) {
                                        <div class="diag-row">
                                            <span class="diag-label">Signals</span>
                                            <span class="diag-value multiline">@FormatRecordingSignals(health)</span>
                                        </div>
                                    }
                                    else {
                                        <div class="diag-row">
                                            <span class="diag-label">Signals</span>
                                            <span class="diag-value diag-dim">no health sample yet</span>
                                        </div>
                                    }
                                </div>   @* end .diag-js-expanded *@
                            }
                        </div>
                    }
                </div>
            }
        </div>

        @RenderOutboundQualityControl(m)
        } @* end Outbound tab *@

        @if (_activeTab == Tab.Inbound) {
        <div class="diag-section">
            <div class="diag-section-header">Present rate (all video surfaces)</div>
            @if (_presentRate is { } rate) {
                <div class="diag-row">
                    <span class="diag-label">Union display slots</span>
                    @if (rate.VideoCount == 0 && rate.UnobservableCount > 0) {
                        <span class="diag-value diag-dim">n/a</span>
                    } else {
                        <span class="diag-value">@rate.SlotsPerSec.ToString("0.#")/s</span>
                    }
                </div>
                @if (rate.VideoCount > 0) {
                    <div class="diag-row diag-sub">
                        <span class="diag-label">frames presented</span>
                        <span class="diag-value diag-dim">@rate.PresentsPerSec.ToString("0.#")/s across @rate.VideoCount video(s)</span>
                    </div>
                }
                @if (rate.UnobservableCount > 0) {
                    <div class="diag-row diag-sub">
                        <span class="diag-label">not measurable</span>
                        <span class="diag-value diag-dim">@rate.UnobservableCount video(s) — canvas backend or no rVFC</span>
                    </div>
                }
            } else {
                <div class="diag-row">
                    <span class="diag-label">Union display slots</span>
                    <span class="diag-value diag-dim">collecting…</span>
                </div>
            }
        </div>
        <div class="diag-section">
            @{
                var clock = ClockStats.Current;
            }
            <div class="diag-section-header">Clock sync</div>
            <div class="diag-row">
                <span class="diag-label">Offset (JS, used by sync)</span>
                <span class="diag-value">@FormatOffsetMs(_jsServerClockOffsetMs)</span>
            </div>
            <div class="diag-row diag-sub">
                <span class="diag-label">source (C#)</span>
                <span class="diag-value diag-dim">@FormatSignedMs(clock.Offset)</span>
            </div>
            <div class="diag-row">
                <span class="diag-label">Precision</span>
                <span class="diag-value">±@FormatMs(clock.Precision)</span>
            </div>
            <div class="diag-row">
                <span class="diag-label">RTT (ema / last)</span>
                <span class="diag-value">@FormatMs(clock.RttEma) / @FormatMs(clock.LastRtt)</span>
            </div>
            <div class="diag-row">
                <span class="diag-label">Last sync</span>
                <span class="diag-value">@FormatSyncAge(clock)</span>
            </div>
        </div>
        @* Active streams *@
        <div class="diag-section">
            <div class="diag-section-header">
                Streams
                <span class="diag-badge">@m.Streams.Count(s => !s.IsOwn)</span>
                @if (m.MemberCount > 0) {
                    <span class="diag-dim ml-2">(@m.MemberCount members)</span>
                }
            </div>
            @{
                var inboundStreams = m.Streams.Where(s => !s.IsOwn).ToArray();
            }
            @if (inboundStreams.Length == 0) {
                <div class="diag-row">
                    <span class="diag-dim">No inbound streams</span>
                </div>
            } else {
                @foreach (var s in inboundStreams) {
                    var sid = s.Info.StreamId.Value;
                    var hasDiag = _streamDiags.TryGetValue(sid, out var rdPeek)
                        && rdPeek.ValueKind == JsonValueKind.Object;
                    var peekBitrate = hasDiag ? GetNum(rdPeek, "bitrateKbps") : 0;
                    var liveCodec = hasDiag ? GetStr(rdPeek, "codec") : "";
                    var liveCodecCategory = hasDiag ? GetStr(rdPeek, "codecCategory") : "";
                    var displayCodec = !string.IsNullOrEmpty(liveCodec) ? liveCodec : s.Info.Format.Codec;
                    JsonElement? fwdEl = hasDiag
                        && rdPeek.TryGetProperty("forwarded", out var fwd)
                        && fwd.ValueKind == JsonValueKind.Object
                        ? fwd
                        : null;
                    int? activeLayerId = null;
                    var activeWidth = 0;
                    var activeHeight = 0;
                    var observedMaxLayerId = -1;
                    if (fwdEl is { } fActive && GetNum(fActive, "ForwardedLayerId") >= 0) {
                        activeLayerId = (int)GetNum(fActive, "ForwardedLayerId");
                        activeWidth = (int)GetNum(fActive, "ForwardedWidth");
                        activeHeight = (int)GetNum(fActive, "ForwardedHeight");
                        observedMaxLayerId = (int)GetNum(fActive, "ObservedMaxLayerId");
                    }
                    var ageSec = hasDiag ? GetNum(rdPeek, "streamAgeMs") / 1000 : 0;

                    <div class="diag-stream">
                        <div class="diag-stream-header">
                            <span>@s.Info.StreamId</span>
                            <span class="diag-source-kind ml-auto">@s.Info.SourceKind</span>
                        </div>
                        <div class="diag-row">
                            <span class="diag-label">Author</span>
                            <span class="diag-value">@s.Author</span>
                        </div>
                        <div class="diag-row">
                            <span class="diag-label">Codec</span>
                            <span class="diag-value">
                                @displayCodec
                                @if (!string.IsNullOrEmpty(liveCodecCategory)) {
                                    <text> (@liveCodecCategory)</text>
                                }
                            </span>
                        </div>
                        <div class="diag-row">
                            <span class="diag-label">Resolution</span>
                            <span class="diag-value">
                                @if (activeLayerId is { } activeId) {
                                    var depth = Math.Max(observedMaxLayerId, activeId) + 1;
                                    var tierIdx = CanonicalTierIndex(s.Info.SourceKind, activeWidth, activeHeight);
                                    var tierText = tierIdx is { } t ? $" (tier L{t})" : "";
                                    @($"L{activeId}/{depth} {activeWidth}×{activeHeight}{tierText}")
                                }
                                else {
                                    <span class="diag-dim">no frame yet</span>
                                }
                            </span>
                        </div>

                        @if (hasDiag) {
                            <div class="diag-row">
                                <span class="diag-label">Requested</span>
                                <span class="diag-value">@FormatRequestedReceiveQuality(rdPeek)</span>
                            </div>
                        }

                        @if (Hub.VideoQualityUI.InboundDemandByStream.TryGetValue(s.Info.StreamId, out var demand)) {
                            <div class="diag-row">
                                <span class="diag-label">Demand</span>
                                <span class="diag-value">@FormatInboundDemand(demand)</span>
                            </div>
                            <div class="diag-row diag-sub">
                                <span class="diag-label">cap binding</span>
                                <span class="diag-value diag-dim">@demand.CapTag</span>
                            </div>
                        }

                        @if (peekBitrate > 0) {
                            <div class="diag-row">
                                <span class="diag-label">Incoming bitrate</span>
                                <span class="diag-value">@(peekBitrate.ToString("0")) kbps</span>
                            </div>
                        }

                        @if (ageSec > 0) {
                            <div class="diag-row">
                                <span class="diag-label">Duration</span>
                                <span class="diag-value">@(ageSec.ToString("0"))s</span>
                            </div>
                        }

                        @if (_throughputDelta.TryGetValue(sid, out var inDelta)) {
                            var isExpanded = _throughputExpanded.Contains(sid);
                            <div class="diag-row diag-clickable" role="button" tabindex="0" @onclick="@(() => OnToggleThroughputExpanded(sid))">
                                <span class="diag-label">Throughput</span>
                                <span class="diag-value">
                                    @($"{inDelta.Fps:0} fps · {inDelta.Kbps:0} kbps")
                                    <span class="diag-expand-indicator">@GetShowDetailsIndicator(isExpanded)</span>
                                </span>
                            </div>
                            @if (isExpanded) {
                                @RenderDropBreakdown(inDelta)
                            }
                        }

                        @if (_displayRateByStream.TryGetValue(sid, out var displayRate)) {
                            @* rVFC-measured distinct display slots — what the eye sees.
                               Throughput above is the MSTG WRITE rate: bursty writes
                               coalesce at the compositor, so it can read 30 while
                               the display shows far fewer distinct frames. *@
                            <div class="diag-row">
                                <span class="diag-label">Display rate</span>
                                <span class="diag-value">@displayRate.ToString("0.#")/s</span>
                            </div>
                        }

                        @if (Hub.VideoQualityUI.InboundDecoderHealthByStream.TryGetValue(s.Info.StreamId, out var decoderHealth)
                            && decoderHealth.Verdict != HealthVerdict.Unknown) {
                            <div class="diag-group-header">Decoder</div>
                            <div class="diag-row">
                                <span class="diag-label">Verdict</span>
                                <span class="diag-value">@FormatVerdict(decoderHealth.Verdict)</span>
                            </div>
                            <div class="diag-row">
                                <span class="diag-label">Signals</span>
                                <span class="diag-value multiline">@FormatDecoderHealth(decoderHealth)</span>
                            </div>
                            @if (hasDiag) {
                                <div class="diag-row">
                                    <span class="diag-label">Queues</span>
                                    <span class="diag-value">enc @(GetNum(rdPeek, "bufferSize").ToString("0")) frames · decoder @(GetNested(rdPeek, "decoderStats", "decoderQueueSize").ToString("0")) in-flight</span>
                                </div>
                            }
                        }

                        @{
                            var authorId = s.Info.AuthorId;
                            var lag = LagTracker.GetSnapshot(authorId);
                        }
                        <div class="diag-group-header">A/V Sync</div>
                        <div class="diag-row">
                            <span class="diag-label">Audio lag</span>
                            <span class="diag-value">@FormatLag(lag.AudioLag) (fresh @lag.FreshAudioStreamCount, stale @lag.StaleAudioStreamCount)</span>
                        </div>
                        <div class="diag-row diag-sub">
                            <span class="diag-label">audio in</span>
                            <span class="diag-value diag-dim">@FormatAudioInputs(lag.AudioInputs)</span>
                        </div>
                        <div class="diag-row">
                            <span class="diag-label">Video lag</span>
                            <span class="diag-value">@FormatLag(lag.VideoLag) (fresh @lag.FreshVideoStreamCount, stale @lag.StaleVideoStreamCount)</span>
                        </div>
                        <div class="diag-row diag-sub">
                            <span class="diag-label">video in</span>
                            <span class="diag-value diag-dim">@FormatVideoInputs(lag.VideoInputs)</span>
                        </div>
                        <div class="diag-row">
                            <span class="diag-label">Peer clock skew</span>
                            <span class="diag-value">@FormatPeerSkew(s.Info)</span>
                        </div>
                        <div class="diag-row">
                            <span class="diag-label">Drift</span>
                            <span class="diag-value">@FormatDrift(lag.AudioLag, lag.VideoLag)</span>
                        </div>
                        <div class="diag-row diag-sub">
                            <span class="diag-label">ctrl drift</span>
                            <span class="diag-value diag-dim">@FormatControllableDrift(lag)</span>
                        </div>
                    </div>
                }
            }
        </div>
        @RenderInboundQualityControl()
        } @* end Inbound tab *@

        @if (_activeTab == Tab.Settings && m.ShowSettingsTab) {
            <div class="diag-section">
                <div class="diag-section-header">Overlays</div>
                <Tile>
                    <TileItem Click="@OnShowFpsOverlayClick">
                        <Content>Show FPS overlay on tiles</Content>
                        <Caption>
                            Renders a small per-tile FPS readout in the corner of
                            every video tile. Updates at 1 Hz; hidden automatically
                            on tiles that are currently showing an error.
                        </Caption>
                        <Right>
                            <div class="pointer-events-none">
                                <Toggle IsChecked="@_showFpsOverlay"/>
                            </div>
                        </Right>
                    </TileItem>
                </Tile>
            </div>
            <div class="diag-section">
                <div class="diag-section-header">Codec selection</div>
                <Tile>
                    <TileItem Click="@OnForceH264OnlyClick">
                        <Content>Force H.264 (AVC) only</Content>
                        <Caption>
                            Restrict codec detection to H.264 (AVC). AV1, HEVC and VP9
                            are excluded for both encoder and decoder. Useful for
                            reproducing AVC-only behaviour. Takes effect on the next
                            stream — toggle, then re-join the call.
                        </Caption>
                        <Right>
                            <div class="pointer-events-none">
                                <Toggle IsChecked="@_forceH264Only"/>
                            </div>
                        </Right>
                    </TileItem>
                </Tile>
            </div>
            <div class="diag-section">
                <div class="diag-section-header">Sender pipeline</div>
                <Tile>
                    <TileItem IsHoverable="false">
                        <Content>Downscaler backend</Content>
                        <Caption>
                            Backend that resizes captured frames into the simulcast
                            ladder. <b>WebGL</b> = GPU cascade (Canvas2D fallback);
                            <b>Canvas2D</b> = 2D cascade; <b>Metadata</b> = cheap
                            display-size wrap (HW encoder rescales — reproduces the
                            Edge HEVC lower-tier crop, comparison only);
                            <b>WebGPU</b> = experimental per-tier NV12 readback to
                            CPU frames (Chromium only — skips the encoder's internal
                            full-res readback). Applies on the next pipeline
                            restart — switch, then re-join the call.
                        </Caption>
                        <Right>
                            <select class="diag-select"
                                    value="@_downscalerMode"
                                    @onchange="@OnDownscalerModeChange">
                                <option value="webgl">WebGL</option>
                                <option value="canvas">Canvas2D</option>
                                <option value="metadata">Metadata</option>
                                <option value="webgpu">WebGPU (CPU NV12)</option>
                            </select>
                        </Right>
                    </TileItem>
                    <TileItem IsHoverable="false">
                        <Content>Capture fps override</Content>
                        <Caption>
                            Pins the camera capture rate, bypassing the demand-driven
                            follower (which sheds to 15 fps when every viewer shows a
                            thumbnail). Renegotiates the live track — applies
                            immediately, no re-join needed. <b>Auto</b> restores
                            demand-driven pacing. Cameras snap to the nearest
                            supported mode (Android is typically 15/30).
                        </Caption>
                        <Right>
                            <select class="diag-select"
                                    value="@(_captureFpsOverride?.ToString() ?? "")"
                                    @onchange="@OnCaptureFpsOverrideChange">
                                <option value="">Auto</option>
                                @foreach (var fps in CaptureFpsOptions) {
                                    <option value="@fps">@fps fps</option>
                                }
                            </select>
                        </Right>
                    </TileItem>
                </Tile>
            </div>
            <div class="diag-section">
                <div class="diag-section-header">Quality control</div>
                <Tile>
                    <TileItem IsHoverable="false">
                        <Content>Outbound layer cap</Content>
                        <Caption>Caps the recording quality controller for your own camera stream.</Caption>
                        <Right>
                            <select class="diag-select"
                                    value="@FormatLayerCount(_maxOutboundLayerCount)"
                                    @onchange="@OnMaxOutboundLayerCountChange">
                                <option value="">Default</option>
                                <option value="1">Up to 1</option>
                                <option value="2">Up to 2</option>
                                <option value="3">Up to 3</option>
                            </select>
                        </Right>
                    </TileItem>
                    <TileItem IsHoverable="false">
                        <Content>Inbound layer cap</Content>
                        <Caption>Caps the playback quality controller requests for active remote streams.</Caption>
                        <Right>
                            <select class="diag-select"
                                    value="@FormatLayerCount(_maxInboundLayerCount)"
                                    @onchange="@OnMaxInboundLayerCountChange">
                                <option value="">Default</option>
                                <option value="1">Up to 1</option>
                                <option value="2">Up to 2</option>
                                <option value="3">Up to 3</option>
                            </select>
                        </Right>
                    </TileItem>
                    <TileItem IsHoverable="false">
                        <Content>Est. bandwidth multiplier</Content>
                        <Caption>Multiplies the AIMD-estimated capacity by this factor before the inbound allocator runs.</Caption>
                        <Right>
                            <select class="diag-select"
                                    value="@FormatBandwidthMultiplier(_estBandwidthMultiplier)"
                                    @onchange="@OnEstBandwidthMultiplierChange">
                                @foreach (var v in BandwidthMultiplierOptions) {
                                    <option value="@v.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)">@v.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)x</option>
                                }
                            </select>
                        </Right>
                    </TileItem>
                </Tile>
            </div>
        }
        </div> @* end .diag-body-content *@
    </Body>
</DialogFrame>

@code {
    private static readonly string JSCollectOwnMethod = $"{BlazorUIAppModule.ImportName}.collectOwnStreamDiagnostics";
    private static readonly string JSCollectRemoteMethod = $"{BlazorUIAppModule.ImportName}.collectRemoteStreamDiagnostics";
    private static readonly string JSCollectServerClockMethod = $"{BlazorUIAppModule.ImportName}.collectServerClockDiagnostics";
    private static readonly string JSCollectPresentRateMethod = $"{BlazorUIAppModule.ImportName}.collectPresentRate";

    private enum Tab { Inbound, Outbound, Settings }

    private Timer? _pollTimer;
    private readonly Dictionary<VideoSourceKind, JsonElement> _ownDiagByKind = new();
    private readonly Dictionary<VideoSourceKind, StreamDemandStats> _demandStatsByKind = new();
    private readonly Dictionary<string, JsonElement> _streamDiags = new();
    private double? _jsServerClockOffsetMs;
    private (double PresentsPerSec, double SlotsPerSec, int VideoCount, int UnobservableCount)? _presentRate;
    private readonly Dictionary<string, double> _displayRateByStream = new();
    private bool _isDisposed;
    private bool _showOwnStreamingDetails;
    private Tab _activeTab = Tab.Inbound;
    private readonly Dictionary<VideoSourceKind, int> _selectedOwnLayerIdByKind = new();
    // Per-target rates + cumulative drop totals, mirrored verbatim from the
    // JS-side diagnostics JSON. Rates are pre-computed at the recorder-tick /
    // latency-tap boundary so the modal never has to derive them from a
    // poll-interval delta (the source of the 13/27 fps alternation bug).
    private readonly Dictionary<string, ThroughputSnapshot> _throughputDelta = new();
    private readonly HashSet<string> _throughputExpanded = new();
    private static string OwnThroughputKey(VideoSourceKind kind) => $"__own__/{(int)kind}";

    private ElementReference? _copyTextSourceRef;

    private ChatVideoUI ChatVideoUI => Hub.ChatVideoUI;
    private IAuthors Authors => Hub.Authors;
    private PlaybackLagTracker LagTracker => field ??= Services.GetRequiredService<PlaybackLagTracker>();
    private ActualChat.UI.Blazor.Services.ServerClockSyncStats ClockStats
        => field ??= Services.GetRequiredService<ActualChat.UI.Blazor.Services.ServerClockSyncStats>();
    private ILogger Log => field ??= Services.LogFor<VideoDiagnosticsModal>();

    [CascadingParameter] public Modal Modal { get; set; } = null!;
    [Parameter] public Model ModalModel { get; set; } = null!;

    public override async ValueTask DisposeAsync() {
        _isDisposed = true;
        if (_pollTimer is not null)
            await _pollTimer.DisposeAsync();
        await base.DisposeAsync();
    }

    protected override void OnAfterRender(bool firstRender) {
        // ComputeState may surface remote streams asynchronously after first render.
        // Re-evaluate polling state on every render so the timer kicks in as soon as
        // streams appear and disposes when the list empties.
        EnsurePollingState();
        if (firstRender)
            _ = LoadSettings();
    }

    protected override ComputedState<ComputedModel>.Options GetStateOptions()
        => new() {
            InitialValue = ComputedModel.Empty,
            UpdateDelayer = FixedDelayer.NextTick,
            Category = GetStateCategory(GetType()),
        };

    protected override async Task<ComputedModel> ComputeState(CancellationToken cancellationToken) {
        var chatId = ModalModel.ChatId;

        var ownSourceKinds = await ChatVideoUI.GetOwnSourceKinds(chatId, cancellationToken).ConfigureAwait(false);
        var activeStreams = await ChatVideoUI.GetActiveVideoStreams(chatId, cancellationToken);
        var memberCount = activeStreams.Count > 0
            ? await ChatVideoUI.GetVideoStreamMemberCount(chatId, cancellationToken).ConfigureAwait(false)
            : 0;

        var ownAuthor = await Authors.GetOwn(Session, chatId, cancellationToken);

        // Resolve author names
        var streams = new StreamEntry[activeStreams.Count];
        for (var i = 0; i < activeStreams.Count; i++) {
            var info = activeStreams[i];
            var author = await Authors.Get(Session, chatId, info.AuthorId, cancellationToken);
            streams[i] = new StreamEntry(info, author?.Avatar.Name ?? info.AuthorId.Value, ownAuthor?.Id == info.AuthorId);
        }

        var account = await Hub.AccountUI.OwnAccount.Use(cancellationToken);
        var showSettingsTab = account.IsAdmin || Hub.HostInfo.IsDevelopmentInstance;
        return new ComputedModel(ownSourceKinds, streams, memberCount, showSettingsTab);
    }

    private void OnSelectTab(Tab tab) {
        if (_activeTab == tab)
            return;
        _activeTab = tab;
        StateHasChanged();
    }

    private static void AppendCeilingAndSignal(
        RenderTreeBuilder builder, int seqBase, ActualChat.Bandwidth.BandwidthEstimator bw)
    {
        var ceilingKbps = (bw.CeilingBps * 8 / 1000).ToString("0");
        var ceilingLabel = bw.HasSeenBadSignal
            ? ceilingKbps + " kbps"
            : "unknown (seed " + ceilingKbps + " kbps)";
        AppendRow(builder, seqBase + 0, "Ceiling", ceilingLabel);
        AppendRow(builder, seqBase + 1, "Current",
            (bw.LastCurrentBps * 8 / 1000).ToString("0") + " kbps");
        AppendRow(builder, seqBase + 2, "Signal",
            bw.LastSignalLevel.ToString("F2") + " (" + bw.LastVerdict + ")");
    }

    private static void AppendDecisionLog(
        RenderTreeBuilder builder, int seqBase,
        IReadOnlyCollection<VideoQualityUI.QualityDecisionEntry> entries,
        string labelA, string labelB)
    {
        builder.OpenElement(seqBase, "div");
        builder.AddAttribute(seqBase + 1, "class", "diag-group-header");
        builder.AddContent(seqBase + 2, "Decision log");
        builder.CloseElement();

        var i = 0;
        // Most recent first.
        foreach (var e in entries.Reverse()) {
            var rowClass = string.IsNullOrEmpty(e.CapChange)
                ? "diag-log-row"
                : "diag-log-row diag-log-row-action";
            builder.OpenElement(seqBase + 100 + i * 30, "div");
            builder.AddAttribute(seqBase + 101 + i * 30, "class", rowClass);

            // Line 1: time + swatches + cap change.
            builder.OpenElement(seqBase + 102 + i * 30, "div");
            builder.AddAttribute(seqBase + 103 + i * 30, "class", "diag-log-line");
            builder.OpenElement(seqBase + 104 + i * 30, "span");
            builder.AddAttribute(seqBase + 105 + i * 30, "class", "diag-log-time");
            builder.AddContent(seqBase + 106 + i * 30, e.At.ToDateTimeOffset().ToString("HH:mm:ss"));
            builder.CloseElement();

            builder.OpenElement(seqBase + 107 + i * 30, "span");
            builder.AddAttribute(seqBase + 108 + i * 30, "class", "diag-log-swatches");
            AppendSwatch(builder, seqBase + 109 + i * 30, labelA, e.SignalA);
            AppendSwatch(builder, seqBase + 113 + i * 30, labelB, e.SignalB);
            AppendBweSwatch(builder, seqBase + 117 + i * 30, "BW", e.BweVerdict);
            builder.CloseElement();

            builder.OpenElement(seqBase + 121 + i * 30, "span");
            builder.AddAttribute(seqBase + 122 + i * 30, "class",
                string.IsNullOrEmpty(e.CapChange) ? "diag-log-cap diag-dim" : "diag-log-cap");
            builder.AddContent(seqBase + 123 + i * 30,
                string.IsNullOrEmpty(e.CapChange) ? e.Reason : $"{e.CapChange} · {e.Reason}");
            builder.CloseElement();
            builder.CloseElement(); // diag-log-line

            // Lines 2..4: one subline per leg (A, B, BW). Skip empty ones.
            AppendSubline(builder, seqBase + 124 + i * 30, labelA, e.RawValuesA);
            AppendSubline(builder, seqBase + 127 + i * 30, labelB, e.RawValuesB);
            AppendSubline(builder, seqBase + 130 + i * 30, "bw", e.RawValuesBw);

            builder.CloseElement(); // diag-log-row
            i++;
        }
    }

    private static void AppendSubline(RenderTreeBuilder builder, int seqBase, string label, string rawValues)
    {
        if (string.IsNullOrEmpty(rawValues))
            return;

        builder.OpenElement(seqBase, "div");
        builder.AddAttribute(seqBase + 1, "class", "diag-log-subline diag-dim");
        builder.AddContent(seqBase + 2, $"{label.ToLowerInvariant()}: {rawValues}");
        builder.CloseElement();
    }

    private static void AppendSwatch(
        RenderTreeBuilder builder, int seqBase, string label, HealthVerdict verdict)
    {
        var cls = verdict switch {
            HealthVerdict.Good => "diag-log-swatch diag-chip-good",
            HealthVerdict.Marginal => "diag-log-swatch diag-chip-marginal",
            HealthVerdict.Bad => "diag-log-swatch diag-chip-bad",
            _ => "diag-log-swatch diag-chip-unknown",
        };
        builder.OpenElement(seqBase, "span");
        builder.AddAttribute(seqBase + 1, "class", cls);
        builder.AddAttribute(seqBase + 2, "title", $"{label}: {verdict}");
        builder.AddContent(seqBase + 3, $"{label}:{VerdictLetter(verdict)}");
        builder.CloseElement();
    }

    private static void AppendBweSwatch(
        RenderTreeBuilder builder, int seqBase, string label, BandwidthVerdict verdict)
    {
        var cls = verdict switch {
            BandwidthVerdict.Good => "diag-log-swatch diag-chip-good",
            BandwidthVerdict.Bad => "diag-log-swatch diag-chip-bad",
            _ => "diag-log-swatch diag-chip-unknown",
        };
        var letter = verdict switch {
            BandwidthVerdict.Good => "G",
            BandwidthVerdict.Bad => "B",
            _ => "·",
        };
        builder.OpenElement(seqBase, "span");
        builder.AddAttribute(seqBase + 1, "class", cls);
        builder.AddAttribute(seqBase + 2, "title", $"{label}: {verdict}");
        builder.AddContent(seqBase + 3, $"{label}:{letter}");
        builder.CloseElement();
    }

    private static string VerdictLetter(HealthVerdict v) => v switch {
        HealthVerdict.Good => "G",
        HealthVerdict.Marginal => "M",
        HealthVerdict.Bad => "B",
        _ => "·",
    };

    private static void AppendRow(RenderTreeBuilder builder, int seq, string label, string value)
    {
        builder.OpenElement(seq, "div");
        builder.AddAttribute(seq + 1, "class", "diag-row");
        builder.OpenElement(seq + 2, "span");
        builder.AddAttribute(seq + 3, "class", "diag-label");
        builder.AddContent(seq + 4, label);
        builder.CloseElement();
        builder.OpenElement(seq + 5, "span");
        builder.AddAttribute(seq + 6, "class", "diag-value");
        builder.AddContent(seq + 7, value);
        builder.CloseElement();
        builder.CloseElement();
    }

    private void OnToggleOwnStreamingDetails() {
        _showOwnStreamingDetails = !_showOwnStreamingDetails;
        EnsurePollingState();
        StateHasChanged();
    }

    private void EnsurePollingState() {
        // Poll whenever there's any active stream — outbound Source rows and the
        // per-inbound-stream Resolution / Codec / bitrate / Age rows all read live
        // values out of `_ownDiagByKind` / `_streamDiags`. Cheap: 1 JS call per stream
        // every 1s, aligned with the JS-side rate-computation cadence.
        var isOwnStreaming = State.Value.OwnSourceKinds.Count > 0;
        var hasRemoteStreams = State.Value.Streams.Any(s => !s.IsOwn);
        var needsPolling = isOwnStreaming || hasRemoteStreams;
        if (needsPolling) {
            _pollTimer ??= new Timer(_1 => _ = PollJsDiagnostics(), null, TimeSpan.Zero, TimeSpan.FromSeconds(1));
        } else {
            _pollTimer?.Dispose();
            _pollTimer = null;
            _ownDiagByKind.Clear();
            _streamDiags.Clear();
        }
    }

    private async Task PollJsDiagnostics() {
        if (_isDisposed) return;
        try {
            var clockDiag = await JS.InvokeAsync<JsonElement>(JSCollectServerClockMethod);
            if (clockDiag.ValueKind == JsonValueKind.Object && clockDiag.TryGetProperty("offsetMs", out var offEl)
                && offEl.ValueKind == JsonValueKind.Number)
                _jsServerClockOffsetMs = offEl.GetDouble();

            var presentRate = await JS.InvokeAsync<JsonElement>(JSCollectPresentRateMethod);
            if (presentRate.ValueKind == JsonValueKind.Object
                && presentRate.TryGetProperty("presentsPerSec", out var presentsEl)
                && presentRate.TryGetProperty("slotsPerSec", out var slotsEl)
                && presentRate.TryGetProperty("videoCount", out var videosEl)) {
                var unobservable = presentRate.TryGetProperty("unobservableCount", out var unobservedEl)
                    && unobservedEl.ValueKind == JsonValueKind.Number
                    ? unobservedEl.GetInt32()
                    : 0;
                _presentRate = (presentsEl.GetDouble(), slotsEl.GetDouble(), videosEl.GetInt32(), unobservable);
                _displayRateByStream.Clear();
                if (presentRate.TryGetProperty("slotsPerSecByStream", out var byStreamEl)
                    && byStreamEl.ValueKind == JsonValueKind.Object)
                    foreach (var prop in byStreamEl.EnumerateObject())
                        if (prop.Value.ValueKind == JsonValueKind.Number)
                            _displayRateByStream[prop.Name] = prop.Value.GetDouble();
            }

            // Poll every active outbound source kind — both camera and
            // screencast streams can be live simultaneously, each with its
            // own recorder and throughput row.
            foreach (var sourceKind in State.Value.OwnSourceKinds) {
                var diag = await JS.InvokeAsync<JsonElement>(JSCollectOwnMethod, (int)sourceKind);
                if (diag.ValueKind != JsonValueKind.Object) continue;
                _ownDiagByKind[sourceKind] = diag;
                if (diag.TryGetProperty("stream", out var ownStream)
                    && BuildOwnThroughputSnapshot(ownStream) is { } ownSnap)
                    _throughputDelta[OwnThroughputKey(sourceKind)] = ownSnap;
            }

            foreach (var entry in State.Value.Streams) {
                if (entry.IsOwn) {
                    // Demand provenance is pull-only by design (see StreamDemandStats) —
                    // fetched here instead of subscribing so the counters' churn can't
                    // drive invalidations. Old servers throw → row shows "no aggregate".
                    try {
                        _demandStatsByKind[entry.Info.SourceKind] = await Hub.LiveVideoStreams
                            .GetDemandStats(Session, entry.Info.StreamId, CancellationToken.None);
                    } catch {
                        _demandStatsByKind.Remove(entry.Info.SourceKind);
                    }
                    continue;
                }

                var streamId = entry.Info.StreamId.Value;
                var diag = await JS.InvokeAsync<JsonElement>(JSCollectRemoteMethod, streamId);
                if (diag.ValueKind == JsonValueKind.Object) {
                    _streamDiags[streamId] = diag;
                    if (BuildRemoteThroughputSnapshot(diag) is { } snap)
                        _throughputDelta[streamId] = snap;
                }
            }

            await InvokeAsync(StateHasChanged);
        } catch {
            // Ignore errors during polling (component may be disposed)
        }
    }

    private static string GetStr(JsonElement el, string prop)
        => el.TryGetProperty(prop, out var v) && v.ValueKind == JsonValueKind.String ? v.GetString() ?? "" : "";

    private static double GetNum(JsonElement el, string prop)
        => el.TryGetProperty(prop, out var v) && v.ValueKind == JsonValueKind.Number ? v.GetDouble() : 0;

    private static double GetNested(JsonElement el, string obj, string prop)
        => el.TryGetProperty(obj, out var o) && o.ValueKind == JsonValueKind.Object ? GetNum(o, prop) : 0;

    private static bool GetBool(JsonElement el, string prop)
        => el.TryGetProperty(prop, out var v) && v.ValueKind is JsonValueKind.True or JsonValueKind.False && v.GetBoolean();

    private static JsonElement[] GetArray(JsonElement el, string prop)
        => el.TryGetProperty(prop, out var v) && v.ValueKind == JsonValueKind.Array
            ? v.EnumerateArray().ToArray()
            : [];

    private static int GetLayerId(JsonElement layer)
        => (int)GetNum(layer, "layerId");

    private JsonElement? SelectOwnLayer(VideoSourceKind kind, JsonElement[] layers) {
        if (layers.Length == 0)
            return null;
        if (_selectedOwnLayerIdByKind.TryGetValue(kind, out var selected)) {
            foreach (var layer in layers)
                if (GetLayerId(layer) == selected)
                    return layer;
        }
        return layers[^1];
    }

    private void OnSelectOwnLayer(VideoSourceKind kind, int layerId) {
        _selectedOwnLayerIdByKind[kind] = layerId;
        StateHasChanged();
    }

    private static string GetStrArray(JsonElement el, string prop) {
        if (!el.TryGetProperty(prop, out var v) || v.ValueKind != JsonValueKind.Array)
            return "";
        return string.Join(", ", v.EnumerateArray().Select(x => x.GetString()));
    }

    private static string FormatRequestedReceiveQuality(JsonElement rd) {
        var senderMax = -1;
        if (rd.TryGetProperty("forwarded", out var fwd) && fwd.ValueKind == JsonValueKind.Object)
            senderMax = (int)GetNum(fwd, "ObservedMaxLayerId");
        var senderMaxText = senderMax >= 0 ? $" (sender max L{senderMax})" : "";

        if (!rd.TryGetProperty("requestedReceiveQuality", out var requested)
            || requested.ValueKind != JsonValueKind.Object)
            return $"default (L1){senderMaxText}";

        return FormatRequestedLayerId((int)GetNum(requested, "layerId")) + senderMaxText;
    }

    private static int? CanonicalTierIndex(VideoSourceKind kind, int width, int height) {
        if (width <= 0 || height <= 0)
            return null;
        var layers = VideoLayerDef.ListFor(kind);
        var longSide = Math.Max(width, height);
        int? result = null;
        for (var i = 0; i < layers.Length; i++)
            if (layers[i].Width <= longSide)
                result = i;
        return result;
    }

    private static string FormatRecordingQualityState(VideoQualityUI.RecordingQualitySnapshot snapshot)
        => snapshot.State is { } state
            ? $"target={state.TargetLayerCount}, effective={state.EffectiveLayerCount}"
            : "no controller state yet";

    private static string FormatRecordingCaps(VideoQualityUI.RecordingQualitySnapshot s) {
        var binding = s.EncodeCapLayers <= s.BandwidthCapLayers ? "encode" : "bandwidth";
        return $"enc={s.EncodeCapLayers} (g{s.EncodeGoodStreak}/b{s.EncodeBadStreak}), "
            + $"bw={s.BandwidthCapLayers} (+{s.BwPositiveStreak}/-{s.BwNegativeStreak}) · binding={binding}";
    }

    private static string FormatRecordingBandwidth(VideoQualityUI.RecordingQualitySnapshot s)
        => $"ceiling={s.CeilingKbps:0} kbps, current={s.CurrentKbps:0} kbps";

    private static bool ShouldShowRecordingAction(RecordingQualityReason reason)
        => reason != RecordingQualityReason.Stable;

    // Verdict inputs only — must mirror RecordingClassifier.Classify.
    private static string FormatRecordingSignals(RecorderStats stats)
        => $"encDeficit={(stats.EncodeDeficitEma * 100):F1}%, "
            + $"encQueueDepth={stats.EncodeQueueDepthEma:F2}, "
            + $"ackAge={FormatAckAge(stats.LastAckAgeMs)}, "
            + $"minRtt={FormatAckAge(stats.WireMinRttMs)}, "
            + $"ringDepth={stats.WireRingDepthEma:F1}, "
            + $"dropRatioEma={stats.SenderFrameDropRatioEma:F2}, "
            + $"connected={(stats.IsConnected ? "yes" : "no")}";

    private static string FormatAckAge(double ageMs)
        => ageMs >= 0 ? $"{ageMs:0}ms" : "n/a";

    private static double EstimatedLayerKbps(VideoSourceKind? sourceKind, int layerId, string codec) {
        if (sourceKind is not { } kind || string.IsNullOrEmpty(codec))
            return 0;
        var layers = VideoLayerDef.ListFor(kind);
        if ((uint)layerId >= (uint)layers.Length)
            return 0;
        return layers[layerId].GetBitrateKbps(codec);
    }

    private static string FormatRequestedLayerId(int value)
        => value == int.MaxValue ? "LMax" : $"L{Math.Max(0, value)}";

    private static string SignalText(int signal)
        => signal switch {
            < 0 => $"{signal} (bad)",
            > 0 => $"+{signal} (good)",
            _ => "0 (neutral)",
        };

    private static string FormatVerdict(HealthVerdict v) => v switch {
        HealthVerdict.Good => "Good (G)",
        HealthVerdict.Marginal => "Marginal (M)",
        HealthVerdict.Bad => "Bad (B)",
        _ => "Unknown",
    };

    private static string FormatDecoderHealth(DecoderHealth h)
        => $"decRatio={h.DecodeRatioEma:F2}, decDeficit={h.DecodeDeficitEma * 100:F1}%, "
            + $"hang/60s={h.HangRateIn60s}, recovery={h.RecoveryStreak}, "
            + $"presentSkip={h.PresentSkipRatio * 100:F1}%, pathDrop={h.ReceiverDecodePathDropRatio * 100:F1}%";

    private static string FormatAudioInputs(LagInputs i)
        => i.AnchorMs <= 0 ? "—" : $"rec={i.AnchorMs:F0} buf={i.LookaheadMs:F0}ms out={i.DeviceLatencyMs:F0}ms";

    private static string FormatVideoInputs(LagInputs i)
        => i.AnchorMs <= 0 ? "—" : $"up={i.UplinkMs:F0}ms rx={i.RxMs:F0}ms buf={i.LookaheadMs:F0}ms tap={i.DeviceLatencyMs:F0}ms";

    private static string FormatLag(TimeSpan? lag)
        => lag is null ? "—" : $"{lag.Value.TotalMilliseconds:+0;-0;0} ms";

    private static string FormatDrift(TimeSpan? audio, TimeSpan? video)
        => audio is null || video is null
            ? "—"
            : $"{(audio.Value - video.Value).TotalMilliseconds:+0;-0;0} ms";

    // Loopback/LAN round-trips are sub-millisecond, so fall back to µs to avoid showing "0 ms".
    private static string FormatMs(TimeSpan value)
    {
        var ms = value.TotalMilliseconds;
        return Math.Abs(ms) < 1 ? $"{ms * 1000:0} µs" : $"{ms:0.##} ms";
    }

    private static string FormatSignedMs(TimeSpan value)
    {
        var ms = value.TotalMilliseconds;
        return Math.Abs(ms) < 1 ? $"{ms * 1000:+0;-0;0} µs" : $"{ms:+0.##;-0.##;0} ms";
    }

    private static string FormatOffsetMs(double? ms)
        => ms is null
            ? "—"
            : Math.Abs(ms.Value) < 1 ? $"{ms.Value * 1000:+0;-0;0} µs" : $"{ms.Value:+0.##;-0.##;0} ms";

    private string FormatSyncAge(ActualChat.UI.Blazor.Services.ServerClockSyncStats.Snapshot clock)
        => clock.SyncCount == 0
            ? "never"
            : $"{(Hub.Clocks.CpuClock.Now - clock.LastSyncAt).TotalSeconds:0}s ago";

    private static string FormatInboundDemand(VideoQualityUI.InboundDemand demand)
    {
        // The render size is what picks the layer, so it's the first thing to
        // check when a stream sits lower than expected: a small tile asking for
        // L0 is correct, a large one asking for L0 is the bug.
        var layer = Math.Max(0, demand.RequestedLayerCount - 1);
        if (demand.RenderCssLongSide <= 0)
            return $"L{layer} ({demand.DesiredSize}, no render size yet)";

        var devicePx = demand.RenderCssLongSide * Math.Max(1, demand.RenderDevicePixelRatio);
        return $"L{layer} ({demand.DesiredSize}) ← tile {demand.RenderCssLongSide:0}css"
            + $" @{Math.Max(1, demand.RenderDevicePixelRatio):0.#}x = {devicePx:0}px";
    }

    private static string FormatPeerSkew(VideoStreamInfo info)
    {
        // Server-measured at registration. Don't derive this from
        // SourceStartedAt - StartedAt: those are equal unless the server's
        // gross-skew guard trips, so that difference reads 0 for every skew
        // small enough to still poison the lag numbers.
        if (info.SourceStartedAt == default || info.StartedAt == default)
            return "—";
        if (info.SourceClockDeltaMs is not { } deltaMs)
            return "—";

        return $"≤ {deltaMs:+0;-0;0} ms";
    }

    // Drift with the uncontrollable output-device latencies removed from both
    // sides — the portion the catch-up policy can actually affect.
    private static string FormatControllableDrift(PlaybackLagSnapshot lag)
    {
        if (lag.AudioLag is not { } a || lag.VideoLag is not { } v)
            return "—";
        var audioCtl = a.TotalMilliseconds - lag.AudioInputs.DeviceLatencyMs;
        var videoCtl = v.TotalMilliseconds - lag.VideoInputs.DeviceLatencyMs;
        return $"{audioCtl - videoCtl:+0;-0;0} ms";
    }

    private string GetShowDetailsIndicator(bool show)
        => show ? ">---<" : "<->";

    // Nested types

    public sealed class Model(ChatId chatId)
    {
        public ChatId ChatId { get; } = chatId;
    }

    public sealed record StreamEntry(VideoStreamInfo Info, string Author, bool IsOwn = false);

    public sealed record ComputedModel(
        IReadOnlyList<VideoSourceKind> OwnSourceKinds,
        StreamEntry[] Streams,
        int MemberCount,
        bool ShowSettingsTab
    ) {
        public static readonly ComputedModel Empty = new([], [], 0, false);
    }

    // Snapshot of pre-computed rates + cumulative drop totals for one target.
    // All rate fields are computed JS-side at the recorder-tick (sender) or
    // latency-tap (receiver) boundary, then surfaced verbatim — the modal
    // never derives rates from its own poll interval, which is what caused
    // the 13/27 fps alternation against the 1.5s modal-poll cadence.
    private sealed record ThroughputSnapshot(
        double Fps,
        double Kbps,
        IReadOnlyDictionary<FrameDropStage, double> DropPerSec,
        IReadOnlyDictionary<FrameDropStage, int> DropTotal);

    private void OnToggleThroughputExpanded(string key) {
        if (!_throughputExpanded.Add(key))
            _throughputExpanded.Remove(key);
    }

    private RenderFragment RenderDropBreakdown(ThroughputSnapshot s) => builder => {
        // Show every stage that has a non-zero lifetime total OR a current
        // drop rate — sorted by enum value to preserve sender → server →
        // receiver ordering.
        var stages = s.DropTotal.Keys.Union(s.DropPerSec.Keys)
            .OrderBy(stage => (byte)stage)
            .ToArray();
        if (stages.Length == 0) {
            builder.OpenElement(0, "div");
            builder.AddAttribute(1, "class", "diag-row");
            builder.OpenElement(2, "span");
            builder.AddAttribute(3, "class", "diag-label");
            builder.AddContent(4, "Drops");
            builder.CloseElement();
            builder.OpenElement(5, "span");
            builder.AddAttribute(6, "class", "diag-value diag-dim");
            builder.AddContent(7, "none");
            builder.CloseElement();
            builder.CloseElement();
            return;
        }
        var seq = 0;
        foreach (var stage in stages) {
            var total = s.DropTotal.TryGetValue(stage, out var t) ? t : 0L;
            var rate = s.DropPerSec.TryGetValue(stage, out var r) ? r : 0.0;
            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class", "diag-row diag-sub");
            builder.OpenElement(seq++, "span");
            builder.AddAttribute(seq++, "class", "diag-label");
            builder.AddContent(seq++, stage.ToString());
            builder.CloseElement();
            builder.OpenElement(seq++, "span");
            builder.AddAttribute(seq++, "class", "diag-value");
            builder.AddContent(seq++, rate > 0 ? $"{rate:0.#}/s (Σ {total})" : $"Σ {total}");
            builder.CloseElement();
            builder.CloseElement();
        }
    };

    private static ThroughputSnapshot? BuildOwnThroughputSnapshot(JsonElement stream) {
        if (stream.ValueKind != JsonValueKind.Object) return null;
        var fps = GetNum(stream, "bundlesPerSec");
        var kbps = GetNum(stream, "bytesPerSec") * 8.0 / 1000.0;
        return new ThroughputSnapshot(
            fps, kbps,
            ReadDropRateMap(stream, "dropTracePerSecByStage"),
            ReadDropTotalMap(stream, "dropTraceByStage"));
    }

    private static ThroughputSnapshot? BuildRemoteThroughputSnapshot(JsonElement diag) {
        if (diag.ValueKind != JsonValueKind.Object) return null;
        var fps = GetNum(diag, "presentedPerSec");
        var kbps = GetNum(diag, "bytesPerSec") * 8.0 / 1000.0;
        return new ThroughputSnapshot(
            fps, kbps,
            ReadDropRateMap(diag, "dropTracePerSecByStage"),
            ReadDropTotalMap(diag, "dropTraceByStage"));
    }

    private static IReadOnlyDictionary<FrameDropStage, int> ReadDropTotalMap(JsonElement el, string prop) {
        if (!el.TryGetProperty(prop, out var m) || m.ValueKind != JsonValueKind.Object)
            return EmptyDropTotal;
        var dict = new Dictionary<FrameDropStage, int>();
        foreach (var p in m.EnumerateObject()) {
            if (!int.TryParse(p.Name, out var stageNum)) continue;
            if (p.Value.ValueKind != JsonValueKind.Number) continue;
            dict[(FrameDropStage)stageNum] = p.Value.GetInt32();
        }
        return dict;
    }

    private static IReadOnlyDictionary<FrameDropStage, double> ReadDropRateMap(JsonElement el, string prop) {
        if (!el.TryGetProperty(prop, out var m) || m.ValueKind != JsonValueKind.Object)
            return EmptyDropRate;
        var dict = new Dictionary<FrameDropStage, double>();
        foreach (var p in m.EnumerateObject()) {
            if (!int.TryParse(p.Name, out var stageNum)) continue;
            if (p.Value.ValueKind != JsonValueKind.Number) continue;
            dict[(FrameDropStage)stageNum] = p.Value.GetDouble();
        }
        return dict;
    }

    private static readonly IReadOnlyDictionary<FrameDropStage, int> EmptyDropTotal
        = new Dictionary<FrameDropStage, int>();
    private static readonly IReadOnlyDictionary<FrameDropStage, double> EmptyDropRate
        = new Dictionary<FrameDropStage, double>();
}
