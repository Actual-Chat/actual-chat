@namespace ActualChat.UI.Blazor.App.Components.VideoPanel
@using ActualChat.UI.Blazor.App.Module
@inherits ComponentBase<AppUIHub>
@implements IModalView<VideoDiagnosticsSettingsModal.Model>

<DialogFrame
    Class="video-diagnostics-modal"
    Title="Video Debug Settings"
    NarrowViewSettings="@DialogFrameNarrowViewSettings.Default"
    HasCloseButton="true">
    <Body>
        <div class="diag-section">
            <div class="diag-section-header">Codec selection</div>
            <Tile>
                <TileItem Click="@OnForceH264OnlyClick">
                    <Content>Force H.264 (AVC) only</Content>
                    <Caption>
                        Restrict codec detection to H.264 (AVC). AV1, HEVC and VP9
                        are excluded for both encoder and decoder. Useful for
                        reproducing AVC-only behaviour. Takes effect on the next
                        stream — toggle, then re-join the call.
                    </Caption>
                    <Right>
                        <Toggle IsChecked="@_forceH264Only"/>
                    </Right>
                </TileItem>
            </Tile>
            <div class="diag-row diag-dim">
                <span class="diag-label">Storage key</span>
                <span class="diag-value">localStorage["video.debug.forceH264Only"]</span>
            </div>
        </div>
        <div class="diag-section">
            <div class="diag-section-header">Quality control</div>
            <Tile>
                <TileItem IsHoverable="false">
                    <Content>Outbound layer cap</Content>
                    <Caption>
                        Caps the recording quality controller for your own webcam stream.
                        Default leaves the controller uncapped.
                    </Caption>
                    <Right>
                        <select
                            class="diag-select"
                            value="@FormatLayerCount(_maxOutboundLayerCount)"
                            @onchange="@OnMaxOutboundLayerCountChange">
                            <option value="">Default</option>
                            <option value="1">Up to 1</option>
                            <option value="2">Up to 2</option>
                            <option value="3">Up to 3</option>
                        </select>
                    </Right>
                </TileItem>
                <TileItem IsHoverable="false">
                    <Content>Inbound layer cap</Content>
                    <Caption>
                        Caps the playback quality controller requests for active remote streams.
                        Default leaves the controller uncapped.
                    </Caption>
                    <Right>
                        <select
                            class="diag-select"
                            value="@FormatLayerCount(_maxInboundLayerCount)"
                            @onchange="@OnMaxInboundLayerCountChange">
                            <option value="">Default</option>
                            <option value="1">Up to 1</option>
                            <option value="2">Up to 2</option>
                            <option value="3">Up to 3</option>
                        </select>
                    </Right>
                </TileItem>
            </Tile>
            <div class="diag-row diag-dim">
                <span class="diag-label">Storage keys</span>
                <span class="diag-value multiline">
                    video.debug.maxOutboundLayerCount,
                    video.debug.maxInboundLayerCount
                </span>
            </div>
        </div>
        <div class="diag-section">
            <div class="diag-section-header">Playback override (global)</div>
            <div class="diag-row diag-dim">
                Forces ReceiveQuality on every remote stream. Off = server-driven
                (default). Degrade = base layer only. Keep = pin to the currently
                forwarded layer. Upgrade = top layer. Session-only; resets on reload.
            </div>
            <div class="diag-row">
                <span class="diag-label">Mode</span>
                <select
                    class="diag-select"
                    value="@_playbackOverride"
                    @onchange="@(e => OnPlaybackModeChanged(e.Value as string))">
                    <option value="Off">Off</option>
                    <option value="Degrade">Degrade</option>
                    <option value="Keep">Keep</option>
                    <option value="Upgrade">Upgrade</option>
                </select>
            </div>
        </div>
    </Body>
</DialogFrame>

@code {
    private static readonly string JSGetMethod = $"{BlazorUIAppModule.ImportName}.getVideoDebugSettings";
    private static readonly string JSSetForceH264OnlyMethod = $"{BlazorUIAppModule.ImportName}.setVideoDebugForceH264Only";
    private static readonly string JSSetMaxOutboundLayerCountMethod =
        $"{BlazorUIAppModule.ImportName}.setVideoDebugMaxOutboundLayerCount";
    private static readonly string JSSetMaxInboundLayerCountMethod =
        $"{BlazorUIAppModule.ImportName}.setVideoDebugMaxInboundLayerCount";
    private static readonly string JSCollectStreamHintsMethod =
        $"{BlazorUIAppModule.ImportName}.collectActiveStreamHints";

    private bool _forceH264Only;
    private int? _maxOutboundLayerCount;
    private int? _maxInboundLayerCount;
    private VideoQualityUI.PlaybackOverrideMode _playbackOverride = VideoQualityUI.PlaybackOverrideMode.Off;

    [CascadingParameter] public Modal Modal { get; set; } = null!;
    [Parameter] public Model ModalModel { get; set; } = null!;

    protected override async Task OnInitializedAsync() {
        var settings = await JS.InvokeAsync<VideoDebugSettings>(JSGetMethod);
        _forceH264Only = settings.ForceH264Only;
        _maxOutboundLayerCount = settings.MaxOutboundLayerCount;
        _maxInboundLayerCount = settings.MaxInboundLayerCount;
        await Hub.VideoQualityUI.SetDebugMaxRecordingLayerCount(_maxOutboundLayerCount, CancellationToken.None);
        await Hub.VideoQualityUI.SetDebugMaxPlaybackLayerCount(
            _maxInboundLayerCount,
            await CollectStreamHints(),
            CancellationToken.None);
        _playbackOverride = Hub.VideoQualityUI.PlaybackOverride;
    }

    private async Task OnForceH264OnlyClick() {
        _forceH264Only = !_forceH264Only;
        StateHasChanged();
        await JS.InvokeVoidAsync(JSSetForceH264OnlyMethod, _forceH264Only);
    }

    private async Task OnMaxOutboundLayerCountChange(ChangeEventArgs e) {
        _maxOutboundLayerCount = ParseLayerCount(e.Value?.ToString());
        await JS.InvokeVoidAsync(JSSetMaxOutboundLayerCountMethod, _maxOutboundLayerCount);
        await Hub.VideoQualityUI.SetDebugMaxRecordingLayerCount(_maxOutboundLayerCount, CancellationToken.None);
    }

    private async Task OnMaxInboundLayerCountChange(ChangeEventArgs e) {
        _maxInboundLayerCount = ParseLayerCount(e.Value?.ToString());
        await JS.InvokeVoidAsync(JSSetMaxInboundLayerCountMethod, _maxInboundLayerCount);
        await Hub.VideoQualityUI.SetDebugMaxPlaybackLayerCount(
            _maxInboundLayerCount,
            await CollectStreamHints(),
            CancellationToken.None);
    }

    private static string FormatLayerCount(int? layerCount)
        => layerCount?.ToString() ?? "";

    private static int? ParseLayerCount(string? value)
        => int.TryParse(value, out var layerCount) && layerCount is >= 1 and <= 3
            ? layerCount
            : null;

    private async Task OnPlaybackModeChanged(string? value) {
        if (!Enum.TryParse<VideoQualityUI.PlaybackOverrideMode>(value, out var mode))
            mode = VideoQualityUI.PlaybackOverrideMode.Off;
        _playbackOverride = mode;
        StateHasChanged();
        var hints = await CollectStreamHints();
        await Hub.VideoQualityUI.SetPlaybackOverride(mode, hints, CancellationToken.None);
    }

    private async Task<IReadOnlyList<VideoQualityUI.PlaybackOverrideStreamHint>> CollectStreamHints() {
        var raw = await JS.InvokeAsync<JsHint[]>(JSCollectStreamHintsMethod);
        var hints = new List<VideoQualityUI.PlaybackOverrideStreamHint>(raw.Length);
        foreach (var h in raw)
            hints.Add(new VideoQualityUI.PlaybackOverrideStreamHint(h.streamId, h.currentSpatialLayerId));
        return hints;
    }

    private sealed record JsHint(string streamId, int currentSpatialLayerId);

    // Mirrors `VideoDebugSettings` in `video-diagnostics.ts`. JSInterop uses
    // System.Text.Json with web defaults (case-insensitive), so PascalCase
    // properties match the camelCase JS object shape.
    public sealed record VideoDebugSettings(
        bool ForceH264Only,
        int? MaxOutboundLayerCount,
        int? MaxInboundLayerCount);

    public sealed record Model;
}
