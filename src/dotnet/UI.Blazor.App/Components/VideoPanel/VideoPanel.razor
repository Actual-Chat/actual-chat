@namespace ActualChat.UI.Blazor.Components
@using ActualChat.Video
@using ActualChat.UI.Blazor.App.Components.VideoPanel
@using ActualChat.UI.Blazor.App.Events
@using ActualChat.UI.Blazor.App.Module
@inherits ComputedStateComponent<AppUIHub, VideoPanel.Model>
@{
    var m = State.Value;
    var hasRemoteStreams = m.RemoteStreams.Length > 0;
    var isOwnCameraStreaming = m.IsOwnRecording;
    var isOwnScreenCasting = m.IsOwnScreenCasting;
    var isOwnStreaming = isOwnCameraStreaming || isOwnScreenCasting;
    var remoteStreamEndedSuccessfully = ChatVideoUI.ConsumeRemoteStreamEndedSuccessfully();

    // Intentional-end signal (sender hung up / codec switch) wins over the
    // 5s "Connecting..." overlay: when remote streams transition from present
    // to empty we enter a short ending-grace window (~500ms) so a codec/
    // quality switch can register a replacement stream before we close the
    // panel. Two paths trigger grace:
    //   1. JS reports OnEnded(null) → NotifyRemoteStreamEnded sets the flag
    //      consumed at line above.
    //   2. Server removes the stream from the active list first (typical
    //      for sender hang-up — B's player is unmounted before its OnEnded
    //      JS callback fires) — caught by hasRemoteStreams transition below.
    var lostAllStreams = !hasRemoteStreams && _hadRemoteStreams
        && !_endingGraceActive && !_showConnecting && !_noStreamsTimedOut;
    if (remoteStreamEndedSuccessfully || lostAllStreams)
        _endingGraceActive = true;
    if (hasRemoteStreams) {
        _showConnecting = false;
        _noStreamsTimedOut = false;
        _hadRemoteStreams = true;
        _endingGraceActive = false;
    } else if (isOwnStreaming && !_hadRemoteStreams && !_noStreamsTimedOut) {
        // Recording solo, never had remote peers — show preview, not "Connecting..."
        _showConnecting = false;
    } else if (_endingGraceActive) {
        _showConnecting = false;
    } else if (!_noStreamsTimedOut && _hadRemoteStreams) {
        _showConnecting = true;
    }

    if (m != Model.Loading && !isOwnStreaming && !hasRemoteStreams && !_showConnecting && !_endingGraceActive) {
        // TODO(DF): move this logic to ChatVideoUI
        _skipCloseAnimation = m.IsExpanded || m.IsCollapsed || m.IsHidden;
        ChatVideoUI.CloseVideoPanel();
    }

    var recordingCls = isOwnCameraStreaming ? "recording" : "";
    var remoteStreamsCls = hasRemoteStreams || _showConnecting ? "has-remote-streams" : "";
    var firstOpenCls = _isFirstOpen ? "first-time-open" : "";
    var audioRecordingCls = m.IsAudioRecording ? "recording" : "";
    var videoBtnCls = isOwnCameraStreaming ? "on" : "";
    var screenCastBtnCls = isOwnScreenCasting ? "on" : "screen-share-start";
    var expandedPanelRecBtnCls = $"rec-btn {audioRecordingCls}";
    var isChatVisible = m.IsChatVisible ?? GetDefaultChatVisibility();
    var chatBtnCls = isChatVisible ? "on" : "";
    var collapsedCls = m.IsCollapsed ? "collapsed" : "";
    var hiddenCls = m.IsHidden ? "panel-hidden" : "";
    var expandedCls = m.IsExpanded ? "expanded" : "";
    var equalLayoutCls = m.IsEqualLayout && m.IsExpanded ? "layout-equal" : "";
    var videoMenuRef = MenuRef.New<VideoPanelMenu>(Chat.Id.Value, ScreenSize.IsNarrow().ToString()).ToString();
    var cameraMenuRef = MenuRef.New<CameraMenu>(CameraMenuRequester, m.SelectedCameraDeviceId ?? "").ToString();
    var layout = m.Layout;
    var panelCls = $"video-panel {firstOpenCls} {recordingCls} {remoteStreamsCls} "
        + $"{collapsedCls} {hiddenCls} {expandedCls} {equalLayoutCls}";
    var contentLayoutCls = m.IsEqualLayout && m.IsExpanded ? "video-panel-layout__equal" : layout.LayoutClass;
    var isMobileOrNarrow = ScreenSize.IsNarrow() || Hub.BrowserInfo.IsMobile;
}

<OnUIEvent TEvent="@CameraSelectedEvent" Handler="OnCameraSelectedEvent"/>
<div @ref="Ref" class="@panelCls">
    <div class="c-container">
        <div class="video-panel-toolbar video-panel-header">
            <div class="header-row">
                <div class="c-left">
                    <HeaderButton Class="btn-video-panel expand-btn show-with-delay" Click="@OnExpandClick">
                        <i class="icon-expand text-lg collapsed-video-panel"></i>
                        <i class="icon-collapse text-lg expanded-video-panel"></i>
                    </HeaderButton>
                    @if (m.IsExpanded) {
                        <HeaderButton
                            Class="@("btn-video-panel layout-toggle-btn " + (m.IsEqualLayout ? "on" : ""))"
                            StopPropagation="true"
                            PreventDefault="true"
                            Click="@(() => ChatVideoUI.SetVideoPanelEqualLayout(!m.IsEqualLayout))">
                            <i class="icon-grid text-lg"></i>
                        </HeaderButton>
                    }
                </div>

                @if (m.VideoStreamMemberCount > 0 || !m.FocusedParticipantName.IsNullOrEmpty()) {
                    <div class="c-center">
                        @if (!m.FocusedParticipantName.IsNullOrEmpty()) {
                            <div class="c-member-name">@m.FocusedParticipantName</div>
                        }
                        @if (m.VideoStreamMemberCount > 0) {
                            <div class="c-member-count">@m.VideoStreamMemberCount members</div>
                        }
                    </div>
                }

                <div class="c-right">
                    <HeaderButton
                        Class="btn-video-panel btn-video-menu"
                        StopPropagation="true"
                        PreventDefault="true"
                        data-menu="@videoMenuRef"
                        data-menu-trigger="Primary">
                        <i class="icon-more-vertical text-lg"></i>
                    </HeaderButton>
                    <HeaderButton
                        Class="btn-video-panel video-panel-collapse-toggle"
                        StopPropagation="true"
                        PreventDefault="true"
                        Click="@(() => ChatActivityUI.SetPanelMode(Chat.Id, VisualActivityPanelMode.Expanded))">
                        <i class="icon-expand text-lg"></i>
                    </HeaderButton>
                    <HeaderButton
                        Class="btn-video-panel talking"
                        StopPropagation="true"
                        PreventDefault="true"
                        Click="@OnHangUpClick"
                        TooltipPosition="FloatingPosition.Bottom">
                        <i class="icon-phone-off"></i>
                    </HeaderButton>
                </div>
            </div>

            @* Pin toggle: fixes the focused (big) tile on a chosen author instead
               of auto-following the active speaker. Second header row, pinned left;
               hides together with the header. Only in the default (non-equal) layout
               with a remote tile. *@
            @if (m is { IsEqualLayout: false, IsCollapsed: false, IsHidden: false } && hasRemoteStreams) {
                <div class="header-row header-row-pin">
                    <HeaderButton
                        Class="@("btn-video-panel btn-pin-toggle " + (m.IsPinned ? "on" : ""))"
                        StopPropagation="true"
                        PreventDefault="true"
                        Click="@OnTogglePinClick">
                        <i class="icon-pin text-lg"></i>
                    </HeaderButton>
                </div>
            }
        </div>

        @* Footer for mobile full-screen video *@
        <div class="video-panel-toolbar video-panel-footer">
            @if (isMobileOrNarrow) {
                <HeaderButton
                    Click="@(() => OnVideoClick(!isOwnCameraStreaming))"
                    Class="@("btn-video-panel btn-video-toggle " + videoBtnCls)">
                    <i class="icon-video text-lg"></i>
                </HeaderButton>
            } else {
                <HeaderButton
                    Click="@(() => OnScreenCastClick(!isOwnScreenCasting))"
                    Class="@("btn-video-panel " + screenCastBtnCls)">
                    <i class="icon-screen-share text-lg"></i>
                </HeaderButton>
            }
            <HeaderButton
                Click="@(() => OnToggleRecordingClick(!m.IsAudioRecording))"
                Class="@("btn-video-panel " + expandedPanelRecBtnCls)">
                @if (m.IsAudioRecording) {
                    <active-recording-svg
                        size="8"
                        isRecording="true"/>
                } else {
                    <i class="icon-recorder-left-half left"></i>
                    <i class="icon-recorder-right-half right"></i>
                }
            </HeaderButton>
            @if (isMobileOrNarrow) {
                @if (isOwnCameraStreaming) {
                    <HeaderButton
                        Click="@OnSwitchCamera"
                        Class="btn-video-panel"
                        data-menu="@cameraMenuRef"
                        data-menu-trigger="@MenuTrigger.Secondary"
                        data-menu-placement="@(FloatingPosition.Top.ToPositionString())">
                        <i class="icon-camera-switch text-lg"></i>
                    </HeaderButton>
                } else {
                    <div class="btn-incut"></div>
                }
            } else {
                <HeaderButton
                    Click="@(() => OnVideoClick(!isOwnCameraStreaming))"
                    Class="@("btn-video-panel btn-video-toggle " + videoBtnCls)">
                    <i class="icon-video text-lg"></i>
                </HeaderButton>
                <HeaderButton Click="@OnToggleChatVisibilityClick" Class="@("btn-video-panel chat-btn " + chatBtnCls)">
                    <i class="icon-message-ellipse text-lg"></i>
                </HeaderButton>
            }
        </div>
        <div class="video-panel-content @contentLayoutCls" data-menu="@videoMenuRef">
            <div class="c-grid tiles-@(layout.TileCount)">
                @if (_showConnecting) {
                    <UITimer Period="@TimeSpan.FromSeconds(5)" IsRecurring="false" Tick="OnConnectingTimeout" />
                    <div class="connecting-overlay">
                        <div class="connecting-spinner"></div>
                        <span>Connecting...</span>
                    </div>
                } else if (_endingGraceActive) {
                    <UITimer Period="@TimeSpan.FromMilliseconds(500)" IsRecurring="false" Tick="OnEndingGraceTimeout" />
                }
                @foreach (var streamInfo in m.RemoteStreams.OrderBy(s => s.StartedAt).ThenBy(s => s.StreamId.Value)) {
                    var remoteStreamCls = layout.GetRemoteStreamPlayerClass(streamInfo.StreamId);
                    if (remoteStreamCls.IsNullOrEmpty()) {
                        // Hidden slot (e.g. the camera half of an author who's also
                        // screencasting — it renders as a separate `pip-overlay` sidebar tile).
                        continue;
                    }
                    if (m.SpeakingAuthorIds is { } speaking && speaking.Contains(streamInfo.AuthorId))
                        remoteStreamCls += " speaking";
                    <RemoteStreamPlayer
                        @key="streamInfo.StreamId.Value"
                        StreamInfo="@streamInfo"
                        Class="@remoteStreamCls"
                        OnTileClick="@OnTilePinClick" />
                    var pipStream = layout.GetPipStreamFor(streamInfo.StreamId);
                    if (pipStream is not null) {
                        <RemoteStreamPlayer
                            @key="@("pip-" + pipStream.StreamId.Value)"
                            StreamInfo="@pipStream"
                            Class="pip-overlay" />
                    }
                }
                @* Own screencast is normally not rendered — the primary slot is
                   reserved for whoever is actually talking remotely, and the
                   camera tile shows a screencast indicator when the local user
                   is dual-streaming. The exception is when own-screencast is
                   the only stream in the panel: without this tile the sharing
                   user sees nothing at all. *@
                @if (isOwnCameraStreaming) {
                    var ownSpeakingCls = m.SpeakingAuthorIds is { } ownSpeaking && m.OwnAuthorId is { } ownAuthorId
                        && ownSpeaking.Contains(ownAuthorId) ? " speaking" : "";
                    <VideoStreamingPreview
                        @key="@("own-camera-" + Chat.Id.Value)"
                        SourceKind="@VideoSourceKind.Camera"
                        Class="@(layout.OwnCameraPreviewClass + ownSpeakingCls)" />
                } else if (isOwnScreenCasting && !hasRemoteStreams) {
                    <VideoStreamingPreview
                        @key="@("own-screencast-" + Chat.Id.Value)"
                        SourceKind="@VideoSourceKind.ScreenCast"
                        Class="item-focused" />
                }
            </div>
        </div>
        @if (m.IsExpanded && isChatVisible && !ScreenSize.IsNarrow() && m.ChatContext is { } chatContext) {
            <div class="video-panel-chat upload-drag-drop-host">
                <CascadingValue Value="@chatContext">
                    <ChatView @key="@chatContext.Chat.Id.Value" NavigationSlotName="@ChatNavigationSlot"/>
                    <div class="layout-subfooter">
                        <RenderStack Name="@ChatNavigationSlot"/>
                    </div>
                    <ChatMessageEditor @key="@("vp-editor-" + chatContext.Chat.Id.Value)"/>
                </CascadingValue>
            </div>
        }
    </div>
</div>

@code {
    private const string CameraMenuRequester = nameof(VideoPanel);
    private const string ChatNavigationSlot = "VideoPanelSubFooter";

    private static readonly string JSCreateMethod = $"{BlazorUIAppModule.ImportName}.VideoPanel.create";

    private bool _isFirstOpen = true;
    private bool _noStreamsTimedOut;
    private bool _showConnecting;
    private bool _endingGraceActive;
    private bool _hadRemoteStreams;
    private bool _shouldStartClosing;
    private bool _skipCloseAnimation;
    private bool _lastCollapsed;
    private bool _lastHidden;
    private bool _lastExpanded;
    private VideoPanelLayoutCalculator? _layoutCalculator;
    private HistoryStepRef? _expandStepRef;

    private Chat Chat => ChatContext.Chat;
    private ChatAudioUI ChatAudioUI => Hub.ChatAudioUI;
    private CameraUI CameraUI => Hub.CameraUI;
    private ChatVideoUI ChatVideoUI => Hub.ChatVideoUI;
    private ChatActivityUI ChatActivityUI => Hub.ChatActivityUI;
    private IAuthors Authors => Hub.Authors;
    private HistoryStepper HistoryStepper => field ??= Hub.Services.GetRequiredService<HistoryStepper>();
    private ILogger Log => field ??= Hub.LogFor(GetType());

    private ElementReference Ref { get; set; }
    private DotNetObjectReference<VideoPanel> BlazorRef { get; set; } = null!;
    private IJSObjectReference? JSRef { get; set; }

    [CascadingParameter] public ChatContext ChatContext { get; set; } = null!;
    [CascadingParameter] public ScreenSize ScreenSize { get; set; }
    [Parameter] public bool IsClosing { get; set; }
    [Parameter] public EventCallback OnClosed { get; set; }

    public override async ValueTask DisposeAsync() {
        CloseExpandStep();
        await JSRef.DisposeSilentlyAsync("dispose");
        JSRef = null!;
        BlazorRef.DisposeSilently();
        BlazorRef = null!;
        await base.DisposeAsync();
    }

    protected override async Task OnParametersSetAsync() {
        await base.OnParametersSetAsync();
        if (IsClosing && !_shouldStartClosing)
            _shouldStartClosing = true;
        else if (!IsClosing) {
            _shouldStartClosing = false;
            if (JSRef is not null)
                await JSRef.InvokeVoidAsync("cancelClosing");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (_shouldStartClosing) {
            _shouldStartClosing = false;
            if (_skipCloseAnimation) {
                _skipCloseAnimation = false;
                await CloseVideoPanel();
                // CloseVideoPanel disposed JSRef/BlazorRef and unmounts via OnClosed.
                // Anything below would try to lazy-init or InvokeVoidAsync on the dead refs.
                return;
            }
            if (JSRef is not null)
                await JSRef.InvokeVoidAsync("startClosing");
        }

        if (JSRef is null) {
            BlazorRef = DotNetObjectReference.Create(this);
            JSRef = await JS.InvokeAsync<IJSObjectReference>(JSCreateMethod, Ref, BlazorRef);

            _ = ClearFirstOpenAsync();
        }

        var isCollapsed = State.Value.IsCollapsed;
        var isHidden = State.Value.IsHidden;
        if (isCollapsed != _lastCollapsed || isHidden != _lastHidden) {
            _lastCollapsed = isCollapsed;
            _lastHidden = isHidden;
            if (JSRef is not null)
                await JSRef.InvokeVoidAsync("updatePanelMode");
        }

        var isExpanded = State.Value.IsExpanded;
        if (isExpanded != _lastExpanded) {
            _lastExpanded = isExpanded;
            if (JSRef is not null)
                await JSRef.InvokeVoidAsync(isExpanded ? "expand" : "collapse");
        }
    }

    [JSInvokable]
    public async Task CloseVideoPanel() {
        ChatActivityUI.TogglePanelMode(Chat.Id, VisualActivityPanelMode.Expanded, false);
        CloseExpandStep();
        ChatVideoUI.StopStreaming();
        await JSRef.DisposeSilentlyAsync("dispose");
        JSRef = null!;

        BlazorRef.DisposeSilently();
        BlazorRef = null!;

        await OnClosed.InvokeAsync();
    }

    [JSInvokable]
    public async Task OnExpanded() {
        ChatActivityUI.SetPanelMode(Chat.Id, VisualActivityPanelMode.Expanded);
        _lastExpanded = true;
        _expandStepRef = HistoryStepper.StepIn("VideoPanel");
        _ = WaitForExpandStepClosed(_expandStepRef);
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task OnCollapsed() {
        ChatActivityUI.TogglePanelMode(Chat.Id, VisualActivityPanelMode.Expanded, false);
        _lastExpanded = false;
        CloseExpandStep();
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task OnForceIsland(bool active) {
        ChatActivityUI.TogglePanelMode(Chat.Id, VisualActivityPanelMode.Collapsed, active);
        return Task.CompletedTask;
    }

    private async Task WaitForExpandStepClosed(HistoryStepRef stepRef) {
        await stepRef.WhenClosed.ConfigureAwait(false);
        await HistoryStepper.Dispatcher.InvokeSafeAsync(() => {
            if (_expandStepRef != stepRef)
                return; // Already handled

            _expandStepRef = null;
            if (!State.Value.IsExpanded)
                return; // Already collapsed

            // Back button pressed — collapse the video panel
            if (JSRef is not null)
                _ = JSRef.InvokeVoidAsync("collapse");
        }, Log);
    }

    private void CloseExpandStep() {
        if (_expandStepRef is not { } stepRef)
            return;

        _expandStepRef = null;
        stepRef.Close();
    }

    protected override ComputedState<Model>.Options GetStateOptions()
        => ComputedStateComponent.GetStateOptions(GetType(),
            t => new ComputedState<Model>.Options {
                InitialValue = Model.Loading,
                UpdateDelayer = FixedDelayer.NextTick,
                Category = GetStateCategory(t),
            });

    protected override async Task<Model> ComputeState(CancellationToken cancellationToken) {
        var chatContext = ChatContext;
        var chatId = chatContext.Chat.Id;

        if (_layoutCalculator is null || _layoutCalculator.ChatId != chatId) {
            _layoutCalculator = Hub.Services.GetRequiredService<VideoPanelLayoutCalculator>();
            _layoutCalculator.Initialize(chatId);
        }
        var layout = await _layoutCalculator.GetLayout(cancellationToken).ConfigureAwait(false);

        var panelMode = await ChatActivityUI.GetPanelMode(chatId, cancellationToken).ConfigureAwait(false);
        var isCollapsed = panelMode is VisualActivityPanelMode.Collapsed;
        var isHidden = panelMode is VisualActivityPanelMode.Hidden;
        var isExpanded = panelMode is VisualActivityPanelMode.Expanded;
        var isEqualLayout = await ChatVideoUI.GetIsVideoPanelEqualLayout(cancellationToken).ConfigureAwait(false);
        var isChatVisible = await ChatVideoUI.GetIsVideoPanelChatVisible(cancellationToken).ConfigureAwait(false);

        var isOwnRecording = await ChatVideoUI.IsOwnCameraRecording(chatId, cancellationToken).ConfigureAwait(false);
        var isOwnScreenCasting = await ChatVideoUI.IsOwnScreenCasting(chatId, cancellationToken).ConfigureAwait(false);
        var audioState = await ChatAudioUI.GetState(chatId).ConfigureAwait(false);
        var selectedCameraDeviceId = await CameraUI.GetSelectedDeviceId(cancellationToken).ConfigureAwait(false);

        var activeStreams = await ChatVideoUI.GetActiveVideoStreams(chatId, cancellationToken).ConfigureAwait(false);
        var videoStreamMemberCount = activeStreams.Count > 0
            ? await ChatVideoUI.GetVideoStreamMemberCount(chatId, cancellationToken).ConfigureAwait(false)
            : 0;

        if (activeStreams.Count == 0)
            return new Model(
                chatContext,
                layout,
                [],
                isOwnRecording,
                isOwnScreenCasting,
                audioState.IsRecording,
                0,
                isCollapsed,
                IsHidden: isHidden,
                IsExpanded: isExpanded,
                IsEqualLayout: isEqualLayout,
                IsChatVisible: isChatVisible,
                SelectedCameraDeviceId: selectedCameraDeviceId);

        var remoteStreams = await ChatVideoUI.GetRemoteStreams(chatId, cancellationToken).ConfigureAwait(false);
        // Name of the currently focused participant — shown above the member count in the header
        var focusedName = await GetFocusedParticipantName(chatId, layout, remoteStreams, cancellationToken)
            .ConfigureAwait(false);
        // Authors currently streaming audio (VAD-gated) — includes the local user; used to
        // ring the active speaker(s) in the equal layout, where focus alone can't (it never
        // points at own).
        var speakingAuthorIds = await Hub.LiveStreamUI.GetStreamingAuthorIds(chatId, cancellationToken)
            .ConfigureAwait(false);
        var ownAuthor = await Authors.GetOwn(Session, chatId, cancellationToken).ConfigureAwait(false);
        var ownAuthorId = ownAuthor?.Id;
        // Equal layout has no focused tile, so the header name tracks the current speaker
        // and — unlike focus — may be the local user. Show "You" when we're the sole speaker;
        // if a remote is also talking the focused remote name stays.
        if (isEqualLayout && isExpanded && ownAuthorId is { } ownId
            && speakingAuthorIds.Contains(ownId)
            && !speakingAuthorIds.Any(a => a != ownId))
            focusedName = "You";

        var pinnedAuthorId = await _layoutCalculator.GetPinnedAuthor(cancellationToken).ConfigureAwait(false);
        // Author shown in the big tile right now — what the pin button pins when toggled on.
        var focusedAuthorId = GetFocusedRemoteAuthorId(layout, remoteStreams);

        return new Model(
            chatContext,
            layout,
            remoteStreams,
            isOwnRecording,
            isOwnScreenCasting,
            audioState.IsRecording,
            videoStreamMemberCount,
            isCollapsed,
            FocusedParticipantName: focusedName,
            IsHidden: isHidden,
            IsExpanded: isExpanded,
            IsEqualLayout: isEqualLayout,
            IsChatVisible: isChatVisible,
            SelectedCameraDeviceId: selectedCameraDeviceId,
            SpeakingAuthorIds: speakingAuthorIds,
            OwnAuthorId: ownAuthorId,
            IsPinned: pinnedAuthorId is not null,
            FocusedAuthorId: focusedAuthorId);
    }

    private static AuthorId? GetFocusedRemoteAuthorId(VideoPanelLayout layout, VideoStreamInfo[] remoteStreams) {
        var focused = layout.RemoteStreamPlayerClasses.FirstOrDefault(c => c.Class.Contains("item-focused"));
        if (focused is null)
            return null;

        var stream = remoteStreams.FirstOrDefault(s => s.StreamId.Value == focused.StreamId);
        return stream?.AuthorId;
    }

    private async Task<string?> GetFocusedParticipantName(
        ChatId chatId,
        VideoPanelLayout layout,
        VideoStreamInfo[] remoteStreams,
        CancellationToken cancellationToken) {
        const string focusedCls = "item-focused";
        if (layout.OwnCameraPreviewClass.Contains(focusedCls))
            return "You";

        var focused = layout.RemoteStreamPlayerClasses.FirstOrDefault(c => c.Class.Contains(focusedCls));
        if (focused is null)
            return null;

        var focusedStream = remoteStreams.FirstOrDefault(s => s.StreamId.Value == focused.StreamId);
        if (focusedStream is null)
            return null;

        var author = await Authors.Get(Session, chatId, focusedStream.AuthorId, cancellationToken)
            .ConfigureAwait(false);
        return author?.Avatar.Name;
    }

    private void OnHangUpClick() {
        var m = State.Value;
        _skipCloseAnimation = m.IsExpanded || m.IsCollapsed || m.IsHidden;
        if (m.IsAudioRecording)
            _ = ChatAudioUI.SetRecordingChatId(null);
        _ = ChatAudioUI.SetListeningState(Chat.Id, false);
        ChatVideoUI.StopStreaming();
        ChatVideoUI.CloseVideoPanel();
    }

    private void OnTilePinClick(AuthorId authorId) {
        // Pin is a default-layout concept; equal has no focused tile.
        // Tapping the focused (big) tile is a toolbar toggle, not a pin — only
        // small tiles pin. The big tile is pinned via the pin button only.
        var m = State.Value;
        if (m.IsEqualLayout || authorId == m.FocusedAuthorId)
            return;

        _layoutCalculator?.SetPinnedAuthor(authorId);
    }

    private void OnTogglePinClick() {
        if (_layoutCalculator is null)
            return;

        var m = State.Value;
        if (m.IsPinned)
            _layoutCalculator.SetPinnedAuthor(null);
        else if (m.FocusedAuthorId is { } focused)
            _layoutCalculator.SetPinnedAuthor(focused);
    }

    private void OnToggleRecordingClick(bool enable)
        => _ = ChatAudioUI.SetRecordingChatId(enable ? Chat.Id : null);

    private void OnVideoClick(bool enable) {
        if (!enable) {
            // Stop own camera only — screencast (if any) keeps running
            ChatVideoUI.StopRecording();
        } else if (ChatVideoUI.HasJoinedVideoSession(Chat.Id)) {
            // Already joined this call — resume without modal
            ChatVideoUI.ResumeVideoStreaming(Chat.Id);
        } else {
            // Open join/start modal
            ChatVideoUI.JoinVideoSession(Chat.Id);
        }
    }

    private void OnScreenCastClick(bool enable) {
        if (!enable) {
            // Stop screencast only — camera (if any) keeps running
            ChatVideoUI.StopScreenCasting();
        } else {
            // Start screencast (additive — does not stop camera)
            ChatVideoUI.StartScreenCasting(Chat.Id);
        }
    }

    private Task OnSwitchCamera()
        => CameraUI.SwitchCamera();

    private Task OnCameraSelectedEvent(CameraSelectedEvent @event, CancellationToken cancellationToken)
        => @event.Requester == CameraMenuRequester
            ? CameraUI.SelectCamera(@event.DeviceId)
            : Task.CompletedTask;

    private void OnToggleChatVisibilityClick() {
        var current = State.Value.IsChatVisible ?? GetDefaultChatVisibility();
        ChatVideoUI.SetVideoPanelChatVisible(!current);
    }

    private async Task OnExpandClick() {
        if (JSRef is not null)
            await JSRef.InvokeVoidAsync("toggleExpand");
    }

    private async Task ClearFirstOpenAsync() {
        await Task.Delay(1000);
        _isFirstOpen = false;
    }

    private bool GetDefaultChatVisibility()
        => ScreenSize.IsWide() && !Hub.BrowserInfo.IsMobile;

    private void OnConnectingTimeout() {
        _showConnecting = false;
        _noStreamsTimedOut = true;
        var m = State.Value;
        if (m.RemoteStreams.Length == 0 && !m.IsOwnRecording && !m.IsOwnScreenCasting) {
            _skipCloseAnimation = m.IsExpanded || m.IsCollapsed || m.IsHidden;
            ChatVideoUI.CloseVideoPanel();
        }
        StateHasChanged();
    }

    private void OnEndingGraceTimeout() {
        _endingGraceActive = false;
        _noStreamsTimedOut = true;
        var m = State.Value;
        if (m.RemoteStreams.Length == 0 && !m.IsOwnRecording && !m.IsOwnScreenCasting) {
            _skipCloseAnimation = m.IsExpanded || m.IsCollapsed || m.IsHidden;
            ChatVideoUI.CloseVideoPanel();
        }
        StateHasChanged();
    }

    // Nested types

    public sealed record Model(
        ChatContext? ChatContext,
        VideoPanelLayout Layout,
        VideoStreamInfo[] RemoteStreams,
        bool IsOwnRecording,
        bool IsOwnScreenCasting,
        bool IsAudioRecording,
        int VideoStreamMemberCount,
        bool IsCollapsed = false,
        string? FocusedParticipantName = null,
        bool IsHidden = false,
        bool IsExpanded = false,
        bool IsEqualLayout = false,
        bool? IsChatVisible = null,
        string? SelectedCameraDeviceId = null,
        AuthorId[]? SpeakingAuthorIds = null,
        AuthorId? OwnAuthorId = null,
        bool IsPinned = false,
        AuthorId? FocusedAuthorId = null
    ) {
        public static readonly Model Loading = new(null, VideoPanelLayout.New, [], false, false, false, 0, false);
    }
}
