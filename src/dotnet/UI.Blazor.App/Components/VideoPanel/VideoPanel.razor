@namespace ActualChat.UI.Blazor.Components
@using ActualChat.UI.Blazor.App.Module
@inherits ComputedStateComponent<AppUIHub, bool>
@{
    var isRightPanelVisible = State.Value;
    var cls = isRightPanelVisible ? "rp-visible" : "";
}

<div @ref="Ref" class="video-panel first-time-open @cls">
    <div class="c-content">
        <div class="video-frame">
            <video autoplay muted playsinline loop preload="auto" class="call-video">
                <source src="/dist/images/landing/landing-tutorial.webm" type="video/webm"/>
                <source src="/dist/images/landing/landing-tutorial.mp4" type="video/mp4"/>
            </video>
        </div>
        <HeaderButton Class="expand-btn show-with-delay">
            <i class="icon-expand text-lg"></i>
        </HeaderButton>
    </div>
</div>

@code {
    private static readonly string JSCreateMethod = $"{BlazorUIAppModule.ImportName}.VideoPanel.create";

    private ElementReference Ref { get; set; }
    private IJSObjectReference JSRef { get; set; } = null!;

    [CascadingParameter] public ScreenSize ScreenSize { get; set; }

    public override async ValueTask DisposeAsync() {
        await JSRef.DisposeSilentlyAsync("dispose");
        JSRef = null!;
        await base.DisposeAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (firstRender) {
            JSRef = await JS.InvokeAsync<IJSObjectReference>(JSCreateMethod, Ref);
        }
    }

    protected override ComputedState<bool>.Options GetStateOptions()
        => ComputedStateComponent.GetStateOptions(GetType(),
            t => new ComputedState<bool>.Options {
                InitialValue = !ScreenSize.IsNarrow() && PanelsUI.Right.IsVisible.Value,
                UpdateDelayer = FixedDelayer.NextTick,
                Category = GetStateCategory(t),
            });

    protected override async Task<bool> ComputeState(CancellationToken cancellationToken) {
        if (ScreenSize.IsNarrow())
            return false;

        return await PanelsUI.Right.IsVisible.Use(cancellationToken);
    }
}
