@namespace ActualChat.UI.Blazor.Components
@using ActualChat.Streaming
@using ActualChat.UI.Blazor.App.Components.VideoPanel
@using ActualChat.UI.Blazor.App.Module
@inherits ComputedStateComponent<AppUIHub, VideoPanel.Model>
@{
    var m = State.Value;
    var cls = m.IsRightPanelVisible ? "rp-visible" : "";
    var recordingCls = m.IsRecording ? "recording" : "";
    var hasRemoteStreams = m.RemoteStreams.Length > 0;

    // Show "Connecting..." overlay when no remote streams and not recording;
    // after 5s timeout, auto-close the panel if streams haven't appeared
    if (hasRemoteStreams) {
        _showConnecting = false;
        _noStreamsTimedOut = false;
        _hadRemoteStreams = true;
    } else if (m.IsRecording && !_hadRemoteStreams && !_noStreamsTimedOut) {
        // Recording solo, never had remote peers — show preview, not "Connecting..."
        _showConnecting = false;
    } else if (!_noStreamsTimedOut) {
        _showConnecting = true;
    }

    var remoteStreamsCls = hasRemoteStreams ? "has-remote-streams" : "";
    var firstOpenCls = _isFirstOpen ? "first-time-open" : "";
    var audioRecordingCls = m.IsAudioRecording ? "recording" : "";
    var videoBtnCls = m.IsRecording ? "video-active" : "";
    var screencastBtnCls = m.IsScreencasting ? "video-active" : "";
    var expandedPanelRecBtnCls = $"rec-btn {audioRecordingCls}";
    var chatBtnCls = _isChatVisible ? "video-active" : "";
    if (m.Chat is { } mChat)
        _lastChat = mChat;
}

@if (_rendered) {
    <div @ref="Ref" class="video-panel @firstOpenCls @cls @recordingCls @remoteStreamsCls @(_isExpanded ? "expanded" : "") @(Collapsed ? "collapsed" : "")">
      <div class="c-container">
        @* Header for expanded video *@
        <div class="video-panel-header">
            <HeaderButton Class="expand-btn show-with-delay expanded-video-btn" Click="@OnExpandClick">
                <i class="icon-expand text-lg collapsed-video-panel"></i>
                <i class="icon-collapse text-lg expanded-video-panel"></i>
            </HeaderButton>

            @if (m.VideoStreamMemberCount > 0) {
                <div class="c-center">
                    <div class="c-member-count">@m.VideoStreamMemberCount members</div>
                </div>
            }

            <HeaderButton
                Class="talking"
                StopPropagation="true"
                PreventDefault="true"
                Click="@OnHangUpClick"
                TooltipPosition="FloatingPosition.Bottom"
                MustKeepAwake="@(!IsListening)">
                <i class="icon-phone-off"></i>
            </HeaderButton>
        </div>

        @* Footer for mobile full-screen video *@
        <div class="video-panel-footer">
            @if (ScreenSize.IsNarrow()) {
                <HeaderButton Click="@OnSwitchCamera">
                    <i class="icon-camera-switch text-lg"></i>
                </HeaderButton>
            }
            <HeaderButton Click="OnVideoClick" Class="@videoBtnCls">
                <i class="icon-video text-lg"></i>
            </HeaderButton>
            @if (!ScreenSize.IsNarrow()) {
                <HeaderButton Click="OnScreencastClick" Class="@screencastBtnCls">
                    <i class="icon-screen-share text-lg"></i>
                </HeaderButton>
            }
            <HeaderButton Click="OnToggleRecordingClick" Class="@expandedPanelRecBtnCls">
                @if (m.IsAudioRecording) {
                    <active-recording-svg
                        size="8"
                        isRecording="true"/>
                } else {
                    <i class="icon-recorder-left-half left"></i>
                    <i class="icon-recorder-right-half right"></i>
                }
            </HeaderButton>
            <HeaderButton Click="OnSettingsClick">
                <i class="icon-options-2 text-lg"></i>
            </HeaderButton>
            <HeaderButton Class="settings-btn" Click="@OnVideoSettingsClick">
                <i class="icon-settings text-lg"></i>
            </HeaderButton>
            @if (!ScreenSize.IsNarrow()) {
                <HeaderButton Class="@("chat-btn " + chatBtnCls)" Click="@OnChatClick">
                    <i class="icon-message-ellipse text-lg"></i>
                </HeaderButton>
            }
        </div>
        <div class="c-content">
            <div class="remote-streams">
                @if (_showConnecting) {
                    <UITimer Period="TimeSpan.FromSeconds(5)" IsRecurring="false" Tick="OnConnectingTimeout" />
                    <div class="connecting-overlay">
                        <div class="connecting-spinner"></div>
                        <span>Connecting...</span>
                    </div>
                }
                @foreach (var streamInfo in m.RemoteStreams) {
                    var name = m.AuthorNames.GetValueOrDefault(streamInfo.AuthorId, "");
                    var isFocused = streamInfo.AuthorId == m.FocusedAuthorId;
                    var isPrevious = streamInfo.AuthorId == m.PreviousFocusedAuthorId;
                    var focusedCls = isFocused ? "focused" : isPrevious ? "previous-speaker" : "";
                    <VideoTrackPlayer @key="streamInfo.StreamId.Value" StreamInfo="@streamInfo" AuthorName="@name" FocusedClass="@focusedCls"/>
                }
            </div>
            <HeaderButton Class="expand-btn show-with-delay collapsed-video-btn" Click="@OnExpandClick">
                <i class="icon-expand text-lg collapsed-video-panel"></i>
                <i class="icon-collapse text-lg expanded-video-panel"></i>
            </HeaderButton>
        </div>
        <VideoRecorder
            PendingCameraDeviceId="@PendingCameraDeviceId"
            PendingBlurEnabled="@PendingBlurEnabled"
            RemoteStreamCount="@m.RemoteStreams.Length"
            AutoStart="@_autoStartPending"/>
        @if (_isExpanded && _isChatVisible && !ScreenSize.IsNarrow() && _lastChat is { } chat) {
            <div class="video-panel-chat">
                <ChatView @key="@chat.Id.Value" ChatId="@chat.Id"/>
                <ChatMessageEditor @key="@("vp-editor-" + chat.Id.Value)" Chat="@chat"/>
            </div>
        }
      </div>
    </div>
}

@code {
    public sealed record Model(
        bool IsRightPanelVisible,
        VideoStreamInfo[] RemoteStreams,
        bool IsRecording,
        bool IsAudioRecording,
        bool IsListening,
        int VideoStreamMemberCount,
        ChatId? ChatId,
        Chat? Chat,
        IReadOnlyDictionary<AuthorId, string> AuthorNames,
        AuthorId? FocusedAuthorId,
        AuthorId? PreviousFocusedAuthorId,
        bool IsScreencasting = false
    ) {
        public static readonly Model None = new(false, [], false, false, false, 0, null, null, new Dictionary<AuthorId, string>(), null, null);
    }

    private record VideoDevice(string DeviceId, string Label);

    private bool _rendered;
    private bool _isFirstOpen = true;
    private bool _isExpanded;
    private bool _isChatVisible = true;
    private Chat? _lastChat;
    private bool _autoStartPending;
    private bool _noStreamsTimedOut;
    private bool _showConnecting;
    private bool _hadRemoteStreams;
    private static readonly string JSCreateMethod = $"{BlazorUIAppModule.ImportName}.VideoPanel.create";
    private static readonly string JSEnumerateMethod = $"{BlazorUIAppModule.ImportName}.JoinVideoCallModal.enumerateDevices";

    private ChatAudioUI ChatAudioUI => Hub.ChatAudioUI;
    private ChatVideoUI ChatVideoUI => Hub.ChatVideoUI;
    private ILogger Log => field ??= Hub.LogFor(GetType());
    private ElementReference Ref { get; set; }
    private DotNetObjectReference<VideoPanel> BlazorRef { get; set; } = null!;
    private IJSObjectReference? JSRef { get; set; }

    [CascadingParameter] public ScreenSize ScreenSize { get; set; }
    [Parameter] public bool Show { get; set; }
    [Parameter] public bool Collapsed { get; set; }
    [Parameter] public bool AutoStart { get; set; }
    [Parameter] public string? PendingCameraDeviceId { get; set; }
    [Parameter] public bool PendingBlurEnabled { get; set; }

    public override async ValueTask DisposeAsync() {
        await JSRef.DisposeSilentlyAsync("dispose");
        JSRef = null!;
        BlazorRef.DisposeSilently();
        BlazorRef = null!;
        await base.DisposeAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (_rendered && JSRef is null) {
            BlazorRef = DotNetObjectReference.Create(this);
            JSRef = await JS.InvokeAsync<IJSObjectReference>(JSCreateMethod, Ref, BlazorRef);

            _ = ClearFirstOpenAsync();
        }
    }

    protected override async Task OnParametersSetAsync() {
        if (Show && !_rendered) {
            _rendered = true;
            _isFirstOpen = true;
            _autoStartPending = AutoStart;
            _noStreamsTimedOut = false;
            _hadRemoteStreams = false;
        } else if (!Show && _rendered && JSRef is not null) {
            await JSRef.InvokeVoidAsync("startClosing");
        }
    }

    private void OnConnectingTimeout() {
        _showConnecting = false;
        _noStreamsTimedOut = true;
        var m = State.Value;
        if (m.RemoteStreams.Length == 0 && !m.IsRecording) {
            ChatVideoUI.SetWatching(null);
        }
        StateHasChanged();
    }

    [JSInvokable]
    public async Task CloseVideoPanel() {
        _rendered = false;
        _isExpanded = false;
        _lastChat = null;
        _autoStartPending = false;
        ChatVideoUI.OnRecordingStopped();
        await JSRef.DisposeSilentlyAsync("dispose");
        JSRef = null!;

        BlazorRef.DisposeSilently();
        BlazorRef = null!;

        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task OnExpanded()
    {
        _isExpanded = true;
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task OnCollapsed()
    {
        _isExpanded = false;
        await InvokeAsync(StateHasChanged);
    }

    private bool IsListening => State is { Value.IsListening: true };

    private void OnHangUpClick() {
        var m = State.Value;
        if (m.ChatId is not { } chatId)
            return;

        if (m.IsRecording)
            _ = ChatAudioUI.SetRecordingChatId(null);
        ChatVideoUI.SetRecordingChatId(null);
        ChatVideoUI.SetWatching(null);
        _ = ChatAudioUI.SetListeningState(chatId, false);
    }

    private void OnToggleRecordingClick() {
        var m = State.Value;
        if (m.ChatId is not { } chatId)
            return;

        if (m.IsAudioRecording)
            _ = ChatAudioUI.SetRecordingChatId(null);
        else
            _ = ChatAudioUI.SetRecordingChatId(chatId);
    }

    private void OnVideoClick() {
        var m = State.Value;
        if (m.ChatId is not { } chatId)
            return;

        if (m.IsRecording) {
            // Stop own video recording (keep panel open for remote streams)
            ChatVideoUI.SetRecordingChatId(null);
        } else if (ChatVideoUI.HasJoinedVideoCall(chatId)) {
            // Already joined this call — resume without modal
            ChatVideoUI.ResumeRecording(chatId);
        } else {
            // Open join/start modal
            ChatVideoUI.JoinVideoSession(chatId);
        }
    }

    private void OnScreencastClick() {
        var m = State.Value;
        if (m.ChatId is not { } chatId)
            return;

        if (m.IsScreencasting) {
            // Stop screencast
            ChatVideoUI.SetRecordingChatId(null);
        } else {
            // Start screencast (stops any active webcam recording)
            ChatVideoUI.SetScreencasting(chatId);
        }
    }

    private void OnSettingsClick() {
        var m = State.Value;
        if (m.ChatId is { } chatId)
            _ = Hub.ModalUI.Show(new VoiceSettingsModal.Model(chatId));
    }

    private void OnVideoSettingsClick() {
        // DO NOT stop recording — the modal will share the recorder's preview stream
        var chatId = Hub.ChatUI.SelectedChatId.Value;
        if (chatId is null)
            return;

        ChatVideoUI.ChangeVideoSessionSettings(chatId);
    }

    private async Task OnSwitchCamera() {
        try {
            var devices = await JS.InvokeAsync<VideoDevice[]>(JSEnumerateMethod);
            if (devices.Length <= 1)
                return;

            var settings = await Hub.LocalSettings.LocalAppSettings().Get();
            var currentId = settings.SelectedCameraDeviceId ?? "";
            var currentIndex = Array.FindIndex(devices, d => d.DeviceId == currentId);
            var nextIndex = (currentIndex + 1) % devices.Length;
            var nextDevice = devices[nextIndex];

            await Hub.LocalSettings.LocalAppSettings().Update(
                s => s with { SelectedCameraDeviceId = nextDevice.DeviceId });
            ChatVideoUI.SetSelectedCamera(nextDevice.DeviceId);
        } catch {
            // Camera enumeration may fail if no permission
        }
    }

    private void OnChatClick() {
        _isChatVisible = !_isChatVisible;
        StateHasChanged();
    }

    private async Task OnExpandClick(MouseEventArgs _) {
        if (JSRef is not null)
            await JSRef.InvokeVoidAsync("toggleExpand");
    }

    private async Task ClearFirstOpenAsync() {
        await Task.Delay(1000);
        _isFirstOpen = false;
    }

    protected override ComputedState<Model>.Options GetStateOptions()
        => ComputedStateComponent.GetStateOptions(GetType(),
            t => new ComputedState<Model>.Options {
                InitialValue = new Model(!ScreenSize.IsNarrow() && PanelsUI.Right.IsVisible.Value, [], false, false, false, 0, null, null, new Dictionary<AuthorId, string>(), null, null),
                UpdateDelayer = FixedDelayer.NextTick,
                Category = GetStateCategory(t),
            });

    protected override async Task<Model> ComputeState(CancellationToken cancellationToken) {
        var isRightPanelVisible = false;
        if (!ScreenSize.IsNarrow())
            isRightPanelVisible = await PanelsUI.Right.IsVisible.Use(cancellationToken);

        // Get current chat
        var emptyNames = (IReadOnlyDictionary<AuthorId, string>)new Dictionary<AuthorId, string>();

        var chatId = await Hub.ChatUI.SelectedChatId.Use(cancellationToken);
        var chat = chatId is not null
            ? await Hub.Chats.Get(Session, chatId, cancellationToken).ConfigureAwait(false)
            : null;

        if (chatId is null)
            return new Model(isRightPanelVisible, [], false, false, false, 0, null, null, emptyNames, null, null);

        // Get centralized video state (for recording status)
        var videoState = await ChatVideoUI.GetState(chatId, cancellationToken).ConfigureAwait(false);
        var audioState = await ChatAudioUI.GetState(chatId).ConfigureAwait(false);

        // Get active video streams for this chat
        var activeStreams = await ChatVideoUI.GetActiveVideoStreams(chatId, cancellationToken);
        var videoStreamMemberCount = activeStreams.Count > 0
            ? await ChatVideoUI.GetVideoStreamMemberCount(chatId, cancellationToken).ConfigureAwait(false)
            : 0;

        if (activeStreams.Count == 0)
            return new Model(isRightPanelVisible, [], videoState.IsRecording, audioState.IsRecording, audioState.IsListening, 0, chatId, chat, emptyNames, null, null);

        var remoteStreams = await ChatVideoUI.GetRemoteStreams(chatId, cancellationToken).ConfigureAwait(false);

        // Resolve author names for remote streams
        var authorNames = new Dictionary<AuthorId, string>();
        foreach (var stream in remoteStreams) {
            var author = await Hub.Authors.Get(Session, chatId, stream.AuthorId, cancellationToken);
            authorNames[stream.AuthorId] = author?.Avatar.Name ?? "";
        }

        // Check for screencast among remote streams — always focused
        var screencastStream = remoteStreams.FirstOrDefault(s => s.StreamKind == StreamKind.Screencast);

        // Get focused speaker from ChatVideoUI (state sync maintains this)
        var focusedAuthorId = screencastStream != default
            ? screencastStream.AuthorId
            : await ChatVideoUI.GetFocusedSpeakerId(cancellationToken).ConfigureAwait(false);

        // Validate focused author still has video; fall back to first remote stream
        var videoAuthorIds = remoteStreams.Select(s => s.AuthorId).ToHashSet();
        if (focusedAuthorId != null && !videoAuthorIds.Contains(focusedAuthorId))
            focusedAuthorId = null;
        focusedAuthorId ??= remoteStreams.FirstOrDefault()?.AuthorId;

        // Get previous focused speaker and validate
        var previousFocusedAuthorId = await ChatVideoUI.GetPreviousFocusedSpeakerId(cancellationToken)
            .ConfigureAwait(false);
        if (previousFocusedAuthorId != null
            && (!videoAuthorIds.Contains(previousFocusedAuthorId)
                || previousFocusedAuthorId == focusedAuthorId))
            previousFocusedAuthorId = null;

        Log.LogWarning("[VideoPanel] ComputeState: remoteStreams=[{Streams}], isRecording={IsRecording}",
            string.Join(", ", remoteStreams.Select(s => $"{s.StreamId}({s.Format.Codec})")),
            videoState.IsRecording);

        return new Model(isRightPanelVisible, remoteStreams, videoState.IsRecording, audioState.IsRecording, audioState.IsListening, videoStreamMemberCount, chatId, chat, authorNames, focusedAuthorId, previousFocusedAuthorId, videoState.IsScreencasting);
    }
}
