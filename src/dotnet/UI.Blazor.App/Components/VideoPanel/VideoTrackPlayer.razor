@namespace ActualChat.UI.Blazor.App.Components.VideoPanel
@using ActualChat.Streaming
@using ActualChat.UI.Blazor.App.Module
@using ActualChat.Video
@inherits ComponentBase<AppUIHub>
@implements IVideoPlayerBackend
@implements IAsyncDisposable

@{
    var isScreenCast = StreamInfo.SourceKind == VideoSourceKind.ScreenCast;
    var sourceKindCls = isScreenCast ? "screencast" : "";
    var labelIcon = isScreenCast ? "icon-screen-share" : "icon-video";
    // Prefer rotation-aware source dims over encoder dims: the encoder's W/H
    // can be landscape at PushVideo time even when the source is portrait
    // (the rotation reconcile in workers/video-processing.ts swaps encoder
    // dims after the first frame, but VideoStreamInfo.Format is frozen at
    // PushVideo). SourceSize is populated post-rotation. JS-side
    // (render-backend-canvas.ts) overrides this on each canvas resize for
    // mid-stream rotation.
    var topFormat = StreamInfo.Format;
    var aspectRatioStyle = topFormat switch {
        { SourceSize.Width: > 0, SourceSize.Height: > 0 } f => $"aspect-ratio: {f.SourceSize.Width} / {f.SourceSize.Height}",
        { Size.Width: > 0, Size.Height: > 0 } f             => $"aspect-ratio: {f.Size.Width} / {f.Size.Height}",
        _                                                   => "",
    };
}
<div class="video-track-player remote-video-container has-source-aspect @FocusedClass @sourceKindCls" style="@aspectRatioStyle"
     @onclick="@OnClick" @onclick:stopPropagation="true">
    @* Low-res intrinsic resolution: WebGPU renders to a 64×64 swap chain
       and CSS `object-cover` upscales to fill the focused tile. The heavy
       bilinear upscale on top of the Kawase blur produces a soft backdrop. *@
    <canvas @ref="BgCanvasRef" class="remote-video-bg" width="64" height="64" aria-hidden="true"></canvas>
    <canvas @ref="CanvasRef" class="remote-video" data-stream-id="@StreamInfo.StreamId.Value" data-author-id="@StreamInfo.AuthorId.Value"></canvas>
    <video @ref="VideoElRef" class="remote-video live-stream-video"
           data-stream-id="@StreamInfo.StreamId.Value"
           autoplay playsinline muted aria-hidden="true"
           disablepictureinpicture disableremoteplayback
           controlslist="nodownload nofullscreen noremoteplayback"></video>
    <div class="video-placeholder" aria-hidden="true">
        <i class="icon-video-play animate-pulse"></i>
    </div>
    @if (!string.IsNullOrEmpty(AuthorName)) {
        <div class="video-participant-label">
            <i class="@labelIcon"></i>
            <span>@AuthorName</span>
            <span class="video-fps" data-stream-id="@StreamInfo.StreamId.Value"></span>
        </div>
    }
</div>

@code {
    private static bool DebugMode => Constants.DebugMode.VideoPlayback;
    private ILogger? DebugLog => DebugMode ? Log : null;

    private static readonly string JSCreateMethod = $"{BlazorUIAppModule.ImportName}.VideoPlayer.create";

    private readonly CancellationTokenSource _disposeCts = new();
    private readonly TaskCompletionSource _whenCompletedSource = new();

    private IJSObjectReference? _jsPlayerRef;
    private Task? _playTask;
    private Timer? _viewerHeartbeatTimer;
    private bool _isDisposed;
    private bool _isViewerRegistered;

    private ILogger Log => field ??= Services.LogFor<VideoTrackPlayer>();
    private ILiveVideoStreams LiveVideoStreams => field ??= Services.GetRequiredService<ILiveVideoStreams>();
    private PlaybackLagTracker LagTracker => field ??= Services.GetRequiredService<PlaybackLagTracker>();

    private ElementReference CanvasRef { get; set; }
    private ElementReference VideoElRef { get; set; }
    private ElementReference BgCanvasRef { get; set; }
    private DotNetObjectReference<VideoTrackPlayer>? BlazorRef { get; set; }

    [Parameter, EditorRequired]
    public VideoStreamInfo StreamInfo { get; set; } = null!;

    [Parameter]
    public string AuthorName { get; set; } = "";

    [Parameter]
    public string FocusedClass { get; set; } = "";

    [Parameter]
    public EventCallback OnClick { get; set; }

    public Task WhenCompleted => _whenCompletedSource.Task;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _isDisposed)
            return;

        try {
            BlazorRef = DotNetObjectReference.Create(this);

            // Register decoder codecs early — before creating JS player.
            // This ensures the server knows our capabilities ASAP, triggering
            // the sender to switch codecs if the current stream is unsupported.
            await RegisterViewer();
            _viewerHeartbeatTimer = new Timer(
                _ => _ = RegisterViewerHeartbeat(),
                null,
                TimeSpan.FromSeconds(30),
                TimeSpan.FromSeconds(30));

            // Ensure server clock is synced before JS compares its clock to the stream origin.
            // ServerTimeSync is only registered on client platforms (WASM/MAUI), not on Server
            var serverTimeSync = Services.GetService<ServerTimeSync>();
            if (serverTimeSync != null)
                await serverTimeSync.EnsureSynced(_disposeCts.Token);

            // Use the top layer (last format = highest LayerId) for the JS player init —
            // canvas dims, codec settings (SPS/PPS), and starting resolution all align to the
            // best tier the receiver may ever decode. The decoder reconfigures at keyframe
            // boundaries if the actual forwarded layer is lower.
            var format = StreamInfo.Format;
            var sourceStartedAt = StreamInfo.SourceStartedAt != default
                ? StreamInfo.SourceStartedAt
                : StreamInfo.StartedAt;
            var startedAtMs = sourceStartedAt.EpochOffset.TotalMilliseconds;
            Log.LogDebug(
                "[VideoTrackPlayer #{StreamId}] Creating JS player: authorId={AuthorId}, startedAtMs={StartedAtMs}, format={Format}",
                StreamInfo.StreamId, StreamInfo.AuthorId, startedAtMs, format);
            _jsPlayerRef = await JS.InvokeAsync<IJSObjectReference>(
                JSCreateMethod,
                _disposeCts.Token,
                CanvasRef,
                VideoElRef,
                BgCanvasRef,
                BlazorRef,
                StreamInfo.StreamId.Value,
                StreamInfo.AuthorId.Value,
                format.Codec,
                format.Size.Width,
                format.Size.Height,
                format.CodecSettings,
                startedAtMs);

            await _jsPlayerRef.InvokeVoidAsync("start", _disposeCts.Token);

            // Start playback in background
            _playTask = Task.Run(async () => await PlayAsync(_disposeCts.Token), CancellationToken.None);
        }
        catch (Exception ex) when (ex is not OperationCanceledException) {
            Log.LogError(ex, "Failed to initialize VideoTrackPlayer for stream #{StreamId}", StreamInfo.StreamId);
            _whenCompletedSource.TrySetResult();
        }
    }

    [JSInvokable]
    public void OnPlaying(double offset, bool isBufferLow)
    {
        DebugLog?.LogDebug(
            "[VideoTrackPlayer #{StreamId}] OnPlaying: {Offset}, buffer: {IsBufferLow}",
            StreamInfo.StreamId, offset, isBufferLow ? "low" : "ok");
    }

    [JSInvokable]
    public async Task OnPlaybackStats(
        long incomingByteRate,
        double bufferSpanMsEma,
        int priority,
        int streamAgeMs,
        double renderCssLongSide,
        double renderDevicePixelRatio,
        bool hasDimensions,
        string codec,
        byte[] dropStages,
        int[] dropCounts,
        int presentedCount,
        double playbackRateEma,
        double decodeRatioEma,
        int hangRateIn60s,
        int recoveryStreak,
        double presentSkipRatio,
        double bufferUnderrunRatio,
        double downlinkLatencyEma,
        double arrivalIntervalEma,
        double decodeDeficitEma)
    {
        if (_isDisposed)
            return;

        var dropTrace = new Dictionary<FrameDropStage, int>(dropStages.Length);
        for (var i = 0; i < dropStages.Length && i < dropCounts.Length; i++)
            dropTrace[(FrameDropStage)dropStages[i]] = dropCounts[i];
        var stats = new PlaybackStats(Priority: (PlaybackStreamPriority)priority,
            Codec: codec,
            RenderCssLongSide: renderCssLongSide,
            RenderDevicePixelRatio: renderDevicePixelRatio,
            PresentedCount: presentedCount,
            StreamDurationMs: streamAgeMs,
            IncomingByteRate: incomingByteRate,
            BufferSpanMsEma: bufferSpanMsEma,
            PlaybackRateEma: playbackRateEma,
            DropTrace: dropTrace,
            DecodeRatioEma: decodeRatioEma,
            HangRateIn60s: hangRateIn60s,
            RecoveryStreak: recoveryStreak,
            PresentSkipRatio: presentSkipRatio,
            BufferUnderrunRatio: bufferUnderrunRatio,
            DownlinkLatencyEma: downlinkLatencyEma,
            ArrivalIntervalEma: arrivalIntervalEma,
            DecodeDeficitEma: decodeDeficitEma);
        try {
            await Hub.VideoQualityUI
                .OnPlaybackStats(
                    StreamInfo.StreamId,
                    StreamInfo.SourceKind,
                    stats,
                    hasDimensions,
                    CancellationToken.None)
                .ConfigureAwait(false);
        }
        catch (Exception e) {
            Log.LogWarning(e, "[VideoTrackPlayer #{StreamId}] OnPlaybackStats failed", StreamInfo.StreamId);
        }
    }

    [JSInvokable]
    public async Task OnPlaybackViewportChanged(
        double renderCssLongSide,
        double renderDevicePixelRatio,
        int priority,
        bool hasDimensions)
    {
        if (_isDisposed)
            return;

        try {
            await Hub.VideoQualityUI
                .OnPlaybackViewportChanged(
                    StreamInfo.StreamId,
                    StreamInfo.SourceKind,
                    renderCssLongSide,
                    renderDevicePixelRatio,
                    (PlaybackStreamPriority)priority,
                    hasDimensions,
                    CancellationToken.None)
                .ConfigureAwait(false);
        }
        catch (Exception e) {
            Log.LogWarning(e, "[VideoTrackPlayer #{StreamId}] OnPlaybackViewChanged failed", StreamInfo.StreamId);
        }
    }

    [JSInvokable]
    public void OnPresentationLag(double lagMs, double captureOffsetMs, double bufferSpanMs, double presentSkipRatio, double tapLagMs, double uplinkMs = 0, double rxMs = 0)
    {
        // Camera-only: screencast pacing is too uneven to be a useful A/V sync target.
        if (StreamInfo.SourceKind != VideoSourceKind.Camera)
            return;

        // lagMs = true on-screen lag (rVFC); tapLagMs = pre-present tap lag, kept
        // in DeviceLatencyMs as a diagnostic so the present→display gap is visible.
        // uplinkMs = capture→server (sender+upload); rxMs = arrival→decode (receiver-internal).
        var anchor = StreamInfo.SourceStartedAt != default ? StreamInfo.SourceStartedAt : StreamInfo.StartedAt;
        var raw = new LagInputs(anchor.EpochOffset.TotalMilliseconds, bufferSpanMs, captureOffsetMs, presentSkipRatio, tapLagMs, uplinkMs, rxMs);
        LagTracker.UpdateVideo(StreamInfo.AuthorId, StreamInfo.StreamId.Value, TimeSpan.FromMilliseconds(lagMs), raw);
    }

    [JSInvokable]
    public async Task OnRequestCodecExclusion(string codecCategory)
    {
        Log.LogWarning(
            "[VideoTrackPlayer #{StreamId}] OnRequestCodecExclusion: codec={Codec} — excluding from supported decoders",
            StreamInfo.StreamId, codecCategory);
        try {
            // Exclude the codec and re-register with updated supported list.
            await JS.InvokeVoidAsync($"{BlazorUIAppModule.ImportName}.excludeDecoderCodec", codecCategory);
            var decoderCodecs = await JS.InvokeAsync<string[]>(
                $"{BlazorUIAppModule.ImportName}.detectSupportedDecoderCodecs");
            await LiveVideoStreams.RegisterMember(
                Session, StreamInfo.ChatId, new ApiArray<string>(decoderCodecs), CancellationToken.None);
            Log.LogWarning(
                "[VideoTrackPlayer #{StreamId}] Re-registered with codecs: [{Codecs}]",
                StreamInfo.StreamId, string.Join(", ", decoderCodecs));
        }
        catch (Exception ex) {
            Log.LogError(ex,
                "[VideoTrackPlayer #{StreamId}] Failed to re-register after requested codec exclusion",
                StreamInfo.StreamId);
        }
    }

    [JSInvokable]
    public void OnEnded(string? errorMessage)
    {
        if (errorMessage is not null)
            Log.LogWarning("[VideoTrackPlayer #{StreamId}] OnEnded: {Error}", StreamInfo.StreamId, errorMessage);

        var isEndedSuccessfully = errorMessage is null;
        var isTerminal = isEndedSuccessfully
            || string.Equals(errorMessage, "evicted", StringComparison.Ordinal)
            || (errorMessage?.StartsWith("Player stream stalled:", StringComparison.Ordinal) ?? false);
        Hub.ChatVideoUI.NotifyRemoteStreamEnded(
            StreamInfo.ChatId,
            StreamInfo.StreamId,
            isEndedSuccessfully,
            isTerminal);
        _whenCompletedSource.TrySetResult();
    }

    public async ValueTask DisposeAsync()
    {
        if (_isDisposed)
            return;

        Log.LogDebug("[VideoTrackPlayer #{StreamId}] DisposeAsync called", StreamInfo.StreamId);

        _isDisposed = true;

        try {
            await _disposeCts.CancelAsync().ConfigureAwait(false);

            if (_viewerHeartbeatTimer != null)
                await _viewerHeartbeatTimer.DisposeAsync().ConfigureAwait(false);

            if (_playTask != null)
                await _playTask.ConfigureAwait(ConfigureAwaitOptions.SuppressThrowing);

            // Don't unregister viewer on dispose — the server has 90s stale member cleanup.
            // Unregistering here causes codec oscillation when ComputeState re-renders
            // rapidly (e.g., isRecording changes), which cycles AV1↔HEVC endlessly.

            if (_jsPlayerRef is {} jsRef) {
                try {
                    await jsRef.InvokeVoidAsync("stop");
                }
                catch {
                    // Ignore JS errors during disposal
                }
                await jsRef.DisposeSilentlyAsync();
            }

            BlazorRef?.DisposeSilently();
        }
        finally {
            _disposeCts.Dispose();
            _whenCompletedSource.TrySetResult();
        }
    }

    private async Task PlayAsync(CancellationToken cancellationToken)
    {
        try {
            var clocks = Services.Clocks();
            var skipTo = clocks.ServerClock.Now - StreamInfo.StartedAt;
            if (skipTo < TimeSpan.Zero)
                skipTo = TimeSpan.Zero;

            DebugLog?.LogDebug(
                "[VideoTrackPlayer #{StreamId}] Starting RPC pull, skipTo={SkipTo}",
                StreamInfo.StreamId, skipTo);

            // Initiate pull from JS — it connects via Fusion RPC and feeds frames directly
            await _jsPlayerRef!.InvokeVoidAsync(
                "startPull",
                cancellationToken,
                StreamInfo.StreamId.Value,
                skipTo.TotalMilliseconds);

            // Wait for playback completion (signaled by JS via OnEnded callback)
            await _whenCompletedSource.Task.WaitAsync(cancellationToken).ConfigureAwait(false);
        }
        catch (OperationCanceledException) {
            // Expected during disposal
        }
        catch (Exception ex) {
            Log.LogError(ex, "[VideoTrackPlayer #{StreamId}] Playback failed", StreamInfo.StreamId);
        }
        finally {
            _whenCompletedSource.TrySetResult();
        }
    }

    private async Task RegisterViewer()
    {
        if (_isViewerRegistered)
            return;

        try {
            var decoderCodecs = await JS.InvokeAsync<string[]>(
                $"{BlazorUIAppModule.ImportName}.detectSupportedDecoderCodecs");
            await LiveVideoStreams.RegisterMember(
                Session, StreamInfo.ChatId, new ApiArray<string>(decoderCodecs), CancellationToken.None);
            _isViewerRegistered = true;
            DebugLog?.LogDebug("[VideoTrackPlayer #{StreamId}] Registered as viewer with decoder codecs: {Codecs}",
                StreamInfo.StreamId, string.Join(", ", decoderCodecs));
        }
        catch (Exception ex) {
            Log.LogError(ex, "[VideoTrackPlayer #{StreamId}] Failed to register as viewer", StreamInfo.StreamId);
        }
    }

    private async Task RegisterViewerHeartbeat()
    {
        if (_isDisposed)
            return;

        try {
            var decoderCodecs = await JS.InvokeAsync<string[]>(
                $"{BlazorUIAppModule.ImportName}.detectSupportedDecoderCodecs");
            await LiveVideoStreams.RegisterMember(
                Session, StreamInfo.ChatId, new ApiArray<string>(decoderCodecs), CancellationToken.None);
        }
        catch {
            // Ignore heartbeat failures — next heartbeat will retry
        }
    }

    private async Task UnregisterViewer()
    {
        if (!_isViewerRegistered)
            return;

        try {
            await LiveVideoStreams.UnregisterMember(Session, StreamInfo.ChatId, CancellationToken.None);
            _isViewerRegistered = false;
            DebugLog?.LogDebug("[VideoTrackPlayer #{StreamId}] Unregistered as viewer", StreamInfo.StreamId);
        }
        catch (Exception ex) {
            Log.LogError(ex, "[VideoTrackPlayer #{StreamId}] Failed to unregister as viewer", StreamInfo.StreamId);
        }
    }

}
