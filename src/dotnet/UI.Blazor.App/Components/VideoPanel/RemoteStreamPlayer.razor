@namespace ActualChat.UI.Blazor.App.Components.VideoPanel
@using ActualChat.Streaming
@inherits ComputedStateComponent<AppUIHub, RemoteStreamPlayer.Model>
@{
    var m = State.Value;
}

<VideoTrackPlayer StreamInfo="@StreamInfo" AuthorName="@m.AuthorName" FocusedClass="@Class" />

@code {
    private IAuthors Authors => Hub.Authors;

    [Parameter, EditorRequired]
    public VideoStreamInfo StreamInfo { get; set; } = null!;
    [Parameter] public string Class { get; set; } = "";

    protected override ComputedState<Model>.Options GetStateOptions()
        => ComputedStateComponent.GetStateOptions(GetType(),
            t => new ComputedState<Model>.Options {
                InitialValue = Model.None,
                UpdateDelayer = FixedDelayer.NextTick,
                Category = GetStateCategory(t),
            });

    protected override async Task<Model> ComputeState(CancellationToken cancellationToken) {
        var authorId = StreamInfo.AuthorId;

        var author = await Authors.Get(Session, StreamInfo.ChatId, authorId, cancellationToken);
        var authorName = author?.Avatar.Name ?? "";

        return new Model(authorName);
    }

    // Nested types

    public sealed record Model(string AuthorName) {
        public static readonly Model None = new("");
    }
}
