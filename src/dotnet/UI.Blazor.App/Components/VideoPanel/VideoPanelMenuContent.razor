@namespace ActualChat.UI.Blazor.App.Components
@inherits ComponentBase<AppUIHub>
@{
    if (Actions is null)
        return;

    var a = Actions;
    var isExpanded = a.Mode == VisualActivityPanelMode.Expanded;
    var isCollapsed = a.Mode == VisualActivityPanelMode.Collapsed;
    var effectiveChatVisible = IsChatVisible ?? !a.IsNarrow;
    var hasLayoutActions = a.CanToggleFullscreen || a.CanToggleIsland || a.CanMinimize;
    var hasStreamActions = a.CanSwitchCamera || a.CanToggleVideo || a.CanToggleScreenCast;
    var hasSettingsActions = a.CanShowVideoSettings || a.CanShowVoiceSettings;
    var hasChatActions = a.CanToggleChatPanel;
    var hasDiagnosticsActions = a.CanShowDiagnostics;
}

<div class="video-panel-menu">
    @if (hasLayoutActions) {
        @if (a.CanToggleFullscreen && !isExpanded) {
            <MenuEntry
                Icon="icon-expand"
                Text="@L.Call_Fullscreen"
                Click="@OnToggleFullscreen"/>
        }
        @if (a.CanToggleIsland && !isCollapsed) {
            <MenuEntry
                Icon="icon-video-collapse"
                Text="@L.Call_Float"
                Click="@OnToggleIsland"/>
        }
        @if (a.CanMinimize) {
            <MenuEntry
                Icon="icon-eye-off"
                Text="@L.Common_Hide"
                Click="@OnMinimize"/>
        }
    }

    @if (hasLayoutActions && hasStreamActions) {
        <MenuEntrySeparator/>
    }

    @if (hasStreamActions) {
        @if (a.CanSwitchCamera) {
            <MenuEntry
                Icon="icon-camera-switch"
                Text="@L.Call_SwitchCamera"
                Click="@OnSwitchCamera"/>
        }
        @if (a.CanToggleVideo) {
            <MenuEntry
                Icon="icon-video"
                Text="@(IsOwnRecording ? L.Video_TurnCameraOff : L.Video_TurnCameraOn)"
                Click="@OnToggleVideo"/>
        }
        @if (a.CanToggleScreenCast) {
            <MenuEntry
                Class="@(IsOwnScreenCasting ? "" : "screen-share-start")"
                Icon="icon-screen-share"
                Text="@(IsOwnScreenCasting ? L.Call_StopScreenShare : L.Call_ShareScreen)"
                Click="@OnToggleScreenCast"/>
        }
    }

    @if ((hasLayoutActions || hasStreamActions) && hasSettingsActions) {
        <MenuEntrySeparator/>
    }

    @if (hasSettingsActions) {
        @if (a.CanShowVideoSettings) {
            <MenuEntry
                Icon="icon-settings"
                Text="@L.Call_VideoSettings"
                Click="@OnVideoSettings"/>
        }
        @if (a.CanShowVoiceSettings) {
            <MenuEntry
                Icon="icon-options-2"
                Text="@L.Call_VoiceSettings"
                Click="@OnVoiceSettings"/>
        }
    }

    @if ((hasLayoutActions || hasStreamActions || hasSettingsActions) && hasChatActions) {
        <MenuEntrySeparator/>
    }

    @if (hasChatActions) {
        <MenuEntry
            Icon="icon-message-ellipse"
            Text="@(effectiveChatVisible ? L.Video_HideChat : L.Video_ShowChat)"
            Click="@OnToggleChatPanel"/>
    }

    @if ((hasLayoutActions || hasStreamActions || hasSettingsActions || hasChatActions) && hasDiagnosticsActions) {
        <MenuEntrySeparator/>
    }

    @if (hasDiagnosticsActions) {
        <MenuEntry
            Icon="icon-activity"
            Text="Video diagnostics"
            Click="@OnDiagnostics"/>
    }
</div>

@code {
    [Parameter, EditorRequired] public ChatId ChatId { get; set; }
    [Parameter, EditorRequired] public VideoPanelActions? Actions { get; set; }
    [Parameter] public bool IsOwnRecording { get; set; }
    [Parameter] public bool IsOwnScreenCasting { get; set; }
    [Parameter] public bool? IsChatVisible { get; set; }

    private ChatVideoUI ChatVideoUI => Hub.ChatVideoUI;
    private ChatActivityUI ChatActivityUI => Hub.ChatActivityUI;

    private void OnToggleFullscreen()
        => ChatActivityUI.TogglePanelMode(ChatId, VisualActivityPanelMode.Expanded,
            Actions?.Mode != VisualActivityPanelMode.Expanded);

    private void OnToggleIsland()
        => ChatActivityUI.TogglePanelMode(ChatId, VisualActivityPanelMode.Collapsed,
            Actions?.Mode != VisualActivityPanelMode.Collapsed);

    private void OnMinimize()
        => ChatActivityUI.SetPanelMode(ChatId, VisualActivityPanelMode.Hidden);

    private Task OnSwitchCamera()
        => Hub.CameraUI.SwitchCamera();

    private void OnToggleVideo()
        => ChatVideoUI.ToggleVideoCapture(ChatId);

    private void OnToggleScreenCast()
        => ChatVideoUI.ToggleScreenCast(ChatId);

    private void OnToggleChatPanel() {
        var a = Actions;
        var current = IsChatVisible ?? (a is not null && !a.IsNarrow);
        ChatVideoUI.SetVideoPanelChatVisible(!current);
    }

    private void OnVoiceSettings()
        => ChatVideoUI.ShowVoiceSettings(ChatId);

    private void OnVideoSettings()
        => ChatVideoUI.ChangeVideoSessionSettings(ChatId);

    private void OnDiagnostics()
        => ChatVideoUI.ShowDiagnostics(ChatId);
}
