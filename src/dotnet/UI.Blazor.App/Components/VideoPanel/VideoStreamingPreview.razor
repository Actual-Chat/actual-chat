@namespace ActualChat.UI.Blazor.App.Components.VideoPanel
@using ActualChat.Streaming
@using ActualChat.UI.Blazor.App.Module
@inherits ComputedStateComponent<AppUIHub, VideoStreamingPreview.Model>
@{
    var m = State.Value;
    var isRecording = m.IsOwnRecording;
    var isScreenCasting = m.IsOwnScreenCasting;
    var recordingCls = isRecording ? "recording" : "";
    var screenCastCls = !isRecording && isScreenCasting ? "screencast" : "";
    // Mirror only for camera. ScreenCast is never mirrored.
    var mirrorCls = isRecording && m.IsCameraMirrored ? "" : "no-mirror";
    var labelIcon = !isRecording && isScreenCasting ? "icon-screen-share" : "icon-video";
}

<div @ref="Ref" class="video-track-player video-streaming-preview @Class @recordingCls @screenCastCls">
    <canvas class="remote-video-bg" aria-hidden="true"></canvas>
    <video class="call-video-native live-stream-video @mirrorCls"
           autoplay playsinline muted aria-hidden="true"
           disablepictureinpicture disableremoteplayback
           controlslist="nodownload nofullscreen noremoteplayback"></video>
    <canvas
        class="call-video @mirrorCls"
        @onclick="@(isRecording && !m.IsAloneOnStream ? OnSettingsClick : null!)"></canvas>
    <div class="video-loading">
        <span class="spinner-icon-wrapper">
            <img src="/dist/images/loading-spinner.svg" class="spinner-icon animate-spin" alt="loading"/>
        </span>
    </div>
    @if (isRecording && m.IsAloneOnStream) {
        <HeaderButton Class="btn-settings btn-video-panel" Click="@OnSettingsClick">
            <i class="icon-settings text-lg"></i>
        </HeaderButton>
    }
    <div class="video-participant-label">
        <i class="@labelIcon"></i>
        <span>You</span>
    </div>
    @if (m.LastErrorMessage is {} errorMessage && errorMessage.Length > 0) {
        <div class="video-error">
            <span>@errorMessage</span>
        </div>
    }
</div>

@code {
    private static readonly string JSCreateMethod = $"{BlazorUIAppModule.ImportName}.VideoStreamingPreview.create";

    private ChatVideoUI ChatVideoUI => Hub.ChatVideoUI;
    private ElementReference Ref { get; set; }
    private IJSObjectReference? JSRef { get; set; }
    private bool _isSuspended;
    private Model _suspendedModel = Model.None;

    [Parameter, EditorRequired] public ChatId ChatId { get; set; }
    [Parameter] public string Class { get; set; } = "";
    [Parameter, EditorRequired] public VideoSourceKind SourceKind { get; set; }

    public override async ValueTask DisposeAsync() {
        ChatVideoUI.SuspendOwnStreamingPreview -= OnSuspendOwnStreamingPreview;
        await JSRef.DisposeSilentlyAsync("dispose");
        JSRef = null!;
        await base.DisposeAsync();
    }

    protected override ComputedState<Model>.Options GetStateOptions()
        => ComputedStateComponent.GetStateOptions(GetType(),
            t => new ComputedState<Model>.Options {
                InitialValue = Model.None,
                UpdateDelayer = FixedDelayer.NextTick,
                Category = GetStateCategory(t),
            });

    protected override async Task<Model> ComputeState(CancellationToken cancellationToken) {
        var chatId = ChatId;
        if (_isSuspended)
            return _suspendedModel;

        var isOwnRecording = SourceKind == VideoSourceKind.Camera
            && await ChatVideoUI.IsOwnCameraRecording(chatId, cancellationToken).ConfigureAwait(false);
        var isOwnScreenCasting = SourceKind == VideoSourceKind.ScreenCast
            && await ChatVideoUI.IsOwnScreenCasting(chatId, cancellationToken).ConfigureAwait(false);
        var hasRemoteStreams = await ChatVideoUI.HasRemoteStreams(chatId, cancellationToken).ConfigureAwait(false);
        var lastError = await ChatVideoUI.GetLastVideoRecorderError(SourceKind, cancellationToken).ConfigureAwait(false);
        var isMirrored = await ChatVideoUI.GetIsCameraMirrored(cancellationToken).ConfigureAwait(false);
        return new Model(isOwnRecording, isOwnScreenCasting, !hasRemoteStreams, lastError, isMirrored);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (!firstRender)
            return;

        JSRef = await JS.InvokeAsync<IJSObjectReference>(JSCreateMethod, Ref, (int)SourceKind);
        ChatVideoUI.SuspendOwnStreamingPreview += OnSuspendOwnStreamingPreview;
    }

    private void OnSettingsClick()
        => ChatVideoUI.ChangeVideoSessionSettings(ChatId);

    private void OnSuspendOwnStreamingPreview(bool suspended) {
        _suspendedModel = suspended ? State.Value : Model.None;
        _isSuspended = suspended;
        _ = State.Recompute();
        if (JSRef is null)
            return;
        _ = JSRef.InvokeVoidAsync("setPaused", suspended);
    }

    // Nested types

    public sealed record Model(
        bool IsOwnRecording,
        bool IsOwnScreenCasting,
        bool IsAloneOnStream,
        string? LastErrorMessage,
        bool IsCameraMirrored) {
        public static readonly Model None = new(false, false, true, null, true);
    }
}
