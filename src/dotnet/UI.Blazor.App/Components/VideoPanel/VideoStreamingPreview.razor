@namespace ActualChat.UI.Blazor.App.Components.VideoPanel
@using ActualChat.Streaming
@using ActualChat.UI.Blazor.App.Module
@inherits ComputedStateComponent<AppUIHub, VideoStreamingPreview.Model>
@{
    var m = State.Value;
    var isRecording = m.OwnStreamingState?.Kind == StreamKind.Webcam;
    var isScreencasting = m.OwnStreamingState?.Kind == StreamKind.Screencast;
    var recordingCls = isRecording ? "recording" : "";
    var screencastCls = isScreencasting ? "screencast" : "";
}

<div @ref="Ref" class="video-streaming-preview @recordingCls @screencastCls">
    <canvas
        class="call-video"
        @onclick="@(isRecording && !m.IsAloneOnStream ? OnSettingsClick : null!)"></canvas>
    <div class="video-loading">
        <span class="spinner-icon-wrapper">
            <img src="/dist/images/loading-spinner.svg" class="spinner-icon animate-spin" alt="loading"/>
        </span>
    </div>
    @if (isRecording && m.IsAloneOnStream) {
        <HeaderButton Class="settings-btn" Click="@OnSettingsClick">
            <i class="icon-settings text-lg"></i>
        </HeaderButton>
    }
    <div class="video-participant-label">
        <i class="icon-video"></i>
        <span>You</span>
    </div>
    @if (m.LastErrorMessage is {} errorMessage && errorMessage.Length > 0) {
        <div class="video-error">
            <span>@errorMessage</span>
        </div>
    }
</div>

@code {
    private static readonly string JSCreateMethod = $"{BlazorUIAppModule.ImportName}.VideoStreamingPreview.create";

    private ChatVideoUI ChatVideoUI => Hub.ChatVideoUI;
    private ElementReference Ref { get; set; }
    private IJSObjectReference? JSRef { get; set; }

    [Parameter, EditorRequired] public ChatId ChatId { get; set; }

    public override async ValueTask DisposeAsync() {
        await JSRef.DisposeSilentlyAsync("dispose");
        JSRef = null!;
        await base.DisposeAsync();
    }

    protected override ComputedState<Model>.Options GetStateOptions()
        => ComputedStateComponent.GetStateOptions(GetType(),
            t => new ComputedState<Model>.Options {
                InitialValue = Model.None,
                UpdateDelayer = FixedDelayer.NextTick,
                Category = GetStateCategory(t),
            });

    protected override async Task<Model> ComputeState(CancellationToken cancellationToken) {
        var chatId = ChatId;
        var streamingState = await ChatVideoUI.GetVideoStreamingState(chatId, cancellationToken).ConfigureAwait(false);
        var hasRemoteStreams = await ChatVideoUI.HasRemoteStreams(chatId, cancellationToken).ConfigureAwait(false);
        var lastError = await ChatVideoUI.GetLastVideoRecorderError(cancellationToken).ConfigureAwait(false);
        return new Model(streamingState, !hasRemoteStreams, lastError);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (!firstRender)
            return;

        JSRef = await JS.InvokeAsync<IJSObjectReference>(JSCreateMethod, Ref);
    }

    private void OnSettingsClick()
        => ChatVideoUI.ChangeVideoSessionSettings(ChatId);

    // Nested types

    public sealed record Model(VideoStreamingState? OwnStreamingState, bool IsAloneOnStream, string? LastErrorMessage) {
        public static readonly Model None = new(null, true, null);
    }
}
