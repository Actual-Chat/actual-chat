@namespace ActualChat.UI.Blazor.App.Components.VideoPanel
@using ActualChat.Streaming
@using ActualChat.UI.Blazor.App.Module
@using ActualChat.UI.Blazor.App.Services.Video
@inherits ComputedStateComponent<AppUIHub, VideoStreamingPreview.Model>
@{
    var m = State.Value;
    var isCameraSource = SourceKind == VideoSourceKind.Camera;
    var isOwnCameraRecording = m.IsOwnCameraRecording;
    var isOwnScreenCasting = m.IsOwnScreenCasting;
    var isActiveRecording = isCameraSource ? isOwnCameraRecording : isOwnScreenCasting;
    var recordingCls = isCameraSource && isOwnCameraRecording ? "recording" : "";
    var screenCastCls = !isCameraSource && isOwnScreenCasting ? "screencast" : "";
    // Mirror only for camera. ScreenCast is never mirrored.
    var mirrorCls = isCameraSource && m.IsCameraMirrored ? "" : "no-mirror";
    // On a camera tile that is also screencasting, show both icons so the
    // local user can see they're broadcasting in two ways at once.
    var showDualIcons = isCameraSource && isOwnCameraRecording && isOwnScreenCasting;
    var labelIcon = isCameraSource ? "icon-video" : "icon-screen-share";
}

<div @ref="Ref" class="video-track-player video-streaming-preview @Class @recordingCls @screenCastCls">
    <canvas class="remote-video-bg" aria-hidden="true"></canvas>
    <video class="call-video-native live-stream-video @mirrorCls"
           autoplay playsinline muted aria-hidden="true"
           disablepictureinpicture disableremoteplayback
           controlslist="nodownload nofullscreen noremoteplayback"></video>
    <canvas
        class="call-video @mirrorCls"
        @onclick="@(isActiveRecording && !m.IsAloneOnStream ? OnSettingsClick : null!)"></canvas>
    <div class="video-loading">
        <span class="spinner-icon-wrapper">
            <img src="/dist/images/loading-spinner.svg" class="spinner-icon animate-spin" alt="loading"/>
        </span>
    </div>
    <div class="video-participant-label">
        @if (showDualIcons) {
            <i class="icon-screen-share"></i>
            <i class="icon-video"></i>
        } else {
            <i class="@labelIcon"></i>
        }
        <span>You</span>
        <span class="video-fps" data-source-kind="@((int)SourceKind)"></span>
    </div>
    @if (m.LastErrorMessage is {} errorMessage && errorMessage.Length > 0) {
        <div class="video-error">
            <span>@errorMessage</span>
        </div>
    }
</div>

@code {
    private static readonly string JSCreateMethod = $"{BlazorUIAppModule.ImportName}.VideoStreamingPreview.create";

    private Chat Chat => ChatContext.Chat;
    private CameraUI CameraUI => Hub.CameraUI;
    private ChatVideoUI ChatVideoUI => Hub.ChatVideoUI;
    private ElementReference Ref { get; set; }
    private IJSObjectReference? JSRef { get; set; }
    private INativeCameraPreview? _nativePreview;
    private bool _isSuspended;
    private Model _suspendedModel = Model.None;

    // Mac Catalyst: the WKWebView can't render getUserMedia, so the self-tile is
    // fed native JPEG frames captured alongside the live publish, same as the
    // join-video preview modal. Camera source only; ScreenCast stays on JS.
    private bool UseNativePreview => OperatingSystem.IsMacCatalyst() && SourceKind == VideoSourceKind.Camera;

    [CascadingParameter] public ChatContext ChatContext { get; set; } = null!;
    [Parameter, EditorRequired] public VideoSourceKind SourceKind { get; set; }
    [Parameter] public string Class { get; set; } = "";

    public override async ValueTask DisposeAsync() {
        ChatVideoUI.SuspendOwnStreamingPreview -= OnSuspendOwnStreamingPreview;
        if (_nativePreview is not null) {
            await _nativePreview.DisposeAsync().ConfigureAwait(false);
            _nativePreview = null;
        }
        await JSRef.DisposeSilentlyAsync("dispose");
        JSRef = null!;
        await base.DisposeAsync();
    }

    protected override ComputedState<Model>.Options GetStateOptions()
        => ComputedStateComponent.GetStateOptions(GetType(),
            t => new ComputedState<Model>.Options {
                InitialValue = Model.None,
                UpdateDelayer = FixedDelayer.NextTick,
                Category = GetStateCategory(t),
            });

    protected override async Task<Model> ComputeState(CancellationToken cancellationToken) {
        var chatId = Chat.Id;
        if (_isSuspended)
            return _suspendedModel;

        // Both fields reflect the user's actual streaming state regardless of
        // SourceKind: the camera tile needs to know whether the user is also
        // screencasting in order to render dual icons in its label.
        var isOwnCameraRecording = await ChatVideoUI.IsOwnCameraRecording(chatId, cancellationToken).ConfigureAwait(false);
        var isOwnScreenCasting = await ChatVideoUI.IsOwnScreenCasting(chatId, cancellationToken).ConfigureAwait(false);
        var hasRemoteStreams = await ChatVideoUI.HasRemoteStreams(chatId, cancellationToken).ConfigureAwait(false);
        var lastError = await ChatVideoUI.GetLastVideoRecorderError(SourceKind, cancellationToken).ConfigureAwait(false);
        var isMirrored = await CameraUI.GetIsMirrored(cancellationToken).ConfigureAwait(false);
        return new Model(isOwnCameraRecording, isOwnScreenCasting, !hasRemoteStreams, lastError, isMirrored);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (firstRender) {
            JSRef = await JS.InvokeAsync<IJSObjectReference>(
                JSCreateMethod, Ref, (int)SourceKind, UseNativePreview);
            ChatVideoUI.SuspendOwnStreamingPreview += OnSuspendOwnStreamingPreview;
        }

        if (UseNativePreview)
            await SyncNativePreview();
    }

    // Run the native capture-backed preview exactly while the local camera is
    // recording and the surface isn't suspended (a JoinVideoCallModal is not
    // taking over). Starting it opens a second AVCaptureSession on the same
    // camera the publisher uses — macOS shares the device across sessions.
    private async Task SyncNativePreview() {
        var shouldRun = !_isSuspended && State.Value.IsOwnCameraRecording;
        if (shouldRun && _nativePreview is null) {
            _nativePreview = Hub.Services.GetService<INativeCameraPreviewFactory>()?.Create(Hub);
            _nativePreview?.Start(CameraUI.LastDeviceId, OnNativePreviewFrame);
        }
        else if (!shouldRun && _nativePreview is not null) {
            await _nativePreview.DisposeAsync().ConfigureAwait(false);
            _nativePreview = null;
        }
    }

    // Runs on the capture thread; marshal to the Blazor dispatcher before
    // touching JSRef and let the returned task gate the native side.
    private ValueTask OnNativePreviewFrame(byte[] jpeg) {
        var base64 = Convert.ToBase64String(jpeg);
        return new ValueTask(InvokeAsync(async () => {
            var jsRef = JSRef;
            if (jsRef is null)
                return;

            try {
                await jsRef.InvokeVoidAsync("renderPreviewFrame", base64);
            }
            catch {
                // The renderer/JS ref can go away as the tile unmounts — a
                // dropped preview frame is harmless.
            }
        }));
    }

    private void OnSettingsClick()
        => ChatVideoUI.ChangeVideoSessionSettings(Chat.Id);

    private void OnSuspendOwnStreamingPreview(bool suspended) {
        _suspendedModel = suspended ? State.Value : Model.None;
        _isSuspended = suspended;
        _ = State.Recompute();
        if (JSRef is null)
            return;
        _ = JSRef.InvokeVoidAsync("setPaused", suspended);
    }

    // Nested types

    public sealed record Model(
        bool IsOwnCameraRecording,
        bool IsOwnScreenCasting,
        bool IsAloneOnStream,
        string? LastErrorMessage,
        bool IsCameraMirrored) {
        public static readonly Model None = new(false, false, true, null, true);
    }
}
