@namespace ActualChat.UI.Blazor.App.Components.VideoPanel
@implements IModalView<ScreenCastAlreadyActiveModal.Model>
@inherits ComponentBase<AppUIHub>

<DialogFrame Title="@L.Call_ScreenShareActiveTitle" Class="modal-sm">
    <Body>
    <FormBlock>
        <p>@L.Call_ScreenShareActiveText</p>
    </FormBlock>
    </Body>
    <Buttons>
        <Button Class="btn-modal btn-primary" Click="@(_ => Modal.Close())">@L.Common_OK</Button>
    </Buttons>
</DialogFrame>

@code {
    [CascadingParameter] public Modal Modal { get; set; } = null!;
    [Parameter] public Model ModalModel { get; set; } = null!;

    public sealed record Model;
}
