@inherits ComputedStateComponent<AppUIHub, bool>
@{
    var isFollowing = State.Value;
    var iconCls = isFollowing ? "icon-eye" : "icon-eye-off";
    var tooltip = isFollowing ? L.ChatHeader_UnfollowThread : L.ChatHeader_FollowThread;
}

<HeaderButton
    Click="OnToggle"
    Tooltip="@tooltip"
    TooltipPosition="FloatingPosition.Bottom">
    <i class="@iconCls"></i>
</HeaderButton>

@code {
    [Parameter, EditorRequired] public ThreadChatId ThreadChatId { get; set; } = null!;

    private IChatThreads ChatThreads => Hub.ChatThreads;

    protected override Task<bool> ComputeState(CancellationToken cancellationToken)
        => ChatThreads.GetThreadFollowStatus(Session, ThreadChatId, cancellationToken);

    private async Task OnToggle()
        => await UICommander.Call(new ChatThreads_ToggleThreadFollowStatus {
            Session = Session,
            ThreadChatId = ThreadChatId,
        }).ConfigureAwait(false);
}
