@inherits ComputedStateComponent<bool>
@{
    var isFollowing = State.Value;
    var iconCls = isFollowing ? "icon-eye" : "icon-eye-off";
    var tooltip = isFollowing ? "Unfollow thread" : "Follow thread";
}

<HeaderButton
    Click="OnToggle"
    Tooltip="@tooltip"
    TooltipPosition="FloatingPosition.Bottom">
    <i class="@iconCls"></i>
</HeaderButton>

@code {
    [Inject] private ChatUIHub Hub { get; init; } = null!;

    [Parameter, EditorRequired] public ChatId ThreadChatId { get; set; } = ChatId.None;

    private Session Session => Hub.Session();
    private IChatThreads ChatThreads => Hub.ChatThreads;
    private UICommander UICommander => Hub.UICommander();

    protected override Task<bool> ComputeState(CancellationToken cancellationToken)
        => ChatThreads.GetThreadFollowStatus(Session, ThreadChatId, cancellationToken);

    private async Task OnToggle()
        => await UICommander.Call(new ChatThreads_ToggleThreadFollowStatus(Session, ThreadChatId)).ConfigureAwait(false);
}
