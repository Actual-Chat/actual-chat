@namespace ActualChat.UI.Blazor.App.Components
@using ActualChat.UI.Blazor.App.Module
@inherits ComputedStateComponent<AppUIHub, ChatActivityPanel.Model?>
@{
    var m = State.Value;
    if (m is null)
        return;

    var isVisible = m.IsAnyoneTalking || m.HasRemoteStreams || m.IsListening || m.IsRecordingHere || m.IsWatchingHere;
    if (!isVisible)
        return;

    var iconSize = ScreenSize.IsNarrow() ? 6 : 8;
    var isListening = m.IsListening;
    var isRecordingHere = m.IsRecordingHere;
    var isWatchingHere = m.IsWatchingHere;
    var isOwnVideoStreaming = m.IsOwnVideoStreaming;
    var isParticipating = isListening || isRecordingHere || isOwnVideoStreaming;
    var isActive = m.IsAnyoneTalking;
    var iconMode = m.HasRemoteStreams ? "video" : "audio";
    var tooltip = isListening ? "Listening..." : "Listen";
    var cls = isListening ? " listening" : "";
    if (m.HasRemoteStreams) cls += " video-streaming";
    if (!isParticipating)
        cls += " not-participating";
    if (isWatchingHere)
        cls += " watching";
    var joinButtonText = "Join muted";
}

<div @ref="Ref"
     class="chat-activity-panel @cls"
     role="button"
     tabindex="0"
     @onclick:preventDefault="true"
     @onclick:stopPropagation="true"
     @onclick="@Click">
    <div class="c-pin-badge">
        <span class="c-badge-content">
            <i class="icon-arrow-down"></i> Pin panel
        </span>
    </div>
    @if (m.HasRemoteStreams) {
        <div class="c-film-strip"></div>
    }
    @if (!isParticipating) {
        @* Camera/audio icon - shown when not participating *@
        <div class="c-icon hideable">
            <chat-activity-panel-icon-svg size="@iconSize" isActive="@isActive" mode="@iconMode"/>
        </div>
    }
    @* Talking heads - shown when anyone is talking *@
    @if (m.IsAnyoneTalking) {
        <ChatActivities
            @key="@Chat.Id.Value"
            MaxCount="@MaxCount"
            IsListening="@isListening"/>
    }
    <div class="flex-1"></div>
    <div class="c-buttons">
        @if (m.CanShowAudioDiagnostics) {
            <HeaderButton
                Class="c-diagnostics-btn"
                StopPropagation="true"
                PreventDefault="true"
                Click="@OnAudioDiagnosticsClick"
                Tooltip="Audio diagnostics"
                TooltipPosition="FloatingPosition.Bottom">
                <i class="icon-activity"></i>
            </HeaderButton>
        }
        <StopLocationSharingButton/>
        @if (!isListening && !isRecordingHere && !isOwnVideoStreaming) {
            <Button
                Class="btn-sm btn-transparent unhovered not-listening"
                StopPropagation="true"
                PreventDefault="true"
                Click="@OnJoinClick"
                Tooltip="@tooltip"
                TooltipPosition="FloatingPosition.Bottom">
                @joinButtonText
            </Button>
        } else if (isRecordingHere || isOwnVideoStreaming || isWatchingHere) {
            <HeaderButton
                Class="talking"
                StopPropagation="true"
                PreventDefault="true"
                Click="@OnHangUpClick"
                Tooltip="@tooltip"
                TooltipPosition="FloatingPosition.Bottom">
                <i class="icon-phone-off"></i>
            </HeaderButton>
        } else {
            <StopListeningCountdownButton ChatId="@Chat.Id" Click="@OnStopListeningClick"/>
        }
    </div>
</div>

@code {
    private static readonly string JSCreateMethod = $"{BlazorUIAppModule.ImportName}.ChatActivityPanel.create";
    private readonly TaskSerializer _taskSerializer = new();
    private CpuTimestamp _lastActionAt;

    private ElementReference Ref { get; set; }
    private IJSObjectReference JSRef { get; set; } = null!;

    private Chat Chat => ChatContext.Chat;
    private LiveStreamUI LiveStreamUI => Hub.LiveStreamUI;
    private ChatAudioUI ChatAudioUI => Hub.ChatAudioUI;
    private ChatVideoUI ChatVideoUI => Hub.ChatVideoUI;
    private ActiveChatsUI ActiveChatsUI => Hub.ActiveChatsUI;
    private AudioDiagnosticsUI AudioDiagnosticsUI => Hub.AudioDiagnosticsUI;

    [CascadingParameter] public ChatContext ChatContext { get; set; } = null!;
    [CascadingParameter] public ScreenSize ScreenSize { get; set; }
    [Parameter] public int MaxCount { get; set; } = 5;
    [Parameter] public EventCallback Click { get; set; }

    public override async ValueTask DisposeAsync() {
        await JSRef.DisposeSilentlyAsync("dispose");
        JSRef = null!;
        await base.DisposeAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (firstRender && ScreenSize.IsNarrow())
            JSRef = await JS.InvokeAsync<IJSObjectReference>(JSCreateMethod, Ref);
    }

    protected override async Task<Model?> ComputeState(CancellationToken cancellationToken) {
        var chat = Chat;
        var audioState = await ChatAudioUI.GetState(chat.Id).ConfigureAwait(false);
        var isAnyoneTalking = await LiveStreamUI.IsAnyoneStreaming(chat.Id, cancellationToken).ConfigureAwait(false);
        var hasRemoteStreams = await ChatVideoUI.HasRemoteStreams(chat.Id, cancellationToken).ConfigureAwait(false);
        var ownSourceKind = await ChatVideoUI.GetOwnSourceKind(chat.Id, cancellationToken).ConfigureAwait(false);
        var isOwnVideoStreaming = ownSourceKind is not null;
        var watchingChatId = await ChatVideoUI.GetWatchingChatId(cancellationToken).ConfigureAwait(false);
        var isWatchingHere = chat.Id == watchingChatId;
        var canShowAudioDiagnostics = await AudioDiagnosticsUI.IsEnabled(cancellationToken).ConfigureAwait(false);
        return new (
            audioState, isAnyoneTalking, hasRemoteStreams,
            isOwnVideoStreaming, isWatchingHere, canShowAudioDiagnostics);
    }

    private void OnAudioDiagnosticsClick()
        => ChatAudioUI.ShowAudioDiagnostics(Chat.Id);

    private async Task OnJoinClick() {
        // User is not participating — join with listening only (no recording, no camera)
        _ = ChatAudioUI.SetListeningState(Chat.Id, true);
        var isAnyoneVideoStreaming = await ChatVideoUI.IsAnyoneVideoStreaming(Chat.Id, CancellationToken.None)
            .ConfigureAwait(false);
        if (isAnyoneVideoStreaming)
            ChatVideoUI.OpenVideoPanel(Chat.Id);
    }

    private async Task OnHangUpClick() {
        var audioState = await ChatAudioUI.GetState(Chat.Id).ConfigureAwait(false);
        if (audioState.IsRecording)
            StopRecording(Chat.Id);
        ChatVideoUI.StopStreaming();
        ChatVideoUI.CloseVideoPanel();
        _ = ChatAudioUI.SetListeningState(Chat.Id, false);
    }

    private void OnStopListeningClick()
        => _ = ChatAudioUI.SetListeningState(Chat.Id, false);

    private void StopRecording(ChatId chatId) {
        if (!IsValidAction())
            return;

        _ = _taskSerializer.Enqueue(async _ => {
            var activeChats = ActiveChatsUI.ActiveChats.Value;
            var recordingChatId = activeChats.FirstOrDefault(c => c.IsRecording)?.ChatId;
            if (recordingChatId == chatId)
                await ChatAudioUI.SetRecordingChatId(null).ConfigureAwait(false); // .ConfigureAwait(false) is fine here
        }, mustAbortPreviousTasks: true);
    }

    private bool IsValidAction() {
        if (_lastActionAt.Elapsed < TimeSpan.FromMilliseconds(500))
            return false; // Rapid action sequence is likely a mistake

        _lastActionAt = CpuTimestamp.Now;
        return true;
    }

    // Nested types

    public sealed record Model(
        ChatAudioState AudioState,
        bool IsAnyoneTalking,
        bool HasRemoteStreams,
        bool IsOwnVideoStreaming,
        bool IsWatchingHere,
        bool CanShowAudioDiagnostics) {
        public bool IsListening => AudioState.IsListening;
        public bool IsRecordingHere => AudioState.IsRecording;
    }
}
