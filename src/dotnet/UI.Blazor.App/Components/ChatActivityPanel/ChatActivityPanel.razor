@namespace ActualChat.UI.Blazor.App.Components
@using ActualChat.UI.Blazor.App.Module
@inherits ComputedStateComponent<AppUIHub, ChatActivityPanel.Model?>
@{
    var m = State.Value;
    if (m is null)
        return;

    var isVisible = m.IsAnyoneTalking || m.IsAnyoneVideoStreaming || m.AudioState.IsListening || IsRecordingHere;
    if (!isVisible)
        return;

    var chat = Chat;
    var chatId = chat?.Id;
    var iconSize = ScreenSize.IsNarrow() ? 6 : 8;
    var isActive = m.IsAnyoneTalking;
    var showVideoIcon = m.IsAnyoneVideoStreaming && !m.IsAnyoneTalking;
    var iconMode = showVideoIcon ? "video" : "audio";
    var tooltip = IsListening ? "Listening..." : "Listen";
    var cls = IsListening ? " listening" : "";
    var joinButtonText = m.IsAnyoneVideoStreaming ? "Join" : "Join muted";
}

<div @ref="Ref"
     class="chat-activity-panel @cls"
     @onclick:preventDefault="true"
     @onclick:stopPropagation="true"
     @onclick="@Click">
    @* Camera icon - shown when anyone is video streaming *@
    <div class="c-icon hideable">
        <chat-activity-panel-icon-svg size="@iconSize" isActive="@isActive" mode="@iconMode"/>
    </div>
    @* Talking heads - shown when anyone is talking *@
    @if (m.IsAnyoneTalking && chatId is not null) {
        <ChatActivities
            @key="@chatId.Value"
            Chat="@chat"
            MaxCount="@MaxCount"
            IsListening="@IsListening"/>
    }
    @if (m.IsAnyoneVideoStreaming && m.VideoStreamMemberCount > 0) {
        <div class="c-member-count">@m.VideoStreamMemberCount watching</div>
    }
    <div class="flex-1"></div>
    <div class="c-buttons">
        @if (!IsListening && !IsRecordingHere) {
            <Button
                Class="btn-sm btn-transparent unhovered not-listening"
                StopPropagation="true"
                PreventDefault="true"
                Click="@OnClick"
                Tooltip="@tooltip"
                TooltipPosition="FloatingPosition.Bottom"
                MustKeepAwake="@(!IsListening)">
                @joinButtonText
            </Button>
        } else if (IsRecordingHere) {
            <HeaderButton
                Class="talking"
                StopPropagation="true"
                PreventDefault="true"
                Click="@OnClick"
                Tooltip="@tooltip"
                TooltipPosition="FloatingPosition.Bottom"
                MustKeepAwake="@(!IsListening)">
                <i class="icon-phone-off"></i>
            </HeaderButton>
        } else {
            const double countdownSeconds = 30;
            const double circumference = 100.531;
            var remainingSeconds = m.StopListeningAt.HasValue
                ? Math.Max(0, (m.StopListeningAt.Value - Hub.Clocks.CpuClock.Now).TotalSeconds)
                : 0;
            var hasRing = m.StopListeningAt.HasValue || IsListening;
            var isCountingDown = remainingSeconds > 0 && remainingSeconds <= countdownSeconds;
            var dashOffset = isCountingDown
                ? (circumference * (1 - remainingSeconds / countdownSeconds)).ToString("F2", CultureInfo.InvariantCulture)
                : "0";
            <div class="listening-timer">
                @if (hasRing) {
                    <svg class="timer-ring" viewBox="0 0 36 36"
                         data-bubble="@(BubbleRef.New<ListeningTimerBubble>())"
                         data-bubble-priority="115"
                         data-bubble-placement="@(FloatingPosition.Bottom.ToPositionString())">
                        <circle class="timer-ring-bg"
                                cx="18" cy="18" r="16" />
                        <circle class="timer-ring-circle"
                                cx="18" cy="18" r="16"
                                style="stroke-dashoffset: @(dashOffset)" />
                    </svg>
                }
                <HeaderButton
                    Class="listening"
                    StopPropagation="true"
                    PreventDefault="true"
                    Click="@OnClick"
                    Tooltip="@tooltip"
                    TooltipPosition="FloatingPosition.Bottom"
                    MustKeepAwake="@(!IsListening)">
                    @if (isCountingDown) {
                        var remaining = (int)Math.Ceiling(remainingSeconds);
                        var mm = remaining / 60;
                        var ss = remaining % 60;
                        <span class="timer-icon-swap">
                            <i class="icon-listen swap-a"></i>
                            <span class="swap-b timer-countdown-text">@($"{mm:D2}:{ss:D2}")</span>
                        </span>
                    } else {
                        <i class="icon-listen"></i>
                    }
                </HeaderButton>
            </div>
        }
    </div>
</div>

@code {
    private static readonly string JSCreateMethod = $"{BlazorUIAppModule.ImportName}.ChatActivityPanel.create";
    private readonly TaskSerializer _taskSerializer = new();
    private CpuTimestamp _lastActionAt;
    private bool _wasListening;

    private ElementReference Ref { get; set; }
    private IJSObjectReference JSRef { get; set; } = null!;

    private LiveStreamUI LiveStreamUI => Hub.LiveStreamUI;
    private ChatAudioUI ChatAudioUI => Hub.ChatAudioUI;
    private ChatVideoUI ChatVideoUI => Hub.ChatVideoUI;
    private ActiveChatsUI ActiveChatsUI => Hub.ActiveChatsUI;

    private ChatId? RecordingChatId {
        get {
            var activeChats = ActiveChatsUI.ActiveChats.Value;
            var recordingChat = activeChats.FirstOrDefault(c => c.IsRecording);
            return recordingChat?.ChatId;
        }
    }

    private bool IsRecordingHere => Chat?.Id is not null && RecordingChatId == Chat.Id;
    private bool IsUpdating => Chat?.Id is not null && State.Value?.Chat.Id != Chat.Id;
    private bool IsListening => !IsUpdating && State is { Value.AudioState.IsListening: true };

    [CascadingParameter] public ScreenSize ScreenSize { get; set; }
    [Parameter, EditorRequired] public Chat? Chat { get; set; }
    [Parameter] public int MaxCount { get; set; } = 5;
    [Parameter] public EventCallback Click { get; set; }

    public override async ValueTask DisposeAsync() {
        await JSRef.DisposeSilentlyAsync("dispose");
        JSRef = null!;
        await base.DisposeAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (firstRender && ScreenSize.IsNarrow()) {
            JSRef = await JS.InvokeAsync<IJSObjectReference>(JSCreateMethod, Ref);
        }
    }

    protected override async Task<Model?> ComputeState(CancellationToken cancellationToken) {
        var chat = Chat;
        var chatId = chat?.Id;
        if (chat is null || chatId is null)
            return null;

        var audioState = await ChatAudioUI.GetState(chatId).ConfigureAwait(false);
        var isAnyoneTalking = await LiveStreamUI.IsAnyoneStreaming(chatId, cancellationToken).ConfigureAwait(false);
        var isVideoStreamingEnabled = await Hub.Features.IsVideoStreamingEnabled(cancellationToken).ConfigureAwait(false);
        var isAnyoneVideoStreaming = isVideoStreamingEnabled
            && await ChatVideoUI.IsAnyoneVideoStreaming(chatId, cancellationToken).ConfigureAwait(false);
        var videoStreamMemberCount = isAnyoneVideoStreaming
            ? await ChatVideoUI.GetVideoStreamMemberCount(chatId, cancellationToken).ConfigureAwait(false)
            : 0;
        var stopListeningAt = audioState.IsListening
            ? await ChatAudioUI.GetStopListeningAt(chatId, cancellationToken).ConfigureAwait(false)
            : null;
        if (stopListeningAt.HasValue) {
            var remaining = (stopListeningAt.Value - Hub.Clocks.CpuClock.Now).TotalSeconds;
            if (remaining > 30)
                Computed.GetCurrent()?.Invalidate(TimeSpan.FromSeconds(remaining - 30));
            else if (remaining > 0) {
                // Align invalidation to the next second boundary for consistent countdown ticks
                var fractional = remaining - Math.Floor(remaining);
                var delay = fractional > 0.05 ? fractional : fractional + 1.0;
                Computed.GetCurrent()?.Invalidate(TimeSpan.FromSeconds(delay));
            }
        }

        // Re-show listening hint bubble each time listening starts
        var isListening = audioState.IsListening;
        if (isListening && !_wasListening)
            _ = Hub.BubbleUI.UnreadBubble<ListeningTimerBubble>();
        _wasListening = isListening;

        return new (chat, audioState, isAnyoneTalking, isAnyoneVideoStreaming, videoStreamMemberCount, stopListeningAt);
    }

    private void OnClick() {
        if (IsUpdating || Chat?.Id is not { } chatId)
            return;

        if (IsListening && IsRecordingHere)
            StopRecording();

        var isVideoStreaming = State.Value?.IsAnyoneVideoStreaming == true;
        if (isVideoStreaming) {
            // When joining a video call: open modal AND start listening
            _ = ModalUI.Show(new JoinVideoCallModal.Model(Chat!));
        }
        // Normal audio join/leave behavior
        _ = ChatAudioUI.SetListeningState(chatId, !IsListening);
    }

    private void StopRecording() {
        if (!IsValidAction())
            return;

        _ = _taskSerializer.Enqueue(async _ => {
            // .ConfigureAwait(false) is fine here
            if (RecordingChatId is not null)
                await ChatAudioUI.SetRecordingChatId(null).ConfigureAwait(false);
        }, mustAbortPreviousTasks: true);
    }

    private bool IsValidAction() {
        if (_lastActionAt.Elapsed < TimeSpan.FromMilliseconds(500))
            return false; // Rapid action sequence is likely a mistake

        _lastActionAt = CpuTimestamp.Now;
        return true;
    }

    // Nested types

    public sealed record Model(
        Chat Chat,
        ChatAudioState AudioState,
        bool IsAnyoneTalking,
        bool IsAnyoneVideoStreaming,
        int VideoStreamMemberCount,
        Moment? StopListeningAt = null);
}
