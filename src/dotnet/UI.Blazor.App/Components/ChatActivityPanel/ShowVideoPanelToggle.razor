@namespace ActualChat.UI.Blazor.App.Components
@inherits ComputedStateComponent<AppUIHub, bool>
@{
    var isVisible = State.Value;
}

<HeaderButton
    Class="video-panel-toggle"
    StopPropagation="true"
    PreventDefault="true"
    Click="@(() => OnToggleVideoPanel(!isVisible))">
    @if (isVisible) {
        <i class="icon-video-expand"></i>
    } else {
        <i class="icon-video-collapse"></i>
    }
</HeaderButton>

@code {
    private ChatVideoUI ChatVideoUI => Hub.ChatVideoUI;

    [Parameter, EditorRequired] public ChatId ChatId { get; set; }

    protected override async Task<bool> ComputeState(CancellationToken cancellationToken) {
        var chatId = ChatId;
        var watchingChatId = await ChatVideoUI.GetWatchingChatId(cancellationToken).ConfigureAwait(false);
        var isWatching = watchingChatId == chatId;
        if (!isWatching)
            return false;

        var isVideoPanelCollapsed = await ChatVideoUI.GetIsVideoPanelCollapsed(cancellationToken).ConfigureAwait(false);
        return !isVideoPanelCollapsed;
    }

    private async Task OnToggleVideoPanel(bool show) {
        if (show) {
            var watchingChatId = await ChatVideoUI.GetWatchingChatId(CancellationToken.None).ConfigureAwait(false);
            if (watchingChatId != ChatId) {
                if (watchingChatId is null)
                    ChatVideoUI.OpenVideoPanel(ChatId);
                else
                    return; // Watcher is already watching another chat
            }
        }
        ChatVideoUI.SetVideoPanelCollapsed(!show);
    }
}
