@using ActualChat.Hosting
@inherits ComputedStateComponent<AppUIHub, AppSettings.Model>
@inject IStringLocalizer<Strings> L
@{
    var m = State.Value;
    var dataCollectionStatus = m.IsDataCollectionEnabled
        ? L["AppSettings_TelemetryAllowed"].Value
        : L["AppSettings_TelemetryDisallowed"].Value;
}

@if (NativeAppSettings != null) {
    <NativeAppSettingsView NativeAppSettings="@NativeAppSettings"></NativeAppSettingsView>
}
@if (HostInfo.HostKind != HostKind.MauiApp) {
    <RenderModeSelector/>
}
<TileTopic Topic="@L["AppSettings_TelemetryDataCollection"].Value"/>
<Tile Class="data-collection-consent">
    <TileItem Click="@OnEnableTelemetryClick">
        <Icon><i class="icon-info text-2xl"></i></Icon>
        <Content>@L["AppSettings_AllowTelemetry"]</Content>
        <Caption>@dataCollectionStatus</Caption>
        <Right>
            <Toggle IsChecked="@m.IsDataCollectionEnabled"/>
        </Right>
    </TileItem>
    <p class="c-description">
        @L["AppSettings_TelemetryDescription_Format", CoreConstants.AppName]
    </p>
</Tile>

<TileTopic Topic="@L["UserInterface_WalkThrough"].Value"/>
<Button
    Class="add-avatar-btn"
    Click="@(OnRestartWalkThrough)">
    <Icon><i class="icon-refresh text-xl"></i></Icon>
    <Title>@L["UserInterface_RestartWalkThrough"]</Title>
</Button>

@if (m.IsAdmin) {
    <TileTopic Topic="@L["UserInterface_Onboarding"].Value"/>
    <Button
        Class="add-avatar-btn"
        Click="@(OnRestartOnboarding)">
        <Icon><i class="icon-refresh text-xl"></i></Icon>
        <Title>@L["UserInterface_RestartOnboarding"]</Title>
    </Button>
}

@code {
    private INativeAppSettings? NativeAppSettings { get; set; }

    private IDataCollectionSettingsUI DataCollectionSettingsUI => Hub.DataCollectionSettingsUI;
    private OnboardingUI OnboardingUI => Hub.OnboardingUI;
    private BubbleUI BubbleUI => Hub.BubbleUI;

    protected override void OnInitialized()
        => NativeAppSettings = Hub.Services.GetService<INativeAppSettings>();

    protected override ComputedState<Model>.Options GetStateOptions()
        => new() { InitialValue = Model.None };

    protected override async Task<Model> ComputeState(CancellationToken cancellationToken) {
        var settings = await UserSettingsUI.UserAppSettings().Get(cancellationToken).ConfigureAwait(false);
        var account = await Hub.AccountUI.OwnAccount.Use(cancellationToken).ConfigureAwait(false);
        return new(
            settings.IsDataCollectionEnabled ?? false,
            account.IsAdmin);
    }

    private async Task OnRestartWalkThrough() {
        await BubbleUI.ResetSettings();
        ToastUI.Show(L["UserInterface_WalkThroughRestarted"].Value, "icon-checkmark-circle", ToastDismissDelay.Short);
    }

    private void OnRestartOnboarding() {
        OnboardingUI.ResetSettings();
        ToastUI.Show(L["UserInterface_OnboardingRestarted"].Value, "icon-checkmark-circle", ToastDismissDelay.Short);
    }

    private async Task OnEnableTelemetryClick() {
        var settings = await UserSettingsUI.UserAppSettings().Update(x => x with {
            IsDataCollectionEnabled = !(x.IsDataCollectionEnabled ?? false),
        });
        await DataCollectionSettingsUI.UpdateState(settings.IsDataCollectionEnabled is true, CancellationToken.None);
    }

    // Nested types

    public record Model(
        bool IsDataCollectionEnabled,
        bool IsAdmin)
    {
        public static readonly Model None = new(false, false);
    }
}
