@namespace ActualChat.UI.Blazor.App.Components
@inherits ComponentBase<AppUIHub>

<TileTopic Topic="@L.RenderMode_Title"/>
<Tile Class="render-mode-tile">
    <RadioTile Options="@Options" SelectedId="@_modeKey.ToString()" SelectedIdChanged="@OnSelectedIdChanged"/>
</Tile>

@code {
    private RenderModeKey _modeKey;

    private RenderModeHelper RenderModeHelper => Services.GetRequiredService<RenderModeHelper>();

    private IReadOnlyList<RadioTileOption> Options => [
        new(nameof(RenderModeKey.Auto), L.RenderMode_Auto, L.RenderMode_AutoDescription),
        new(nameof(RenderModeKey.Server), L.RenderMode_Server, L.RenderMode_ServerDescription),
        new(nameof(RenderModeKey.Wasm), L.RenderMode_Wasm, L.RenderMode_WasmDescription),
    ];

    protected override void OnInitialized()
        => _modeKey = (RenderModeHelper.CurrentMode?.Key[0] ?? 'a') switch {
            's' => RenderModeKey.Server,
            'w' => RenderModeKey.Wasm,
            _ => RenderModeKey.Auto,
        };

    private void OnSelectedIdChanged(string id)
        => ChangeMode(Enum.Parse<RenderModeKey>(id));

    private void ChangeMode(RenderModeKey modeKey) {
        if (_modeKey == modeKey)
            return;

        _modeKey = modeKey;
        var sModeKey = modeKey switch {
            RenderModeKey.Auto => "a",
            RenderModeKey.Server => "s",
            RenderModeKey.Wasm => "w",
            _ => throw new ArgumentOutOfRangeException(nameof(modeKey), modeKey, null),
        };
        var renderMode = RenderModeDef.GetOrDefault(sModeKey);
        RenderModeHelper.ChangeMode(renderMode);
    }

    // Nested types

    public enum RenderModeKey {
        Auto = 0,
        Server,
        Wasm,
    }
}
