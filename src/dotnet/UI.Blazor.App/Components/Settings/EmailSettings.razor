@inherits ComponentBase<AppUIHub>
@implements IDisposable
@{
    #pragma warning disable IL2091

    if (!_readyToRender)
        return;

    var email = _emailForm.Email ?? "";
    var isEmailEmpty = email.IsNullOrEmpty();
    var isEmailValid = _emailFormEditContext.IsValid(() => _emailForm.Email);
    var isEmailVerified = !isEmailEmpty && _account.Identities.HasEmail(email);
}

<TileTopic Topic="@L.Email_Title"/>
<Tile>
    <Form EditContext="_emailFormEditContext">
        <DataAnnotationsValidator/>

        <FormBlock Class="email-form">
            <FormSection
                For="() => _emailForm.Email"
                InputId="@_emailForm.EmailFieldId"
                Label="@L.Email_Label"
                IsLabelInsideInput="true">
                <ChildContent>
                    <TextBox
                        @bind-Value="@_emailForm.Email"
                        Id="@_emailForm.EmailFieldId"
                        Autofocus="true"/>
                </ChildContent>
                <Right>
                    <VerificationStatus IsVerified="isEmailVerified"/>
                </Right>
            </FormSection>
            @if (isEmailValid && !isEmailVerified && !isEmailEmpty) {
                <EmailVerifier Email="@email" Class="my-3" />
            }
        </FormBlock>
    </Form>
</Tile>

@code {
    private EditContext _emailFormEditContext = null!;
    private EmailFormModel _emailForm = null!;
    private AccountFull _account = null!;
    private bool _readyToRender;

    protected override Task OnInitializedAsync() {
        _account = Hub.AccountUI.OwnAccount.Value;
        Hub.AccountUI.OwnAccount.Updated += OnOwnAccountChanged;
        _emailForm = new EmailFormModel(ComponentIdGenerator) {
            Email = _account.Email,
        };
        _emailFormEditContext = new EditContext(_emailForm);
        _emailFormEditContext.OnFieldChanged += EmailFormEditContextOnOnFieldChanged;
        _readyToRender = true;
        return Task.CompletedTask;
    }

    public void Dispose() {
        Hub.AccountUI.OwnAccount.Updated -= OnOwnAccountChanged;
        if (_emailFormEditContext != null!)
            _emailFormEditContext.OnFieldChanged -= EmailFormEditContextOnOnFieldChanged;
    }

    private void EmailFormEditContextOnOnFieldChanged(object? sender, FieldChangedEventArgs e) {
        StateHasChanged();
    }

    private void OnOwnAccountChanged(State state, StateEventKind eventKind) {
        _account = Hub.AccountUI.OwnAccount.Value;
        _ = InvokeAsync(StateHasChanged);
    }

    // Nested types

    public sealed class EmailFormModel {
        [Email] public string? Email { get; set; }

        private string FormId { get; }
        public string EmailFieldId { get; init; }

        public EmailFormModel(ComponentIdGenerator componentIdGenerator) {
            FormId = componentIdGenerator.Next("email-form");
            EmailFieldId = $"{FormId}-email";
        }
    }
}
