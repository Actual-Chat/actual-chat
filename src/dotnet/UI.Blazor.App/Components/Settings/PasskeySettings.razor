@namespace ActualChat.UI.Blazor.App.Components
@inherits ComputedStateComponent<AppUIHub, PasskeySettings.Model>
@{
    var m = State.Value;
    var passkeys = m.Passkeys;
}

<TileTopic Topic="@L.Passkeys_YourPasskeys"/>

@if (!m.CanUse && passkeys.Count == 0) {
    <p class="c-description">@L.Passkeys_Unavailable</p>
} else {
    <Tile Class="tile-flat passkey-tile">
        <div class="passkey-intro">
            <div class="c-title">@L.Passkeys_Headline</div>
            <p class="c-text">@L.Passkeys_Intro</p>
        </div>
        @if (passkeys.Count == 0) {
            <TileItem IsHoverable="false">
                <Icon><i class="icon-key"></i></Icon>
                <Content>@L.Passkeys_EmptyTitle</Content>
                <Caption>@L.Passkeys_EmptyText</Caption>
                <Right><i class="icon-info text-xl text-03"></i></Right>
            </TileItem>
        } else {
            @foreach (var passkey in passkeys) {
                <TileItem Click="@(() => OnRenameClick(passkey))">
                    <Icon><i class="icon-key"></i></Icon>
                    <Content>@passkey.Name</Content>
                    <Caption>@PasskeyFacts(passkey)</Caption>
                    <Right>
                        <div class="c-actions p-1" @onclick:stopPropagation="true">
                            <HeaderButton
                                Class="c-danger btn-sm"
                                Tooltip="@L.Passkeys_Delete"
                                Click="@(() => OnDeleteClick(passkey))">
                                <i class="icon-trash03"></i>
                            </HeaderButton>
                        </div>
                    </Right>
                </TileItem>
            }
        }
        @if (m.CanUse) {
            <TileItem Class="tile-item-action" Click="@OnAddClick">
                <Icon><i class="icon-plus"></i></Icon>
                <Content>@L.Common_Add</Content>
                <Caption>@L.Passkeys_AddCaption</Caption>
            </TileItem>
        }
    </Tile>
}

@code {
    private PasskeyUI PasskeyUI => Hub.PasskeyUI;

    protected override ComputedState<Model>.Options GetStateOptions()
        => new() {
            InitialValue = new Model(),
            Category = GetStateCategory(GetType()),
        };

    protected override async Task<Model> ComputeState(CancellationToken cancellationToken) {
        var canUse = await PasskeyUI.CanUse(cancellationToken).ConfigureAwait(false);
        var passkeys = await PasskeyUI.ListOwn(cancellationToken).ConfigureAwait(false);
        return new Model {
            CanUse = canUse,
            Passkeys = passkeys,
        };
    }

    private string FormatDate(Moment moment)
        => DateTimeConverter.ToLocalTime(moment.ToDateTime()).ToString("d", DateFormatter);

    private string PasskeyFacts(Passkey passkey) {
        var added = L.Passkeys_Added_Format(FormatDate(passkey.CreatedAt));
        return passkey.LastUsedAt is { } lastUsedAt
            ? $"{added} · {L.Passkeys_LastUsed_Format(FormatDate(lastUsedAt))}"
            : added;
    }

    private async Task OnAddClick() {
        var passkey = await PasskeyUI.Register().ConfigureAwait(true);
        if (passkey != null)
            ToastUI.Show(L.Passkeys_Added, "icon-checkmark-circle", ToastDismissDelay.Short);
    }

    private Task OnRenameClick(Passkey passkey)
        => ModalUI.Show(new PasskeyRenameModal.Model(passkey));

    private async Task OnDeleteClick(Passkey passkey) {
        var isConfirmed = false;
        var model = new ConfirmModal.Model(true,
            L.Passkeys_DeleteConfirm_Format(passkey.Name),
            () => { isConfirmed = true; }) {
            Title = L.Passkeys_Delete,
            ConfirmButtonText = L.Passkeys_Delete,
        };
        var modalRef = await ModalUI.Show(model).ConfigureAwait(false);
        await modalRef.WhenClosed.ConfigureAwait(false);
        if (!isConfirmed)
            return;

        await PasskeyUI.Delete(passkey.Id).ConfigureAwait(false);
    }

    // Nested types

    public sealed record Model {
        public bool CanUse { get; init; }
        public ApiArray<Passkey> Passkeys { get; init; } = ApiArray<Passkey>.Empty;
    }
}
