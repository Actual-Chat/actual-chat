@using ActualChat.Hosting
@implements IModalView<SettingsModal.Model>
@inherits ComputedStateComponent<ChatUIHub, SettingsModal.ComputedModel>
@{
    var m = State.Value;
    var account = m.AccountFull;
    var isGuest = account.IsGuest;
    var showMyAccount = !isGuest;
    var showNotifications = !isGuest && _enableIncompleteUI;
    var showLogout = !isGuest;
    var showQuit = HostInfo.HostKind.IsMauiApp() && HostInfo.AppKind == AppKind.Windows;
}

<ModalFrame Class="settings-modal">
    @if (!ScreenSize.IsNarrow()) {
        <ButtonRound Class="close-settings-btn" Click="OnCloseClick">
            <i class="icon-close text-xl"></i>
        </ButtonRound>
    }
    <SettingsPanel Title="Settings" CloseModalClick="OnCloseClick" DefaultTabId="@m.TabId">
        @if (showMyAccount) {
            <SettingsTab @key="1" TabIndex="1" Title="Your Account" Id="@SettingsTabId.Account" IconClass="icon-person">
                <YourAccount/>
            </SettingsTab>
        }

        @if (showNotifications) {
            <SettingsTab @key="3" TabIndex="3" Title="Notifications" Id="@SettingsTabId.Notifications" IconClass="icon-bell">
                <ChildContent>
                </ChildContent>
            </SettingsTab>
        }

        <SettingsTab @key="4" TabIndex="4" Title="Transcription" Id="@SettingsTabId.Transcription" IconClass="icon-transcription">
            <TitleContent>
                <LanguageShortcut/>
            </TitleContent>
            <ChildContent>
                <TranscriptionSettings/>
            </ChildContent>
        </SettingsTab>

        <SettingsTab @key="5" TabIndex="5" Title="User Interface" Id="@SettingsTabId.UserInterface" IconClass="icon-sort-by-alphabet">
            <UserInterface/>
        </SettingsTab>

        <SettingsTab @key="6" TabIndex="6" Title="Application" Id="@SettingsTabId.App" IconClass="icon-settings">
            <AppSettings/>
        </SettingsTab>

        <SettingsTab @key="7" TabIndex="7" Title="Emails" Id="@SettingsTabId.Emails" IconClass="icon-email">
            <EmailSettings/>
        </SettingsTab>

        @if (m.EnableChatRouletteUI) {
            <SettingsTab @key="8" TabIndex="8" Title="Chat Roulette" Id="@SettingsTabId.ChatRoulette" IconClass="icon-hand">
                <ChatRouletteSettings/>
            </SettingsTab>
        }

        <SettingsTab @key="90" TabIndex="90" Title="Documents" Id="@SettingsTabId.Documents" Class="docs-tab" IconClass="icon-file-text">
            <DocumentsPage/>
        </SettingsTab>

        @if (m.ShowDeveloperTools) {
            <SettingsTab @key="99" TabIndex="99" Title="Developer tools" Id="@SettingsTabId.DevTools" IconClass="icon-eye" HasSeparatorBefore="true">
                <DeveloperTools/>
            </SettingsTab>
        }

        @if (showLogout) {
            <SettingsTab @key="100" TabIndex="100" Title="Log out" Id="@SettingsTabId.SignOut" IconClass="icon-log-out" HasSeparatorBefore="true">
            </SettingsTab>
        }
        @if (showQuit) {
            <SettingsTab @key="101" TabIndex="101" Title="Quit Actual Chat" Id="@SettingsTabId.Quit" IconClass="icon-close">
            </SettingsTab>
        }

    </SettingsPanel>
</ModalFrame>

@code {
    private bool _enableIncompleteUI;
    private IDeveloperTools? _developerTools;

    [CascadingParameter] public ScreenSize ScreenSize { get; set; }
    [CascadingParameter] public Modal Modal { get; set; } = null!;
    [Parameter] public Model ModalModel { get; set; } = null!;

    protected override async Task OnInitializedAsync() {
        _developerTools = Hub.GetService<IDeveloperTools>();
        _enableIncompleteUI = await Features.IsIncompleteUIEnabled(CancellationToken.None);
    }

    protected override ComputedState<ComputedModel>.Options GetStateOptions()
        => new() {
            InitialValue = new(AccountUI.OwnAccount.Value),
            Category = GetStateCategory(GetType()),
        };

    protected override async Task<ComputedModel> ComputeState(CancellationToken cancellationToken) {
        var account = await AccountUI.OwnAccount.Use(cancellationToken).ConfigureAwait(false);
        var showDeveloperTools = _developerTools?.IsEnabled(account) ?? false;
        var tabId = ModalModel.TabId;
        var enableChatRouletteUI = await Features.Get<Features_EnableChatRouletteUI>(cancellationToken);
        return new ComputedModel(account) {
            ShowDeveloperTools = showDeveloperTools,
            EnableChatRouletteUI = enableChatRouletteUI,
            TabId = tabId,
        };
    }

    private void OnCloseClick()
        => Modal.Close();

    // Nested types

    public sealed record ComputedModel(AccountFull AccountFull) {
        public bool ShowDeveloperTools { get; init; }
        public bool EnableChatRouletteUI { get; init; }
        public string? TabId { get; init; }
    }

    public sealed record Model(string? TabId = null) {
        public static readonly Model Instance = new();
    }
}
