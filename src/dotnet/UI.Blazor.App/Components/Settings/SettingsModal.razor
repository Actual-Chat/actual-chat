@implements IModalView<SettingsModal.Model>
@using ActualChat.Hosting
@using ActualChat.UI.Blazor.App.Module
@inherits ComputedStateComponent<AppUIHub, SettingsModal.ComputedModel>
@{
    var m = State.Value;
    var account = m.AccountFull;
    var isGuest = account.IsGuest;
    var showMyAccount = !isGuest;
    var showLogout = !isGuest;
    var showQuit = HostInfo.HostKind.IsMauiApp() && HostInfo.AppKind == AppKind.Windows;
    var quitTitle = $"Quit {CoreConstants.AppName}";
}

<ModalFrame Class="settings-modal">
    @if (!ScreenSize.IsNarrow()) {
        <ButtonRound Class="close-settings-btn" Click="OnCloseClick">
            <i class="icon-close text-xl"></i>
        </ButtonRound>
    }
    <SettingsPanel Title="Settings" CloseModalClick="OnCloseClick" DefaultTabId="@m.TabId">
        @if (showMyAccount) {
            <SettingsTab @key="1" TabIndex="1" Title="Your Account" Id="@SettingsTabId.Account" IconClass="icon-person">
                <YourAccount/>
            </SettingsTab>
        }

        <SettingsTab @key="2" TabIndex="2" Title="User Interface" Id="@SettingsTabId.UserInterface" IconClass="icon-interface">
            <UserInterface/>
        </SettingsTab>

        <SettingsTab @key="3" TabIndex="3" Title="Transcription" Id="@SettingsTabId.Transcription" IconClass="icon-transcription">
            <TitleContent>
                <LanguageShortcut/>
            </TitleContent>
            <ChildContent>
                <TranscriptionSettings/>
            </ChildContent>
        </SettingsTab>

        <SettingsTab @key="4" TabIndex="4" Title="Application" Id="@SettingsTabId.App" IconClass="icon-settings">
            <AppSettings/>
        </SettingsTab>

        @if (showMyAccount) {
            <SettingsTab @key="5" TabIndex="5" Title="Sessions" Id="@SettingsTabId.Sessions" IconClass="icon-lock">
                <SessionSettings/>
            </SettingsTab>
            <SettingsTab @key="6" TabIndex="6" Title="API Keys" Id="@SettingsTabId.ApiKeys" IconClass="icon-key">
                <ApiKeySettings/>
            </SettingsTab>
        }

        @if (showMyAccount) {
            <SettingsTab @key="7" TabIndex="7" Title="Privacy" Id="@SettingsTabId.Privacy" IconClass="icon-lock">
                <PrivacySettings/>
            </SettingsTab>
        }

        @if (m.NotesChat != null) {
            <SettingsTab @key="88" TabIndex="88" Title="Notes" Id="@SettingsTabId.Notes" IconClass="icon-file-text" HasSeparatorBefore="true" Click="@OnNotesClick">
            </SettingsTab>
        }
        @if (account.IsAdmin) {
            <SettingsTab @key="89" TabIndex="89" Title="Notifications" Id="@SettingsTabId.Notifications" IconClass="icon-bell" HasSeparatorBefore="@(m.NotesChat == null)" Click="@OnNotificationsClick">
            </SettingsTab>
        }

        <SettingsTab @key="90" TabIndex="90" Title="Documents" Id="@SettingsTabId.Documents" Class="docs-tab" IconClass="icon-file-text" HasSeparatorBefore="@(m.NotesChat == null && !account.IsAdmin)">
            <DocumentsPage/>
        </SettingsTab>

        <SettingsTab @key="91" TabIndex="91" Title="Developer tools" Id="@SettingsTabId.DevTools" IconClass="icon-eye">
            <DeveloperTools/>
        </SettingsTab>

        @if (account.IsAdmin) {
            <SettingsTab @key="92" TabIndex="92" Title="Test Pages" Id="@SettingsTabId.TestPages" IconClass="icon-alert-triangle" Click="@OnTestPagesClick">
            </SettingsTab>
        }

        @if (m.ShowLogViewer) {
            <SettingsTab @key="93" TabIndex="93" Title="Log Viewer" Id="@SettingsTabId.LogViewer" Class="log-viewer-tab" HeaderClass="no-scrollbar" ContentClass="no-scrollbar" IconClass="icon-info">
                <ChildContent>
                    <div class="log-viewer-page">
                        <LogView/>
                    </div>
                    <div class="log-viewer-footer">
                        @if (Hub.ReportUI.IsAvailable) {
                            <Button Class="log-viewer-report-btn btn-primary" Click="@OnReportClick">Report</Button>
                        }
                        <Button Class="log-viewer-copy-btn btn-primary" Click="@OnCopyVisibleLogsClick">Copy</Button>
                    </div>
                </ChildContent>
            </SettingsTab>
        }

        @if (showLogout) {
            <SettingsTab @key="100" TabIndex="100" Title="Log out" Id="@SettingsTabId.SignOut" IconClass="icon-log-out" HasSeparatorBefore="true" Click="@OnSignOutClick">
            </SettingsTab>
        }
        @if (showQuit) {
            <SettingsTab @key="101" TabIndex="101" Title="@quitTitle" Id="@SettingsTabId.Quit" IconClass="icon-close" Click="@OnQuitClick">
            </SettingsTab>
        }

    </SettingsPanel>
</ModalFrame>

@code {
    [CascadingParameter] public ScreenSize ScreenSize { get; set; }
    [CascadingParameter] public Modal Modal { get; set; } = null!;
    [Parameter] public Model ModalModel { get; set; } = null!;

    protected override ComputedState<ComputedModel>.Options GetStateOptions()
        => new() {
            InitialValue = new(AccountUI.OwnAccount.Value, ModalModel.TabId),
            Category = GetStateCategory(GetType()),
        };

    protected override async Task<ComputedModel> ComputeState(CancellationToken cancellationToken) {
        var account = await AccountUI.OwnAccount.Use(cancellationToken).ConfigureAwait(false);
        var tabId = ModalModel.TabId;
        // Hide the Log Viewer in SSB — it can't capture/show local logs there.
        var showLogViewer = Hub.LogUI.CanCapture
            && await Hub.LogUI.IsEnabled.Use(cancellationToken).ConfigureAwait(false);
        var notesChat = await Hub.ChatListUI.NotesChat.Use(cancellationToken).ConfigureAwait(false);
        return new ComputedModel(account, tabId) {
            ShowLogViewer = showLogViewer,
            NotesChat = notesChat,
        };
    }

    private void OnCloseClick()
        => Modal.Close();

    private async Task OnNotesClick() {
        if (State.Value.NotesChat is not { } notesChat)
            return;

        Modal.Close();
        await Modal.Ref.WhenClosed;
        _ = History.NavigateTo(Links.Chat(notesChat.Id));
    }

    private async Task OnNotificationsClick() {
        Modal.Close();
        await Modal.Ref.WhenClosed;
        _ = History.NavigateTo(Links.Notifications);
    }

    private async Task OnTestPagesClick() {
        Modal.Close();
        await Modal.Ref.WhenClosed;
        Hub.NavbarUI.SelectGroup(NavbarGroupIds.TestPages, true);
        _ = History.NavigateTo(Links.TestPageHome);
        _ = TuneUI.Play(Tune.SelectNavbarItem).SilentAwait();
    }

    private void OnSignOutClick() {
        Modal.Close();
        _ = AccountUI.SignOut();
    }

    private void OnQuitClick()
        => Hub.ReloadUI.Quit();

    private Task OnReportClick()
        => ModalUI.Show(new ReportModal.Model());

    private async Task OnCopyVisibleLogsClick() {
        var text = await JS.InvokeAsync<string>(JSGetVisibleLogsText).ConfigureAwait(true);
        if (text.IsNullOrEmpty()) {
            ToastUI.Show("Nothing to copy", "icon-alert-circle", ToastDismissDelay.Short);
            return;
        }
        await Hub.ClipboardUI.WriteText(text).ConfigureAwait(true);
        ToastUI.Show("Visible log entries copied", "icon-checkmark-circle", ToastDismissDelay.Short);
    }

    private static readonly string JSGetVisibleLogsText =
        $"{BlazorUIAppModule.ImportName}.LogView.getVisibleEntriesText";

    // Nested types

    public sealed record ComputedModel(AccountFull AccountFull, string? TabId) {
        public bool ShowLogViewer { get; init; }
        public ChatInfo? NotesChat { get; init; }
    }

    public sealed record Model(string? TabId = null) {
        public static readonly Model Instance = new();
    }
}
