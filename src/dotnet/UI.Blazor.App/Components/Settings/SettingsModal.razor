@implements IModalView<SettingsModal.Model>
@using ActualChat.Hosting
@using ActualChat.UI.Blazor.App.Module
@inherits ComputedStateComponent<AppUIHub, SettingsModal.ComputedModel>
@{
    var m = State.Value;
    var account = m.AccountFull;
    var isGuest = account.IsGuest;
    var showMyAccount = !isGuest;
    var showLogout = !isGuest;
    var showQuit = HostInfo.HostKind.IsMauiApp() && HostInfo.AppKind == AppKind.Windows;
    var showPushToTalk = HostInfo.HostKind.IsMauiApp() && m.EnableIncompleteUI;
    var quitTitle = L["Settings_Quit_Format", CoreConstants.AppName].Value;
}

<ModalFrame Class="settings-modal">
    @if (!ScreenSize.IsNarrow()) {
        <ButtonRound Class="close-settings-btn" Click="OnCloseClick">
            <i class="icon-close text-xl"></i>
        </ButtonRound>
    }
    <SettingsPanel Title="@L["Settings_Title"].Value" CloseModalClick="OnCloseClick" DefaultTabId="@m.TabId">
        @if (showMyAccount) {
            <SettingsTab @key="1" TabIndex="1" Title="@L["Settings_YourAccount"].Value" Id="@SettingsTabId.Account" IconClass="icon-person">
                <YourAccount/>
            </SettingsTab>
        }

        <SettingsTab @key="2" TabIndex="2" Title="@L["Settings_UserInterface"].Value" Id="@SettingsTabId.UserInterface" IconClass="icon-interface">
            <UserInterface/>
        </SettingsTab>

        <SettingsTab @key="3" TabIndex="3" Title="@L["Settings_Transcription"].Value" Id="@SettingsTabId.Transcription" IconClass="icon-transcription">
            <TitleContent>
                <LanguageShortcut/>
            </TitleContent>
            <ChildContent>
                <TranscriptionSettings/>
            </ChildContent>
        </SettingsTab>

        @if (showPushToTalk) {
            <SettingsTab @key="4" TabIndex="4" Title="Push to Talk" Id="@SettingsTabId.PushToTalk"
                IconClass="icon-talking">
                <PushToTalkSettings/>
            </SettingsTab>
        }

        <SettingsTab @key="5" TabIndex="5" Title="@L["Settings_Application"].Value" Id="@SettingsTabId.App" IconClass="icon-settings">
            <AppSettings/>
        </SettingsTab>

        @if (showMyAccount) {
            <SettingsTab @key="6" TabIndex="6" Title="@L["Settings_Sessions"].Value" Id="@SettingsTabId.Sessions" IconClass="icon-lock">
                <SessionSettings/>
            </SettingsTab>
            <SettingsTab @key="7" TabIndex="7" Title="@L["Settings_ApiKeys"].Value" Id="@SettingsTabId.ApiKeys" IconClass="icon-key">
                <ApiKeySettings/>
            </SettingsTab>
        }

        @if (showMyAccount) {
            <SettingsTab @key="8" TabIndex="8" Title="@L["Settings_Privacy"].Value" Id="@SettingsTabId.Privacy" IconClass="icon-lock">
                <PrivacySettings/>
            </SettingsTab>
        }

        <SettingsTab @key="90" TabIndex="90" Title="@L["Settings_Documents"].Value" Id="@SettingsTabId.Documents" Class="docs-tab" IconClass="icon-file-text" HasSeparatorBefore="true">
            <DocumentsPage/>
        </SettingsTab>

        <SettingsTab @key="91" TabIndex="91" Title="@L["Settings_DeveloperTools"].Value" Id="@SettingsTabId.DevTools" IconClass="icon-eye">
            <DeveloperTools/>
        </SettingsTab>

        @if (m.ShowLogViewer) {
            <SettingsTab @key="92" TabIndex="92" Title="@L["Settings_LogViewer"].Value" Id="@SettingsTabId.LogViewer" Class="log-viewer-tab" HeaderClass="no-scrollbar" ContentClass="no-scrollbar" IconClass="icon-info">
                <ChildContent>
                    <div class="log-viewer-page">
                        <LogView/>
                    </div>
                    <div class="log-viewer-footer">
                        @if (Hub.ReportUI.IsAvailable) {
                            <Button Class="log-viewer-report-btn btn-primary" Click="@OnReportClick">Report</Button>
                        }
                        <Button Class="log-viewer-copy-btn btn-primary" Click="@OnCopyVisibleLogsClick">Copy</Button>
                    </div>
                </ChildContent>
            </SettingsTab>
        }

        @if (showLogout) {
            <SettingsTab @key="100" TabIndex="100" Title="@L["Settings_LogOut"].Value" Id="@SettingsTabId.SignOut" IconClass="icon-log-out" HasSeparatorBefore="true">
            </SettingsTab>
        }
        @if (showQuit) {
            <SettingsTab @key="101" TabIndex="101" Title="@quitTitle" Id="@SettingsTabId.Quit" IconClass="icon-close">
            </SettingsTab>
        }

    </SettingsPanel>
</ModalFrame>

@code {
    [CascadingParameter] public ScreenSize ScreenSize { get; set; }
    [CascadingParameter] public Modal Modal { get; set; } = null!;
    [Parameter] public Model ModalModel { get; set; } = null!;

    protected override ComputedState<ComputedModel>.Options GetStateOptions()
        => new() {
            InitialValue = new(AccountUI.OwnAccount.Value, ModalModel.TabId),
            Category = GetStateCategory(GetType()),
        };

    protected override async Task<ComputedModel> ComputeState(CancellationToken cancellationToken) {
        var account = await AccountUI.OwnAccount.Use(cancellationToken).ConfigureAwait(false);
        var tabId = ModalModel.TabId;
        // Hide the Log Viewer in SSB — it can't capture/show local logs there.
        var showLogViewer = Hub.LogUI.CanCapture
            && await Hub.LogUI.IsEnabled.Use(cancellationToken).ConfigureAwait(false);
        var enableIncompleteUI = await Hub.Features.IsIncompleteUIEnabled(cancellationToken).ConfigureAwait(false);
        return new ComputedModel(account, tabId) {
            ShowLogViewer = showLogViewer,
            EnableIncompleteUI = enableIncompleteUI,
        };
    }

    private void OnCloseClick()
        => Modal.Close();

    private Task OnReportClick()
        => ModalUI.Show(new ReportModal.Model());

    private async Task OnCopyVisibleLogsClick() {
        var text = await JS.InvokeAsync<string>(JSGetVisibleLogsText).ConfigureAwait(true);
        if (text.IsNullOrEmpty()) {
            ToastUI.Show("Nothing to copy", "icon-alert-circle", ToastDismissDelay.Short);
            return;
        }
        await Hub.ClipboardUI.WriteText(text).ConfigureAwait(true);
        ToastUI.Show("Visible log entries copied", "icon-checkmark-circle", ToastDismissDelay.Short);
    }

    private static readonly string JSGetVisibleLogsText =
        $"{BlazorUIAppModule.ImportName}.LogView.getVisibleEntriesText";

    // Nested types

    public sealed record ComputedModel(AccountFull AccountFull, string? TabId) {
        public bool ShowLogViewer { get; init; }
        public bool EnableIncompleteUI { get; init; }
    }

    public sealed record Model(string? TabId = null) {
        public static readonly Model Instance = new();
    }
}
