@implements IModalView<SettingsModal.Model>
@using ActualChat.Hosting
@using ActualChat.UI.Blazor.App.Module
@inherits ComputedStateComponent<AppUIHub, SettingsModal.ComputedModel>
@{
    var m = State.Value;
    var account = m.AccountFull;
    var isGuest = account.IsGuest;
    var showMyAccount = !isGuest;
    var showLogout = !isGuest;
    var showQuit = HostInfo.HostKind.IsMauiApp() && HostInfo.AppKind == AppKind.Windows;
    // Push-to-talk is a device feature; on the web it's an admin-only preview, local hosts only.
    var isPttPreview = account.IsAdmin && HostInfo.BaseUrlKind == BaseUrlKind.Local;
    var showPtt = m.EnableIncompleteUI && Ptt.IsSupported(HostInfo) && (HostInfo.HostKind.IsMauiApp() || isPttPreview);
    var quitTitle = L.Settings_Quit_Format(CoreConstants.AppName);

    var tabs = new List<SettingsTabDef>();
    if (showMyAccount)
        tabs.Add(new(SettingsTabId.Account, L.Settings_YourAccount) {
            IconClass = "icon-person",
            Content = @<YourAccount/>,
        });
    tabs.Add(new(SettingsTabId.UserInterface, L.Settings_UserInterface) {
        IconClass = "icon-interface",
        Content = @<UserInterface/>,
    });
    tabs.Add(new(SettingsTabId.Transcription, L.Settings_Transcription) {
        IconClass = "icon-transcription",
        TitleContent = @<LanguageShortcut/>,
        Content = @<TranscriptionSettings/>,
    });
    if (showPtt)
        tabs.Add(new(SettingsTabId.Ptt, L.Settings_Ptt) {
            IconClass = "icon-talking",
            Content = @<PttSettings/>,
        });
    tabs.Add(new(SettingsTabId.App, L.Settings_Application) {
        IconClass = "icon-settings",
        Content = @<AppSettings/>,
    });
    if (showMyAccount) {
        tabs.Add(new(SettingsTabId.Sessions, L.Settings_Sessions) {
            IconClass = "icon-lock",
            Content = @<SessionSettings/>,
        });
        tabs.Add(new(SettingsTabId.ApiKeys, L.Settings_ApiKeys) {
            IconClass = "icon-key",
            Content = @<ApiKeySettings/>,
        });
        tabs.Add(new(SettingsTabId.Privacy, L.Settings_Privacy) {
            IconClass = "icon-lock",
            Content = @<PrivacySettings/>,
        });
    }
    tabs.Add(new(SettingsTabId.Documents, L.Settings_Documents) {
        IconClass = "icon-file-text",
        Class = "docs-tab",
        HasSeparatorBefore = true,
        Content = @<DocumentsPage/>,
    });
    tabs.Add(new(SettingsTabId.DevTools, L.Settings_DeveloperTools) {
        IconClass = "icon-eye",
        Content = @<DeveloperTools/>,
    });
    if (m.ShowLogViewer)
        tabs.Add(new(SettingsTabId.LogViewer, L.Settings_LogViewer) {
            IconClass = "icon-info",
            Class = "log-viewer-tab",
            HeaderClass = "no-scrollbar",
            ContentClass = "no-scrollbar",
            Content = @<text>
                          <div class="log-viewer-page">
                              <LogView/>
                          </div>
                          <div class="log-viewer-footer">
                              @if (Hub.ReportUI.IsAvailable) {
                                  <Button Class="log-viewer-report-btn btn-primary" Click="@OnReportClick">Report</Button>
                              }
                              <Button Class="log-viewer-copy-btn btn-primary" Click="@OnCopyVisibleLogsClick">Copy</Button>
                          </div>
                      </text>,
        });
    if (showLogout)
        tabs.Add(new(SettingsTabId.SignOut, L.Settings_LogOut) {
            IconClass = "icon-log-out",
            HasSeparatorBefore = true,
            Click = SignOut,
        });
    if (showQuit)
        tabs.Add(new(SettingsTabId.Quit, quitTitle) {
            IconClass = "icon-close",
            Click = Hub.ReloadUI.Quit,
        });
}

<ModalFrame Class="settings-modal">
    @if (!ScreenSize.IsNarrow()) {
        <ButtonRound Class="close-settings-btn" Click="OnCloseClick">
            <i class="icon-close text-xl"></i>
        </ButtonRound>
    }
    <SettingsPanel Tabs="@tabs" Title="@L.Settings_Title" CloseModalClick="OnCloseClick" DefaultTabId="@m.TabId"/>
</ModalFrame>

@code {
    [CascadingParameter] public ScreenSize ScreenSize { get; set; }
    [CascadingParameter] public Modal Modal { get; set; } = null!;
    [Parameter] public Model ModalModel { get; set; } = null!;

    protected override ComputedState<ComputedModel>.Options GetStateOptions()
        => new() {
            InitialValue = new(AccountUI.OwnAccount.Value, ModalModel.TabId),
            Category = GetStateCategory(GetType()),
        };

    protected override async Task<ComputedModel> ComputeState(CancellationToken cancellationToken) {
        var account = await AccountUI.OwnAccount.Use(cancellationToken).ConfigureAwait(false);
        var tabId = ModalModel.TabId;
        // Hide the Log Viewer in SSB — it can't capture/show local logs there.
        var showLogViewer = Hub.LogUI.CanCapture
            && await Hub.LogUI.IsEnabled.Use(cancellationToken).ConfigureAwait(false);
        var enableIncompleteUI = await Hub.Features.IsIncompleteUIEnabled(cancellationToken).ConfigureAwait(false);
        return new ComputedModel(account, tabId) {
            ShowLogViewer = showLogViewer,
            EnableIncompleteUI = enableIncompleteUI,
        };
    }

    private void OnCloseClick()
        => Modal.Close();

    private void SignOut() {
        Modal.Close();
        _ = Hub.AccountUI.SignOut();
    }

    private Task OnReportClick()
        => ModalUI.Show(new ReportModal.Model());

    private async Task OnCopyVisibleLogsClick() {
        var text = await JS.InvokeAsync<string>(JSGetVisibleLogsText).ConfigureAwait(true);
        if (text.IsNullOrEmpty()) {
            ToastUI.Show(L.Settings_NothingToCopy, "icon-alert-circle", ToastDismissDelay.Short);
            return;
        }
        await Hub.ClipboardUI.WriteText(text).ConfigureAwait(true);
        ToastUI.Show(L.Settings_LogEntriesCopied, "icon-checkmark-circle", ToastDismissDelay.Short);
    }

    private static readonly string JSGetVisibleLogsText =
        $"{BlazorUIAppModule.ImportName}.LogView.getVisibleEntriesText";

    // Nested types

    public sealed record ComputedModel(AccountFull AccountFull, string? TabId) {
        public bool ShowLogViewer { get; init; }
        public bool EnableIncompleteUI { get; init; }
    }

    public sealed record Model(string? TabId = null) {
        public static readonly Model Instance = new();
    }
}
