@namespace ActualChat.UI.Blazor.App.Components
@using ActualChat.Hosting
@using ActualChat.UI.Blazor.App.Services.Gestures
@inherits ComputedStateComponent<AppUIHub, TranscriptionSettings.Model>
@attribute [UnconditionalSuppressMessage("Trimming", "IL2091:GenericArgumentDoNotHaveAnnotation", Justification = "Primitive types will be preserved.")]
@{
#pragma warning disable IL2091
    if (State.IsInitial(out var m))
        return;

    var languages = m.Languages.ListSpoken();
    _formModel.PrimaryLanguageId = languages.GetOrDefault(0)?.Value ?? "";
    _formModel.SecondaryLanguageId = languages.GetOrDefault(1)?.Value ?? "";
    _formModel.TertiaryLanguageId = languages.GetOrDefault(2)?.Value ?? "";
    var shouldDisplayTranscriberEngineSettings = m.EnableIncompleteUI;
    var hasSensors = HostInfo.HostKind.IsMauiApp() && GestureUI.Feed.IsAccelerometerAvailable;
}

<TileTopic Topic="@L.Transcription_Languages"/>

<Tile>
    <Form Model="@_formModel">
        <DataAnnotationsValidator/>

        <FormBlock Class="languages-form">
            <FormSection
                For="() => _formModel.PrimaryLanguageId"
                InputId="@_formModel.PrimaryLanguageFormId"
                IsLabelInsideInput="true"
                Label="@L.Transcription_PrimaryLanguage"
                IsRequired="true">
                <InputSelect
                    Value="_formModel.PrimaryLanguageId"
                    ValueExpression="@(() => _formModel.PrimaryLanguageId)"
                    ValueChanged="@((string languageId) => OnLanguageChanged(0, languageId))">
                    @foreach (var language in Languages.AllTranscription) {
                        <option value="@language.Id">@language.Title</option>
                    }
                </InputSelect>
            </FormSection>

            <FormSection
                For="() => _formModel.SecondaryLanguageId"
                InputId="@_formModel.SecondaryLanguageFormId"
                IsLabelInsideInput="true"
                Label="@L.Transcription_SecondLanguage">
                <InputSelect
                    Value="_formModel.SecondaryLanguageId"
                    ValueExpression="@(() => _formModel.SecondaryLanguageId)"
                    ValueChanged="@((string languageId) => OnLanguageChanged(1, languageId))">
                    <option value="">@L.Transcription_None</option>
                    @foreach (var language in Languages.AllTranscription) {
                        <option value="@language.Id">@language.Title</option>
                    }
                </InputSelect>
            </FormSection>

            <FormSection
                For="() => _formModel.TertiaryLanguageId"
                InputId="@_formModel.TertiaryLanguageFormId"
                IsLabelInsideInput="true"
                Label="@L.Transcription_ThirdLanguage">
                <InputSelect
                    Value="_formModel.TertiaryLanguageId"
                    ValueExpression="@(() => _formModel.TertiaryLanguageId)"
                    ValueChanged="@((string languageId) => OnLanguageChanged(2, languageId))">
                    <option value="">@L.Transcription_None</option>
                    @foreach (var language in Languages.AllTranscription) {
                        <option value="@language.Id">@language.Title</option>
                    }
                </InputSelect>
            </FormSection>
        </FormBlock>
    </Form>
</Tile>

<TileTopic Topic="@L.Transcription_KeepListeningTopic"/>
<Tile Class="theme-tile">
    <ListeningLingerSettings/>
</Tile>

<TileTopic Topic="@L.Transcription_TranslatedVoiceTopic"/>
<Tile>
    <TileItem Click="@OnToggleTranslatedVoice">
        <Icon><i class="icon-headphones-fill text-2xl"></i></Icon>
        <Content>@L.Transcription_TranslatedVoice</Content>
        <Caption>@L.Transcription_TranslatedVoiceCaption</Caption>
        <Right>
            <Toggle IsChecked="@m.Languages.IsTranslatedVoiceEnabled"
                    IsCheckedChanged="@(_ => OnToggleTranslatedVoice())"/>
        </Right>
    </TileItem>
    @if (m.OwnVoice is { } ownVoice) {
        <TileItem Click="@OnToggleOwnVoice">
            <Icon><i class="icon-voice-01 text-2xl"></i></Icon>
            <Content>@L.Transcription_OwnVoice</Content>
            <Caption>
                @L.Transcription_OwnVoiceCaption
                <div class="own-voice-status">@FormatOwnVoiceStatus(ownVoice)</div>
            </Caption>
            <Right>
                <Toggle IsChecked="@ownVoice.IsEnabled"
                        IsCheckedChanged="@(_ => OnToggleOwnVoice())"/>
            </Right>
        </TileItem>
        @if (ownVoice.IsEnabled) {
            @if (m.NotesChatId is { } notesChatId) {
                <TileItem Click="@(() => OnRecordSampleClick(notesChatId))">
                    <Icon><i class="icon-mic-2 text-2xl"></i></Icon>
                    <Content>
                        @(ownVoice.HasExplicitSample
                            ? L.Transcription_OwnVoiceRerecord
                            : L.Transcription_OwnVoiceRecord)
                    </Content>
                    <Right>
                        <i class="icon-chevron-right text-xl text-03"></i>
                    </Right>
                </TileItem>
            }
            @if (ownVoice.HasExplicitSample) {
                <TileItem Click="@OnRemoveSampleClick">
                    <Icon><i class="icon-trash03 text-2xl"></i></Icon>
                    <Content>@L.Transcription_OwnVoiceRemoveSample</Content>
                </TileItem>
            }
        }
    }
    <TileItem Click="@OnDubVoiceClick">
        <Icon><i class="icon-mic text-2xl"></i></Icon>
        <Content>@L.Transcription_DubVoice</Content>
        <Caption>
            @(m.OwnVoice is { IsEnabled: true }
                ? L.Transcription_DubVoiceFallbackCaption
                : L.Transcription_DubVoiceCaption)
        </Caption>
        <Right>
            <span class="text-03">@FormatDubVoice(m)</span>
            <i class="icon-chevron-right text-xl text-03"></i>
        </Right>
    </TileItem>
</Tile>

@if (hasSensors && m.EnableIncompleteUI) {
    <TileTopic Topic="@L.Transcription_MicrophoneTopic"/>
    <Tile>
        <TileItem Click="@OnToggleFaceDownStop">
            <Icon><i class="icon-mic-off text-2xl"></i></Icon>
            <Content>@L.Transcription_FaceDownStop</Content>
            <Caption>@L.Transcription_FaceDownStopCaption</Caption>
            <Right>
                <Toggle IsChecked="@m.IsFaceDownMicStopEnabled" IsCheckedChanged="@(_ => OnToggleFaceDownStop())"/>
            </Right>
        </TileItem>
    </Tile>
}

@if (shouldDisplayTranscriberEngineSettings) {
    <TileTopic Topic="@L.Transcription_Engines"/>
    <Tile Class="theme-tile">
        <TranscriptionEngineSettings/>
    </Tile>
}

@code {
    private FormModel _formModel = null!;

    private LanguageUI LanguageUI => Hub.LanguageUI;
    private GestureUI GestureUI => Hub.GestureUI;
    private ChatListUI ChatListUI => Hub.ChatListUI;

    [CascadingParameter] public Modal? Modal { get; set; }

    protected override void OnInitialized()
        => _formModel = new FormModel(ComponentIdGenerator);

    protected override async Task<Model> ComputeState(CancellationToken cancellationToken) {
        var languages = await LanguageUI.Settings.Use(LanguageUI.WhenReady, cancellationToken).ConfigureAwait(false);
        var enableIncompleteUI = await Features.IsIncompleteUIEnabled(cancellationToken).ConfigureAwait(false);
        var isFaceDownMicStopEnabled = await UserSettingsUI.UserAppSettings()
            .Get(x => !(x.IsFaceDownMicStopDisabled ?? false), cancellationToken)
            .ConfigureAwait(false);
        var defaultDubVoiceId = await GetDefaultDubVoiceId(cancellationToken).ConfigureAwait(false);
        var ownVoice = await GetOwnVoice(enableIncompleteUI, cancellationToken).ConfigureAwait(false);
        // The sample is recorded in Notes; without that chat there's nowhere to record it, so no row
        var notesChatId = ownVoice is { IsEnabled: true }
            ? (await ChatListUI.NotesChat.Use(cancellationToken).ConfigureAwait(false))?.Id
            : null;
        return new(languages, enableIncompleteUI, isFaceDownMicStopEnabled, defaultDubVoiceId, ownVoice, notesChatId);
    }

    private async Task<OwnVoiceStatus?> GetOwnVoice(bool enableIncompleteUI, CancellationToken cancellationToken) {
        // An admin preview until Soniox raises the voice quota; null hides the whole tile group
        var account = await AccountUI.OwnAccount.Use(cancellationToken).ConfigureAwait(false);
        if (!(account.IsAdmin && enableIncompleteUI))
            return null;

        return await Hub.OwnVoices.GetOwnVoiceStatus(Session, cancellationToken).ConfigureAwait(false);
    }

    private async Task<string?> GetDefaultDubVoiceId(CancellationToken cancellationToken) {
        // Guests can't list voices; the tile then reads "Default" and the modal explains
        var account = await AccountUI.OwnAccount.Use(cancellationToken).ConfigureAwait(false);
        if (!account.IsActive())
            return null;

        var suggested = await Hub.Translations.ListSuggestedDubVoices(Session, cancellationToken)
            .ConfigureAwait(false);
        return suggested.Count > 0 ? suggested[0].Id : null;
    }

    private string FormatDubVoice(Model m) {
        if (!m.Languages.DubVoice.IsNullOrEmpty())
            return m.Languages.DubVoice;

        return m.DefaultDubVoiceId ?? L.Transcription_DubVoiceDefault;
    }

    private async Task OnLanguageChanged(int index, string languageId) {
        var language = Language.ParseNullable(languageId);
        await LanguageUI.UpdateSettings(x => x.With(index, language));
        _ = State.Recompute(); // Necessary, coz otherwise zero-effect changes won't be reflected
    }

    private Task OnToggleFaceDownStop()
        => UserSettingsUI.UserAppSettings().Update(
            x => x with { IsFaceDownMicStopDisabled = !(x.IsFaceDownMicStopDisabled ?? false) },
            CancellationToken.None);

    private string FormatOwnVoiceStatus(OwnVoiceStatus ownVoice) {
        if (!ownVoice.IsEnabled)
            return L.Transcription_OwnVoiceStatus_Off;
        if (ownVoice.Status == UserVoiceStatus.Ready)
            return L.Transcription_OwnVoiceStatus_Ready;
        if (ownVoice.Failure == VoiceSampleFailure.SampleMissing)
            return L.Transcription_OwnVoiceStatus_SampleMissing;
        if (ownVoice.MissingDuration is { } missing && missing > TimeSpan.Zero) {
            // Rounded up to 5 s: the catalog's "seconds" is written for that, see Strings.en.json
            var seconds = (int)Math.Ceiling(missing.TotalSeconds / 5) * 5;
            return L.Transcription_OwnVoiceStatus_NeedsMore_Format(seconds);
        }
        if (ownVoice.Status == UserVoiceStatus.Failed || ownVoice.Failure != VoiceSampleFailure.None)
            return L.Transcription_OwnVoiceStatus_Fallback;
        if (ownVoice.Status == UserVoiceStatus.Creating)
            return L.Transcription_OwnVoiceStatus_Preparing;

        return L.Transcription_OwnVoiceStatus_ReadyToUse;
    }

    private Task OnToggleTranslatedVoice()
        => LanguageUI.UpdateSettings(x => x with { IsTranslatedVoiceEnabled = !x.IsTranslatedVoiceEnabled });

    private Task OnToggleOwnVoice()
        => LanguageUI.UpdateSettings(x => x with { IsOwnVoiceEnabled = !x.IsOwnVoiceEnabled });

    private Task OnRemoveSampleClick() {
        LanguageUI.DismissOwnVoiceSamplePrompt();
        return LanguageUI.UpdateSettings(x => x with { OwnVoiceSampleEntryId = null });
    }

    private void OnRecordSampleClick(ChatId notesChatId) {
        // The sample is an ordinary voice message in Notes, prompted by a banner there
        LanguageUI.ShowOwnVoiceSamplePrompt(notesChatId);
        Modal?.Close();
        _ = History.NavigateTo(Links.Chat(notesChatId));
    }

    private void OnDubVoiceClick()
        => ModalUI.Show(new DubVoiceModal.Model());

    // Nested types

    public sealed class FormModel {
        public string PrimaryLanguageId { get; set; } = "";
        public string SecondaryLanguageId { get; set; } = "";
        public string TertiaryLanguageId { get; set; } = "";

        private string FormId { get; }
        public string PrimaryLanguageFormId { get; }
        public string SecondaryLanguageFormId { get; }
        public string TertiaryLanguageFormId { get; }

        public FormModel(ComponentIdGenerator componentIdGenerator) {
            FormId = componentIdGenerator.Next("new-chat-form");
            PrimaryLanguageFormId = $"{FormId}-primary-language";
            SecondaryLanguageFormId = $"{FormId}-secondary-language";
            TertiaryLanguageFormId = $"{FormId}-tertiary-language";
        }
    }

    public sealed record Model(
        UserLanguageSettings Languages,
        bool EnableIncompleteUI,
        bool IsFaceDownMicStopEnabled,
        string? DefaultDubVoiceId,
        OwnVoiceStatus? OwnVoice,
        ChatId? NotesChatId);
}
