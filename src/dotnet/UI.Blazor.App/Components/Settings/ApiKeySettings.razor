@inherits ComputedStateComponent<AppUIHub, ApiKeySettings.Model>
@{
    var m = State.Value;
}

<TileTopic Topic="Create API Key"/>

<Tile>
    <Form Model="@_formModel">
        <FormBlock>
            <FormSection
                For="() => _formModel.Name"
                InputId="@_formModel.NameFormId"
                IsLabelInsideInput="true"
                Label="Name">
                <InputText
                    id="@_formModel.NameFormId"
                    @bind-Value="_formModel.Name"
                    placeholder="My API key" />
            </FormSection>

            <FormSection
                For="() => _formModel.ExpiresInDays"
                InputId="@_formModel.ExpiresInDaysFormId"
                IsLabelInsideInput="true"
                Label="Expires in (days)">
                <InputNumber
                    id="@_formModel.ExpiresInDaysFormId"
                    @bind-Value="_formModel.ExpiresInDays" />
            </FormSection>
        </FormBlock>
    </Form>

    <TileItem>
        <Content>
            <Button Class="btn-primary" Click="@OnCreateClick">
                Create API Key
            </Button>
        </Content>
    </TileItem>
</Tile>

@if (m.ApiKeys.Count > 0) {
    <TileTopic Topic="Your API Keys"/>

    <Tile>
        @foreach (var key in m.ApiKeys) {
            <TileItem IsHoverable="false">
                <Content>
                    <div class="flex flex-col">
                        <span class="font-medium">@(key.Description.IsNullOrEmpty() ? "Unnamed key" : key.Description)</span>
                        <span class="text-xs text-secondary">@key.IdPrefix...</span>
                    </div>
                </Content>
                <Caption>
                    Created: @key.CreatedAt.ToDateTime().ToString("g")
                    | Expires: @key.ExpiresAt.ToDateTime().ToString("g")
                    @if (!key.IsActive) {
                        <span class="text-danger"> | Deactivated</span>
                    }
                </Caption>
            </TileItem>
            @if (key.IsActive) {
                <div class="flex justify-end px-4 pb-2">
                    <Button Class="btn-sm btn-danger" Click="@(() => OnDeactivateClick(key.IdPrefix))">
                        Deactivate
                    </Button>
                </div>
            }
        }
    </Tile>
}

@code {
    private readonly FormModel _formModel = new();

    protected override ComputedState<Model>.Options GetStateOptions()
        => new() {
            InitialValue = new Model(),
            Category = GetStateCategory(GetType()),
        };

    protected override async Task<Model> ComputeState(CancellationToken cancellationToken)
    {
        var apiKeys = await Hub.Accounts.ListOwnSessions(Session, SessionKind.ApiKey, cancellationToken).ConfigureAwait(false);
        return new Model { ApiKeys = apiKeys };
    }

    private async Task OnCreateClick()
    {
        var command = new Accounts_CreateApiKey(Session, _formModel.Name, _formModel.ExpiresInDays);
        var result = await UICommander.Run(command);
        if (result.HasError)
            return;

        _formModel.Name = "";
        _formModel.ExpiresInDays = 365;

        // Show the key in a modal — it will never be visible again
        await Hub.ModalUI.Show(new ApiKeyRevealModal.Model(result.Value));
    }

    private Task OnDeactivateClick(string idPrefix)
    {
        var command = new Accounts_DeactivateSession(Session, idPrefix);
        return UICommander.Run(command);
    }

    // Nested types

    public sealed record Model
    {
        public ApiList<SessionInfo> ApiKeys { get; init; } = new();
    }

    public sealed class FormModel
    {
        public string NameFormId { get; } = "api-key-name";
        public string ExpiresInDaysFormId { get; } = "api-key-expires";
        public string Name { get; set; } = "";
        public int ExpiresInDays { get; set; } = 365;
    }
}
