@inherits ComputedStateComponent<AppUIHub, ApiKeySettings.Model>
@{
    var m = State.Value;
    var keys = m.ApiKeys.OrderByDescending(x => x.CreatedAt).ToList();
}

<TileTopic Topic="@L.Settings_ApiKeys" Description="@L.ApiKeys_Description"/>

<Tile>
    @foreach (var key in keys) {
        <TileItem IsHoverable="false">
            <Icon><i class="icon-key"></i></Icon>
            <Content>
                @KeyLabel(key)
                <span class="c-dim">@key.IdPrefix...</span>
            </Content>
            <Caption>
                @if (key.IsActive) {
                    @L.ApiKeys_Expires_Format(ExpiresText(key))
                } else {
                    @L.ApiKeys_Deactivated
                }
            </Caption>
            <Right>
                @if (key.IsActive) {
                    <HeaderButton
                        Class="btn-quiet-danger btn-sm"
                        Tooltip="@L.ApiKeys_Deactivate"
                        Click="@(() => OnDeactivateClick(key.IdPrefix))">
                        <i class="icon-key-off"></i>
                    </HeaderButton>
                }
            </Right>
        </TileItem>
    }
    <TileItem Class="tile-item-action" Click="@OnCreateClick">
        <Icon><i class="icon-plus"></i></Icon>
        <Content>@L.Common_Create</Content>
        <Caption>@L.ApiKeys_CreateCaption</Caption>
    </TileItem>
    @if (keys.Any(k => k.IsActive)) {
        <TileItem Class="tile-item-action item-danger" Click="@OnDeactivateAllClick">
            <Icon><i class="icon-key-off"></i></Icon>
            <Content>@L.ApiKeys_DeactivateAll</Content>
            <Caption>@L.ApiKeys_DeactivateAllCaption</Caption>
        </TileItem>
    }
</Tile>

@code {
    protected override ComputedState<Model>.Options GetStateOptions()
        => new() {
            InitialValue = new Model(),
            Category = GetStateCategory(GetType()),
        };

    protected override async Task<Model> ComputeState(CancellationToken cancellationToken)
    {
        var apiKeys = await Hub.Accounts.ListOwnSessions(Session, SessionKind.ApiKey, cancellationToken).ConfigureAwait(false);
        return new Model { ApiKeys = apiKeys };
    }

    private string KeyLabel(SessionInfo key)
        => key.Description.IsNullOrEmpty() ? L.ApiKeys_UnnamedKey : key.Description;

    private string ExpiresText(SessionInfo key)
        => DateTimeConverter.ToLocalTime(key.ExpiresAt.ToDateTime()).ToString("d", DateFormatter);

    private Task OnCreateClick()
        => Hub.ModalUI.Show(new ApiKeyCreateModal.Model());

    private Task OnDeactivateClick(string idPrefix)
    {
        var command = new Accounts_DeactivateSession { Session = Session, IdPrefix = idPrefix };
        return UICommander.Run(command);
    }

    private async Task OnDeactivateAllClick()
    {
        var confirmed = false;
        var model = new ConfirmModal.Model(false,
            L.ApiKeys_DeactivateAllConfirm,
            () => { confirmed = true; }) {
            Title = L.ApiKeys_DeactivateAllTitle,
            ConfirmButtonText = L.Common_Yes,
        };
        var modalRef = await ModalUI.Show(model).ConfigureAwait(false);
        await modalRef.WhenClosed.ConfigureAwait(false);
        if (!confirmed)
            return;

        var command = new Accounts_DeactivateAllSessions { Session = Session, Kinds = [SessionKind.ApiKey] };
        await UICommander.Run(command).ConfigureAwait(false);
    }

    // Nested types

    public sealed record Model
    {
        public ApiList<SessionInfo> ApiKeys { get; init; } = new();
    }
}
