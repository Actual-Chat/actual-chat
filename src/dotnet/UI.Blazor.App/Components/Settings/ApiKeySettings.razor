@inherits ComputedStateComponent<AppUIHub, ApiKeySettings.Model>
@{
    var m = State.Value;
    var keys = m.ApiKeys.OrderByDescending(x => x.CreatedAt).ToList();
}

<TileTopic Topic="Create API Key"/>

<Button Class="btn-primary btn-outline btn-w-full" Click="@OnCreateClick">
    Create API Key
</Button>

@if (m.ApiKeys.Count > 0) {
    <TileTopic Topic="Your API Keys"/>

    <Tile Class="api-key-tile">
        @foreach (var key in keys) {
            <TileItem IsHoverable="false">
                <Content>
                    <div class="c-key-info">
                        @if (!key.IsActive) {
                            <span class="c-deactivated">Deactivated</span>
                        }
                        <span class="c-key-name">@(key.Description.IsNullOrEmpty() ? "Unnamed key" : key.Description)</span>
                        <span class="c-key-prefix">@key.IdPrefix...</span>
                    </div>
                    @if (key.IsActive) {
                        <div class="c-deactivate">
                            <ButtonRound
                                Class="btn-sm btn-danger"
                                Tooltip="Deactivate"
                                Click="@(() => OnDeactivateClick(key.IdPrefix))">
                                <i class="icon-trash03 text-xl"></i>
                            </ButtonRound>
                        </div>
                    }
                </Content>
                <Caption>
                    <span class="c-key-expires">Expires: @DateTimeConverter.ToLocalTime(key.ExpiresAt.ToDateTime()).ToString("g")</span>
                </Caption>
            </TileItem>
            @if (key != keys[^1]) {
                <Divider />
            }
        }
    </Tile>
}

@if (keys.Any(k => k.IsActive)) {
    <Button Class="btn-outline btn-danger-light btn-w-full" Click="@OnDeactivateAllClick">
        Deactivate all API keys
    </Button>
}

@code {
    protected override ComputedState<Model>.Options GetStateOptions()
        => new() {
            InitialValue = new Model(),
            Category = GetStateCategory(GetType()),
        };

    protected override async Task<Model> ComputeState(CancellationToken cancellationToken)
    {
        var apiKeys = await Hub.Accounts.ListOwnSessions(Session, SessionKind.ApiKey, cancellationToken).ConfigureAwait(false);
        return new Model { ApiKeys = apiKeys };
    }

    private Task OnCreateClick()
        => Hub.ModalUI.Show(new ApiKeyCreateModal.Model());

    private Task OnDeactivateClick(string idPrefix)
    {
        var command = new Accounts_DeactivateSession(Session, idPrefix);
        return UICommander.Run(command);
    }

    private async Task OnDeactivateAllClick()
    {
        var confirmed = false;
        var model = new ConfirmModal.Model(false,
            "This will deactivate all your API keys. Continue?",
            () => { confirmed = true; }) {
            Title = "Deactivate all API keys?",
            ConfirmButtonText = "Yes",
        };
        var modalRef = await ModalUI.Show(model).ConfigureAwait(false);
        await modalRef.WhenClosed.ConfigureAwait(false);
        if (!confirmed)
            return;

        var command = new Accounts_DeactivateAllSessions(Session, [SessionKind.ApiKey]);
        await UICommander.Run(command).ConfigureAwait(false);
    }

    // Nested types

    public sealed record Model
    {
        public ApiList<SessionInfo> ApiKeys { get; init; } = new();
    }
}
