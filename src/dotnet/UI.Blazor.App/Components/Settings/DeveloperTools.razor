@using ActualChat.UI.App.Services
@inherits ComputedStateComponent<AppUIHub, DeveloperTools.Model>
@{
    var m = State.Value;
    var experimentalFeatureStatus = m.AreExperimentalFeaturesEnabled
        ? L.DevTools_EarlyAccessEnabled
        : L.Common_Disabled;
    var incompleteUIStatus = m.IsIncompleteUIEnabled
        ? L.DevTools_EarlyAccessUIEnabled
        : L.Common_Disabled;
}

@if (m.IsAdmin) {
    if (ServerInstanceSelector != null) {
        <TileTopic Topic="@L.DevTools_Host"/>
        <Tile Class="host-switcher-tile">
            <ServerInstanceSelector Selector="@ServerInstanceSelector" />
        </Tile>
    }

    <TileTopic Topic="@L.DevTools_EarlyAccess"/>
    <Tile Class="early-access-features">
        <TileItem Click="@OnExperimentalFeatureEnabledClick">
            <Icon><i class="icon-info text-2xl"></i></Icon>
            <Content>@L.DevTools_EarlyAccessFeatures</Content>
            <Caption>@experimentalFeatureStatus</Caption>
            <Right>
                <Toggle
                    IsChecked="@m.AreExperimentalFeaturesEnabled"
                    IsCheckedChanged="@(_ => OnExperimentalFeatureEnabledClick())"/>
            </Right>
        </TileItem>
        <TileItem Click="@OnIncompleteUIEnabledClick">
            <Icon><i class="icon-info text-2xl"></i></Icon>
            <Content>@L.DevTools_EarlyAccessUI</Content>
            <Caption>@incompleteUIStatus</Caption>
            <Right>
                <Toggle
                    IsChecked="@m.IsIncompleteUIEnabled"
                    IsCheckedChanged="@(_ => OnIncompleteUIEnabledClick())"/>
            </Right>
        </TileItem>
    </Tile>
}

<TileTopic Topic="@L.DevTools_Troubleshooting"/>
<Tile>
    <TileItem Click="@OnLogUIEnabledClick">
        <Content>@L.DevTools_EnableLogViewer</Content>
        <Right>
            <Toggle IsChecked="@m.IsLogUIEnabled" IsCheckedChanged="@(_ => OnLogUIEnabledClick())"/>
        </Right>
    </TileItem>
    <TileItem Click="@OnVideoDiagnosticsEnabledClick">
        <Content>Enable video diagnostics</Content>
        <Right>
            <Toggle
                IsChecked="@m.IsVideoDiagnosticsEnabled"
                IsCheckedChanged="@(_ => OnVideoDiagnosticsEnabledClick())"/>
        </Right>
    </TileItem>
    <TileItem Click="@OnAudioDiagnosticsEnabledClick">
        <Content>Enable audio diagnostics</Content>
        <Right>
            <Toggle
                IsChecked="@m.IsAudioDiagnosticsEnabled"
                IsCheckedChanged="@(_ => OnAudioDiagnosticsEnabledClick())"/>
        </Right>
    </TileItem>
    @if (MauiLogAccessor?.GetLogFile != null) {
        <TileItem Click="@OnGetLogFileClick">
            <Content>
                @MauiLogAccessor.ActionName
            </Content>
        </TileItem>
    }
</Tile>

@if (m is { IsAdmin: true, IsIncompleteUIEnabled: true }) {
    <LocationAccuracySelector/>
}

@code {
    private AppServerInstanceSelector? ServerInstanceSelector { get; set; }
    private IMauiLogAccessor? MauiLogAccessor { get; set; }

    private LogUI LogUI => Hub.LogUI;
    private ChatVideoUI ChatVideoUI => Hub.ChatVideoUI;
    private AudioDiagnosticsUI AudioDiagnosticsUI => Hub.AudioDiagnosticsUI;

    protected override void OnInitialized() {
        ServerInstanceSelector = Services.GetService<AppServerInstanceSelector>();
        MauiLogAccessor = Services.GetService<IMauiLogAccessor>();
    }

    protected override ComputedState<Model>.Options GetStateOptions()
        => new() { InitialValue = Model.None };

    protected override async Task<Model> ComputeState(CancellationToken cancellationToken) {
        var settings = await UserSettingsUI.UserAppSettings().Get(cancellationToken).ConfigureAwait(false);
        var account = await Hub.AccountUI.OwnAccount.Use(cancellationToken).ConfigureAwait(false);
        var appSettings = await LocalSettings.LocalAppSettings().Get(cancellationToken).ConfigureAwait(false);
        var isVideoDiagnosticsEnabled = await ChatVideoUI.IsDiagnosticsEnabled(cancellationToken).ConfigureAwait(false);
        var isAudioDiagnosticsEnabled = await AudioDiagnosticsUI.IsEnabled(cancellationToken).ConfigureAwait(false);
        return new(
            settings.AreExperimentalFeaturesEnabled ?? false,
            settings.IsIncompleteUIEnabled ?? false,
            account.IsAdmin,
            appSettings.IsLogViewerEnabledOrDefault,
            isVideoDiagnosticsEnabled,
            isAudioDiagnosticsEnabled);
    }

    private Task OnExperimentalFeatureEnabledClick()
        => UserSettingsUI.UserAppSettings().Update(x => x with {
            AreExperimentalFeaturesEnabled = !(x.AreExperimentalFeaturesEnabled ?? false),
        });

    private Task OnIncompleteUIEnabledClick()
        => UserSettingsUI.UserAppSettings().Update(x => x with {
            IsIncompleteUIEnabled = !(x.IsIncompleteUIEnabled ?? false),
        });

    private async Task OnLogUIEnabledClick() {
        await LocalSettings.LocalAppSettings().Update(x => x with {
            IsLogViewerEnabled = !x.IsLogViewerEnabledOrDefault,
        });
        LogUI.IsEnabled.Invalidate();
    }

    private Task OnVideoDiagnosticsEnabledClick()
        => UserSettingsUI.UserAppSettings().Update(x => x with {
            IsVideoDiagnosticsEnabled = !State.Value.IsVideoDiagnosticsEnabled,
        });

    private Task OnAudioDiagnosticsEnabledClick()
        => UserSettingsUI.UserAppSettings().Update(x => x with {
            IsAudioDiagnosticsEnabled = !State.Value.IsAudioDiagnosticsEnabled,
        });

    private Task OnGetLogFileClick()
        => MauiLogAccessor!.GetLogFile!.Invoke();

    // Nested types

    public record Model(
        bool AreExperimentalFeaturesEnabled,
        bool IsIncompleteUIEnabled,
        bool IsAdmin,
        bool IsLogUIEnabled,
        bool IsVideoDiagnosticsEnabled,
        bool IsAudioDiagnosticsEnabled)
    {
        public static readonly Model None = new(false, false, false, false, false, false);
    }
}
