@inherits ComputedStateComponent<AppUIHub, SessionSettings.Model>
@{
    var m = State.Value;
    var now = ServerClock.Now;
    var currentSession = m.Sessions.FirstOrDefault(s => s.IsCurrent);
    var otherSessions = m.Sessions.Where(s => !s.IsCurrent).OrderByDescending(s => s.LastSeenAt).ToList();
}

@if (currentSession != null) {
    <TileTopic Topic="@L.Sessions_CurrentSession"/>

    <Tile>
        <TileItem IsHoverable="false" Class="sessions-tile-item">
            <Content>
                <span class="c-description">@currentSession.Description</span>
            </Content>
            <Caption>
                <span>@L.Sessions_Current</span>
            </Caption>
            <Right>
                <span class="flex items-center justify-center w-8">
                    <i class="icon-checkmark-circle-2 text-xl text-success"></i>
                </span>
            </Right>
        </TileItem>
    </Tile>
}

<TileTopic Topic="@L.Sessions_Sessions"/>

<Tile>
    @foreach (var session in otherSessions) {
        var activeDaysAgo = (int)(now - session.LastSeenAt).Positive().TotalDays;
        var sActiveDaysAgo = activeDaysAgo == 0
            ? L.Sessions_Today
            : (activeDaysAgo == 1
                ? L.Sessions_DaysAgo_One(activeDaysAgo)
                : L.Sessions_DaysAgo_Other(activeDaysAgo));

        <TileItem IsHoverable="false" Class="sessions-tile-item">
            <Content>
                <span class="c-description">@session.Description</span>
            </Content>
            <Caption>
                <span>@L.Sessions_LastActive_Format(sActiveDaysAgo)</span>
            </Caption>
            <Right>
                <ButtonRound
                    Class="btn-xs btn-danger"
                    Tooltip="@L.Sessions_SignOut"
                    Click="@(() => OnSignOutClick(session.IdPrefix))">
                    <i class="icon-log-out text-xl"></i>
                </ButtonRound>
            </Right>
        </TileItem>
        @if (session != otherSessions[^1]) {
            <Divider />
        }
    }

    @if (otherSessions.Count == 0) {
        <TileItem IsHoverable="false">
            <Content>@L.Sessions_NoOtherSessions</Content>
        </TileItem>
    }
</Tile>

@if (otherSessions.Count > 0) {
    <Button Class="btn-outline btn-danger-light btn-w-full" Click="@OnSignOutAllClick">
        @L.Sessions_SignOutAll
    </Button>
}

@code {
    private MomentClock ServerClock => Hub.Clocks.ServerClock;

    protected override ComputedState<Model>.Options GetStateOptions()
        => new() {
            InitialValue = new Model(),
            Category = GetStateCategory(GetType()),
        };

    protected override async Task<Model> ComputeState(CancellationToken cancellationToken)
    {
        var sessions = await Hub.Accounts.ListOwnSessions(Session, SessionKind.Session, cancellationToken).ConfigureAwait(false);
        return new Model { Sessions = sessions };
    }

    private Task OnSignOutClick(string idPrefix)
    {
        var command = new Accounts_DeactivateSession(Session, idPrefix);
        return UICommander.Run(command);
    }

    private async Task OnSignOutAllClick()
    {
        var confirmed = false;
        var model = new ConfirmModal.Model(false,
            L.Sessions_SignOutAllConfirm,
            () => { confirmed = true; }) {
            Title = L.Sessions_SignOutAllTitle,
            ConfirmButtonText = L.Common_Yes,
        };
        var modalRef = await ModalUI.Show(model).ConfigureAwait(false);
        await modalRef.WhenClosed.ConfigureAwait(false);
        if (!confirmed)
            return;

        var command = new Accounts_DeactivateAllSessions(Session, [SessionKind.Session]);
        await UICommander.Run(command).ConfigureAwait(false);
    }

    // Nested types

    public sealed record Model
    {
        public ApiList<SessionInfo> Sessions { get; init; } = new();
    }
}
