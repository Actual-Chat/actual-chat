@namespace ActualChat.UI.Blazor.App.Components
@using System.Globalization
@inherits ComputedStateComponent<AppUIHub, PttAnswerWindowSettings.Model>
@{
    var m = State.Value;
    var options = Items
        .Select(i => new SelectTileOption(i.ToString(CultureInfo.InvariantCulture), GetLabel(i)))
        .ToList();
}

<SelectTile
    Label="@L.Ptt_AnswerWindow"
    Options="@options"
    SelectedId="@m.Seconds.ToString(CultureInfo.InvariantCulture)"
    SelectedIdChanged="@OnSecondsChanged"/>
<p class="c-description">@L.Ptt_AnswerWindowCaption</p>

@code {
    private static readonly int[] Items = [15, 30, 60];

    protected override ComputedState<Model>.Options GetStateOptions()
        => new() { InitialValue = Model.None, Category = GetStateCategory(GetType()) };

    protected override async Task<Model> ComputeState(CancellationToken cancellationToken) {
        var settings = await UserSettingsUI.UserPttSettings().Get(cancellationToken).ConfigureAwait(false);
        return new((int)settings.AnswerWindow.TotalSeconds);
    }

    private Task OnSecondsChanged(string id) {
        var seconds = int.Parse(id, CultureInfo.InvariantCulture);
        return UserSettingsUI.UserPttSettings()
            .Update(x => x with { AnswerWindow = TimeSpan.FromSeconds(seconds) }, CancellationToken.None);
    }

    private string GetLabel(int seconds)
        => seconds switch {
            60 => L.Ptt_OneMinute,
            _ => L.Ptt_Seconds_Format(seconds),
        };

    // Nested types

    public sealed record Model(int Seconds = 15) {
        public static readonly Model None = new();
    }
}
