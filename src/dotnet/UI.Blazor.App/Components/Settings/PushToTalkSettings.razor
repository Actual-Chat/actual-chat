@namespace ActualChat.UI.Blazor.App.Components
@using ActualChat.Hosting
@using ActualChat.UI.Blazor.App.Services.Gestures
@inherits ComputedStateComponent<AppUIHub, PushToTalkSettings.Model>
@{
    var m = State.Value;
    var hasSensors = HostInfo.HostKind.IsMauiApp() && GestureUI.Feed.IsAccelerometerAvailable;
    var canAddChat = m.Chats.Count < UserWalkieTalkieSettings.MaxChatCount;
}

<div class="push-to-talk-settings">
<TileTopic Topic="@L.Ptt_ChatsTopic"/>
<Tile>
    @foreach (var chat in m.Chats) {
        var isUnavailable = chat.Title is null;
        <TileItem IsHoverable="false" Caption="@GetCaption(chat)">
            <Icon><i class="@(isUnavailable ? "icon-alert-circle" : "icon-talking") text-2xl"></i></Icon>
            <Content>@(chat.Title ?? L.Ptt_UnavailableChat)</Content>
            <Right>
                <ButtonRound Class="btn-xs btn-danger" Tooltip="@L.Common_Remove" Click="@(() => OnRemove(chat.Id))">
                    <i class="icon-minus-circle text-2xl"></i>
                </ButtonRound>
            </Right>
        </TileItem>
    }
    @if (m.Chats.Count == 0) {
        <p class="c-description">
            @L.Ptt_NoChats
        </p>
    }
</Tile>
<Button Class="add-avatar-btn" Click="@OnAddChat" IsDisabled="@(!canAddChat)">
    <Icon><i class="icon-plus text-xl"></i></Icon>
    <Title>@(canAddChat ? L.Ptt_AddChat : L.Ptt_MaxChats_Format(UserWalkieTalkieSettings.MaxChatCount))</Title>
</Button>

@if (HostInfo.HostKind.IsMauiApp()) {
    <TileTopic Topic="@L.Ptt_GesturesTopic"/>
    <Tile>
        @if (hasSensors) {
            <TileItem Click="@OnToggleFlip">
                <Icon><i class="icon-refresh text-2xl"></i></Icon>
                <Content>@L.Ptt_FlipToTalk</Content>
                <Caption>@L.Ptt_FlipToTalkCaption</Caption>
                <Right><Toggle IsChecked="@m.Settings.IsFlipToTalkEnabled" IsCheckedChanged="@(_ => OnToggleFlip())"/></Right>
            </TileItem>
            <TileItem Click="@OnToggleShake">
                <Icon><i class="icon-alert-circle text-2xl"></i></Icon>
                <Content>@L.Ptt_DoubleShake</Content>
                <Caption>@L.Ptt_DoubleShakeCaption</Caption>
                <Right><Toggle IsChecked="@m.Settings.IsDoubleShakeEnabled" IsCheckedChanged="@(_ => OnToggleShake())"/></Right>
            </TileItem>
        }
        @if (HostInfo.AppKind == AppKind.Android) {
            <TileItem Click="@OnToggleHeadsetButton">
                <Icon><i class="icon-headphones-fill text-2xl"></i></Icon>
                <Content>@L.Ptt_HeadsetButton</Content>
                <Caption>@L.Ptt_HeadsetButtonCaption</Caption>
                <Right><Toggle IsChecked="@(m.Settings.IsHeadsetButtonEnabled ?? true)" IsCheckedChanged="@(_ => OnToggleHeadsetButton())"/></Right>
            </TileItem>
        }
        @if (hasSensors) {
            @if (m.Settings.IsDoubleShakeEnabled) {
                <TileItem IsHoverable="false">
                    <Icon><i class="icon-settings text-2xl"></i></Icon>
                    <Content>@L.Ptt_ShakeSensitivity</Content>
                    <Right>
                        <div class="c-sensitivity">
                            @foreach (var value in SensitivityOrder) {
                                var isSelected = m.Settings.ShakeSensitivity == value;
                                <Button
                                    Class="@($"btn-xs {(isSelected ? "btn-primary" : "")}")"
                                    Click="@(() => OnSetSensitivity(value))">
                                    @value.ToString()
                                </Button>
                            }
                        </div>
                    </Right>
                </TileItem>
            }
            <TileItem Click="@OnToggleAlwaysOn">
                <Icon><i class="icon-infinity text-2xl"></i></Icon>
                <Content>@L.Ptt_AlwaysListen</Content>
                <Caption>@L.Ptt_AlwaysListenCaption</Caption>
                <Right><Toggle IsChecked="@m.Settings.AreGesturesAlwaysOn" IsCheckedChanged="@(_ => OnToggleAlwaysOn())"/></Right>
            </TileItem>
        } else {
            <p class="c-description">@L.Ptt_NoMotionSensor</p>
        }
    </Tile>

    @if (HostInfo.AppKind == AppKind.Ios) {
        <TileTopic Topic="@L.Ptt_LockScreenTopic"/>
        <Tile>
            <TileItem Click="@OnTogglePttTransmit">
                <Icon><i class="icon-talking text-2xl"></i></Icon>
                <Content>@L.Ptt_LockScreenTalk</Content>
                <Caption>@L.Ptt_LockScreenTalkCaption</Caption>
                <Right><Toggle IsChecked="@(m.Settings.IsPttTransmitEnabled ?? true)" IsCheckedChanged="@(_ => OnTogglePttTransmit())"/></Right>
            </TileItem>
        </Tile>
    }

    @if (hasSensors) {
        <TileTopic Topic="@L.Ptt_PracticeTopic"/>
        <PushToTalkPracticePanel/>
    }
}

<TileTopic Topic="@L.Ptt_ReplyWindowTopic"/>
<Tile>
    @foreach (var window in HotWindows) {
        var isSelected = m.Settings.HotWindow == window;
        <TileItem Click="@(() => OnSetHotWindow(window))">
            <Icon><i class="icon-clock-2 text-2xl"></i></Icon>
            <Content>@L.Ptt_Seconds_Format(window.TotalSeconds.ToString("F0"))</Content>
            <Caption>@L.Ptt_ReplyWindowCaption</Caption>
            <Right>
                @if (isSelected) {
                    <i class="icon-checkmark-simple text-primary text-2xl"></i>
                }
            </Right>
        </TileItem>
    }
</Tile>

<TileTopic Topic="@L.Ptt_CuesTopic"/>
<Tile>
    <TileItem Click="@OnToggleCues">
        <Icon><i class="icon-voice-01 text-2xl"></i></Icon>
        <Content>@L.Ptt_AudibleCues</Content>
        <Caption>@L.Ptt_AudibleCuesCaption</Caption>
        <Right><Toggle IsChecked="@m.Settings.AreAudibleCuesEnabled" IsCheckedChanged="@(_ => OnToggleCues())"/></Right>
    </TileItem>
</Tile>
</div>

@code {
    private static readonly ShakeSensitivity[] SensitivityOrder =
        [ShakeSensitivity.Low, ShakeSensitivity.Medium, ShakeSensitivity.High];
    private static readonly TimeSpan[] HotWindows =
        [TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(60), TimeSpan.FromSeconds(120)];

    private GestureUI GestureUI => Hub.GestureUI;
    private IChats Chats => Hub.Chats;

    protected override ComputedState<Model>.Options GetStateOptions()
        => new() { InitialValue = Model.None, Category = GetStateCategory(GetType()) };

    protected override async Task<Model> ComputeState(CancellationToken cancellationToken) {
        var settings = await UserSettingsUI.UserWalkieTalkieSettings().Get(cancellationToken).ConfigureAwait(false);
        var pttChats = settings.AllPttChats;
        var chats = new List<ChatItem>(pttChats.Length);
        foreach (var pttChat in pttChats) {
            var chat = await Chats.Get(Session, pttChat.ChatId, cancellationToken).ConfigureAwait(false);
            var isArmed = chat != null && UserWalkieTalkieSettings.IsArmed(chat.PttEnabledAt, pttChat.JoinedAt);
            chats.Add(new ChatItem(pttChat.ChatId, chat?.Title, isArmed));
        }
        return new Model(settings, chats);
    }

    private RenderFragment? GetCaption(ChatItem chat)
        => chat.Title is null || chat.IsArmed
            ? null
            : b => b.AddContent(0, L.Ptt_NotActive);

    private Task OnRemove(ChatId chatId)
        => UserSettingsUI.UserWalkieTalkieSettings().Update(x => x.WithoutPttChat(chatId), CancellationToken.None);

    private Task OnAddChat()
        => ModalUI.Show(new PttChatPickerModal.Model(
            State.Value.Chats.Select(c => c.Id).ToHashSet(),
            UserWalkieTalkieSettings.MaxChatCount - State.Value.Chats.Count));

    private Task OnToggleFlip()
        => UserSettingsUI.UserWalkieTalkieSettings()
            .Update(x => x with { IsFlipToTalkEnabled = !x.IsFlipToTalkEnabled }, CancellationToken.None);

    private Task OnToggleShake()
        => UserSettingsUI.UserWalkieTalkieSettings()
            .Update(x => x with { IsDoubleShakeEnabled = !x.IsDoubleShakeEnabled }, CancellationToken.None);

    private Task OnToggleHeadsetButton()
        => UserSettingsUI.UserWalkieTalkieSettings()
            .Update(
                x => x with { IsHeadsetButtonEnabled = !(x.IsHeadsetButtonEnabled ?? true) },
                CancellationToken.None);

    private Task OnTogglePttTransmit()
        => UserSettingsUI.UserWalkieTalkieSettings()
            .Update(
                x => x with { IsPttTransmitEnabled = !(x.IsPttTransmitEnabled ?? true) },
                CancellationToken.None);

    private Task OnToggleAlwaysOn()
        => UserSettingsUI.UserWalkieTalkieSettings()
            .Update(x => x with { AreGesturesAlwaysOn = !x.AreGesturesAlwaysOn }, CancellationToken.None);

    private Task OnToggleCues()
        => UserSettingsUI.UserWalkieTalkieSettings()
            .Update(x => x with { AreAudibleCuesEnabled = !x.AreAudibleCuesEnabled }, CancellationToken.None);

    private Task OnSetSensitivity(ShakeSensitivity sensitivity)
        => UserSettingsUI.UserWalkieTalkieSettings()
            .Update(x => x with { ShakeSensitivity = sensitivity }, CancellationToken.None);

    private Task OnSetHotWindow(TimeSpan hotWindow)
        => UserSettingsUI.UserWalkieTalkieSettings()
            .Update(x => x with { HotWindow = hotWindow }, CancellationToken.None);

    // Nested types

    public sealed record Model(UserWalkieTalkieSettings Settings, IReadOnlyList<ChatItem> Chats) {
        public static readonly Model None = new(new UserWalkieTalkieSettings(), []);
    }

    public sealed record ChatItem(ChatId Id, string? Title, bool IsArmed);
}
