@namespace ActualChat.UI.Blazor.App.Components
@inherits ComputedStateComponent<AppUIHub, CarAudioSettings.Model>
@{
#pragma warning disable IL2091
    if (State.IsInitial(out var m))
        return;
    if (!m.IsSupported)
        return;

    _formModel.FromModel(m.Settings);
}

<TileTopic Topic="@L.CarAudio_Mode"/>
<Tile Class="car-audio-tile">
    <Form Model="@_formModel">
        <DataAnnotationsValidator/>

        <FormBlock>
            <InputRadioGroup
                TValue="@CarAudioMode"
                Name="car-audio-mode"
                DisplayName="@L.CarAudio_Mode"
                @bind-Value="_formModel.Mode">

                @foreach (var mode in Modes) {
                    var formId = _formModel.GetFormId(mode);
                    <TileItem
                        Class="@GetTileItemClass(mode)"
                        Caption="@GetCaption(mode)"
                        Click="@(_ => OnTileClick(mode))">
                        <Icon>
                            <FormRadio TValue="@CarAudioMode" Id="@formId" Value="@mode"/>
                        </Icon>
                        <Content>
                            <Label InputId="@formId" Text="@ModeTitle(mode)" IsRequired="true"></Label>
                        </Content>
                    </TileItem>
                }

            </InputRadioGroup>
        </FormBlock>
    </Form>
</Tile>

@code {
    private static readonly CarAudioMode[] Modes =
        [CarAudioMode.Car, CarAudioMode.CarSpeakers, CarAudioMode.Phone];

    private FormModel _formModel = null!;

    private ILogger Log => field ??= Services.LogFor(GetType());

    protected override void OnInitialized() {
        _formModel = new(ComponentIdGenerator);
        _formModel.ModeChanged += OnModeChanged;
    }

    protected override ComputedState<Model>.Options GetStateOptions()
        => new() { InitialValue = Model.None, Category = GetStateCategory(GetType()) };

    protected override async Task<Model> ComputeState(CancellationToken cancellationToken) {
        var isSupported = Hub.Services.GetService<ICarConnection>() != null;
        if (!isSupported)
            return Model.None;

        var settings = await UserSettingsUI.UserCarAudioSettings().Get(cancellationToken).ConfigureAwait(false);
        return new(true, settings);
    }

    private async Task OnModeChanged(CarAudioMode mode) {
        Log.LogInformation("CarAudioSettings: Mode -> {Mode}", mode);
        await UserSettingsUI.UserCarAudioSettings().Update(x => x.WithCarAudioMode(mode), CancellationToken.None);
        await State.Recompute(); // Necessary, coz otherwise zero-effect changes won't be reflected
    }

    private void OnTileClick(CarAudioMode mode)
        => _formModel.Mode = mode;

    private RenderFragment GetCaption(CarAudioMode mode)
        => b => b.AddContent(0, ModeCaption(mode));

    private string GetTileItemClass(CarAudioMode mode)
        => _formModel.Mode == mode ? "selected transparent" : "transparent";

    private string ModeTitle(CarAudioMode mode)
        => mode switch {
            CarAudioMode.CarSpeakers => L.CarAudio_CarSpeakers,
            CarAudioMode.Phone => L.CarAudio_Phone,
            _ => L.CarAudio_Car,
        };

    private string ModeCaption(CarAudioMode mode)
        => mode switch {
            CarAudioMode.CarSpeakers => L.CarAudio_CarSpeakersCaption,
            CarAudioMode.Phone => L.CarAudio_PhoneCaption,
            _ => L.CarAudio_CarCaption,
        };

    // Nested types

    public sealed record Model(bool IsSupported, UserCarAudioSettings Settings) {
        public static readonly Model None = new(false, new UserCarAudioSettings());
    }

    public sealed class FormModel {
        private CarAudioMode _mode;

        private string FormId { get; }

        public CarAudioMode Mode {
            get => _mode;
            set {
                if (_mode == value)
                    return;

                _mode = value;
                _ = ModeChanged?.Invoke(value);
            }
        }

        public event Func<CarAudioMode, Task>? ModeChanged;

        public FormModel(ComponentIdGenerator componentIdGenerator)
            => FormId = componentIdGenerator.Next("car-audio-form");

        public string GetFormId(CarAudioMode mode)
            => $"{FormId}-mode-{mode}";

        public void FromModel(UserCarAudioSettings settings)
            => _mode = settings.GetCarAudioMode();
    }
}
