@namespace ActualChat.UI.Blazor.App.Components
@inherits ComputedStateComponent<AppUIHub, CarAudioSettings.Model>
@{
    if (State.IsInitial(out var m))
        return;
    var selectedId = m.Settings.GetCarAudioMode().ToString();
}

<TileTopic Topic="@L.CarAudio_SectionTitle"/>
<Tile Class="car-audio-tile">
    <RadioTile Options="@Options" SelectedId="@selectedId" SelectedIdChanged="@OnSelectedIdChanged"/>
</Tile>

@code {
    private ICarConnection? CarConnection => field ??= Hub.Services.GetService<ICarConnection>();
    private ILogger Log => field ??= Services.LogFor(GetType());

    private IReadOnlyList<RadioTileOption> Options => [
        new(nameof(CarAudioMode.Car), L.CarAudio_Car, L.CarAudio_CarCaption),
        new(nameof(CarAudioMode.CarAssistant), L.CarAudio_CarAssistant, L.CarAudio_CarAssistantCaption),
        new(nameof(CarAudioMode.CarSpeakers), L.CarAudio_CarSpeakers, L.CarAudio_CarSpeakersCaption),
        new(nameof(CarAudioMode.Phone), L.CarAudio_Phone, L.CarAudio_PhoneCaption),
    ];

    protected override ComputedState<Model>.Options GetStateOptions()
        => new() { InitialValue = Model.None, Category = GetStateCategory(GetType()) };

    protected override async Task<Model> ComputeState(CancellationToken cancellationToken) {
        var settings = await UserSettingsUI.UserCarAudioSettings().Get(cancellationToken).ConfigureAwait(false);
        return new(settings);
    }

    private async Task OnSelectedIdChanged(string id) {
        var mode = Enum.Parse<CarAudioMode>(id);
        Log.LogInformation("CarAudioSettings: Mode -> {Mode}", mode);
        if (mode == CarAudioMode.CarAssistant && CarConnection is { } carConnection) {
            var isGranted = await carConnection.RequestAssistantLinkPermission(CancellationToken.None);
            if (!isGranted) {
                ToastUI.Show(L.CarAudio_AssistantPermissionDenied, "icon-alert-circle", ToastDismissDelay.Long);
                await State.Recompute(); // Puts the radio back on the stored mode
                return;
            }
        }
        await UserSettingsUI.UserCarAudioSettings().Update(x => x.WithCarAudioMode(mode), CancellationToken.None);
        await State.Recompute(); // Necessary, coz otherwise zero-effect changes won't be reflected
    }

    // Nested types

    public sealed record Model(UserCarAudioSettings Settings) {
        public static readonly Model None = new(new UserCarAudioSettings());
    }
}
