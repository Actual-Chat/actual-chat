@inherits ComponentBase<AppUIHub>

<Form Model="@_formModel">
    <FormBlock>
        <FormSection
            For="() => _formModel.LanguageCode"
            InputId="@_formModel.LanguageFormId"
            IsLabelInsideInput="true"
            IsRequired="true"
            Label="@L.Settings_Language">
            <InputSelect
                TValue="string"
                class="c-language-select"
                Value="_formModel.LanguageCode"
                ValueExpression="@(() => _formModel.LanguageCode)"
                ValueChanged="@(OnLanguageChanged)">
                @foreach (var language in LanguageUI.SupportedUILanguages) {
                    <option value="@language.Value">@language.NativeName</option>
                }
            </InputSelect>
        </FormSection>
    </FormBlock>
</Form>

@code {
    private FormModel _formModel = null!;

    private LanguageUI LanguageUI => field ??= Hub.LanguageUI;

    protected override void OnInitialized()
        => _formModel = new FormModel(ComponentIdGenerator) { Language = LanguageUI.UILanguage.Value };

    private async Task OnLanguageChanged(string code) {
        _formModel.LanguageCode = code;
        LanguageUI.UILanguage.Value = _formModel.Language;
        await LanguageUI.UILanguage.WhenWritten();
        await History.ForceReload("Language changed", History.Uri);
    }

    public sealed class FormModel
    {
        private string FormId { get; }
        public string LanguageFormId { get; }
        public Language Language { get; set; } = LanguageUI.DefaultUILanguage;
        public string LanguageCode {
            get => Language.Value;
            set => Language = Language.Parse(value);
        }

        public FormModel(ComponentIdGenerator componentIdGenerator)
        {
            FormId = componentIdGenerator.Next("ui-language-form");
            LanguageFormId = $"{FormId}-language";
        }
    }
}
