@inherits ComputedStateComponent<AppUIHub, Language?>
@attribute [UnconditionalSuppressMessage("Trimming", "IL2091:GenericArgumentDoNotHaveAnnotation",
    Justification = "Primitive types will be preserved.")]
@{
    _formModel.Language = State.Value;
}

<Form Model="@_formModel">
    <FormBlock>
        <FormSection
            For="() => _formModel.LanguageCode"
            InputId="@_formModel.LanguageFormId"
            IsLabelInsideInput="true"
            Label="@L.Settings_Language">
            <InputSelect
                TValue="string"
                class="c-language-select"
                Value="_formModel.LanguageCode"
                ValueExpression="@(() => _formModel.LanguageCode)"
                ValueChanged="@(OnLanguageChanged)">
                <option value="">@L.Settings_Language_Auto</option>
                @foreach (var language in Languages.AllUI) {
                    <option value="@language.Value">@language.NativeName</option>
                }
            </InputSelect>
        </FormSection>
    </FormBlock>
</Form>

@code {
    private FormModel _formModel = null!;

    private LanguageUI LanguageUI => field ??= Hub.LanguageUI;

    protected override void OnInitialized()
        => _formModel = new FormModel(ComponentIdGenerator);

    protected override async Task<Language?> ComputeState(CancellationToken cancellationToken) {
        var settings = await LanguageUI.Settings.Use(LanguageUI.WhenReady, cancellationToken).ConfigureAwait(false);
        return settings.UILanguage;
    }

    private async Task OnLanguageChanged(string code) {
        var language = Language.TryParse(code, allowNull: true);
        await LanguageUI.UpdateUILanguage(language).ConfigureAwait(true);

        var effectiveLanguage = Languages.ResolveUILanguage(
            Hub.BrowserInfo.UILanguageOverride,
            language,
            Hub.BrowserInfo.ClientLanguages);
        if (effectiveLanguage == Hub.LocalizationUI.Language)
            return;

        var mustReload = false;
        var model = new ConfirmModal.Model(
            IsDestructive: false,
            Text: L.Settings_UILanguageReloadText,
            Confirm: () => mustReload = true) {
            Title = L.Settings_UILanguageApplyTitle,
            ConfirmButtonText = L.Navbar_Reload,
            CancelButtonText = L.Common_Later,
        };
        var modalRef = await ModalUI.Show(model).ConfigureAwait(true);
        await modalRef.WhenClosed.ConfigureAwait(true);
        if (mustReload)
            Hub.ReloadUI.Reload();
    }

    public sealed class FormModel {
        private string FormId { get; }
        public string LanguageFormId { get; }
        public Language? Language { get; set; }
        public string LanguageCode {
            get => Language?.Value ?? "";
            set => Language = ActualChat.Language.TryParse(value, allowNull: true);
        }

        public FormModel(ComponentIdGenerator componentIdGenerator) {
            FormId = componentIdGenerator.Next("ui-language-form");
            LanguageFormId = $"{FormId}-language";
        }
    }
}
