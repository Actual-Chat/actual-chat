@inherits ComputedStateComponent<AppUIHub, UserLanguageSettings>
@{
    var spoken = State.Value.ListSpoken();
    var primary = spoken[0].ShortTitle.ToSentenceCase();
    var extra = spoken.Count - 1;
}

<div class="language-shortcut">
    @primary@if (extra > 0) {<sup class="c-more">+@extra</sup>}
</div>

@code{
    private LanguageUI LanguageUI => Hub.LanguageUI;

    protected override ComputedState<UserLanguageSettings>.Options GetStateOptions()
        => ComputedStateComponent.GetStateOptions(GetType(),
            static t => new ComputedState<UserLanguageSettings>.Options() {
                InitialValue = new(),
                UpdateDelayer = FixedDelayer.NextTick,
                Category = GetStateCategory(t),
            });

    protected override Task<UserLanguageSettings> ComputeState(CancellationToken cancellationToken)
        => LanguageUI.Settings.Use(LanguageUI.WhenReady, cancellationToken);
}
