@namespace ActualChat.UI.Blazor.App.Components
@inherits ComputedStateComponent<AppUIHub, PttShakeSensitivitySettings.Model>
@{
    var m = State.Value;
    _formModel.Sensitivity = m.Sensitivity;
}

<Form Model="@_formModel">
    <DataAnnotationsValidator/>

    <FormBlock Class="ptt-shake-sensitivity-settings">
        <FormSection
            For="() => _formModel.Sensitivity"
            InputId="@_formModel.SensitivityFormId"
            IsLabelInsideInput="true"
            Label="@L.Ptt_ShakeSensitivity"
            IsRequired="true"
            HideValidationMessage="true">
            <InputSelect
                Value="_formModel.Sensitivity"
                ValueExpression="@(() => _formModel.Sensitivity)"
                ValueChanged="@((ShakeSensitivity sensitivity) => OnSensitivityChanged(sensitivity))">
                @foreach (var item in Items) {
                    <option value="@item">@GetLabel(item)</option>
                }
            </InputSelect>
        </FormSection>
    </FormBlock>
</Form>

@code {
    private static readonly ShakeSensitivity[] Items =
        [ShakeSensitivity.Low, ShakeSensitivity.Medium, ShakeSensitivity.High];

    private FormModel _formModel = null!;

    protected override void OnInitialized()
        => _formModel = new FormModel(ComponentIdGenerator);

    protected override ComputedState<Model>.Options GetStateOptions()
        => new() { InitialValue = Model.None, Category = GetStateCategory(GetType()) };

    protected override async Task<Model> ComputeState(CancellationToken cancellationToken) {
        var settings = await UserSettingsUI.UserPttSettings().Get(cancellationToken).ConfigureAwait(false);
        return new(settings.ShakeSensitivity);
    }

    private Task OnSensitivityChanged(ShakeSensitivity sensitivity) {
        _formModel.Sensitivity = sensitivity;
        return UserSettingsUI.UserPttSettings()
            .Update(x => x with { ShakeSensitivity = sensitivity }, CancellationToken.None);
    }

    private string GetLabel(ShakeSensitivity sensitivity)
        => sensitivity switch {
            ShakeSensitivity.Low => L.Ptt_ShakeLow,
            ShakeSensitivity.Medium => L.Ptt_ShakeMedium,
            ShakeSensitivity.High => L.Ptt_ShakeHigh,
            _ => sensitivity.ToString(),
        };

    // Nested types

    public sealed class FormModel(ComponentIdGenerator componentIdGenerator) {
        public ShakeSensitivity Sensitivity { get; set; }
        public string SensitivityFormId { get; } = componentIdGenerator.Next("ptt-shake-sensitivity");
    }

    public sealed record Model(ShakeSensitivity Sensitivity = ShakeSensitivity.Medium) {
        public static readonly Model None = new();
    }
}
