@namespace ActualChat.UI.Blazor.App.Components
@inherits ComputedStateComponent<AppUIHub, ListeningLingerSettings.Model>
@{
    if (State.IsInitial(out var m))
        return;
    var selectedId = m.Value.ToString();
}

<RadioTile Options="@Options" SelectedId="@selectedId" SelectedIdChanged="@OnSelectedIdChanged"/>

@code {
    private Task _whenUpdatedTask = Task.CompletedTask;

    private IReadOnlyList<RadioTileOption> Options => [
        new(nameof(ListeningLinger.None), L.ListeningLinger_Off),
        new(nameof(ListeningLinger.For5Seconds), L.ListeningLinger_5Seconds),
        new(nameof(ListeningLinger.For10Seconds), L.ListeningLinger_10Seconds),
        new(nameof(ListeningLinger.For30Seconds), L.ListeningLinger_30Seconds),
    ];

    protected override async Task<Model> ComputeState(CancellationToken cancellationToken) {
        var settings = await UserSettingsUI.UserListeningSettings()
            .Get(cancellationToken)
            .ConfigureAwait(false);
        return new(settings.ListeningLinger);
    }

    private Task OnSelectedIdChanged(string id) {
        // Chained so rapid clicks apply in click order (last click wins)
        var prevUpdateTask = _whenUpdatedTask;
        _whenUpdatedTask = UpdateSettings();
        return _whenUpdatedTask;

        async Task UpdateSettings() {
            await prevUpdateTask.SilentAwait();
            var value = Enum.Parse<ListeningLinger>(id);
            await UserSettingsUI.UserListeningSettings()
                .Update(x => x with { ListeningLinger = value }, CancellationToken.None);
            await State.Recompute(); // Necessary, coz otherwise zero-effect changes won't be reflected
        }
    }

    // Nested types

    public sealed record Model(ListeningLinger Value);
}
