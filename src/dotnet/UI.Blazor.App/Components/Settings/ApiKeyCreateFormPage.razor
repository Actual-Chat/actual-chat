@inherits ComponentBase<AppUIHub>

<Tile>
    <Form Model="@_formModel">
        <FormBlock Class="api-key-form-block">
            <FormSection
                For="() => _formModel.Name"
                InputId="@_formModel.NameFormId"
                IsLabelInsideInput="true"
                Label="@L["ApiKeyCreate_Name"].Value">
                <TextBox
                    Id="@_formModel.NameFormId"
                    Placeholder="@L["ApiKeyCreate_Placeholder"].Value"
                    @bind-Value="@_formModel.Name"
                    ClearButton="true"/>
            </FormSection>

            <FormSection
                For="() => _formModel.ExpiresInDaysText"
                InputId="@_formModel.ExpiresInDaysFormId"
                IsLabelInsideInput="true"
                Label="@L["ApiKeyCreate_ExpiresInDays"].Value">
                <TextBox
                    Id="@_formModel.ExpiresInDaysFormId"
                    Type="number"
                    @bind-Value="@_formModel.ExpiresInDaysText"/>
            </FormSection>
        </FormBlock>
    </Form>
</Tile>

@code {
    private readonly FormModel _formModel = new();

    [CascadingParameter] public DiveInModalPageContext Context { get; set; } = null!;

    protected override void OnInitialized() {
        Context.Title = L["ApiKeyCreate_Title"].Value;
        Context.Buttons = [DialogButtonInfo.CancelButton, DialogButtonInfo.CreateSubmitButton(L["ApiKeyCreate_Create"].Value, OnCreate)];
    }

    private async Task OnCreate() {
        if (!int.TryParse(_formModel.ExpiresInDaysText, out var expiresInDays) || expiresInDays <= 0)
            return;
        var command = new Accounts_CreateApiKey(Session, _formModel.Name, expiresInDays);
        var result = await UICommander.Run(command);
        if (result.HasError)
            return;

        Context.StepIn(DiveInDialogPage.New<ApiKeyRevealPage>(new ApiKeyRevealPage.Model(result.Value)));
    }

    private sealed class FormModel
    {
        public string NameFormId { get; } = "api-key-name";
        public string ExpiresInDaysFormId { get; } = "api-key-expires";
        public string Name { get; set; } = "";
        public string ExpiresInDaysText { get; set; } = "365";
    }
}
