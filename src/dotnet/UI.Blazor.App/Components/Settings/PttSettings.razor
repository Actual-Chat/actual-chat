@namespace ActualChat.UI.Blazor.App.Components
@using ActualChat.Hosting
@using ActualChat.UI.Blazor.App.Services.Gestures
@inherits ComputedStateComponent<AppUIHub, PttSettings.Model>
@{
    var m = State.Value;
    var hasSensors = HostInfo.HostKind.IsMauiApp() && GestureUI.Feed.IsAccelerometerAvailable;
    var canAllowMore = m.CanAllowMore;
}

<Tile>
    <TileItem Click="@OnToggleDevice">
        <Icon><i class="icon-phone text-2xl"></i></Icon>
        <Content>@L.Ptt_UseOnThisDevice</Content>
        <Caption>@L.Ptt_UseOnThisDeviceCaption</Caption>
        <Right><Toggle IsChecked="@m.IsDeviceEnabled" IsCheckedChanged="@(_ => OnToggleDevice())"/></Right>
    </TileItem>
</Tile>

<div class="ptt-settings-body @(m.IsDeviceEnabled ? "" : "off")">
<TileTopic Topic="@L.Ptt_ChatsTopic"/>
<Tile>
    @foreach (var chat in m.AllowedChats) {
        <TileItem Click="@(() => OnTurnOff(chat.Id))" Caption="@GetPlaceCaption(chat)">
            <Icon><i class="icon-push-to-talk text-2xl"></i></Icon>
            <Content>@chat.Title</Content>
            <Right>
                <Toggle IsChecked="true" IsCheckedChanged="@(_ => OnTurnOff(chat.Id))"/>
            </Right>
        </TileItem>
    }
    <p class="c-description">@GetAllowedDescription(m)</p>
</Tile>

@if (m.AvailableChats.Count != 0) {
    <TileTopic Topic="@L.Ptt_AvailableTopic"/>
    <Tile>
        @foreach (var chat in m.AvailableChats) {
            <TileItem Click="@(() => OnAllow(chat))" Caption="@GetPlaceCaption(chat)">
                <Icon><i class="icon-push-to-talk text-2xl"></i></Icon>
                <Content>@chat.Title</Content>
                <Right>
                    <Toggle
                        IsDisabled="@(!canAllowMore)"
                        IsChecked="false"
                        IsCheckedChanged="@(_ => OnAllow(chat))"/>
                </Right>
            </TileItem>
        }
        <p class="c-description">
            @(canAllowMore
                ? L.Ptt_AllowHint
                : L.Ptt_AllowLimitHint)
        </p>
    </Tile>
}

@if (HostInfo.HostKind.IsMauiApp()) {
    <TileTopic Topic="@L.Ptt_GesturesTopic"/>
    <Tile>
        @if (hasSensors) {
            <TileItem Click="@OnToggleFlip">
                <Icon><i class="icon-refresh text-2xl"></i></Icon>
                <Content>@L.Ptt_FlipToTalk</Content>
                <Caption>@L.Ptt_FlipToTalkCaption</Caption>
                <Right><Toggle IsChecked="@m.Settings.IsFlipToTalkEnabled" IsCheckedChanged="@(_ => OnToggleFlip())"/></Right>
            </TileItem>
            <TileItem Click="@OnToggleShake">
                <Icon><i class="icon-alert-circle text-2xl"></i></Icon>
                <Content>@L.Ptt_DoubleShake</Content>
                <Caption>@L.Ptt_DoubleShakeCaption</Caption>
                <Right><Toggle IsChecked="@m.Settings.IsDoubleShakeEnabled" IsCheckedChanged="@(_ => OnToggleShake())"/></Right>
            </TileItem>
            @if (m.Settings.IsDoubleShakeEnabled) {
                <PttShakeSensitivitySettings/>
            }
        }
        @if (HostInfo.AppKind == AppKind.Android) {
            <TileItem Click="@OnToggleHeadsetButton">
                <Icon><i class="icon-headphones-fill text-2xl"></i></Icon>
                <Content>@L.Ptt_HeadsetButton</Content>
                <Caption>@L.Ptt_HeadsetButtonCaption</Caption>
                <Right><Toggle IsChecked="@(m.Settings.IsHeadsetButtonEnabled ?? true)" IsCheckedChanged="@(_ => OnToggleHeadsetButton())"/></Right>
            </TileItem>
        }
        @if (hasSensors) {
            <TileItem Click="@OnToggleAlwaysOn">
                <Icon><i class="icon-infinity text-2xl"></i></Icon>
                <Content>@L.Ptt_AlwaysListen</Content>
                <Caption>@L.Ptt_AlwaysListenCaption</Caption>
                <Right><Toggle IsChecked="@m.Settings.AreGesturesAlwaysOn" IsCheckedChanged="@(_ => OnToggleAlwaysOn())"/></Right>
            </TileItem>
        } else {
            <p class="c-description">@L.Ptt_NoMotionSensor</p>
        }
        @if ((hasSensors || HostInfo.AppKind == AppKind.Android) && !m.Settings.AreGesturesAlwaysOn) {
            <PttAnswerWindowSettings/>
        }
    </Tile>

    @if (HostInfo.AppKind == AppKind.Ios) {
        <TileTopic Topic="@L.Ptt_LockScreenTopic"/>
        <Tile>
            <TileItem Click="@OnTogglePttTransmit">
                <Icon><i class="icon-push-to-talk text-2xl"></i></Icon>
                <Content>@L.Ptt_LockScreenTalk</Content>
                <Caption>@L.Ptt_LockScreenTalkCaption</Caption>
                <Right><Toggle IsChecked="@(m.Settings.IsPttTransmitEnabled ?? true)" IsCheckedChanged="@(_ => OnTogglePttTransmit())"/></Right>
            </TileItem>
        </Tile>
    }

    @if (hasSensors) {
        <TileTopic Topic="@L.Ptt_PracticeTopic"/>
        <PttPracticePanel/>
    }
}

<TileTopic Topic="@L.Ptt_ReplyWindowTopic"/>
<PttReplyWindowSettings/>

<TileTopic Topic="@L.Ptt_CuesTopic"/>
<Tile>
    <TileItem Click="@OnToggleCues">
        <Icon><i class="icon-voice-01 text-2xl"></i></Icon>
        <Content>@L.Ptt_AudibleCues</Content>
        <Caption>@L.Ptt_AudibleCuesCaption</Caption>
        <Right><Toggle IsChecked="@m.Settings.AreAudibleCuesEnabled" IsCheckedChanged="@(_ => OnToggleCues())"/></Right>
    </TileItem>
</Tile>
</div>

@code {
    private GestureUI GestureUI => Hub.GestureUI;
    private ChatListUI ChatListUI => Hub.ChatListUI;
    private ChatAudioUI ChatAudioUI => Hub.ChatAudioUI;
    private IPlaces Places => Hub.Places;

    protected override ComputedState<Model>.Options GetStateOptions()
        => new() { InitialValue = Model.None, Category = GetStateCategory(GetType()) };

    protected override async Task<Model> ComputeState(CancellationToken cancellationToken) {
        var settings = await UserSettingsUI.UserPttSettings().Get(cancellationToken).ConfigureAwait(false);
        var isDeviceEnabled = await ChatAudioUI.IsPttEnabledOnDevice(cancellationToken).ConfigureAwait(false);
        // Consented, not armed: the roster shows the account-level consents, which other devices
        // act on even while this device's switch is off.
        var allowedChatIds = await ChatAudioUI.GetConsentedPttChatIds(cancellationToken).ConfigureAwait(false);
        var allowedChatIdSet = allowedChatIds.ToHashSet();
        var chatInfos = await ChatListUI.ListAllUnordered(cancellationToken).ConfigureAwait(false);
        var allowedChats = new List<ChatItem>();
        var availableChats = new List<ChatItem>();
        foreach (var chatInfo in chatInfos.Values) {
            var chat = chatInfo.Chat;
            if (chat.PttEnabledAt is not { } pttEnabledAt)
                continue;
            if (chat.HasSingleAuthor || !chat.IsMember() || chat.Id.IsThread())
                continue;

            var placeTitle = await GetPlaceTitle(chat, cancellationToken).ConfigureAwait(false);
            var item = new ChatItem(chat.Id, chat.Title, placeTitle, pttEnabledAt);
            if (allowedChatIdSet.Contains(chat.Id))
                allowedChats.Add(item);
            else
                availableChats.Add(item);
        }
        return new Model(
            settings,
            isDeviceEnabled,
            allowedChatIdSet,
            allowedChats.OrderBy(x => x.Title).ToList(),
            availableChats.OrderBy(x => x.Title).ToList());
    }

    private async Task<string?> GetPlaceTitle(Chat chat, CancellationToken cancellationToken) {
        if (chat.Id is not PlaceChatId placeChatId)
            return null;

        var place = await Places.Get(Session, placeChatId.PlaceId, cancellationToken).ConfigureAwait(false);
        return place?.Title;
    }

    private static RenderFragment? GetPlaceCaption(ChatItem chat)
        => chat.PlaceTitle is { } placeTitle
            ? b => b.AddContent(0, placeTitle)
            : null;

    private string GetAllowedDescription(Model m)
        => m.AllowedChats.Count != 0
            ? L.Ptt_AllowedCount_Format(m.AllowedChatIds.Count, UserPttSettings.MaxChatCount)
            : m.AvailableChats.Count != 0
                ? L.Ptt_NothingAllowed
                : L.Ptt_NoPttChats;

    private void OnToggleDevice()
        => ChatAudioUI.SetIsPttEnabledOnDevice(!State.Value.IsDeviceEnabled);

    private Task OnTurnOff(ChatId chatId)
        => UserSettingsUI.UserPttSettings().Update(x => x.WithoutPttChat(chatId), CancellationToken.None);

    private Task OnAllow(ChatItem chat) {
        var m = State.Value;
        if (!m.CanAllowMore)
            return Task.CompletedTask;

        // Never a raw client clock: JoinedAt must land within the current epoch (>= PttEnabledAt).
        var joinedAt = Moment.Max(Clocks.ServerClock.Now, chat.PttEnabledAt);
        var allowedChatIds = m.AllowedChatIds;
        return UserSettingsUI.UserPttSettings().Update(
            x => x.WithOnlyPttChats(allowedChatIds).WithPttChat(chat.Id, joinedAt),
            CancellationToken.None);
    }

    private Task OnToggleFlip()
        => UserSettingsUI.UserPttSettings()
            .Update(x => x with { IsFlipToTalkEnabled = !x.IsFlipToTalkEnabled }, CancellationToken.None);

    private Task OnToggleShake()
        => UserSettingsUI.UserPttSettings()
            .Update(x => x with { IsDoubleShakeEnabled = !x.IsDoubleShakeEnabled }, CancellationToken.None);

    private Task OnToggleHeadsetButton()
        => UserSettingsUI.UserPttSettings()
            .Update(
                x => x with { IsHeadsetButtonEnabled = !(x.IsHeadsetButtonEnabled ?? true) },
                CancellationToken.None);

    private Task OnTogglePttTransmit()
        => UserSettingsUI.UserPttSettings()
            .Update(
                x => x with { IsPttTransmitEnabled = !(x.IsPttTransmitEnabled ?? true) },
                CancellationToken.None);

    private Task OnToggleAlwaysOn()
        => UserSettingsUI.UserPttSettings()
            .Update(x => x with { AreGesturesAlwaysOn = !x.AreGesturesAlwaysOn }, CancellationToken.None);

    private Task OnToggleCues()
        => UserSettingsUI.UserPttSettings()
            .Update(x => x with { AreAudibleCuesEnabled = !x.AreAudibleCuesEnabled }, CancellationToken.None);

    // Nested types

    public sealed record Model(
        UserPttSettings Settings,
        bool IsDeviceEnabled,
        IReadOnlySet<ChatId> AllowedChatIds,
        IReadOnlyList<ChatItem> AllowedChats,
        IReadOnlyList<ChatItem> AvailableChats) {
        public static readonly Model None = new(new UserPttSettings(), false, new HashSet<ChatId>(), [], []);
        public bool CanAllowMore => AllowedChatIds.Count < UserPttSettings.MaxChatCount;
    }

    public sealed record ChatItem(ChatId Id, string Title, string? PlaceTitle, Moment PttEnabledAt);
}
