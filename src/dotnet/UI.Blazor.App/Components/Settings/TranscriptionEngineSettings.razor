@namespace ActualChat.UI.Blazor.App.Components
@inherits ComputedStateComponent<AppUIHub, TranscriptionEngineSettings.Model>
@{
    if (State.IsInitial(out var m))
        return;
    var selectedId = m.TranscriberId;
}

<RadioTile Options="@Items" SelectedId="@selectedId" SelectedIdChanged="@OnSelectedIdChanged"/>

@code {
    // Transcriber names are brands, so only the composition around them is localized.
    private RadioTileOption[] Items => field ??= [
        new("", L.Transcription_Automatic),
        new(TranscriberId.SonioxStream.Value, L.Transcription_NoRetranscription_Format("Soniox")),
        new(TranscriberId.NewPair(TranscriberId.SonioxStream, TranscriberId.SonioxOffline).Value,
            L.Transcription_Retranscription_Format("Soniox", "Soniox")),
        new(TranscriberId.NewPair(TranscriberId.SonioxStream, TranscriberId.OpenAIOffline).Value,
            L.Transcription_Retranscription_Format("Soniox", "OpenAI")),
        // new(TranscriberId.NewPair(TranscriberId.SonioxStream, TranscriberId.ElevenLabsOffline).Value,
        //     L.Transcription_Retranscription_Format("Soniox", "ElevenLabs")),
        new(TranscriberId.NewPair(TranscriberId.DeepgramStream, TranscriberId.OpenAIOffline).Value,
            L.Transcription_Retranscription_Format("Deepgram", "OpenAI")),
        // new(TranscriberId.ElevenLabsStream.Value, L.Transcription_NoRetranscription_Format("ElevenLabs")),
        // new(TranscriberId.NewPair(TranscriberId.ElevenLabsStream, TranscriberId.ElevenLabsOffline).Value,
        //     L.Transcription_Retranscription_Format("ElevenLabs", "ElevenLabs")),
        new(TranscriberId.GoogleStream.Value, "Google Cloud"),
    ];

    protected override async Task<Model> ComputeState(CancellationToken cancellationToken) {
        var settings = await UserSettingsUI.UserTranscriptionEngineSettings()
            .Get(cancellationToken)
            .ConfigureAwait(false);
        return new(settings.Transcriber);
    }

    private async Task OnSelectedIdChanged(string transcriberId) {
        var settings = new UserTranscriptionEngineSettings { Transcriber = transcriberId };
        await UserSettingsUI.UserTranscriptionEngineSettings().Set(settings, CancellationToken.None);
        await State.Recompute(); // Necessary, coz otherwise zero-effect changes won't be reflected
    }

    // Nested types

    public sealed record Model(string TranscriberId);
}
