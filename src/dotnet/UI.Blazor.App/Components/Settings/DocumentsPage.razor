@inherits ComponentBase<AppUIHub>
@{
    var tabs = new TabDef[] {
        new("docs-privacy-policy", L.Documents_PrivacyPolicy) { Content = @<DocsPrivacyContent/> },
        new("docs-terms-conditions", L.Documents_TermsConditions) { Content = @<DocsTermsContent/> },
        new("docs-cookies", L.Documents_Cookies) { Content = @<DocsCookiesContent/> },
    };
}

<TabPanel
    Tabs="@tabs"
    Class="docs-panel"
    BottomHill="true"
    SwapKind="@TabContentSwap.Swipe"/>
