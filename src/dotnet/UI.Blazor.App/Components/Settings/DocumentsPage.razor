@inherits ComponentBase<AppUIHub>

<TabPanel
    Class="docs-panel"
    BottomHill="true">

    <Tab @key="@("docs-privacy-tab")" Id="docs-privacy-policy" Title="@L["Documents_PrivacyPolicy"].Value" Order="0">
        <DocsPrivacyContent/>
    </Tab>
    <Tab @key="@("docs-terms-tab")" Id="docs-terms-conditions" Title="@L["Documents_TermsConditions"].Value" Order="1">
        <DocsTermsContent/>
    </Tab>
    <Tab @key="@("docs-cookies-tab")" Id="docs-cookies" Title="@L["Documents_Cookies"].Value" Order="2">
        <DocsCookiesContent/>
    </Tab>
</TabPanel>
