@inherits ComponentBase<AppUIHub>
@{
    var tabs = new TabDef[] {
        new(DocumentsTabId.PrivacyPolicy, L.Documents_PrivacyPolicy) { Content = @<DocsPrivacyContent/> },
        new(DocumentsTabId.TermsConditions, L.Documents_TermsConditions) { Content = @<DocsTermsContent/> },
        new(DocumentsTabId.Cookies, L.Documents_Cookies) { Content = @<DocsCookiesContent/> },
    };
}

<TabPanel
    Tabs="@tabs"
    Class="docs-panel"
    DefaultTabId="@TabId"
    BottomHill="true"
    SwapKind="@TabContentSwap.Swipe"/>

@code {
    [Parameter] public string? TabId { get; set; }
}
