@namespace ActualChat.UI.Blazor.App.Components
@using System.Globalization
@inherits ComputedStateComponent<AppUIHub, PttHushDurationSettings.Model>
@{
    var m = State.Value;
    var options = Items
        .Select(i => new SelectTileOption(i.ToString(CultureInfo.InvariantCulture), GetLabel(i)))
        .ToList();
}

<SelectTile
    Label="@L.Ptt_HushDuration"
    Options="@options"
    SelectedId="@m.Minutes.ToString(CultureInfo.InvariantCulture)"
    SelectedIdChanged="@OnMinutesChanged"/>

@code {
    private static readonly int[] Items = Constants.Audio.PttMuteDurations.Select(d => (int)d.TotalMinutes).ToArray();

    protected override ComputedState<Model>.Options GetStateOptions()
        => new() { InitialValue = Model.None, Category = GetStateCategory(GetType()) };

    protected override async Task<Model> ComputeState(CancellationToken cancellationToken) {
        var settings = await UserSettingsUI.UserPttSettings().Get(cancellationToken).ConfigureAwait(false);
        return new((int)settings.HushDuration.TotalMinutes);
    }

    private Task OnMinutesChanged(string id) {
        var minutes = int.Parse(id, CultureInfo.InvariantCulture);
        return UserSettingsUI.UserPttSettings()
            .Update(x => x with { HushDuration = TimeSpan.FromMinutes(minutes) }, CancellationToken.None);
    }

    private string GetLabel(int minutes)
        => PttSessionCore.FormatDuration(L, TimeSpan.FromMinutes(minutes));

    // Nested types

    public sealed record Model(int Minutes) {
        public static readonly Model None = new((int)Constants.Audio.PttHushDurationDefault.TotalMinutes);
    }
}
