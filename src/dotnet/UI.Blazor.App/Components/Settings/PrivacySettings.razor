@using ActualChat.Contacts
@inherits ComputedStateComponent<AppUIHub, PrivacySettings.Model>
@{
    var m = State.Value;
}

<TileTopic Topic="@L.Privacy_BlockedUsers"/>

<Tile>
    <TileItem Click="@(m.Items.Count == 0 ? default : EventCallback.Factory.Create(this, OnToggleExpand))">
        <Icon>
            <i class="icon-slash-circle text-2xl"></i>
        </Icon>
        <Content>@L.Privacy_BlockedUsers</Content>
        <Right>
            <span class="text-03">@m.Items.Count</span>
            @if (m.Items.Count > 0) {
                <i class="icon-chevron-right text-2xl text-03 transition-transform @(_isExpanded ? "rotate-90" : "")"></i>
            }
        </Right>
    </TileItem>
</Tile>

@if (_isExpanded && m.Items.Count > 0) {
    <Tile>
        <div class="max-h-[80svh] overflow-y-auto">
            @foreach (var item in m.Items) {
                <TileItem IsHoverable="false">
                    <Icon>
                        <AvatarCircle Avatar="@item.Avatar" Size="@SquareSize.Size9" IsBlurred="@false"/>
                    </Icon>
                    <Content>
                        <span>@item.Name</span>
                    </Content>
                    <Right>
                        <ButtonRound
                            Class="btn-xs btn-danger"
                            Tooltip="@L.PeerContact_Unblock"
                            Click="@(() => OnUnblock(item.ContactId))">
                            <i class="icon-minus-circle text-2xl"></i>
                        </ButtonRound>
                    </Right>
                </TileItem>
                @if (item != m.Items[^1]) {
                    <Divider/>
                }
            }
        </div>
    </Tile>
}

@code {
    private bool _isExpanded;

    private IContacts Contacts => Hub.Contacts;

    protected override ComputedState<Model>.Options GetStateOptions()
        => new() {
            InitialValue = Model.None,
            Category = GetStateCategory(GetType()),
        };

    protected override async Task<Model> ComputeState(CancellationToken cancellationToken) {
        var ids = await Contacts.ListBlockedIds(Session, cancellationToken).ConfigureAwait(false);
        var items = new List<Item>(ids.Length);
        foreach (var id in ids) {
            var contact = await Contacts.Get(Session, id, cancellationToken).ConfigureAwait(false);
            if (contact?.Account is null)
                continue;

            var avatar = contact.Account.Avatar;
            var name = contact.PreferredPeerName ?? avatar.Name;
            items.Add(new Item(id, name, avatar));
        }
        return new Model(items);
    }

    private void OnToggleExpand() {
        _isExpanded = !_isExpanded;
    }

    private Task OnUnblock(ContactId contactId)
        => Hub.PeerBlockUI.SetBlocked(contactId, false);

    // Nested types

    public sealed record Model(IReadOnlyList<Item> Items) {
        public static readonly Model None = new(Array.Empty<Item>());
    }

    public sealed record Item(ContactId ContactId, string Name, Avatar Avatar);
}
