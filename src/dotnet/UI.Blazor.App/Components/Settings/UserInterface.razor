@inherits ComputedStateComponent<AppUIHub, UserInterface.Model>
@{
    var m = State.Value;
}

@if (m.EnableIncompleteUI) {
    <TileTopic Topic="@L.Settings_UILanguage"/>
    <Tile>
        <LanguageSettings/>
    </Tile>
}

<TileTopic Topic="@L.UserInterface_Font"/>
<Tile Class="font-size-tile">
    <div class="ui-settings">
        <FontSizeSlider/>
    </div>
</Tile>

<TileTopic Topic="@L.UserInterface_Theme"/>
<Tile Class="theme-tile">
    <ThemeSettings/>
</Tile>

<TileTopic Topic="@L.UserInterface_Chats"/>
<Tile>
    <TileItem Click="@OnToggleAuthorColors">
        <Icon><i class="icon-color-swatch text-2xl"></i></Icon>
        <Content>@L.UserInterface_ColorizeAuthorNames</Content>
        <Caption>@(m.IsAuthorColorsEnabled ? L.RightPanel_On : L.RightPanel_Off)</Caption>
        <Right>
            <Toggle IsChecked="@m.IsAuthorColorsEnabled" IsCheckedChanged="@(_ => OnToggleAuthorColors())"/>
        </Right>
    </TileItem>
</Tile>

@code {
    private ILogger<UserInterface> Log => field ??= Hub.LogFor<UserInterface>();

    private BubbleUI BubbleUI => Hub.BubbleUI;
    private OnboardingUI OnboardingUI => Hub.OnboardingUI;

    [CascadingParameter] public ScreenSize ScreenSize { get; set; }

    protected override ComputedState<Model>.Options GetStateOptions()
        => new() { InitialValue = Model.None };

    protected override async Task<Model> ComputeState(CancellationToken cancellationToken) {
        var account = await Hub.AccountUI.OwnAccount.Use(cancellationToken).ConfigureAwait(false);
        var appSettings = await UserSettingsUI.UserAppSettings().Get(cancellationToken).ConfigureAwait(false);
        var enableIncompleteUI = await Hub.Features.IsIncompleteUIEnabled(cancellationToken).ConfigureAwait(false);
        return new(account.IsAdmin, appSettings.IsAuthorColorsEnabled ?? true, enableIncompleteUI);
    }

    private Task OnToggleAuthorColors()
        => UserSettingsUI.UserAppSettings().Update(x => x with {
            IsAuthorColorsEnabled = !(x.IsAuthorColorsEnabled ?? true),
        });

    private async Task OnRestartWalkThrough() {
        await BubbleUI.ResetSettings();
        ToastUI.Show(L.UserInterface_WalkThroughRestarted, "icon-checkmark-circle", ToastDismissDelay.Short);
    }

    private void OnRestartOnboarding() {
        OnboardingUI.ResetSettings();
        ToastUI.Show(L.UserInterface_OnboardingRestarted, "icon-checkmark-circle", ToastDismissDelay.Short);
    }

    // Nested types

    public record Model(bool IsAdmin, bool IsAuthorColorsEnabled, bool EnableIncompleteUI)
    {
        public static readonly Model None = new(false, true, false);
    }
}
