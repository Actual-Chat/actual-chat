@inherits ComputedStateComponent<AppUIHub, UserInterface.Model>
@{
    var m = State.Value;
}

<TileTopic Topic="Font"/>
<Tile Class="font-size-tile">
    <div class="ui-settings">
        <FontSizeSlider/>
    </div>
</Tile>

<TileTopic Topic="Theme"/>
<Tile Class="theme-tile">
    <ThemeSettings/>
</Tile>

<ChatsBarSettings/>

@code {
    protected override ComputedState<Model>.Options GetStateOptions()
        => new() { InitialValue = Model.None };

    protected override async Task<Model> ComputeState(CancellationToken cancellationToken) {
        var account = await Hub.AccountUI.OwnAccount.Use(cancellationToken).ConfigureAwait(false);
        return new(account.IsAdmin);
    }

    // Nested types

    public record Model(bool IsAdmin)
    {
        public static readonly Model None = new(false);
    }
}
