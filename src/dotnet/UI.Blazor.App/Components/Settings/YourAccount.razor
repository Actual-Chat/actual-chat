@using TimeZone = ActualChat.Users.TimeZone
@using AccountField = ActualChat.UI.Blazor.App.Components.OwnAccountEditorModal.AccountField
@inherits ComputedStateComponent<AppUIHub, AccountFull>
@implements IDisposable
@inject IStringLocalizer<Strings> L
@{
    var account = State.Value;
    var readablePhone = account.Phone?.ToReadable() ?? "";
}

<TileTopic Topic="@L["YourAccount_Information"].Value"/>

<Tile Class="your-account-tile">
    <TileItem Class="first-tile-item" Click="@(() => OnEditClick(AccountField.Name))">
        <Icon>
            <AvatarBadge
                Avatar="@account.Avatar"
                Size="@SquareSize.Size9"
                NameClass="hidden" />
        </Icon>
        <Content>
            @account.Name
        </Content>
        <Caption>
            @L["YourAccount_Name"]
        </Caption>
    </TileItem>

    @if (account.AliasId is { } aliasId) {
        <TileItem Click="@(() => OnEditClick(AccountField.AliasId))">
            <Icon>
                <i class="icon-link-2"></i>
            </Icon>
            <Content>
                @("@" + aliasId.Value)
            </Content>
            <Caption>
                @L["YourAccount_UserLink"]
            </Caption>
            <Right>
                <div class="c-actions" @onclick:stopPropagation="true">
                    <CopyToClipboard
                        ButtonClass="btn-xs btn-transparent tile-hidden-btn"
                        Text="@(UrlMapper.ToAbsolute(Links.User(account.AliasInfo)))"/>
                </div>
            </Right>
        </TileItem>
    }

    <TileItem Click="@(() => OnEditClick(AccountField.Email))">
        <Icon>
            <i class="icon-at"></i>
        </Icon>
        <Content>
            @account.Email
        </Content>
        <Caption>
            @L["YourAccount_Email"]
        </Caption>
        <Right>
            <div class="c-actions" @onclick:stopPropagation="true">
                <CopyToClipboard ButtonClass="btn-xs btn-transparent tile-hidden-btn" Text="@account.Email"/>
                <VerificationStatus
                    IsVerified="account.IsEmailVerified()"
                    Class="w-8 h-8"
                    Verify="@(() => OnEditClick(AccountField.Email))"/>
            </div>
        </Right>
    </TileItem>

    <TileItem Click="@(() => OnEditClick(AccountField.Phone))">
        <Icon>
            <i class="icon-phone"></i>
        </Icon>
        <Right>
            @if (account.Phone != null) {
                <div class="c-actions" @onclick:stopPropagation="true">
                    <CopyToClipboard ButtonClass="btn-xs btn-transparent tile-hidden-btn" Text="@readablePhone"/>
                    <VerificationStatus
                        IsVerified="account.IsPhoneVerified()"
                        Class="w-8 h-8"
                        Verify="@(() => OnEditClick(AccountField.Phone))"/>
                </div>
            }
        </Right>
        <Content>
            @account.Phone?.ToReadable()
        </Content>
        <Caption>
            @L["YourAccount_Phone"]
        </Caption>
    </TileItem>

    <TileItem Click="@OnTimeZoneClick">
        <Icon>
            <i class="icon-globe"></i>
        </Icon>
        <Content>
            @(_timeZoneName ?? L["YourAccount_TimeZoneNotSet"].Value)
        </Content>
        <Caption>
            @L["YourAccount_TimeZone"]
        </Caption>
    </TileItem>

    <TileItem Class="tile-item-edit" Click="@(() => OnEditClick(AccountField.Name))">
        <Icon>
            <i class="icon-edit"></i>
        </Icon>
        <Content>
            Edit or Delete
        </Content>
        <Caption>
            Edit name, email, phone, or delete account
        </Caption>
    </TileItem>

    <TileItem Class="tile-item-share" Click="@OnShareClick">
        <Icon>
            <i class="icon-share"></i>
        </Icon>
        <Content>
            @L["YourAccount_Share"]
        </Content>
        <Caption>
            @L["YourAccount_ShareYourContact"]
        </Caption>
    </TileItem>
</Tile>

<TileTopic Topic="@L["YourAccount_MyAvatars"].Value"/>

<OwnAvatarList Account="@account"/>

@code {
    private string? _timeZoneName;
    private IReadOnlyCollection<TimeZone>? _timeZones;

    private ITimeZones TimeZones => Hub.TimeZones;

    protected override ComputedState<AccountFull>.Options GetStateOptions()
        => new() {
            InitialValue = AccountUI.OwnAccount.Value,
            Category = GetStateCategory(GetType()),
        };

    protected override async Task<AccountFull> ComputeState(CancellationToken cancellationToken) {
        var account = await AccountUI.OwnAccount.Use(cancellationToken);
        _timeZoneName = await TimeZones.FindDisplayName("en-US", account.TimeZone, cancellationToken);
        return account;
    }

    protected override async Task OnInitializedAsync() {
        await base.OnInitializedAsync();
        _timeZones = await TimeZones.List("en-US", CancellationToken.None);
    }

    public void Dispose() { }

    private void OnEditClick(AccountField field)
        => ModalUI.Show(new OwnAccountEditorModal.Model(field));

    private void OnShareClick()
        => _ = ShareUI.ShareOwnAccount();

    private void OnTimeZoneClick()
        => ModalUI.Show(new TimeZoneEditorModal.Model(_timeZones ?? []));
}
