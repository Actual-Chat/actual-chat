@inherits ComponentBase<AppUIHub>

<RadioTile Options="@Options" SelectedId="@_selectedId" SelectedIdChanged="@OnSelectedIdChanged"/>

@code {
    private string _selectedId = "";

    private ThemeUI ThemeUI => Hub.ThemeUI;
    private ILogger Log => field ??= Hub.LogFor(GetType());

    private IReadOnlyList<RadioTileOption> Options => [
        new(nameof(Theme.Light), L.ThemeSettings_Light),
        new(nameof(Theme.Ash), L.ThemeSettings_LightLinkWater),
        new(nameof(Theme.Dark), L.ThemeSettings_Dark),
        new("", L.ThemeSettings_MatchSystem),
    ];

    protected override void OnInitialized()
        => _selectedId = GetThemeKey(ThemeUI.State.Value.Theme);

    private void OnSelectedIdChanged(string themeKey) {
        _selectedId = themeKey;
        ThemeUI.SetTheme(GetTheme(themeKey)).WithErrorLog(Log, "Failed to change theme to {Theme}", themeKey);
    }

    private string GetThemeKey(Theme? theme)
        => theme?.ToString() ?? "";

    private Theme? GetTheme(string? themeKey)
        => !themeKey.IsNullOrEmpty() && Enum.TryParse<Theme>(themeKey, true, out var v) ? v : null;
}
