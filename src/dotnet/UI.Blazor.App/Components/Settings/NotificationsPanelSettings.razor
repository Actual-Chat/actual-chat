@namespace ActualChat.UI.Blazor.App.Components
@using ActualChat.Users
@inherits ComputedStateComponent<AppUIHub, NotificationsPanelSettings.Model>
@{
    var m = State.Value;
    _formModel.Retention = m.Retention;
}

<Tile Class="notifications-panel-settings">
    <Form Model="@_formModel">
        <DataAnnotationsValidator/>

        <FormBlock>
            <p class="c-description">
                A chat you've read stays in the notifications panel for a while, then drops out on its own.
            </p>
            <FormSection
                For="() => _formModel.Retention"
                InputId="@_formModel.RetentionFormId"
                IsLabelInsideInput="true"
                Label="Drop read chats"
                IsRequired="true"
                HideValidationMessage="true">
                <InputSelect
                    Value="_formModel.Retention"
                    ValueExpression="@(() => _formModel.Retention)"
                    ValueChanged="@((NotificationsPanelRetention retention) => OnRetentionChanged(retention))">
                    @foreach (var option in Options) {
                        <option value="@option">@GetLabel(option)</option>
                    }
                </InputSelect>
            </FormSection>
        </FormBlock>
    </Form>
</Tile>

@code {
    private static readonly NotificationsPanelRetention[] Options = [
        NotificationsPanelRetention.Immediately,
        NotificationsPanelRetention.UntilPanelClosed,
        NotificationsPanelRetention.Minutes10,
        NotificationsPanelRetention.Hour1,
        NotificationsPanelRetention.Hours3,
        NotificationsPanelRetention.Hours8,
        NotificationsPanelRetention.Hours24,
    ];

    private FormModel _formModel = null!;

    protected override void OnInitialized()
        => _formModel = new FormModel(ComponentIdGenerator);

    protected override ComputedState<Model>.Options GetStateOptions()
        => new() { InitialValue = Model.None, Category = GetStateCategory(GetType()) };

    protected override async Task<Model> ComputeState(CancellationToken cancellationToken) {
        var settings = await UserSettingsUI.UserNotificationsPanelSettings().Get(cancellationToken).ConfigureAwait(false);
        return new(settings.Retention);
    }

    private Task OnRetentionChanged(NotificationsPanelRetention retention) {
        _formModel.Retention = retention;
        return UserSettingsUI.UserNotificationsPanelSettings()
            .Update(x => x with { Retention = retention }, CancellationToken.None);
    }

    private static string GetLabel(NotificationsPanelRetention retention)
        => retention switch {
            NotificationsPanelRetention.Immediately => "Immediately",
            NotificationsPanelRetention.UntilPanelClosed => "After closing the panel",
            NotificationsPanelRetention.Minutes10 => "After 10 minutes",
            NotificationsPanelRetention.Hour1 => "After 1 hour",
            NotificationsPanelRetention.Hours3 => "After 3 hours",
            NotificationsPanelRetention.Hours8 => "After 8 hours",
            NotificationsPanelRetention.Hours24 => "After 24 hours",
            _ => retention.ToString(),
        };

    // Nested types

    public sealed class FormModel {
        public NotificationsPanelRetention Retention { get; set; }
        public string RetentionFormId { get; }

        public FormModel(ComponentIdGenerator componentIdGenerator)
            => RetentionFormId = componentIdGenerator.Next("notifications-panel-retention");
    }

    public sealed record Model(NotificationsPanelRetention Retention = NotificationsPanelRetention.Hour1) {
        public static readonly Model None = new();
    }
}
