@namespace ActualChat.UI.Blazor.App.Components
@inherits ComputedStateComponent<AppUIHub, AudioRecordingChatEntryMessageView.Model?>
@{
    var m = State.Value;
    var isVoiceDetected = m?.IsVoiceDetected ?? false;
    _rendered = m;
}

<p class="chat-message-markup">
    <ChatEntryKindView IsTranscribed="@true"/>
    <span>@(isVoiceDetected ? "Transcribing..." : "Listening...")</span>
</p>


@code {
    private Model? _rendered;

    [Parameter, EditorRequired] public ChatContext ChatContext { get; set; } = null!;
    [Parameter, EditorRequired] public ChatEntryMessage Message { get; set; } = null!;

    protected override async Task<Model?> ComputeState(CancellationToken cancellationToken) {
        var state = await Hub.AudioRecorder.State.Use(cancellationToken).ConfigureAwait(false);
        if (state.ChatId != ChatContext.ChatId)
            return _rendered; // Use last state when recording in the chat turned off to avoid flickering.
        return new Model(state.IsVoiceActive);
    }

    // Nested types
    public record Model(bool IsVoiceDetected);
}
