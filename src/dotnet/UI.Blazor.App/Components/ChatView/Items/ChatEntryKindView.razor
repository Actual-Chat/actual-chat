@namespace ActualChat.UI.Blazor.App.Components
@inherits FusionComponentBase<AppUIHub>
@{
    var cls = IsTranslation
        ? "icon-translate"
        : Kind == ChatEntryKind.Audio
            ? "icon-volume-up"
            : "icon-text";
}

<span class="chat-entry-kind-marker @cls"></span>

@code {
    [Parameter, EditorRequired] public ChatEntryKind Kind { get; set; }
    [Parameter, EditorRequired] public bool IsTranslation { get; set; }
}
