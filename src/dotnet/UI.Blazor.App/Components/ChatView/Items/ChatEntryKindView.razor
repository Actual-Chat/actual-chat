@namespace ActualChat.UI.Blazor.App.Components
@inherits FusionComponentBase<AppUIHub>
@{
    var cls = IsTranscribed ? "icon-voice-to-text-message" : "icon-text";
}

<span class="chat-entry-kind-marker entry-marker">
    <i class="@cls"></i>
</span>

@code {
    [Parameter, EditorRequired] public bool IsTranscribed { get; set; }
}
