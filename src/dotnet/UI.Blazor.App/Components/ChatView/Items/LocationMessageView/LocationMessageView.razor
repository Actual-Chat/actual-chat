@namespace ActualChat.UI.Blazor.App.Components
@inherits ComputedStateComponent<AppUIHub, LocationMessageView.Model?>
@{
    var m = State.Value;
    var liveCls = m?.IsLive == true ? "live" : "";
}
@* Fixed-height container reserved on first render (before ComputeState resolves) so the
   virtual list's total height stays stable and doesn't scroll-jump when the map fills in. *@
<div class="location-message @liveCls" @onclick="@OnOpenMap">
    @if (m is not null) {
        <div class="c-map-area">
            <MapView
                Class="c-map"
                Zoom="15"
                Interactive="false"
                Center="@m.Center"
                Markers="@m.Markers"/>
            @if (m.Countdown is { } countdown) {
                <RoundProgress Class="c-countdown" Radius="14.5" Fraction="@countdown.Fraction">
                    @if (countdown.IsUnlimited) {
                        <i class="icon-infinity"></i>
                    } else {
                        <span>@countdown.Text</span>
                    }
                </RoundProgress>
            }
            @if (m.IsOwnLive) {
                <ButtonRound Class="btn-stop-sharing" Click="@OnStopSharing" StopPropagation="true"
                             Tooltip="Stop sharing" TooltipPosition="FloatingPosition.Top">
                    <marker-pin-off-svg></marker-pin-off-svg>
                </ButtonRound>
            }
            @if (m.IsOwnLive && m.TrackingError is not null) {
                <div class="c-tracking-error">
                    <i class="icon-alert-circle"></i>
                    <span>Location tracking is off</span>
                </div>
            }
        </div>
        <div class="c-footer">
            @if (m.IsLive) {
                <marker-pin-live-svg class="c-pin"></marker-pin-live-svg>
            } else {
                <i class="icon-marker-pin c-pin"></i>
            }
            <div class="c-info">
                <div class="c-title">@(m.IsLive ? "Live location" : "Location")</div>
                <div class="c-caption">
                    @if (m.DistanceText.IsNullOrEmpty()) {
                        @m.Center.ToDisplayText()
                    } else {
                        @($"{m.DistanceText} from you")
                    }
                </div>
            </div>
            <div class="c-copy" @onclick:stopPropagation="true">
                <CopyToClipboard ButtonClass="btn-xs btn-transparent" Text="@m.Center.ToOpenStreetMapUrl()"/>
            </div>
        </div>
    }
</div>

@code {
    private MutableState<GeoPoint?> _currentLocation = null!;

    private ISharedLocations SharedLocations => Hub.SharedLocations;
    private LocationUI LocationUI => Hub.LocationUI;
    private ILocationTracker Tracker => Hub.LocationTracker;
    private LocationPermissionHandler LocationPermission
        => field ??= Hub.Services.GetRequiredService<LocationPermissionHandler>();

    [Parameter, EditorRequired] public ChatEntry Entry { get; set; } = null!;

    protected override void OnInitialized() {
        _currentLocation = StateFactory.NewMutable(
            (GeoPoint?)null,
            StateCategories.Get(GetType(), nameof(_currentLocation)));
        _ = FetchCurrentLocation();
    }

    protected override ComputedState<Model?>.Options GetStateOptions()
        => ComputedStateComponent.GetStateOptions(GetType(),
            static t => new ComputedState<Model?>.Options() {
                InitialValue = null,
                UpdateDelayer = FixedDelayer.NextTick,
                Category = GetStateCategory(t),
            });

    protected override async Task<Model?> ComputeState(CancellationToken cancellationToken) {
        if (Entry.LocationId is not { } locationId)
            return null;

        var chatId = Entry.ChatId;
        var location = await SharedLocations.Get(Session, chatId, locationId, cancellationToken)
            .ConfigureAwait(false);
        if (location is null)
            return null;

        var marker = await LocationUI.GetMapMarker(chatId, locationId, cancellationToken).ConfigureAwait(false)
            ?? new MapMarker(location.Id.Value, location.Point);
        var countdown = await LocationUI.GetCountdown(chatId, locationId, cancellationToken).ConfigureAwait(false);
        var ownAuthor = await Hub.Authors.GetOwn(Session, chatId, cancellationToken).ConfigureAwait(false);
        var isOwn = ownAuthor is not null && location.AuthorId == ownAuthor.Id;
        var isOwnLive = isOwn && countdown is not null;
        var trackingError = isOwnLive
            ? await LocationUI.GetTrackingError(chatId, cancellationToken).ConfigureAwait(false)
            : null;
        var distanceText = isOwn ? "" : await GetDistanceText(location.Point, cancellationToken).ConfigureAwait(false);
        return new Model(
            location.Point,
            [marker],
            countdown,
            isOwnLive,
            distanceText,
            trackingError);
    }

    // Private methods

    private async Task<string> GetDistanceText(GeoPoint target, CancellationToken cancellationToken) {
        var ownPoint = await Tracker.LastKnown.Use(cancellationToken).ConfigureAwait(false)
            ?? await _currentLocation.Use(cancellationToken).ConfigureAwait(false);
        return ownPoint is { } point ? point.DistanceTextTo(target) : "";
    }

    private async Task FetchCurrentLocation() {
        // Never prompts for the location permission: a message card must stay passive,
        // so it reads a cached fix only when the permission is already granted.
        if (await LocationPermission.Check(CancellationToken.None).ConfigureAwait(false) != true)
            return;

        if (await Tracker.Get().ConfigureAwait(false) is { } point)
            _currentLocation.Value = point;
    }

    private Task OnOpenMap()
        => ModalUI.Show(new LocationMapModal.Model(Entry.ChatId, Entry.LocationId));

    private Task OnStopSharing()
        => LocationUI.StopSharing(Entry.ChatId, CancellationToken.None);

    // Nested types

    public sealed record Model(
        GeoPoint Center,
        IReadOnlyList<MapMarker> Markers,
        LocationCountdown? Countdown,
        bool IsOwnLive,
        string DistanceText = "",
        GeoTrackingError? TrackingError = null) {
        public bool IsLive => Countdown is not null;
    }
}
