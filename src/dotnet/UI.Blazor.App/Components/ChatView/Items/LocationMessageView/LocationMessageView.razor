@namespace ActualChat.UI.Blazor.App.Components
@inherits ComputedStateComponent<AppUIHub, LocationMessageView.Model?>
@{
    var m = State.Value;
}
@* Fixed-height container reserved on first render (before ComputeState resolves) so the
   virtual list's total height stays stable and doesn't scroll-jump when the map fills in. *@
<div class="location-message" @onclick="@OnOpenMap">
    @if (m is not null) {
        <div class="c-map-area">
            <MapView
                Class="c-map"
                Zoom="15"
                Interactive="false"
                Center="@m.Center"
                Markers="@m.Markers"/>
            @if (m.IsLive) {
                <div class="c-live-caption">
                    <div class="c-title">
                        @if (m.TrackingError is not null) {
                            <i class="icon-alert-circle c-broken-icon"></i>
                            <span>Location tracking is off</span>
                        } else {
                            <span class="c-live-dot"></span>
                            <span>Live Location</span>
                        }
                    </div>
                    @if (m.TrackingError is null) {
                        <div class="c-updated">
                            @("Updated ")<LiveTimeDeltaText Moment="@m.ModifiedAt" NullText=""/>
                        </div>
                    }
                </div>
            }
        </div>
        <div class="c-footer">
            <i class="icon-location-pin"></i>
            @* TODO: place name + address once reverse geocoding is available *@
            <div class="c-info">
                <div class="c-title">@(m.IsLive ? "Live location" : "Location")</div>
                <div class="c-caption">@m.Center.ToDisplayText()</div>
            </div>
            <div class="c-copy" @onclick:stopPropagation="true">
                <CopyToClipboard ButtonClass="btn-xs btn-transparent" Text="@m.Center.ToOpenStreetMapUrl()"/>
            </div>
        </div>
    }
</div>

@code {
    private ISharedLocations SharedLocations => Hub.SharedLocations;
    private LocationUI LocationUI => Hub.LocationUI;

    [Parameter, EditorRequired] public ChatEntry Entry { get; set; } = null!;

    protected override ComputedState<Model?>.Options GetStateOptions()
        => ComputedStateComponent.GetStateOptions(GetType(),
            static t => new ComputedState<Model?>.Options() {
                InitialValue = null,
                UpdateDelayer = FixedDelayer.NextTick,
                Category = GetStateCategory(t),
            });

    protected override async Task<Model?> ComputeState(CancellationToken cancellationToken) {
        if (Entry.LocationId is not { } locationId)
            return null;

        var location = await SharedLocations.Get(Session, Entry.ChatId, locationId, cancellationToken)
            .ConfigureAwait(false);
        if (location is null)
            return null;

        var marker = new MapMarker(location.Id.Value, location.Point);
        var trackingError = await LocationUI.GetTrackingError(Entry.ChatId, cancellationToken).ConfigureAwait(false);
        return new Model(
            location.Point,
            [marker],
            location.IsLive(Clocks.ServerClock.Now),
            location.ModifiedAt,
            trackingError);
    }

    private Task OnOpenMap()
        => ModalUI.Show(new LocationMapModal.Model(Entry.ChatId, Entry.LocationId));

    // Nested types

    public sealed record Model(
        GeoPoint Center,
        IReadOnlyList<MapMarker> Markers,
        bool IsLive,
        Moment ModifiedAt,
        GeoTrackingError? TrackingError = null);
}
