@namespace ActualChat.UI.Blazor.App.Components
@inherits ComputedStateComponent<ThreadMessageView.Model>
@{
    var chat = Message.Chat;
    var m = State.Value;
    var firstAuthors = m.AuthorIds.Take(3).ToList();
    var extraAuthorCount = Math.Clamp(m.AuthorIds.Count - 3, 0, 99);
}

<div class="thread-message">
    <div class="c-title">
        <div class="c-left">
            <span class="c-text">
                <span class="c-hash">#</span>
                How does your honour for this many a day
            </span>
        </div>
        <div class="c-right" @onclick="@OnGoToTheThread">
            <i class="icon-message-stars"></i>
            <span class="c-message-count">23</span>
            <i class="icon-chevron-right"></i>
        </div>
    </div>
    <div class="c-short">
        A thread about faith. Claudius thinks there's no God. Ophelia thinks there is a God. Hamlet doubts God,
        but does not deny A thread about faith. Claudius thinks there's no God. Ophelia thinks there is a God.
        Hamlet doubts God, but does not deny
    </div>
    <Divider/>
    <div class="c-last-messages">
        @foreach (var chatEntry in m.Entries) {
            <div class="c-message-wrapper">
                <AuthorCircle
                    AuthorSid="@chatEntry.AuthorId.Value"
                    Size="SquareSize.Size8" />
                <div class="c-content">
                    <div class="c-info">
                        <AuthorName AuthorSid="@chatEntry.AuthorId" Class="chat-message-author-name"/>
                        <LiveTimeDeltaText Class="chat-message-timestamp min-w-fit" Moment="@chatEntry.BeginsAt"/>
                    </div>
                    <span class="c-message">
                        @chatEntry.Content
                    </span>
                </div>
            </div>
        }
    </div>
    <div class="c-footer">
        <div class="c-author-list">
            @foreach (var authorId in firstAuthors) {
                <AuthorCircle AuthorSid="@authorId.Value" Size="@SquareSize.Size6"/>
            }
            @if (extraAuthorCount > 0) {
                <div class="author-incut ai-extra">+@extraAuthorCount</div>
            }
        </div>
        <div class="c-info">
            23.11 created by Ophelia R.
        </div>
        <HeaderButton Click="CopyToClipboardRequested">
            <i class="icon-copy"></i>
        </HeaderButton>
    </div>
</div>


@code {
    private ChatUIHub Hub => ChatContext.Hub;
    private Session Session => Hub.Session();
    private IChats Chats => Hub.Chats;
    private History History => Hub.History;

    [Parameter, EditorRequired] public ChatContext ChatContext { get; set; } = null!;
    [Parameter, EditorRequired] public ThreadMessage Message { get; set; } = null!;
    [Parameter] public EventCallback CopyToClipboardRequested { get; set; }

    protected override async Task<Model> ComputeState(CancellationToken cancellationToken) {
        var tileRange = ChatUI.IdTileStack.GetOptimalCoveringTiles(new Range<long>(0, 2))[0]; // Get tile for the first 2 messages.
        var chatId = Message.Chat.Id;
        var tile = await Chats.GetTile(Session, chatId, ChatEntryKind.Text, tileRange.Range, cancellationToken).ConfigureAwait(false);
        var allEntries = tile.Entries;
        var authorIds = allEntries.Select(entry => entry.AuthorId).Distinct().ToList();

        return new Model(tile.Entries.OrderBy(c => c.LocalId).Take(2).ToImmutableArray(), authorIds);
    }

    private void OnGoToTheThread()
        => _ = History.NavigateTo(Links.Chat(Message.Chat.Id));

    // Nested types
    public record Model(IReadOnlyList<ChatEntry> Entries, List<AuthorId> AuthorIds);
}
