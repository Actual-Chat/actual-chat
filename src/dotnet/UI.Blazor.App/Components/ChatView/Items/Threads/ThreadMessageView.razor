@namespace ActualChat.UI.Blazor.App.Components
@using StringBuilderExt = ActualLab.Text.StringBuilderExt
@inherits ComputedStateComponent<AppUIHub, ThreadMessageView.Model?>
@{
    var chat = Message.Chat;
    var m = State.Value;
    var isLoading = m is null;
    var title = m?.Title ?? TranslatedText.From(chat.Title);
    var description = m?.Description ?? TranslatedText.From(chat.Description);
    var createdAt = DateTimeConverter.ToLocalTime(chat.CreatedAt.ToDateTime());
    var now = DateTimeConverter.ToLocalTime(Clocks.SystemClock.Now.ToDateTime());
    var daysDelta = (now.Date - createdAt.Date).Days;
    var creationDate = createdAt.Year != now.Year // prev year
        ? createdAt.ToString("MMM dd, yyyy")
        : daysDelta == 0 // today
            ? "Today"
                : daysDelta == 1 // yesterday
                ? "Yesterday"
                    : daysDelta < 8 // this week
                    ? createdAt.ToString("dddd")
                        : createdAt.ToString("MMM dd"); // this year
    var attachments = m is null ? [] : m.Attachments;
    var messageCount = m?.MessageCount ?? 0;
    var previewEntries = m?.Entries.Select(x => new PreviewEntry(x.Item1, x.Item2)).ToList() ?? [];
}

<div class="thread-message"
     data-menu="@(MenuRef.New<ThreadMenu>(Message.Entry.Id.ToString() ,chat.Id.Value, title.Text))">
    <div class="c-title">
        <div class="c-left">
            <span class="c-text">
                <span class="c-hash">
                    <i class="icon-thread text-headline-6"></i>
                </span>
                @title.Text
                @TranslationFragments.TranslationMark(title.State)
            </span>
        </div>
        <HeaderButton
            Class="btn-go-to-thread"
            Tooltip="Go to the thread"
            Click="@OnGoToTheThread">
            <i class="icon-arrow-right"></i>
        </HeaderButton>
    </div>
    <div class="c-short">
        @description.Text
        @TranslationFragments.TranslationMark(description.State)
    </div>
    <Divider/>
    <LastEntriesPreview Entries="@previewEntries" IsLoading="@isLoading"/>
    @if (attachments.Length > 0) {
        var (mediaList, fileList) = GetOrderedAttachmentList(attachments);
        <div class="message-attachments">
            <VisualMediaAttachmentList MediaList="@mediaList" IsConversation="true" IsNarrow="@ScreenSize.IsNarrow()"/>
            <div class="message-file-attachments">
                @foreach (var attachment in fileList) {
                    if (attachment.IsAudio()) {
                        <AudioFileAttachment Attachment="@attachment"/>
                    } else {
                        <FileAttachment Attachment="@attachment"/>
                    }
                }
            </div>
        </div>
    }

    <div class="c-footer">
        <div class="c-author-list">
            @if (isLoading) {
                <round-skeleton radius="6"/>
                <round-skeleton radius="6"/>
            } else {
                const int displayAuthorsLimit = 3;
                var topAuthorIds = m!.TopAuthorIds.Take(displayAuthorsLimit).ToList();
                var extraAuthorCount = Math.Clamp(m.AuthorCount - topAuthorIds.Count, 0, 99);
                foreach (var authorId in topAuthorIds) {
                    <AuthorCircle AuthorId="@authorId" Size="@SquareSize.Size6"/>
                }
                if (extraAuthorCount > 0) {
                    <div class="author-incut ai-extra">+@extraAuthorCount</div>
                }
            }
        </div>
        <div class="c-info">
            <div class="c-created">
                <span>@creationDate,</span><span> created by </span>
                @if (isLoading) {
                    <string-skeleton firstWidth="4" secondWidth="8" height="4"/>
                } else {
                    <span class="c-author-name">@m!.OwnerName</span>
                }
            </div>
            <div class="c-count">
                @(messageCount + " message".Pluralize((int)messageCount))
            </div>
        </div>
        @if (!isLoading) {
            <HeaderButton Click="OnCopyToClipboardRequested">
                <i class="icon-copy"></i>
            </HeaderButton>
        }
    </div>
</div>


@code {
    private IChatMarkupHub _chatMarkupHub = null!;

    private IChats Chats => Hub.Chats;
    private ChatUI ChatUI => Hub.ChatUI;
    private IChatThreads ChatThreads => Hub.ChatThreads;
    private ClipboardUI ClipboardUI => Hub.ClipboardUI;
    private TranslationUI TranslationUI => Hub.TranslationUI;

    [CascadingParameter] public ScreenSize ScreenSize { get; set; }

    // ChatContext belongs to parent Chat, not to the thread chat.
    [Parameter, EditorRequired] public ChatContext ChatContext { get; set; } = null!;
    [Parameter, EditorRequired] public ThreadMessage Message { get; set; } = null!;

    protected override void OnInitialized() =>
        _chatMarkupHub = Hub.ChatMarkupHubFactory[Message.Chat.Id];

    protected override async Task<Model?> ComputeState(CancellationToken cancellationToken) {
        var chatId = Message.ChatId;
        var chat = await Chats.Get(Session, chatId, cancellationToken).ConfigureAwait(false);
        if (chat is null)
            return null;

        var session = Session;
        var threadCreator = await ChatThreads.GetThreadCreator(session, chatId, cancellationToken).ConfigureAwait(false);
        var ownerName = threadCreator?.Avatar.Name ?? "Unknown";
        var chatEntries = await ChatUI.GetThreadPreviewEntries(chatId, cancellationToken).ConfigureAwait(false);
        var markups = await chatEntries.Select(x => GetMarkup(x, cancellationToken)).Collect(cancellationToken).ConfigureAwait(false);
        var threadStat = await ChatThreads.GetThreadStat(session, chatId, cancellationToken).ConfigureAwait(false);
        var attachments = threadStat.Attachments;

        var title = TranslatedText.From(chat.Title);
        var description = TranslatedText.From(chat.Description);
        var mustTranslate = await TranslationUI.MustTranslate(chat, cancellationToken).ConfigureAwait(false);
        if (mustTranslate) {
            var titleTranslationTask = TranslationUI.Get(chatId, ThreadTranslationIdKind.Title, cancellationToken);
            var descriptionTranslationTask = TranslationUI.Get(chatId, ThreadTranslationIdKind.Description, cancellationToken);
            await Task.WhenAll(titleTranslationTask, descriptionTranslationTask).ConfigureAwait(false);
            var titleTranslation = await titleTranslationTask.ConfigureAwait(false);
            var descriptionTranslation = await descriptionTranslationTask.ConfigureAwait(false);
            title = TranslatedText.From(chat.Title, titleTranslation);
            description = TranslatedText.From(chat.Description, descriptionTranslation);
        }

        return new Model(title, description, chatEntries.Zip(markups).ToList(), threadStat.TopAuthorIds, attachments, threadStat.AuthorCount, threadStat.MessageCount, ownerName);
    }

    private async Task<Markup> GetMarkup(ChatEntry chatEntry, CancellationToken cancellationToken)
    {
        var markup = await _chatMarkupHub.GetMarkup(chatEntry, MarkupConsumer.MessageView, cancellationToken).ConfigureAwait(false);
        if (!await TranslationUI.MustTranslate(chatEntry, false, cancellationToken).ConfigureAwait(false))
            return markup;

        var translation = await TranslationUI.Get(chatEntry.Id, cancellationToken).ConfigureAwait(false);
        if (translation is null || translation.MatchesOriginal(chatEntry.Content))
            return markup;

        return _chatMarkupHub.Parser.Parse(translation.Content);
    }

    private (ChatEntryAttachment[], ChatEntryAttachment[]) GetOrderedAttachmentList(ChatEntryAttachment[] attachments)
        => (attachments.Where(a => a.IsVisualMedia()).ToArray(),
            attachments.Where(a => !a.IsVisualMedia()).ToArray());

    private void OnGoToTheThread()
        => _ = History.NavigateTo(Links.Chat(Message.Chat.Id));

    private async Task OnCopyToClipboardRequested() {
        var text = GetText();
        await ClipboardUI.WriteText(text).ConfigureAwait(false);
    }

    private string GetText() {
        var m = State.Value;
        var sb = StringBuilderExt.Acquire();
        sb.Append("Thread \"");
        sb.Append(m?.Title.Text ?? Message.Chat.Title);
        sb.Append("\" on");
        sb.Append(CoreConstants.AppName);
        sb.Append(": ");
        sb.Append(UrlMapper.ToAbsolute(Links.Chat(Message.Chat.Id)));
        return sb.ToStringAndRelease();
    }

    // Nested types
    public record Model(
        TranslatedText Title,
        TranslatedText Description,
        IReadOnlyList<(ChatEntry, Markup)> Entries,
        AuthorId[] TopAuthorIds,
        ChatEntryAttachment[] Attachments,
        int AuthorCount,
        long MessageCount,
        string OwnerName);
}
