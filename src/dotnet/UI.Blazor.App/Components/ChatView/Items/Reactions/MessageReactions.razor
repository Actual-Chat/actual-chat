@namespace ActualChat.UI.Blazor.App.Components
@inherits ComputedStateComponent<AppUIHub, MessageReactions.Model?>
@{
    var serverModel = State.Value;
    var pending = OptimisticReactions.List(Entry.Id);
    var m = pending.Count > 0
        ? ApplyOptimistic(serverModel, Entry.Id, pending)
        : serverModel;
    if (m is null)
        return;

}

<ul class="message-reactions @Class">
    @foreach (var reaction in m.Reactions) {
        <ReactionBadge @key="@reaction.Emoji"
                       Reaction="reaction"
                       IsOwn="m.OwnEmojis.Contains(reaction.Emoji)"
                       Entry="Entry"/>
    }

    <li class="message-reactions-add"
        data-menu="@(MenuRef.New<ReactionSelectMenu>(Entry.Id.Value))"
        data-menu-trigger="@MenuTrigger.Primary"
        data-menu-placement="@(FloatingPosition.Right.ToPositionString())">
        <AddReactionIcon Class="message-reactions-add-icon"/>
    </li>
</ul>

@code {
    private IReactions Reactions => Hub.Reactions;
    private OptimisticReactions OptimisticReactions => Hub.OptimisticReactions;

    [Parameter, EditorRequired] public ChatEntry Entry { get; set; } = null!;
    [Parameter] public string Class { get; set; } = "";
    [CascadingParameter] ScreenSize ScreenSize { get; set; }

    protected override void OnInitialized()
        => OptimisticReactions.Changed += OnOptimisticChanged;

    public override ValueTask DisposeAsync() {
        OptimisticReactions.Changed -= OnOptimisticChanged;
        return base.DisposeAsync();
    }

    private void OnOptimisticChanged(ChatEntryId entryId) {
        if (entryId == Entry.Id)
            this.NotifyStateHasChanged();
    }

    protected override ComputedState<Model?>.Options GetStateOptions()
        => new() {
            InitialValue = Entry.HasReactions ? new Model([], []) : null,
            Category = GetStateCategory(GetType()),
        };

    protected override async Task<Model?> ComputeState(CancellationToken cancellationToken) {
        var entryId = Entry.Id;
        var summaries = await Reactions.ListSummaries(Session, entryId, cancellationToken).ConfigureAwait(false);
        Reaction[] ownReactions = [];
        if (summaries.Length > 0)
            ownReactions = await Reactions.ListOwn(Session, entryId, cancellationToken).ConfigureAwait(false);
        var ownEmojis = ownReactions.Select(x => x.Emoji).ToArray();

        // Clear optimistic state once server data reflects the expected change
        foreach (var pending in OptimisticReactions.List(entryId))
            if (ownEmojis.Contains(pending.Emoji) != pending.IsRemove)
                OptimisticReactions.TryRemove(entryId, pending.Emoji);

        return summaries.Length == 0 ? null : new(summaries, ownEmojis);
    }

    private static Model? ApplyOptimistic(
        Model? serverModel,
        ChatEntryId entryId,
        List<OptimisticReactions.OptimisticReactionInfo> pending) {
        var reactions = serverModel?.Reactions.ToList() ?? [];
        var ownEmojis = serverModel?.OwnEmojis.ToHashSet() ?? [];
        foreach (var (emoji, isRemove) in pending) {
            if (isRemove) {
                if (ownEmojis.Remove(emoji))
                    UpdateSummaryCount(reactions, entryId, emoji, -1);
            } else if (ownEmojis.Add(emoji))
                UpdateSummaryCount(reactions, entryId, emoji, +1);
        }

        return reactions.Count > 0 ? new Model(reactions.ToArray(), ownEmojis.ToArray()) : null;
    }

    private static void UpdateSummaryCount(
        List<ReactionSummary> summaries,
        ChatEntryId entryId,
        Emoji emoji,
        int delta) {
        for (int i = 0; i < summaries.Count; i++) {
            if (summaries[i].Emoji == emoji) {
                var newCount = summaries[i].Count + delta;
                if (newCount <= 0)
                    summaries.RemoveAt(i);
                else
                    summaries[i] = summaries[i] with { Count = newCount };
                return;
            }
        }
        if (delta > 0) {
            summaries.Add(new ReactionSummary {
                Id = Symbol.Empty,
                EntryId = entryId,
                Emoji = emoji,
                Count = delta,
            });
        }
    }

    // Nested types

    public sealed record Model(
        ReactionSummary[] Reactions,
        Emoji[] OwnEmojis
    );
}
