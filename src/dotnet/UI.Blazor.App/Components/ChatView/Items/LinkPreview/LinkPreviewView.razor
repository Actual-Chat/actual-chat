@namespace ActualChat.UI.Blazor.App.Components
@using ActualChat.Media
@using LinkPreview = ActualChat.Media.LinkPreview;
@inherits ComputedStateComponent<AppUIHub, LinkPreviewView.Model?>
@{
    if (State.IsInitial(out var m) || m is null)
        return;

    var preview = m.Preview;
    var uri = m.Uri;
    var imageUrl = GetImageUrl(preview.PreviewMedia, m.Entry.LinkPreviewMode);
    var compactCls = preview.PreviewMedia != null ? "" : "compact";
    var hasThumbnailCls = preview.PreviewMedia != null ? "" : "no-thumbnail";
    var linkMenuRef = MenuRef.New<LinkPreviewMenu>(
        m.Entry.Id.Value,
        uri.ToString(),
        m.LocalLink?.LocalUrl.Value ?? "").ToString();
}

@if (m.LocalLink is { CanRender: true }) {
    <LocalLinkPreview Data="@m.LocalLink"/>
} else {
    var isLocal = m.LocalLink is { };
    var target = isLocal ? "_self" : "_blank";
    <a class="link-preview unfocusable @hasThumbnailCls @compactCls" href="@uri" target="@target">
        @RenderMedia()
        <div class="c-info">
            @RenderInfo()
            <span class="c-domain">@uri.Host</span>
        </div>
        <div class="incut"></div>
    </a>
}

<ButtonRound
    Class="link-more-btn btn-xs"
    data-menu="@linkMenuRef"
    data-menu-trigger="@MenuTrigger.Primary"
    data-menu-placement="@(FloatingPosition.BottomEnd.ToPositionString())">
    <i class="icon-more-vertical text-xl"></i>
</ButtonRound>

<div class="link-buttons">
    <CopyTrigger Tooltip="@uri.ToString()" CopyText="@uri.ToString()">
        <HeaderButton>
            <i class="hide-on-copied-hint icon-copy" aria-hidden="true"></i>
            <i class="copied-hint icon-checkmark-simple" aria-hidden="true"></i>
        </HeaderButton>
    </CopyTrigger>
    @if (m.LocalLink is null) {
        <HeaderButton
            Tooltip="@L.MessageMenu_Forward"
            Click="@(() => SelectionUI.Forward(m.Entry.Id))">
            <i class="icon-share"></i>
        </HeaderButton>
    }
</div>

@{
    RenderFragment RenderMedia() {
        if (preview.PreviewMedia != null) {
            if (preview.IsYouTubeVideo) {
                return @<div class="c-thumbnail c-video">
                           <image-skeleton
                               class="c-skeleton"
                               src="@imageUrl"/>
                           <div class="c-overlay">
                               <i class="c-play icon-play-fill"></i>
                           </div>
                       </div>;
            }
            return @<image-skeleton
                        class="c-thumbnail"
                        src="@imageUrl"/>;
        }
        return @<div class="c-icon">
                   <i class="icon-link-2"></i>
               </div>;
    }

    RenderFragment RenderInfo() =>
        @<div>
            <span class="c-title">@preview.Title</span>
            @if (!preview.Description.IsNullOrEmpty()) {
                <div class="c-description">@preview.Description</div>
            }
        </div>;
}

@code {
    private SelectionUI SelectionUI => Hub.SelectionUI;
    private LinkPreviewUI LinkPreviewUI => Hub.LinkPreviewUI;

    [Parameter, EditorRequired] public ChatEntry Entry { get; set; } = null!;
    [Parameter, EditorRequired] public LinkPreview LinkPreview { get; set; } = null!;
    [CascadingParameter] public ScreenSize ScreenSize { get; set; }

    protected override async Task<Model?> ComputeState(CancellationToken cancellationToken) {
        var entry = Entry;
        var linkPreview = LinkPreview;
        if (entry.LinkPreviewMode == LinkPreviewMode.None || linkPreview.IsEmpty)
            return null;

        Uri.TryCreate(linkPreview.Url, UriKind.Absolute, out var uri);
        if (uri == null)
            return null;

        var localLink = await LinkPreviewUI
            .TryGetLocal(linkPreview.Url, cancellationToken)
            .ConfigureAwait(false); // Ok here: no further access to locals
        return new Model {
            Entry = entry,
            Preview = linkPreview,
            Uri = uri,
            LocalLink = localLink,
        };
    }

    // Private methods

    private string GetImageUrl(Media? preview, LinkPreviewMode linkPreviewMode)
    {
        if (preview?.BlobId.IsNullOrEmpty() != false)
            return "";

        var imageUrl = UrlMapper.ContentUrl(preview.BlobId);
        // TODO: use image metadata for better proportions selection
        var (width, height) = GetImageMaxSize(linkPreviewMode);
        return UrlMapper.ImagePreviewUrl(imageUrl, width, height);
    }

    private (int? Width, int Height) GetImageMaxSize(LinkPreviewMode linkPreviewMode) {
        const int sizeMultiplier = 2; // reduced images look blurry
        switch (linkPreviewMode) {
            case LinkPreviewMode.Compact:
                var maxHeight = ScreenSize.IsNarrow() ? 80 : 120;
                return (maxHeight * sizeMultiplier, maxHeight * sizeMultiplier);
            case LinkPreviewMode.Default:
            case LinkPreviewMode.Full:
                maxHeight = ScreenSize.IsNarrow() ? 160  : 136;
                return (null, maxHeight * sizeMultiplier);
            default:
                return (0, 0);
        }
    }

    // Nested types

    public sealed record Model {
        public ChatEntry Entry { get; init; } = null!;
        public LinkPreview Preview { get; init; } = null!;
        public Uri Uri { get; init; } = null!;
        public LocalLinkInfo? LocalLink { get; init; }
    }
}
