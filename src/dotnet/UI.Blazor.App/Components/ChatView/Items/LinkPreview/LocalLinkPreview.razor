@namespace ActualChat.UI.Blazor.App.Components
@using ActualChat.Media
@inherits FusionComponentBase<AppUIHub>
@{
    var m = Data;
    if (!m.CanRender)
        return;

    var url = m.LocalUrl;
    Chat? chat = null;
    Account? user = null;
    ChatEntry? entry = null;
    Author? author = null;
    Place? place = null;
    if (Data is ChatLocalLinkInfo chatLocalLinkInfo) {
        chat = chatLocalLinkInfo.Chat;
        entry = chatLocalLinkInfo.Entry;
        author = chatLocalLinkInfo.Author;
        place = chatLocalLinkInfo.Place;
    }
    else if (Data is UserLocalLinkInfo userLocalLinkInfo) {
        user = userLocalLinkInfo.Account;
        chat = userLocalLinkInfo.Chat;
    } else if (Data is PlaceLocalLinkInfo placeLocalLinkInfo) {
        place = placeLocalLinkInfo.Place;

    }
    var cls = entry is not null ? " local-link-chat-entry" : " local-link-chat";
}

<div class="link-preview local-link unfocusable @cls">
    <div class="c-chat-icon">
        @if (entry is not null) {
            <AuthorCircle
                AuthorId="@entry.AuthorId"
                Size="SquareSize.Size9"/>

        } else if (user is not null) {
            <AccountCircle
                UserId="@user.Id"
                Size="@SquareSize.Size8" />
        }
        else if (chat is not null) {
            <ChatIcon Chat="@chat" Size="SquareSize.Size8"/>
        }
        else if (place is not null) {
            <Pic
                Title="@place.Title"
                Picture="@place.Picture.ToPicture()"
                Size="@SquareSize.Size8"
                IsSquare="@true"
                AvatarKind="@AvatarKind.Marble"
                AvatarKey="@place.Id.Value"/>
        }
    </div>
    <div class="c-info">
        @if (entry is not null) {
            <div class="c-top">
                @if (author != null) {
                    <div class="c-author-header">
                        <AuthorName AuthorId="@author.Id" Class="chat-message-author-name"/>
                        <LiveTimeDeltaText Class="chat-message-timestamp min-w-fit" Moment="@entry.BeginsAt"/>
                    </div>
                }
                <a class="c-description" href="@url" @onclick:preventDefault="true" @onclick="NavigateToUrl">@entry.Content</a>
            </div>

            @if (entry.Attachments.Length > 0) {
                var maxCount = Math.Min(entry.Attachments.Length, 3);
                var textEntryAttachments = entry.Attachments.Take(maxCount).ToArray();
                <div class="link-preview-attachment-list">
                    @for (var i = 0; i < maxCount; i++) {
                        var attachment = entry.Attachments[i];
                        if (attachment.IsVisualMedia()) {
                            <VisualMediaAttachment Attachment="@attachment" Attachments="@textEntryAttachments"/>
                        } else {
                            <FileAttachment Attachment="@attachment"/>
                        }
                    }
                    @if (entry.Attachments.Length > 3) {
                        <div class="extra-attachment">+@($"{entry.Attachments.Length - maxCount}")</div>
                    }
                </div>
            }
        }

        <span class="c-domain">
            @if (entry is not null) {
                <span>in </span>
            }
            @if (user is not null) {
                <a class="text-primary" href="@Data.LocalUrl.Value" @onclick:preventDefault="true" @onclick="NavigateToUrl">@user.Avatar.Name</a>
            }
            else if (chat is not null) {
                var linkText = chat.Title;
                if (place?.Id is not null)
                    linkText += $", {place.Title}";

                var useDirectChatLink = entry is not null;
                var chatLink = useDirectChatLink ? Links.Chat(chat.Id) : Data.LocalUrl;
                <a class="text-primary" href="@chatLink" @onclick:preventDefault="true" @onclick="@(() => NavigateTo(chatLink))">@linkText</a>
            }
            else if (place is not null) {
                <a class="text-primary" href="@Data.LocalUrl.Value" @onclick:preventDefault="true" @onclick="NavigateToUrl">@place.Title</a>
            }
        </span>
    </div>
    <div class="incut"></div>
</div>

@code {
    [Parameter, EditorRequired] public LocalLinkInfo Data { get; set; } = null!;

    private void NavigateToUrl()
        => _ = History.NavigateTo(Data.LocalUrl);

    private void NavigateTo(string url)
        => _ = History.NavigateTo(url);
}
