@namespace ActualChat.UI.Blazor.App.Components
@using ActualChat.Media
@inherits ComputedStateComponent<AppUIHub, LocalLinkPreview.Model>
@{
    var m = State.Value;
    var data = Data;
    if (!data.CanRender)
        return;

    var url = data.LocalUrl;
    Chat? chat = null;
    Account? user = null;
    ChatEntry? entry = null;
    Author? author = null;
    Place? place = null;
    if (data is ChatLocalLinkInfo chatLocalLinkInfo) {
        chat = chatLocalLinkInfo.Chat;
        entry = chatLocalLinkInfo.Entry;
        author = chatLocalLinkInfo.Author;
        place = chatLocalLinkInfo.Place;
    } else if (data is UserLocalLinkInfo userLocalLinkInfo) {
        user = userLocalLinkInfo.Account;
        chat = userLocalLinkInfo.Chat;
    } else if (data is PlaceLocalLinkInfo placeLocalLinkInfo) {
        place = placeLocalLinkInfo.Place;
    }
    var cls = entry is not null
        ? " local-link-chat-entry"
        : user is not null
            ? " local-link-chat local-link-user"
            : " local-link-chat";
    var showBg = chat is not null;
    var inChatPrefix = entry is null ? "" : L.LinkPreview_InChat_Prefix;
    var inChatSuffix = entry is null ? "" : L.LinkPreview_InChat_Suffix;
}

<div class="link-preview local-link unfocusable @cls">
    @if (showBg) {
        <div class="c-bg">
            <ChatIcon Chat="@chat" Size="SquareSize.SizeFull" IsSquare="@true" IsBlurred="@true"/>
        </div>
    }
    <div class="c-chat-icon">
        @if (entry is not null) {
            <AuthorCircle
                AuthorId="@entry.AuthorId"
                Size="SquareSize.Size10"/>
        } else if (user is not null) {
            <AccountCircle
                UserId="@user.Id"
                Size="@SquareSize.Size10"/>
        } else if (chat is not null) {
            <ChatIcon Chat="@chat" Size="SquareSize.Size10"/>
        } else if (place is not null) {
            <Pic
                Title="@place.Title"
                Picture="@place.Picture.ToPicture()"
                Size="@SquareSize.Size10"
                IsSquare="@true"
                AvatarKind="@AvatarKind.Marble"
                AvatarKey="@place.Id.Value"/>
        }
    </div>
    <div class="c-info">
        @if (entry is not null) {
            <div class="c-top">
                @if (author != null) {
                    <div class="c-author-header">
                        <AuthorName AuthorId="@author.Id" Class="chat-message-author-name"/>
                        <LiveTimeDeltaText Class="chat-message-timestamp min-w-fit" Moment="@entry.BeginsAt"/>
                    </div>
                }
                <a class="c-description" href="@url" @onclick:preventDefault="true" @onclick="NavigateToUrl">@entry.Content</a>
            </div>

            @if (entry.Attachments.Length > 0) {
                var maxCount = Math.Min(entry.Attachments.Length, 3);
                var chatEntryAttachments = entry.Attachments.Take(maxCount).ToArray();
                <div class="link-preview-attachment-list">
                    @for (var i = 0; i < maxCount; i++) {
                        var attachment = entry.Attachments[i];
                        if (attachment.IsVisualMedia()) {
                            <VisualMediaAttachment Attachment="@attachment" Attachments="@chatEntryAttachments"/>
                        } else {
                            <FileAttachment Attachment="@attachment"/>
                        }
                    }
                    @if (entry.Attachments.Length > 3) {
                        <div class="extra-attachment">+@($"{entry.Attachments.Length - maxCount}")</div>
                    }
                </div>
            }
        }

        <span class="c-domain">
            @if (!inChatPrefix.IsNullOrEmpty()) {
                <span>@inChatPrefix</span>
            }
            @if (user is not null) {
                <a class="domain-link" href="@Data.LocalUrl.Value" @onclick:preventDefault="true" @onclick="NavigateToUrl">@user.Avatar.Name</a>
            } else if (chat is not null) {
                var linkText = chat.Title;
                if (place?.Id is not null)
                    linkText += $", {place.Title}";

                var useDirectChatLink = entry is not null;
                var chatLink = useDirectChatLink ? Links.Chat(chat.Id) : Data.LocalUrl;
                <a class="domain-link" href="@chatLink" @onclick:preventDefault="true" @onclick="@(() => NavigateTo(chatLink))">@linkText</a>
            } else if (place is not null) {
                <a class="domain-link" href="@Data.LocalUrl.Value" @onclick:preventDefault="true" @onclick="NavigateToUrl">@place.Title</a>
            }
            @if (!inChatSuffix.IsNullOrEmpty()) {
                <span>@inChatSuffix</span>
            }
        </span>
        @if (chat is not null && chat.Kind is not ChatKind.Peer && entry is null && m.MemberCount > 0) {
            var typeLabel = chat.Id is PlaceChatId { IsRoot: true }
                ? L.Chat_TypePlace
                : chat.IsPublic ? L.Chat_Public : L.Chat_Private;
            var memberCount = L.Chat_Members(m.MemberCount, m.MemberCount);
            <span class="c-chat-meta">@typeLabel · @memberCount</span>
        }
    </div>
    <div class="incut"></div>
</div>

@code {
    private IAuthors Authors => Hub.Authors;

    [Parameter, EditorRequired] public LocalLinkInfo Data { get; set; } = null!;

    protected override ComputedState<Model>.Options GetStateOptions()
        => ComputedStateComponent.GetStateOptions(GetType(),
            static t => new ComputedState<Model>.Options() {
                InitialValue = Model.Loading,
                UpdateDelayer = FixedDelayer.NextTick,
                Category = GetStateCategory(t),
            });

    protected override async Task<Model> ComputeState(CancellationToken cancellationToken) {
        var data = Data;
        if (data is not ChatLocalLinkInfo { Chat: { } chat, Entry: null })
            return Model.Loading;
        if (chat.Kind is ChatKind.Peer)
            return Model.Loading;

        var authorIds = await Authors.ListAuthorIds(Session, chat.Id, cancellationToken).ConfigureAwait(false);
        return new Model { MemberCount = authorIds.Length };
    }

    private void NavigateToUrl()
        => _ = History.NavigateTo(Data.LocalUrl);

    private void NavigateTo(string url)
        => _ = History.NavigateTo(url);

    // Nested types

    public sealed record Model {
        public static readonly Model Loading = new();
        public int MemberCount { get; init; }
    }
}
