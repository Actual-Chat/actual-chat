@namespace ActualChat.UI.Blazor.App.Components
@inherits ComputedRenderStateComponent<Markup>
@{
    var m = State.Value;
}

<MarkupView Markup="@m"/>

@code {
    private Markup? _initialData = null;

    private ChatUIHub Hub => ChatContext.Hub;
    private ITranslations Translations => Hub.Translations;
    private IMarkupParser MarkupParser => ChatContext.ChatMarkupHub.Parser;
    private Features Features => Hub.Features();
    private TranslationUI TranslationUI => Hub.TranslationUI;

    [Parameter, EditorRequired] public ChatContext ChatContext { get; set; } = null!;
    [CascadingParameter] public ChatEntry Entry { get; set; } = null!;
    [Parameter, EditorRequired, ParameterComparer(typeof(ByRefParameterComparer))]
    public Markup Markup { get; set; } = null!;

    public override async Task SetParametersAsync(ParameterView parameters)
    {
        parameters.SetParameterProperties(this);
        _initialData = await ComputeState(CancellationToken.None).ConfigureAwait(true);
        if (ReferenceEquals(State, null)) {
            var (state, stateOptions) = CreateState();
            SetState(state, stateOptions);
        }
        await base.SetParametersAsync(ParameterView.Empty);
    }

    protected override ComputedState<Markup>.Options GetStateOptions() {
        var initialData = _initialData ?? Markup;
        return ComputedStateComponent.GetStateOptions(GetType(),
            t => new ComputedState<Markup>.Options {
                InitialValue = initialData, // show original text immediately
                Category = GetStateCategory(t),
            });
    }

    protected override async Task<Markup> ComputeState(CancellationToken cancellationToken) {
        var entry = Entry;
        var markup = Markup;
        if (!await Features.IsIncompleteUIEnabled(cancellationToken).ConfigureAwait(false))
            return markup;

        var isOn = await TranslationUI.IsOn(entry.ChatId, cancellationToken).ConfigureAwait(false) ?? false;
        if (!isOn)
            return markup;

        if (!await TranslationUI.NeedsTranslation(entry.Id, cancellationToken).ConfigureAwait(false))
            return markup;

        var translation = await TranslationUI.Get(entry.Id, cancellationToken).ConfigureAwait(false);
        return translation == null ? markup : MarkupParser.Parse(translation.Content);
    }
}
