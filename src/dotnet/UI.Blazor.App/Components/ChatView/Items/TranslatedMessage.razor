@namespace ActualChat.UI.Blazor.App.Components
@inherits ComputedRenderStateComponent<ChatUIHub, TranslatedMessage.Model>
@{
    var m = State.Value;
    _rendered = m;
}

<MarkupView Markup="@m.Markup" />

@code {
    private Model? _rendered;
    private IMarkupParser MarkupParser => ChatContext.ChatMarkupHub.Parser;
    private TranslationUI TranslationUI => Hub.TranslationUI;

    [Parameter, EditorRequired] public ChatContext ChatContext { get; set; } = null!;
    [Parameter, EditorRequired] public ChatEntryMessage Message { get; set; } = null!;
    [Parameter, EditorRequired] public Markup Markup { get; set; } = null!;

    protected override bool ShouldRender()
        => _rendered is null ||
           !ReferenceEquals(_rendered, State.Value)
            && (_rendered.Message.Entry.ContentHash != State.Value.Message.Entry.ContentHash
                || _rendered.Markup != State.Value.Markup);

    protected override ComputedState<Model>.Options GetStateOptions() {
        // Do not use cached options as we need to pass Message and Markup parameters.
        var initialData = new Model(Markup, Message);
        return new() {
            InitialValue = initialData, // To show the original text immediately
            Category = GetStateCategory(GetType()),
        };
    }


    protected override async Task<Model> ComputeState(CancellationToken cancellationToken) {
        var message = Message;
        var markup = Markup;
        var entry = message.Entry;
        if (!await Features.IsIncompleteUIEnabled(cancellationToken).ConfigureAwait(false))
            return new(markup, message);

        var isOn = await TranslationUI.IsOn(entry.ChatId, cancellationToken).ConfigureAwait(false) ?? false;
        if (!isOn)
            return new(markup, message);

        var textEntryId = entry.Id.ToTextEntryId();
        var needsTranslation = await TranslationUI.NeedsTranslation(textEntryId, cancellationToken).ConfigureAwait(false);
        if (!needsTranslation)
            return new(markup, message);

        var translation = await TranslationUI.Get(textEntryId, cancellationToken).ConfigureAwait(false);
        return new (translation == null ? markup : MarkupParser.Parse(translation.Content), message);
    }

    // Nested types

    public sealed record Model(Markup Markup, ChatEntryMessage Message);
}
