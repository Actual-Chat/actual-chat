@namespace ActualChat.UI.Blazor.App.Components
@{
    var conversation = Header.Conversation!;
    var title = conversation.Title;
    var messageCount = conversation.MessageCount;
    var startsAt = DateTimeConverter.ToLocalTime(conversation.StartsAt);
}

<ConversationMessageHeader
    Title="@title"
    MessageCount="@messageCount"
    MessageCountClick="@ToggleShowMessage"
    StartsAt="@startsAt"
    IsSeparated="true"/>

@code {
    private AppUIHub Hub => ChatContext.Hub;
    private DateTimeConverter DateTimeConverter => Hub.DateTimeConverter;
    private ChatUI ChatUI => Hub.ChatUI;

    [Parameter, EditorRequired] public ChatContext ChatContext { get; set; } = null!;
    [Parameter, EditorRequired] public ConversationHeader Header { get; set; } = null!;

    private void ToggleShowMessage()
        => ChatUI.ToggleExpandConversation(Header.Conversation!.Id);
}
