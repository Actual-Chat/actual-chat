@namespace ActualChat.UI.Blazor.App.Components
@using ActualChat.Live
@inherits ComputedStateComponent<AppUIHub, ConversationLiveState>
@{
    var state = State.Value;
    var m = state.Conversation;
    var conversation = Message.Conversation!;
    var messageCount = conversation.MessageCount;
    var startsAt = DateTimeConverter.ToLocalTime(conversation.StartsAt);
    var endsAt = DateTimeConverter.ToLocalTime(conversation.EndsAt);
    var openClass = _isOpen ? "open-details" : "closed-details";
    var detailsCls = _isOpen ? "show" : "";
    var liveClass = state.IsLive ? (state.IsJoined ? "live joined" : "live") : "";
    var cls = $"conversation-message message-wrapper {openClass} {liveClass}";
    var attachments = conversation.Attachments;
    var canExpand = !state.IsLive || state.IsJoined;
    var liveTitle = m.Title.Text.IsNullOrEmpty() ? state.ParticipantsText : m.Title.Text;
}
<div class="@cls"
     data-menu="@(MenuRef.New<ConversationMenu>(conversation.Id.Value, false.ToString()))">
    @if (state.IsLive) {
        var secondLine = state.IsVoiceOnly ? "Voice only" : messageCount + " message".Pluralize(messageCount);
        var startedAt = $"Started at {startsAt:HH:mm}";
        var hasSummary = state.HasFoldedEntries;
        <div class="c-live-card">
            <div class="c-lc-title">
                <chat-activity-panel-icon-svg size="6" isActive="true" mode="audio"/>
                <span class="c-lc-name">@liveTitle</span>
                @if (hasSummary) {
                    <HeaderButton Class="c-lc-expand" Click="@ToggleShowMessage">
                        <i class="@(state.IsExpanded ? "icon-collapse" : "icon-expand")"></i>
                    </HeaderButton>
                }
            </div>
            @if (state.IsJoined) {
                <div class="c-lc-oncall">You on the call</div>
            }
            @if (hasSummary) {
                <CascadingValue Value="@_fakeEntry" IsFixed="true">
                    <div class="c-lc-summary">
                        <MarkupView Markup="@m.Description.Markup"/>
                    </div>
                </CascadingValue>
            }
            <div class="c-lc-meta-row">
                <AuthorCircleGroup
                    Class="c-lc-authors"
                    AuthorIds="@conversation.AuthorIds"
                    Size="@SquareSize.Size5"
                    MaxCount="4"
                    ShowRing="false"/>
                <div class="c-lc-meta">
                    <div class="c-lc-started">@startedAt</div>
                    <div class="c-lc-second">@secondLine</div>
                </div>
                <HeaderButton Class="c-lc-copy" Click="@OnCopyToClipboardRequested">
                    <i class="icon-copy"></i>
                </HeaderButton>
            </div>
            @if (!state.IsJoined) {
                <button type="button" class="c-join-row" @onclick="@OnJoin">Tap to join</button>
            }
        </div>
    } else {
        <CascadingValue Value="@_fakeEntry" IsFixed="true">
        <div class="c-details">
            <div class="c-summary">
                <ConversationMessageHeader
                    Conversation="@conversation"
                    Title="@m.Title"
                    MessageCount="@messageCount"
                    StartsAt="@startsAt"
                    ConversationToggleClick="@OnHeaderClick"/>
                <div class="c-short">
                    <MarkupView Markup="@m.Description.Markup"/>
                    @if (!_isOpen && canExpand) {
                        <span class="show-more-btn" @onclick="@ToggleDetails"> Show items</span>
                    }
                </div>
            </div>
            @if (_isOpen) {
                <div class="c-long">
                    <div class="c-long-content @detailsCls">
                        <MarkupView Markup="@m.Summary.Markup"/>
                        <span class="show-more-btn" @onclick="@ToggleDetails"> Hide items</span>
                    </div>
                </div>
            }
            @if (attachments.Length > 0) {
                var (mediaList, fileList) = GetOrderedAttachmentList(attachments);
                <div class="message-attachments">
                    <VisualMediaAttachmentList
                        MediaList="@mediaList"
                        IsConversation="true"
                        IsNarrow="@ScreenSize.IsNarrow()"/>
                    <div class="message-file-attachments">
                        @foreach (var attachment in fileList) {
                            if (attachment.IsAudio()) {
                                <AudioFileAttachment Attachment="@attachment"/>
                            } else {
                                <FileAttachment Attachment="@attachment"/>
                            }
                        }
                    </div>
                </div>
            }
        </div>
        </CascadingValue>
        <ConversationMessageFooter
            CopyToClipboardRequested="@OnCopyToClipboardRequested"
            Authors="@conversation.AuthorIds"
            MessageCount="@messageCount"
            StartsAt="@startsAt"
            EndsAt="@endsAt"/>
    }
</div>

@code {
    private bool _isOpen;
    private ConversationMessage? _lastMessage;
    private ChatEntry _fakeEntry = null!;

    private ChatUI ChatUI => Hub.ChatUI;
    private IAuthors Authors => Hub.Authors;
    private ChatAudioUI ChatAudioUI => Hub.ChatAudioUI;
    private LiveSessionUI LiveSessionUI => Hub.LiveSessionUI;
    private IChatMarkupHub ChatMarkupHub => ChatContext.ChatMarkupHub;
    private ClipboardUI ClipboardUI => ChatContext.Hub.ClipboardUI;
    private ConversationUI ConversationUI => Hub.ConversationUI;

    [CascadingParameter] public ScreenSize ScreenSize { get; set; }
    [Parameter, EditorRequired] public ChatContext ChatContext { get; set; } = null!;
    [Parameter, EditorRequired] public ConversationMessage Message { get; set; } = null!;

    protected override ComputedState<ConversationLiveState>.Options GetStateOptions() {
        var conversation = Message.Conversation!;
        var title = conversation.Title;
        var descriptionMarkup = ChatMarkupHub.Parser.Parse(conversation.Description);
        var summaryMarkup = ChatMarkupHub.Parser.Parse(conversation.Summary);
        var translated = new TranslatedConversation(
            conversation.Id,
            TranslatedText.From(title),
            TranslatedMarkup.From(descriptionMarkup),
            TranslatedMarkup.From(summaryMarkup));
        return ComputedStateComponent.GetStateOptions(GetType(),
            t => new ComputedState<ConversationLiveState>.Options() {
                InitialValue = new ConversationLiveState(translated, false, false, false),
                Category = GetStateCategory(t),
            });
    }

    protected override void OnParametersSet() {
        if (ReferenceEquals(_lastMessage, Message))
            return;

        var conversation = Message.Conversation!;
        var chatEntryId = ChatEntryId.New(conversation.Id.ChatId, conversation.Id.StartEntryLid);
        _fakeEntry = new TextEntry(chatEntryId);
        _lastMessage = Message;
    }

    protected override async Task<ConversationLiveState> ComputeState(CancellationToken cancellationToken) {
        var conversation = Message.Conversation!;
        var translated = await ConversationUI.GetTranslatedConversation(conversation, cancellationToken).ConfigureAwait(true);

        var chatId = conversation.Id.ChatId;
        var live = await LiveSessionUI.GetConversation(chatId, cancellationToken).ConfigureAwait(true);
        var isLive = live != null && live.Id == conversation.Id;
        var isJoined = isLive && await LiveSessionUI.AmIInLiveConversation(chatId, cancellationToken).ConfigureAwait(true);
        var isVoiceOnly = isLive
            && !await LiveSessionUI.IsTranscriptionOn(chatId, cancellationToken).ConfigureAwait(true);
        var participantsText = isLive
            ? await GetParticipantsText(chatId, conversation.AuthorIds, cancellationToken).ConfigureAwait(true)
            : "";
        // EndEntryLid only advances past the visible start once a summary lands, so this both gates the
        // expand affordance and marks that a summary/folded range exists.
        var rawLive = await LiveSessionUI.GetState(chatId, cancellationToken).ConfigureAwait(true);
        var hasFoldedEntries = isLive && !isVoiceOnly
            && rawLive is { SessionStartedAt: not null }
            && rawLive.EndEntryLid >= rawLive.EffectiveVisibleStartLid;
        var overrides = await ChatUI.ConversationExpansionOverrides.Use(cancellationToken).ConfigureAwait(true);
        var isExpanded = conversation.IsExpandedByDefault ^ overrides.Contains(conversation.Id);
        return new ConversationLiveState(
            translated, isLive, isJoined, isVoiceOnly, participantsText, hasFoldedEntries, isExpanded);
    }

    private async Task<string> GetParticipantsText(
        ChatId chatId,
        IReadOnlyList<AuthorId> authorIds,
        CancellationToken cancellationToken) {
        var names = new List<string>();
        foreach (var authorId in authorIds.Take(3)) {
            var author = await Authors.Get(Hub.Session, chatId, authorId, cancellationToken).ConfigureAwait(true);
            if (author?.Avatar.Name is { } name && !name.IsNullOrEmpty())
                names.Add(Abbreviate(name));
        }
        if (names.Count == 0)
            return "";
        if (names.Count == 1)
            return names[0];

        var total = authorIds.Count;
        if (total > 3)
            return $"{names[0]}, {names[1]} and {total - 2} {"other".Pluralize(total - 2)}";
        if (names.Count == 2)
            return $"{names[0]} and {names[1]}";
        return $"{names[0]}, {names[1]} and {names[2]}";
    }

    private static string Abbreviate(string name) {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length < 2 ? name : $"{parts[0]} {parts[1][0]}.";
    }

    private void OnHeaderClick() {
        if (State.Value is { IsLive: true, IsJoined: false })
            _ = OnJoin();
        else
            ToggleShowMessage();
    }

    private void ToggleShowMessage()
        => ChatUI.ToggleExpandConversation(Message.Conversation!.Id);

    private async Task OnJoin() {
        var chatId = Message.Conversation!.Id.ChatId;
        await ChatAudioUI.SetListeningState(chatId, true).ConfigureAwait(true);
    }

    private void ToggleDetails() {
        _isOpen = !_isOpen;
        StateHasChanged();
    }

    private async Task OnCopyToClipboardRequested() {
        var text = await ConversationUI.GetClipboardText(State.Value.Conversation);
        await ClipboardUI.WriteText(text).ConfigureAwait(false);
    }

    private (ChatEntryAttachment[], ChatEntryAttachment[]) GetOrderedAttachmentList(ChatEntryAttachment[] attachments)
        => (attachments.Where(a => a.IsVisualMedia()).ToArray(),
            attachments.Where(a => !a.IsVisualMedia()).ToArray());
}
