@namespace ActualChat.UI.Blazor.App.Components
@using StringBuilderExt = ActualLab.Text.StringBuilderExt
@inherits ComputedStateComponent<AppUIHub, ConversationMessageView.Model>
@{
    var m = State.Value;
    var conversation = Message.Conversation!;
    var messageCount = conversation.MessageCount;
    var startsAt = DateTimeConverter.ToLocalTime(conversation.StartsAt);
    var endsAt = DateTimeConverter.ToLocalTime(conversation.EndsAt);
    var openClass = _isOpen ? "open-details" : "closed-details";
    var detailsCls = _isOpen ? "show" : "";
    var cls = $"conversation-message message-wrapper {openClass}";
    var attachments = conversation.Attachments;
    var attachmentCount = conversation.AttachmentCount;
    var maxShowCount = attachments?.Length ?? 0;
    if (ScreenSize.IsNarrow() && maxShowCount > 5)
        maxShowCount = 5;
}
<div class="@cls"
     data-menu="@(MenuRef.New<ConversationMenu>(conversation.Id.Value, false.ToString()))">
    <CascadingValue Value="@_fakeEntry" IsFixed="true">
    <div class="c-details">
        <div class="c-summary">
            <ConversationMessageHeader
                Title="@m.Title"
                MessageCount="@messageCount"
                StartsAt="@startsAt"
                MessageCountClick="@ToggleShowMessage"/>
            <div class="c-short">
                @TranslationFragments.TranslatedMarkupWithMark(m.Description)
                @if (!_isOpen) {
                    <span class="show-more-btn" @onclick="@ToggleDetails"> Show more</span>
                }
            </div>
        </div>
        @if (_isOpen) {
            <div class="c-long">
                <div class="c-long-content @detailsCls">
                    @TranslationFragments.TranslatedMarkupWithMark(m.Summary)
                    <span class="show-more-btn" @onclick="@ToggleDetails"> Show less</span>
                </div>
            </div>
        }
        @if (attachments?.Length > 0) {
            var extra = Math.Max(0, attachmentCount - maxShowCount);
            var (mediaList, fileList) = GetOrderedAttachmentList(attachments);
            var totalCount = maxShowCount;
            <div class="conversation-attachments">
                @if (mediaList.Length > 0) {
                    @foreach (var media in mediaList) {
                        if (totalCount == 0)
                            break;

                        <VisualMediaAttachment Attachment="@media" Attachments="@mediaList"/>
                        totalCount--;
                    }
                }
                @if (totalCount > 0 && fileList.Length > 0) {
                    @foreach (var file in fileList) {
                        if (totalCount == 0)
                            break;

                        <FileAttachment Attachment="@file" IconOnly="true"/>
                        totalCount--;
                    }
                }
                @if (extra > 0) {
                    <div class="c-extra">
                        +@extra
                    </div>
                }
            </div>
        }
    </div>
    </CascadingValue>
    <ConversationMessageFooter
        CopyToClipboardRequested="@OnCopyToClipboardRequested"
        Authors="@conversation.AuthorIds"
        StartsAt="@startsAt"
        EndsAt="@endsAt"/>
</div>

@code {
    private bool _isOpen;
    private ConversationMessage? _lastMessage;
    private ChatEntry _fakeEntry = null!;
    private ConversationId? _conversationId;

    private ChatUI ChatUI => Hub.ChatUI;
    private IChatMarkupHub ChatMarkupHub => ChatContext.ChatMarkupHub;
    private ClipboardUI ClipboardUI => ChatContext.Hub.ClipboardUI;
    private TranslationUI TranslationUI => Hub.TranslationUI;

    [CascadingParameter] public ScreenSize ScreenSize { get; set; }
    [Parameter, EditorRequired] public ChatContext ChatContext { get; set; } = null!;
    [Parameter, EditorRequired] public ConversationMessage Message { get; set; } = null!;

    protected override ComputedState<Model>.Options GetStateOptions() {
        var conversation = Message.Conversation!;
        var title = conversation.Title;
        var descriptionMarkup = ChatMarkupHub.Parser.Parse(conversation.Description);
        var summaryMarkup = ChatMarkupHub.Parser.Parse(conversation.Summary);
        return ComputedStateComponent.GetStateOptions(GetType(),
            t => new ComputedState<Model>.Options() {
                InitialValue = new Model(
                    TranslatedText.From(title),
                    TranslatedMarkup.From(descriptionMarkup),
                    TranslatedMarkup.From(summaryMarkup)),
                Category = GetStateCategory(t),
            });
    }

    protected override void OnParametersSet() {
        if (ReferenceEquals(_lastMessage, Message))
            return;

        var conversation = Message.Conversation!;
        _conversationId = conversation.Id;
        var chatEntryId = TextEntryId.New(_conversationId.ChatId, _conversationId.StartEntryLid);
        _fakeEntry = new (chatEntryId);
        _lastMessage = Message;
    }

    protected override async Task<Model> ComputeState(CancellationToken cancellationToken) {
        var conversation = Message.Conversation!;
        var conversationId = conversation.Id;
        var title = conversation.Title;
        var descriptionMarkup = ChatMarkupHub.Parser.Parse(conversation.Description);
        var summaryMarkup = ChatMarkupHub.Parser.Parse(conversation.Summary);
        var mustTranslate = await TranslationUI.MustTranslate(conversation, cancellationToken).ConfigureAwait(false);

        if (!mustTranslate)
            return new Model(
                TranslatedText.From(title),
                TranslatedMarkup.From(descriptionMarkup),
                TranslatedMarkup.From(summaryMarkup));

        var titleTranslationTask = TranslationUI.Get(conversationId, ConversationTranslationIdKind.Title, TranslationConsumers.ChatView, cancellationToken);
        var descriptionTranslationTask = TranslationUI.Get(conversationId, ConversationTranslationIdKind.Description, TranslationConsumers.ChatView, cancellationToken);
        var summaryTranslationTask = TranslationUI.Get(conversationId, ConversationTranslationIdKind.Summary, TranslationConsumers.ChatView, cancellationToken);
        var titleTranslation = await titleTranslationTask.ConfigureAwait(false);
        var descriptionTranslation = await descriptionTranslationTask.ConfigureAwait(false);
        var summaryTranslation = await summaryTranslationTask.ConfigureAwait(false);
        await Task.WhenAll(titleTranslationTask, descriptionTranslationTask, summaryTranslationTask).ConfigureAwait(false);
        var translatedTitle = TranslatedText.From(conversation.Title, titleTranslation);
        var translatedDescription = TranslatedMarkup.From(conversation.Description, descriptionTranslation, ChatMarkupHub, descriptionMarkup);
        var translatedSummary = TranslatedMarkup.From(conversation.Summary, summaryTranslation, ChatMarkupHub, summaryMarkup);
        return new Model(translatedTitle, translatedDescription, translatedSummary);
    }

    private void ToggleShowMessage()
        => ChatUI.ToggleExpandConversation(Message.Conversation!.Id);

    private void ToggleDetails() {
        _isOpen = !_isOpen;
        StateHasChanged();
    }

    private async Task OnCopyToClipboardRequested() {
        var text = await GetText();
        await ClipboardUI.WriteText(text).ConfigureAwait(false);
    }

    private async Task<string> GetText() {
        var m = State.Value;
        CancellationToken cancellationToken = default;
        var sb = StringBuilderExt.Acquire();
        sb.AppendLine(m.Title.Text);
        sb.AppendLine();
        var description = await ChatMarkupHub.ApplyMentionNamer(m.Description.Markup, cancellationToken).ConfigureAwait(false);
        sb.AppendLine(description.ToReadableText());
        sb.AppendLine();
        var summary = await ChatMarkupHub.ApplyMentionNamer(m.Summary.Markup, cancellationToken).ConfigureAwait(false);
        sb.AppendLine(summary.ToReadableText());
        return sb.ToStringAndRelease();
    }

    private (TextEntryAttachment[], TextEntryAttachment[]) GetOrderedAttachmentList(TextEntryAttachment[] attachments)
        => (attachments.Where(a => a.IsVisualMedia()).ToArray(),
            attachments.Where(a => !a.IsVisualMedia()).ToArray());

    // Nested types
    public record Model(
        TranslatedText Title,
        TranslatedMarkup Description,
        TranslatedMarkup Summary);
}
