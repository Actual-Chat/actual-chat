@namespace ActualChat.UI.Blazor.App.Components
@{
    var cls = IsSeparated ? "conversation-header sticky" : "conversation-header-short";
    var startDate = GetStartDateString();
    var tooltip = IsSeparated ? "Collapse summary" : "Expand summary";
}

<div class="@cls"
     data-menu="@(MenuRef.New<ConversationMenu>(Conversation.Id.Value, IsSeparated.ToString()))">
    <div class="bg-wrapper">
        @if (ShowToggle) {
            <HeaderButton
                Class="btn-summary-toggle"
                Tooltip="@tooltip"
                data-vl-hold="@(IsSeparated ? "keep-edge" : "always")"
                Click="@OnConversationToggleClick">
                @if (IsSeparated) {
                    <i class="icon-collapse"></i>
                } else {
                    <i class="icon-expand"></i>
                }
            </HeaderButton>
        }
        <div class="c-title">
            <span class="c-tldr">
                <i class="@Icon"></i>
            </span>
            @Title.Text
            @TranslationFragments.TranslationMark(Title.State)
        </div>
    </div>
</div>

@code{
    private string _loadingCls = "";

    [Inject] private UIHub Hub { get; set; } = null!;
    private TuneUI TuneUI => Hub.TuneUI;

    [Parameter] public Conversation Conversation { get; set; } = null!;
    [Parameter] public TranslatedText Title { get; set; } = TranslatedText.None;
    [Parameter] public int MessageCount { get; set; }
    [Parameter] public bool IsSeparated { get; set; }
    [Parameter] public DateTime StartsAt { get; set; }
    [Parameter] public string Icon { get; set; } = "icon-tldr";
    [Parameter] public bool ShowToggle { get; set; } = true;
    [Parameter] public EventCallback ConversationToggleClick { get; set; }

    private void OnConversationToggleClick() {
        _ = TuneUI.Play(Tune.ClickButton);
        _loadingCls = string.IsNullOrEmpty(_loadingCls) ? "loading-conversation" : "";
        StateHasChanged();
        ConversationToggleClick.InvokeAsync();
    }

    private string GetStartDateString() {
        return $"{StartsAt:dd MMM}";
    }
}
