@namespace ActualChat.UI.Blazor.App.Components
@{
    var cls = IsSeparated ? "conversation-header sticky" : "conversation-header-short";
    var startDate = GetStartDateString();
}

<div class="@cls"
     data-menu="@(Conversation != null ? MenuRef.New<ConversationMenu>(Conversation.Id.Value, true.ToString()) : null)">
    <div class="bg-wrapper">
        <div class="c-ending @_loadingCls" @onclick="OnMessageCountClick">
            <div class="c-content">
                <i class="icon-message-stars"></i>
                <span class="c-message-count">@MessageCount</span>
                <i class="icon-chevron-compact-down rotate-icon"></i>
            </div>
        </div>
        <div class="c-title">
            <span class="c-date">@startDate </span>
            @Title.Text
            @TranslationFragments.TranslationMark(Title.State)
        </div>
    </div>
</div>

@code{
    private string _loadingCls = "";

    [Inject] private UIHub Hub { get; set; } = null!;
    private TuneUI TuneUI => Hub.TuneUI;

    [Parameter] public Conversation? Conversation { get; set; }
    [Parameter] public TranslatedText Title { get; set; } = TranslatedText.None;
    [Parameter] public int MessageCount { get; set; }
    [Parameter] public bool IsSeparated { get; set; }
    [Parameter] public DateTime StartsAt { get; set; }
    [Parameter] public EventCallback MessageCountClick { get; set; }

    private void OnMessageCountClick() {
        _ = TuneUI.Play(Tune.ClickButton);
        _loadingCls = string.IsNullOrEmpty(_loadingCls) ? "loading-conversation" : "";
        StateHasChanged();
        MessageCountClick.InvokeAsync();
    }

    private string GetStartDateString() {
        return $"{StartsAt:dd MMM}";
    }
}
