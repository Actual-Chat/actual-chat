@namespace ActualChat.UI.Blazor.App.Components
@{
    var firstAuthors = Authors.Take(3).ToList();
    var extraAuthorCount = Math.Clamp(Authors.Count - 3, 0, 99);
    var timeTotal = GetConversationTimeInfoString();
    var cls = IsSeparated ? "conversation-footer" : "conversation-footer-short";
}

<div class="@cls">
    <div class="bg-wrapper">
        <div class="c-content">
            <div class="c-author-list">
                @foreach (var authorId in firstAuthors) {
                    <AuthorCircle AuthorId="@authorId" Size="@SquareSize.Size6"/>
                }
                @if (extraAuthorCount > 0) {
                    <div class="author-incut ai-extra">+@extraAuthorCount</div>
                }
            </div>
            <div class="c-info">
                <div class="c-time c-tool">
                    @timeTotal
                </div>
                <div class="c-count c-tool">
                    @(SecondLine ?? MessageCount + " message".Pluralize(MessageCount))
                </div>
            </div>
        </div>
        <HeaderButton Click="CopyToClipboardRequested">
            <i class="icon-copy"></i>
        </HeaderButton>
    </div>
</div>

@code {
    [Inject] protected AppUIHub Hub { get; init; } = null!;
    private DateTimeConverter DateTimeConverter => Hub.DateTimeConverter;
    private MomentClockSet Clocks => Hub.Clocks;

    [Parameter] public IReadOnlyList<AuthorId> Authors { get; set; } = null!;
    [Parameter] public int MessageCount { get; set; }
    [Parameter] public DateTime StartsAt { get; set; }
    [Parameter] public DateTime EndsAt { get; set; }
    [Parameter] public bool IsSeparated { get; set; }
    [Parameter] public string? SecondLine { get; set; }
    [Parameter] public EventCallback CopyToClipboardRequested { get; set; }

    private string GetConversationTimeInfoString() {
        var now = DateTimeConverter.ToLocalTime(Clocks.SystemClock.Now);
        var isToday = false;
        var isYesterday = false;
        var inWeek = false;
        var timeRange = "";
        var timestamp = "";

        var totalDiff = EndsAt - StartsAt;
        var minutesDiff = totalDiff.Seconds > 0 ? 1 : 0;
        if (totalDiff.TotalDays >= 1) {
            timeRange = $"{(int)totalDiff.TotalDays} d {(int)totalDiff.TotalHours} h {totalDiff.Minutes + minutesDiff} min";
        } else if (totalDiff.TotalHours >= 1)
            timeRange = $"{(int)totalDiff.TotalHours} h {totalDiff.Minutes + minutesDiff} min";
        else if (totalDiff.TotalMinutes >= 1)
            timeRange = $"{(int)totalDiff.TotalMinutes + minutesDiff} min";
        else
            timeRange = "1 min";

        var delta = (now - StartsAt).Days;

        switch (delta) {
            case 0:
                isToday = true;
                break;
            case 1:
                isYesterday = true;
                break;
            case < 8:
                inWeek = true;
                break;
        }

        if (isToday)
            timestamp = StartsAt.ToString("HH:mm", null);
        else if (isYesterday)
            timestamp = $"{StartsAt.ToString("HH:mm", null)}, Yesterday";
        else if (inWeek)
            timestamp = StartsAt.ToString("HH:mm, ddd", null);
        else if (now.Year == StartsAt.Year)
            timestamp = StartsAt.ToString("HH:mm, MMM dd", null);
        else
            timestamp = StartsAt.ToString("HH:mm, MMM dd, yyyy", null);
        return $"{timeRange} at {timestamp}";
    }
}
