@namespace ActualChat.UI.Blazor.App.Components
@{
    var timeTotal = GetConversationTimeInfoString();
    var cls = IsSeparated ? "conversation-footer" : "conversation-footer-short";
}

<div class="@cls">
    <div class="bg-wrapper">
        <div class="c-content">
            <AuthorCircleGroup Class="c-author-list"
                AuthorIds="@Authors"
                Size="@SquareSize.Size6"
                MaxCount="3"
                IsListening="true"
                ShowRing="false"/>
            <div class="c-info">
                <div class="c-time c-tool">
                    @timeTotal
                </div>
                <div class="c-count c-tool">
                    @(SecondLine ?? MessageCount + " message".Pluralize(MessageCount))
                </div>
            </div>
        </div>
        @if (ShowCopy) {
            <HeaderButton Click="CopyToClipboardRequested">
                <i class="icon-copy"></i>
            </HeaderButton>
        }
    </div>
</div>

@code {
    [Inject] protected AppUIHub Hub { get; init; } = null!;
    private DateTimeConverter DateTimeConverter => Hub.DateTimeConverter;
    private DateFormatter DateFormatter => Hub.DateFormatter;
    private IStringLocalizer L => Hub.StringLocalizer;
    private MomentClockSet Clocks => Hub.Clocks;

    [Parameter] public IReadOnlyList<AuthorId> Authors { get; set; } = null!;
    [Parameter] public int MessageCount { get; set; }
    [Parameter] public DateTime StartsAt { get; set; }
    [Parameter] public DateTime EndsAt { get; set; }
    [Parameter] public bool IsSeparated { get; set; }
    [Parameter] public string? SecondLine { get; set; }
    [Parameter] public bool ShowCopy { get; set; } = true;
    [Parameter] public EventCallback CopyToClipboardRequested { get; set; }

    private string GetConversationTimeInfoString() {
        var now = DateTimeConverter.ToLocalTime(Clocks.SystemClock.Now);
        var timeRange = DateFormatter.FormatDuration(EndsAt - StartsAt);
        var time = StartsAt.ToString("t", DateFormatter);
        // Elapsed 24h spans rather than calendar days - a message from 23:00 stays
        // "today" until 23:00 the next day, as it did before.
        var timestamp = (now - StartsAt).Days switch {
            0 => time,
            1 => L.Date_Parts_Format(time, L.Common_Yesterday),
            < 8 => L.Date_Parts_Format(time, StartsAt.ToString("ddd", DateFormatter)),
            _ => L.Date_Parts_Format(time, StartsAt.ToString(now.Year == StartsAt.Year ? "m" : "d", DateFormatter)),
        };
        return L.Conversation_DurationAt_Format(timeRange, timestamp);
    }
}
