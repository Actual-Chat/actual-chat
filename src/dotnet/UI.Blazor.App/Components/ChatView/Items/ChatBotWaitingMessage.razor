@namespace ActualChat.UI.Blazor.App.Components
@inherits ComputedStateComponent<AppUIHub, bool>
@{
    var m = State.Value;
    if (m == false)
        return;
}

<div class="bot-waiting-message">
    <div class="chat-message group">
        <div class="c-author-badge">
            <ChatMessageAuthorCircle
                AuthorId="@_botId"
                Click="@_onClickCallback"/>
        </div>
        <div class="c-content">
            <div class="c-author-header">
                <AuthorName AuthorId="@_botId" Class="chat-message-author-name"/>
                <LiveTimeDeltaText Class="chat-message-timestamp min-w-fit" Moment="@Clocks.SystemClock.Now"/>
            </div>

            <div class="message-content">
                <div class="waiting-message-container">
                    <span id="waiting-circle-1" class="c-circle"></span>
                    <span id="waiting-circle-2" class="c-circle"></span>
                    <span id="waiting-circle-3" class="c-circle"></span>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private EventCallback<AuthorId> _onClickCallback;
    private AuthorId _botId = null!;
    private ChatId _chatId = null!;

    // Shortcuts
    private AuthorUI AuthorUI => Hub.AuthorUI;
    private ChatUI ChatUI => Hub.ChatUI;

    [Parameter, EditorRequired] public ChatContext ChatContext { get; set; } = null!;
    [Parameter, EditorRequired] public ChatEntryMessage Message { get; set; } = null!;

    protected override void OnInitialized() {
        _onClickCallback = NoStateHasChanged.EventCallback<AuthorId>(OnAuthorBadgeClick);
    }

    protected override void OnParametersSet() {
        _chatId = ChatContext.Chat.Id;
        _botId = Constants.User.Sherlock.GetSherlockAuthorId(_chatId);
    }

    protected override async Task<bool> ComputeState(CancellationToken cancellationToken) {
        var message = Message;

        var timeDelta = (Clocks.SystemClock.Now - Message.Entry.BeginsAt).Seconds;
        if (timeDelta > 30)
            return false;

        var chatState = await ChatUI.GetState(_chatId, false, cancellationToken).ConfigureAwait(false);
        if (chatState == null)
            return false;

        var lastEntry = chatState.Info.LastTextEntry;
        return lastEntry == message.Entry;
    }

    private void OnAuthorBadgeClick(AuthorId authorId)
        => _ = AuthorUI.Show(authorId);
}
