@namespace ActualChat.UI.Blazor.App.Components
@inherits ComputedStateComponent<AppUIHub, TranslationButton.Model>
@{
    if (State.IsInitial(out var m))
        return;

    var isOnCls = m.IsOn ? "on" : "";
    var cls = $"translation-btn {isOnCls}";
}

<HeaderButton
    Class="@cls"
    Tooltip="@L.ChatView_Translation"
    TooltipPosition="FloatingPosition.Bottom"
    Click="OnClick">
    <i class="icon-translation text-2xl"></i>
    @if (m.IsSubHeaderVisible) {
        <span class="c-hill"></span>
    }
</HeaderButton>

@code {
    private TranslationUI TranslationUI => Hub.TranslationUI;

    private Chat Chat => ChatContext.Chat;

    [CascadingParameter] public ChatContext ChatContext { get; set; } = null!;
    [CascadingParameter] public ScreenSize ScreenSize { get; set; }

    protected override async Task<Model> ComputeState(CancellationToken cancellationToken) {
        var chatId = Chat.Id;
        var isSubHeaderVisible = await TranslationUI.IsSubHeaderVisible(chatId, cancellationToken).ConfigureAwait(false);
        var isOn = await TranslationUI.IsEnabled(chatId, cancellationToken).ConfigureAwait(false) ?? false;
        return new(isSubHeaderVisible, isOn);
    }

    private Task OnClick()
        => TranslationUI.SetIsSubHeaderVisible(Chat.Id, !State.Value.IsSubHeaderVisible);

    // Nested types

    public sealed record Model(bool IsSubHeaderVisible, bool IsOn);
}
