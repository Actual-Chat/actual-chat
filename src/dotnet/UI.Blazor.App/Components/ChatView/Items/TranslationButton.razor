@namespace ActualChat.UI.Blazor.App.Components
@inherits ComputedStateComponent<AppUIHub, TranslationButton.Model?>
@{
    if(!State.IsSet(out var m))
        return;

    if(m.IsGlobeVisible != true)
        return;

    var isOnCls = m.IsOn ? "on" : "";
    var sizeCls = ScreenSize.IsNarrow() ? "btn-sm" : "";
    var cls = $"translation-btn {sizeCls} {isOnCls}";
}

<HeaderButton
    Class="@cls"
    Tooltip="Translation"
    TooltipPosition="FloatingPosition.Bottom"
    Click="OnClick">
        <i class="icon-language text-2xl"></i>
</HeaderButton>

@code {
    private TranslationUI TranslationUI => Hub.TranslationUI;

    [CascadingParameter] public ScreenSize ScreenSize { get; set; }

    [Parameter, EditorRequired] public ChatId ChatId { get; set; } = null!;

    protected override async Task<Model?> ComputeState(CancellationToken cancellationToken) {
        var chatId = ChatId;
        var enableIncompleteUI = await Features.IsIncompleteUIEnabled(CancellationToken.None);
        if (!enableIncompleteUI)
            return null;

        var isGlobeVisible = await TranslationUI.IsGlobeVisible(chatId, cancellationToken).ConfigureAwait(false);
        var isSubHeaderVisible = await TranslationUI.IsSubHeaderVisible(chatId, cancellationToken).ConfigureAwait(false);
        var isOn = await TranslationUI.IsOn(chatId, cancellationToken).ConfigureAwait(false) ?? false;
        return new(isGlobeVisible, isSubHeaderVisible, isOn, chatId);
    }

    private Task OnClick()
        => TranslationUI.SetIsSubHeaderVisible(State.Value!.ChatId, !State.Value.IsSubHeaderVisible);

    // Nested types

    public sealed record Model(bool IsGlobeVisible, bool IsSubHeaderVisible, bool IsOn, ChatId ChatId) {
        public static readonly Model None = new(false, false, false, null!);
    }
}
