@namespace ActualChat.UI.Blazor.App.Components
@inherits ComputedStateComponent<AppUIHub, bool>
@if (!State.Value) {
    return;
}

<div class="translation-btn-wrapper">
    <ButtonRound Class="translation-btn btn-sm" Click="OnClick">
        <i class="icon-language text-2xl"></i>
    </ButtonRound>
</div>

@code {
    private TranslationUI TranslationUI => Hub.TranslationUI;

    [Parameter, EditorRequired] public ChatId ChatId { get; set; } = null!;

    protected override async Task<bool> ComputeState(CancellationToken cancellationToken) {
        var chatId = ChatId;
        var enableIncompleteUI = await Features.IsIncompleteUIEnabled(CancellationToken.None);
        if (!enableIncompleteUI)
            return false;

        var isOn = await TranslationUI.IsOn(chatId, cancellationToken).ConfigureAwait(false);
        return isOn == true;
    }

    private void OnClick()
        => ModalUI.Show(new TranslationSettingsModal.Model(ChatId));
}
