@namespace ActualChat.UI.Blazor.App.Components

@code {
    @* '__builder' is predefined name used by RazorSourceGenerator *@
    public static RenderFragment<TranslationState> TranslationMark = state => __builder =>
    {
        @if (state == TranslationState.None)
            return;
        var isActive = state == TranslationState.Translating;
        <span class="translation-marker entry-marker">
            <translation-svg size="4" isActive="@isActive" />
        </span>
    };
}
