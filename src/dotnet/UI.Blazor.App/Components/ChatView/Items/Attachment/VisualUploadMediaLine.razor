@namespace ActualChat.UI.Blazor.App.Components
@{
    var tileCount = Row.Tiles.Count;
    var cls = tileCount == 1 ? "one-image" : "";
}

<div class="image-line @Class @Row.LineHeightCls() @cls">
    @foreach (var tile in Row.Tiles) {
        <div class="image-item" style="width: @Row.GetTileWidthInPercent(tile)%">
            <UploadAttachmentItem Attachment="@tile.Item"
                RestartClick="@(() => OnRestartClick(tile.Item))"
                RemoveClick="@(() => OnRemoveClick(tile.Item))"/>
        </div>
    }
</div>

@code {
    [CascadingParameter] public ScreenSize ScreenSize { get; set; }

    [Parameter, EditorRequired] public VisualMediaGalleryLine<Attachment> Row { get; set; } = null!;
    [Parameter, EditorRequired] public IAttachmentList Uploads { get; set; } = null!;
    [Parameter] public Attachment[]? MediaList { get; set; }
    [Parameter] public string Class { get; set; } = "";

    private Task OnRemoveClick(Attachment attachment)
        => Uploads.Remove(attachment);

    private Task OnRestartClick(Attachment attachment)
        => Uploads.Restart(attachment);
}
