@namespace ActualChat.UI.Blazor.App.Components

<div class="media-attachment-uploads message-image-attachments">
    @foreach (var row in _rows) {
        <VisualMediaAttachmentLine Row="@row" TotalItems="@MediaList.Length">
            <ItemTemplate>
                <UploadAttachmentItem
                    @key="@context.Id"
                    Attachment="@context"
                    RestartClick="@(() => OnRestartClick(context))"
                    RemoveClick="@(() => OnRemoveClick(context))"/>
            </ItemTemplate>
        </VisualMediaAttachmentLine>
    }
</div>

@code {
    private VisualMediaGalleryLine<Attachment>[] _rows = [];
    [CascadingParameter] public ScreenSize ScreenSize { get; set; }
    [Parameter, EditorRequired] public IAttachmentList Uploads { get; set; } = null!;
    [Parameter, EditorRequired] public Attachment[] MediaList { get; set; } = null!;

    protected override void OnParametersSet() {
        _rows = GetRows(MediaList, ScreenSize.IsNarrow());
    }

    private static VisualMediaGalleryLine<Attachment>[] GetRows(Attachment[] mediaList, bool isNarrow)
        => VisualMediaGalleryArranger.Pick(false, isNarrow).Arrange(mediaList, a => (a.Width, a.Height));

    private Task OnRemoveClick(Attachment attachment)
        => Uploads.Remove(attachment);

    private Task OnRestartClick(Attachment attachment)
        => Uploads.Restart(attachment);
}
