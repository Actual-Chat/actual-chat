@namespace ActualChat.UI.Blazor.App.Components
@inherits AttachmentItemBase

@{
    var m = State.Value;
    var attachment = m.Attachment;
    var preview = m.Preview;
    var previewState = preview.State;
    var previewUrl = preview.PreviewUrl;
    var progress = m.Progress;
    var plugClass = progress.IsReady ? "" : "blurred-plug";
    var isUploading = progress.IsInProgress;
    var percent = (int)Math.Round(Math.Clamp(progress.Progress, 0, 100));
    var w = attachment.Size.Width;
    var h = attachment.Size.Height;
    var hasDims = w > 0 && h > 0;
    var ratioStyle = hasDims
        ? $"aspect-ratio: {((float)w / h).ToString(CultureInfo.InvariantCulture)}"
        : null;
}
<li class="attachment-wrapper @(progress.IsFailed ? "attachment-failed" : "")">
    <div class="c-content">
        <div class="attachment-item">
            <ButtonSquare Click="@RemoveClick" Class="remove-attachment-btn btn-danger btn-sm">
                <i class="icon-trash03 text-2xl font-thin"></i>
            </ButtonSquare>
            @if (previewState is PreviewAccessState.Ok) {
                @if (attachment.IsSupportedImage || m.HasCustomPreview || m.HasImagePreview) {
                    <image-skeleton class="show-image-skeleton @plugClass" src="@previewUrl"
                                    width="@(hasDims ? w : 0)" height="@(hasDims ? h : 0)" style="@ratioStyle" />
                } else if (attachment.IsSupportedVideo) {
                    <video preload="metadata" class="@plugClass">
                        <source src="@previewUrl#t=0.5"/>
                    </video>
                }
                @if (!progress.IsReady) {
                    @if (isUploading) {
                        <RoundProgress Class="attachment-upload-ring" Fraction="@(percent / 100d)" title="@progress.Details">
                            <span class="c-percent">@percent%</span>
                        </RoundProgress>
                    } else if (progress.IsFailed && !m.NoAccess && RestartClick.HasDelegate) {
                        <span class="reload-icon-wrapper">
                            <ButtonRound Click="@RestartClick" Class="btn-sm">
                                <i class="icon-sync text-2xl"></i>
                            </ButtonRound>
                        </span>
                    }
                }
            } else {
                var iconCls = previewState is PreviewAccessState.PendingGetAccessRequest ? "icon-file-blocked" : "icon-file-broken";
                <div class="c-plug">
                    <div class="c-wrapper">
                        <i class="@iconCls text-2xl"></i>
                    </div>
                </div>
            }
            @if (progress.IsInProgress && progress.UploadSize > 0) {
                <div class="attachment-upload-size">@FileSizeFormatter.Format(progress.UploadSize)</div>
            }
        </div>
    </div>
</li>
