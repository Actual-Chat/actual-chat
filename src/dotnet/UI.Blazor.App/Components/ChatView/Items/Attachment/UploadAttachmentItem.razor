@namespace ActualChat.UI.Blazor.App.Components
@{
    var attachment = Attachment;
    var progress = attachment.Progress;
    var uploadProgressClass = "attachment-upload-progress";
    var plugClass = "blurred-plug";
    if (attachment.Failed) {
        progress = Math.Max(progress, 30);
        uploadProgressClass += " attachment-upload-failed";
    } else if (attachment.Uploaded) {
        uploadProgressClass += " attachment-upload-completed";
        plugClass = "";
    }
}
<li class="attachment-wrapper">
    <div class="c-content">
        <div class="attachment-item">
            <ButtonSquare Click="@RemoveClick" Class="remove-attachment-btn btn-danger btn-sm">
                <i class="icon-trash03 text-2xl font-thin"></i>
            </ButtonSquare>
            @if (_state is PreviewAccessState.Ok) {
                @if (attachment.IsImage) {
                    <img src="@_previewUrl" alt="Image attachment" class="@plugClass"/>
                } else if (attachment.IsVideo) {
                    <video preload="metadata" class="@plugClass">
                        <source src="@_previewUrl#t=0.5"/>
                    </video>
                }
                @if (!attachment.Uploaded) {
                    @if (attachment.IsUploading) {
                        <span class="spinner-icon-wrapper">
                            <img src="/dist/images/loading-spinner.svg" class="spinner-icon animate-spin" alt="loading"/>
                        </span>
                    } else if (attachment.Failed && !attachment.NoAccess && RestartClick.HasDelegate) {
                        <span class="reload-icon-wrapper">
                            <ButtonRound Click="@RestartClick" Class="btn-sm">
                                <i class="icon-sync text-2xl"></i>
                            </ButtonRound>
                        </span>
                    }
                }
            } else {
                var iconCls = _state is PreviewAccessState.PendingGetAccessRequest ? "icon-file-blocked" : "icon-file-broken";
                <div class="c-plug">
                    <div class="c-wrapper">
                        <i class="@iconCls text-2xl"></i>
                    </div>
                </div>
            }
        </div>
        <div class="attachment-filename" title="@attachment.FileName">
            @if (attachment.FileName.Length > 0) {
                <span>@attachment.FileName</span>
            } else {
                <span>&nbsp;</span>
            }
        </div>
        <div class="@uploadProgressClass" style="@($"width: {progress}%;")"></div>
    </div>
</li>

@code {
    private PreviewAccessState _state;
    private string _previewUrl = "";

    [Parameter] public Attachment Attachment { get; set; } = null!;
    [Parameter] public EventCallback RemoveClick { get; set; }
    [Parameter] public EventCallback RestartClick { get; set; }

    protected override void OnParametersSet() {
        _previewUrl = "";
        if (Attachment.GetPreviewUrl.IsCompleted) {
            var previewUrl = Attachment.PreviewUrl;
            if (!previewUrl.IsNullOrEmpty()) {
                // Preview properly resolved.
                _state = PreviewAccessState.Ok;
                _previewUrl = previewUrl;
            } else {
                // Did not get file permissions.
                _state = PreviewAccessState.NoFileAccess;
            }
        } else {
            _state = PreviewAccessState.PendingGetAccessRequest;
        }
    }

    // Nested types
    private enum PreviewAccessState {
        Ok, NoFileAccess, PendingGetAccessRequest
    }
}
