@namespace ActualChat.UI.Blazor.App.Components
@inherits ComputedStateComponent<AppUIHub, AttachmentState>

@{
    var attachment = Attachment;
    var state = State.Value;
    var preview = state.Preview;
    var previewState = preview.State;
    var previewUrl = preview.PreviewUrl;
    var uploadState = state.UploadState;
    var progress = uploadState.Progress;
    var stageDetails = uploadState.Details;
    var uploadProgressClass = "attachment-upload-progress";
    var plugClass = "blurred-plug";
    if (uploadState.IsFailed) {
        progress = Math.Max(progress, 30);
        uploadProgressClass += " attachment-upload-failed";
    } else if (uploadState.IsReady) {
        uploadProgressClass += " attachment-upload-completed";
        plugClass = "";
    }
    var isUploading = state.UploadSessionId != "" && !(uploadState.IsReady || uploadState.IsFailed);
}
<li class="attachment-wrapper">
    <div class="c-content">
        <div class="attachment-item">
            <ButtonSquare Click="@RemoveClick" Class="remove-attachment-btn btn-danger btn-sm">
                <i class="icon-trash03 text-2xl font-thin"></i>
            </ButtonSquare>
            @if (previewState is PreviewAccessState.Ok) {
                @if (attachment.IsImage) {
                    <img src="@previewUrl" alt="Image attachment" class="@plugClass"/>
                } else if (attachment.IsVideo) {
                    <video preload="metadata" class="@plugClass">
                        <source src="@previewUrl#t=0.5"/>
                    </video>
                }
                @if (!uploadState.IsReady) {
                    @if (isUploading) {
                        <span class="spinner-icon-wrapper">
                            <img src="/dist/images/loading-spinner.svg" class="spinner-icon animate-spin" alt="loading"/>
                        </span>
                    } else if (uploadState.IsFailed && !state.NoAccess && RestartClick.HasDelegate) {
                        <span class="reload-icon-wrapper">
                            <ButtonRound Click="@RestartClick" Class="btn-sm">
                                <i class="icon-sync text-2xl"></i>
                            </ButtonRound>
                        </span>
                    }
                }
            } else {
                var iconCls = previewState is PreviewAccessState.PendingGetAccessRequest ? "icon-file-blocked" : "icon-file-broken";
                <div class="c-plug">
                    <div class="c-wrapper">
                        <i class="@iconCls text-2xl"></i>
                    </div>
                </div>
            }
        </div>
        <div class="attachment-filename" title="@attachment.FileName">
            @if (attachment.FileName.Length > 0) {
                <span>@attachment.FileName</span>
            } else {
                <span>&nbsp;</span>
            }
        </div>
        <div class="@uploadProgressClass"
             style="@($"width: {progress}%;")"
             title="@stageDetails">
        </div>
    </div>
</li>

@code {
    private AttachmentRegistry AttachmentRegistry => Hub.AttachmentRegistry;

    [Parameter] public Attachment Attachment { get; set; } = null!;
    [Parameter] public EventCallback RemoveClick { get; set; }
    [Parameter] public EventCallback RestartClick { get; set; }

    protected override ComputedState<AttachmentState>.Options GetStateOptions()
        => new() { InitialValue = AttachmentState.None };

    protected override Task<AttachmentState> ComputeState(CancellationToken cancellationToken)
        => AttachmentRegistry.GetAttachmentState(Attachment.Id, cancellationToken);
}
