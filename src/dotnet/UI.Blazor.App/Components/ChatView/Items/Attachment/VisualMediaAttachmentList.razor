@namespace ActualChat.UI.Blazor.App.Components
@{
    _rows = GetRows();
    var listCls = GetListClass();
}

<div class="message-image-attachments @listCls">
    @foreach (var row in _rows) {
        var cls = GetRowClass(row);
        <VisualMediaAttachmentLine
            Row="@row"
            Class="@cls"
            MediaList="@MediaList"/>
    }
</div>

@code {
    private IEnumerable<ImageRow> _rows = null!;

    [Parameter, EditorRequired] public List<TextEntryAttachment> MediaList { get; set; } = null!;

    private IEnumerable<ImageRow> GetRows() {
        var line = new List<ImageTile>();
        foreach (var (attachment, index) in MediaList.Select((value, index) => (value, index))) {
            var tile = new ImageTile(attachment);
            if (index == 1
                && index == MediaList.Count - 1
                && line[0].Proportions is ImageProportions.Wide or ImageProportions.ExtraWide
                && tile.Proportions is ImageProportions.Wide or ImageProportions.ExtraWide) {
                yield return new ImageRow(line);
                line = new();
            }
            if ((index != MediaList.Count - 1 && line.Count >= 3)
                || index == MediaList.Count - 1
                && line.Count == 3
                && tile.Proportions is ImageProportions.Wide or ImageProportions.ExtraWide
                && line.Count(t => t.Proportions is ImageProportions.Wide or ImageProportions.ExtraWide) > 1) {
                yield return new ImageRow(line);
                line = new ();
            }
            line.Add(tile);
        }
        if (line.Count > 0)
            yield return new ImageRow(line);
    }

    private string GetRowClass(ImageRow row) {
        var tiles = row.Tiles;
        if (tiles.Count > 2)
            return "normal-line";
        if (tiles.Count == 2) {
            if (tiles.Count(t => t.Proportions is ImageProportions.Square) == 2)
                return "md-md";

            if (tiles.Count(t => t.Proportions is ImageProportions.Narrow) == 2)
                return "sm-sm";

            if (tiles.Count(t => t.Proportions is ImageProportions.Narrow) == 1
                && tiles.Count(t => t.Proportions is ImageProportions.Square) == 1)
                return "sm-md";
        }
        if (tiles.Count == 1) {
            var tile = tiles[0];
            if (tile.Proportions is ImageProportions.Narrow)
                return "sm-sm";
            if (tile.Proportions is ImageProportions.Square)
                return "md-md";
            if (tile.Proportions is ImageProportions.Wide)
                return "lg-lg";
            if (tile.Proportions is ImageProportions.ExtraWide)
                return "xl-xl";
        }
        return "normal-line";
    }

    private string GetListClass()
        => _rows.Count() == 1 ? "one-row" : "";
}
