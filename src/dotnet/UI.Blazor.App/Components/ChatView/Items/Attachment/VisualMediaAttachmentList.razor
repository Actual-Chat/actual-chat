@namespace ActualChat.UI.Blazor.App.Components

<div class="message-image-attachments">
    @foreach (var row in _rows) {
        <VisualMediaAttachmentLine Row="@row" TotalItems="@_mediaList.Length">
            <ItemTemplate>
                <VisualMediaAttachment Attachment="@context" Attachments="@_viewableList" IsUploading="@IsUploading"/>
            </ItemTemplate>
        </VisualMediaAttachmentLine>
    }
</div>
@if (_mediaList.Length < MediaList.Length) {
    var extra = MediaList.Length - _mediaList.Length;
    var attachment = MediaList[_mediaList.Length];
    var url = UrlMapper.ContentUrl(attachment.Media.BlobId);
    <div class="extra-media-count"
         @onclick="@(() => { if (attachment.Media.IsReady) VisualMediaViewerUI.Show(url, _viewableList); })">
        + @extra media
    </div>
}

@code {
    private VisualMediaGalleryLine<ChatEntryAttachment>[] _rows = [];
    private ChatEntryAttachment[] _mediaList = [];
    private ChatEntryAttachment[] _viewableList = [];

    [Inject] private UIHub Hub { get; init; } = null!;
    private UrlMapper UrlMapper => Hub.UrlMapper;
    private VisualMediaViewerUI VisualMediaViewerUI => Hub.VisualMediaViewerUI;

    [Parameter, EditorRequired] public ChatEntryAttachment[] MediaList { get; set; } = null!;
    [Parameter] public bool IsConversation { get; set; }
    [Parameter] public bool IsNarrow { get; set; }
    [Parameter] public bool IsUploading { get; set; }

    protected override void OnParametersSet() {
        var maxCount = IsConversation ? IsNarrow ? 6 : 8 : 10;
        _mediaList = MediaList.Take(maxCount).ToArray();
        _rows = GetRows(_mediaList, IsConversation, IsNarrow);
        _viewableList = IsUploading ? MediaList.Where(a => a.Media.IsReady).ToArray() : MediaList;
    }

    private static VisualMediaGalleryLine<ChatEntryAttachment>[] GetRows(
        ChatEntryAttachment[] mediaList, bool isConversation, bool isNarrow)
        => VisualMediaGalleryArranger
            .Pick(isConversation, isNarrow)
            .Arrange(mediaList, a => (a.Media.Width, a.Media.Height));
}
