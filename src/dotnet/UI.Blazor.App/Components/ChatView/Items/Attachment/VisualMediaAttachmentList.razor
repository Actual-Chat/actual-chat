@namespace ActualChat.UI.Blazor.App.Components
@{
    _rows = GetRows();
    var listCls = GetListClass();
    var wide = IsConversation && !IsNarrow;
    var attachmentsCls = wide ? "wide" : "";
    var maxCount = 10;
    if (IsConversation)
        maxCount = 8;
    if (IsConversation && IsNarrow)
        maxCount = 6;
    _mediaList = MediaList.Take(maxCount).ToArray();
}

<div class="message-image-attachments @listCls @attachmentsCls">
    @foreach (var row in _rows) {
        var cls = GetRowClass(row);
        <VisualMediaAttachmentLine
            Row="@row"
            Class="@cls"
            MediaList="@MediaList"/>
    }
</div>
@if (_mediaList.Length < MediaList.Length) {
    var extra = MediaList.Length - _mediaList.Length;
    var attachment = MediaList[_mediaList.Length];
    var url = UrlMapper.ContentUrl(attachment.Media.ContentId);
    <div class="extra-media-count"
         @onclick="@(() => VisualMediaViewerUI.Show(url, MediaList))">
        + @extra media
    </div>
}

@code {
    private IEnumerable<ImageRow> _rows = null!;
    private TextEntryAttachment[] _mediaList = [];

    [Inject] private UIHub Hub { get; init; } = null!;
    private UrlMapper UrlMapper => Hub.UrlMapper;
    private VisualMediaViewerUI VisualMediaViewerUI => Hub.VisualMediaViewerUI;

    [Parameter, EditorRequired] public TextEntryAttachment[] MediaList { get; set; } = null!;
    [Parameter] public bool IsConversation { get; set; }
    [Parameter] public bool IsNarrow { get; set; }

    private IEnumerable<ImageRow> GetRows() {
        var line = new List<ImageTile>();
        if (IsConversation && !IsNarrow) {
            for (var index = 0; index < _mediaList.Length; index++) {
                var attachment = _mediaList[index];
                var tile = new ImageTile(attachment);

                var isLast = index == _mediaList.Length - 1;
                var lineIsFull = line.Count >= 4;
                var tileIsWide = tile.Proportions is ImageProportions.Wide or ImageProportions.ExtraWide;
                var lineHasManyWide = line.Count(imageTile => imageTile.Proportions is ImageProportions.Wide or ImageProportions.ExtraWide) > 2;

                if (_mediaList.Length == 3
                    && index == 1
                    && line is [{ Proportions: ImageProportions.Wide or ImageProportions.ExtraWide }]
                    && tileIsWide) {
                    yield return new ImageRow(line);
                    line = [];
                }

                if ((!isLast && lineIsFull)
                    || (isLast && line.Count == 4 && tileIsWide && lineHasManyWide)) {
                    yield return new ImageRow(line);
                    line = [];
                }

                line.Add(tile);
            }

            if (line.Count > 0)
                yield return new ImageRow(line);
        } else {
            for (var index = 0; index < _mediaList.Length; index++) {
                var attachment = _mediaList[index];
                var tile = new ImageTile(attachment);

                var isLast = index == _mediaList.Length - 1;
                var lineIsFull = line.Count >= 3;
                var tileIsWide = tile.Proportions is ImageProportions.Wide or ImageProportions.ExtraWide;
                var lineHasManyWide = line.Count(imageTile => imageTile.Proportions is ImageProportions.Wide or ImageProportions.ExtraWide) > 1;

                if (_mediaList.Length == 2
                    && index == 1
                    && line is [{ Proportions: ImageProportions.Wide or ImageProportions.ExtraWide }]
                    && tileIsWide) {
                    yield return new ImageRow(line);
                    line = [];
                }

                if ((!isLast && lineIsFull)
                    || (isLast && line.Count == 3 && tileIsWide && lineHasManyWide)) {
                    yield return new ImageRow(line);
                    line = [];
                }

                line.Add(tile);
            }

            if (line.Count > 0)
                yield return new ImageRow(line);
        }
    }

    private string GetRowClass(ImageRow row) {
        var tiles = row.Tiles;
        if (tiles.Count > 2)
            return "normal-line";
        if (tiles.Count == 2) {
            if (tiles.Count(t => t.Proportions is ImageProportions.Square) == 2)
                return "md-md";

            if (tiles.Count(t => t.Proportions is ImageProportions.Narrow) == 2)
                return "sm-sm";

            if (tiles.Count(t => t.Proportions is ImageProportions.Narrow) == 1
                && tiles.Count(t => t.Proportions is ImageProportions.Square) == 1)
                return "sm-md";
        }
        if (tiles.Count == 1) {
            var tile = tiles[0];
            if (tile.Proportions is ImageProportions.Narrow)
                return "sm-sm";
            if (tile.Proportions is ImageProportions.Square)
                return "md-md";
            if (tile.Proportions is ImageProportions.Wide)
                return "lg-lg";
            if (tile.Proportions is ImageProportions.ExtraWide)
                return "xl-xl";
        }
        return "normal-line";
    }

    private string GetListClass()
        => _rows.Count() == 1 ? "one-row" : "";
}
