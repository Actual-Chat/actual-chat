@namespace ActualChat.UI.Blazor.App.Components
@using System.Globalization
@inherits ComponentBase<AppUIHub>
@{
    var attachment = Attachment;
    var url = UrlMapper.ContentUrl(Attachment.Media.BlobId);
    string? previewUrl = null;
    if (attachment.IsGif() || attachment.IsSvg()) {
        previewUrl = url; // currently image proxy fails on large gifs
    } else if (attachment.IsSupportedImage()) {
        previewUrl = UrlMapper.ImagePreviewUrl(url, null, (int?)Constants.Attachments.MaxActualThumbnailResolution.Y);
    }
    var attachments = Attachments ?? [Attachment];
    // Stamp aspect-ratio from metadata so the tile reserves correct space from
    // the first paint — independent of when the row's aspect-ratio cascades
    // down through the flex chain or when the image bitmap actually loads.
    var mediaW = attachment.Media.Width;
    var mediaH = attachment.Media.Height;
    var hasDims = mediaW > 0 && mediaH > 0;
    var ratioStyle = hasDims
        ? $"aspect-ratio: {((float)mediaW / mediaH).ToString(CultureInfo.InvariantCulture)}"
        : null;
    var imageMenuRef = Hub.ClipboardUI.CanWriteImage && attachment.IsSupportedImage() && !attachment.IsSvg()
        ? MenuRef.New<MessageMenu>(attachment.EntryId.Value, bool.FalseString, "", "", url).ToString()
        : null;
}

<div class="image-attachment @Class" style="@ratioStyle">
    <a class="c-content"
       href="@url"
       role="button"
       data-menu="@imageMenuRef"
       @onclick="@(() => VisualMediaViewerUI.Show(url, attachments))"
       @onclick:preventDefault="true">
        @if (attachment.IsSupportedVideo()) {
            <VideoAttachmentThumbnail Attachment="@attachment"/>
        } else {
            <image-skeleton
                initial-state="skeleton"
                src="@url"
                thumbnailSrc="@previewUrl"
                width="@(hasDims ? mediaW : 0)"
                height="@(hasDims ? mediaH : 0)"
            />
        }
    </a>
    @* TODO(Andrey): need to add Attachment parameter Hidden *@
    @* @if (_enableIncompleteUI) { *@
    @*     <div class="noise-overlay @_overlayCls" @onclick="@OnOverlayClick"></div> *@
    @* } *@
</div>

@code {
    private string _overlayCls = "block";
    private bool _enableIncompleteUI;

    private VisualMediaViewerUI VisualMediaViewerUI => Hub.VisualMediaViewerUI;

    [CascadingParameter] public ScreenSize ScreenSize { get; set; }
    [Parameter, EditorRequired] public ChatEntryAttachment Attachment { get; set; } = null!;
    [Parameter] public ChatEntryAttachment[]? Attachments { get; set; }
    [Parameter] public string Class { get; set; } = "";

    protected override async Task OnInitializedAsync() {
        _enableIncompleteUI = await Features.IsIncompleteUIEnabled(CancellationToken.None);
    }


    private void OnOverlayClick() {
        if (_overlayCls == "hidden")
            return;
        _overlayCls = "hidden";
        StateHasChanged();
    }
}
