@namespace ActualChat.UI.Blazor.App.Components
@{
    var media = Attachment.Media;
    var placeholderUrl = ImagePlaceholder.ToDataUrl(media.Placeholder);
    var ratioStyle = media is { Width: > 0, Height: > 0 }
        ? $"aspect-ratio: {((float)media.Width / media.Height).ToString()}"
        : null;
}

<div class="image-attachment uploading-media-attachment" style="@ratioStyle">
    @if (placeholderUrl.IsNullOrEmpty()) {
        <div class="c-skeleton"></div>
    } else {
        <img class="c-placeholder" src="@placeholderUrl" alt=""/>
    }
    <Spinner Class="c-spinner"/>
</div>

@code {
    [Parameter, EditorRequired] public ChatEntryAttachment Attachment { get; set; } = null!;
}
