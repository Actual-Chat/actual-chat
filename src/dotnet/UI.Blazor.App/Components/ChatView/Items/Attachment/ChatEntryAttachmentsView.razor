@namespace ActualChat.UI.Blazor.App.Components
@if (_hasCompletedAttachments) {
    if (_hasShownUploads) {
        Hub.SendingMessages.NotifyAttachmentsLoaded(Entry.Id);
        _hasShownUploads = false;
    }
    var (mediaList, fileList) = GetOrderedAttachmentList(Entry);
    <div class="message-attachments">
        <VisualMediaAttachmentList MediaList="@mediaList" />
        <div class="message-file-attachments">
            @foreach (var attachment in fileList) {
                <FileAttachment Attachment="@attachment"/>
            }
        </div>
        @if (IsUnreadByOthers) {
            <ChatMessageSendingStatus
                Status="@ChatMessageSendingStatus.MessageStatus.Unread"
                IsDotOnly="@(!IsUnreadByOthersBlockStart)"/>
        }
    </div>
}
else if (_hasAttachmentUploads) {
    if (IsOwnMessage) {
        if (_mediaUploads is {} mediaUploads) {
            <div class="message-attachments">
                <ChatEntryAttachmentUploadsView Uploads="@mediaUploads.Attachments"/>
                <ChatMessageSendingStatus
                    Status="@ChatMessageSendingStatus.MessageStatus.Sending"
                    IsDotOnly="@true"/>
            </div>
            _hasShownUploads = true;
        }
    } else {
        <div class="upload-plug">
            <div class="upload-plug-icons">
                <div class="c-image c-icon">
                    <i class="icon-image"></i>
                </div>
                <div class="c-video c-icon">
                    <i class="icon-video"></i>
                </div>
                <div class="c-file c-icon">
                    <i class="icon-file"></i>
                </div>
            </div>
            <div class="upload-plug-text">Sending attachments…</div>
        </div>
    }
}

@code {
    private bool _hasCompletedAttachments;
    private bool _hasAttachmentUploads;
    private AttachmentUploads? _mediaUploads;
    private bool _hasShownUploads;

    [Parameter, EditorRequired] public AppUIHub Hub { get; set; } = null!;
    [Parameter, EditorRequired] public ChatEntry Entry { get; set; } = null!;
    [Parameter, EditorRequired] public bool IsOwnMessage { get; set; }
    [Parameter] public bool IsUnreadByOthers { get; set; }
    [Parameter] public bool IsUnreadByOthersBlockStart { get; set; }

    protected override void OnParametersSet() {
        _hasCompletedAttachments = false;
        _hasAttachmentUploads = Entry.HasAttachmentUploads;
        if (Entry.Attachments.Length > 0) {
            if (Entry.Attachments.All(c => c.Media.IsReady))
                _hasCompletedAttachments = true;
            else
                _hasAttachmentUploads = true;
        }
        _mediaUploads = _hasAttachmentUploads && IsOwnMessage ? Hub.SendingMessages.GetMediaUploads(Entry) : null;
    }

    private (TextEntryAttachment[], TextEntryAttachment[]) GetOrderedAttachmentList(ChatEntry entry)
        => (entry.Attachments.Where(a => a.IsVisualMedia()).ToArray(),
            entry.Attachments.Where(a => !a.IsVisualMedia()).ToArray());
}
