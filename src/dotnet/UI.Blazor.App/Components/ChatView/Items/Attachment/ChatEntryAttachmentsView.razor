@namespace ActualChat.UI.Blazor.App.Components
@if (Entry.HasUploadingAttachments) {
    if (IsOwnMessage) {
        <ChatEntryAttachmentUploadsViewContainer
            Hub="@Hub"
            Entry="@Entry"
            ShownUploads="@(() => _hasShownUploads = true)" />
    } else {
        <UploadPlug />
    }
}
else if (Entry.Attachments.Length > 0) {
    if (_hasShownUploads) {
        Hub.SendingMessages.NotifyAttachmentsLoaded(Entry.Id);
        _hasShownUploads = false;
    }
    var (mediaList, fileList) = GetOrderedAttachmentList(Entry);
    <div class="message-attachments">
        <VisualMediaAttachmentList MediaList="@mediaList" />
        <div class="message-file-attachments">
            @foreach (var attachment in fileList) {
                if (attachment.IsAudio()) {
                    <AudioFileAttachment Attachment="@attachment"/>
                } else {
                    <FileAttachment Attachment="@attachment"/>
                }
            }
        </div>
        @if (IsUnreadByOthers) {
            <ChatMessageSendingStatus
                Status="@ChatMessageSendingStatus.MessageStatus.Unread"
                IsDotOnly="@(!IsUnreadByOthersBlockStart)"/>
        }
    </div>
}

@code {
    private bool _hasShownUploads;

    [Parameter, EditorRequired] public AppUIHub Hub { get; set; } = null!;
    [Parameter, EditorRequired] public ChatEntry Entry { get; set; } = null!;
    [Parameter, EditorRequired] public bool IsOwnMessage { get; set; }
    [Parameter] public bool IsUnreadByOthers { get; set; }
    [Parameter] public bool IsUnreadByOthersBlockStart { get; set; }

    private (ChatEntryAttachment[], ChatEntryAttachment[]) GetOrderedAttachmentList(ChatEntry entry)
        => (entry.Attachments.Where(a => a.IsVisualMedia()).ToArray(),
            entry.Attachments.Where(a => !a.IsVisualMedia()).ToArray());
}
