@using ActualChat.Media
@namespace ActualChat.UI.Blazor.App.Components
@{
    var fileSize = Attachment.Media.Length;
    var url = UrlMapper.ContentUrl(Attachment.Media.BlobId);
    MediaMimeTypes.TryGetExtension(Attachment.Media.ContentType, out var extension);
    var fileExtension = extension != null ? extension.Replace(".", "") : "";
    var fileCls = FileTypeHelper.FileColors.GetValueOrDefault(fileExtension, "file-default");
}

<div class="file-attachment with-menu unfocusable">
    <a class="c-file-link"
       href="@url"
       target="_blank"
       role="button">
        <div class="c-file-icon @fileCls">
            @if (fileCls == FileTypeHelper.FileClasses[FileType.Multimedia]) {
                <i class="icon-play-fill text-2xl"></i>
            } else {
                <i class="icon-file text-xl"></i>
            }
        </div>
        <div class="c-file-info">
            <FileAttachmentTitle Title="@Attachment.Media.FileName"/>
            <div class="c-bottom">
                <div class="c-size">
                    <span>@FileSizeFormatter.Format(fileSize)</span>
                </div>
            </div>
        </div>
    </a>
    <ButtonRound
        Class="btn-sm btn-transparent"
        data-menu="@(MenuRef.New<FileAttachmentMenu>(Attachment.EntryId.Value, Attachment.Index.ToString()).ToString())"
        data-menu-trigger="@MenuTrigger.Primary"
        data-menu-placement="@(FloatingPosition.TopEnd.ToPositionString())">
        <i class="icon-more-vertical text-xl"></i>
    </ButtonRound>
</div>

@code {
    [Inject] private UrlMapper UrlMapper { get; init; } = null!;

    [Parameter, EditorRequired]
    public ChatEntryAttachment Attachment { get; set; } = null!;
    [Parameter] public bool IconOnly { get; set; }

    private string GetTooltipTitle() {
        var name = Attachment.Media.FileName;
        return name.Length <= 24 ? name : $"{name[..10]}...{name[^10..]}";
    }
}
