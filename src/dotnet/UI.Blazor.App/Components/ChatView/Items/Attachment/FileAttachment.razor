@namespace ActualChat.UI.Blazor.App.Components
@inherits ComponentBase<UIHub>
@{
    var media = Attachment.Media;
    var isPending = IsUploading && !media.IsReady;
    // ToOrigin: the link opens outside the WebView, which can't resolve the app's content scheme
    var url = isPending ? null : UrlMapper.ToOrigin(UrlMapper.ContentUrl(media.BlobId));
}

<FileAttachmentTile
    FileName="@media.FileName"
    ContentType="@media.ContentType"
    Length="@media.Length"
    Url="@url"
    IsUploading="@isPending"
    Class="with-menu">
    <ButtonRound
        Class="c-menu btn-sm btn-transparent"
        data-menu="@(MenuRef.New<FileAttachmentMenu>(Attachment.EntryId.Value, Attachment.Index.ToString()).ToString())"
        data-menu-trigger="@MenuTrigger.Primary"
        data-menu-placement="@(FloatingPosition.TopEnd.ToPositionString())">
        <i class="icon-more-vertical text-xl"></i>
    </ButtonRound>
</FileAttachmentTile>

@code {
    [Parameter, EditorRequired]
    public ChatEntryAttachment Attachment { get; set; } = null!;
    [Parameter] public bool IsUploading { get; set; }
    [Parameter] public bool IconOnly { get; set; }
}
