@namespace ActualChat.UI.Blazor.App.Components
@typeparam TItem
@{
    var tileCount = Row.Tiles.Count;
    var cls = tileCount == 1 ? "one-image" : "";
}

<div class="image-line @Class @Row.LineHeightCls() @cls">
    @foreach (var tile in Row.Tiles) {
        <div class="image-item" style="width: @Row.GetTileWidthInPercent(tile)%">
            @ItemTemplate(tile.Item)
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public VisualMediaGalleryLine<TItem> Row { get; set; } = null!;
    [Parameter] public string Class { get; set; } = "";
    [Parameter] public RenderFragment<TItem> ItemTemplate { get; set; } = null!;
}
