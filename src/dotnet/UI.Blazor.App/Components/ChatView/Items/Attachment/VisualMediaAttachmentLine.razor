@namespace ActualChat.UI.Blazor.App.Components
@typeparam TItem

<div class="image-line @Class @(Row.Tiles.Count == 1 ? "one-image" : "")" style="@Row.GetRowStyle()">
    @foreach (var tile in Row.Tiles) {
        <div class="image-item" style="@Row.GetTileStyle(tile)">
            @ItemTemplate(tile.Item)
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public VisualMediaGalleryLine<TItem> Row { get; set; } = null!;
    [Parameter] public string Class { get; set; } = "";
    [Parameter] public RenderFragment<TItem> ItemTemplate { get; set; } = null!;
}
