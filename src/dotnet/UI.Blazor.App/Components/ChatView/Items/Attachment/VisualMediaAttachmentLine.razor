@namespace ActualChat.UI.Blazor.App.Components
@{
    var tileCount = Row.Tiles.Count;
    var cls = tileCount == 1 ? "one-image" : "";
}

<div class="image-line @Class @Row.LineHeightCls(Row) @cls">
    @foreach (var tile in Row.Tiles) {
        <div class="image-item" style="width: @Row.GetTileWidthInPercent(Row, tile)%">
            <VisualMediaAttachment Attachment="@tile.Attachment" Attachments="@MediaList?.ToArray()"/>
        </div>
    }
</div>

@code {
    [CascadingParameter] public ScreenSize ScreenSize { get; set; }
    [Parameter, EditorRequired] public ImageRow Row { get; set; } = null!;
    [Parameter] public List<TextEntryAttachment>? MediaList { get; set; }
    [Parameter] public string Class { get; set; } = "";
}
