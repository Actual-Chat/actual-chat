@using ActualChat.Media
@namespace ActualChat.UI.Blazor.App.Components
@inherits ComputedStateComponent<AppUIHub, AttachmentState>

@{
    var attachment = Attachment;
    var state = State.Value;
    var previewState = state.Preview.State;
    var progress = state.Progress;
    var progressValue = progress.Progress;
    var stageDetails = progress.Details;
    var uploadProgressClass = "attachment-upload-progress";
    MediaMimeTypes.TryGetExtension(attachment.FileType, out var extension);
    var fileExtension = extension != null ? extension.Replace(".", "") : "";
    var fileCls = FileTypeHelper.FileColors.GetValueOrDefault(fileExtension, "file-default");
    var iconOnlyCls = IconOnly ? "icon-only" : "";
    var tooltipTitle = IconOnly ? GetTooltipTitle() : "";
    if (progress.IsFailed) {
        progressValue = Math.Max(progressValue, 30);
        uploadProgressClass += " attachment-upload-failed";
    } else if (progress.IsReady) {
        uploadProgressClass += " attachment-upload-completed";
    }
    var uploadStyle = $"width: {progressValue}%;";
    var isUploading = state.UploadSessionId != "" && !(progress.IsReady || progress.IsFailed);
}

<div class="file-attachment upload-file unfocusable @iconOnlyCls"
   data-tooltip="@tooltipTitle"
   data-tooltip-position="@FloatingPosition.Top.ToPositionString()">
    <div class="c-file-icon @fileCls">
        @if (previewState is PreviewAccessState.PendingGetAccessRequest) {
            <i class="icon-file-blocked text-2xl text-02"></i>
        } else if (previewState is PreviewAccessState.NoFileAccess) {
            <i class="icon-file-broken text-2xl text-02"></i>
        } else {
            if (fileCls == FileTypeHelper.FileClasses[FileType.Multimedia]) {
                <i class="icon-play-fill text-2xl"></i>
            } else {
                <i class="icon-file text-xl"></i>
            }
        }
        @if (!progress.IsReady && previewState is PreviewAccessState.Ok) {
            @if (isUploading) {
                <span class="spinner-icon-wrapper">
                    <img src="/dist/images/loading-spinner.svg" class="spinner-icon animate-spin" alt="loading"/>
                </span>
            }
        }
    </div>
    @if (!IconOnly) {
        <div class="c-file-info">
            <FileAttachmentTitle Title="@attachment.FileName"/>
            <div class="c-bottom">
                <div class="c-size">
                    <span>@FileSizeFormatter.Format(Attachment.Length)</span>
                </div>
                <div class="@uploadProgressClass"
                     style="@uploadStyle"
                     title="@stageDetails">
                </div>
            </div>
        </div>
    }
    @if (!progress.IsReady) {
        @if (progress.IsFailed && !state.NoAccess && RestartClick.HasDelegate) {
            <span class="reload-icon-wrapper">
                <ButtonRound Click="@RestartClick" Class="btn-sm">
                    <i class="icon-sync text-2xl"></i>
                </ButtonRound>
            </span>
        }
    }
    <ButtonRound Click="@RemoveClick" Class="remove-attachment-btn btn-danger">
        <i class="icon-trash03 text-2xl font-thin"></i>
    </ButtonRound>
</div>

@code {
    private AttachmentRegistry AttachmentRegistry => Hub.AttachmentRegistry;

    [Parameter, EditorRequired] public Attachment Attachment { get; set; } = null!;
    [Parameter] public bool IconOnly { get; set; }
    [Parameter] public EventCallback RemoveClick { get; set; }
    [Parameter] public EventCallback RestartClick { get; set; }

    protected override ComputedState<AttachmentState>.Options GetStateOptions()
        => new() { InitialValue = AttachmentState.None };

    protected override Task<AttachmentState> ComputeState(CancellationToken cancellationToken)
        => AttachmentRegistry.GetAttachmentState(Attachment.Id, cancellationToken);

    private string GetTooltipTitle() {
        var name = Attachment.FileName;
        return name.Length <= 24 ? name : $"{name[..10]}...{name[^10..]}";
    }
}
