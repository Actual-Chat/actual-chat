@using ActualChat.Media
@namespace ActualChat.UI.Blazor.App.Components
@inherits AttachmentItemBase

@{
    var m = State.Value;
    var attachment = m.Attachment;
    var previewState = m.Preview.State;
    var progress = m.Progress;
    var progressValue = progress.Progress;
    var stageDetails = progress.Details;
    var uploadProgressClass = "attachment-upload-progress";
    if (progress.IsFailed) {
        progressValue = Math.Max(progressValue, 30);
        uploadProgressClass += " attachment-upload-failed";
    } else if (progress.IsReady) {
        uploadProgressClass += " attachment-upload-completed";
    }
    var uploadStyle = $"width: {progressValue}%;";
    var isUploading = progress.IsInProgress;
    var iconCls = previewState switch {
        PreviewAccessState.PendingGetAccessRequest => "icon-file-blocked text-2xl text-02",
        PreviewAccessState.NoFileAccess => "icon-file-broken text-2xl text-02",
        _ => null,
    };
    var sizeText = isUploading && progress.UploadSize > 0
        ? FileSizeFormatter.FormatProgress(progress.UploadProgress, progress.UploadSize)
        : null;
}

<FileAttachmentTile
    FileName="@attachment.FileName"
    ContentType="@attachment.FileType"
    Length="@attachment.Length"
    IsUploading="@(isUploading && previewState is PreviewAccessState.Ok)"
    IconClass="@iconCls"
    SizeText="@sizeText"
    Class="upload-file">
    <Progress>
        <div class="@uploadProgressClass"
             style="@uploadStyle"
             title="@stageDetails">
        </div>
    </Progress>
    <ChildContent>
        @if (!progress.IsReady && progress.CanRestart && !m.NoAccess && RestartClick.HasDelegate) {
            <span class="reload-icon-wrapper">
                <ButtonRound Click="@RestartClick" Class="btn-sm">
                    <i class="icon-sync text-2xl"></i>
                </ButtonRound>
            </span>
        }
        <ButtonRound Click="@RemoveClick" Class="remove-attachment-btn btn-danger">
            <i class="icon-trash03 text-2xl font-thin"></i>
        </ButtonRound>
    </ChildContent>
</FileAttachmentTile>
