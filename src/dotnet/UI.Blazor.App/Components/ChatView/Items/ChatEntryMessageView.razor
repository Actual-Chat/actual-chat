@namespace ActualChat.UI.Blazor.App.Components
@using ActualChat.Media
@using ActualLab.Diagnostics
@inherits ComputedStateComponent<AppUIHub, ChatEntryMessageView.Model?>
@{
    var m = _rendered = State.Value ?? Model.Empty;
    // var chatId = ChatContext.ChatId;
    // DebugLog?.LogDebug("Rendering ChatEntryMessageView for chat {ChatId} with message {MessageId}, Content='{Content}'", chatId, Message.Entry.Id, Message.Entry.Content);

    var message = _renderedMessage = Message;
    var markup = _renderedMarkup = _markup;
    var entry = message.Entry;

    // Flags
    var isSystem = entry.IsSystemEntry;
    var isReply = m.RepliedEntry != null;
    var isForward = entry.Forwarded is not null;
    var isReplyToOwnMessage = m.RepliedEntry?.AuthorId == entry.AuthorId;
    var isBlockStart = message.Flags.HasFlag(ChatMessageFlags.BlockStart);
    var showAuthor = !isSystem && (isBlockStart || isReply);
    var showAuthorBadge = showAuthor && ShowAuthorBadge;
    var showTime = !showAuthor && ShowAuthorBadge;
    var showForwardHeader = !isSystem && isForward && message.Flags.HasFlag(ChatMessageFlags.ForwardStart);
    var showForwardAuthor = !isSystem && isForward && message.Flags.HasFlag(ChatMessageFlags.ForwardAuthorStart);


    // Classes
    var systemClass = isSystem ? "system-entry" : "";
    var forwardedClass = isForward ? "forwarded-message" : "";
    var forwardedBorderClass = isForward && !showAuthor ? "forwarded-border" : "";
    var paddingClass = isBlockStart && !message.Flags.HasFlag(ChatMessageFlags.FirstInConversation) ? "pt-2" : "";
    var unreadBlockClass = m.IsUnreadByOthersBlockStart ? "unread-block" : "";
    var ownMessageClass = m.IsOwnMessage ? "own-message" : "";
    var highlightClass = m.IsHighlighted ? "chat-message-highlighted" : "";
    var repliedClass = m.IsReplyTarget ? "replied-message" : "";
    var selectedClass = m.IsSelected ? "selected-message" : "";
    var selectionStartClass = m.IsSelectionStart ? "selection-start" : "";
    var selectionEndClass = m.IsSelectionEnd ? "selection-end" : "";
    var mentionClass = m.IsOwnAuthorMentioned && !isReplyToOwnMessage ? "mention" : "";
    var showAuthorClass = showAuthorBadge ? "show-author" : "";
    var cls = $"{systemClass} {forwardedClass} {forwardedBorderClass} {ownMessageClass} {mentionClass} {paddingClass} {unreadBlockClass} {highlightClass} {repliedClass} {selectedClass} {selectionStartClass} {selectionEndClass} {showAuthorClass} message-wrapper";
}

@switch (message.Kind) {
    case ChatMessageKind.None:
        break;
    case ChatMessageKind.DateLine:
        <ChatMessageDateLine Date="@message.Date"/>
        return;
    case ChatMessageKind.NewMessagesLine:
        <Separator Title="New messages" TitleClass="new-separator-title"/>
        return;
    case ChatMessageKind.WelcomeBlock:
        @if (m.Chat is { } chat1) {
            <ChatWelcomeBlock Chat="@chat1" />
        }
        return;
    case ChatMessageKind.SendingNewMessage:
        break;
    case ChatMessageKind.AudioRecordingMessage:
        if (HasPriorStreamingEntry(message))
            return;
        break;
    default:
        throw new ArgumentOutOfRangeException();
}

@if (isSystem) {
    <div class="@cls"
         data-chat-entry-id="@(entry.Id.Value)"
         data-menu="@(MenuRef.New<MessageMenu>(entry.Id.Value, bool.TrueString, "", ""))">
        <div class="chat-message">
            <div class="c-content">
                <div class="message-content">
                    <div class="chat-message-markup">
                        <CascadingValue Value="@entry" IsFixed="true">
                            <MarkupView Markup="@markup"/>
                        </CascadingValue>
                    </div>
                </div>
            </div>
            @if (entry.HasReactions || OptimisticReactions.HasPendingAdd(entry.Id)) {
                <MessageReactions Entry="@entry"/>
            }
        </div>
        <MessageHoverMenu @ref="@_messageHoverMenu" Entry="@entry" IsSystem="@true" />
    </div>
    return;
}
@{
    var showMenu = message.Kind is not ChatMessageKind.AudioRecordingMessage;
    var menuRef = showMenu ? MenuRef.New<MessageMenu>(entry.GetClientId(m.IsOwnMessage), bool.FalseString, "", "").ToString() : "";
}
<div class="@cls"
     data-chat-entry-id="@(entry.Id.Value)"
     data-menu="@menuRef">
    <div class="chat-message group">
        <div class="c-author-badge">
            @if (showAuthorBadge) {
                <ChatMessageAuthorCircle
                    AuthorId="@entry.AuthorId"
                    Click="@_onClickCallback"/>
            } else if (showTime) {
                var timestamp = DateTimeConverter.ToLocalTime(entry.BeginsAt).ToShortTimeString();
                <div class="c-empty">
                    <span class="chat-message-timestamp-on-hover">@timestamp</span>
                </div>
            }
        </div>
        <div class="c-content">
            @if (showAuthor) {
                <div class="c-author-header">
                    <AuthorName AuthorId="@entry.AuthorId" Class="chat-message-author-name" Colorize="true"/>
                    <LiveTimeDeltaText Class="chat-message-timestamp min-w-fit" Moment="@entry.BeginsAt"/>
                    @* <div class="text-02 opacity-20 text-xxs">id=@entry.Id</div> *@
                </div>
            }
            @if (showForwardHeader) {
                <div class="forwarded-chat-header">
                    <i class="icon-corner-up-right forwarded-chat-header-icon"></i>
                    <span class="forwarded-chat-header-title">Forwarded from </span>
                    @if (m.ForwardedChat != null) {
                        <span class="forwarded-chat-header-name message-link"
                              @onclick="() => OnForwardedMessageHeaderClick(m.ForwardedChat.Id)">
                            @m.ForwardedChat.Title
                        </span>
                    } else if (m.ForwardedPeerAuthor != null) {
                        <span class="forwarded-chat-header-name message-link"
                              @onclick="() => OnForwardedAuthorClick(m.ForwardedPeerAuthor)">
                            @m.ForwardedPeerAuthor.Avatar.Name
                        </span>
                    } else {
                        <span class="forwarded-chat-header-name">
                            @(!entry.Forwarded!.ChatTitle.IsNullOrEmpty()
                                ? entry.Forwarded.ChatTitle
                                : "Unknown chat")
                        </span>
                    }
                </div>
            }
            @if (showForwardAuthor) {
                <div class="forwarded-author-header">
                    @{
                        var forwardedAuthorName = m.ForwardedAuthor?.Avatar.Name
                            ?? entry.Forwarded!.AuthorName.NullIfEmpty()
                            ?? "Unknown author";
                        var canClick = m.ForwardedAuthor != null || m.ForwardedChatEntryId is not null;
                    }
                    @if (canClick) {
                        <span class="forwarded-author-header-name message-link"
                              @onclick="() => OnForwardedMessageAuthorClick(m.ForwardedChatEntryId, m.ForwardedAuthor)">
                            @forwardedAuthorName
                        </span>
                    } else {
                        <span class="forwarded-author-header-name">
                            @forwardedAuthorName
                        </span>
                    }
                    <LiveTimeDeltaText Class="chat-message-timestamp min-w-fit" Moment="@entry.Forwarded!.BeginsAt"/>
                </div>
            }
            <div class="message-content">
                @if (isReply) {
                    <ChatMessageQuote Entry="@m.RepliedEntry" IsOwn="@isReplyToOwnMessage"/>
                }
                @if (message.Kind is ChatMessageKind.AudioRecordingMessage) {
                    <StreamingEntryBadge ChatId="@ChatId" IsLanguageKnown="@m.IsChatLanguageSelected" IsVoiceActive="@m.IsVoiceActive"/>
                } else {
                    <ChatEntryMessageInternalView
                        Markup="@markup"
                        Message="@message"
                        ChatContext="@ChatContext"
                        IsUnreadByOthers="@m.IsUnreadByOthers"
                        IsUnreadByOthersBlockStart="@m.IsUnreadByOthersBlockStart"
                        IsFirstAuthorMessage="@showAuthorBadge"
                        IsChatLanguageSelected="@m.IsChatLanguageSelected"/>
                }
            </div>
            @if (entry.Attachments.Length > 0 || entry.HasUploadingAttachments) {
                <ChatEntryAttachmentsView
                    Hub="@Hub"
                    Entry="@entry"
                    IsOwnMessage="@m.IsOwnMessage"
                    IsUnreadByOthers="@m.IsUnreadByOthers"
                    IsUnreadByOthersBlockStart="@m.IsUnreadByOthersBlockStart" />
            }
            @if (entry.LinkPreviews.Length > 0) {
                <div class="message-links">
                    @foreach (var linkPreview in entry.LinkPreviews) {
                        var showLinkPreview = !linkPreview.IsEmpty && entry.LinkPreviewMode != LinkPreviewMode.None;
                        @if (showLinkPreview) {
                            <div class="message-link-preview">
                                <LinkPreviewView Entry="@entry" LinkPreview="@linkPreview"/>
                            </div>
                        }
                    }
                </div>
            }
            @if (entry.HasReactions || OptimisticReactions.HasPendingAdd(entry.Id)) {
                <MessageReactions Entry="@entry"/>
            }
            @if (!isForward && m.MentionedAuthorIds is not null && m.MentionedAuthorIds.Count != 0) {
                <div class="notify-mentioned-members-line"> @* Takes full line *@
                    <NotifyMentionedMembers
                        ChatContext="@ChatContext"
                        AuthorIds="m.MentionedAuthorIds"
                        ChatEntry="@Entry"/>
                </div>
            }
        </div>
    </div>
    <MessageHoverMenu @ref="@_messageHoverMenu" Entry="@entry" IsSystem="@false" MessageWithAuthor="@showAuthor"/>
</div>

@code {
    private MessageHoverMenu? _messageHoverMenu;
    private ChatEntryId? _registeredHoverEntryId;
    private bool _forceRender;
    private Model? _rendered;
    private ChatEntryMessage? _renderedMessage;
    private Markup? _renderedMarkup;
    private Task<Markup> _markupTask = Task.FromResult(Markup.EmptyText);
    private Markup _markup = Markup.EmptyText;
    private ChatEntryMessage? _lastMessage;
    private EventCallback<AuthorId> _onClickCallback;
    private bool _hasBeenRead;

    // Shortcuts
    private ChatEntry Entry => Message.Entry;
    private ChatId ChatId => Entry.ChatId;

    private IAuthors Authors => Hub.Authors;
    private IChats Chats => Hub.Chats;
    private IChatMarkupHub ChatMarkupHub => ChatContext.ChatMarkupHub;
    private ChatUI ChatUI => Hub.ChatUI;
    private AuthorUI AuthorUI => Hub.AuthorUI;
    private SelectionUI SelectionUI => Hub.SelectionUI;
    private LanguageUI LanguageUI => Hub.LanguageUI;
    private ChatEditorUI ChatEditorUI => Hub.ChatEditorUI;
    private BrowserInfo BrowserInfo => Hub.BrowserInfo;
    private OptimisticReactions OptimisticReactions => Hub.OptimisticReactions;
    private ILogger Log => field ??= Hub.LogFor(GetType());
    private ILogger? DebugLog => Log.IfEnabled(LogLevel.Debug);

    [CascadingParameter] public ChatView? ChatView { get; set; }
    [Parameter, EditorRequired] public ChatContext ChatContext { get; set; } = null!;
    [Parameter, EditorRequired] public ChatEntryMessage Message { get; set; } = null!;
    [Parameter] public bool ShowAuthorBadge { get; set; } = true;

    protected override void OnInitialized() {
        _onClickCallback = NoStateHasChanged.EventCallback<AuthorId>(OnAuthorBadgeClick);
        OptimisticReactions.Changed += OnOptimisticReactionChanged;
    }

    // The hosting ChatView is a single hover-menu coordinator; this instance keeps its inline
    // MessageHoverMenu registered there by the current entry id, re-registering when the
    // VirtualList recycles this instance onto a different entry.
    protected override void OnAfterRender(bool firstRender) {
        if (BrowserInfo.IsTouchCapable)
            return;

        var entryId = Entry.Id;
        if (_registeredHoverEntryId == entryId)
            return;

        if (_registeredHoverEntryId is { } oldId && _messageHoverMenu != null)
            ChatView?.UnregisterHoverMenu(oldId, _messageHoverMenu);
        _registeredHoverEntryId = null;
        if (_messageHoverMenu != null) {
            ChatView?.RegisterHoverMenu(entryId, _messageHoverMenu);
            _registeredHoverEntryId = entryId;
        }
    }

    public override ValueTask DisposeAsync() {
        OptimisticReactions.Changed -= OnOptimisticReactionChanged;
        if (_registeredHoverEntryId is { } registeredId && _messageHoverMenu != null)
            ChatView?.UnregisterHoverMenu(registeredId, _messageHoverMenu);
        return base.DisposeAsync();
    }

    private void OnOptimisticReactionChanged(ChatEntryId entryId) {
        if (entryId == Entry.Id && !Entry.HasReactions) {
            _forceRender = true;
            this.NotifyStateHasChanged();
        }
    }

    private void OnAuthorBadgeClick(AuthorId authorId)
        => _ = AuthorUI.Show(authorId);

    protected override async Task OnParametersSetAsync()
    {
        if (Message == _lastMessage)
            return;

        _lastMessage = Message;
        _markupTask = ChatMarkupHub.GetMarkup(Entry, MarkupConsumer.MessageView, CancellationToken.None).AsTask();
        _markup = await _markupTask;
        await base.OnParametersSetAsync(); // Triggers recompute
    }

    protected override bool ShouldRender() {
        if (_forceRender) {
            _forceRender = false;
            return true;
        }
        var shouldRender = !ReferenceEquals(_rendered, State.Value)
           || !ReferenceEquals(_renderedMessage, Message)
           || !ReferenceEquals(_renderedMarkup, _markup);
        return shouldRender;
    }

    protected override ComputedState<Model?>.Options GetStateOptions() {
        Model? initialValue = null;
        ChatEntry? repliedEntry = null;
        var repliedEntryId = GetRepliedEntryId(Message.Entry);
        if (repliedEntryId is not null)
            repliedEntry = ChatEntry.Loading(repliedEntryId);
        var isOwnMessage = Message.Flags.HasFlag(ChatMessageFlags.IsOwnMessage);
        var selectedComputed = Computed.GetExisting(() => LanguageUI.IsChatLanguageSelected(Message.Entry.ChatId));
        var isSelected = selectedComputed ?.IsConsistent() == true &&  selectedComputed is { HasValue: true, Value: true };
        initialValue = new Model(null) {
            IsChatLanguageSelected = isSelected,
        };
        if (isOwnMessage || repliedEntry != null) {
            initialValue = initialValue with {
                IsOwnMessage = isOwnMessage,
                RepliedEntry = repliedEntry,
            };
        }
        return new() {
            InitialValue = initialValue,
            Category = GetStateCategory(GetType()),
        };
    }

    protected override async Task<Model?> ComputeState(CancellationToken cancellationToken) {
        var entry = Entry;
        var previousMessage = Message.PreviousMessage as ChatEntryMessage;
        var nextMessage = Message.NextMessage as ChatEntryMessage;
        var prevEntry = previousMessage?.Entry;
        var chatId = ChatId;
        var chatMessage = Message;
        var chat = await Chats.Get(Session, chatId, cancellationToken).ConfigureAwait(false);
        var ownAuthor = chat?.Rules.Author;
        var ownAuthorId = chat?.Rules.Author?.Id;
        var isOwnMessage = ownAuthorId is not null && entry.AuthorId == ownAuthorId;

        var markup = await _markupTask.ConfigureAwait(false);
        var repliedEntry = await GetRepliedEntry(cancellationToken).ConfigureAwait(false);
        var hasAnyMentions = HasAnyMentions(markup);
        var isOwnAuthorMentioned = ownAuthorId is not null && IsMentioned(markup, repliedEntry, ownAuthorId, hasAnyMentions);
        var isForward = entry.Forwarded is not null;
        IReadOnlyList<AuthorId>? mentionedAuthorIds = null;
        if (isOwnMessage && hasAnyMentions && !isForward) {
            var mentionIds = MentionExtractor.Instance.GetMentionIds(markup);
            var ids = new List<AuthorId>();
            var seen = new HashSet<AuthorId>();
            foreach (var mentionId in mentionIds) {
                // A member can be mentioned directly (@a:author) or via their account (@u:user).
                AuthorId? authorId = mentionId.Target switch {
                    AuthorId a => a,
                    UserId u => (await Authors.GetByUserId(Session, entry.ChatId, u, cancellationToken).ConfigureAwait(false))?.Id,
                    _ => null,
                };
                if (authorId is { } id && id != ownAuthorId && seen.Add(id))
                    ids.Add(id);
            }
            mentionedAuthorIds = ids;
        }
        var relatedChatEntry = await ChatEditorUI.RelatedEntryRef.Use(cancellationToken).ConfigureAwait(false);
        var isReplyTarget = relatedChatEntry is { Kind: RelatedEntryKind.Reply, EntryId: var repliedEntryId } && repliedEntryId == entry.Id;
        var isHighlighted = entry.Id == await ChatUI.HighlightedEntryId.Use(cancellationToken).ConfigureAwait(false);
        Chat? forwardedChat = null;
        ChatEntryId? forwardedChatEntryId = null;
        if (isForward && entry.Forwarded!.ChatEntryId is not null) {
            var fwdEntryId = entry.Forwarded.ChatEntryId;
            forwardedChat = await Chats.Get(Session, fwdEntryId.ChatId, cancellationToken).ConfigureAwait(false);
            if (forwardedChat != null)
                forwardedChatEntryId = fwdEntryId;
            else {
                // Maybe chat was copied to place and removed afterward. Try to find out copied chat.
                var replacementChatId = await Chats.GetForwardChatReplacement(Session, fwdEntryId.ChatId, cancellationToken).ConfigureAwait(false);
                if (replacementChatId is not null) {
                    forwardedChat = await Chats.Get(Session, replacementChatId, cancellationToken).ConfigureAwait(false);
                    forwardedChatEntryId = ChatEntryId.New(replacementChatId, fwdEntryId.LocalId);
                }
            }
        }

        var forwardedAuthor = await GetForwardedAuthor(entry, ownAuthor, cancellationToken).ConfigureAwait(false);
        var forwardedPeerAuthor = await GetForwardedPeerAuthor(entry, ownAuthor, cancellationToken).ConfigureAwait(false);
        var selectedChatEntries = await SelectionUI.Selection.Use(cancellationToken).ConfigureAwait(false);
        var isPreviousSelected = previousMessage != null
            && selectedChatEntries.Contains(previousMessage.Entry.Id)
            && previousMessage.Kind == ChatMessageKind.None;
        var isNextSelected = nextMessage != null
            && selectedChatEntries.Contains(nextMessage.Entry.Id)
            && nextMessage.Kind == ChatMessageKind.None;
        var isSelected = selectedChatEntries.Contains(entry.Id);

        var isSelectionStart = isSelected && !isPreviousSelected;
        var isSelectionEnd = isSelected && !isNextSelected;

        var (isUnreadByOthers, isUnreadBlockStart) = (false, false);
        if (chat is not null && ownAuthorId is not null)
            (isUnreadByOthers, isUnreadBlockStart) = await IsUnreadByOthers(chat, entry, prevEntry, ownAuthorId, cancellationToken);
        var isChatLanguageSelected = await LanguageUI.IsChatLanguageSelected(chatId, cancellationToken).ConfigureAwait(false);
        var isVoiceActive = false;
        if (chatMessage.Kind is ChatMessageKind.AudioRecordingMessage) {
            var recorderState = await Hub.AudioRecorder.State.Use(cancellationToken).ConfigureAwait(false);
            isVoiceActive = recorderState.ChatId == chatId && recorderState.IsVoiceActive;
        }
        var result = new Model(chat) {
            RepliedEntry = repliedEntry,
            IsOwnMessage = isOwnMessage,
            IsHighlighted = isHighlighted,
            IsReplyTarget = isReplyTarget,
            IsSelected = isSelected,
            IsSelectionStart = isSelectionStart,
            IsSelectionEnd = isSelectionEnd,
            IsOwnAuthorMentioned = isOwnAuthorMentioned,
            ForwardedChat = forwardedChat,
            ForwardedChatEntryId = forwardedChatEntryId,
            ForwardedAuthor = forwardedAuthor,
            ForwardedPeerAuthor = forwardedPeerAuthor,
            IsUnreadByOthers = isUnreadByOthers,
            IsUnreadByOthersBlockStart = isUnreadBlockStart,
            MentionedAuthorIds = mentionedAuthorIds,
            IsChatLanguageSelected = isChatLanguageSelected,
            IsVoiceActive = isVoiceActive,
        };
        return result.Equals(_rendered) ? _rendered! : result;

        async Task<ChatEntry?> GetRepliedEntry(CancellationToken cancellationToken1) {
            var repliedEntryId1 = GetRepliedEntryId(chatMessage.Entry);
            if (repliedEntryId1 is null)
                return null;

            var repliedEntry1 = await Chats.GetEntry(Session, repliedEntryId1, cancellationToken1).ConfigureAwait(false) ?? ChatEntry.Removed(repliedEntryId1);
            return repliedEntry1;
        }
    }

    private ChatEntryId? GetRepliedEntryId(ChatEntry entry)
        => entry.RepliedEntryLid is not { } repliedEntryLocalId ? null : ChatEntryId.New(entry.ChatId, repliedEntryLocalId);

    private async ValueTask<(bool IsUnread, bool IsUnreadBlockStart)> IsUnreadByOthers(
        Chat chat,
        ChatEntry entry,
        ChatEntry? prevEntry,
        AuthorId ownAuthorId,
        CancellationToken cancellationToken)
    {
        if (_hasBeenRead)
            return (false, false);

        var isOwnMessage = ownAuthorId == entry.AuthorId;
        if (!isOwnMessage)
            return (false, false);

        if (!await ChatSupportsUnreadStatus(chat, cancellationToken).ConfigureAwait(false))
            return (false, false);

        var readPositionsStat = await Chats.GetReadPositionsStat(Session, entry.ChatId, cancellationToken).ConfigureAwait(false);
        var canCalculateHasRead = readPositionsStat.CanCalculateHasReadByAnotherAuthor(entry);
        // Do not show the ` Unread ` label for old messages (before the feature was introduced)
        // until we have at least more or less good enough read positions stat.
        if (!canCalculateHasRead)
            return  (false, false);

        var hasBeenRead = readPositionsStat.HasReadByAnotherAuthor(entry, ownAuthorId);
        var previousHasBeenRead = prevEntry == null || readPositionsStat.HasReadByAnotherAuthor(prevEntry, ownAuthorId);
        if (hasBeenRead)
            _hasBeenRead = true; // Remember that message has been read, so we don't need to recalculate it on next ComputeState cycle.
        return (!hasBeenRead, previousHasBeenRead);
    }

    private async ValueTask<bool> ChatSupportsUnreadStatus(Chat chat, CancellationToken cancellationToken) {
        // NOTE(DF): move this check to ChatContext to share among all message views.
        // ChatContext and Chat can be considered as immutable and used from any thread.
        if (chat.HasSingleAuthor)
            return false;

        var authors = await Authors.ListAuthorIds(Session, chat.Id, cancellationToken).ConfigureAwait(false);
        if (authors.Length < 2)
            return false; // It seems the current user is the only member in the chat hence it has no sense to check unread status.

        return true;
    }

    private void OnForwardedMessageHeaderClick(ChatId chatId)
        => _ = History.NavigateTo(Links.Chat(chatId));

    private void OnForwardedMessageAuthorClick(ChatEntryId? entryId, Author? forwardedAuthor) {
        if (entryId is not null)
            _ = History.NavigateTo(Links.Chat(entryId));
        else if (forwardedAuthor != null)
            _ = AuthorUI.Show(forwardedAuthor.Id);
    }

    private void OnForwardedAuthorClick(Author forwardedAuthor)
        => _ = AuthorUI.Show(forwardedAuthor.Id);

    private static bool HasPriorStreamingEntry(ChatEntryMessage message) {
        var authorId = message.Entry.AuthorId;
        var current = message.PreviousMessage;
        for (var i = 0; i < 50 && current != null; i++, current = current.PreviousMessage) {
            if (current is ChatEntryMessage em
                && em.Entry.AuthorId == authorId
                && em.Entry.IsContentStreaming)
                return true;
        }
        return false;
    }

    private bool HasAnyMentions(Markup markup)
        => MarkupValidator.ContainsAnyMention.IsValid(markup);

    private bool IsMentioned(Markup markup,
        ChatEntry? repliedEntry,
        AuthorId authorId,
        bool hasAnyMentions)
    {
        if (repliedEntry?.AuthorId == authorId)
            return true;

        return hasAnyMentions && MarkupValidator.ContainsMention(MentionRef.NewAuthor(authorId)).IsValid(markup);
    }

    private async Task<Author?> GetForwardedAuthor(ChatEntry entry, AuthorFull? ownAuthor, CancellationToken cancellationToken) {
        if (entry.Forwarded is not { } forwarded)
            return null;

        if (forwarded.ChatEntryId is not null)
            return await Authors.Get(Session, forwarded.ChatEntryId.ChatId, forwarded.AuthorId, cancellationToken);

        if (forwarded.AuthorId.ChatId is not PeerChatId peerChatId)
            return null;

        if (ownAuthor == null)
            return null;

        // extract user id of forwarded author!
        var forwardedUserId = forwarded.AuthorId.LocalId == 1
            ? peerChatId.UserId1
            : peerChatId.UserId2;

        if (forwardedUserId == ownAuthor.UserId)
            return ownAuthor; // we have forwarded the message - so let's use own author in the current chat

        // TODO(DF): review code duplication
        // try to find your peer chat and author for the user who forwarded the message
        var yourPeerChatId = PeerChatId.New(forwardedUserId, ownAuthor.UserId);
        var yourPeerAuthorId = AuthorId.New(yourPeerChatId, yourPeerChatId.UserId1 == forwardedUserId ? 1 : 2);
        var author = await Authors.Get(Session, yourPeerChatId, yourPeerAuthorId, cancellationToken);
        return author?.Version == 0
            ? null // do not return virtual author
            : author;
    }

    private async Task<Author?> GetForwardedPeerAuthor(ChatEntry entry, AuthorFull? ownAuthor, CancellationToken cancellationToken) {
        if (entry.Forwarded?.AuthorId.ChatId is not PeerChatId peerChatId)
            return null;

        if (ownAuthor == null)
            return null;

        // extract user id of forwarded author peer!!!
        var forwardedPeerUserId = entry.Forwarded.AuthorId.LocalId == 1
            ? peerChatId.UserId2
            : peerChatId.UserId1;

        if (forwardedPeerUserId == ownAuthor.UserId)
            return ownAuthor; // message has been forwarded form peer chat with us - so let's use own author in the current chat

        // TODO(DF): review code duplication
        // try to find your peer chat and author for the user who was the peer of the author who forwarded the message
        var yourPeerChatId = PeerChatId.New(forwardedPeerUserId, ownAuthor.UserId);
        var yourPeerAuthorId = AuthorId.New(yourPeerChatId, yourPeerChatId.UserId1 == forwardedPeerUserId ? 1 : 2);
        var author = await Authors.Get(Session, yourPeerChatId, yourPeerAuthorId, cancellationToken);
        return author?.Version == 0
            ? null // do not return virtual author
            : author;
    }

    // Nested types

    public sealed record Model(Chat? Chat) {
        public static readonly Model Empty = new((Chat?)null) {
            MentionedAuthorIds = [],
        };

        public bool IsOwnMessage { get; init; }
        public bool IsHighlighted { get; init; }
        public bool IsReplyTarget { get; init; }
        public bool IsOwnAuthorMentioned { get; init; }
        public bool IsSelected { get; init; }
        public bool IsSelectionStart { get; init; }
        public bool IsSelectionEnd { get; init; }
        public ChatEntry? RepliedEntry { get; init; }
        public Chat? ForwardedChat { get; init; }
        public ChatEntryId? ForwardedChatEntryId { get; init; }
        public Author? ForwardedAuthor { get; init; }
        public Author? ForwardedPeerAuthor { get; init; }
        public bool IsUnreadByOthers { get; init; }
        public bool IsUnreadByOthersBlockStart { get; init; }
        public IReadOnlyList<AuthorId>? MentionedAuthorIds { get; init; }
        public bool IsChatLanguageSelected { get; init; }
        public bool IsVoiceActive { get; init; }
    }
}
