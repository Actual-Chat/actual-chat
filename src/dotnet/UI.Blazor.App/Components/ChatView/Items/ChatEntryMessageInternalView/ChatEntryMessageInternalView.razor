@namespace ActualChat.UI.Blazor.App.Components
@using ActualChat.UI.Blazor.App.Module
@inherits ComputedRenderStateComponent<AppUIHub, ChatEntryMessageInternalView.Model>
@{
    var m = State.Value;
    var sm = m.Streaming;
    var message = Message;
    var entry = m.Entry;
    // The server fills a location entry's content with a maps-link fallback for clients that don't
    // understand location entries; here we render the map instead, so that content stays hidden
    // (status still shows). TODO: 2026-07, remove when all clients support location entries.
    var markup = entry.HasLocation ? Markup.EmptyText : m.Markup;
    var trimmedContent = entry.HasLocation ? "" : entry.Content.Trim();
    var isSoleEmojiMention = markup.IsSoleEmojiMention();
    // Plain-text zoom only for an actual unicode emoji glyph — not a slug id like "ginger-clown".
    var isEmojiOnly = Emojis.BySymbol.GetValueOrDefault(trimmedContent) != null || isSoleEmojiMention;
    var isGifOnly = UrlMapper.IsTrustedGifUrl(trimmedContent);
    var oldTranslation = _rendered?.Translation ?? m.Translation;
    var oldStreaming = _rendered?.Streaming;
    var oldIsStreaming = _rendered?.IsStreaming ?? m.IsStreaming;
    if (oldIsStreaming && !m.IsStreaming && oldStreaming is not null) {
        // Capture the full text shown while streaming (retained + still-animating parts), not just
        // RetainedText: otherwise the fade-out overlay is shorter than the final markup and the
        // streaming→non-streaming transition visibly jumps.
        _temporaryText = oldStreaming.RetainedText + oldStreaming.ChangedText + oldStreaming.AnimatedText;
    }

    _rendered = m;
    var streamingCls = "";
    if (!oldIsStreaming && !m.IsStreaming) {
        streamingCls = "not-streaming";
    } else if (oldIsStreaming && !m.IsStreaming) {
        streamingCls = "from-streaming";
    } else if (m.IsStreaming) {
        streamingCls = "streaming";
    }
    var translationCls = "";
    if (oldTranslation is TranslationState.None or TranslationState.Translating && m.Translation == TranslationState.Translated) {
        translationCls = "to-translated";
    } else if (oldTranslation is TranslationState.Translated or TranslationState.Translating && m.Translation == TranslationState.None) {
        translationCls = "from-translated";
    } else if (m.Translation == TranslationState.Translating) {
        translationCls = "translating";
    }

    // Log.LogInformation("Rendering ChatEntryMessageInternalView for #{EntryId} (IsStreaming: {IsStreaming}, Translation: {TranslationState})",
    //     message.Entry.Id, m.IsStreaming, m.Translation);

    var status = ChatMessageSendingStatus.MessageStatus.Default;
    if (entry.IsSending) {
        if (!entry.HasUploadingAttachments)
            status = ChatMessageSendingStatus.MessageStatus.Sending;
    }
    else if (entry.HasUploadingAttachments) {
        // Use default
    }
    else if (IsUnreadByOthers) {
        if (entry.Attachments.Length == 0)
            status = ChatMessageSendingStatus.MessageStatus.Unread;
    }
    var showTextStatus = status == ChatMessageSendingStatus.MessageStatus.Unread && IsUnreadByOthersBlockStart;
    // Message kinds that shouldn't carry an inline status in the chat view (the chat-list preview
    // still shows its own status — it's a separate ChatListItem render).
    var hideInlineStatus = entry.HasLocation || isGifOnly || isEmojiOnly;

    // Should be named __builder
    // ReSharper disable once VariableHidesOuterVariable UnusedParameter.Local
    RenderFragment statusFragment = (__builder) => {
        @* <span>@entry.Id.LocalId : @entry.Version</span> *@
        @TranslationFragments.TranslationMark(m.Translation)
        @if (status != ChatMessageSendingStatus.MessageStatus.Default && !hideInlineStatus) {
            <ChatMessageSendingStatus Status="@status" IsDotOnly="@(!showTextStatus)" />
        }
    };

    // No visible content (no text, status icon or translation mark) → mark the markup empty so it renders
    // hidden from the first frame. The JS used to add this one frame late, which made attachment-only
    // messages render ~1 text line taller, then collapse — re-anchoring the list (a jump).
    var isEmptyMarkup = !m.IsStreaming
        && trimmedContent.IsNullOrEmpty()
        && !entry.HasLocation
        && m.Translation == TranslationState.None
        && status == ChatMessageSendingStatus.MessageStatus.Default;
}
<div @ref="Ref" class="chat-message-markup @translationCls @streamingCls @(isEmptyMarkup ? "empty" : "")">
    @if (m.IsStreaming) {
        @if (IsOwnMessage
             && sm.RetainedText.IsNullOrEmpty()
             && sm.ChangedText.IsNullOrEmpty()
             && sm.AnimatedText.IsNullOrEmpty()
             && !HasNewerStreamingEntry()) {
            <StreamingEntryBadge
                ChatId="@ChatContext.Chat.Id"
                IsVoiceActive="@true"
                IsLanguageKnown="@m.IsChatLanguageSelected"
                VoiceStartedAt="@entry.BeginsAt"/>
        }
        @if (!sm.RetainedText.IsNullOrEmpty()) {
            <span class="retained">@sm.RetainedText</span>
        }
        <span class="changes">
            <span class="changed-item">@sm.ChangedText</span>
            @{
                for (var spanIndex = 0; spanIndex < AnimationSpanCount; spanIndex++) {
                    var spanStart = sm.AnimatedText.Length * spanIndex / AnimationSpanCount;
                    var spanEnd = sm.AnimatedText.Length * (spanIndex + 1) / AnimationSpanCount;
                    if (spanStart >= spanEnd)
                        continue;

                    var spanDelay = (int)Math.Round(AnimationSpanDurationMs * spanIndex);
                    var style = $"transition-delay: {spanDelay}ms;";
                    <span class="change-item" style="@style">@sm.AnimatedText[spanStart..spanEnd]</span>
                }
            }
        </span>
        @if (!sm.Tail.IsNullOrEmpty()) {
            <span>…@sm.Tail</span>
        }
        @if (m.Translation != TranslationState.None) {
            @TranslationFragments.TranslationMark(TranslationState.Translating)
        }
    } else {
        @if (!_temporaryText.IsNullOrEmpty()) {
            <div class="temporary-container hide">
                <span>@_temporaryText</span>
            </div>
        }
        <CascadingValue Value="@entry" IsFixed="true">
            <CascadingValue Value="@statusFragment">
                @* A lone emoji mention (the whole message is one EmojiMention) renders large. *@
                <CascadingValue Value="@isSoleEmojiMention" Name="IsSoleEmojiMention" IsFixed="true">
                    <MarkupView Markup="@markup"/>
                </CascadingValue>
            </CascadingValue>
        </CascadingValue>
        @if (entry.HasLocation) {
            <LocationMessageView Entry="@entry"/>
        }
    }
</div>

@code {
    private static readonly string JSCreateMethod = $"{BlazorUIAppModule.ImportName}.ChatEntryMessageInternalView.create";

    private static readonly double AnimationDurationMs = Constants.Transcription.ThrottlePeriod.TotalMilliseconds;
    private static readonly int AnimationSpanCount = (int)Math.Round(AnimationDurationMs / (1000.0 / 15));
    private static readonly double AnimationSpanDurationMs = AnimationDurationMs / AnimationSpanCount;
    private static readonly IThreadSafeLruCache<ChatEntryId, TranscriptStreamReader> TranscriptStreamReaderCache
        = new ThreadSafeLruCache<ChatEntryId, TranscriptStreamReader>(100);

    private string? _temporaryText;
    private Model? _rendered;
    private TranscriptStreamReader _streamReader = null!;
    private ChatEntryId _textEntryId = null!;
    private ILogger Log => Hub.LogFor(GetType());
    private IMarkupParser MarkupParser => ChatContext.ChatMarkupHub.Parser;
    private ChatUI ChatUI => Hub.ChatUI;
    private TranslationUI TranslationUI => Hub.TranslationUI;
    private LanguageUI LanguageUI => Hub.LanguageUI;
    private IChatMarkupHub ChatMarkupHub => ChatContext.ChatMarkupHub;

    private bool HasNewerStreamingEntry() {
        var authorId = Message.Entry.AuthorId;
        var current = Message.NextMessage;
        for (var i = 0; i < 50 && current != null; i++, current = current.NextMessage) {
            if (current is ChatEntryMessage em
                && em.Entry.AuthorId == authorId
                && em.Entry.IsContentStreaming)
                return true;
        }
        return false;
    }

    private ElementReference Ref { get; set; }
    private IJSObjectReference JSRef { get; set; } = null!;

    [Parameter, EditorRequired] public ChatContext ChatContext { get; set; } = null!;
    [Parameter, EditorRequired] public ChatEntryMessage Message { get; set; } = null!;
    [Parameter, EditorRequired] public Markup Markup { get; set; } = null!;
    [Parameter] public bool IsUnreadByOthers { get; set; }
    [Parameter] public bool IsUnreadByOthersBlockStart { get; set; }
    [Parameter] public bool IsOwnMessage { get; set; }

    public override async ValueTask DisposeAsync() {
        await JSRef.DisposeSilentlyAsync("dispose");
        JSRef = null!;

        // Log.LogInformation("ChatEntryMessageInternalView.DisposeAsync: {Id}", _textEntryId);
        TranscriptStreamReaderCache.TryGetValue(_textEntryId, out var cached);
        if (ReferenceEquals(cached, _streamReader)) {
            var isStreaming = _streamReader.State.ValueOrDefault?.IsStreaming == true;
            if (!isStreaming) {
                TranscriptStreamReaderCache.Remove(_textEntryId);
                await _streamReader.DisposeSilentlyAsync().ConfigureAwait(false);
            }
            // If still streaming, keep cached for reuse and do not dispose
        }
        else
            await _streamReader.DisposeSilentlyAsync().ConfigureAwait(false);

        await base.DisposeAsync().ConfigureAwait(false);
    }

    protected override void OnInitialized() {
        var messageEntry = Message.Entry;
        _textEntryId = ChatEntryId.New(messageEntry.ChatId, messageEntry.LocalId);
        // Log.LogInformation("ChatEntryMessageInternalView.OnInitialized: {Id}", _textEntryId);

        _streamReader = GetTranscriptStreamReader();
        if (Message.Entry.IsContentStreaming) {
            // Add if the entry was created as streaming
            var added = TranscriptStreamReaderCache.GetOrAdd(_textEntryId, _ => _streamReader);
            // If the instance in the cache is the newly created _streamer, start streaming.
            if (ReferenceEquals(added, _streamReader))
                _streamReader.Start();
        }
        else
            _streamReader.Start();
        // Log.LogInformation("Created new TranscriptStreamer for {Id}", _textEntryId);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (firstRender) {
            JSRef = await JS.InvokeAsync<IJSObjectReference>(
                JSCreateMethod,
                Ref);
        }
    }

    protected override bool ShouldRender() {
        var stateValue = State.Value;
        var shouldRender = _rendered is null
            || !ReferenceEquals(_rendered, stateValue)
                && (stateValue.IsStreaming
                    || _rendered.IsStreaming != stateValue.IsStreaming
                    || _rendered.IsChatLanguageSelected != stateValue.IsChatLanguageSelected
                    || _rendered.Entry.ContentHash != stateValue.Entry.ContentHash
                    || _rendered.Entry.IsSending != stateValue.Entry.IsSending
                    || _rendered.Entry.HasAudio != stateValue.Entry.HasAudio
                    || _rendered.Markup != stateValue.Markup
                    || _rendered.Translation != stateValue.Translation
                    || _rendered.IsUnread != stateValue.IsUnread
                    || _rendered.IsUnreadBlockStart != stateValue.IsUnreadBlockStart);
        return shouldRender;
    }

    protected override ComputedState<Model>.Options GetStateOptions() {
        // Do not use cached options as we need to pass Message and Markup parameters.
        var initialData = new Model(Markup, Message.Entry, TranslationState.None, TranscriptStreamReaderState.None, IsUnreadByOthers, IsUnreadByOthersBlockStart);
        return new() {
            InitialValue = initialData, // To show the original text immediately
            Category = GetStateCategory(GetType()),
        };
    }

    protected override async Task<Model> ComputeState(CancellationToken cancellationToken) {
        var message = Message;
        var isUnreadByOthers = IsUnreadByOthers;
        var isUnreadByOthersBlockStart = IsUnreadByOthersBlockStart;
        // When entry isSending, it's a local chat entry. It does not exist on the server side.
        if (message.Entry.IsSending)
            return new Model(Markup, message.Entry, TranslationState.None, TranscriptStreamReaderState.None, isUnreadByOthers, isUnreadByOthersBlockStart);

        var renderedEntry = _rendered?.Entry ?? message.Entry;
        var markup = _rendered?.Markup ?? Markup;
        var isRenderedTranslated = (_rendered?.Translation ?? TranslationState.None) != TranslationState.None;
        var isRenderedStreaming = _rendered?.IsStreaming ?? false;
        var entry = await ChatUI.GetEntry(renderedEntry.Id, cancellationToken).ConfigureAwait(false);
        if (entry == null) {
            Log.LogWarning("Entry not found: {Id}", renderedEntry.Id);
            return _rendered ?? new Model(markup, message.Entry, TranslationState.None, TranscriptStreamReaderState.None, isUnreadByOthers, isUnreadByOthersBlockStart);
        }

        var streamingState = await _streamReader.State.Use(cancellationToken).ConfigureAwait(false);
        // The transcript reader can finish before the server clears Entry.IsContentStreaming.
        // Keep its last state through that gap — it retains the streamed text, so the streaming
        // branch doesn't render empty and collapse to the "Transcribing" badge.
        if (streamingState.IsStreaming || entry.IsContentStreaming) {
            var translationState = streamingState.IsTranslating
                ? TranslationState.Translating
                : TranslationState.None;
            var isChatLanguageSelected = await LanguageUI.IsChatLanguageSelected(entry.ChatId, cancellationToken).ConfigureAwait(false);
            return new(markup, entry, translationState, streamingState, isUnreadByOthers, isUnreadByOthersBlockStart) {
                IsChatLanguageSelected = isChatLanguageSelected,
            };
        }

        // If we're not streaming, handle possible translation
        var mustTranslate = await TranslationUI.MustTranslate(entry, false, cancellationToken).ConfigureAwait(false);
        var hasTranslationChanged = isRenderedTranslated != mustTranslate;
        var hasStreamingChanged = isRenderedStreaming != streamingState.IsStreaming;
        if (!renderedEntry.VersionEquals(entry) || hasTranslationChanged || hasStreamingChanged)
            markup = await ChatMarkupHub.GetMarkup(entry, MarkupConsumer.MessageView, cancellationToken).ConfigureAwait(false);

        if (!mustTranslate)
            return new(markup, entry, TranslationState.None, TranscriptStreamReaderState.None, isUnreadByOthers, isUnreadByOthersBlockStart);

        var translation = await TranslationUI.Get(entry.Id, cancellationToken).ConfigureAwait(false);
        if (translation is null)
            return new(markup, entry, TranslationState.Translating, TranscriptStreamReaderState.None, isUnreadByOthers, isUnreadByOthersBlockStart);

        if (translation.MatchesOriginal(entry.Content))
            return new(markup, entry, translation.IsStreaming ? TranslationState.Translating : TranslationState.None, TranscriptStreamReaderState.None, isUnreadByOthers, isUnreadByOthersBlockStart);

        var translatedMarkup = entry.HasAudio
            ? new PlayableTextMarkup(translation.Content, translation.GetTimeMap(entry))
            : MarkupParser.Parse(translation.Content);

        var translating = translation.IsStreaming ? TranslationState.Translating : TranslationState.Translated;
        return new(translatedMarkup, entry, translating, TranscriptStreamReaderState.None, isUnreadByOthers, isUnreadByOthersBlockStart);
    }

    // Private methods

    private TranscriptStreamReader GetTranscriptStreamReader() {
        if (TranscriptStreamReaderCache.TryGetValue(_textEntryId, out var cached)) {
            var isStreaming = cached.State.ValueOrDefault?.IsStreaming == true;
            if (isStreaming)
                return cached;

            TranscriptStreamReaderCache.Remove(_textEntryId);
        }
        return new(_textEntryId, Hub);
    }

    // Nested types

    public sealed record Model(
        Markup Markup,
        ChatEntry Entry,
        TranslationState Translation,
        TranscriptStreamReaderState Streaming,
        bool IsUnread,
        bool IsUnreadBlockStart)
    {
        public bool IsChatLanguageSelected { get; init; }
        public bool IsStreaming => Entry.IsContentStreaming || Streaming.IsStreaming;
    }
}
