@namespace ActualChat.UI.Blazor.App.Components
@using ActualChat.Notifications
@inherits ComputedStateComponent<AppUIHub, NotifyMentionedMembers.Model>
@{
    if (State.IsInitial(out var m)) {
        <div class="notify-mentioned-members">
            <span>&nbsp;</span>
        </div>
        return;
    }
    if (m is { HasNotified: false, EverybodyHasRead: true })
        return;

    var cls = m.HasNotified ? "has-notified" : "not-notified";
    var clickHandler = !m.HasNotified ? EventCallback.Factory.Create(this, OnNotifyAuthorsClick) : EventCallback.Empty;
}

<div class="notify-mentioned-members @cls" @onclick="@clickHandler">
    @if (!m.HasNotified) {
        <span class="c-icon">
            <i class="icon-notify-phone-2 self-center text-xs"></i>
        </span>
        <span class="not-mentioned">Alert mentioned</span>
    } else {
        <span class="text-primary font-semibold">You</span><span class="default-text">&nbsp;notified&nbsp;</span>
        @for (var i = 0; i < AuthorIds.Count; i++) {
            var isFirst = i == 0;
            var isLast = i == AuthorIds.Count - 1;
            var authorId = AuthorIds[i];
            if (!isFirst) {
                if (!isLast) {
                    <span class="default-text">,&nbsp;</span>
                } else {
                    <span class="default-text">&nbsp;and&nbsp;</span>
                }
            }

            var mentionIndexCls = "mention-" + i;
            <AuthorBadgeTemplate AuthorId="@authorId">
                <div class="mention-markup mention-markup-valid @mentionIndexCls">
                    <div class="truncate">
                        @(context?.Author?.Avatar.Name ?? "")
                    </div>
                </div>
            </AuthorBadgeTemplate>
        }
    }
</div>

@code {
    private string AdditionalInfo => $"<div class='alert-text'>{CoreConstants.AppName} sends regular notifications for every message, but an" +
                                $" <span class='font-bold'>\"Alert\" is a notification similar to a phone call</span>" +
                                $" — it’s louder, and the user must swipe it or open the app to stop the sound." +
                                $" If you don’t need to distract mentioned members right now, consider not sending it.</div>";

    [Parameter, EditorRequired] public ChatContext ChatContext { get; set; } = null!;
    [Parameter, EditorRequired] public ChatEntry ChatEntry { get; set; } = null!;
    [Parameter, EditorRequired] public IReadOnlyList<AuthorId> AuthorIds { get; set; } = [];

    private IChats Chats => Hub.Chats;
    private INotifications Notifications => Hub.Notifications;

    protected override ComputedState<Model>.Options GetStateOptions()
        => ComputedStateComponent.GetStateOptions(GetType(),
            static t => new ComputedState<Model>.Options() {
                UpdateDelayer = FixedDelayer.NextTick,
                Category = GetStateCategory(t),
            });

    protected override async Task<Model> ComputeState(CancellationToken cancellationToken) {
        var chatEntry = ChatEntry;
        var chatEntryId = chatEntry.Id;
        var hasNotified = await Notifications.HasNotifiedMentionedMembers(
            Session,
            chatEntryId,
            cancellationToken
            ).ConfigureAwait(false);
        if (hasNotified)
            return new Model(true, false); // We can skip checking hasRead status, because we will show badge anyway.
        var everybodyHasRead = true;
        foreach (var authorId in AuthorIds) {
            var mentionId = MentionRef.NewAuthor(authorId);
            var hasRead = await Chats.IsEntryReadByMentionedUser(Session, chatEntryId, mentionId, cancellationToken).ConfigureAwait(false);
            if (!hasRead)
                everybodyHasRead = false;
        }
        return new Model(false, everybodyHasRead);
    }

    private void OnNotifyAuthorsClick()
        => _ = ModalUI.Show(new ConfirmModal.Model(
            false,
            "Are you sure you want to Alert mentioned members?",
            NotifyAuthorsInternal) {
            Title = "Alert mentioned members",
            AdditionalContent = AdditionalInfo,
            Class = "alert-confirm-modal",
            ConfirmButtonText = "Alert",
        });

    private void NotifyAuthorsInternal()
        => _ = UICommander.Call(new Notifications_NotifyMentionedMembers(Session, ChatEntry.Id));

    // Nested types

    public record Model(bool HasNotified, bool EverybodyHasRead);
}
