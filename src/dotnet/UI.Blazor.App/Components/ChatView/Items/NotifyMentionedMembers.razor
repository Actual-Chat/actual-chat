@using ActualChat.Notification
@namespace ActualChat.UI.Blazor.App.Components
@inherits ComputedStateComponent<NotifyMentionedMembers.Model>
@{
    var m = State.Value;
    var cls = m.HasNotified ? "has-notified" : "cursor-pointer";
    var clickHandler = !m.HasNotified ? EventCallback.Factory.Create(this, OnNotifyAuthorsClick) : EventCallback.Empty;
}
@if (ReferenceEquals(m, Model.Loading)) {
    <div class="notify-mentioned-members">
        <span>&nbsp;</span>
    </div>
    return;
}
<div class="notify-mentioned-members @cls" @onclick="@clickHandler">
    @if (!m.HasNotified) {
        <i class="icon-notify-phone"></i>
        <span>&nbsp;Get attention of&nbsp;</span>
    } else {
        <span><span class="text-primary font-semibold">You</span> notified&nbsp;</span>
    }
    @for (var i = 0; i < AuthorIds.Length; i++) {
        var isFirst = i == 0;
        var isLast = i == AuthorIds.Length - 1;
        var authorId = AuthorIds[i];
        if (!isFirst) {
            if (!isLast) {
                <span>,&nbsp;</span>
            } else {
                <span>&nbsp;and&nbsp;</span>
            }
        }

        var mentionIndexCls = "mention-" + i;
        <AuthorBadgeTemplate AuthorSid="@authorId">
            <div class="mention-markup mention-markup-valid @mentionIndexCls">
                <div class="truncate">
                    @context.Author.Avatar.Name
                </div>
            </div>
        </AuthorBadgeTemplate>
    }
</div>

@code {
    [Parameter, EditorRequired] public ChatContext ChatContext { get; set; } = null!;
    [Parameter, EditorRequired] public ChatEntry ChatEntry { get; set; } = null!;
    [Parameter, EditorRequired] public ImmutableArray<AuthorId> AuthorIds { get; set; }

    private ChatUIHub Hub => ChatContext.Hub;
    private Session Session => Hub.Session();
    private INotifications Notifications => Hub.Notifications;
    private UICommander UICommander => Hub.UICommander();
    private ModalUI ModalUI => Hub.ModalUI;

    protected override ComputedState<Model>.Options GetStateOptions()
        => ComputedStateComponent.GetStateOptions(GetType(),
            static t => new ComputedState<Model>.Options() {
                InitialValue = Model.Loading,
                UpdateDelayer = FixedDelayer.NextTick,
                Category = ComputedStateComponent.GetStateCategory(t),
            });

    protected override async Task<Model> ComputeState(CancellationToken cancellationToken) {
        var hasNotified = await Notifications.HasNotifiedMentionedMembers(
            Session,
            ChatEntry.Id.ToTextEntryId(),
            cancellationToken
            ).ConfigureAwait(false);
        return new Model(hasNotified);
    }

    private void OnNotifyAuthorsClick()
        => _ = ModalUI.Show(new ConfirmModal.Model(
            false,
            "Are you sure you want to Notify mentioned members?",
            NotifyAuthorsInternal) {
            Title = "Notify mentioned members"
        });

    private void NotifyAuthorsInternal()
        => _ = UICommander.Call(new Notifications_NotifyMentionedMembers(Session, ChatEntry.Id.ToTextEntryId()));

    // Nested types
    public record Model(bool HasNotified) {
        public static readonly Model Loading = new (false);
    }
}
