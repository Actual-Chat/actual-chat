@namespace ActualChat.UI.Blazor.App.Components
@inherits ComputedRenderStateComponent<AppUIHub, ChatEntryMessageInternalView.Model>
@{
    var m = State.Value;
    var sm = m.Streaming;
    var message = Message;
    var markup = m.Markup;
    var entry = m.Entry;
    var oldTranslation = _rendered?.Translation ?? m.Translation;
    var oldStreaming = _rendered?.Streaming.IsStreaming ?? m.Streaming.IsStreaming;
    _rendered = m;
    var isSimpleMarkup = markup is PlainTextMarkup or PlayableTextMarkup;
    var streamingCls = "";
    if (!oldStreaming && !m.IsStreaming) {
        streamingCls = "not-streaming";
    } else if (oldStreaming && !m.IsStreaming) {
        streamingCls = "from-streaming";
    }
    var translationCls = "";
    if (oldTranslation is TranslationState.None or TranslationState.Translating && m.Translation == TranslationState.Translated) {
        translationCls = "to-translated";
    } else if (oldTranslation is TranslationState.Translated or TranslationState.Translating && m.Translation == TranslationState.None) {
        translationCls = "from-translated";
    } else if (m.Translation == TranslationState.Translating) {
        translationCls = "translating";
    }

    // Log.LogInformation("Rendering ChatEntryMessageInternalView for {MessageId} (IsStreaming: {IsStreaming}, IsTranslated: {IsTranslated})",
    //     message.Entry.Id, m.IsStreaming, m.Translation);

    // Should be named __builder
    // ReSharper disable once VariableHidesOuterVariable UnusedParameter.Local
    RenderFragment statusFragment = (__builder) => {
        @TranslationFragments.TranslationMark(m.Translation)
        @if (IsUnreadByOthers && entry.Attachments.Length == 0) {
            <ChatMessageSendingStatus
                Status="@ChatMessageSendingStatus.MessageStatus.Unread"
                IsDotOnly="@(!IsUnreadByOthersBlockStart)"/>
        }
        @if (message.ShowIndexDocId) {
            <span>[DocId=@message.IndexDocId]</span>
        }
    };
}
<p class="chat-message-markup @translationCls @streamingCls">
    @if (message.Flags.HasFlag(ChatMessageFlags.HasEntryKindSign)) {
        <ChatEntryKindView Kind="@(entry.HasAudioEntry ? ChatEntryKind.Audio : entry.Kind)"/>
    }
    @if (m.IsStreaming) {
        @if (!sm.RetainedText.IsNullOrEmpty()) {
            <span class="retained">@sm.RetainedText</span>
        }
        <span class="changes">
            <span>@sm.ChangedText</span>
            @{
                for (var spanIndex = 0; spanIndex < AnimationSpanCount; spanIndex++) {
                    var spanStart = sm.AnimatedText.Length * spanIndex / AnimationSpanCount;
                    var spanEnd = sm.AnimatedText.Length * (spanIndex + 1) / AnimationSpanCount;
                    if (spanStart >= spanEnd)
                        continue;

                    var spanDelay = (int)Math.Round(AnimationSpanDurationMs * spanIndex);
                    var style = $"transition-delay: {spanDelay}ms;";
                    <span class="change-item" style="@style">@sm.AnimatedText[spanStart..spanEnd]</span>
                }
            }
        </span>
        @if (!sm.Tail.IsNullOrEmpty()) {
            <span>…@sm.Tail</span>
        }
        @if (m.Translation != TranslationState.None) {
            @TranslationFragments.TranslationMark(TranslationState.Translating)
        }
    } else {
        <CascadingValue Value="@entry" IsFixed="true">
            @if (isSimpleMarkup) {
                <CascadingValue Value="@statusFragment" IsFixed="true">
                    <MarkupView Markup="@markup"/>
                </CascadingValue>
            } else {
                <MarkupView Markup="@markup"/>
                @statusFragment
            }
        </CascadingValue>
    }
</p>

@code {
    private static readonly double AnimationDurationMs = Constants.Transcription.ThrottlePeriod.TotalMilliseconds;
    private static readonly int AnimationSpanCount = (int)Math.Round(AnimationDurationMs / (1000.0 / 15));
    private static readonly double AnimationSpanDurationMs = AnimationDurationMs / AnimationSpanCount;

    private Model? _rendered;
    private TranscriptStreamer _streamer = null!;
    private ILogger Log => Hub.LogFor(GetType());
    private IMarkupParser MarkupParser => ChatContext.ChatMarkupHub.Parser;
    private ChatUI ChatUI => Hub.ChatUI;
    private TranslationUI TranslationUI => Hub.TranslationUI;
    private IChatMarkupHub ChatMarkupHub => ChatContext.ChatMarkupHub;

    [Parameter, EditorRequired] public ChatContext ChatContext { get; set; } = null!;
    [Parameter, EditorRequired] public ChatEntryMessage Message { get; set; } = null!;
    [Parameter, EditorRequired] public Markup Markup { get; set; } = null!;
    [Parameter] public bool IsUnreadByOthers { get; set; }
    [Parameter] public bool IsUnreadByOthersBlockStart { get; set; }

    public override async ValueTask DisposeAsync() {
        await _streamer.DisposeSilentlyAsync().ConfigureAwait(false);
        await base.DisposeAsync().ConfigureAwait(false);
    }

    protected override void OnInitialized() {
        _streamer = new (Message.Entry.Id, Hub);
        _streamer.Start();
    }

    protected override bool ShouldRender() {
        var stateValue = State.Value;
        var shouldRender = _rendered is null || !ReferenceEquals(_rendered, stateValue)
            && (stateValue.IsStreaming
                || _rendered.IsStreaming != stateValue.IsStreaming
                || _rendered.Entry.ContentHash != stateValue.Entry.ContentHash
                || _rendered.Markup != stateValue.Markup
                || _rendered.Translation != stateValue.Translation
                || _rendered.IsUnread != stateValue.IsUnread
                || _rendered.IsUnreadBlockStart != stateValue.IsUnreadBlockStart);
        if (!shouldRender) {
            Log.LogInformation("Skipping render for {MessageId} (IsStreaming: {IsStreaming}, IsTranslated: {IsTranslated})",
                Message.Entry.Id, stateValue.IsStreaming, stateValue.Translation);
        }
        return shouldRender;
    }

    protected override ComputedState<Model>.Options GetStateOptions() {
        // Do not use cached options as we need to pass Message and Markup parameters.
        var initialData = new Model(Markup, Message.Entry, TranslationState.None, TranscriptStreamer.StreamingState.None, IsUnreadByOthers, IsUnreadByOthersBlockStart);
        return new() {
            InitialValue = initialData, // To show the original text immediately
            Category = GetStateCategory(GetType()),
        };
    }

    protected override async Task<Model> ComputeState(CancellationToken cancellationToken) {
        var message = Message;
        var renderedEntry = _rendered?.Entry ?? message.Entry;
        var markup = _rendered?.Markup ?? Markup;
        var isRenderedTranslated = (_rendered?.Translation ?? TranslationState.None) != TranslationState.None;
        var isRenderedStreaming = _rendered?.IsStreaming ?? false;
        var isUnreadByOthers = IsUnreadByOthers;
        var isUnreadByOthersBlockStart = IsUnreadByOthersBlockStart;
        var entry = await ChatUI.GetEntry(renderedEntry.Id, cancellationToken).ConfigureAwait(false);
        if (entry == null) {
            Log.LogWarning("Entry not found: {Id}", renderedEntry.Id);
            return _rendered ?? new Model(markup, message.Entry, TranslationState.None, TranscriptStreamer.StreamingState.None, isUnreadByOthers, isUnreadByOthersBlockStart);
        }

        var streamingState = await _streamer.State.Use(cancellationToken).ConfigureAwait(false);
        if (streamingState.IsStreaming) {
            var translationState = streamingState.IsTranslating
                ? TranslationState.Translating
                : TranslationState.None;
            return new(markup, entry, translationState, streamingState, isUnreadByOthers, isUnreadByOthersBlockStart);
        }

        // If we're not streaming, handle possible translation
        var mustTranslate = await TranslationUI.MustTranslate(entry, false, cancellationToken).ConfigureAwait(false);
        var hasTranslationChanged = isRenderedTranslated != mustTranslate;
        var hasStreamingChanged = isRenderedStreaming != streamingState.IsStreaming;
        if (!renderedEntry.VersionEquals(entry) || hasTranslationChanged || hasStreamingChanged)
            markup = await ChatMarkupHub.GetMarkup(entry, MarkupConsumer.MessageView, cancellationToken).ConfigureAwait(false);

        if (!mustTranslate)
            return new(markup, entry, TranslationState.None, TranscriptStreamer.StreamingState.None, isUnreadByOthers, isUnreadByOthersBlockStart);

        var translation = await TranslationUI.Get(entry.Id.ToTextEntryId(), cancellationToken).ConfigureAwait(false);
        if (translation is null)
            return new(markup, entry, TranslationState.Translating, TranscriptStreamer.StreamingState.None, isUnreadByOthers, isUnreadByOthersBlockStart);

        if (translation.MatchesOriginal(entry.Content))
            return new(markup, entry, translation.IsStreaming ? TranslationState.Translating : TranslationState.None, TranscriptStreamer.StreamingState.None, isUnreadByOthers, isUnreadByOthersBlockStart);

        var translatedMarkup = entry.HasMediaEntry
            ? new PlayableTextMarkup(translation.Content, translation.GetTimeMap(entry))
            : MarkupParser.Parse(translation.Content);

        var translating = translation.IsStreaming ? TranslationState.Translating : TranslationState.Translated;
        return new(translatedMarkup, entry, translating, TranscriptStreamer.StreamingState.None, isUnreadByOthers, isUnreadByOthersBlockStart);
    }

    // Nested types
    public sealed record Model(
        Markup Markup,
        ChatEntry Entry,
        TranslationState Translation,
        TranscriptStreamer.StreamingState Streaming,
        bool IsUnread,
        bool IsUnreadBlockStart)
    {
        public bool IsStreaming => Entry.IsStreaming || Streaming.IsStreaming;
    }
}
