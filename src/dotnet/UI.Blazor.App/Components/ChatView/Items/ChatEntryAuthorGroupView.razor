@namespace ActualChat.UI.Blazor.App.Components
@{
    var m = Message;
    var firstItem = m.Items.FirstOrDefault();
    var showAuthorBadge = !(firstItem?.Entry.IsSystemEntry ?? false);
}


<div class="chat-message-group">
    <div class="c-left">
        @if (showAuthorBadge) {
            <ChatMessageAuthorCircle
                AuthorSid="@Message.AuthorId.Value"
                Click="@_onClickCallback"/>
        }
    </div>
    <div class="c-group-items">
        @foreach (var item in Message.Items) {
            <div @key="@item.Key" class="item" data-key="@item.Key">
                <ChatEntryMessageView ChatContext="@ChatContext" Message="@item" ShowAuthorBadge="false"/>
            </div>
        }
    </div>
</div>


@code {
    private EventCallback<AuthorId> _onClickCallback;

    private AppUIHub Hub => ChatContext.Hub;
    private AuthorUI AuthorUI => Hub.AuthorUI;

    [Parameter, EditorRequired] public ChatContext ChatContext { get; set; } = null!;
    [Parameter, EditorRequired] public ChatEntryAuthorGroup Message { get; set; } = null!;

    protected override void OnInitialized()
        => _onClickCallback = NoStateHasChanged.EventCallback<AuthorId>(OnAuthorBadgeClick);

    private void OnAuthorBadgeClick(AuthorId authorId)
        => _ = AuthorUI.Show(authorId);
}
