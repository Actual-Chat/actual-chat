@namespace ActualChat.UI.Blazor.App.Components
@{
    var m = Message;
    var firstItem = m.Items.FirstOrDefault();
    var isSystem = firstItem?.Entry.IsSystemEntry ?? false;
    // No BlockStart => the group exists only because a separator (e.g. NewMessagesLine) split a
    // same-author run; the inner header is suppressed too, so a lone avatar would look orphaned.
    var isBlockStart = firstItem?.Flags.HasFlag(ChatMessageFlags.BlockStart) ?? false;
    var showAuthorBadge = !isSystem && isBlockStart;
    // Log.LogInformation("Render ChatEntryAuthorGroupView: {Id}, Count = {Count}", firstItem?.Entry.Id, m.Items.Count);
}


<div class="chat-message-group">
    <div class="c-left">
        @if (showAuthorBadge) {
            <ChatMessageAuthorCircle
                AuthorId="@Message.AuthorId"
                Click="@_onClickCallback"/>
        }
    </div>
    <div class="c-group-items">
        @foreach (var item in Message.Items) {
            @* A streaming entry grows a line at a time; animating its height reflows the whole list
               on every animation frame (height is a layout property), which a mobile WebView repaints
               as a flicker of the neighbouring blocks. "none" makes it grow instantly - one reflow per
               line, not one per frame. A settled entry (null) keeps the normal height animation. *@
            <div @key="@item.Key" class="item" data-key="@item.Key"
                 data-vl-h-transition="@(item.Entry.IsContentStreaming ? "none" : null)"
                 data-children="conversation-message live-card live-footer live-header show-author conversation-header vl-sticky">
                <ChatEntryMessageView ChatContext="@ChatContext" Message="@item" ShowAuthorBadge="false"/>
            </div>
        }
    </div>
</div>


@code {
    private EventCallback<AuthorId> _onClickCallback;

    private AppUIHub Hub => ChatContext.Hub;
    private AuthorUI AuthorUI => Hub.AuthorUI;
    private SelectionUI SelectionUI => Hub.SelectionUI;

    [Parameter, EditorRequired] public ChatContext ChatContext { get; set; } = null!;
    [Parameter, EditorRequired] public ChatEntryAuthorGroup Message { get; set; } = null!;

    protected override void OnInitialized()
        => _onClickCallback = NoStateHasChanged.EventCallback<AuthorId>(OnAuthorBadgeClick);

    private void OnAuthorBadgeClick(AuthorId authorId) {
        // The group avatar sits in .c-left, outside any message's data-chat-entry-id, so the JS
        // selection host never sees it; in selection mode we just suppress the author card instead
        // of opening it over the selection.
        if (SelectionUI.HasSelection.Value)
            return;

        _ = AuthorUI.Show(authorId);
    }
}
