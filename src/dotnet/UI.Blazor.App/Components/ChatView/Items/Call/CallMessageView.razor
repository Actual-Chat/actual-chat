@namespace ActualChat.UI.Blazor.App.Components
@{
    // Both flags come from the already-loaded chat rather than a compute state: resolving them
    // asynchronously painted every card as the receiving side's first, so a caller saw "Missed"
    // before it flipped to "Canceled".
    var rules = ChatContext.Chat.Rules;
    var isCaller = rules.Author?.Id == Entry.CallerId;
    var canCall = Entry.ChatId.Kind != ChatKind.Peer || (rules.CanWriteAudio() && !rules.IsPeerContactPending);
    var (icon, title, hint, isCallBack) = CallCardFormat.Get(Entry.Outcome, isCaller, L);
    // An offer that would only reach the server's peer-call gate and come back as a toast is worse
    // than no offer: the header button greys itself out on the same rule.
    if (isCallBack && !canCall)
        hint = null;
    var time = DateTimeConverter.ToLocalTime(Entry.BeginsAt).ToString("t", DateFormatter);
    // An answered call has no call card to frame it here, so its own span becomes the shown duration.
    string? caption;
    if (Entry is { Outcome: CallOutcome.Ended, EndsAt: { } endsAt })
        caption = DateFormatter.FormatDuration(endsAt - Entry.BeginsAt);
    else if (isCallBack)
        caption = hint ?? time;
    else if (hint is not null)
        caption = $"{hint} · {time}";
    else
        caption = time;
    // Only a missed call wears the magenta tint; everything else - including a call you declined or
    // canceled yourself - reads as neutral. CallCardFormat flags exactly the missed cases as callable back.
    var isMissed = isCallBack;
    // The whole pill redials, the way the header's call button does. It rides on @onclick, which the
    // browser never raises for a touch that turned into a scroll, so reading the log can't ring anyone.
    _canCall = canCall;
}

@* No avatars: a peer call has exactly two sides, and the icon carries the direction. *@
<div class="call-message @(isMissed ? "c-missed" : "c-regular") @(_canCall ? "c-action" : null)"
     role="@(_canCall ? "button" : null)"
     @onclick="OnCardClick">
    <div class="c-cm-icon-badge">
        <i class="@icon c-cm-icon"></i>
    </div>
    <div class="c-cm-body">
        <div class="c-cm-title">@title</div>
        <div class="c-cm-meta">@caption</div>
    </div>
</div>

@code {
    private bool _canCall;

    [Inject] protected AppUIHub Hub { get; init; } = null!;
    private DateTimeConverter DateTimeConverter => Hub.DateTimeConverter;
    private DateFormatter DateFormatter => Hub.DateFormatter;
    private IStringLocalizer L => Hub.StringLocalizer;
    private CallUI CallUI => Hub.CallUI;
    [Parameter, EditorRequired] public ChatContext ChatContext { get; set; } = null!;
    [Parameter, EditorRequired] public CallEntry Entry { get; set; } = null!;

    private Task OnCardClick()
        => _canCall
            ? CallUI.StartCall(Entry.ChatId, default, Entry.HasVideo, CancellationToken.None)
            : Task.CompletedTask;
}
