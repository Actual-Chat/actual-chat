@namespace ActualChat.UI.Blazor.App.Components
@inherits ComputedMenuBase<AppUIHub, ConversationMenu.Model>
@{
    var m = State.Value;
    if (State.Value == Model.None)
        return;

    var expandCollapseButtonTitle = _isOpen ? L.ConversationMenu_Collapse : L.ConversationMenu_Expand;
    var expandCollapseButtonIcon = _isOpen ? "icon-collapse" : "icon-expand";
}

<div class="message-menu">
    <MenuEntry
        Icon="@expandCollapseButtonIcon"
        Text="@expandCollapseButtonTitle"
        Class="important-item"
        Click="@(ToggleShowMessage)">
    </MenuEntry>
    @if (m.CanReSummarize) {
        <MenuEntry
            Icon="icon-resummarize"
            Text="@L.ConversationMenu_ReSummarize"
            Click="@(OnReSummarize)">
        </MenuEntry>
    }
    <MenuEntry
        Icon="icon-copy"
        Text="@L.ConversationMenu_CopySummary"
        Click="@OnCopyToClipboardRequested">
    </MenuEntry>
</div>

@code {
    private bool _isOpen;
    private ConversationId _conversationId = null!;

    private IConversations Conversations => Hub.Conversations;
    private ConversationUI ConversationUI => Hub.ConversationUI;
    private ChatUI ChatUI => Hub.ChatUI;
    private IChats Chats => Hub.Chats;
    private ClipboardUI ClipboardUI => Hub.ClipboardUI;

    protected override void OnParametersSet() {
        if (Arguments is not [ var sConversationId, var sIsOpen ])
            throw new ArgumentOutOfRangeException(nameof(Arguments));

        _conversationId = ConversationId.Parse(sConversationId);
        _isOpen = bool.Parse(sIsOpen);
    }

    protected override ComputedState<Model>.Options GetStateOptions()
        => ComputedStateComponent.GetStateOptions(GetType(),
            static t => new ComputedState<Model>.Options() {
                InitialValue = Model.None,
                Category = GetStateCategory(t),
            });

    protected override async Task<Model> ComputeState(CancellationToken cancellationToken) {
        var conversationId = _conversationId;
        var conversation = await Conversations.Get(Session, conversationId, cancellationToken).ConfigureAwait(false);
        if (conversation == null)
            return Model.None;

        // Production never shows Re-summarize, so the owner check stays conditional - asking for the
        // chat there would add a dependency that recomputes this menu for nothing.
        var canReSummarize = false;
        if (!HostInfo.IsProductionInstance) {
            var chat = await Chats.Get(Session, conversationId.ChatId, cancellationToken).ConfigureAwait(false);
            canReSummarize = chat != null && (chat.Rules.IsOwner() || chat.Kind == ChatKind.Peer);
        }
        return new() {
            Conversation = conversation,
            CanReSummarize = canReSummarize,
        };
    }

    private void ToggleShowMessage()
        => ChatUI.ToggleExpandConversation(_conversationId);

    private void OnReSummarize()
        => UICommander.Call(new Conversations_Summarize { Session = Session, ConversationId = _conversationId });

    private async Task OnCopyToClipboardRequested() {
        var cancellationToken = CancellationToken.None;
        var m = State.Value;
        var translatedConversation = await ConversationUI
            .GetTranslatedConversation(m.Conversation, cancellationToken);
        var text = await ConversationUI.GetClipboardText(translatedConversation, cancellationToken);
        await ClipboardUI.WriteText(text).ConfigureAwait(false);
    }

    // Nested types

    public sealed record Model {
        public static readonly Model None = new();

        public Conversation Conversation { get; init; } = null!;
        public bool CanReSummarize { get; init; }
    }
}
