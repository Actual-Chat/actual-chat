@namespace ActualChat.UI.Blazor.App.Components
@using ActualChat.UI.Blazor.App.Events

@* ReSharper disable once UnusedParameter.Local *@
@code {
    public static readonly RenderFragment<(ChatMessage Item, ChatContext Context)> RenderChatMessage = context => __builder => {
        var item = context.Item;
        var chatContext = context.Context;
        if (item is ChatEntryMessage message) {
            <ChatEntryMessageView ChatContext="@chatContext" Message="@message"/>
        }
        else if (item is ThreadMessage threadMessage)
        {
            <ThreadMessageView ChatContext="@chatContext" Message="@threadMessage" />
        }
        else if (item is ConversationMessage conversationMessage)
        {
            <ConversationMessageView ChatContext="@chatContext" Message="@conversationMessage" />
        }
        else if (item is ConversationHeader conversationHeader)
        {
            <ConversationHeaderView ChatContext="@chatContext" Header="@conversationHeader" />
        }
        else if (item is ConversationFooter conversationFooter)
        {
            <ConversationFooterView ChatContext="@chatContext" Footer="@conversationFooter" />
        }
        else if (item is ExpandedConversationMessage expandedConversationMessage) {
            foreach (var childItem in expandedConversationMessage.Items) {
                @if (childItem is ConversationHeader) {
                    <div @key="@childItem.Key" class="item expanded" data-key="@childItem.Key" data-skip="true">
                        @RenderChatMessage!((childItem, chatContext))
                    </div>
                }
                else if (childItem.IsGroup) {
                    <div class="group" >
                        @RenderChatMessage!((childItem, chatContext))
                    </div>
                }
                else {
                    <div @key="@childItem.Key" class="item" data-key="@childItem.Key" data-skip="@childItem.ShouldSkipKey">
                        @RenderChatMessage!((childItem, chatContext))
                    </div>
                }
            }
        }
        else if (item is ChatEntryAuthorGroup chatEntryGroup) {
            <ChatEntryAuthorGroupView ChatContext="@chatContext" Message="@chatEntryGroup" />
        }
    };
}

<OnUIEvent TEvent="@NavigateToChatEntryEvent" Handler="@OnNavigateToChatEntry" />
<CascadingValue Value="@this">
    <VirtualList
        @key="@Chat.Id.Value"
        Class="chat-view"
        DataSource="@this"
        Identity="@Chat.Id.Value"
        DefaultEdge="@VirtualListEdge.End"
        ShowOverscrollCue="true"
        SkeletonCount="15"
        SpacerSize="1500"
        ItemVisibilityChanged="@OnItemVisibilityChanged">
        <Item>
            @RenderChatMessage((context, ChatContext))
        </Item>
        <SkeletonBatch>
            <chat-view-skeleton class="no-scrollbar" count="@context" />
        </SkeletonBatch>
    </VirtualList>
</CascadingValue>

<RenderIntoStack Name="@LayoutSlots.SubFooter" Order="-1000_000" Key="NavigationSubFooter">
    <CascadingValue Value="@ChatContext">
        <CascadingValue Value="@this">
            <ChatViewNavigationPanel/>
        </CascadingValue>
    </CascadingValue>
</RenderIntoStack>

<RenderIntoStack Name="@LayoutSlots.SubHeader" Order="2000_000" Key="DateVisor">
    <DateVisor Chat="@Chat" ChatView="@this"/>
</RenderIntoStack>
