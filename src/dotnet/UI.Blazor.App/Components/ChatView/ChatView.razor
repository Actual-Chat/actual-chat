@namespace ActualChat.UI.Blazor.App.Components
@using ActualChat.UI.Blazor.App.Events

<OnUIEvent TEvent="@NavigateToChatEntryEvent" Handler="@OnNavigateToChatEntry" />
<VirtualList
    @key="@ChatId.Value"
    Class="chat-view"
    DataSource="@this"
    Identity="@ChatId"
    DefaultEdge="@VirtualListEdge.End"
    SkeletonCount="15"
    SpacerSize="1500"
    RequestDataOnParameterSet="true"
    ItemVisibilityChanged="@OnItemVisibilityChanged">
    <Item>
        @if(context is ChatEntryMessage message)
        {
            <ChatEntryMessageView ChatContext="@_chatContext" Message="@message"/>
        }
        else if(context is ConversationMessage conversationMessage)
        {
            <ConversationMessageView ChatContext="@_chatContext" Message="@conversationMessage" />
        }
        else if (context is ConversationHeader conversationHeader)
        {
            <ConversationHeaderView ChatContext="@_chatContext" Header="@conversationHeader" />
        }
        else if (context is ConversationFooter conversationFooter)
        {
            <ConversationFooterView ChatContext="@_chatContext" Footer="@conversationFooter" />
        }
    </Item>
    <SkeletonBatch>
        <chat-view-skeleton count="@context" />
    </SkeletonBatch>
</VirtualList>

<RenderIntoStack Name="@LayoutSlots.SubFooter" Order="-1000_000" Key="NavigationSubFooter">
    <ChatViewNavigationPanel ChatId="@ChatId" ChatView="@this" />
    <TranslationButton ChatId="@ChatId"/>
</RenderIntoStack>

<RenderIntoStack Name="@LayoutSlots.SubHeader" Order="1000_000" Key="DateVisor">
    <DateVisor ChatId="@ChatId" ChatView="@this"/>
</RenderIntoStack>
