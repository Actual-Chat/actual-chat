@namespace ActualChat.UI.Blazor.App.Components
@using ActualChat.UI.Blazor.App.Events

@code {
    private static readonly RenderFragment<(ChatMessage, ChatContext)> RenderChatMessage = context => __builder => {
        @if (context.Item1 is ChatEntryMessage message) {
            <ChatEntryMessageView ChatContext="@context.Item2" Message="@message"/>
        }
        else if (context.Item1 is ConversationMessage conversationMessage)
        {
            <ConversationMessageView ChatContext="@context.Item2" Message="@conversationMessage" />
        }
        else if (context.Item1 is ConversationHeader conversationHeader)
        {
            <ConversationHeaderView ChatContext="@context.Item2" Header="@conversationHeader" />
        }
        else if (context.Item1 is ConversationFooter conversationFooter)
        {
            <ConversationFooterView ChatContext="@context.Item2" Footer="@conversationFooter" />
        }
        else if (context.Item1 is ExpandedConversationMessage expandedConversationMessage) {
            foreach (var item in expandedConversationMessage.Items) {
                <div @key="@item.Key" class="item" data-key="@item.Key">
                    @RenderChatMessage!((item, context.Item2))
                </div>
            }
        }
    };
}

<OnUIEvent TEvent="@NavigateToChatEntryEvent" Handler="@OnNavigateToChatEntry" />
<VirtualList
    @key="@ChatId.Value"
    Class="chat-view"
    DataSource="@this"
    Identity="@ChatId"
    DefaultEdge="@VirtualListEdge.End"
    SkeletonCount="15"
    SpacerSize="1500"
    RequestDataOnParameterSet="true"
    ItemVisibilityChanged="@OnItemVisibilityChanged">
    <Item>
        @RenderChatMessage((context, _chatContext))
    </Item>
    <SkeletonBatch>
        <chat-view-skeleton count="@context" />
    </SkeletonBatch>
</VirtualList>

<RenderIntoStack Name="@LayoutSlots.SubFooter" Order="-1000_000" Key="NavigationSubFooter">
    <ChatViewNavigationPanel ChatId="@ChatId" ChatView="@this" />
    <TranslationButton ChatId="@ChatId"/>
</RenderIntoStack>

<RenderIntoStack Name="@LayoutSlots.SubHeader" Order="1000_000" Key="DateVisor">
    <DateVisor ChatId="@ChatId" ChatView="@this"/>
</RenderIntoStack>
