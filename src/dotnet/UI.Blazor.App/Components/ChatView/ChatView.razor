@namespace ActualChat.UI.Blazor.App.Components
@using ActualChat.UI.Blazor.App.Events

@{
    // Render more skeletons when there are no entries rendered yet
    var skeletonCount = ItemVisibility.Value.VisibleEntryLids.Count > 0
        ? 2
        : 10;
}

<OnUIEvent TEvent="@NavigateToChatEntryEvent" Handler="@OnNavigateToChatEntry" />
<VirtualList
    @key="@ChatId.Value"
    Class="chat-view"
    DataSource="@this"
    Identity="@ChatId"
    DefaultEdge="@VirtualListEdge.End"
    SkeletonCount="@skeletonCount"
    RequestDataOnParameterSet="true"
    ItemVisibilityChanged="@OnItemVisibilityChanged">
    <Item>
        <ChatMessageView ChatContext="@_chatContext" Message="@context" />
    </Item>
    <SkeletonBatch>
        <chat-view-skeleton count="@context" />
    </SkeletonBatch>
</VirtualList>

<RenderIntoStack Name="@LayoutSlots.SubFooter" Order="-1000_000" Key="NavigationSubFooter">
    <ChatViewNavigationPanel ChatId="@ChatId" ChatView="@this" />
</RenderIntoStack>

<RenderIntoStack Name="@LayoutSlots.SubHeader" Order="1000_000" Key="DateVisor">
    <DateVisor ChatId="@ChatId" ChatView="@this"/>
</RenderIntoStack>
