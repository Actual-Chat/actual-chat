@namespace ActualChat.UI.Blazor.App.Components
@inherits ComputedStateComponent<AppUIHub, EmptyChatContent.Model?>
@{
    var m = State.ValueOrDefault; // Intended: Error != null when chat is not found
    if (ReferenceEquals(m, null))
        return;
}

<div class="empty-chat-content">
    <empty-chat-svg />
    <div class="c-text">
        <span>@L.ChatView_NoMessagesYet</span>
        @if (m.PeerAccount is { } peerAccount) {
            <div class="c-truncated-text">
                <span class="c-part">@L.ChatView_SayHiTo_Prefix</span>
                <AccountName UserId="@peerAccount.Id"/>
                <span class="c-part">@L.ChatView_SayHiTo_Suffix</span>
            </div>
        } else {
            <span>@L.ChatView_PostTheFirstMessage</span>
        }
    </div>
</div>

@code {
    private IAccounts Accounts => Hub.Accounts;
    private ChatUI ChatUI => Hub.ChatUI;

    [Parameter, EditorRequired] public Chat Chat { get; set; } = null!;

    protected override async Task<Model?> ComputeState(CancellationToken cancellationToken) {
        var chat = Chat;
        var chatId = chat.Id;

        var isEmpty = await ChatUI.IsEmpty(chatId, cancellationToken).ConfigureAwait(false);
        if (!isEmpty || chat.HasSingleAuthor)
            return null;

        if (chatId is not PeerChatId peerChatId)
            return Model.NoPeerAccount;

        var account = await AccountUI.OwnAccount.Use(cancellationToken).ConfigureAwait(false);
        var peerAccountId = peerChatId.AnotherUserIdOrNull(account.Id);
        if (peerAccountId is null)
            return Model.NoPeerAccount;

        var peerAccount = await Accounts.Get(Session, peerAccountId, cancellationToken).ConfigureAwait(false);
        return new() { PeerAccount = peerAccount };
    }

    // Nested types

    public sealed record Model {
        public static readonly Model NoPeerAccount = new();

        public Account? PeerAccount { get; init; }
    }
}
