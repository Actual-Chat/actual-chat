@namespace ActualChat.UI.Blazor.App.Components
@using ActualChat.Notifications
@inherits ComputedStateComponent<AppUIHub, AlertMentionedMenuEntry.Model>
@{
    var m = State.Value;
    if (!m.CanAlert)
        return;
}

<MenuEntry
    Icon="icon-bell"
    Text="@L.Alert_AlertAll"
    Click="OnClick">
</MenuEntry>

@code {
    private INotifications Notifications => Hub.Notifications;

    [Parameter, EditorRequired] public ChatEntry Entry { get; set; } = null!;

    protected override ComputedState<Model>.Options GetStateOptions()
        => ComputedStateComponent.GetStateOptions(GetType(),
            static t => new ComputedState<Model>.Options() {
                InitialValue = Model.None,
                UpdateDelayer = FixedDelayer.NextTick,
                Category = GetStateCategory(t),
            });

    protected override async Task<Model> ComputeState(CancellationToken cancellationToken) {
        var alerts = await Notifications
            .ListMentionedMemberAlerts(Session, Entry.Id, cancellationToken)
            .ConfigureAwait(false);
        var alertable = alerts
            .Where(a => a is { IsNotified: false, IsRead: false })
            .Select(a => a.AuthorId)
            .ToApiArray();
        return alertable.Count == 0 ? Model.None : new(true, alertable);
    }

    private Task OnClick() {
        var alertable = State.Value.AlertableAuthorIds;
        if (alertable.Count == 0)
            return Task.CompletedTask;

        var command = new Notifications_NotifyMentionedMembers {
            Session = Session,
            ChatEntryId = Entry.Id,
            AuthorIds = alertable,
        };
        return UICommander.Run(command);
    }

    // Nested types

    public sealed record Model(bool CanAlert, ApiArray<AuthorId> AlertableAuthorIds) {
        public static readonly Model None = new(false, default);
    }
}
