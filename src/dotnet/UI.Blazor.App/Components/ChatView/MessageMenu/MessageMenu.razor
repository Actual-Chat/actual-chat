@namespace ActualChat.UI.Blazor.App.Components
@inherits ComputedMenuBase<AppUIHub, MessageMenu.Model>
@{
    if (State.Value == Model.None)
        return;
}
@if (State.Value.Message is { } m) {
    <MessageMenuContent
        ChatEntry="m.ChatEntry"
        ClickedLinkUrl="@m.Link"
        ClickedCode="@m.Code"
        ClickedImageUrl="@m.ImageUrl"
        IsOwnEntry="m.IsOwnEntry"
        IsOwner="m.IsOwner"
        IsPeerChat="m.IsPeerChat"
        CanWrite="m.CanWrite"
        IsSystem="m.IsSystem">
    </MessageMenuContent>
}
@if (State.Value.SendingMessage is { } m2) {
    <SendingMessageMenuContent
        ChatEntry="@m2.ChatEntry" />
}

@code {
    private string? _link;
    private string? _code;
    private string? _imageUrl;
    private bool _isSystem;
    private string _clientEntryId = "";

    private IChats Chats => Hub.Chats;
    private IAuthors Authors => Hub.Authors;
    private SendingMessages SendingMessages => Hub.SendingMessages;

    protected override void OnParametersSet() {
        if (Arguments is not [ var sClientEntryId, var sIsSystem, var link, var code, .. ])
            throw new ArgumentOutOfRangeException(nameof(Arguments));

        _isSystem = bool.Parse(sIsSystem);
        _clientEntryId = sClientEntryId;
        _link = link.NullIfEmpty();
        _code = code.NullIfEmpty();
        _imageUrl = (Arguments.Length > 4 ? Arguments[4] : "").NullIfEmpty();
    }

    protected override ComputedState<Model>.Options GetStateOptions()
        => ComputedStateComponent.GetStateOptions(GetType(),
            static t => new ComputedState<Model>.Options() {
                InitialValue = Model.None,
                Category = GetStateCategory(t),
            });

    protected override async Task<Model> ComputeState(CancellationToken cancellationToken) {
        var isSystem = _isSystem;
        var clientEntryId = _clientEntryId;
        var link = _link;
        var code = _code;
        var imageUrl = _imageUrl;

        if (ChatEntryId.TryParse(clientEntryId, out var entryId)) {
            var chatEntry = await Chats.GetEntry(Session, entryId, CancellationToken.None).ConfigureAwait(false);
            if (chatEntry == null)
                return Model.None;

            return await CreateMessageModel(chatEntry);
        }

        var (chatEntry2, isSending) = await GetSendingChatEntry(clientEntryId);
        if (chatEntry2 is null)
            return Model.None;

        if (isSending)
            return new Model {
                SendingMessage = new SendingMessageModel {
                    ChatEntry = chatEntry2,
                },
            };

        return await CreateMessageModel(chatEntry2);

        async Task<Model> CreateMessageModel(ChatEntry chatEntry)
        {
            var requestAuthor = await Authors.GetOwn(Session, chatEntry.ChatId, CancellationToken.None).ConfigureAwait(false);
            var rules = await Chats.GetRules(Session, chatEntry.ChatId, cancellationToken).ConfigureAwait(false);

            var messageModel = new MessageModel() {
                Link = link,
                IsSystem = isSystem,
                Code = code,
                ImageUrl = imageUrl,
                ChatEntry = chatEntry,
                CanWrite = rules.CanWrite(),
                IsOwner = rules.IsOwner(),
                IsPeerChat = chatEntry.ChatId.Kind == ChatKind.Peer,
                IsOwnEntry = requestAuthor != null && requestAuthor.Id == chatEntry.AuthorId,
            };
            return new Model { Message = messageModel };
        }
    }

    private async Task<(ChatEntry?, bool)> GetSendingChatEntry(string clientEntryId) {
        var chatEntry = SendingMessages.TryGetChatEntryByClientId(clientEntryId);
        if (chatEntry is null)
            return (null, false);

        var sendingMessage = chatEntry.GetSendingMessage();
        if (sendingMessage is null)
            return (null, false);

        var chatSendingMessages = SendingMessages.GetSendingMessages(sendingMessage.ChatId);
        var isSending = await chatSendingMessages.IsSending(sendingMessage);
        return (chatEntry, isSending);
    }

    // Nested types

    public sealed record Model {
        public static readonly Model None = new();

        public MessageModel? Message { get; init; }
        public SendingMessageModel? SendingMessage { get; init; }
    }

    public sealed record MessageModel {
        public string? Link { get; init; }
        public bool IsSystem { get; init; }
        public string? Code { get; set; }
        public string? ImageUrl { get; init; }
        public bool IsOwnEntry { get; init; }
        public bool CanWrite { get; init; }
        public bool IsOwner { get; init; }
        public bool IsPeerChat { get; init; }
        public ChatEntry ChatEntry { get; init; } = null!;
    }

    public sealed record SendingMessageModel {
        public ChatEntry ChatEntry { get; init; } = null!;
    }
}
