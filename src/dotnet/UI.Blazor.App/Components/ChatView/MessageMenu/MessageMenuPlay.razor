@namespace ActualChat.UI.Blazor.App.Components
@inherits ComputedStateComponent<AppUIHub, MessageMenuPlay.Model>
@{
    var m = State.Value;
    var canPlay = m.CanPlay;
}

@if (canPlay) {
    @if (IsMenu) {
        <MenuEntry
            Icon="icon-play-fill"
            Class="important-item"
            Text="@L.MessageMenu_Play"
            Click="@OnPlay"
            MustKeepAwake="true">
        </MenuEntry>
    } else {
        <ButtonRound
            Class="play-btn btn-transparent btn-xs"
            Tooltip="@L.MessageMenu_Play"
            TooltipPosition="FloatingPosition.Top"
            Click="@OnPlay"
            MustKeepAwake="true">
            <i class="icon-play-fill text-xl text-primary"></i>
        </ButtonRound>
    }
} else {
    @if (IsMenu) {
        <MenuEntry
            Icon="icon-stop-fill"
            Class="important-item"
            Text="@L.Common_Stop"
            Click="@OnStop">
        </MenuEntry>
    } else {
        <ButtonRound
            Click="OnStop"
            Class="play-btn btn-xs btn-transparent"
            Tooltip="@L.Common_Stop"
            TooltipPosition="FloatingPosition.Top">
            <i class="icon-stop-fill text-xl text-primary"></i>
        </ButtonRound>
    }
}

@code {
    private IChats Chats => Hub.Chats;
    private ChatAudioUI ChatAudioUI => Hub.ChatAudioUI;

    [Parameter] public ChatEntry Entry { get; set; } = null!;
    [Parameter] public bool IsMenu { get; set; }

    private ILogger Log => field ??= Services.LogFor(GetType());

    protected override ComputedState<Model>.Options GetStateOptions()
        => ComputedStateComponent.GetStateOptions(GetType(),
            static t => new ComputedState<Model>.Options() {
                InitialValue = Model.NotPlaying,
                UpdateDelayer = FixedDelayer.NextTick,
                Category = GetStateCategory(t),
            });

    protected override async Task<Model> ComputeState(CancellationToken cancellationToken) {
        var replayState = await ChatAudioUI.ReplayState.Use(cancellationToken).ConfigureAwait(false);
        if (replayState is not { ChatId: var chatId })
            return Model.NotPlaying;

        var player = await ChatAudioUI.GetReplayPlayer(chatId, cancellationToken).ConfigureAwait(false);
        var lastState = State.Value;
        if (player is null) {
            // This happens when player is being disposed, which means this method
            // will soon recompute anyway.
            return lastState; // Keep the last state to avoid blinking
        }
        var isPaused = await player.Playback.IsPaused.Use(cancellationToken).ConfigureAwait(false);
        var playingTracks = await player.Playback.PlayingTracks.Use(cancellationToken).ConfigureAwait(false);
        Moment? playingAt = null;
        var canPlay = true;
        foreach (var playingTrack in playingTracks) {
            var trackInfo = playingTrack.TrackInfo;
            if (trackInfo is ChatAudioTrackInfo { AudioEntry: { } audioEntry }) {
                if (audioEntry.ChatId != Entry.ChatId)
                    continue;
                if (audioEntry.LocalId == Entry.LocalId) {
                    if (isPaused || playingTrack.State.IsStarted)
                        canPlay = false;
                }
            }
        }
        if (!playingAt.HasValue && !ReferenceEquals(lastState, Model.NotPlaying)) {
            // Try to keep the last state to avoid blinking
            if (lastState.CanPlay == canPlay)
                return lastState;
        }

        return new() {
            CanPlay = canPlay,
        };
    }

    private Task OnStop() {
        ChatAudioUI.StopReplay();
        return Task.CompletedTask;
    }

    private Task OnPlay() {
        var entry = Entry;
        var chatId = entry.ChatId;
        var startAt = entry.BeginsAt;
        return Hub.ChatAudioUI.StartReplay(chatId, startAt);
    }

    // Nested types

    public sealed record Model
    {
        public static readonly Model NotPlaying = new();

        public bool CanPlay { get; init; } = true;
    }
}
