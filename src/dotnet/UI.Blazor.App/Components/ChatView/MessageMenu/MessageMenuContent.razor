@namespace ActualChat.UI.Blazor.App.Components
@inherits ComponentBase<AppUIHub>
@{
    var e = ChatEntry;
    var hasSelection = SelectionUI.HasSelection.Value;
    var isSelected = SelectionUI.IsSelected(e.Id);
    var isForwarded = e.Forwarded is not null;
    var showPlayButton = ScreenSize.IsNarrow() && e.HasAudio && !hasSelection;
    var isTextEntry = !e.IsContentStreaming;
    var canDelete = CanWrite && (IsOwnEntry || CanModerate || IsPeerChat) && isTextEntry && !hasSelection;
    var canEdit = CanWrite && IsOwnEntry && isTextEntry && !isForwarded && !hasSelection;
    var messageLink = Links.Chat(e.Id).ToAbsolute(UrlMapper);
    var canReply = !e.IsContentStreaming && CanWrite && !IsSystem;
    var canCopyText = isTextEntry && !e.Content.IsNullOrEmpty();
    var canCopyLink = !ClickedLinkUrl.IsNullOrEmpty();
    var canCopyCode = !ClickedCode.IsNullOrEmpty();
    var canCopyImage = !ClickedImageUrl.IsNullOrEmpty();
    var canCopyMessageLink = !IsSystem;
    var attachmentCount = e.Attachments.Length;
    var canDownloadAttachments = attachmentCount > 0 && !hasSelection;
    var canForward = !e.IsContentStreaming && !IsSystem && !hasSelection;
    var canStartThread = !e.IsContentStreaming && !IsSystem && !hasSelection;
    var canPin = CanPin && isTextEntry && !IsSystem && !hasSelection;
    // Selection
    var canSelect = !e.IsContentStreaming && !IsSystem && !isSelected;
    var canUnselect = isSelected;
}

@if (_showAllReactions) {
    <div class="message-menu">
        <div class="reactions-menu no-scrollbar">
            @foreach (var group in Enum.GetValues<EmojiGroup>()) {
                <div @key="group" class="reactions-menu-group">
                    <div class="reactions-menu-group-items">
                        @foreach (var emoji in Emojis.GetByGroup(group)) {
                            <MenuEntry @key="emoji"
                                Class="reactions-menu-item"
                                Click="@(_ => React(emoji))">
                                <IconContent>
                                    <EmojiIcon Emoji="@emoji" Class="reactions-menu-emoji"/>
                                </IconContent>
                            </MenuEntry>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
} else {
    <div class="message-menu">
        <ReactionSelect Entry="@e" OnExpandClick="ShowAllReactions"/>
        @if (showPlayButton) {
            <MessageMenuPlay Entry="@e" IsMenu="true"/>
        }
        @if (canEdit) {
            <MenuEntry
                Icon="icon-edit"
                Class="important-item"
                FocusOnEditor="true"
                Text="@L.Common_Edit"
                Click="@(() => ChatEditorUI.Edit(e))">
            </MenuEntry>
        }
        @if (canReply) {
            <MenuEntry
                Icon="icon-reply"
                FocusOnEditor="true"
                Text="@L.MessageMenu_Reply"
                Click="@Reply">
            </MenuEntry>
        }
        @if (canCopyText) {
            <MenuEntry
                Icon="icon-copy"
                Text="@L.MessageMenu_CopyText"
                Click="@(() => SelectionUI.CopyToClipboard(e.Id))">
            </MenuEntry>
        }
        @if (canCopyLink) {
            <CopyTrigger Tooltip="" CopyText="@ClickedLinkUrl" Class="ac-menu-item !p-0">
                <MenuEntry
                    Icon="icon-copy"
                    Text="@L.MessageMenu_CopyLink">
                </MenuEntry>
            </CopyTrigger>
        }
        @if (canCopyCode) {
            <CopyTrigger Tooltip="" CopyText="@ClickedCode?.Trim()" Class="ac-menu-item !p-0">
                <MenuEntry
                    Icon="icon-copy"
                    Text="@L.MessageMenu_CopyCode">
                </MenuEntry>
            </CopyTrigger>
        }
        @if (canCopyImage) {
            <MenuEntry
                Icon="icon-copy"
                Text="@L.MessageMenu_CopyImage"
                Click="@(() => Hub.ClipboardUI.WriteImage(ClickedImageUrl!))">
            </MenuEntry>
        }
        @if (canCopyMessageLink) {
            <CopyTrigger Tooltip="" CopyText="@messageLink" Class="ac-menu-item !p-0">
                <MenuEntry
                    Icon="icon-link-2"
                    Text="@L.MessageMenu_CopyMessageLink">
                </MenuEntry>
            </CopyTrigger>
        }
        @if (canDownloadAttachments) {
            <MenuEntry
                Icon="icon-download"
                Text="@(attachmentCount > 1 ? L.MessageMenu_DownloadAll : L.MessageMenu_Download)"
                Click="@DownloadAttachments">
            </MenuEntry>
        }
        @if (canForward) {
            <MenuEntry
                Icon="icon-share"
                Text="@L.MessageMenu_Forward"
                Click="@(() => SelectionUI.Forward(e.Id))">
            </MenuEntry>
        }
        @if (canStartThread) {
            <MenuEntry
                Icon="icon-conversation"
                Text="@L.MessageMenu_StartThread"
                Click="@(() => SelectionUI.StartThread(e.Id))">
            </MenuEntry>
        }
        @if (canPin) {
            <MenuEntry
                Icon="@(IsPinned ? "icon-unpin" : "icon-pin")"
                Text="@(IsPinned ? L.MessageMenu_UnpinMessage : L.MessageMenu_PinMessage)"
                Click="@Pin">
            </MenuEntry>
        }
        @if (canDelete) {
            <MenuEntry
                Class="warning-item"
                Icon="icon-trash03"
                Text="@L.MessageMenu_DeleteMessage"
                Click="@(() => SelectionUI.Delete(e.Id))">
            </MenuEntry>
        }
        @if (canSelect || canUnselect) {
            <MenuEntrySeparator/>
        }
        @if (canUnselect) {
            <MenuEntry
                Icon="icon-copy"
                Text="@L.MessageMenu_CopySelection"
                Click="@(() => SelectionUI.CopyToClipboard())">
            </MenuEntry>
            <MenuEntry
                Icon="icon-share"
                Text="@L.MessageMenu_ForwardSelection"
                Click="@(() => SelectionUI.Forward())">
            </MenuEntry>
            <MenuEntry
                Icon="icon-conversation"
                Text="@L.MessageMenu_StartThread"
                Click="@(() => SelectionUI.StartThread())">
            </MenuEntry>
            <MenuEntry
                Icon="icon-trash03"
                Text="@L.MessageMenu_ClearSelection"
                Click="@(() => SelectionUI.Clear())">
            </MenuEntry>
            <MenuEntrySeparator/>
            <MenuEntry
                Icon="icon-select"
                Text="@L.MessageMenu_Unselect"
                Click="@(() => SelectionUI.Unselect(e.Id))">
            </MenuEntry>
        }
        @if (canSelect) {
            <MenuEntry
                Icon="icon-select"
                Text="@L.MessageMenu_Select"
                Click="@(() => SelectionUI.Select(e.Id))">
            </MenuEntry>
        }
    </div>
}

@code {
    private bool _showAllReactions;

    private SelectionUI SelectionUI => Hub.SelectionUI;
    private ChatEditorUI ChatEditorUI => Hub.ChatEditorUI;
    private ChatPinsUI ChatPinsUI => Hub.ChatPinsUI;
    private FileDownloadUI FileDownloadUI => Hub.FileDownloadUI;
    private OptimisticReactions OptimisticReactions => Hub.OptimisticReactions;

    [CascadingParameter] public ScreenSize ScreenSize { get; set; }
    [Parameter, EditorRequired] public ChatEntry ChatEntry { get; set; } = null!;
    [Parameter, EditorRequired] public string? ClickedLinkUrl { get; set; }
    [Parameter, EditorRequired] public string? ClickedCode { get; set; }
    [Parameter, EditorRequired] public string? ClickedImageUrl { get; set; }
    [Parameter, EditorRequired] public bool IsSystem { get; set; }
    [Parameter, EditorRequired] public bool IsOwnEntry { get; set; }
    [Parameter, EditorRequired] public bool CanModerate { get; set; }
    [Parameter, EditorRequired] public bool IsPeerChat { get; set; }
    [Parameter, EditorRequired] public bool CanWrite { get; set; }
    [Parameter, EditorRequired] public bool CanPin { get; set; }
    [Parameter, EditorRequired] public bool IsPinned { get; set; }

    private Task Reply()
        => ChatEditorUI.ShowRelatedEntry(RelatedEntryKind.Reply, ChatEntry.Id, focusOnEditor: true);

    private Task Pin()
        => IsPinned ? ChatPinsUI.Unpin(ChatEntry.Id) : ChatPinsUI.Pin(ChatEntry.Id);

    private async Task DownloadAttachments() {
        var attachments = ChatEntry.Attachments;
        foreach (var attachment in attachments) {
            var media = attachment.Media;
            await FileDownloadUI.Download(media.BlobId, media.FileName, media.ContentType).ConfigureAwait(false);
        }
    }

    private void ShowAllReactions()
        => _showAllReactions = true;

    private async Task React(Emoji emoji) {
        _ = TuneUI.Play(Tune.React);
        OptimisticReactions.AddPendingAnimation(ChatEntry.Id.Value, emoji.Id.Value);
        OptimisticReactions.Set(ChatEntry.Id, emoji, false);
        var reaction = new Reaction {
            Id = Symbol.Empty,
            AuthorId = null!,
            EntryId = ChatEntry.Id,
            Emoji = emoji,
        };
        _ = Hub.UserSettingsUI.UserReactionSettings().Update(s => s.WithBubbleUp(emoji.Id.Value));
        await UICommander.Run(new Reactions_React { Session = Session, Reaction = reaction });
    }
}
