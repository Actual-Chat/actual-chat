@namespace ActualChat.UI.Blazor.App.Components
@inherits FusionComponentBase<AppUIHub>
@{
    var e = ChatEntry;
    var hasSelection = SelectionUI.HasSelection.Value;
    var isForwarded = e.Forwarded is not null;
    var isTextEntry = !e.IsContentStreaming;
    var canEdit = isTextEntry && !isForwarded && !hasSelection && !e.HasUploadingAttachments;
    var canCopyText = isTextEntry && !e.Content.IsNullOrEmpty();
}

@if (canCopyText) {
    <MenuEntry
        Icon="icon-copy"
        Text="@L.MessageMenu_CopyText"
        Click="@(() => SelectionUI.CopyToClipboard(e))">
    </MenuEntry>
}
@if (canEdit) {
    <MenuEntry
        Icon="icon-edit"
        FocusOnEditor="true"
        Text="@L.Common_Edit"
        Click="@(() => ChatEditorUI.Edit(e))">
    </MenuEntry>
}
<MenuEntry
    Icon="icon-stop-fill"
    FocusOnEditor="true"
    Text="@L.MessageMenu_CancelSend"
    Click="@(() => SendingMessages.Cancel(e.GetSendingMessage()!))">
</MenuEntry>

@code {
    private SelectionUI SelectionUI => Hub.SelectionUI;
    private ChatEditorUI ChatEditorUI => Hub.ChatEditorUI;
    private SendingMessages SendingMessages => Hub.SendingMessages;

    [Parameter, EditorRequired] public ChatEntry ChatEntry { get; set; } = null!;
}
