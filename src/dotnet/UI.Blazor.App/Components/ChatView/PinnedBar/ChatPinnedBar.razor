@namespace ActualChat.UI.Blazor.App.Components
@inherits ComputedStateComponent<AppUIHub, ChatPinnedBar.Model>
@{
    var m = State.Value;
    if (m.Entries.Count == 0)
        return;

    var count = m.Entries.Count;
    var index = m.Index;
    var entry = m.Entries[index];
    var pin = m.Pins[index];
    var isManageable = pin.IsPersonal || (pin.IsShared && m.CanPinForEveryone);
    // Telegram-style: at most MaxSegmentCount segments, the window slides to keep the active one visible.
    var segmentCount = Math.Min(count, MaxSegmentCount);
    var firstSegment = Math.Clamp(index - 1, 0, count - segmentCount);
    var markupHub = ChatMarkupHubFactory[Chat.Id];
    var text = markupHub.GetMarkup(entry, MarkupConsumer.QuoteView).ToReadableText(MarkupConsumer.QuoteView);
    var menuRef = MenuRef.New<ChatPinnedBarMenu>(entry.Id.Value).ToString();
}

<div class="pinned-bar">
    <button type="button" class="c-cycle" @onclick="OnBarClick">
        <div class="c-indicator">
            @for (var i = firstSegment; i < firstSegment + segmentCount; i++) {
                <span class="c-seg @(i == index ? "active" : "")"></span>
            }
        </div>
        <div class="c-text">@text</div>
    </button>
    @if (isManageable) {
        <HeaderButton
            Class="c-pin-btn btn-sm"
            data-menu="@menuRef"
            data-menu-trigger="@MenuTrigger.Primary"
            data-menu-placement="@(FloatingPosition.BottomEnd.ToPositionString())">
            <i class="icon-pin"></i>
        </HeaderButton>
    }
    else {
        <i class="c-pin-icon icon-pin"></i>
    }
</div>

@code {
    private const int MaxSegmentCount = 4;

    // Reactive cursor: ComputeState reads it via .Use(), so advancing it recomputes the model
    // and reliably re-renders the bar (a plain field wouldn't drive a ComputedStateComponent render).
    private MutableState<int> _cursor = null!;

    private IChats Chats => Hub.Chats;
    private ChatPinsUI ChatPinsUI => Hub.ChatPinsUI;
    private ChatUI ChatUI => Hub.ChatUI;
    private ChatVideoUI ChatVideoUI => Hub.ChatVideoUI;
    private KeyedFactory<IChatMarkupHub, ChatId> ChatMarkupHubFactory => Hub.ChatMarkupHubFactory;

    [Parameter, EditorRequired] public Chat Chat { get; set; } = null!;

    protected override void OnInitialized()
        => _cursor = StateFactory.NewMutable(0, StateCategories.Get(GetType(), nameof(_cursor)));

    protected override ComputedState<Model>.Options GetStateOptions()
        => ComputedStateComponent.GetStateOptions(GetType(),
            static t => new ComputedState<Model>.Options() {
                InitialValue = Model.None,
                Category = GetStateCategory(t),
            });

    protected override async Task<Model> ComputeState(CancellationToken cancellationToken) {
        var chatId = Chat.Id;
        // Hide the bar while a live video is shown in this chat so it doesn't eat vertical space.
        if (await ChatVideoUI.IsWatching(chatId, cancellationToken).ConfigureAwait(false))
            return Model.None;

        var allPins = await ChatPinsUI.List(chatId, cancellationToken).ConfigureAwait(false);
        if (allPins.Count == 0)
            return Model.None;

        var entries = new List<ChatEntry>(allPins.Count);
        var pins = new List<ChatPin>(allPins.Count);
        foreach (var pin in allPins) {
            var entry = await Chats.GetEntry(Session, pin.EntryId, cancellationToken).ConfigureAwait(false);
            if (entry is not { IsRemoved: false })
                continue;

            entries.Add(entry);
            pins.Add(pin);
        }
        if (entries.Count == 0)
            return Model.None;

        var canPinForEveryone = await ChatPinsUI.CanPinForEveryone(chatId, cancellationToken).ConfigureAwait(false);
        var cursor = await _cursor.Use(cancellationToken).ConfigureAwait(false);
        var index = ((cursor % entries.Count) + entries.Count) % entries.Count;
        return new Model {
            Entries = entries.ToApiArray(),
            Pins = pins.ToApiArray(),
            Index = index,
            CanPinForEveryone = canPinForEveryone,
        };
    }

    private void OnBarClick() {
        var m = State.Value;
        if (m.Entries.Count == 0)
            return;

        ChatUI.HighlightEntry(m.Entries[m.Index].Id, navigate: true);
        _cursor.Value = m.Index + 1; // Cycle to the next pin.
    }

    public sealed record Model {
        public static readonly Model None = new();
        public ApiArray<ChatEntry> Entries { get; init; }
        public ApiArray<ChatPin> Pins { get; init; }
        public int Index { get; init; }
        public bool CanPinForEveryone { get; init; }
    }
}
