@namespace ActualChat.UI.Blazor.App.Components
@inherits ComponentBase<AppUIHub>
@implements IModalView<PinMessageModal.Model>
@{
    var label = ModalModel.PeerName is { } peerName
        ? L.Pin_AlsoForPeer_Format(peerName)
        : L.Pin_AlsoForEveryone;
}

<DialogFrame Title="@L.MessageMenu_PinMessage" Class="pin-message-modal compact-header modal-sm">
    <Body>
    <FormBlock>
        @* Checkbox cancels its own click, so the toggle belongs to the element around it *@
        <div class="c-for-everyone" @onclick="@(() => _isForEveryone = !_isForEveryone)">
            <Checkbox
                Label="@label"
                IsChecked="@_isForEveryone"/>
        </div>
    </FormBlock>
    </Body>
    <Buttons>
        <Button Class="btn-modal" Click="OnCancel">@L.Common_Cancel</Button>
        <Button Class="btn-modal btn-primary" Click="OnPin">@L.ChatMenu_Pin</Button>
    </Buttons>
</DialogFrame>

@code {
    private bool _isForEveryone = true;

    [CascadingParameter] public Modal Modal { get; set; } = null!;
    [Parameter] public Model ModalModel { get; set; } = null!;

    // Private methods

    private void OnCancel()
        => Modal.Close();

    private void OnPin() {
        Modal.Close();
        _ = Hub.ChatPinsUI.Pin(ModalModel.EntryId, _isForEveryone);
    }

    // Nested types

    public sealed record Model(ChatEntryId EntryId, string? PeerName);
}
