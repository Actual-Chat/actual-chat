@namespace ActualChat.UI.Blazor.App.Components
@inherits ComponentBase<AppUIHub>
@implements IModalView<AppReviewModal.Model>
@implements IDisposable

<DialogFrame Class="app-review-modal modal-sm" HasHeader="false">
    <Body>
    <div class="c-app-review">
        @switch (_step) {
            case Step.OpeningRequest:
                <Kitty Name="app-review-small-team-kittens"/>
                <p class="c-text">@L.AppReview_Pitch</p>
                <div class="c-actions">
                    <Button Class="btn-primary btn-w-full" IsDisabled="@_isBusy" Click="@LeaveReview">
                        @L.AppReview_LeaveReview
                    </Button>
                    <Button Class="btn-transparent btn-w-full" Click="@(() => SetStep(Step.AreYouSure))">
                        @L.AppReview_MaybeLater
                    </Button>
                </div>
                break;
            case Step.ThankYou:
                <Kitty Name="app-review-happy-thank-you"/>
                <p class="c-title">@L.AppReview_ThankYou</p>
                <p class="c-text">@L.AppReview_ThankYouText</p>
                <div class="c-actions">
                    <Button Class="btn-primary btn-w-full" Click="@(() => Modal.Close())">@L.AppReview_Done</Button>
                </div>
                break;
            case Step.AreYouSure:
                <Kitty Name="app-review-big-eyes-pleading"/>
                <p class="c-title">@L.AppReview_AreYouSure</p>
                <p class="c-text">@L.AppReview_AreYouSureText</p>
                <div class="c-actions">
                    <Button Class="btn-primary btn-w-full" IsDisabled="@_isBusy" Click="@LeaveReview">
                        @L.AppReview_LeaveReview
                    </Button>
                    <Button Class="btn-modal btn-w-full" Click="@InviteFriends">
                        @L.AppReview_InviteFriends
                    </Button>
                    <Button Class="btn-transparent btn-w-full" Click="@Decline">
                        @L.AppReview_NotRightNow
                    </Button>
                </div>
                break;
            case Step.Farewell:
                <Kitty Name="app-review-sad-farewell"/>
                <p class="c-text">@L.AppReview_FarewellText</p>
                <div class="c-actions">
                    <Button Class="btn-primary btn-w-full" Click="@(() => Modal.Close())">@L.Common_Close</Button>
                </div>
                break;
        }
    </div>
    </Body>
</DialogFrame>

@code {
    private Step _step = Step.OpeningRequest;
    private bool _isBusy;
    private ReviewPromptOutcome _outcome = ReviewPromptOutcome.Dismissed;

    private AppReviewUI AppReviewUI => Hub.AppReviewUI;

    [CascadingParameter] public Modal Modal { get; set; } = null!;
    [Parameter] public Model ModalModel { get; set; } = null!;

    public void Dispose()
        => ModalModel.OnOutcome?.Invoke(_outcome);

    private void SetStep(Step step)
        => _step = step;

    private void Decline() {
        _outcome = ReviewPromptOutcome.Declined;
        _step = Step.Farewell;
    }

    private async Task LeaveReview() {
        if (_isBusy)
            return;

        _isBusy = true;
        try {
            var outcome = await AppReviewUI.LeaveReview();
            _outcome = outcome switch {
                AppReviewOutcome.Completed => ReviewPromptOutcome.Reviewed,
                AppReviewOutcome.Requested => ReviewPromptOutcome.Asked,
                _ => ReviewPromptOutcome.Dismissed,
            };
            _step = outcome == AppReviewOutcome.Cancelled ? Step.Farewell : Step.ThankYou;
        }
        finally {
            _isBusy = false;
        }
    }

    private async Task InviteFriends() {
        Modal.Close();
        await Hub.ShareUI.ShareOwnAccount();
    }

    // Nested types

    public enum Step { OpeningRequest, ThankYou, AreYouSure, Farewell }

    public sealed record Model(Action<ReviewPromptOutcome>? OnOutcome = null);
}
