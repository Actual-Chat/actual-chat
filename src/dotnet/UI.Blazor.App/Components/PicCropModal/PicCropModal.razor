@using ActualChat.Media
@using ActualChat.Users
@using ActualChat.UI.Blazor.App.Module
@namespace ActualChat.UI.Blazor.App.Components
@inherits ComponentBase<AppUIHub>
@implements IModalView<PicCropModal.Model>
@implements IAsyncDisposable

<DialogFrame
    Class="@("pic-crop-modal fixed-height"
        + (ModalModel.IsSquare ? " square" : "")
        + (ModalModel.HasBlur ? " has-blur" : "")
        + (_hasSource ? "" : " empty")
        + (IsMarbleState ? " marble" : "")
        + (_isSaving ? " saving" : ""))"
    Title="@Title"
    NarrowViewSettings="@DialogFrameNarrowViewSettings.Default"
    BodyClass="no-scrollbar"
    HasCloseButton="true">
    <Body>
        @if (_hasError) {
            <div class="c-error">
                <i class="icon-warning text-2xl"></i>
                <span>@L.PicCrop_LoadFailed</span>
            </div>
        } else {
            <div class="c-crop">
                <div class="c-content">
                    <div class="c-canvas-container">
                        @if (IsMarbleState) {
                            <div class="c-marble">@GeneratedAvatar</div>
                        }
                        <canvas @ref="_canvasRef" width="400"
                                height="@(ModalModel.ViewportAspectRatio > 0 ? (int)(400 / ModalModel.ViewportAspectRatio) : 400)"></canvas>
                        <div class="c-angle" hidden></div>
                        @if (IsMarbleState) {
                            <div class="c-hint">@L.PicCrop_MarbleHint</div>
                        } else if (!_hasSource) {
                            <div class="c-placeholder">
                                <i class="icon-image text-3xl"></i>
                                <span>@L.PicCrop_MarbleHint</span>
                            </div>
                        }
                        @if (_isGenerating) {
                            <div class="c-generating">
                                <Spinner/>
                            </div>
                        }
                    </div>
                </div>
                @* Wallpaper needs no size previews: its canvas is already a full-width, blurred WYSIWYG. *@
                @if (ModalModel.ViewportAspectRatio <= 0) {
                    <div class="c-preview">
                        <canvas width="48" height="48"></canvas>
                        <canvas width="40" height="40"></canvas>
                        <canvas width="32" height="32"></canvas>
                        @* The canvases stay in the DOM (JS captures them once); a marble has no crop source,
                           so it's shown as its own elements and the empty canvases are hidden via CSS. *@
                        @if (IsMarbleState) {
                            <div class="c-marble-preview w-[48px] h-[48px]">@GeneratedAvatar</div>
                            <div class="c-marble-preview w-[40px] h-[40px]">@GeneratedAvatar</div>
                            <div class="c-marble-preview w-[32px] h-[32px]">@GeneratedAvatar</div>
                        }
                    </div>
                }
            </div>
            <div class="c-actions-row">
                <Button Class="@($"btn-outline {ActionBtnSize}")" Click="@OnOpenGeneration" IsDisabled="@(_isSaving || _isGenerating)">
                    <i class="icon-ai-stars text-lg"></i>
                    <span>@L.PicCrop_Create</span>
                </Button>
                <Button Class="@($"btn-outline {ActionBtnSize}")" Click="@OnUploadClick" IsDisabled="@_isSaving">
                    <i class="icon-upload text-lg"></i>
                    <span>@L.PicCrop_Upload</span>
                </Button>
            </div>
            <div class="c-controls">
                <div class="c-tools-row">
                    <ButtonRound Class="btn-rotate-ccw btn-sm" Tooltip="@L.PicCrop_RotateLeft" IsDisabled="@(!_hasSource || _isSaving)">
                        <i class="icon-refresh text-xl c-flip"></i>
                    </ButtonRound>
                    <ButtonRound Class="btn-rotate-cw btn-sm" Tooltip="@L.PicCrop_RotateRight" IsDisabled="@(!_hasSource || _isSaving)">
                        <i class="icon-refresh text-xl"></i>
                    </ButtonRound>
                    <ButtonRound Class="btn-mirror btn-sm" Click="@OnMirror" Tooltip="@L.PicCrop_Mirror" IsDisabled="@(!_hasSource || _isSaving)">
                        <i class="icon-mirror-video text-xl"></i>
                    </ButtonRound>
                    <ButtonRound Class="btn-reset btn-sm" Click="@OnReset" Tooltip="@L.PicCrop_Reset" IsDisabled="@(!_hasSource || _isSaving)">
                        <i class="icon-sync text-xl"></i>
                    </ButtonRound>
                    <ButtonRound Class="btn-revert btn-sm" Click="@OnRevert" Tooltip="@L.PicCrop_RevertPrevious" IsDisabled="@(!_hasSource || _isSaving)">
                        <i class="icon-forward text-xl c-flip"></i>
                    </ButtonRound>
                </div>
                <div class="c-labeled-slider">
                    <div class="c-slider">
                        <div class="c-track"></div>
                        <div class="c-fill"></div>
                        <div class="c-thumb"></div>
                        <input type="range" class="zoom-range dialog-unstyled" min="100" max="400" step="1" value="100"
                               disabled="@(!_hasSource || _isSaving)" />
                    </div>
                    <span class="c-slider-label">@L.PicCrop_Zoom</span>
                </div>
                @if (ModalModel.HasBlur) {
                    <div class="c-labeled-slider">
                        <div class="c-slider">
                            <div class="c-track"></div>
                            <div class="c-fill"></div>
                            <div class="c-thumb"></div>
                            <input type="range" class="blur-range dialog-unstyled" min="0" max="16" step="1" value="0" />
                        </div>
                        <span class="c-slider-label">@L.PicCrop_Blur</span>
                    </div>
                }
                @if (_hasGenerationError) {
                    <div class="c-status c-generation-error">@L.PicCrop_GenerationFailed</div>
                }
            </div>
        }
        <input @ref="_fileInputRef" type="file" accept="image/*" @onchange="@OnFileSelected" hidden />
    </Body>
    <Buttons>
        <Button Class="btn-modal" Click="@OnCancel" IsDisabled="@_isSaving">@L.Common_Cancel</Button>
        <Button Class="btn-modal btn-primary" Click="@OnSave" IsDisabled="@(!_hasSource || _isSaving)">
            @if (_isSaving) {
                <Spinner/>
            } else {
                @L.Common_Save
            }
        </Button>
    </Buttons>
</DialogFrame>

@code {
    private static readonly string JSCreateMethod = $"{BlazorUIAppModule.ImportName}.PicCropModal.create";
    private static readonly string JSClickFileInput = $"{BlazorUIAppModule.ImportName}.clickFileInput";
    private static readonly string JSCreateBlobUrl = $"{BlazorUIAppModule.ImportName}.createBlobUrlFromInput";
    private static readonly string JSClearFileInput = $"{BlazorUIAppModule.ImportName}.clearFileInput";

    private FileUploader FileUploader => field ??= Services.GetRequiredService<FileUploader>();

    private string Title => ModalModel.Title.NullIfEmpty()
        ?? (ModalModel.HasBlur
            ? L.PicCrop_WallpaperTitle
            : ModalModel.IsSquare ? L.PicCrop_PlaceAvatarTitle : L.PicCrop_AvatarTitle);

    private ElementReference _canvasRef;
    private ElementReference _fileInputRef;
    private IJSObjectReference? _jsRef;
    private DotNetObjectReference<PicCropModal>? _blazorRef;
    private CancellationTokenSource? _saveCts;
    private bool _hasError;
    private bool _hasSource;
    private bool _isSaving;
    private CancellationTokenSource? _generateCts;
    private bool _isGenerating;
    private bool _hasGenerationError;
    private string _description = "";
    private ImageStyle? _style;
    private MediaId? _generatedMediaId;
    private string _avatarKey = "";

    // A generated avatar (marble/beam) is showing and there's nothing to crop.
    private bool IsMarbleState => !_avatarKey.IsNullOrEmpty() && !_hasSource && !ModalModel.HasBlur;

    private RenderFragment GeneratedAvatar => @<text>
        @if (ModalModel.AvatarKind == AvatarKind.Marble) {
            <marble-avatar key="@_avatarKey" title="@ModalModel.AvatarTitle"></marble-avatar>
        } else {
            <beam-avatar key="@_avatarKey"></beam-avatar>
        }
    </text>;

    private string ActionBtnSize => ScreenSize.IsNarrow() ? "btn-sm" : "btn-md";

    [CascadingParameter] public Modal Modal { get; set; } = null!;
    [CascadingParameter] public ScreenSize ScreenSize { get; set; }
    [Parameter] public Model ModalModel { get; set; } = null!;

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (!firstRender)
            return;

        _blazorRef = DotNetObjectReference.Create(this);
        _jsRef = await JS.InvokeAsync<IJSObjectReference>(
            JSCreateMethod,
            _canvasRef,
            ModalModel.InitialImageUrl,
            _blazorRef,
            ModalModel.IsSquare,
            ModalModel.ViewportAspectRatio,
            ModalModel.HasBlur).ConfigureAwait(true);
    }

    public async ValueTask DisposeAsync() {
        _saveCts.CancelAndDisposeSilently();
        _saveCts = null;
        // Cancel first, or an in-flight generation lands after this and leaks the media it saved
        _generateCts.CancelAndDisposeSilently();
        _generateCts = null;
        if (_generatedMediaId is { } generatedMediaId) {
            _generatedMediaId = null;
            await RemoveMedia(generatedMediaId).SilentAwait(false);
        }
        if (_jsRef is { } jsRef) {
            _jsRef = null;
            await jsRef.DisposeSilentlyAsync("dispose");
        }
        _blazorRef?.Dispose();
        _blazorRef = null;
    }

    protected override void OnInitialized() {
        _description = ModalModel.Description;
        _style = ModalModel.Style;
        _avatarKey = ModalModel.AvatarKey;
    }

    private async Task OnUploadClick() {
        if (_jsRef is null)
            return;

        await JS.InvokeVoidAsync(JSClickFileInput, _fileInputRef).ConfigureAwait(true);
    }

    private async Task OnFileSelected() {
        var blobUrl = await JS.InvokeAsync<string?>(JSCreateBlobUrl, _fileInputRef).ConfigureAwait(true);
        await JS.InvokeVoidAsync(JSClearFileInput, _fileInputRef).ConfigureAwait(true);
        if (blobUrl is null || _jsRef is null)
            return;

        await _jsRef.InvokeVoidAsync("setImage", blobUrl, true).ConfigureAwait(true);
    }

    private async Task OnMirror() {
        if (_jsRef is { } jsRef)
            await jsRef.InvokeVoidAsync("mirror").ConfigureAwait(true);
    }

    private async Task OnReset() {
        if (_jsRef is { } jsRef)
            await jsRef.InvokeVoidAsync("reset").ConfigureAwait(true);
    }

    private async Task OnRevert() {
        if (_jsRef is { } jsRef)
            await jsRef.InvokeVoidAsync("revertToPrevious").ConfigureAwait(true);
    }

    private void OnCancel()
        => Modal.Close();

    private void OnOpenGeneration()
        => ModalUI.Show(new ImageGenerationModal.Model(_description, _style, OnGenerate));

    private void OnGenerate(string description, ImageStyle style) {
        _description = description;
        _style = style;
        _ = Generate(description, style);
    }

    private async Task Generate(string description, ImageStyle style) {
        if (_isGenerating)
            return;

        _isGenerating = true;
        _hasGenerationError = false;
        _generateCts = new CancellationTokenSource();
        var cancellationToken = _generateCts.Token;
        StateHasChanged();
        try {
            var command = new Media_Generate {
                Session = Session,
                Scope = ModalModel.Scope,
                Description = description,
                Style = style,
                Kind = ModalModel.MediaKind,
                IsBackground = ModalModel.HasBlur,
            };
            var (mediaRef, error) = await UICommander.Run(command, cancellationToken).ConfigureAwait(true);
            if (error != null || mediaRef is null) {
                _hasGenerationError = true;
                return;
            }

            var url = UrlMapper.ContentUrl(mediaRef.BlobId);
            if (_jsRef is { } jsRef)
                await jsRef.InvokeVoidAsync("setImage", url).ConfigureAwait(true);

            // Only now is the one it replaced certainly off screen. Anything the user accepts is a
            // fresh crop upload, so nothing here is ever what they keep.
            var replaced = _generatedMediaId;
            _generatedMediaId = mediaRef.MediaId;
            await RemoveMedia(replaced).ConfigureAwait(true);
        }
        catch (Exception e) when (!e.IsCancellationOf(cancellationToken)) {
            _hasGenerationError = true;
        }
        finally {
            _isGenerating = false;
            StateHasChanged();
        }
    }

    private async Task RemoveMedia(MediaId? mediaId) {
        if (mediaId is null)
            return;

        var command = new Media_RemoveMedia { Session = Session, MediaId = mediaId };
        await UICommander.Run(command).ConfigureAwait(true);
    }

    [JSInvokable("OnImageLoadError")]
    public void OnImageLoadError() {
        _hasError = true;
        StateHasChanged();
    }

    [JSInvokable("OnSourceChanged")]
    public void OnSourceChanged(bool hasSource) {
        _hasSource = hasSource;
        StateHasChanged();
    }

    private async Task OnSave() {
        if (_isSaving || !_hasSource)
            return;

        _isSaving = true;
        _saveCts = new CancellationTokenSource();
        var cancellationToken = _saveCts.Token;
        try {
            var exported = await _jsRef!.InvokeAsync<bool>("exportCrop", cancellationToken).ConfigureAwait(true);
            if (!exported) {
                UICommander.ShowError(StandardError.Upload.CropExportFailed());
                return;
            }

            // Upload the cropped blob via the standard pipeline
            var scope = ModalModel.Scope;
            var mediaId = await UICommander.Call(
                new Media_ReserveMedia { Session = Session, Scope = scope },
                cancellationToken);

            var tag = $"FileUpload/v1/{scope}";
            var metadata = new MetadataBag()
                .Set("FileName", "avatar-crop.png")
                .Set("ContentType", "image/png");
            var blobSize = await _jsRef!
                .InvokeAsync<long>("getCroppedBlobSize", cancellationToken)
                .ConfigureAwait(true);
            var uploadId = await UICommander.Call(new Uploads_Create {
                Session = Session,
                Length = blobSize,
                Tag = tag,
                Metadata = metadata,
            }, cancellationToken);

            var streamSource = new WebUploadStreamSource(_jsRef!);
            await FileUploader.Upload(streamSource, uploadId, null, cancellationToken);

            var mediaRef = await UICommander.Call(new Media_ProcessUpload {
                Session = Session,
                MediaId = mediaId,
                UploadId = uploadId,
            }, cancellationToken);

            ModalModel.OnCropped?.Invoke(mediaRef);
            Modal.Close();
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) {
            // The modal was closed while saving
        }
        catch (Exception e) {
            UICommander.ShowError(e);
        }
        finally {
            _isSaving = false;
            _saveCts.DisposeSilently();
            _saveCts = null;
        }
    }

    // Nested types

    public sealed record Model(
        string InitialImageUrl,
        string Scope,
        Action<MediaRef>? OnCropped,
        bool IsSquare = false,
        float ViewportAspectRatio = 0,
        bool HasBlur = false)
    {
        // "Edit chat picture" and so on; falls back to the generic editor titles when unset
        public string Title { get; init; } = "";

        // Seeds the generation modal. Empty everywhere except the AI suggestion banner, which
        // already has a description worth editing rather than retyping.
        public string Description { get; init; } = "";

        public ImageStyle? Style { get; init; }
        public MediaKind MediaKind { get; init; } = MediaKind.ChatPicture;

        // Generated avatar to show when the modal opens without an image (empty = none).
        public string AvatarKey { get; init; } = "";
        public string AvatarTitle { get; init; } = "";
        public AvatarKind AvatarKind { get; init; } = AvatarKind.Beam;
    }
}
