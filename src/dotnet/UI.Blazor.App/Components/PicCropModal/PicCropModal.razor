@using ActualChat.Media
@using ActualChat.UI.Blazor.App.Module
@namespace ActualChat.UI.Blazor.App.Components
@inherits ComponentBase<AppUIHub>
@implements IModalView<PicCropModal.Model>
@implements IAsyncDisposable

<DialogFrame
    Class="@("pic-crop-modal"
        + (ModalModel.IsSquare ? " square" : "")
        + (ModalModel.HasBlur ? " has-blur" : "")
        + (_isSaving ? " saving" : ""))"
    Title="@Title"
    NarrowViewSettings="@DialogFrameNarrowViewSettings.Default"
    HasCloseButton="true">
    <Body>
        @if (_hasError) {
            <div class="c-error">
                <i class="icon-warning text-2xl"></i>
                <span>@L.PicCrop_LoadFailed</span>
            </div>
        } else {
            <div class="c-content">
                <div class="c-canvas-container">
                    <canvas @ref="_canvasRef" width="400" height="400"></canvas>
                    @if (_isGenerating) {
                        <div class="c-generating">
                            <Spinner/>
                        </div>
                    }
                </div>
                @if (ModalModel.ViewportAspectRatio > 0) {
                    <div class="c-preview">
                        <canvas @ref="_previewRef"
                                width="120"
                                height="@((int)(120 / ModalModel.ViewportAspectRatio))"></canvas>
                        <span class="c-preview-label">@L.PicCrop_Preview</span>
                    </div>
                } else {
                    <div class="c-preview">
                        <canvas @ref="_previewRef" width="40" height="40"></canvas>
                        <span class="c-preview-label">@L.PicCrop_Preview</span>
                    </div>
                }
            </div>
            <div class="c-controls">
                @if (ModalModel.HasBlur) {
                    <div class="c-blur-slider">
                        <input type="range" class="blur-range" min="0" max="16" step="1" value="0" />
                        <span class="c-blur-label">@L.PicCrop_Blur</span>
                    </div>
                }
                <div class="c-buttons-row">
                    <div class="c-group">
                        <ButtonRound Class="btn-zoom-out" Tooltip="@L.PicCrop_ZoomOut" IsDisabled="@_isSaving">
                            <i class="icon-minus-circle text-2xl"></i>
                        </ButtonRound>
                        <ButtonRound Class="btn-zoom-in" Tooltip="@L.PicCrop_ZoomIn" IsDisabled="@_isSaving">
                            <i class="icon-plus-circle text-2xl"></i>
                        </ButtonRound>
                    </div>
                    <ButtonRound Class="btn-confirm"
                                 Click="@OnConfirm"
                                 Tooltip="@L.PicCrop_Apply"
                                 IsDisabled="@_isSaving">
                        @if (_isSaving) {
                            <Spinner/>
                        } else {
                            <i class="icon-checkmark-simple text-2xl"></i>
                        }
                    </ButtonRound>
                    <div class="c-group">
                        <ButtonRound Class="btn-rotate-ccw" Tooltip="@L.PicCrop_RotateLeft" IsDisabled="@_isSaving">
                            <i class="icon-refresh text-2xl c-flip"></i>
                        </ButtonRound>
                        <ButtonRound Class="btn-rotate-cw" Tooltip="@L.PicCrop_RotateRight" IsDisabled="@_isSaving">
                            <i class="icon-refresh text-2xl"></i>
                        </ButtonRound>
                    </div>
                    <ButtonRound Class="btn-generate"
                                 Click="@OnOpenGeneration"
                                 Tooltip="@L.ImageGeneration_Title"
                                 IsDisabled="@(_isSaving || _isGenerating)">
                        <i class="icon-ai-stars text-2xl"></i>
                    </ButtonRound>
                </div>
                @if (_hasGenerationError) {
                    <div class="c-status c-generation-error">@L.PicCrop_GenerationFailed</div>
                } else if (!_saveStatus.IsNullOrEmpty()) {
                    <div class="c-status">@_saveStatus</div>
                }
            </div>
        }
    </Body>
</DialogFrame>

@code {
    private static readonly string JSCreateMethod = $"{BlazorUIAppModule.ImportName}.PicCropModal.create";

    private FileUploader FileUploader => field ??= Services.GetRequiredService<FileUploader>();

    private string Title => ModalModel.Title.NullIfEmpty()
        ?? (ModalModel.HasBlur
            ? L.PicCrop_WallpaperTitle
            : ModalModel.IsSquare ? L.PicCrop_PlaceAvatarTitle : L.PicCrop_AvatarTitle);

    private ElementReference _canvasRef;
    private ElementReference _previewRef;
    private IJSObjectReference? _jsRef;
    private DotNetObjectReference<PicCropModal>? _blazorRef;
    private CancellationTokenSource? _saveCts;
    private bool _hasError;
    private bool _isSaving;
    private string _saveStatus = "";
    private CancellationTokenSource? _generateCts;
    private bool _isGenerating;
    private bool _hasGenerationError;
    private string _description = "";
    private ImageStyle? _style;
    private MediaId? _generatedMediaId;

    [CascadingParameter] public Modal Modal { get; set; } = null!;
    [Parameter] public Model ModalModel { get; set; } = null!;

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (!firstRender)
            return;

        _blazorRef = DotNetObjectReference.Create(this);
        _jsRef = await JS.InvokeAsync<IJSObjectReference>(
            JSCreateMethod,
            _canvasRef,
            _previewRef,
            ModalModel.BlobUrl,
            _blazorRef,
            ModalModel.IsSquare,
            ModalModel.ViewportAspectRatio,
            ModalModel.HasBlur).ConfigureAwait(true);
    }

    public async ValueTask DisposeAsync() {
        _saveCts.CancelAndDisposeSilently();
        _saveCts = null;
        // Cancel first, or an in-flight generation lands after this and leaks the media it saved
        _generateCts.CancelAndDisposeSilently();
        _generateCts = null;
        if (_generatedMediaId is { } generatedMediaId) {
            _generatedMediaId = null;
            await RemoveMedia(generatedMediaId).SilentAwait(false);
        }
        if (_jsRef is { } jsRef) {
            _jsRef = null;
            await jsRef.DisposeSilentlyAsync("dispose");
        }
        _blazorRef?.Dispose();
        _blazorRef = null;
    }

    protected override void OnInitialized() {
        _description = ModalModel.Description;
        _style = ModalModel.Style;
    }

    private void OnOpenGeneration()
        => ModalUI.Show(new ImageGenerationModal.Model(_description, _style, OnGenerate));

    private void OnGenerate(string description, ImageStyle style) {
        _description = description;
        _style = style;
        _ = Generate(description, style);
    }

    private async Task Generate(string description, ImageStyle style) {
        if (_isGenerating)
            return;

        _isGenerating = true;
        _hasGenerationError = false;
        _generateCts = new CancellationTokenSource();
        var cancellationToken = _generateCts.Token;
        StateHasChanged();
        try {
            var command = new Media_Generate {
                Session = Session,
                Scope = ModalModel.Scope,
                Description = description,
                Style = style,
                Kind = ModalModel.MediaKind,
                IsBackground = ModalModel.HasBlur,
            };
            var (mediaRef, error) = await UICommander.Run(command, cancellationToken).ConfigureAwait(true);
            if (error != null || mediaRef is null) {
                _hasGenerationError = true;
                return;
            }

            var url = UrlMapper.ContentUrl(mediaRef.BlobId);
            if (_jsRef is { } jsRef)
                await jsRef.InvokeVoidAsync("setImage", url).ConfigureAwait(true);

            // Only now is the one it replaced certainly off screen. Anything the user accepts is a
            // fresh crop upload, so nothing here is ever what they keep.
            var replaced = _generatedMediaId;
            _generatedMediaId = mediaRef.MediaId;
            await RemoveMedia(replaced).ConfigureAwait(true);
        }
        catch (Exception e) when (!e.IsCancellationOf(cancellationToken)) {
            _hasGenerationError = true;
        }
        finally {
            _isGenerating = false;
            StateHasChanged();
        }
    }

    private async Task RemoveMedia(MediaId? mediaId) {
        if (mediaId is null)
            return;

        var command = new Media_RemoveMedia { Session = Session, MediaId = mediaId };
        await UICommander.Run(command).ConfigureAwait(true);
    }

    [JSInvokable("OnImageLoadError")]
    public void OnImageLoadError() {
        _hasError = true;
        StateHasChanged();
    }

    private async Task OnConfirm() {
        if (_isSaving)
            return;

        _isSaving = true;
        _saveCts = new CancellationTokenSource();
        var cancellationToken = _saveCts.Token;
        try {
            SetSaveStatus(L.PicCrop_Uploading_Format(0));
            var exported = await _jsRef!.InvokeAsync<bool>("exportCrop", cancellationToken).ConfigureAwait(true);
            if (!exported) {
                UICommander.ShowError(StandardError.Upload.CropExportFailed());
                return;
            }

            // Upload the cropped blob via the standard pipeline
            var scope = ModalModel.Scope;
            var mediaId = await UICommander.Call(
                new Media_ReserveMedia { Session = Session, Scope = scope },
                cancellationToken);

            var tag = $"FileUpload/v1/{scope}";
            var metadata = new MetadataBag()
                .Set("FileName", "avatar-crop.png")
                .Set("ContentType", "image/png");
            var blobSize = await _jsRef!
                .InvokeAsync<long>("getCroppedBlobSize", cancellationToken)
                .ConfigureAwait(true);
            var uploadId = await UICommander.Call(new Uploads_Create {
                Session = Session,
                Length = blobSize,
                Tag = tag,
                Metadata = metadata,
            }, cancellationToken);

            var streamSource = new WebUploadStreamSource(_jsRef!);
            var progress = new Progress<double>(p => SetSaveStatus(L.PicCrop_Uploading_Format((int)p)));
            await FileUploader.Upload(streamSource, uploadId, progress, cancellationToken);

            SetSaveStatus(L.PicCrop_Processing);
            var mediaRef = await UICommander.Call(new Media_ProcessUpload {
                Session = Session,
                MediaId = mediaId,
                UploadId = uploadId,
            }, cancellationToken);

            ModalModel.OnCropped?.Invoke(mediaRef);
            Modal.Close();
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) {
            // The modal was closed while saving
        }
        catch (Exception e) {
            UICommander.ShowError(e);
        }
        finally {
            _isSaving = false;
            _saveStatus = "";
            _saveCts.DisposeSilently();
            _saveCts = null;
        }
    }

    private void SetSaveStatus(string status) {
        _saveStatus = status;
        _ = InvokeAsync(StateHasChanged);
    }

    // Nested types

    public sealed record Model(
        string BlobUrl,
        string Scope,
        Action<MediaRef>? OnCropped,
        bool IsSquare = false,
        float ViewportAspectRatio = 0,
        bool HasBlur = false)
    {
        // "Edit chat picture" and so on; falls back to the generic editor titles when unset
        public string Title { get; init; } = "";

        // Seeds the generation modal. Empty everywhere except the AI suggestion banner, which
        // already has a description worth editing rather than retyping.
        public string Description { get; init; } = "";

        public ImageStyle? Style { get; init; }
        public MediaKind MediaKind { get; init; } = MediaKind.ChatPicture;
    }
}
