@namespace ActualChat.UI.Blazor.App.Components
@inherits ComputedStateComponent<AppUIHub, ChatAudioControls.Model>
@{
    var audioState = AudioState ?? ChatAudioState.None;
    var isRecording = audioState.IsRecording;
    var isListening = audioState.IsListening;
    var m = State.Value;
    var stopListeningAt = m.StopListeningAt;
    const double countdownSeconds = 30;
    const double circumference = 100.531;
    var remainingSeconds = isListening && !isRecording && stopListeningAt.HasValue
        ? Math.Max(0, (stopListeningAt.Value - Now).TotalSeconds)
        : 0;
    // Headphone + countdown shows the moment an auto-stop is scheduled; hang up (the phone)
    // shows only while the conversation itself holds the timer off.
    var isCountingDown = remainingSeconds > 0;
    var showHangUp = !isRecording && ((isListening && !isCountingDown) || MustShowHangUp);
    if (!isRecording && !isCountingDown && !showHangUp)
        return;

    // The ring stays full until the last countdownSeconds, then drains.
    var dashOffset = (circumference * (1 - Math.Min(remainingSeconds, countdownSeconds) / countdownSeconds))
        .ToString("F2", null);
    var remaining = (int)Math.Ceiling(remainingSeconds);
    var mm = remaining / 60;
    var ss = remaining % 60;
    // StopListening plays only once the last listening chat stops, so until then a tap is the only feedback
    var stopListeningTune = m.IsOnlyListeningChat ? "none" : null;
    var hangUpTune = m.HasHangUpTune ? "none" : null;
}

<div class="chat-audio-controls @Class" data-child="audio-controls">
    @if (isRecording) {
        @if (ShowRecordingToggle) {
            <HeaderButton
                Class="c-mic"
                StopPropagation="true"
                PreventDefault="true"
                Click="@OnStopRecording"
                data-tune="none"
                Tooltip="@L.Recording_StopRecording"
                TooltipPosition="FloatingPosition.Top">
                <i class="icon-mic-2"></i>
            </HeaderButton>
        }
        <HeaderButton
            Class="c-hangup"
            StopPropagation="true"
            PreventDefault="true"
            Click="@OnHangUp"
            data-tune="none"
            Tooltip="@L.Call_HangUp"
            TooltipPosition="FloatingPosition.Top">
            <i class="icon-phone-off"></i>
        </HeaderButton>
    } else if (isCountingDown) {
        <div class="c-listening-timer">
            <svg class="c-timer-ring" viewBox="0 0 36 36"
                 data-bubble="@(BubbleRef.New<ListeningTimerBubble>())"
                 data-bubble-priority="115"
                 data-bubble-placement="@(FloatingPosition.Bottom.ToPositionString())">
                <circle class="c-timer-ring-bg" cx="18" cy="18" r="16"/>
                <circle class="c-timer-ring-circle" cx="18" cy="18" r="16"
                        style="stroke-dashoffset: @(dashOffset)"/>
            </svg>
            <HeaderButton
                Class="c-listen"
                StopPropagation="true"
                PreventDefault="true"
                Click="@OnStopListening"
                data-tune="@stopListeningTune"
                Tooltip="@L.Call_ListeningCountdown"
                TooltipPosition="FloatingPosition.Top">
                <span class="timer-swap">
                    <i class="icon-listen swap-a"></i>
                    <span class="swap-b c-timer-text">@($"{mm:D2}:{ss:D2}")</span>
                </span>
            </HeaderButton>
        </div>
    } else {
        <HeaderButton
            Class="c-hangup"
            StopPropagation="true"
            PreventDefault="true"
            Click="@OnHangUp"
            data-tune="@hangUpTune"
            Tooltip="@L.Call_HangUp"
            TooltipPosition="FloatingPosition.Top"
            data-render-script-hint="@(m.MustShowHangUpHint ? L.Call_HangUpHint : "")">
            <i class="icon-phone-off"></i>
        </HeaderButton>
    }
</div>

@code {
    private ChatAudioUI ChatAudioUI => Hub.ChatAudioUI;
    private CallScreensUI CallScreensUI => Hub.CallScreensUI;
    private LiveSessionUI LiveSessionUI => Hub.LiveSessionUI;
    private Moment Now => Hub.Clocks.CpuClock.Now;

    [Parameter, EditorRequired] public Chat Chat { get; set; } = null!;
    [Parameter, EditorRequired] public ChatAudioState? AudioState { get; set; }
    [Parameter] public bool MustShowHangUp { get; set; }
    [Parameter] public bool HasHangUpHint { get; set; }
    [Parameter] public bool ShowRecordingToggle { get; set; } = true;
    [Parameter] public string Class { get; set; } = "";

    // Protected/internal methods

    protected override ComputedState<Model>.Options GetStateOptions()
        => ComputedStateComponent.GetStateOptions(GetType(),
            static t => new ComputedState<Model>.Options {
                InitialValue = Model.None,
                Category = GetStateCategory(t),
            });

    protected override async Task<Model> ComputeState(CancellationToken cancellationToken) {
        var chatId = Chat.Id;
        var mustShowHangUpHint = await MustShowHangUpHint(chatId, cancellationToken).ConfigureAwait(true);
        var stopListeningAt = await ChatAudioUI.GetStopListeningAt(chatId, cancellationToken).ConfigureAwait(true);
        var listeningChatIds = await ChatAudioUI.GetListeningChatIds().ConfigureAwait(true);
        var isOnlyListeningChat = listeningChatIds.Count == 1 && listeningChatIds.Contains(chatId);
        var hasHangUpTune = await CallScreensUI.HasHangUpTune(chatId, cancellationToken).ConfigureAwait(true);
        if (!stopListeningAt.HasValue)
            return new Model(null, mustShowHangUpHint, isOnlyListeningChat, hasHangUpTune);

        var remaining = (stopListeningAt.Value - Now).TotalSeconds;
        if (remaining > 0) {
            var fractional = remaining - Math.Floor(remaining);
            var delay = fractional > 0.05 ? fractional : fractional + 1.0;
            Computed.GetCurrent().Invalidate(TimeSpan.FromSeconds(delay));
        }
        return new Model(stopListeningAt, mustShowHangUpHint, isOnlyListeningChat, hasHangUpTune);
    }

    // Private methods

    private async Task<bool> MustShowHangUpHint(ChatId chatId, CancellationToken cancellationToken) {
        // The call screen's own hang-up, when it shows one, is the one the hint points at
        if (!HasHangUpHint)
            return false;

        var screen = await CallScreensUI.GetScreen(cancellationToken).ConfigureAwait(false);
        if (screen is { HasHangUp: true } && screen.ChatId == chatId)
            return false;

        return await LiveSessionUI.MustShowHangUpHint(chatId, cancellationToken).ConfigureAwait(false);
    }

    private void OnStopRecording()
        => _ = ChatAudioUI.SetRecordingChatId(default);

    private void OnStopListening()
        => _ = ChatAudioUI.SetListeningState(Chat.Id, false);

    private Task OnHangUp() {
        // A call held here ends the way the call screen ends it: with its media alone gone,
        // the server notices the leave only after its grace, and the call lingers until then.
        // A ring isn't answered by leaving what is live in its chat, so it is left to ring.
        var call = Hub.CallUI.GetActiveCallNonComputed();
        return call is { Phase: not CallPhase.Ringing } && call.ChatId == Chat.Id
            ? CallScreensUI.HangUp(Chat.Id)
            : CallScreensUI.LeaveLiveSession(Chat.Id);
    }

    // Nested types

    public sealed record Model(
        Moment? StopListeningAt = null,
        bool MustShowHangUpHint = false,
        bool IsOnlyListeningChat = false,
        bool HasHangUpTune = false) {
        public static readonly Model None = new();
    }
}
