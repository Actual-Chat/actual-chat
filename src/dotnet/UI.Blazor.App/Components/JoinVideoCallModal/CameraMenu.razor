@namespace ActualChat.UI.Blazor.App.Components
@using ActualChat.UI.Blazor.App.Events
@inherits Menu<AppUIHub>

<div class="camera-menu">
    <div class="c-header">@L.Call_SelectCamera</div>
    @if (_devices is null) {
        <div class="c-loading">@L.Common_Loading</div>
    } else if (_devices.Length == 0) {
        <div class="c-empty">@L.Call_NoCameras</div>
    } else {
        var hasFront = _devices.Any(d => d.IsFront);
        var hasBack = _devices.Any(d => d.IsBack);
        var showFacingBadge = hasFront && hasBack;
        var groupOrder = new[] { "user", "environment", null };
        var first = true;
        foreach (var group in groupOrder) {
            var groupDevices = _devices.Where(d => d.Facing == group).ToArray();
            if (groupDevices.Length == 0)
                continue;
            if (!first) {
                <MenuEntrySeparator/>
            }
            first = false;
            foreach (var device in groupDevices) {
                var isSelected = device.DeviceId == _selectedDeviceId;
                <MenuEntry
                    Class="@(isSelected ? "selected" : "")"
                    Icon="@(isSelected ? "icon-checkmark-simple" : "icon-checkmark-simple invisible")"
                    Click="@(() => OnClick(device.DeviceId))">
                    <TextContent>
                        <span class="c-camera-name">@device.Label</span>
                        @if (showFacingBadge && device.Facing is { Length: > 0 }) {
                            <span class="c-facing-badge">(@FacingBadgeText(device.Facing))</span>
                        }
                    </TextContent>
                </MenuEntry>
            }
        }
    }
</div>

@code {
    private VideoDevice[]? _devices;
    private string _requester = "";
    private string _selectedDeviceId = "";

    private CameraUI CameraUI => Hub.CameraUI;

    protected override async Task OnParametersSetAsync() {
        _requester = Arguments.Length > 0 ? Arguments[0] : "";
        _selectedDeviceId = Arguments.Length > 1 ? Arguments[1] : "";
        _devices = await CameraUI.EnumerateDevices(includeAll: true).ConfigureAwait(true);
    }

    private async Task OnClick(string deviceId) {
        await UIEventHub.Publish(new CameraSelectedEvent(_requester, deviceId));
    }

    private static string FacingBadgeText(string? facing)
        => facing switch {
            "user" => "front",
            "environment" => "back",
            _ => "",
        };
}
