@namespace ActualChat.UI.Blazor.App.Components
@inherits ComputedStateComponent<AppUIHub, JoinVideoCallModal.ComputedModel>
@implements IModalView<JoinVideoCallModal.Model>
@using ActualChat.Hosting
@using ActualChat.UI
@using ActualChat.UI.Blazor.App.Events
@using ActualChat.UI.Blazor.App.Module
@{
    var m = State.Value;
}

<OnUIEvent TEvent="@CameraSelectedEvent" Handler="OnCameraSelectedEvent"/>
<DialogFrame
    Class="join-video-call-modal modal-sm"
    Title="@Title">
    <Body>
    <div class="c-container">
        @if (m.HasActiveSession) {
            <div class="c-members">
                <CascadingValue Value="@ChatContext">
                    <ChatActivities @key="@Chat.Id.Value" MaxCount="3" IsListening="true"/>
                </CascadingValue>
            </div>
        }
        @if (_permission != CameraPermissionState.Granted) {
            <div class="c-permission-block">
                <i class="icon-video text-5xl text-03"></i>
                @switch (_permission) {
                    case CameraPermissionState.Denied:
                        <div class="c-text">Camera access is blocked.</div>
                        <div class="c-hint">
                            @if (HostInfo.HostKind.IsMauiApp()) {
                                <text>Open settings below and allow camera access for @CoreConstants.AppName, then click Request permission.</text>
                            } else {
                                <text>Click the camera or lock icon in your browser's address bar, set Camera to Allow, then click Request permission.</text>
                            }
                        </div>
                        break;
                    case CameraPermissionState.Prompt:
                        <div class="c-text">We need access to your camera to start the video preview.</div>
                        break;
                    default:
                        <div class="c-text">Checking camera access…</div>
                        break;
                }
            </div>
        } else {
            var effectiveCameraState = IsSettingsMode && !string.IsNullOrEmpty(m.LastRecorderError)
                ? CameraState.Unavailable
                : PreviewState;
            var videoCls = "c-video";
            if (effectiveCameraState is CameraState.Starting)
                videoCls += " camera-starting";
            if (!_isCameraMirrored)
                videoCls += " no-mirror";
            <div @ref="_containerRef" class="@videoCls">
                <div class="video-frame">
                    <video class="camera-preview-video live-stream-video"
                           autoplay playsinline muted aria-hidden="true"
                           disablepictureinpicture disableremoteplayback
                           controlslist="nodownload nofullscreen noremoteplayback"></video>
                    <canvas class="camera-preview"></canvas>
                    <span class="plug-text">@GetPlugText(effectiveCameraState)</span>
                    <div class="video-loading">
                        <span class="spinner-icon-wrapper">
                            <img src="/dist/images/loading-spinner.svg" class="spinner-icon animate-spin" alt="loading"/>
                        </span>
                    </div>
                </div>
            </div>
        }
        @if (_permission == CameraPermissionState.Granted) {
            if (ScreenSize.IsWide()) {
                @* Desktop toolbar *@
                <div class="c-toolbar">
                    @* Camera pill with chevron menu *@
                    <div class="toolbar-pill @(_isVideoOn ? "active" : "")">
                        <HeaderButton Class="pill-action" Click="OnVideoToggle">
                            <i class="icon-video text-2xl"></i>
                        </HeaderButton>
                        <span class="pill-divider"></span>
                        <HeaderButton
                            Class="pill-chevron"
                            data-menu="@(MenuRef.New<CameraMenu>(CameraMenuRequester, _selectedDevice?.DeviceId ?? "").ToString())"
                            data-menu-trigger="@MenuTrigger.Primary"
                            data-menu-placement="@(FloatingPosition.Bottom.ToPositionString())">
                            <i class="icon-chevron-compact-down text-xl"></i>
                        </HeaderButton>
                    </div>

                    @* Mic button *@
                    <ButtonRound Class="@MicBtnClass()" Click="@OnMicToggle">
                        @if (_isRecording) {
                            <i class="icon-mic-2 text-2xl"></i>
                        } else {
                            <i class="icon-mic-off text-2xl"></i>
                        }
                    </ButtonRound>

                    @* Mirror toggle *@
                    <ButtonRound Class="@MirrorBtnClass()" Click="@OnMirrorToggle" Tooltip="Mirror preview">
                        <i class="icon-mirror-video text-2xl"></i>
                    </ButtonRound>
                </div>
            } else {
                @* Mobile toolbar *@
                <div class="c-toolbar">
                    <ButtonRound Class="@VideoWrapperBtnClass()" Click="@OnVideoToggle">
                        <i class="icon-video text-2xl"></i>
                    </ButtonRound>

                    @* Mic button *@
                    <ButtonRound Class="@MicBtnClass()" Click="@OnMicToggle">
                        @if (_isRecording) {
                            <i class="icon-mic-2 text-2xl"></i>
                        } else {
                            <i class="icon-mic-off text-2xl"></i>
                        }
                    </ButtonRound>

                    <ButtonRound
                        Click="@OnSwitchCamera"
                        data-menu="@(MenuRef.New<CameraMenu>(CameraMenuRequester, _selectedDevice?.DeviceId ?? "").ToString())"
                        data-menu-trigger="@MenuTrigger.Secondary"
                        data-menu-placement="@(FloatingPosition.Top.ToPositionString())">
                        <i class="icon-camera-switch text-2xl"></i>
                    </ButtonRound>

                    @* Mirror toggle *@
                    <ButtonRound Class="@MirrorBtnClass()" Click="@OnMirrorToggle" Tooltip="Mirror preview">
                        <i class="icon-mirror-video text-2xl"></i>
                    </ButtonRound>
                </div>
            }
        }
    </div>
    </Body>
    <Buttons>
        @if (IsSettingsMode) {
            var closeBtnClass = _permission == CameraPermissionState.Granted
                ? "btn-modal btn-primary"
                : "btn-modal";
            <Button Class="@closeBtnClass" Click="@OnCloseSettingsClick">Close</Button>
        } else {
            <Button Class="btn-modal" Click="@(_ => Modal.Close())">Cancel</Button>
            @if (_permission == CameraPermissionState.Granted) {
                <Button Class="btn-modal btn-primary"
                        Click="@OnJoinClick"
                        IsDisabled="@IsSubmitDisabled">@SubmitButtonText</Button>
            }
        }
        @if (_permission is CameraPermissionState.Prompt or CameraPermissionState.Denied) {
            @if (_permission == CameraPermissionState.Denied && HostInfo.HostKind.IsMauiApp()) {
                <Button Class="btn-modal" Click="@OnOpenSettingsClick">Open settings</Button>
            }
            <Button Class="btn-modal btn-primary" Click="@OnAllowCameraClick">Proceed</Button>
        }
    </Buttons>
</DialogFrame>

@code {
    private const string CameraMenuRequester = nameof(JoinVideoCallModal);

    private static readonly string JSCreateMethod = $"{BlazorUIAppModule.ImportName}.JoinVideoCallModal.create";

    private ElementReference _containerRef;
    private DotNetObjectReference<JoinVideoCallModal>? _blazorRef;
    private IJSObjectReference? _jsRef;
    private IVideoSession? _session;
    private readonly CancellationTokenSource _disposeCts = new();

    private bool _isInitialized;
    private bool _isVideoOn = true;
    private bool _isBlurEnabled;
    private bool _isCameraMirrored = true;
    private bool _isRecording;
    private CameraPermissionState _permission = CameraPermissionState.Unknown;
    private List<VideoDevice> _videoDevices = new();
    private VideoDevice? _selectedDevice;
    private Task<string> _getLastSelectedDeviceIdTask = null!;

    private ChatAudioUI ChatAudioUI => Hub.ChatAudioUI;
    private AudioRecorder AudioRecorder => Hub.AudioRecorder;
    private ChatVideoUI ChatVideoUI => Hub.ChatVideoUI;
    private CameraUI CameraUI => Hub.CameraUI;
    private CameraPermissionHandler CameraPermission => field ??= Hub.Services.GetRequiredService<CameraPermissionHandler>();
    private SystemSettingsUI SystemSettingsUI => field ??= Hub.Services.GetRequiredService<SystemSettingsUI>();
    private ILogger Log => field ??= Hub.LogFor(GetType());

    // Computed properties
    private ChatContext ChatContext => ModalModel.ChatContext;
    private Chat Chat => ChatContext.Chat;
    private bool IsSettingsMode => ModalModel.Mode is VideoCallMode.Settings;
    private CameraState PreviewState => _session?.State ?? CameraState.Starting;
    private string Title => IsSettingsMode ? "Video Settings"
        : State.Value.HasActiveSession ? "Join the video"
        : "Video preview";
    private string SubmitButtonText => IsSettingsMode ? "Apply"
        : State.Value.HasActiveSession ? "Join"
        : "Start video";

    // Submit conditions:
    // - Video off: enabled iff remote streams exist (joining as viewer makes
    //   sense only when someone else is already streaming).
    // - Video on: require both a resolved device and a settled camera state
    //   (On = preview live, Unavailable = preview failed but user can still
    //   join without a working camera). Starting/Off mean we don't yet know
    //   if the camera works, so block submit.
    private bool IsSubmitDisabled => _isVideoOn
        ? _selectedDevice is null || PreviewState is not (CameraState.On or CameraState.Unavailable)
        : !State.Value.HasActiveSession;

    [CascadingParameter] public Modal Modal { get; set; } = null!;
    [CascadingParameter] public ScreenSize ScreenSize { get; set; }
    [Parameter] public Model ModalModel { get; set; } = null!;

    protected override ComputedState<ComputedModel>.Options GetStateOptions()
        => new() {
            InitialValue = new(false, null),
            UpdateDelayer = FixedDelayer.NextTick,
            Category = GetStateCategory(GetType()),
        };

    protected override async Task<ComputedModel> ComputeState(CancellationToken cancellationToken) {
        var chat = ModalModel.Chat;
        if (IsSettingsMode) {
            // Show "Camera is unavailable" when the live recorder reports an error
            // (e.g. ghost camera). The recorder clears the error on a successful
            // switch so the state recovers automatically.
            var lastError = await ChatVideoUI
                .GetLastVideoRecorderError(VideoSourceKind.Camera, cancellationToken)
                .ConfigureAwait(false);
            return new ComputedModel(false, lastError);
        }

        var hasRemoteStreams = await ChatVideoUI.HasRemoteStreams(chat.Id, cancellationToken).ConfigureAwait(false);
        return new(hasRemoteStreams, null);
    }

    protected override async Task OnInitializedAsync() {
        var settingsTask = LocalSettings.LocalAppSettings().Get();
        _getLastSelectedDeviceIdTask = settingsTask.ContinueWith(
            t => t.Result.SelectedCameraDeviceId ?? "", TaskScheduler.Default);
        var settings = await settingsTask;
        _isBlurEnabled = settings.IsBackgroundBlurEnabledOrDefault;
        var recordingChatId = await ChatAudioUI.GetRecordingChatId();
        _isRecording = recordingChatId == ModalModel.Chat.Id;
        _isVideoOn = !IsSettingsMode
            || await ChatVideoUI.IsOwnCameraRecording(ModalModel.Chat.Id).ConfigureAwait(true);

        // Resolve camera permission before the first render so the body picks
        // either the permission block or the video container — JS-side init
        // depends on the container element being present.
        var cached = await CameraPermission.Check(_disposeCts.Token);
        _permission = ToPermissionState(cached);

        // Auto-recover when the user grants access externally (browser UI,
        // OS dialog) — flip from Prompt/Denied → Granted without re-opening.
        _ = BackgroundTask.Run(WatchPermissionChanges, Log,
            "JoinVideoCallModal permission watcher failed", CancellationToken.None);
        _ = BackgroundTask.Run(PollPermissionWhileNotGranted, Log,
            "JoinVideoCallModal permission poller failed", CancellationToken.None);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (_isInitialized || _permission != CameraPermissionState.Granted)
            return;

        await InitializeCamera();
    }

    private async Task InitializeCamera() {
        // Set early to keep multiple OnAfterRenderAsync invocations from
        // racing into duplicate JS module + session creation.
        _isInitialized = true;

        _videoDevices = (await CameraUI.EnumerateDevices()).ToList();
        StateHasChanged();
        var lastSelectedDeviceId = await _getLastSelectedDeviceIdTask;
        if (!lastSelectedDeviceId.IsNullOrEmpty())
            _selectedDevice = _videoDevices.FirstOrDefault(d => d.DeviceId == lastSelectedDeviceId);
        // Always work with a device from the enumerated list — fall back to the
        // first one when nothing is saved (or the saved id no longer exists).
        _selectedDevice ??= _videoDevices.FirstOrDefault();

        _blazorRef = DotNetObjectReference.Create(this);
        _jsRef = await JS.InvokeAsync<IJSObjectReference>(JSCreateMethod, _containerRef, _blazorRef);
        _session = CreateSession(_jsRef);
        _session.StateChanged += OnSessionStateChanged;

        StateHasChanged();

        // Fire-and-forget: on Windows (unpackaged NativeAOT) getUserMedia may never resolve
        // because camera permission isn't declared in the app manifest. Awaiting the JS call
        // from OnAfterRenderAsync blocks the Blazor render dispatcher and prevents any
        // subsequent click (e.g. Join/Cancel) from running DisposeAsync, so the whole app
        // hangs. OnFirstFrameRendered (JSInvokable) updates CameraState.On when it arrives.
        // Session.Start handles BOTH the warmup recorder kick-off AND the
        // modal-display attach (via attachToRecorder). One camera open call,
        // shared across preview / warmup / openGate live recording — the
        // browser doesn't have to juggle multiple MediaStreamTracks against
        // the same camera (which on Android/iOS Safari can wedge with
        // NotReadableError after a swap).
        _ = BackgroundTask.Run(StartPreview, Log,
            "JoinVideoCallModal preview start failed");
        return;

        async Task StartPreview() {
            await _session!.Start();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task WatchPermissionChanges() {
        try {
            await foreach (var c in CameraPermission.Cached.Computed.Changes(_disposeCts.Token).ConfigureAwait(false)) {
                var next = ToPermissionState(c.Value);
                if (next == _permission)
                    continue;
                _permission = next;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { }
    }

    // Browsers don't fire any signal when the user toggles a site's camera
    // permission via the address-bar icon or chrome://settings, so we re-query
    // the Permissions API every few seconds while we're not Granted. Once we
    // hit Granted the loop just sleeps — Cached.Computed.Changes drives the UI.
    private async Task PollPermissionWhileNotGranted() {
        try {
            while (!_disposeCts.Token.IsCancellationRequested) {
                await Task.Delay(TimeSpan.FromSeconds(2), _disposeCts.Token).ConfigureAwait(false);
                if (_permission == CameraPermissionState.Granted)
                    continue;
                await CameraPermission.Check(_disposeCts.Token).ConfigureAwait(false);
            }
        }
        catch (OperationCanceledException) { }
    }

    private static CameraPermissionState ToPermissionState(bool? cached)
        => cached switch {
            true => CameraPermissionState.Granted,
            false => CameraPermissionState.Denied,
            null => CameraPermissionState.Prompt,
        };

    private Task OnOpenSettingsClick()
        => SystemSettingsUI.Open();

    private async Task OnAllowCameraClick() {
        // CheckOrRequest will prompt only when state is Prompt; for Denied the
        // browser silently refuses (no dialog), but we still re-check so the
        // user can recover after they unblock the site in browser settings.
        var wasDenied = _permission == CameraPermissionState.Denied;
        var granted = await CameraPermission.CheckOrRequest(
            mustRequest: true, mustTroubleshoot: false, _disposeCts.Token);
        _permission = granted
            ? CameraPermissionState.Granted
            : CameraPermissionState.Denied;
        StateHasChanged();
        // The browser silently rejected our request because the site is
        // already blocked at the browser/OS level. Surface that explicitly —
        // a dead click would leave the user thinking the button is broken.
        // We only toast for Denied → Denied; Prompt → Denied is a fresh
        // user choice (native dialog), where the visible state change speaks
        // for itself.
        if (!granted && wasDenied) {
            var toastText = HostInfo.HostKind.IsMauiApp()
                ? "Camera is still blocked. Please allow camera access in system settings first."
                : "Camera is still blocked. Please allow camera access in your browser settings first.";
            ToastUI.Show(toastText, "icon-alert-circle", ToastDismissDelay.Long);
        }
        // OnAfterRenderAsync will pick this up once the video container renders.
    }

    private IVideoSession CreateSession(IJSObjectReference jsRef)
        => IsSettingsMode
            ? new RecorderVideoSession(
                jsRef,
                ChatVideoUI,
                CameraUI,
                ModalModel.Chat.Id,
                () => _isVideoOn,
                () => _selectedDevice?.DeviceId)
            : new WarmupRecorderVideoSession(
                jsRef,
                ChatVideoUI,
                ModalModel.Chat.Id,
                () => _isVideoOn,
                () => _selectedDevice?.DeviceId,
                () => _isBlurEnabled,
                _disposeCts.Token);

    public override async ValueTask DisposeAsync() {
        _disposeCts.CancelAndDisposeSilently();
        if (_session is not null) {
            _session.StateChanged -= OnSessionStateChanged;
            _session = null;
        }
        if (_jsRef is not null) {
            await _jsRef.DisposeSilentlyAsync("dispose");
            _jsRef = null;
        }
        _blazorRef?.Dispose();
        _blazorRef = null;
        // Modal closed without Join (IsConfirmed false) → tear down the
        // warmup recorder. When OnJoinClick set IsConfirmed=true, leave it
        // alone — StateSync will claim it via TryClaimCameraWarmupRecorder.
        if (!IsSettingsMode && !ModalModel.IsConfirmed)
            await ChatVideoUI.CancelCameraWarmup(ModalModel.Chat.Id);
        await base.DisposeAsync();
    }

    private void OnSessionStateChanged()
        => _ = InvokeAsync(StateHasChanged);

    [JSInvokable]
    public Task OnFirstFrameRendered() {
        _session?.NotifyFirstFrameRendered();
        _ = ApplyMirrorForCurrentCamera();
        return Task.CompletedTask;
    }

    // Seeds the modal's mirror toggle from the same resolved value the live
    // self-preview uses (CameraUI, populated by the recorder's OnTrackSettings),
    // so the modal preview and the live tile never disagree.
    private async Task ApplyMirrorForCurrentCamera() {
        if (_jsRef is null)
            return;

        _isCameraMirrored = await CameraUI.GetIsMirrored();
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnVideoToggle() {
        if (_session is null)
            return;

        _isVideoOn = !_isVideoOn;
        StateHasChanged();
        await _session.SetVideoEnabled(_isVideoOn);
    }

    private async Task OnCameraSelected(VideoDevice device) {
        _selectedDevice = device;
        StateHasChanged();

        await Hub.LocalSettings.LocalAppSettings().Update(
            s => s with { SelectedCameraDeviceId = device.DeviceId });

        if (!_isVideoOn || _session is null)
            return;

        // Session.ChangeCamera routes to the recorder (warmup-aware in
        // Join mode, live-recorder in Settings mode). No second
        // ChatVideoUI call — the session owns warmup propagation.
        await _session.ChangeCamera(device.DeviceId);
    }

    private Task OnCameraSelectedEvent(CameraSelectedEvent @event, CancellationToken cancellationToken) {
        if (@event.Requester != CameraMenuRequester)
            return Task.CompletedTask;

        var device = _videoDevices.FirstOrDefault(d => d.DeviceId == @event.DeviceId);
        Log.LogInformation("CameraSelectedEvent: {DeviceId} -> {Device}", @event.DeviceId, device);
        Log.LogInformation("Devices: {Devices}", string.Join(", ", _videoDevices.Select(d => d.ToString())));
        return device is null ? Task.CompletedTask : OnCameraSelected(device);
    }

    private async Task OnSwitchCamera() {
        var currentDeviceId = _selectedDevice?.DeviceId;
        var nextDevice = await CameraUI.GetCameraToSwitch(currentDeviceId);
        if (nextDevice is null)
            return;

        await OnCameraSelected(nextDevice);
    }

    private void OnMirrorToggle() {
        // Toggling only affects this modal's preview. The choice is committed
        // (persisted + propagated to the live self-preview) on close / join —
        // see CommitMirrorChoice. This lets users try the mirror state in the
        // modal without immediately flipping the on-going call view.
        _isCameraMirrored = !_isCameraMirrored;
        StateHasChanged();
    }

    private async Task CommitMirrorChoice() {
        // Persist the per-camera override and tell CameraUI to re-resolve so
        // the live self-preview picks up the change without waiting for the
        // next camera (re)acquisition. No-op if we never resolved a deviceId.
        var deviceId = CameraUI.LastDeviceId ?? _selectedDevice?.DeviceId;
        if (string.IsNullOrEmpty(deviceId))
            return;
        var mirrored = _isCameraMirrored;
        await Hub.LocalSettings.LocalAppSettings().Update(
            s => s with { CameraMirrorOverrides = s.CameraMirrorOverrides.With(deviceId, mirrored) });
        CameraUI.ReapplyMirror();
    }

    private string MirrorBtnClass()
        => _isCameraMirrored ? "mirror-btn active" : "mirror-btn";

    private async Task OnBlurToggle() {
        _isBlurEnabled = !_isBlurEnabled;
        await Hub.LocalSettings.LocalAppSettings().Update(
            s => s with { IsBackgroundBlurEnabled = _isBlurEnabled });

        if (!_isVideoOn || _session is null)
            return;

        await _session.SetBlurEnabled(_isBlurEnabled);
    }

    private async Task OnCloseSettingsClick() {
        await CommitMirrorChoice();
        await DisposeAsync();
        Modal.Close();
    }

    private void OnJoinClick() {
        ModalModel.SelectedDeviceId = _selectedDevice?.DeviceId;
        ModalModel.IsBlurEnabled = _isBlurEnabled;
        ModalModel.IsVideoOn = _isVideoOn;
        ModalModel.IsConfirmed = true;

        _ = CommitMirrorChoice();  // fire-and-forget — no need to block close on a settings write
        _ = DisposeAsync();  // fire-and-forget — don't block Modal.Close on the JS dispose roundtrip
        Modal.Close();
    }

    private async Task OnMicToggle() {
        var chatId = (ChatId?)ModalModel.Chat.Id;
        if (chatId is null)
            return;

        if (_isRecording) {
            await ChatAudioUI.SetRecordingChatId(null);
            _isRecording = false;
        } else {
            if (!await AudioRecorder.MicrophonePermission.CheckOrRequest(CancellationToken.None))
                return;
            await ChatAudioUI.SetRecordingChatId(chatId);
            _isRecording = true;
        }
    }

    private string MicBtnClass()
        => _isRecording ? "mic-btn recording" : "mic-btn";

    private string VideoWrapperBtnClass()
        => _isVideoOn ? "video-btn-on" : "video-btn-off";

    private string BlurBtnClass()
        => _isBlurEnabled ? "blur-btn active" : "blur-btn";

    private string GetPlugText(CameraState cameraState) {
        if (!_isVideoOn)
            return "Camera is off";
        return cameraState switch {
            CameraState.On => "",
            CameraState.Unavailable => "Camera is unavailable",
            // Off here means the session has not been created yet — the only
            // user-driven Off path is _isVideoOn == false, handled above.
            _ => "Camera is starting...",
        };
    }

    // Nested types

    /// <summary>
    /// Strategy for the modal's live preview. <see cref="WarmupRecorderVideoSession"/>
    /// kicks off a warmup <c>VideoRecorder</c> and attaches the modal's canvas to
    /// its preview pipeline (Join mode); <see cref="RecorderVideoSession"/> follows
    /// the already-active recorder through <see cref="ChatVideoUI"/> (Settings
    /// mode). Both ride a single MediaStreamTrack the recorder owns — the modal
    /// never opens the camera itself. The session owns the
    /// <see cref="CameraState"/> machine and notifies the component via
    /// <see cref="StateChanged"/>; the first actually-rendered frame is funneled
    /// into <see cref="NotifyFirstFrameRendered"/>.
    /// </summary>
    private interface IVideoSession
    {
        /// <summary>Current camera/preview state. Transitions are driven by the
        /// session itself; subscribe to <see cref="StateChanged"/> to re-render.</summary>
        CameraState State { get; }

        event Action StateChanged;

        /// <summary>Engage the preview source. Join mode: acquires a MediaStreamTrack
        /// and starts the canvas renderer, ending in <c>On</c> or <c>Unavailable</c>.
        /// Settings mode: attaches the canvas to the active recorder's preview
        /// pipeline and stays in <c>Starting</c> until
        /// <see cref="NotifyFirstFrameRendered"/> is called.</summary>
        Task Start();

        /// <summary>Switch the active camera. Join mode: restarts the own stream.
        /// Settings mode: pushes the selection into <see cref="ChatVideoUI"/>; the
        /// recorder's pipeline restarts and the shared preview view auto-reattaches.</summary>
        Task ChangeCamera(string deviceId);

        /// <summary>Toggle preview blur. Join mode: drives a local
        /// <c>BlurPreviewSession</c> over the own stream. Settings mode: mutates
        /// <see cref="ChatVideoUI.SetBackgroundBlur"/> — the recorder's pipeline
        /// produces blurred frames for the shared view.</summary>
        Task SetBlurEnabled(bool enabled);

        /// <summary>Enable/disable the preview. Join mode: start/stop the own
        /// stream. Settings mode: no-op (the recorder owns the pipeline).</summary>
        Task SetVideoEnabled(bool enabled);

        /// <summary>Called by the component when the JS layer reports the first
        /// rendered frame. Advances state from <c>Starting</c> to <c>On</c>.</summary>
        void NotifyFirstFrameRendered();
    }

    private abstract class VideoSessionBase : IVideoSession
    {
        // Starting (not Off) so the very first render already shows the camera
        // as acquiring. Start() runs on a background task, so without this the
        // Submit button briefly flashes enabled between `_isInitialized = true`
        // and the SetState(Starting) that happens inside Start().
        private CameraState _state = CameraState.Starting;

        public CameraState State => _state;
        public event Action? StateChanged;
        event Action IVideoSession.StateChanged {
            add => StateChanged += value;
            remove => StateChanged -= value;
        }

        protected void SetState(CameraState state) {
            if (_state == state)
                return;
            _state = state;
            StateChanged?.Invoke();
        }

        public abstract Task Start();
        public abstract Task ChangeCamera(string deviceId);
        public abstract Task SetBlurEnabled(bool enabled);
        public abstract Task SetVideoEnabled(bool enabled);

        public virtual void NotifyFirstFrameRendered() {
            // The JS layer fires first-frame events on every (re)attach. Only
            // promote Starting → On; ignore it if a toggle moved us elsewhere
            // (e.g. the user hit Off between attach and the callback).
            if (_state is CameraState.Starting)
                SetState(CameraState.On);
        }
    }


    /// <summary>Join mode — kicks off the warmup recorder and attaches the
    /// modal's display canvas to its preview pipeline. ONE camera open call
    /// for the entire preview → openGate → live recording flow; no second
    /// MediaStreamTrack acquisition (which can wedge the camera on iOS
    /// Safari and some Android browsers).</summary>
    private sealed class WarmupRecorderVideoSession(
        IJSObjectReference jsRef,
        ChatVideoUI chatVideoUI,
        ChatId chatId,
        Func<bool> getIsVideoOn,
        Func<string?> getSelectedDeviceId,
        Func<bool> getIsBlurEnabled,
        CancellationToken disposeCt) : VideoSessionBase
    {
        public override async Task Start()
        {
            if (!getIsVideoOn()) {
                SetState(CameraState.Off);
                return;
            }
            SetState(CameraState.Starting);
            // Recorder must register before attachToRecorder can find it.
            await chatVideoUI.StartCameraWarmup(
                chatId,
                getSelectedDeviceId(),
                getIsBlurEnabled(),
                disposeCt);
            await jsRef.InvokeVoidAsync("attachToRecorder");
        }

        public override Task ChangeCamera(string deviceId)
        {
            SetState(CameraState.Starting);
            return chatVideoUI.UpdateCameraWarmupSettings(
                chatId, deviceId, getIsBlurEnabled(), disposeCt);
        }

        public override Task SetBlurEnabled(bool enabled)
            => chatVideoUI.UpdateCameraWarmupSettings(
                chatId, getSelectedDeviceId(), enabled, disposeCt);

        public override async Task SetVideoEnabled(bool enabled)
        {
            if (enabled) {
                await Start();
            }
            else {
                SetState(CameraState.Off);
                await chatVideoUI.CancelCameraWarmup(chatId);
            }
        }
    }

    /// <summary>Settings mode — preview follows the active recorder; camera/blur
    /// changes are applied by mutating the shared recorder state through
    /// <see cref="ChatVideoUI"/>, and the <c>RecorderPreviewView</c> inside the JS
    /// module re-renders automatically. Leaves the UI in <c>Starting</c> until the
    /// recorder delivers a frame; <see cref="VideoSessionBase.NotifyFirstFrameRendered"/>
    /// advances it to <c>On</c>.</summary>
    private sealed class RecorderVideoSession(
        IJSObjectReference jsRef,
        ChatVideoUI chatVideoUI,
        CameraUI cameraUI,
        ChatId chatId,
        Func<bool> getIsVideoOn,
        Func<string?> getSelectedDeviceId) : VideoSessionBase
    {
        public override async Task Start() {
            if (!getIsVideoOn()) {
                SetState(CameraState.Off);
                return;
            }
            SetState(CameraState.Starting);
            await jsRef.InvokeVoidAsync("attachToRecorder");
        }

        public override Task ChangeCamera(string deviceId) {
            // The recorder's pipeline restarts; the shared RecorderPreviewView
            // auto-detaches and reattaches, so we'll get a fresh first-frame
            // callback once the new camera is live.
            SetState(CameraState.Starting);
            cameraUI.SetSelectedDevice(deviceId);
            return Task.CompletedTask;
        }

        public override Task SetBlurEnabled(bool enabled) {
            chatVideoUI.SetBackgroundBlur(enabled);
            return Task.CompletedTask;
        }

        public override Task SetVideoEnabled(bool enabled) {
            // Stops the camera stream on the active call (or resumes it) —
            // same as the video-panel's toggle. The RecorderPreviewView
            // detaches on recorder teardown and re-attaches when it comes back.
            if (enabled) {
                cameraUI.SetSelectedDevice(getSelectedDeviceId());
                chatVideoUI.ResumeVideoStreaming(chatId);
                SetState(CameraState.Starting);
            } else {
                chatVideoUI.StopRecording();
                SetState(CameraState.Off);
            }
            return Task.CompletedTask;
        }
    }

    public enum CameraState { Off, Starting, On, Unavailable }
    public enum CameraPermissionState { Unknown, Prompt, Granted, Denied }
    public enum VideoCallMode { Join, Settings }

    public sealed class Model(ChatContext chatContext, VideoCallMode mode) {
        public ChatContext ChatContext { get; } = chatContext;
        public Chat Chat => ChatContext.Chat;
        public VideoCallMode Mode { get; } = mode;

        // Result properties — set by the modal before closing
        public bool IsConfirmed { get; set; }
        public string? SelectedDeviceId { get; set; }
        public bool IsBlurEnabled { get; set; }
        // false = user toggled video off; the caller should join as a viewer
        // (no recording, no streaming) instead of starting StartVideoStreaming.
        public bool IsVideoOn { get; set; }
    }

    public sealed record ComputedModel(bool HasActiveSession, string? LastRecorderError);
}
