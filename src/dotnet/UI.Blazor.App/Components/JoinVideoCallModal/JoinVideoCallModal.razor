@namespace ActualChat.UI.Blazor.App.Components
@inherits ComponentBase<AppUIHub>
@implements IModalView<JoinVideoCallModal.Model>
@implements IAsyncDisposable
@using ActualChat.UI.Blazor.App.Module
@using ActualChat.Users

<DialogFrame
    Class="join-video-call-modal modal-sm"
    Title="@ModalTitle">
    <Body>
    <FormBlock Class="">
        @if (ModalModel.Mode == VideoCallMode.Join) {
            <div class="c-members">
                <ChatActivities
                    @key="@ModalModel.Chat.Id.Value"
                    Chat="@ModalModel.Chat"
                    MaxCount="3"
                    IsListening="true"/>
            </div>
            <div class="c-rules">
                <div class="c-rules-header">Rules</div>
                <div class="c-rules-text">No transcription, no anonymous</div>
            </div>
        }
        <div @ref="_containerRef" class="c-video">
            <div class="video-frame">
                <span class="plug-text">
                    Camera is off
                </span>
            </div>
        </div>
        @if (ScreenSize.IsWide()) {
            @* Desktop toolbar *@
            <div class="c-toolbar">
                @* Blur circle *@
                <ButtonRound Class="@BlurBtnClass()" Click="@OnBlurToggle">
                    <i class="icon-eye text-2xl"></i>
                </ButtonRound>
                @* Mic button *@
                <ButtonRound Class="@MicBtnClass()" Click="@OnMicToggle">
                    @if (_isRecording) {
                        <narrow-recording-svg isRecording="true" class="rec-icon on" />
                    } else {
                        <div class="rec-icon off">
                            <i class="icon-recorder-left-half left"></i>
                            <i class="icon-recorder-right-half right"></i>
                        </div>
                    }
                </ButtonRound>
                @* Camera pill with chevron + dropdown *@
                <div class="camera-pill-wrapper">
                    <div class="toolbar-pill @(_isVideoOn ? "active" : "")">
                        <button class="pill-action" type="button" @onclick="OnVideoToggle">
                            <i class="icon-video text-2xl"></i>
                        </button>
                        <span class="pill-divider"></span>
                        <button class="pill-chevron" type="button" @onclick="OnCameraDropdownToggle">
                            <i class="icon-chevron-compact-down text-xl"></i>
                        </button>
                    </div>
                    @if (_isCameraDropdownOpen) {
                        <div class="camera-dropdown">
                            <div class="camera-dropdown-header">Select a camera</div>
                            @foreach (var device in _videoDevices) {
                                var isSelected = device.DeviceId == _selectedDeviceId;
                                var isDisabled = ModalModel.IsSettingsMode;
                                <div class="camera-dropdown-item @(isDisabled ? "disabled" : "")"
                                     @onclick="@(isDisabled ? (Func<Task>)(() => Task.CompletedTask) : () => OnCameraSelected(device))">
                                    @if (isSelected) {
                                        <i class="icon-checkmark-simple text-primary text-lg"></i>
                                    } else {
                                        <span class="w-[18px]"></span>
                                    }
                                    <span class="truncate">@device.Label</span>
                                </div>
                            }
                            <div class="camera-dropdown-divider"></div>
                            <div class="camera-dropdown-item" @onclick="@OnBlurToggle">
                                @if (_isBlurEnabled) {
                                    <i class="icon-checkmark-simple text-primary text-lg"></i>
                                } else {
                                    <span class="w-[18px]"></span>
                                }
                                <span>Blur my background</span>
                            </div>
                        </div>
                    }
                </div>
                @* Screen-share circle *@
                <ButtonRound>
                    <i class="icon-screen-share text-2xl"></i>
                </ButtonRound>
            </div>
        } else {
            @* Mobile toolbar *@
            <div class="c-toolbar">
                <ButtonRound>
                    <i class="icon-volume-up text-2xl"></i>
                </ButtonRound>
                <ButtonRound Class="@BlurBtnClass()" Click="@OnBlurToggle">
                    <i class="icon-eye text-2xl"></i>
                </ButtonRound>
                <ButtonRound Class="@MicBtnClass()" Click="@OnMicToggle">
                    @if (_isRecording) {
                        <narrow-recording-svg isRecording="true" class="rec-icon on" />
                    } else {
                        <div class="rec-icon off">
                            <i class="icon-recorder-left-half left"></i>
                            <i class="icon-recorder-right-half right"></i>
                        </div>
                    }
                </ButtonRound>
                <ButtonRound Class="@VideoWrapperBtnClass()" Click="@OnVideoToggle">
                    <i class="icon-video text-2xl"></i>
                </ButtonRound>
                <ButtonRound Click="@OnSwitchCamera" IsDisabled="@ModalModel.IsSettingsMode">
                    <i class="icon-sync text-2xl"></i>
                </ButtonRound>
            </div>
        }
    </FormBlock>
    </Body>
    <Buttons>
        <Button Class="btn-modal" Click="@(_ => Modal.Close())">Cancel</Button>
        <Button Class="btn-modal btn-primary" Click="@OnJoinClick">@ButtonText</Button>
    </Buttons>
</DialogFrame>

@code {
    private static readonly string JSCreateMethod = $"{BlazorUIAppModule.ImportName}.JoinVideoCallModal.create";
    private static readonly string JSEnumerateMethod = $"{BlazorUIAppModule.ImportName}.JoinVideoCallModal.enumerateDevices";

    private record VideoDevice(string DeviceId, string Label);

    private ElementReference _containerRef;
    private DotNetObjectReference<JoinVideoCallModal>? _blazorRef;
    private IJSObjectReference? _jsRef;

    private bool _isVideoOn;
    private string _selectedDeviceId = "";
    private bool _isBlurEnabled;
    private bool _isCameraDropdownOpen;
    private bool _isRecording;
    private List<VideoDevice> _videoDevices = new();

    [CascadingParameter] public Modal Modal { get; set; } = null!;
    [CascadingParameter] public ScreenSize ScreenSize { get; set; }
    [Parameter] public Model ModalModel { get; set; } = null!;

    private ActiveChatsUI ActiveChatsUI => Hub.ActiveChatsUI;
    private ChatAudioUI ChatAudioUI => Hub.ChatAudioUI;
    private AudioRecorder AudioRecorder => Hub.AudioRecorder;

    private string ModalTitle => ModalModel.IsSettingsMode
        ? "Video Settings"
        : ModalModel.Mode == VideoCallMode.Start
            ? "Start Video Call"
            : "Join the video call";

    private string ButtonText => ModalModel.IsSettingsMode
        ? "Apply"
        : ModalModel.Mode == VideoCallMode.Start
            ? "Start"
            : "Join";

    private ChatVideoUI ChatVideoUI => Hub.ChatVideoUI;

    protected override async Task OnInitializedAsync() {
        var settings = await Hub.LocalSettings.LocalAppSettings().Get();
        _selectedDeviceId = settings.SelectedCameraDeviceId ?? "";
        _isBlurEnabled = settings.GetIsBackgroundBlurEnabled(Hub.BrowserInfo.IsMobile);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (!firstRender)
            return;

        await LoadVideoDevices();
        await EnsureJsRef();
        if (_jsRef is null)
            return;

        if (ModalModel.IsSettingsMode) {
            // Settings mode: attach to the active recorder's preview stream
            var attached = await _jsRef.InvokeAsync<bool>("attachFromRecorder");
            if (attached) {
                _isVideoOn = true;
                // Start blur preview if blur is currently active
                if (_isBlurEnabled)
                    await _jsRef.InvokeVoidAsync("toggleBlur", true);
                StateHasChanged();
            }
        } else {
            // Normal mode: acquire our own stream
            var deviceId = string.IsNullOrEmpty(_selectedDeviceId) ? null : _selectedDeviceId;
            var success = await _jsRef.InvokeAsync<bool>("startPreview", deviceId);
            if (success) {
                _isVideoOn = true;
                if (_isBlurEnabled)
                    await _jsRef.InvokeVoidAsync("toggleBlur", true);
                StateHasChanged();
            }
        }
    }

    public async ValueTask DisposeAsync() {
        if (_jsRef is not null) {
            await _jsRef.InvokeVoidAsync("dispose");
            await _jsRef.DisposeAsync();
            _jsRef = null;
        }
        _blazorRef?.Dispose();
        _blazorRef = null;
    }

    private async Task LoadVideoDevices() {
        try {
            var devices = await JS.InvokeAsync<VideoDevice[]>(JSEnumerateMethod);
            _videoDevices = devices.ToList();
            StateHasChanged();
        } catch {
            _videoDevices = new();
        }
    }

    private async Task EnsureJsRef() {
        if (_jsRef is not null)
            return;

        _blazorRef = DotNetObjectReference.Create(this);
        _jsRef = await JS.InvokeAsync<IJSObjectReference>(JSCreateMethod, _containerRef, _blazorRef);
    }

    private async Task OnVideoToggle() {
        await EnsureJsRef();
        if (_jsRef is null)
            return;

        if (_isVideoOn) {
            await _jsRef.InvokeVoidAsync("stopPreview");
            _isVideoOn = false;
        } else {
            var deviceId = string.IsNullOrEmpty(_selectedDeviceId) ? null : _selectedDeviceId;
            var success = await _jsRef.InvokeAsync<bool>("startPreview", deviceId);
            if (success)
                _isVideoOn = true;
        }
    }

    private void OnCameraDropdownToggle()
        => _isCameraDropdownOpen = !_isCameraDropdownOpen;

    private async Task OnCameraSelected(VideoDevice device) {
        _selectedDeviceId = device.DeviceId;
        _isCameraDropdownOpen = false;
        await Hub.LocalSettings.LocalAppSettings().Update(
            s => s with { SelectedCameraDeviceId = device.DeviceId });

        // Switch camera if preview is active
        if (_isVideoOn && _jsRef is not null)
            await _jsRef.InvokeAsync<bool>("switchCamera", device.DeviceId);
    }

    private async Task OnSwitchCamera() {
        if (_videoDevices.Count <= 1)
            return;

        var currentIndex = _videoDevices.FindIndex(d => d.DeviceId == _selectedDeviceId);
        var nextIndex = (currentIndex + 1) % _videoDevices.Count;
        await OnCameraSelected(_videoDevices[nextIndex]);
    }

    private async Task OnBlurToggle() {
        _isBlurEnabled = !_isBlurEnabled;
        await Hub.LocalSettings.LocalAppSettings().Update(
            s => s with { IsBackgroundBlurEnabled = _isBlurEnabled });
        // Update live blur state so VideoPanel can react during an active call
        ChatVideoUI.SetBackgroundBlur(_isBlurEnabled);
        // Update blur preview in the modal
        if (_jsRef is not null && _isVideoOn)
            await _jsRef.InvokeVoidAsync("toggleBlur", _isBlurEnabled);
    }

    private async Task OnJoinClick() {
        if (ModalModel.IsSettingsMode) {
            // Settings mode: apply blur setting and close — recording continues
            ChatVideoUI.SetBackgroundBlur(_isBlurEnabled);
            await DisposeAsync();
            Modal.Close();
            return;
        }

        // Get actual device ID from JS before disposing — the browser may have
        // picked a different camera than what was originally requested (e.g.,
        // front camera when no device ID was specified).
        string? deviceId = null;
        if (_jsRef is not null)
            deviceId = await _jsRef.InvokeAsync<string?>("getActualDeviceId");
        if (string.IsNullOrEmpty(deviceId))
            deviceId = string.IsNullOrEmpty(_selectedDeviceId) ? null : _selectedDeviceId;

        await DisposeAsync();
        var chatId = ModalModel.Chat.Id;
        ChatVideoUI.SetRecordingChatId(chatId, deviceId, _isBlurEnabled);
        Modal.Close();
    }

    private async Task OnMicToggle() {
        var chatId = (ChatId?)ModalModel.Chat.Id;
        if (chatId is null)
            return;

        if (_isRecording) {
            await ChatAudioUI.SetRecordingChatId(null);
            _isRecording = false;
        } else {
            if (!await AudioRecorder.MicrophonePermission.CheckOrRequest(CancellationToken.None))
                return;
            await ChatAudioUI.SetRecordingChatId(chatId);
            _isRecording = true;
        }
    }

    private string MicBtnClass()
        => _isRecording ? "mic-btn recording" : "mic-btn";

    private string VideoWrapperBtnClass()
        => _isVideoOn ? "video-btn-on" : "video-btn-off";

    private string BlurBtnClass()
        => _isBlurEnabled ? "blur-btn active" : "blur-btn";

    // Nested types

    public enum VideoCallMode { Join, Start }

    public sealed record Model(Chat Chat, VideoCallMode Mode = VideoCallMode.Join, bool IsSettingsMode = false);
}
