@namespace ActualChat.UI.Blazor.App.Components
@inherits ComponentBase<UIHub>

<div class="c-hero">
    <img draggable="false" src="/dist/images/guide/mic-access.svg" alt="@L.MicGuide_BlockedImageAlt">
</div>
<div class="c-title">
    @L.MicGuide_Title
</div>
<div class="c-intro">
    @L.MicGuide_Intro_Format(CoreConstants.AppName)
    @L.Guide_EnableInPhoneSettings
</div>
<ol class="c-steps">
    <li>
        @L.MicGuide_AndroidAppStep1
        <img draggable="false" src="/dist/images/guide/android-app-01.png" alt="Android/App/01">
    </li>
    <li>
        @L.MicGuide_AndroidAppStep2
        <img draggable="false" src="/dist/images/guide/android-app-02.png" alt="Android/App/02">
    </li>
    <li>
        @L.MicGuide_AndroidAppStep3
        <img draggable="false" src="/dist/images/guide/android-app-03.png" alt="Android/App/03">
    </li>
    <li>
        @L.MicGuide_AndroidAppStep4_Format(CoreConstants.AppName)
        <img draggable="false" src="/dist/images/guide/android-app-04.png" alt="Android/App/04">
    </li>
    <li>
        @L.MicGuide_AndroidAppStep5
        <img draggable="false" src="/dist/images/guide/android-app-05.png" alt="Android/App/05">
    </li>
    <li>
        @L.MicGuide_AndroidAppStep6_Format(CoreConstants.AppName)
        <img draggable="false" src="/dist/images/guide/android-app-06.png" alt="Android/App/06">
    </li>
</ol>
