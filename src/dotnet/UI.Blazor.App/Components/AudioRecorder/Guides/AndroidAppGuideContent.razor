@namespace ActualChat.UI.Blazor.App.Components

<div class="c-hero">
    <img draggable="false" src="/dist/images/guide/mic-access.svg" alt="Microphone access is blocked">
</div>
<div class="c-title">
    Microphone access is blocked, but you can fix this!
</div>
<div class="c-intro">
    @CoreConstants.AppName requires microphone access to record and transcribe your messages.
    To enable it in your phone settings:
</div>
<ol class="c-steps">
    <li>
        Open Settings on your phone
        <img draggable="false" src="/dist/images/guide/android-app-01.png" alt="Android/App/01">
    </li>
    <li>
        Go to Apps section
        <img draggable="false" src="/dist/images/guide/android-app-02.png" alt="Android/App/02">
    </li>
    <li>
        Go to Manage apps
        <img draggable="false" src="/dist/images/guide/android-app-03.png" alt="Android/App/03">
    </li>
    <li>
        Choose @CoreConstants.AppName
        <img draggable="false" src="/dist/images/guide/android-app-04.png" alt="Android/App/04">
    </li>
    <li>
        Tap on App permissions
        <img draggable="false" src="/dist/images/guide/android-app-05.png" alt="Android/App/05">
    </li>
    <li>
        Allow @CoreConstants.AppName app to record audio
        <img draggable="false" src="/dist/images/guide/android-app-06.png" alt="Android/App/06">
    </li>
</ol>
