@namespace ActualChat.UI.Blazor.App.Components

<div class="c-hero">
    <img draggable="false" src="/dist/images/guide/mic-access.svg" alt="Microphone access is blocked">
</div>
<div class="c-title">
    Microphone access is blocked, but you can fix this!
</div>
<div class="c-intro">
    @CoreConstants.AppName requires microphone access to record and transcribe your messages.
    To enable it in Google Chrome:
</div>
<ol class="c-steps">
    <li>
        Click "More" button in the upper right corner, and then click "Settings"
        <img draggable="false" src="/dist/images/guide/web-chrome-01.png" alt="Web/Chrome/01">
    </li>
    <li>
        Choose "Privacy and security" on the left side
        <img draggable="false" src="/dist/images/guide/web-chrome-02.png" alt="Web/Chrome/02">
    </li>
    <li>
        Select "Site settings"
        <img draggable="false" src="/dist/images/guide/web-chrome-03.png" alt="Web/Chrome/03">
    </li>
    <li>
        Select "Microphone"
        <img draggable="false" src="/dist/images/guide/web-chrome-04.png" alt="Web/Chrome/04">
    </li>
    <li>
        Check that you allow sites to ask to use your microphone
        <img draggable="false" src="/dist/images/guide/web-chrome-05.png" alt="Web/Chrome/05">
    </li>
    <li>
        If "@Constants.Hosts.Voxt" is not allowed to use microphone, select it
        <img draggable="false" src="/dist/images/guide/web-chrome-06.png" alt="Web/Chrome/06">
    </li>
    <li>
        Change "Permissions" &gt; "Microphone" value from "Deny" to "Allow" or "Ask"
        <img draggable="false" src="/dist/images/guide/web-chrome-07.png" alt="Web/Chrome/07">
    </li>
</ol>
