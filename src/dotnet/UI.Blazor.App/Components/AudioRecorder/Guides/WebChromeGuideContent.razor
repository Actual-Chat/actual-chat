@namespace ActualChat.UI.Blazor.App.Components
@inherits ComponentBase<UIHub>

<div class="c-hero">
    <img draggable="false" src="/dist/images/guide/mic-access.svg" alt="@L.MicGuide_BlockedImageAlt">
</div>
<div class="c-title">
    @L.MicGuide_Title
</div>
<div class="c-intro">
    @L.MicGuide_Intro_Format(CoreConstants.AppName)
    @L.Guide_EnableInWebChrome
</div>
<ol class="c-steps">
    <li>
        @L.MicGuide_WebChromeStep1
        <img draggable="false" src="/dist/images/guide/web-chrome-01.png" alt="Web/Chrome/01">
    </li>
    <li>
        @L.MicGuide_WebChromeStep2
        <img draggable="false" src="/dist/images/guide/web-chrome-02.png" alt="Web/Chrome/02">
    </li>
    <li>
        @L.MicGuide_WebChromeStep3
        <img draggable="false" src="/dist/images/guide/web-chrome-03.png" alt="Web/Chrome/03">
    </li>
    <li>
        @L.MicGuide_WebChromeStep4
        <img draggable="false" src="/dist/images/guide/web-chrome-04.png" alt="Web/Chrome/04">
    </li>
    <li>
        @L.MicGuide_WebChromeStep5
        <img draggable="false" src="/dist/images/guide/web-chrome-05.png" alt="Web/Chrome/05">
    </li>
    <li>
        @L.MicGuide_WebChromeStep6_Format(Constants.Hosts.Voxt)
        <img draggable="false" src="/dist/images/guide/web-chrome-06.png" alt="Web/Chrome/06">
    </li>
    <li>
        @L.MicGuide_WebChromeStep7
        <img draggable="false" src="/dist/images/guide/web-chrome-07.png" alt="Web/Chrome/07">
    </li>
</ol>
