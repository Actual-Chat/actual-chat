@namespace ActualChat.UI.Blazor.App.Components

<div class="c-hero">
    <img draggable="false" src="/dist/images/guide/mic-access.svg" alt="Microphone access is blocked">
</div>
<div class="c-title">
    Microphone access is blocked, but you can fix this!
</div>
<div class="c-intro">
    @CoreConstants.AppName requires microphone access to record and transcribe your messages.
    To enable it in Safari or any other browser on iOS:
</div>
<ol class="c-steps">
    <li>
        Open iOS Settings app, then "Safari" section
        <img draggable="false" src="/dist/images/guide/ios-safari-01.png" alt="iOS/Safari/01">
    </li>
    <li>
        Go to "Settings for websites" (section) &gt; Microphone
        <img draggable="false" src="/dist/images/guide/ios-safari-02.png" alt="iOS/Safari/02">
    </li>
    <li>
        Change "Microphone access on all websites" to "Ask"
        <img draggable="false" src="/dist/images/guide/ios-safari-03.png" alt="iOS/Safari/03">
    </li>
</ol>
