@namespace ActualChat.UI.Blazor.App.Components
@inherits ComponentBase<UIHub>

<div class="c-hero">
    <img draggable="false" src="/dist/images/guide/mic-access.svg" alt="@L.MicGuide_BlockedImageAlt">
</div>
<div class="c-title">
    @L.MicGuide_Title
</div>
<div class="c-intro">
    @L.MicGuide_Intro_Format(CoreConstants.AppName)
    @L.Guide_EnableInMobileSafari
</div>
<ol class="c-steps">
    <li>
        @L.MicGuide_MobileSafariStep1
        <img draggable="false" src="/dist/images/guide/ios-safari-01.png" alt="iOS/Safari/01">
    </li>
    <li>
        @L.MicGuide_MobileSafariStep2
        <img draggable="false" src="/dist/images/guide/ios-safari-02.png" alt="iOS/Safari/02">
    </li>
    <li>
        @L.MicGuide_MobileSafariStep3
        <img draggable="false" src="/dist/images/guide/ios-safari-03.png" alt="iOS/Safari/03">
    </li>
</ol>
