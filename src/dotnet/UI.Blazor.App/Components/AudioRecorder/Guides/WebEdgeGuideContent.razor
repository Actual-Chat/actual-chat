@namespace ActualChat.UI.Blazor.App.Components

<div class="c-hero">
    <img draggable="false" src="/dist/images/guide/mic-access.svg" alt="Microphone access is blocked">
</div>
<div class="c-title">
    Microphone access is blocked, but you can fix this!
</div>
<div class="c-intro">
    @CoreConstants.AppName requires microphone access to record and transcribe your messages.
    To enable it in Microsoft Edge:
</div>
<ol class="c-steps">
    <li>
        Click "⋯" &gt; "Settings" on Windows, or "Microsoft Edge" &gt; "Preferences" on MacOS
        <img draggable="false" src="/dist/images/guide/web-edge-01.png" alt="Web/Edge/01">
    </li>
    <li>
        Choose "Cookies and Site Permissions"
        <img draggable="false" src="/dist/images/guide/web-edge-02.png" alt="Web/Edge/02">
    </li>
    <li>
        Select "Microphone"
        <img draggable="false" src="/dist/images/guide/web-edge-03.png" alt="Web/Edge/03">
    </li>
    <li>
        Delete "@Constants.Hosts.Voxt" from "Block" list
        <img draggable="false" src="/dist/images/guide/web-edge-04.png" alt="Web/Edge/04">
    </li>
    <li>
        Reopen @CoreConstants.AppName and allow it to use microphone
        <img draggable="false" src="/dist/images/guide/web-edge-05.png" alt="Web/Edge/05">
    </li>
</ol>
