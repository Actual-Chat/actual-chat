@namespace ActualChat.UI.Blazor.App.Components
@inherits ComponentBase<UIHub>

<div class="c-hero">
    <img draggable="false" src="/dist/images/guide/mic-access.svg" alt="@L.MicGuide_BlockedImageAlt">
</div>
<div class="c-title">
    @L.MicGuide_Title
</div>
<div class="c-intro">
    @L.MicGuide_Intro_Format(CoreConstants.AppName)
    @L.Guide_EnableInWebEdge
</div>
<ol class="c-steps">
    <li>
        @L.MicGuide_WebEdgeStep1
        <img draggable="false" src="/dist/images/guide/web-edge-01.png" alt="Web/Edge/01">
    </li>
    <li>
        @L.MicGuide_WebEdgeStep2
        <img draggable="false" src="/dist/images/guide/web-edge-02.png" alt="Web/Edge/02">
    </li>
    <li>
        @L.MicGuide_WebEdgeStep3
        <img draggable="false" src="/dist/images/guide/web-edge-03.png" alt="Web/Edge/03">
    </li>
    <li>
        @L.MicGuide_WebEdgeStep4_Format(Constants.Hosts.Voxt)
        <img draggable="false" src="/dist/images/guide/web-edge-04.png" alt="Web/Edge/04">
    </li>
    <li>
        @L.MicGuide_WebEdgeStep5_Format(CoreConstants.AppName)
        <img draggable="false" src="/dist/images/guide/web-edge-05.png" alt="Web/Edge/05">
    </li>
</ol>
