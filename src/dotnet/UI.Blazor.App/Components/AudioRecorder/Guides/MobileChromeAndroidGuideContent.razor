@namespace ActualChat.UI.Blazor.App.Components

<div class="c-hero">
    <img draggable="false" src="/dist/images/guide/mic-access.svg" alt="Microphone access is blocked">
</div>
<div class="c-title">
    Microphone access is blocked, but you can fix this!
</div>
<div class="c-intro">
    @CoreConstants.AppName requires microphone access to record and transcribe your messages.
    To enable it in Google Chrome (mobile):
</div>
<ol class="c-steps">
    <li>
        Tap on "⋮"
        <img draggable="false" src="/dist/images/guide/android-chrome-01.png" alt="Android/Chrome/01">
    </li>
    <li>
        Click "Settings"
        <img draggable="false" src="/dist/images/guide/android-chrome-02.png" alt="Android/Chrome/02">
    </li>
    <li>
        Open "Site settings"
        <img draggable="false" src="/dist/images/guide/android-chrome-03.png" alt="Android/Chrome/03">
    </li>
    <li>
        Tap on "Microphone"
        <img draggable="false" src="/dist/images/guide/android-chrome-04.png" alt="Android/Chrome/04">
    </li>
    <li>
        Enable "Ask first before allowing sites to use your microphone" option
        <img draggable="false" src="/dist/images/guide/android-chrome-05.png" alt="Android/Chrome/05">
    </li>
</ol>
