@namespace ActualChat.UI.Blazor.App.Components
@inherits ComponentBase<UIHub>

<div class="c-hero">
    <img draggable="false" src="/dist/images/guide/mic-access.svg" alt="@L.MicGuide_BlockedImageAlt">
</div>
<div class="c-title">
    @L.MicGuide_Title
</div>
<div class="c-intro">
    @L.MicGuide_Intro_Format(CoreConstants.AppName)
    @L.Guide_EnableInMobileChrome
</div>
<ol class="c-steps">
    <li>
        @L.MicGuide_MobileChromeStep1
        <img draggable="false" src="/dist/images/guide/android-chrome-01.png" alt="Android/Chrome/01">
    </li>
    <li>
        @L.MicGuide_MobileChromeStep2
        <img draggable="false" src="/dist/images/guide/android-chrome-02.png" alt="Android/Chrome/02">
    </li>
    <li>
        @L.MicGuide_MobileChromeStep3
        <img draggable="false" src="/dist/images/guide/android-chrome-03.png" alt="Android/Chrome/03">
    </li>
    <li>
        @L.MicGuide_MobileChromeStep4
        <img draggable="false" src="/dist/images/guide/android-chrome-04.png" alt="Android/Chrome/04">
    </li>
    <li>
        @L.MicGuide_MobileChromeStep5
        <img draggable="false" src="/dist/images/guide/android-chrome-05.png" alt="Android/Chrome/05">
    </li>
</ol>
