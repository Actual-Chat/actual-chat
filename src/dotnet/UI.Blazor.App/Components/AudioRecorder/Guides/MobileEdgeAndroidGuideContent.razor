@namespace ActualChat.UI.Blazor.App.Components

<div class="c-hero">
    <img draggable="false" src="/dist/images/guide/mic-access.svg" alt="Microphone access is blocked">
</div>
<div class="c-title">
    Microphone access is blocked, but you can fix this!
</div>
<div class="c-intro">
    @CoreConstants.AppName requires microphone access to record and transcribe your messages.
    To enable it in Microsoft Edge (mobile):
</div>
<ol class="c-steps">
    <li>
        Tap middle button on the navigation bar
        <img draggable="false" src="/dist/images/guide/android-edge-01.png" alt="Android/Edge/01">
    </li>
    <li>
        Go to "Settings"
        <img draggable="false" src="/dist/images/guide/android-edge-02.png" alt="Android/Edge/02">
    </li>
    <li>
        Choose "Privacy and security"
        <img draggable="false" src="/dist/images/guide/android-edge-03.png" alt="Android/Edge/03">
    </li>
    <li>
        Go to "Site permissions"
        <img draggable="false" src="/dist/images/guide/android-edge-04.png" alt="Android/Edge/04">
    </li>
    <li>
        Choose "Microphone"
        <img draggable="false" src="/dist/images/guide/android-edge-05.png" alt="Android/Edge/05">
    </li>
    <li>
        Enable "Ask first before allowing sites to use your microphone" option
        <img draggable="false" src="/dist/images/guide/android-edge-06.png" alt="Android/Edge/06">
    </li>
    <li>
        Check if Edge itself has microphone access permission
        <img draggable="false" src="/dist/images/guide/android-edge-07.png" alt="Android/Edge/07">
    </li>
    <li>
        If not, allow Edge to use microphone
        <img draggable="false" src="/dist/images/guide/android-edge-08.png" alt="Android/Edge/08">
    </li>
</ol>
