@namespace ActualChat.UI.Blazor.App.Components
@inherits ComponentBase<UIHub>

<div class="c-hero">
    <img draggable="false" src="/dist/images/guide/mic-access.svg" alt="@L.MicGuide_BlockedImageAlt">
</div>
<div class="c-title">
    @L.MicGuide_Title
</div>
<div class="c-intro">
    @L.MicGuide_Intro_Format(CoreConstants.AppName)
    @L.Guide_EnableInPhoneSettings
</div>
<ol class="c-steps">
    <li>
        @L.MicGuide_IosAppStep1
        <img draggable="false" src="/dist/images/guide/ios-app-01.png" alt="Ios/App/01">
    </li>
    <li>
        @L.MicGuide_IosAppStep2_Format(CoreConstants.AppName)
        <img draggable="false" src="/dist/images/guide/ios-app-02.png" alt="Ios/App/02">
    </li>
    <li>
        @L.MicGuide_IosAppStep3_Format(CoreConstants.AppName)
        <img draggable="false" src="/dist/images/guide/ios-app-03.png" alt="Ios/App/03">
    </li>
</ol>
