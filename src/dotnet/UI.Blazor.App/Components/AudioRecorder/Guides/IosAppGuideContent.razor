@namespace ActualChat.UI.Blazor.App.Components

<div class="c-hero">
    <img draggable="false" src="/dist/images/guide/mic-access.svg" alt="Microphone access is blocked">
</div>
<div class="c-title">
    Microphone access is blocked, but you can fix this!
</div>
<div class="c-intro">
    @CoreConstants.AppName requires microphone access to record and transcribe your messages.
    To enable it in your phone settings:
</div>
<ol class="c-steps">
    <li>
        Open Settings on your phone
        <img draggable="false" src="/dist/images/guide/ios-app-01.png" alt="Ios/App/01">
    </li>
    <li>
        Scroll to Apps and open @CoreConstants.AppName
        <img draggable="false" src="/dist/images/guide/ios-app-02.png" alt="Ios/App/02">
    </li>
    <li>
        Allow @CoreConstants.AppName app to record audio
        <img draggable="false" src="/dist/images/guide/ios-app-03.png" alt="Ios/App/03">
    </li>
</ol>
