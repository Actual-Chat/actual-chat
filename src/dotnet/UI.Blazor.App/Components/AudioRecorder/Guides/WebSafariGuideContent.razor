@namespace ActualChat.UI.Blazor.App.Components

<div class="c-hero">
    <img draggable="false" src="/dist/images/guide/mic-access.svg" alt="Microphone access is blocked">
</div>
<div class="c-title">
    Microphone access is blocked, but you can fix this!
</div>
<div class="c-intro">
    @CoreConstants.AppName requires microphone access to record and transcribe your messages.
    To enable it in Apple Safari:
</div>
<ol class="c-steps">
    <li>
        Go to Safari Preferences
        <img draggable="false" src="/dist/images/guide/web-safari-01.png" alt="Web/Safari/01">
    </li>
    <li>
        Choose "Websites" category
        <img draggable="false" src="/dist/images/guide/web-safari-02.png" alt="Web/Safari/02">
    </li>
    <li>
        Select "Microphone" on the left
        <img draggable="false" src="/dist/images/guide/web-safari-03.png" alt="Web/Safari/03">
    </li>
    <li>
        Change "@Constants.Hosts.Voxt" entry's value from "Deny" to "Allow" or "Ask"
        <img draggable="false" src="/dist/images/guide/web-safari-04.png" alt="Web/Safari/04">
    </li>
</ol>
