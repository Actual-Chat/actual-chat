@namespace ActualChat.UI.Blazor.App.Components
@inherits ComponentBase<UIHub>

<div class="c-hero">
    <img draggable="false" src="/dist/images/guide/mic-access.svg" alt="@L.MicGuide_BlockedImageAlt">
</div>
<div class="c-title">
    @L.MicGuide_Title
</div>
<div class="c-intro">
    @L.MicGuide_Intro_Format(CoreConstants.AppName)
    @L.Guide_EnableInWebSafari
</div>
<ol class="c-steps">
    <li>
        @L.MicGuide_WebSafariStep1
        <img draggable="false" src="/dist/images/guide/web-safari-01.png" alt="Web/Safari/01">
    </li>
    <li>
        @L.MicGuide_WebSafariStep2
        <img draggable="false" src="/dist/images/guide/web-safari-02.png" alt="Web/Safari/02">
    </li>
    <li>
        @L.MicGuide_WebSafariStep3
        <img draggable="false" src="/dist/images/guide/web-safari-03.png" alt="Web/Safari/03">
    </li>
    <li>
        @L.MicGuide_WebSafariStep4_Format(Constants.Hosts.Voxt)
        <img draggable="false" src="/dist/images/guide/web-safari-04.png" alt="Web/Safari/04">
    </li>
</ol>
