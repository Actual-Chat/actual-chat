@namespace ActualChat.UI.Blazor.App.Components
@inherits ComponentBase<UIHub>

<div class="c-hero">
    <img draggable="false" src="/dist/images/guide/mic-access.svg" alt="@L.MicGuide_BlockedImageAlt">
</div>
<div class="c-title">
    @L.MicGuide_UnknownTitle_Format(CoreConstants.AppName)
</div>
<div class="c-intro">
    @L.MicGuide_UnknownIntro
</div>

<ul class="c-items">
    <li>
        @L.MicGuide_UnknownReload_Prefix<a
            class="c-reload"
            @onclick="@OnReloadClick">@L.MicGuide_UnknownReloadLink</a>@L.MicGuide_UnknownReload_Suffix
    </li>
    <li>@L.MicGuide_UnknownReopen</li>
    <li>@L.MicGuide_UnknownCheckInternet</li>
</ul>

@code {
    [Inject] private ReloadUI ReloadUI { get; init; } = null!;

    private void OnReloadClick()
        => ReloadUI.Reload();
}
