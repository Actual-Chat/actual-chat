@namespace ActualChat.UI.Blazor.App.Components
@inherits ComputedStateComponent<AppUIHub, Place?>
@{
    var place = State.Value;
    var isPlace = place?.Id is not null;
}

<div class="no-results-container">
    <div class="c-wrapper">
        <no-search-results-svg />
        <div class="text-wrapper">
            <p>@L.NoResults_Title</p>
            @if (!isPlace) {
                <p>@L.NoResults_TryAnotherRequest</p>
            } else {
                <Button Class="btn-transparent" Click="@SelectChatsNavbarItem">@L.NoResults_SearchOutsidePlace</Button>
            }
        </div>
    </div>
</div>

@code {
    private IPlaces Places => Hub.Places;
    private NavbarUI NavbarUI => Hub.NavbarUI;

    protected override async Task OnInitializedAsync() {
        NavbarUI.SelectedGroupChanged += OnNavbarSelectedGroupChanged;
        NavbarUI.SelectedGroupTitleUpdated += OnNavbarSelectedGroupChanged;
        await base.OnInitializedAsync();
    }

    public void Dispose() {
        NavbarUI.SelectedGroupChanged -= OnNavbarSelectedGroupChanged;
        NavbarUI.SelectedGroupTitleUpdated -= OnNavbarSelectedGroupChanged;
    }

    protected override ComputedState<Place?>.Options GetStateOptions()
        => ComputedStateComponent.GetStateOptions(GetType(),
            static t => new ComputedState<Place?>.Options() {
                InitialValue = null,
                UpdateDelayer = FixedDelayer.NextTick,
                Category = GetStateCategory(t),
            });

    protected override async Task<Place?> ComputeState(CancellationToken cancellationToken) {
        NavbarUI.IsPlaceSelected(out var placeId);
        if (placeId is null)
            return null;

        var place = await Places.Get(Session, placeId, cancellationToken).ConfigureAwait(false);
        return place;
    }

    private void SelectChatsNavbarItem()
        => NavbarUI.SelectGroup(NavbarGroupIds.Chats, true);

    private void OnNavbarSelectedGroupChanged(object? s, EventArgs e)
        => State.Invalidate();
}
