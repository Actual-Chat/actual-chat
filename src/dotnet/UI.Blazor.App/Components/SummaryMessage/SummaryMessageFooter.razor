<div class="summary-footer @Class">
    <div class="bg-wrapper">
        <div class="c-content">
            <div class="c-author-list">
                @foreach (var authorCls in SummaryData.Authors) {
                    <div class="author-incut @authorCls"></div>
                }
                <div class="author-incut ai-extra">+@SummaryData.ExtraAuthorCount</div>
            </div>
            <div class="c-time">
                @SummaryData.TimeRange
            </div>
        </div>
        <HeaderButton>
            <i class="icon-copy"></i>
        </HeaderButton>
    </div>
</div>

@code {
    [Parameter] public string Class { get; set; } = "";
    [Parameter] public SummaryTestPageContent.SummaryInfo SummaryData { get; set; } = null!;
}
