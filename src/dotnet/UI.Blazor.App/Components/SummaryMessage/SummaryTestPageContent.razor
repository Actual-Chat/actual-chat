    private string[] _summaryTitles = [
        "Улучшение дизайна редактора и системы упоминаний",
        "Ухудшение всего, чего только можно",
    ];

    private string[] _summaryTimes = [
        "23.11 15:00-18:00",
        "12.04 11:00-12:00",
    ];

    private Message[] GetMessages() {
        var mList = new List<Message>();
        for (var i = 0; i < _entries.Length; i++) {
            var message = new Message(i + 1, _entries[i]);
            mList.Add(message);
        }
        return mList.ToArray();
    }

    public record Message(int Id, string Entry);

    public record SummaryInfo(
        Message[] Messages,
        string Title,
        string TimeRange,
        string[] Authors,
        int ExtraAuthorCount);
}
