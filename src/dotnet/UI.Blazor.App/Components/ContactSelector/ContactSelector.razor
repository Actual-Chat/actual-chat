@namespace ActualChat.UI.Blazor.App.Components
@inherits ComputedStateComponent<AppUIHub, IReadOnlyList<ContactInfo>>
@using ActualChat.Search

<CascadingValue IsFixed="true" Value="@this">
    @ChildContent
</CascadingValue>

@code {
    private MutableState<IReadOnlyDictionary<ChatId, ContactInfo>> _allContacts = null!;
    private MutableState<ImmutableHashSet<ChatId>> _selectedChatIds = null!;
    private PlaceId? _placeId;

    private LocalSearchUI LocalSearchUI => Hub.LocalSearchUI;

    [Parameter] public ChatListOrder Order { get; set; } = ChatListOrder.ByOwnUpdateTime;
    [Parameter] public ChatListPreOrder ChatListPreOrder { get; set; } = ChatListPreOrder.ChatList;
    [Parameter] public ChatListFilter Filter { get; set; } = ChatListFilter.None;
    [Parameter] public bool UseCanWriteFilter { get; set; } = true;
    [Parameter] public IReadOnlySet<ChatId>? ExcludeChatIds { get; set; }
    [Parameter] public SearchQuery SearchQuery { get; set; }
    [Parameter] public EventCallback Changed { get; set; }
    [Parameter] public RenderFragment ChildContent { get; set; } = null!;

    public IState<IReadOnlyDictionary<ChatId, ContactInfo>> AllContacts => _allContacts;
    public ComputedState<IReadOnlyList<ContactInfo>> Contacts => State;
    public IState<ImmutableHashSet<ChatId>> SelectedChatIds => _selectedChatIds;

    public void Toggle(ChatId chatId)
        => _selectedChatIds.Set(
            chatId,
            static (chatId1, x) => x.Value.Contains(chatId1)
                ? x.Value.Remove(chatId1)
                : x.Value.Add(chatId1));

    public void Add(ChatId chatId)
        => _selectedChatIds.Set(chatId, static (chatId1, x) => x.Value.Add(chatId1));

    public void Remove(ChatId chatId)
        => _selectedChatIds.Set(chatId, static (chatId1, x) => x.Value.Remove(chatId1));

    public void Clear()
        => _selectedChatIds.Set(static x => x.Value.Clear());

    public void SelectPlace(PlaceId? placeId) {
        _placeId = placeId;
        _ = State.Recompute();
    }

    // Protected methods

    protected override void OnInitialized() {
        var type = GetType();
        _allContacts = StateFactory.NewMutable(
            (IReadOnlyDictionary<ChatId, ContactInfo>)ImmutableDictionary<ChatId, ContactInfo>.Empty,
            StateCategories.Get(type, nameof(AllContacts)));
        _selectedChatIds = StateFactory.NewMutable(
            ImmutableHashSet<ChatId>.Empty,
            StateCategories.Get(type, nameof(SelectedChatIds)));
        _selectedChatIds.Updated += (_, _) => InvokeAsync(
            () => !State.DisposeToken.IsCancellationRequested
                ? Changed.InvokeAsync()
                : Task.CompletedTask);
    }

    protected override ComputedState<IReadOnlyList<ContactInfo>>.Options GetStateOptions()
        => ComputedStateComponent.GetStateOptions(GetType(),
            static t => new ComputedState<IReadOnlyList<ContactInfo>>.Options() {
                InitialValue = ImmutableList<ContactInfo>.Empty,
                UpdateDelayer = FixedDelayer.NextTick,
                Category = GetStateCategory(t),
            });

    protected override async Task<IReadOnlyList<ContactInfo>> ComputeState(CancellationToken cancellationToken) {
        var chatListOrder = Order;
        var chatListPreOrder = ChatListPreOrder;
        var searchQuery = SearchQuery;
        var excludedChats = ExcludeChatIds;
        var filter = Filter;

        var allContacts = await LocalSearchUI.ListContactInfos(_placeId, cancellationToken).ConfigureAwait(false);
        _allContacts.Value = allContacts;
        IEnumerable<ContactInfo> contacts = allContacts.Values;
        if (excludedChats != null && excludedChats.Count != 0)
            contacts = contacts.Where(x => !excludedChats.Contains(x.Id));
        contacts = contacts.Where(filter.Invoke);
        if (UseCanWriteFilter)
            contacts = contacts.Where(c => c.Chat.Rules.CanWrite());

        contacts = contacts.OrderBy(chatListOrder, chatListPreOrder);
        if (!searchQuery.IsEmpty)
            contacts = contacts.FilterAndOrderBySearchQuery(searchQuery);

        return contacts.ToList();
    }
}
