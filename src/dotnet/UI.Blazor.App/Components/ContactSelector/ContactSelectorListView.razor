@namespace ActualChat.UI.Blazor.App.Components
@inherits ComputedStateComponent<AppUIHub, object?>
@{
    var contacts = Selector.Contacts.Value;
    var selectedChatIds = Selector.SelectedChatIds.Value;
}

<ContentSwap
    LayerKey="@Selector.SelectedPlaceId"
    Class="c-list-swap"
    Children="contact-list"
    LayerChildren="contact-list"
    Effect="@_swapDirection.Wipe(Selector.SelectedPlaceIndex)">
    <ChildContent>
        <div class="contact-selector-list" role="listbox" aria-multiselectable="true" data-child="contact-list">
            @foreach (var contact in contacts) {
                var isSelected = selectedChatIds.Contains(contact.Id);
                var missingPermissions = Selector.GetMissingPermissions(contact);
                var isDisabled = missingPermissions != default;
                <div class="contact-selector-list-item"
                     role="option"
                     tabindex="0"
                     aria-selected="@(isSelected ? "true" : "false")"
                     aria-disabled="@(isDisabled ? "true" : "false")"
                     @onclick="() => OnContactClick(contact)">
                    <ContactView
                        ContactInfo="contact"
                        SearchQuery="Selector.SearchQuery"
                        Note="@GetNote(missingPermissions)"/>
                    <Checkbox
                        IsChecked="@isSelected"
                        IsDisabled="@isDisabled"
                        Class="!flex-none"
                        Change="() => OnContactClick(contact)"/>
                </div>
            }
        </div>
        @if (Selector.ContactsPlaceId == Selector.SelectedPlaceId) {
            <ContentSwapDisplay/>
        }
    </ChildContent>
</ContentSwap>

@code {
    private readonly ContentSwapDirection _swapDirection = new();

    [CascadingParameter] public ContactSelector Selector { get; set; } = null!;

    protected override ComputedState<object?>.Options GetStateOptions()
        => ComputedStateComponent.GetStateOptions(GetType(),
            static t => new ComputedState<object?>.Options() {
                UpdateDelayer = FixedDelayer.NextTick,
                Category = GetStateCategory(t),
            });

    protected override async Task<object?> ComputeState(CancellationToken cancellationToken) {
        await Selector.Contacts.Use(cancellationToken).ConfigureAwait(false);
        await Selector.SelectedChatIds.Use(cancellationToken).ConfigureAwait(false);
        return null;
    }

    private void OnContactClick(ContactInfo contact) {
        var missingPermissions = Selector.GetMissingPermissions(contact);
        if (missingPermissions == default) {
            Selector.Toggle(contact.Id);
            return;
        }

        if (missingPermissions.Has(ChatPermissions.Upload))
            ToastUI.Show(L.Share_NoFilesYetReason, "icon-alert-circle", ToastDismissDelay.Short);
    }

    private string GetNote(ChatPermissions missingPermissions)
        => missingPermissions.Has(ChatPermissions.Upload) ? L.Share_NoFilesYet : "";
}
