@namespace ActualChat.UI.Blazor.App.Components
@inherits ComputedStateComponent<AppUIHub, object?>
@{
    var allContacts = Selector.AllContacts.Value;
    var selectedChatIds = Selector.SelectedChatIds.Value;
}

<div class="contact-selector-wrapper">
    <div class="contact-selector-badges no-scrollbar">
        @foreach (var chatId in selectedChatIds) {
            var contact = allContacts.GetValueOrDefault(chatId);
            if (contact == null)
                continue;

            <SelectedBadge @key="@chatId" Name="@contact.Chat.Title" OnRemove="() => Selector.Remove(contact.Id)">
                <Icon>
                    <ChatIcon Chat="@contact.Chat" Size="SquareSize.Size6"/>
                </Icon>
            </SelectedBadge>
        }
    </div>
</div>

@code {
    [CascadingParameter] public ContactSelector Selector { get; set; } = null!;

    protected override ComputedState<object?>.Options GetStateOptions()
        => ComputedStateComponent.GetStateOptions(GetType(),
            static t => new ComputedState<object?>.Options() {
                UpdateDelayer = FixedDelayer.NextTick,
                Category = GetStateCategory(t),
            });

    protected override async Task<object?> ComputeState(CancellationToken cancellationToken) {
        await Selector.AllContacts.Use(cancellationToken).ConfigureAwait(false);
        await Selector.SelectedChatIds.Use(cancellationToken).ConfigureAwait(false);
        return null;
    }
}
