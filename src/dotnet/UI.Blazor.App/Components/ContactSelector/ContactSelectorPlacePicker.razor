@using ActualChat.Contacts
@using ActualChat.Media;
@namespace ActualChat.UI.Blazor.App.Components
@inherits ComputedStateComponent<AppUIHub, List<Place>>
@{
    if (State.IsInitial(out var places) || places.Count == 0)
        return;

    var tabs = new List<TabDef> {
        new(string.Empty) {
            TitleContent = @<i class="icon-message-ellipse text-2xl font-medium"></i>,
        },
    };
    foreach (var place in places)
        tabs.Add(new(place.Id.Value) {
            TitleContent = @<Pic
                                Title="@place.Title"
                                Picture="@place.Picture.ToPicture()"
                                Size="@SquareSize.Size10"
                                IsSquare="true"
                                AvatarKind="@AvatarKind.Marble"
                                AvatarKey="@place.Id.Value"/>,
        });
}

<div class="contact-selector-place-picker no-scrollbar">
    <TabPanel
        Tabs="@tabs"
        TabsClass="carousel"
        BottomHill="@true"
        SelectedTabIdChanged="@OnSelectedTabIdChanged"/>
</div>

@code {
    private IContacts Contacts => Hub.Contacts;
    private NavbarUI NavbarUI => Hub.NavbarUI;

    [CascadingParameter] public ContactSelector Selector { get; set; } = null!;

    protected override async Task<List<Place>> ComputeState(CancellationToken cancellationToken) {
        var navbarSettings = await NavbarUI.Settings.Use(cancellationToken).ConfigureAwait(false);
        var placeIds = await Contacts.ListPlaceIds(Session, cancellationToken).ConfigureAwait(false);
        var maybePlaces = await placeIds
            .OrderBy(x => navbarSettings.PlacesOrder.IndexOf(x))
            .Select(id => Hub.Places.Get(Session, id, cancellationToken))
            .Collect(ApiConstants.Concurrency.Unlimited, cancellationToken)
            .ConfigureAwait(false);
        var places = maybePlaces.SkipNullItems().ToList();
        return places;
    }

    private void OnSelectedTabIdChanged(string? tabId) {
        if (tabId.IsNullOrEmpty())
            SelectPlace(null, 0);
        else if (PlaceId.TryParse(tabId, out var placeId))
            SelectPlace(placeId, GetPlaceIndex(placeId));
    }

    private void SelectPlace(PlaceId? placeId, int index)
        => Selector.SelectPlace(placeId, index);

    private int GetPlaceIndex(PlaceId placeId) {
        // The all-places tab is rendered first, so a place sits one past its position in the list
        var places = State.Value;
        for (var i = 0; i < places.Count; i++)
            if (places[i].Id == placeId)
                return i + 1;

        return 0;
    }
}
