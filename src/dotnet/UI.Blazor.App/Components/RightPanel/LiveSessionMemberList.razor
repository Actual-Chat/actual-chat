@namespace ActualChat.UI.Blazor.App.Components
@using ActualChat.Live
@using ActualChat.Users
@inherits ComputedStateComponent<AppUIHub, LiveSessionMemberList.Model>
@{
    var m = State.Value;
    var live = m.Session;
    if (live is null) {
        <div class="live-session-member-list">
            @if (!State.IsInitial(out _)) {
                <ContentSwapDisplay/>
            }
            <div class="c-empty">@L.Call_NoActiveCall</div>
        </div>
        return;
    }
    var groups = new (string Key, string Title, MemberGroup Group)[] {
        ("host", L.Call_GroupHost, MemberGroup.Host),
        ("others", L.Call_GroupOthers, MemberGroup.Other),
        ("exited", L.Call_GroupExited, MemberGroup.Exited),
    };
}
<div class="live-session-member-list">
    @if (!State.IsInitial(out _)) {
        <ContentSwapDisplay/>
    }
    @if (live.Kind == LiveSessionKind.Dialing) {
        <div class="c-dialing">@L.Call_Dialing</div>
    }
    <div class="c-rules">
        <span class="c-rules-title">@L.Call_Rules</span>
        <span class="c-rules-text">@RulesText(live.Rules)</span>
    </div>
    @if (m.IsController) {
        var anyMuted = live.Members.Any(x => x.AuthorId != m.OwnAuthorId && x.MicMuted);
        <div class="c-manage">
            <span class="c-manage-title">@L.Call_Manage</span>
            <div class="c-manage-buttons">
                <button class="c-manage-btn @(TranscriptOn(live.Rules) ? "on" : "off")"
                        @onclick="@(() => ToggleTranscript(live))" title="@L.Call_Transcription">
                    <i class="icon-voice-to-text-message"></i>
                </button>
                <button class="c-manage-btn @(VoiceOn(live.Rules) ? "on" : "off")"
                        @onclick="@(() => ToggleVoice(live))" title="@L.Call_Voice">
                    <i class="icon-voice-01"></i>
                </button>
                <button class="c-manage-btn @(live.Rules.VideoAllowed ? "on" : "off")"
                        @onclick="@(() => ToggleVideo(live))" title="@L.Call_Video">
                    <i class="icon-video"></i>
                </button>
                @if (m.CanMuteOthers) {
                    <button class="c-manage-btn @(anyMuted ? "on" : "off")"
                            @onclick="@(() => ToggleMuteAll(live, !anyMuted))"
                            title="@(anyMuted ? L.Call_UnmuteAll : L.Call_MuteAll)">
                        <i class="@(anyMuted ? "icon-mic-off" : "icon-mic-2")"></i>
                    </button>
                }
            </div>
        </div>
    }
    <div class="c-content">
        @foreach (var (key, title, group) in groups) {
            var members = live.Members.Where(x => x.Group == group).ToList();
            if (members.Count == 0)
                continue;

            var groupTitle = L.RightPanel_GroupTitle_Format(title, members.Count);
            <Collapsed @key="@key" Title="@groupTitle" IsCollapsed="false">
            @foreach (var member in members) {
                <div class="c-member-row" @key="@member.AuthorId.Value">
                    <AuthorBadge
                        AuthorId="@member.AuthorId"
                        ShowPresence="true"
                        ShowPresenceText="true"
                        IsShortPresenceText="true"
                        Click="@_onClickCallback"/>
                    <div class="c-member-state">
                        @if (m.CanSetHost && member.AuthorId != live.Host
                            && member.Group != MemberGroup.Exited) {
                            <button class="c-host-btn" title="@L.Call_MakeHost"
                                    @onclick="@(() => OnMakeHostClick(live.ChatId, member))">
                                <i class="icon-star"></i>
                            </button>
                        }
                        @if (member.HasScreenShare) {
                            <i class="icon-screen-share" title="@L.Call_SharingScreen"></i>
                        }
                        @if (member.HasCamera) {
                            <i class="icon-video" title="@L.Call_CameraOn"></i>
                        }
                        @{
                            var isRecording = member.IsMicOpen && !member.MicMuted;
                            var isListening = member.MicMuted || member.IsListening;
                        }
                        @if (isRecording) {
                            var micTitle = CanStopRecording(m, member) ? L.Call_TurnOffRecording : L.Call_Recording;
                            <button class="c-mic-btn" title="@micTitle"
                                    @onclick="@(() => OnMicClick(live.ChatId, m, member))">
                                <i class="icon-mic-2 recording"></i>
                            </button>
                        }
                        else if (isListening) {
                            <i class="icon-phone in-call" title="@L.Call_InCall"></i>
                        }
                    </div>
                </div>
            }
            </Collapsed>
        }
    </div>
</div>

@code {
    private EventCallback<AuthorId> _onClickCallback;

    private IChats Chats => Hub.Chats;
    private IAuthors Authors => Hub.Authors;
    private IRoles Roles => Hub.Roles;
    private AuthorUI AuthorUI => Hub.AuthorUI;
    private LiveSessionUI LiveSessionUI => Hub.LiveSessionUI;
    private ToastUI ToastUI => Hub.ToastUI;

    [Parameter, EditorRequired] public ChatId ChatId { get; set; }

    protected override void OnInitialized()
        => _onClickCallback = NoStateHasChanged.EventCallback<AuthorId>(authorId => _ = AuthorUI.Show(authorId));

    protected override ComputedState<Model>.Options GetStateOptions()
        => ComputedStateComponent.GetStateOptions(GetType(),
            static t => new ComputedState<Model>.Options() {
                InitialValue = Model.None,
                UpdateDelayer = FixedDelayer.Get(0.1),
                Category = GetStateCategory(t),
            });

    protected override async Task<Model> ComputeState(CancellationToken cancellationToken) {
        if (ChatId is null || ChatId.Value.IsNullOrEmpty())
            return Model.None;

        var live = await LiveSessionUI.Get(ChatId, cancellationToken).ConfigureAwait(true);
        // A closing session can linger with no one left in it - never show the Call tab for an empty call.
        if (live is null || live.Members.Count == 0)
            return Model.None;

        var ownAuthor = await Authors.GetOwn(Session, ChatId, cancellationToken).ConfigureAwait(true);
        var rules = await Chats.GetRules(Session, ChatId, cancellationToken).ConfigureAwait(true);
        var isPeerChat = ChatId is PeerChatId;
        var isHost = ownAuthor is not null && live.Host == ownAuthor.Id;
        var ownerIds = isPeerChat
            ? []
            : await Roles.ListOwnerIds(Session, ChatId, cancellationToken).ConfigureAwait(true);
        return new Model {
            Session = live,
            OwnAuthorId = ownAuthor?.Id,
            IsController = rules.CanModerate() || isHost,
            IsOwner = rules.IsOwner(),
            IsHost = isHost,
            IsPeerChat = isPeerChat,
            OwnerAuthorIds = ownerIds,
        };
    }

    private Task OnMicClick(ChatId chatId, Model m, LiveSessionMember member) {
        // Turning a mic off is the only outcome here - nothing in this component ever unmutes another member.
        if (CanStopRecording(m, member))
            return LiveSessionUI.MutePeer(chatId, member.AuthorId, true, CancellationToken.None);

        var info = m.IsPeerChat
            ? L.Call_CantMutePeer
            : !m.CanMute(member.AuthorId)
                ? L.Call_CantMuteOwner
                : L.Call_CantMuteOthers;
        ToastUI.Show(info, "icon-mic-off", ToastDismissDelay.Short);
        return Task.CompletedTask;
    }

    private Task OnMakeHostClick(ChatId chatId, LiveSessionMember member)
        => LiveSessionUI.SetHost(chatId, member.AuthorId, CancellationToken.None);

    private static bool CanStopRecording(Model m, LiveSessionMember member)
        => member.AuthorId == m.OwnAuthorId
            || (m.CanMuteOthers && m.CanMute(member.AuthorId) && member.Group != MemberGroup.Exited);

    private Task ToggleTranscript(LiveSession live)
        => SetVoiceMode(live, !TranscriptOn(live.Rules), VoiceOn(live.Rules));
    private Task ToggleVoice(LiveSession live)
        => SetVoiceMode(live, TranscriptOn(live.Rules), !VoiceOn(live.Rules));
    private Task ToggleVideo(LiveSession live)
        => LiveSessionUI.SetRules(live.ChatId,
            live.Rules with { VideoAllowed = !live.Rules.VideoAllowed },
            CancellationToken.None);
    private Task ToggleMuteAll(LiveSession live, bool muted)
        => LiveSessionUI.MuteAll(live.ChatId, muted, CancellationToken.None);

    private Task SetVoiceMode(LiveSession live, bool transcript, bool voice) {
        var mode = (transcript, voice) switch {
            (true, true) => VoiceMode.TextAndVoice,
            (true, false) => VoiceMode.JustText,
            (false, true) => VoiceMode.JustVoice,
            _ => VoiceMode.JustText,
        };
        return LiveSessionUI.SetRules(live.ChatId, live.Rules with { VoiceModeOverride = mode }, CancellationToken.None);
    }

    private static bool TranscriptOn(SessionRules r) => r.VoiceModeOverride is not VoiceMode.JustVoice;
    private static bool VoiceOn(SessionRules r) => r.VoiceModeOverride is not VoiceMode.JustText;

    private string RulesText(SessionRules r) {
        var parts = new List<string> {
            TranscriptOn(r) ? L.Call_Transcription : L.Call_NoTranscription,
            VoiceOn(r) ? L.Call_Voice : L.Call_NoVoice,
            r.VideoAllowed ? L.Call_Video : L.Call_NoVideo,
        };
        return string.Join(", ", parts);
    }

    // Nested types

    public sealed record Model {
        public static readonly Model None = new();

        public LiveSession? Session { get; init; }
        public AuthorId? OwnAuthorId { get; init; }
        public bool IsController { get; init; }
        public bool IsOwner { get; init; }
        public bool IsHost { get; init; }
        public bool IsPeerChat { get; init; }
        public IReadOnlyCollection<AuthorId> OwnerAuthorIds { get; init; } = [];
        public bool CanMuteOthers => IsController && !IsPeerChat;
        public bool CanSetHost => (IsOwner || IsHost) && !IsPeerChat;
        public bool CanMute(AuthorId authorId)
            => IsOwner || IsHost || !OwnerAuthorIds.Contains(authorId);
    }
}
