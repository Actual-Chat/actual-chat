@using ActualChat.Contacts
@namespace ActualChat.UI.Blazor.App.Components
@inherits ComputedStateComponent<AppUIHub, RightPanelChatInfo.Model>
@{
    if (State.IsInitial(out var m))
        return;
}

<div class="c-chat-info">
    @if (!m.HideNotificationsToggle) {
        var iconCls = m.NotificationMode != ChatNotificationMode.Muted ? "text-primary" : "text-03";
        <RightPanelChatInfoItem
            Click="@(_ => OnNotificationToggleChanged(m.NotificationMode != ChatNotificationMode.Muted))"
            Content="Notifications"
            Hint="@(m.NotificationMode != ChatNotificationMode.Muted ? "On" : "Off")">
            <Icon>
                <i class="text-2xl icon-bell @iconCls"></i>
            </Icon>
            <Right>
                <Toggle Class="mr-2" IsChecked="@(m.NotificationMode != ChatNotificationMode.Muted)"/>
            </Right>
        </RightPanelChatInfoItem>
    }
    @if (m.ShowSummarizationToggle) {
        var iconCls = m.IsSummarized ? "text-primary" : "text-03";
        <RightPanelChatInfoItem
            Click="@(_ => OnSummarizeToggleChanged(!m.IsSummarized))"
            Content="Summarize"
            Hint="@(m.IsSummarized ? "On" : "Off")">
            <Icon>
                <i class="text-2xl icon-ai-stars @iconCls"></i>
            </Icon>
            <Right>
                <Toggle Class="mr-2" IsChecked="@m.IsSummarized"/>
            </Right>
        </RightPanelChatInfoItem>
    }
    @if (m.ShowBlockToggle) {
        <RightPanelChatInfoItem
            Click="@(_ => OnBlockToggleChanged(!m.IsBlocked))"
            Content="Block user"
            Hint="@(m.IsBlocked ? "Blocked" : "Not blocked")">
            <Icon>
                <i class="text-2xl icon-block @(m.IsBlocked ? "text-danger" : "text-03")"></i>
            </Icon>
            <Right>
                <Toggle Class="mr-2" IsChecked="@m.IsBlocked"/>
            </Right>
        </RightPanelChatInfoItem>
    }
</div>

@code {
    private Chat? Chat => ChatContext?.Chat;

    [CascadingParameter] public ChatContext? ChatContext { get; set; }
    [CascadingParameter] public ScreenSize ScreenSize { get; set; }

    protected override async Task<Model> ComputeState(CancellationToken cancellationToken) {
        var chat = Chat;
        var chatId = chat.Id;

        if (chat.HasSingleAuthor || !chat.IsMember())
            return new() { HideNotificationsToggle = true };

        var isOwner = chat.Rules.IsOwner() || chat.Kind == ChatKind.Peer;
        var chatUserSettings = await UserSettingsUI.ChatUserSettings(chatId).Get(cancellationToken).ConfigureAwait(false);
        var isPeer = chatId is PeerChatId;
        Contact? peerContact = null;
        if (isPeer)
            peerContact = await Hub.Contacts.GetForChat(Session, chatId, cancellationToken).ConfigureAwait(false);
        return new() {
            NotificationMode = chatUserSettings.NotificationMode,
            ShowSummarizationToggle = isOwner,
            IsSummarized = Chat.IsSummarized ?? false,
            ShowBlockToggle = isPeer && peerContact is not null,
            IsBlocked = peerContact?.IsBlocked ?? false,
            PeerContactId = peerContact?.Id,
        };
    }

    private Task OnNotificationToggleChanged(bool isMuted)
        => UICommander.RunLocal(ct
            => UserSettingsUI.ChatUserSettings(Chat.Id)
                .Update(x => x with { NotificationMode = isMuted ? ChatNotificationMode.Muted : ChatNotificationMode.Default, }, ct));

    private Task OnBlockToggleChanged(bool isBlocked) {
        var m = State.Value;
        if (m.PeerContactId is null)
            return Task.CompletedTask;

        return UICommander.Run(new Contacts_SetIsBlocked(Session, m.PeerContactId, isBlocked));
    }

    private Task OnSummarizeToggleChanged(bool isSummarized) {
        if (State.Value.IsSummarized == isSummarized)
            return Task.CompletedTask;

        var update = Change.Update<ChatDiff>(new() { IsSummarized = isSummarized });
        return UICommander.Run(new Chats_Change(Session, Chat.Id, null, update));
    }

    // Nested types

    public sealed record Model {
        public ChatNotificationMode NotificationMode { get; init; }
        public bool IsSummarized { get; init; }
        public bool HideNotificationsToggle { get; init; }
        public bool ShowSummarizationToggle { get; init; }
        public bool ShowBlockToggle { get; init; }
        public bool IsBlocked { get; init; }
        public ContactId? PeerContactId { get; init; }
    }
}
