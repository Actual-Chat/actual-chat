@namespace ActualChat.UI.Blazor.App.Components
@inherits ComputedStateComponent<AppUIHub, RightPanelChatInfo.Model>
@{
    if (State.IsInitial(out var m))
        return;
}

@{
    var summarizeClick = m.IsOwner
        ? EventCallback.Factory.Create(this, () => OnSummarizeToggleChanged(!m.IsSummarized))
        : default;
    var pttClick = m.IsOwner
        ? EventCallback.Factory.Create(this, () => OnPttToggleChanged(!m.IsPttEnabled))
        : default;
}
<div class="c-chat-info">
    @if (m.ShowSummarizationToggle || m.ShowPttToggle) {
        <Card>
            @if (m.ShowSummarizationToggle) {
                var iconCls = m.IsSummarized ? "text-primary" : "text-03";
                <CardItem Click="@summarizeClick">
                    <Left>
                        <i class="text-2xl icon-ai-stars @iconCls"></i>
                    </Left>
                    <Title>Summarize</Title>
                    <Caption>@GetStateCaption(m.IsSummarized, m.IsOwner)</Caption>
                    <Right>
                        <Toggle
                            IsDisabled="@(!m.IsOwner)"
                            IsChecked="@m.IsSummarized"
                            IsCheckedChanged="@OnSummarizeToggleChanged"/>
                    </Right>
                </CardItem>
            }
            @if (m.ShowPttToggle) {
                var pttIconCls = m.IsPttEnabled ? "text-primary" : "text-03";
                <CardItem Click="@pttClick">
                    <Left>
                        <i class="text-2xl icon-talking @pttIconCls"></i>
                    </Left>
                    <Title>Push-to-talk</Title>
                    <Caption>@GetStateCaption(m.IsPttEnabled, m.IsOwner)</Caption>
                    <Right>
                        <Toggle
                            IsDisabled="@(!m.IsOwner)"
                            IsChecked="@m.IsPttEnabled"
                            IsCheckedChanged="@OnPttToggleChanged"/>
                    </Right>
                </CardItem>
            }
        </Card>
    }
</div>

@code {
    private Chat? Chat => ChatContext?.Chat;

    [CascadingParameter] public ChatContext? ChatContext { get; set; }
    [CascadingParameter] public ScreenSize ScreenSize { get; set; }

    protected override async Task<Model> ComputeState(CancellationToken cancellationToken) {
        var chat = Chat;
        if (chat.HasSingleAuthor || !chat.IsMember())
            return new();

        var isOwner = chat.Rules.IsOwner() || chat.Kind == ChatKind.Peer;
        var isIncompleteUIEnabled = await Hub.Features.IsIncompleteUIEnabled(cancellationToken).ConfigureAwait(false);
        var isSummarized = chat.IsSummarized ?? false;
        var isPttEnabled = chat.PttEnabledAt != null;
        // Non-owners see turned-on settings as read-only facts; turned-off ones are hidden entirely.
        return new() {
            IsOwner = isOwner,
            ShowSummarizationToggle = isOwner || isSummarized,
            IsSummarized = isSummarized,
            ShowPttToggle = isIncompleteUIEnabled && !chat.Id.IsThread() && (isOwner || isPttEnabled),
            IsPttEnabled = isPttEnabled,
        };
    }

    private Task OnSummarizeToggleChanged(bool isSummarized) {
        if (!State.Value.IsOwner || State.Value.IsSummarized == isSummarized)
            return Task.CompletedTask;

        var update = Change.Update<ChatDiff>(new() { IsSummarized = isSummarized });
        return UICommander.Run(new Chats_Change(Session, Chat.Id, null, update));
    }

    private async Task OnPttToggleChanged(bool isPttEnabled) {
        var chat = Chat;
        if (chat is null || !State.Value.IsOwner || State.Value.IsPttEnabled == isPttEnabled)
            return;

        // A non-null value is just a "turn it on" sentinel - the server stamps the real epoch.
        var pttEnabledAt = isPttEnabled ? (Moment?)Clocks.SystemClock.Now : null;
        var update = Change.Update<ChatDiff>(new() { PttEnabledAt = pttEnabledAt });
        var (newChat, error) = await UICommander.Run(new Chats_Change(Session, chat.Id, null, update));
        if (error != null)
            return;

        // Flipping the toggle is itself consent: auto-arm the owner with the server-stamped epoch.
        if (isPttEnabled && newChat?.PttEnabledAt is { } enabledAt)
            await UserSettingsUI.UserPttSettings()
                .Update(x => x.WithPttChat(chat.Id, enabledAt), CancellationToken.None);
        else if (!isPttEnabled)
            await UserSettingsUI.UserPttSettings()
                .Update(x => x.WithoutPttChat(chat.Id), CancellationToken.None);
    }

    private static string GetStateCaption(bool isOn, bool isOwner) {
        var state = isOn ? "On" : "Off";
        return isOwner ? state : $"{state} - by chat owner";
    }

    // Nested types

    public sealed record Model {
        public bool IsOwner { get; init; }
        public bool IsSummarized { get; init; }
        public bool ShowSummarizationToggle { get; init; }
        public bool IsPttEnabled { get; init; }
        public bool ShowPttToggle { get; init; }
    }
}
