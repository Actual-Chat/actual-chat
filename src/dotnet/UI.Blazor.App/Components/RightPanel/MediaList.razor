@namespace ActualChat.UI.Blazor.App.Components
@inherits ComputedStateComponent<AppUIHub, MediaList.Model>
@{
    var m = State.Value;
    var attachments = m.Attachments ?? [];
}

<div class="media-list-tab">
    <div class="c-content">
        @foreach (var attachment in attachments) {
            var url = UrlMapper.ContentUrl(attachment.Media.ContentId);
            string? previewUrl = null;
            if (attachment.IsGif() || attachment.IsSvg()) {
                previewUrl = url; // currently image proxy fails on large gifs
            } else if (attachment.IsSupportedImage()) {
                previewUrl = UrlMapper.ImagePreviewUrl(url, null, (int?)Constants.Attachments.MaxActualThumbnailResolution.Y);
            }

            <div class="image-attachment">
                <a class="c-content"
                   href="@url"
                   role="button"
                   @onclick="@(() => VisualMediaViewerUI.Show(url, attachments))"
                   @onclick:preventDefault="true">
                    @if (attachment.IsSupportedVideo()) {
                        <VideoAttachmentThumbnail Attachment="@attachment"/>
                    } else {
                        <image-skeleton
                            class="show-image-skeleton"
                            src="@url"
                            thumbnailSrc="@previewUrl"
                        />
                    }
                </a>
            </div>
        }
    </div>
</div>

@code {
    private ChatUI ChatUI => Hub.ChatUI;
    private VisualMediaViewerUI VisualMediaViewerUI => Hub.VisualMediaViewerUI;

    [Parameter] public ChatId? ChatId { get; set; }
    [Parameter] public PlaceId? PlaceId { get; set; }

    protected override ComputedState<Model>.Options GetStateOptions()
        => ComputedStateComponent.GetStateOptions(GetType(),
            static t => new ComputedState<Model>.Options() {
                InitialValue = Model.None,
                UpdateDelayer = FixedDelayer.Get(0.1),
                Category = GetStateCategory(t),
            });

    protected override async Task<Model> ComputeState(CancellationToken cancellationToken) {
        var chatId = ChatId;

        if (chatId is null)
            return Model.None;

        var chatState = await ChatUI.GetState(chatId, false, cancellationToken).ConfigureAwait(false);
        if (chatState is null)
            return Model.None;

        var attachments = GetChatEntries(chatState);

        return new() {
            Attachments = attachments,
        };
    }

    private TextEntryAttachment[] GetChatEntries(ChatState chatState) {
        var lastEntry = chatState.Info.News?.LastTextEntry;
        if (lastEntry is null)
            return [];

        var entryAttachments = lastEntry.Attachments;
        if (entryAttachments.Length == 0)
            return [];

        return entryAttachments.Where(attachment => attachment.IsVisualMedia()).ToArray();
    }

    // Nested types

    public sealed class Model {
        public static readonly Model None = new();

        public TextEntryAttachment[]? Attachments { get; init; }
    }
}
