@namespace ActualChat.UI.Blazor.App.Components
@using ActualChat.Users
@inherits ComputedStateComponent<AppUIHub, RightPanelModeSwitch.Model>
@{
    var m = State.Value;
}

<SegmentedSwitch
    Class="right-panel-mode-switch pill"
    Items="@BuildItems(m)"
    SelectedId="@m.Mode.ToString()"
    SelectedIdChanged="@OnSelectedIdChanged"/>

@code {
    protected override ComputedState<Model>.Options GetStateOptions()
        => new() {
            InitialValue = new Model(PanelsUI.Right.Mode.Value, false),
            UpdateDelayer = FixedDelayer.NextTick,
            Category = GetStateCategory(GetType()),
        };

    protected override async Task<Model> ComputeState(CancellationToken cancellationToken) {
        var mode = await PanelsUI.Right.Mode.Use(cancellationToken).ConfigureAwait(false);
        var note = await UserSettingsUI.UserCoachWeeklyNote().Get(cancellationToken).ConfigureAwait(false);
        return new Model(mode, note.IsPending);
    }

    private IReadOnlyList<SegmentedSwitchItem> BuildItems(Model m) => [
        new(RightPanelMode.Chat.ToString(), L.Coach_ModeChat),
        new(RightPanelMode.Coach.ToString(), L.Coach_ModeCoach) { HasDot = m.HasNote },
    ];

    private void OnSelectedIdChanged(string id)
        => PanelsUI.Right.SetMode(Enum.Parse<RightPanelMode>(id));

    public sealed record Model(RightPanelMode Mode, bool HasNote);
}
