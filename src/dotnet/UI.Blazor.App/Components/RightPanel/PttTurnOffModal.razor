@namespace ActualChat.UI.Blazor.App.Components
@inherits ComponentBase<AppUIHub>
@implements IModalView<PttTurnOffModal.Model>

@* Pausing keeps everyone's consent, turning off drops it - so pausing is the default *@
<DialogFrame Class="ptt-turn-off-modal compact-header modal-sm" Title="@L.Ptt_TurnOffTitle">
    <Body>
        <FormBlock>
            <TileItem ToggleValue="@_isPause" ToggleValueChanged="@(v => _isPause = v)">
                <Content>@L.Ptt_PauseForEveryone</Content>
                <Caption>@(_isPause ? L.Ptt_PauseConfirmText : L.Ptt_TurnOffCaption)</Caption>
            </TileItem>
        </FormBlock>
    </Body>
    <Buttons>
        <Button Class="btn-modal" Click="@(_ => Modal.Close())">@L.Common_Cancel</Button>
        <Button Class="btn-modal btn-primary" Click="@OnConfirm">
            @(_isPause ? L.Common_Pause : L.Common_TurnOff)
        </Button>
    </Buttons>
</DialogFrame>

@code {
    private bool _isPause = true;

    [CascadingParameter] public Modal Modal { get; set; } = null!;
    [Parameter] public Model ModalModel { get; set; } = null!;

    private void OnConfirm() {
        ModalModel.Confirm(_isPause);
        Modal.Close();
    }

    // Nested types

    public sealed record Model(Action<bool> Confirm);
}
