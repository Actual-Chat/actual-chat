@namespace ActualChat.UI.Blazor.App.Components
@inherits ComputedStateComponent<AppUIHub, ChatDescription.Model>
@{
    var m = State.Value;
}

@if (!m.PeerOwnName.IsNullOrEmpty()) {
    <span class="c-chat-description">
        @m.PeerOwnName
    </span>
}
<span class="c-chat-description">
    @m.Description
</span>

@code {
    private IAvatars Avatars => Hub.Avatars;
    private IAuthors Authors => Hub.Authors;

    [ParameterComparer(typeof(ByRefParameterComparer))]
    [Parameter, EditorRequired] public Chat Chat { get; set; } = null!;

    protected override ComputedState<Model>.Options GetStateOptions()
        => ComputedStateComponent.GetStateOptions(GetType(),
            static t => new ComputedState<Model>.Options() {
                InitialValue = Model.Loading,
                Category = GetStateCategory(t),
            });

    protected override async Task<Model> ComputeState(CancellationToken cancellationToken) {
        if (Chat.Id is PeerChatId peerChatId)
            return await GetPeerChatModel(peerChatId, cancellationToken);

        return new() {
            Description = Chat.Description,
        };
    }

    private async Task<Model> GetPeerChatModel(PeerChatId peerChatId, CancellationToken cancellationToken) {
        var chat = Chat;
        var ownAccount = await AccountUI.OwnAccount.Use(cancellationToken).ConfigureAwait(false);
        var peerAccountId = peerChatId.AnotherUserIdOrNull(ownAccount.Id);
        if (peerAccountId is null)
            return Model.Loading;

        var ownUserId = ownAccount.Id;
        var anotherAuthorId = peerChatId.AnotherAuthorId(ownUserId);
        var anotherAuthor = await Authors.Get(Session, peerChatId, anotherAuthorId, cancellationToken).ConfigureAwait(false);

        if (anotherAuthor == null)
            return Model.Loading;

        var bio = anotherAuthor.Avatar.Bio;
        var avatar = await Avatars.Get(Session, anotherAuthor.Avatar.Id, cancellationToken).ConfigureAwait(false);
        var peerOwnName = avatar?.Name ?? "";
        return new() {
            Description = bio,
            PeerOwnName = chat.Title != peerOwnName ? peerOwnName : ""
        };
    }

    // Nested types

    public sealed record Model {
        public static readonly Model Loading = new();

        public string Description { get; init; } = "";
        public string PeerOwnName { get; init; } = "";
    }
}
