@namespace ActualChat.UI.Blazor.App.Components
@using ActualChat.Roulette
@inherits ComputedStateComponent<AppUIHub, ChatDescription.Model>
@{
    var m = State.Value;
}

@if (!m.PeerOwnName.IsNullOrEmpty()) {
    <span class="c-chat-description">
        @m.PeerOwnName
    </span>
}
<span class="c-chat-description">
    @m.Description
</span>

@if (m.ChatRouletteInfo != null) {
    var preferences = m.ChatRouletteInfo.PeerProfile.Preferences.Preferences;
    var countryName = preferences.Country?.Title.NullIfEmpty() ?? "---";
    var languages = string.Join(", ", preferences.Languages.Select(c => c.Title)).NullIfEmpty() ?? "---";
    <div class="cr-item">
        <div class="c-center">
            <div class="cr-badge c-location">
                <i class="icon-map-point"></i>
                <span>@countryName</span>
            </div>
            <div class="cr-badge c-languages">
                <i class="icon-globe"></i>
                <span>@languages</span>
            </div>
        </div>
        <div class="c-bottom">
            @{
                var matchInterests = m.ChatRouletteInfo.OwnProfile?.Preferences.Preferences.Interests ?? [];
            }
            @foreach (var interest in preferences.Interests) {
                var match = matchInterests.Contains(interest);
                <div class="cr-badge @(match ? "selected" : "")">
                    <span>@interest.Title</span>
                </div>
            }
        </div>
    </div>
}

@code {
    private IAvatars Avatars => Hub.Avatars;
    private IAuthors Authors => Hub.Authors;
    private IRoulette Roulette => Hub.Roulette;

    [ParameterComparer(typeof(ByRefParameterComparer))]
    [Parameter, EditorRequired] public Chat Chat { get; set; } = null!;

    protected override ComputedState<Model>.Options GetStateOptions()
        => ComputedStateComponent.GetStateOptions(GetType(),
            static t => new ComputedState<Model>.Options() {
                InitialValue = Model.Loading,
                Category = GetStateCategory(t),
            });

    protected override async Task<Model> ComputeState(CancellationToken cancellationToken) {
        if (Chat.Id is PeerChatId peerChatId)
            return await GetPeerChatModel(peerChatId, cancellationToken);

        var isChatRoulette = Chat.IsChatRoulette();
        if (isChatRoulette)
            return await GetChatRouletteModel(Chat, cancellationToken);

        return new() {
            Description = Chat.Description,
        };
    }

    private async Task<Model> GetPeerChatModel(PeerChatId peerChatId, CancellationToken cancellationToken) {
        var chat = Chat;
        var ownAccount = await AccountUI.OwnAccount.Use(cancellationToken).ConfigureAwait(false);
        var peerAccountId = peerChatId.AnotherUserIdOrNull(ownAccount.Id);
        if (peerAccountId is null)
            return Model.Loading;

        var ownUserId = ownAccount.Id;
        var anotherAuthorId = peerChatId.AnotherAuthorId(ownUserId);
        var anotherAuthor = await Authors.Get(Session, peerChatId, anotherAuthorId, cancellationToken).ConfigureAwait(false);

        if (anotherAuthor == null)
            return Model.Loading;

        var bio = anotherAuthor.Avatar.Bio;
        var avatar = await Avatars.Get(Session, anotherAuthor.Avatar.Id, cancellationToken).ConfigureAwait(false);
        var peerOwnName = avatar?.Name ?? "";
        return new() {
            Description = bio,
            PeerOwnName = !OrdinalEquals(chat.Title, peerOwnName) ? peerOwnName : ""
        };
    }

    private async Task<Model> GetChatRouletteModel(Chat chat, CancellationToken cancellationToken) {
        var chatRouletteInfo = await GetChatRouletteInfo(chat, cancellationToken).ConfigureAwait(false);
        if (chatRouletteInfo is null)
            return new();

        return new() {
            Description = chatRouletteInfo.PeerProfile.Avatar.Bio,
            ChatRouletteInfo = chatRouletteInfo
        };
    }

    private async Task<ChatRouletteInfo?> GetChatRouletteInfo(Chat chat, CancellationToken cancellationToken) {
        var chatRouletteProfiles = await Roulette.GetProfiles(Session, chat.Id, cancellationToken).ConfigureAwait(false);
        if (chatRouletteProfiles is null)
            return null;

        var peerProfile = chatRouletteProfiles.PeerProfile;
        var ownProfile = chatRouletteProfiles.OwnProfile;
        if (peerProfile is null || ownProfile is null)
            return null;

        return new ChatRouletteInfo(peerProfile, chatRouletteProfiles.OwnProfile);
    }

    // Nested types

    public sealed record Model {
        public static readonly Model Loading = new();

        public string Description { get; init; } = "";
        public string PeerOwnName { get; init; } = "";
        public ChatRouletteInfo? ChatRouletteInfo { get; init; }
    }

    public sealed record ChatRouletteInfo(Profile PeerProfile, Profile? OwnProfile);
}
