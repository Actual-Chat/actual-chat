@namespace ActualChat.UI.Blazor.App.Components
@inherits ComputedStateComponent<AppUIHub, RightPanelContent.Model>
@{
    var m = State.Value;
    if (m.ShowSkeletons) { // Chat is null
        <RightPanelSkeleton />
        return;
    }

    var chat = m.Chat;
}

<div class="right-panel">
    <ErrorBarrier Name="RightPanelContent" Kind="@ErrorBarrierKind.Full">
        <RightPanelHeader Chat="@chat" />
        <div class="c-panel-content">
            <RightPanelChatInfo Chat="@chat"/>
            <div class="c-panel-tabs">
                @if (m.ShowTabs) {
                    <TabPanel
                        @key="@chat.Id.Value"
                        TabsClass="left-panel-tabs wide-left-panel-tabs"
                        BottomHill="true">

                        @if (m.ShowMembersTab) {
                            <Tab @key="@("members")" Id="members" Title="Members" Order="0">
                                <AuthorList ChatId="@chat.Id"/>
                            </Tab>
                        }
                        @if (m.ShowThreads) {
                            <Tab @key="@("threads")" Id="threads" Title="Threads" Order="1">
                                <ThreadList ChatId="@chat.Id"/>
                            </Tab>
                        }
                        <Tab @key="@("photo")" Id="photo" Title="Photo" Order="3">
                            <ChatContentItemList ChatId="@chat.Id" KindMask="@(ChatContentKind.Photo)"/>
                        </Tab>
                        <Tab @key="@("video")" Id="video" Title="Video" Order="4">
                            <ChatContentItemList ChatId="@chat.Id" KindMask="@(ChatContentKind.Video)"/>
                        </Tab>
                        <Tab @key="@("files")" Id="files" Title="Files" Order="6">
                            <ChatContentItemList ChatId="@chat.Id" KindMask="@(ChatContentKind.File)"/>
                        </Tab>
                        <Tab @key="@("links")" Id="links" Title="Links" Order="9">
                            <ChatContentItemList ChatId="@chat.Id" KindMask="@(ChatContentKind.Link)"/>
                        </Tab>
                    </TabPanel>
                }
            </div>
            <div class="safe-area-bottom safe-area-bottom-overlay"></div>
        </div>
    </ErrorBarrier>
</div>

@code {
    private IChats Chats => Hub.Chats;

    [ParameterComparer(typeof(ByRefParameterComparer))]
    [Parameter, EditorRequired] public Chat? Chat { get; set; }

    protected override ComputedState<Model>.Options GetStateOptions()
        => ComputedStateComponent.GetStateOptions(GetType(),
            t => new ComputedState<Model>.Options() {
                InitialValue = Chat is null ? Model.Skeletons : Model.Loading(Chat),
                UpdateDelayer = FixedDelayer.NextTick,
                Category = GetStateCategory(t),
            });

    protected override async Task<Model> ComputeState(CancellationToken cancellationToken) {
        var chat = Chat;
        if (chat is null)
            return Model.Skeletons;

        var chatId = chat.Id;
        var rules = await Chats.GetRules(Session, chatId, cancellationToken).ConfigureAwait(false);
        // Disable 'members' tab for the announcements chat
        var showMemberTab = chat.Id != Constants.Chat.AnnouncementsChatId && rules.CanSeeMembers();

        return new () {
            Chat = chat,
            ShowMembersTab = showMemberTab,
        };
    }

    // Nested types

    public sealed record Model {
        public static Model Skeletons = new();
        public static Model Loading(Chat chat) => new() { Chat = chat };

        public Chat? Chat { get; init; }
        [MemberNotNullWhen(false, nameof(Chat))]
        public bool ShowSkeletons => Chat is null;
        public bool ShowThreads => Chat?.Id.Kind is ChatKind.Group or ChatKind.Place;
        public bool ShowTabs => Chat is not null;
        public bool ShowMembersTab { get; init; }
    }
}
