@namespace ActualChat.UI.Blazor.App.Components
@using ActualChat.UI.Blazor.App.Module
@using ActualChat.Contacts
@inherits ComputedStateComponent<AppUIHub, RightPanelHeader.Model>
@{
    var m = State.Value;
    var chat = Chat;
    if (chat is null)
        return;
}

<div @ref="Ref" class="c-header">
    <div class="c-buttons">
        <ButtonRound Click="@OnHideRightPanelClick" Class="right-panel-close-btn btn-sm close-btn">
            <i class="icon-close text-2xl"></i>
        </ButtonRound>
    </div>

    <div class="c-top">
        <ChatIcon
            Chat="@chat"
            Size="SquareSize.SizeFull"
            IsSquare="@true"
            HideTitle="@true"
            IsBlurred="@true"
            ShowPresence="@false"/>
    </div>

    <div class="c-center">
        <div class="chat-avatar">
            <div class="c-wrapper">
                <ChatIcon Chat="@chat" Size="SquareSize.SizeFull" ShowPresence="@false" Class="small-avatar"/>
                @if (_showFullSizeAvatar) {
                    <ChatIcon Chat="@chat" Size="SquareSize.SizeFull" ShowPresence="@false" ShowFullSizeAvatar="@true" Class="full-size-avatar"/>
                }
            </div>
        </div>
        <div class="c-buttons">
            @if (m.PeerContact is not null) {
                @if (m.EnableIncompleteUI) {
                    <ButtonRound
                        Class="btn-sm"
                        Tooltip="Show call"
                        TooltipPosition="FloatingPosition.Top"
                        Click="@OnCallClick">
                        <i class="icon-phone text-2xl"></i>
                    </ButtonRound>
                }
                @if (!m.IsActivePeerChat) {
                    <ButtonRound
                        Class="btn-sm"
                        Tooltip="Start chat"
                        TooltipPosition="FloatingPosition.Top"
                        Click="@OnStartPeerChatClick">
                        <i class="icon-message-ellipse text-2xl"></i>
                    </ButtonRound>
                }
                <ButtonRound
                    Class="btn-sm"
                    data-menu="@(MenuRef.New<ContactActionMenu>(chat.Id.Value).ToString())"
                    data-menu-trigger="@MenuTrigger.Primary"
                    data-menu-placement="@(FloatingPosition.BottomEnd.ToPositionString())">
                    <i class="icon-more-vertical text-2xl"></i>
                </ButtonRound>
            } else {
                @if (EditMembersUI.CanAddMembers(chat)) {
                    <ButtonRound
                        Class="btn-sm"
                        Tooltip="Add members"
                        TooltipPosition="FloatingPosition.Top"
                        Click="@OnInviteClick">
                        <i class="icon-person-add text-2xl"></i>
                    </ButtonRound>
                }
                <ButtonRound
                    Class="btn-sm"
                    data-menu="@(MenuRef.New<ChatHeaderMenu>(chat.Id.Value).ToString())"
                    data-menu-trigger="@MenuTrigger.Primary"
                    data-menu-placement="@(FloatingPosition.BottomEnd.ToPositionString())">
                    <i class="icon-more-vertical text-2xl"></i>
                </ButtonRound>
            }
        </div>
    </div>

    <div class="c-bottom">
        <div class="c-content">
            <div class="c-title">
                @chat.Title
            </div>
            <StatusBadge Chat="@chat"/>
        </div>
        <ChatDescription Chat="@chat"/>
    </div>
</div>

@code {
    private bool _showFullSizeAvatar;
    private ChatId? _previousChatId;
    private static readonly string JSCreateMethod = $"{BlazorUIAppModule.ImportName}.RightPanelHeader.create";

    private Chat? Chat => ChatContext?.Chat;
    private IChats Chats => Hub.Chats;
    private IContacts Contacts => Hub.Contacts;
    private ChatUI ChatUI => Hub.ChatUI;

    private IJSObjectReference? JSRef { get; set; }
    private DotNetObjectReference<RightPanelHeader> BlazorRef { get; set; } = null!;
    private ElementReference Ref { get; set; }

    [CascadingParameter] public ChatContext? ChatContext { get; set; }

    public override ValueTask DisposeAsync() {
        JSRef.DisposeSilentlyAsync("dispose");
        JSRef = null!;
        BlazorRef.DisposeSilently();
        BlazorRef = null!;
        return base.DisposeAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (firstRender) {
            BlazorRef = DotNetObjectReference.Create(this);
            JSRef = await JS.InvokeAsync<IJSObjectReference>(
                JSCreateMethod,
                Ref,
                BlazorRef);
        }
    }

    protected override async Task OnParametersSetAsync() {
        var currentId = Chat?.Id;
        if (_previousChatId != currentId) {
            _showFullSizeAvatar = false;
            _previousChatId = currentId;

            if (JSRef is not null)
                await JSRef.InvokeVoidAsync("clearHeader");
        }
    }

    protected override ComputedState<Model>.Options GetStateOptions()
        => new() {
            InitialValue = Model.Loading,
            UpdateDelayer = FixedDelayer.NextTick,
            Category = GetStateCategory(GetType()),
        };

    protected override async Task<Model> ComputeState(CancellationToken cancellationToken) {
        var chatId = Chat?.Id;
        if (chatId is null)
            return Model.Loading;

        var authorRules = await Chats.GetRules(Session, chatId, cancellationToken).ConfigureAwait(false);
        var shareModel = await ShareUI.GetModel(chatId, cancellationToken).ConfigureAwait(false);
        Contact? peerContact = null;
        var isActivePeerChat = false;
        if (chatId is PeerChatId) {
            peerContact = await Contacts.GetForChat(Session, chatId, cancellationToken).ConfigureAwait(false);
            var selectedChatId = await ChatUI.SelectedChatId.Use(cancellationToken).ConfigureAwait(false);
            isActivePeerChat = selectedChatId == chatId;
        }
        var enableIncompleteUI = await Features.IsIncompleteUIEnabled(cancellationToken).ConfigureAwait(false);
        return new Model(authorRules.CanEditProperties(), shareModel, peerContact, isActivePeerChat, enableIncompleteUI);
    }

    private void OnHideRightPanelClick()
        => PanelsUI.Right.SetIsVisible(false);

    private void OnInviteClick()
        => _ = ModalUI.Show(new AddMemberModal.Model(Chat!.Id));

    private Task OnStartPeerChatClick()
        => History.NavigateTo(Links.Chat(Chat!.Id));

    private Task OnCallClick()
        => Task.CompletedTask;

    [JSInvokable]
    public void FullSizeAvatarHandler(bool show) {
        if (_showFullSizeAvatar == show)
            return;

        _showFullSizeAvatar = show;
        StateHasChanged();
    }

    // Nested types

    public sealed record Model(
        bool CanEditProperties,
        ShareModalModel? ShareModel,
        Contact? PeerContact,
        bool IsActivePeerChat,
        bool EnableIncompleteUI) {
        public static readonly Model Loading = new (false, null, null, false, false);
    }
}
