@namespace ActualChat.UI.Blazor.App.Components
@inherits ComputedStateComponent<AppUIHub, ChatSidePanelInfo.Model>
@{
    if (State.IsInitial(out var m))
        return;
}

<div class="c-chat-info">
    @if (m.ShowSummarizationToggle || m.ShowPttToggle || m.RetentionPeriod is not null) {
        <Card>
            @if (m.ShowSummarizationToggle) {
                var iconCls = m.IsSummarized ? "text-primary" : "text-03";
                <TileItem ToggleValue="@m.IsSummarized"
                          ToggleValueChanged="@OnSummarizeToggleChanged"
                          ToggleDisabled="@(!m.IsOwner)">
                    <Icon><i class="text-xl icon-ai-stars @iconCls"></i></Icon>
                    <Content>@L.RightPanel_Summarize</Content>
                    <Caption>@GetStateCaption(m.IsSummarized, m.IsOwner)</Caption>
                </TileItem>
            }
            @if (m.ShowPttToggle) {
                var pttIconCls = m.IsPttEnabled ? "text-primary" : "text-03";
                <TileItem ToggleValue="@m.IsPttEnabled"
                          ToggleValueChanged="@OnPttToggleChanged"
                          ToggleDisabled="@(!m.IsOwner)">
                    <Icon><i class="text-xl icon-push-to-talk @pttIconCls"></i></Icon>
                    <Content>@L.VoiceSettings_Ptt</Content>
                    <Caption>@GetStateCaption(m.IsPttEnabled, m.IsOwner)</Caption>
                </TileItem>
            }
            @if (m.RetentionPeriod is { } retention) {
                <TileItem
                    Class="item-retention"
                    IsHoverable="@m.CanManageHistory"
                    Click="@OnHistoryRetentionClick">
                    <Icon><i class="text-xl icon-history text-primary"></i></Icon>
                    <Content>@L.HistoryRetention_Title</Content>
                    <Caption>@L.PeriodText(retention)</Caption>
                    <Right>
                        @if (m.CanManageHistory) {
                            <i class="icon-chevron-right text-xl"></i>
                        }
                    </Right>
                </TileItem>
            }
        </Card>
    }
</div>

@code {
    private Chat Chat => ChatContext!.Chat;

    [CascadingParameter] public ChatContext? ChatContext { get; set; }
    [CascadingParameter] public ScreenSize ScreenSize { get; set; }

    protected override async Task<Model> ComputeState(CancellationToken cancellationToken) {
        var chat = Chat;
        if (chat.HasSingleAuthor || !chat.IsMember())
            return new() { RetentionPeriod = chat.RetentionPeriod };

        var isOwner = chat.Rules.IsOwner() || chat.Kind == ChatKind.Peer;
        var isSummarized = chat.IsSummarized ?? false;
        var isPttEnabled = chat.PttEnabledAt != null;
        // Non-owners see turned-on settings as read-only facts; turned-off ones are hidden entirely.
        return new() {
            IsOwner = isOwner,
            ShowSummarizationToggle = isOwner || isSummarized,
            IsSummarized = isSummarized,
            ShowPttToggle = !chat.Id.IsThread() && (isOwner || isPttEnabled),
            IsPttEnabled = isPttEnabled,
            RetentionPeriod = chat.RetentionPeriod,
            CanManageHistory = chat.CanManageHistory(),
        };
    }

    private Task OnSummarizeToggleChanged(bool isSummarized) {
        if (!State.Value.IsOwner || State.Value.IsSummarized == isSummarized)
            return Task.CompletedTask;

        var update = Change.Update<ChatDiff>(new() { IsSummarized = isSummarized });
        return UICommander.Run(new Chats_Change {
            Session = Session,
            ChatId = Chat.Id,
            ExpectedVersion = null,
            Change = update,
        });
    }

    private async Task OnPttToggleChanged(bool isPttEnabled) {
        var chat = Chat;
        if (chat is null || !State.Value.IsOwner || State.Value.IsPttEnabled == isPttEnabled)
            return;

        // A non-null value is just a "turn it on" sentinel - the server stamps the real epoch.
        var pttEnabledAt = isPttEnabled ? (Moment?)Clocks.SystemClock.Now : null;
        var update = Change.Update<ChatDiff>(new() { PttEnabledAt = pttEnabledAt });
        var (newChat, error) = await UICommander.Run(new Chats_Change {
            Session = Session,
            ChatId = chat.Id,
            ExpectedVersion = null,
            Change = update,
        });
        if (error != null)
            return;

        if (!isPttEnabled) {
            await UserSettingsUI.UserPttSettings()
                .Update(x => x.WithoutPttChat(chat.Id), CancellationToken.None);
            return;
        }

        if (newChat?.PttEnabledAt is not { } enabledAt)
            return;

        // Flipping the toggle is itself consent: auto-arm the owner with the server-stamped epoch.
        // At capacity that consent can't be honoured, and dropping another chat to make room would
        // silently cost the owner its wake-ups - so the chat stays on and only the arming waits.
        // The consented set, not the armed one: WithOnlyPttChats drops whatever it doesn't get, and
        // the armed set leaves out muted chats (and everything, on a device with PTT off).
        var pttChatIds = await Hub.ChatAudioUI.GetConsentedPttChatIds(CancellationToken.None).ConfigureAwait(true);
        if (pttChatIds.Count >= UserPttSettings.MaxChatCount && !pttChatIds.Contains(chat.Id)) {
            ToastUI.Show(
                L.Ptt_ChatAtCapacity_Format(UserPttSettings.MaxChatCount),
                "icon-alert-circle",
                ToastDismissDelay.Long);
            return;
        }

        await UserSettingsUI.UserPttSettings().Update(
            x => x.WithOnlyPttChats(pttChatIds.ToHashSet()).WithPttChat(chat.Id, enabledAt),
            CancellationToken.None);
    }

    private Task OnHistoryRetentionClick()
        => State.Value.CanManageHistory
            ? ModalUI.Show(new ChatHistoryRetentionModal.Model(Chat.Id))
            : Task.CompletedTask;

    private string GetStateCaption(bool isOn, bool isOwner) {
        var state = isOn ? L.RightPanel_On : L.RightPanel_Off;
        return isOwner ? state : L.RightPanel_StateByChatOwner_Format(state);
    }

    // Nested types

    public sealed record Model {
        public bool IsOwner { get; init; }
        public bool IsSummarized { get; init; }
        public bool ShowSummarizationToggle { get; init; }
        public bool IsPttEnabled { get; init; }
        public bool ShowPttToggle { get; init; }
        public TimeSpan? RetentionPeriod { get; init; }
        public bool CanManageHistory { get; init; }
    }
}
