@namespace ActualChat.UI.Blazor.App.Components
@using System.Linq.Expressions
@implements IDisposable
@{
    var messages = CurrentEditContext.GetValidationMessages(_fieldIdentifier).ToList();
    var isInvalid = messages.Any();
    var validationCls = "";
    var message = "";
    if (isInvalid) {
        validationCls = "invalid";
        message = messages.First();
    } else {
        var hint = ToHint(_userLinkIsAvailable);
        if (hint != null) {
            validationCls = hint.Class;
            message = hint.Message;
        }
    }
}
<div class="form-section-validation @validationCls">@message</div>

@code {
    private readonly EventHandler<ValidationStateChangedEventArgs>? _validationStateChangedHandler;
    private EditContext? _previousEditContext;
    private Expression<Func<string>>? _previousFieldAccessor;
    private FieldIdentifier _fieldIdentifier;
    private bool? _userLinkIsAvailable;

    [Inject] private ChatUIHub Hub { get; init; } = null!;

    [CascadingParameter] EditContext CurrentEditContext { get; set; } = default!;

    [Parameter, EditorRequired] public Expression<Func<string>>? For { get; set; }
    [Parameter, EditorRequired] public UserLinkKind Kind { get; set; } = null!;
    [Parameter] public string CurrentUserLinkId { get; set; } = "";
    [Parameter, EditorRequired] public Func<string> GetUserLinkIdFunc { get; set; } = null!;

    public UserLinkValidationMessage() {
        _validationStateChangedHandler = (sender, eventArgs) => {
            _ = CheckUserLinkAvailability();
            StateHasChanged();
        };
    }

    protected override void OnParametersSet() {
        if (CurrentEditContext == null)
            throw StandardError.Internal(
                $"{GetType()} requires a cascading parameter " +
                $"of type {nameof(EditContext)}. For example, you can use {GetType()} inside " +
                $"an {nameof(EditForm)}.");

        if (For == null)
            throw StandardError.Internal($"{GetType()} requires a value for the {nameof(For)} parameter.");

        if (For != _previousFieldAccessor) {
            _fieldIdentifier = FieldIdentifier.Create(For);
            _previousFieldAccessor = For;
        }

        if (CurrentEditContext != _previousEditContext) {
            DetachValidationStateChangedListener();
            CurrentEditContext.OnValidationStateChanged += _validationStateChangedHandler;
            _previousEditContext = CurrentEditContext;
        }
    }

    void IDisposable.Dispose() {
        DetachValidationStateChangedListener();
    }

    private void DetachValidationStateChangedListener() {
        if (_previousEditContext != null) {
            _previousEditContext.OnValidationStateChanged -= _validationStateChangedHandler;
        }
    }

    private async Task CheckUserLinkAvailability()
    {
        _userLinkIsAvailable = null;

        var actualUserLinkId = GetUserLinkIdFunc();
        var sUserLinkId = actualUserLinkId;
        if (sUserLinkId.IsNullOrEmpty())
            return;

        if (OrdinalEquals(sUserLinkId, CurrentUserLinkId))
            return;

        if (!UserLinkId.TryParse(sUserLinkId, out var userLinkId))
            return;

        if (ReferenceEquals(Kind, UserLinkKind.AccountLink)) {
            var userId = await Hub.UserLinks.GetUserIdByUserLink(userLinkId).ConfigureAwait(true);
            _userLinkIsAvailable = userId.IsNone;
        } else if (Kind.PlaceId.IsNone) {
            var userLinkRef = await Hub.UserLinks.GetUserLinkRef(userLinkId).ConfigureAwait(true);
            _userLinkIsAvailable = userLinkRef.IsNone;
        } else {
            var placeChatId = await Hub.UserLinks.GetPlaceChatIdByUserLink(Kind.PlaceId, userLinkId).ConfigureAwait(true);
            _userLinkIsAvailable = placeChatId.IsNone;
        }

        StateHasChanged();
    }

    private static FormSectionHint? ToHint(bool? userLinkIsAvailableHint)
    {
        if (!userLinkIsAvailableHint.HasValue)
            return null;

        return userLinkIsAvailableHint.Value
            ? new FormSectionHint("This link is available.", "success")
            : new FormSectionHint("This link is already in use.", "invalid");
    }

    private record FormSectionHint(string Message, string Class = "");

    public record UserLinkKind(PlaceId PlaceId) {
        public static readonly UserLinkKind AccountLink = new (PlaceId.None);
        public static readonly UserLinkKind PlaceLink = new (PlaceId.None);
        public static UserLinkKind ChatLink(PlaceId placeId) => new (placeId);
    }
}
