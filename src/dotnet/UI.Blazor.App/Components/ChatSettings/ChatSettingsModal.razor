@namespace ActualChat.UI.Blazor.App.Components
@implements IModalView<ChatSettingsModal.Model>

<DiveInDialogFrame
    HasCloseButton="true"
    Class="edit-settings-modal edit-chat-settings-modal fixed-height"
    BodyClass="no-scrollbar"
    StartPage="@StartPage" />

@code {
    [Parameter] public Model ModalModel { get; set; } = null!;

    private DiveInDialogPage StartPage => ModalModel.IsOwnerHandover
        ? DiveInDialogPage.New<EditChatMembersModalPage>(ModalModel.ChatId)
        : DiveInDialogPage.New<ChatSettingsStartModalPage>(ModalModel.ChatId);

    public sealed record Model(ChatId ChatId) {
        public bool IsOwnerHandover { get; init; }
    }
}
