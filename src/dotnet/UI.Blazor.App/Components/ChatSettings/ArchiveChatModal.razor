@namespace ActualChat.UI.Blazor.App.Components
@inherits ComponentBase<AppUIHub>
@implements IModalView<ArchiveChatModal.Model>

<DialogFrame Title="@L.ArchiveChat_Title" Class="archive-chat-modal compact-header modal-sm">
    <Body>
    <FormBlock>
        <p>@L.ArchiveChat_Text_Format(ModalModel.Chat.Title)</p>
        @* Checkbox cancels its own click, so the toggle belongs to the element around it *@
        <div class="c-disable-notifications" @onclick="@(() => _mustDisableNotifications = !_mustDisableNotifications)">
            <Checkbox
                Label="@L.ArchiveChat_DisableNotifications"
                IsChecked="@_mustDisableNotifications"/>
        </div>
    </FormBlock>
    </Body>
    <Buttons>
        <Button Class="btn-modal" Click="OnCancel">@L.Common_Cancel</Button>
        <Button Class="btn-modal btn-primary" Click="OnArchive">@L.ChatMenu_Archive</Button>
    </Buttons>
</DialogFrame>

@code {
    private bool _mustDisableNotifications;

    [CascadingParameter] public Modal Modal { get; set; } = null!;
    [Parameter] public Model ModalModel { get; set; } = null!;

    private void OnCancel()
        => Modal.Close();

    private void OnArchive() {
        Modal.Close();
        _ = Hub.ChatUI.Archive(ModalModel.Chat.Id, _mustDisableNotifications);
    }

    // Nested types

    public sealed record Model(Chat Chat);
}
