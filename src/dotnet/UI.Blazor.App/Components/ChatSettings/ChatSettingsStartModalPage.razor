@namespace ActualChat.UI.Blazor.App.Components
@using ActualChat.Media
@inherits ComputedStateComponent<AppUIHub, ChatSettingsStartModalPage.ComputedModel>
@{
    if (State.IsInitial(out var m))
        return;
    if (m.Chat == null || !m.Chat.Rules.CanEditProperties()) {
        Context.Close();
        return;
    }
    if (_form == null)
        return;

    Context.ContextItems.Set(nameof(ComputedModel.MemberCount), m.MemberCount);
    var isPlaceChat = m.IsPlace;
    var publicChatLabel = !isPlaceChat ? L.Chat_Public : L.Chat_TypePlace;
    var isThread = m.Chat.Id.IsThread();
    var canEditChatPic = !isThread;
    var canEditChatType = !isThread && m.IsOwner;
}

<Form Class="h-full" @ref="@_formRef" Model="@_form">
    @{
        _submitButtonInfo.CanExecute = _formRef?.IsValid ?? false;
    }
    <DataAnnotationsValidator/>
    @if (canEditChatPic) {
        <FormBlock Class="chat-settings-header">
            <div class="c-top">
                <ChatIcon
                    Chat="@m.Chat"
                    Size="SquareSize.SizeFull"
                    IsSquare="@true"
                    HideTitle="@true"
                    IsBlurred="@true"
                    ShowPresence="@false"/>
                <ButtonRound
                    Click="@(() => Context.Close())"
                    Class="btn-sm right-panel-close-btn close-btn">
                    <i class="icon-close text-2xl"></i>
                </ButtonRound>
            </div>
            <div class="c-center">
                <Pic
                    Title="@_form.Title"
                    Picture="@_form.Picture"
                    Size="@SquareSize.Size16"
                    AvatarKind="@_avatarKind"
                    AvatarKey="@_avatarKey"/>

                <div class="c-buttons">
                    <ButtonRound Class="btn-sm" Click="@(() => _avatarPicker!.Pick())">
                        <i class="icon-person-add-2 text-2xl"></i>
                    </ButtonRound>
                    <ImageCropPicker @ref="_avatarPicker"
                        Scope="@_form!.ImageScope"
                        OnCropped="@OnImagePicked" />
                </div>
            </div>
        </FormBlock>
    }

    <FormBlock>
        <FormSection Class="field-chat-title" For="() => _form.Title" InputId="@_form.TitleId" IsLabelInsideInput="true" Label="@L.Form_ChatTitle">
            <TextBox
                @bind-Value="@_form.Title"
                Id="@_form.TitleId"
                ClearButton="true"/>
        </FormSection>
        <FormSection Class="field-chat-title" For="() => _form.Description" InputId="@_form.DescriptionId" IsLabelInsideInput="true" Label="@L.Form_ChatDescription">
            <TextBox
                @bind-Value="@_form.Description"
                Id="@_form.DescriptionId"
                ClearButton="true"/>
        </FormSection>
    </FormBlock>

    <div class="chat-settings-container">
        @if (canEditChatType) {
            <TileItem Click="OnManageChatTypeClick" Class="chat-type-tile-item">
                <Icon>
                    <i class="icon-key text-xl"></i>
                </Icon>
                <Content>
                    @L.Chat_TypeTitle
                </Content>
                <Right>
                    @(m.IsPublic ? publicChatLabel : L.Chat_Private)
                </Right>
            </TileItem>
        }

        @if (m.Chat.Rules.CanEditMembers()) {
            @if (!m.Chat.IsPublicPlaceChat()) {
                <TileItem Class="item-manage-members" Click="OnManageMembersClick">
                    <Icon>
                        <i class="icon-people"></i>
                    </Icon>
                    <Content>
                        @L.Place_MembersLabel(m.MemberCount, m.MemberCount)
                    </Content>
                    <Right>
                        <i class="icon-chevron-right text-3xl"></i>
                    </Right>
                </TileItem>
            } else {
                <TileItem Class="item-manage-members">
                    <Icon>
                        <i class="icon-people"></i>
                    </Icon>
                    <Content>
                        @L.Place_MembersLabel(m.MemberCount, m.MemberCount)
                    </Content>
                    <Caption>
                        @L.ChatSettings_UsePlaceSettingsForMembers
                    </Caption>
                </TileItem>
            }

            @if (m is { IsOwner: true, Chat: not null } && !_isPlaceWelcomeChat) {
                <TileItem Class="item-archive-chat item-danger" Click="@(() => OnArchiveChatClick(m.Chat))">
                    <Icon><i class="icon-history"></i></Icon>
                    <Content>@L.Chat_ArchiveTitle</Content>
                </TileItem>

                <TileItem Class="item-leave-group item-danger" Click="@(() => OnDeleteChatClick(m.Chat))">
                    <Icon><i class="icon-log-out"></i></Icon>
                    <Content>@L.ChatSettings_LeaveChatAndDelete</Content>
                </TileItem>
            }
        }
        else if (m.CanRemoveThread) {
            <TileItem Class="item-leave-group item-danger" Click="@(() => OnDeleteThreadClick(m.Chat))">
                <Icon><i class="icon-trash02"></i></Icon>
                <Content>@L.LeaveConfirm_DeleteThreadTitle</Content>
            </TileItem>
        }
    </div>
</Form>

@code {
    private Form?_formRef;
    private FormModel? _form;
    private DialogButtonInfo _submitButtonInfo = null!;
    private ImageCropPicker? _avatarPicker;
    private AvatarKind _avatarKind;
    private string? _avatarKey;
    private PlaceId? _placeId;
    private bool _isPlaceWelcomeChat;

    private IChats Chats => Hub.Chats;
    private IAuthors Authors => Hub.Authors;
    private ChatUI ChatUI => Hub.ChatUI;

    [CascadingParameter] public DiveInModalPageContext Context { get; set; } = null!;

    private ChatId ChatId { get; set; } = null!;

    protected override void OnInitialized() {
        ChatId = Context.GetModel<ChatId>();
        Context.Title = L.Chat_SettingsTitle;
        if (ChatId is PeerChatId)
            throw StandardError.NotSupported("Peer chat is not supported.");

        _avatarKind = AvatarKind.Marble;
        _avatarKey = ChatId.Value;
        _submitButtonInfo = DialogButtonInfo.CreateSubmitButton(L.Common_Save, OnSubmit);
        Context.Buttons = [DialogButtonInfo.CreateCancelButton(L), _submitButtonInfo];
    }

    protected override async Task OnInitializedAsync() {
        _form = Context.Items.KeylessGet<FormModel>();
        if (_form is not null)
            return;

        var chat = await Hub.Chats.Get(Session, ChatId, default).Require();
        _form = new FormModel(ComponentIdGenerator) {
            Title = chat.Title,
            Description = chat.Description,
            Picture = chat.Picture?.ToPicture(),
            ImageScope = MediaUploadScopes.ForChat(chat.Id),
        };
        _placeId = (chat.Id as PlaceChatId)?.PlaceId;
        if (_placeId is not null)
            _isPlaceWelcomeChat = chat.IsWelcome;
        Context.Items.KeylessSet(_form);
    }

    protected override ComputedState<ComputedModel>.Options GetStateOptions()
        => ComputedStateComponent.GetStateOptions(GetType(),
            static t => new ComputedState<ComputedModel>.Options() {
                UpdateDelayer = FixedDelayer.NextTick,
                Category = GetStateCategory(t),
            });

    protected override async Task<ComputedModel> ComputeState(CancellationToken cancellationToken) {
        var chatId = ChatId;

        var chat = await Chats.Get(Session, chatId, cancellationToken).ConfigureAwait(false);
        if (chat == null)
            return new ComputedModel { Chat = null };

        if (chat.Id.IsThread(out var threadChatId)) {
            var parentChat = await Chats.Get(Session, threadChatId.GetOutermostParent(), cancellationToken).ConfigureAwait(false);
            return new ComputedModel { Chat = chat, CanRemoveThread = parentChat?.Rules.IsOwner() ?? false };
        }

        if (!chat.Rules.CanEditProperties())
            return new() { Chat = chat };

        var allAuthorIds = await Authors.ListAuthorIds(Session, chatId, cancellationToken);
        var isPublic = chat.IsPublic;
        _placeId = (chat.Id as PlaceChatId)?.PlaceId;
        var isPlace = _placeId is not null;

        return new() {
            Chat = chat,
            IsOwner = chat.Rules.IsOwner(),
            MemberCount = allAuthorIds.Length,
            IsPublic = isPublic,
            IsPlace = isPlace,
            IsAdmin = AccountUI.OwnAccount.Value.IsAdmin,
        };
    }

    private void OnImagePicked(MediaRef mediaRef) {
        _form!.Picture = new (mediaRef);
    }

    private void OnManageChatTypeClick()
        => Context.StepIn(DiveInDialogPage.New<EditChatTypeModalPage>(ChatId));

    private void OnManageMembersClick()
        => Context.StepIn(DiveInDialogPage.New<EditChatMembersModalPage>(ChatId));

    private void OnDeleteChatClick(Chat chat)
        => ChatUI.DeleteChat(chat);

    private void OnDeleteThreadClick(Chat chat)
        => ChatUI.DeleteThread(chat);

    private void OnArchiveChatClick(Chat chat)
        => ChatUI.ArchiveChat(chat);

    private async Task OnSubmit() {
        if (_formRef == null)
            return;
        if (!_formRef.IsValid)
            return;
        await Save();
        Context.Close();
    }

    private async Task Save() {
        var chat = await Chats.Get(Session, ChatId, default).Require();
        var newChat = chat with {
            Title = _form!.Title,
            Description = _form!.Description,
            MediaId = _form.Picture?.MediaRef?.MediaId,
        };
        var command = new Chats_Change {
            Session = Session,
            ChatId = chat.Id,
            ExpectedVersion = chat.Version,
            Change = new() {
                Update = DiffEngine.Diff<Chat, ChatDiff>(chat, newChat),
            },
        };
        await Hub.UICommander.Run(command);
    }

    // Nested types

    [UnconditionalSuppressMessage("ReflectionAnalysis", "IL2026:RequiresUnreferencedCode", Justification = "String.Count should be preserved.")]
    public sealed class FormModel {
        [Required]
        public string Title { get; set; } = "";

        public string Description { get; set; } = "";
        public Picture? Picture { get; set; }
        public string ImageScope { get; init; } = "";

        public string FormId { get; }
        public string TitleId { get; }
        public string DescriptionId { get; }

        public FormModel(ComponentIdGenerator componentIdGenerator) {
            FormId = componentIdGenerator.Next("new-chat-form");
            TitleId = $"{FormId}-title";
            DescriptionId = $"{FormId}-description";
        }
    }

    public sealed record ComputedModel {
        public static readonly ComputedModel Loading = new();

        public Chat? Chat { get; init; }
        public bool IsOwner { get; init; }
        public int MemberCount { get; init; }
        public bool IsPublic { get; init; }
        public bool IsPlace { get; init; }
        public bool IsAdmin { get; init; }
        public bool CanRemoveThread { get; init; }
    }
}
