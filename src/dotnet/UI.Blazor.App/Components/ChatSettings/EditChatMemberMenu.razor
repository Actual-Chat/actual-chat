@namespace ActualChat.UI.Blazor.App.Components
@inherits ComputedMenuBase<AppUIHub, EditChatMemberModel?>
@{
    var m = State.Value;
    if (m == null)
        return;
    var statusText = m.IsOwner ? "Owner" : m.IsModerator ? "Moderator" : null;
}

<div class="edit-member-menu edit-chat-member-menu">

    <AuthorBadge
        AuthorId="@AuthorId"
        ShowPresence="true"
        StatusText="@statusText"/>

    @if (m.CanPromoteToOwner) {
        <MenuEntry
            Icon="icon-star"
            Text="Promote to Owner"
            Click="@(() => OnPromoteToOwnerClick(m.Author))">
        </MenuEntry>
    }

    @if (m.CanSetModerator) {
        <MenuEntry
            Icon="icon-star-2"
            Text="@(m.IsModerator ? "Remove Moderator" : "Make Moderator")"
            Click="@(() => OnSetModeratorClick(m.Author, !m.IsModerator))">
        </MenuEntry>
    }

    @if (m.CanRemoveFromGroup) {
        <MenuEntrySeparator/>
        <MenuEntry
            Class="warning-item"
            Icon="icon-minus-circle"
            Text="Remove from group"
            Click="@(() => OnRemoveFromGroupClick(m.Author))">
        </MenuEntry>
    }

</div>

@code {
    private AuthorId AuthorId { get; set; } = null!;

    protected override async Task OnParametersSetAsync() {
        if (Arguments is not [ var sAuthorId ])
            throw new ArgumentOutOfRangeException(nameof(Arguments));

        AuthorId = AuthorId.Parse(sAuthorId);
        await base.OnParametersSetAsync();
    }

    protected override Task<EditChatMemberModel?> ComputeState(CancellationToken cancellationToken)
        => EditChatMemberCommands.ComputeState(Hub, AuthorId, cancellationToken);

    private Task OnRemoveFromGroupClick(Author author)
        => EditChatMemberCommands.OnRemoveFromGroupClick(Hub, author);

    private async Task OnPromoteToOwnerClick(Author author) {
        await WhenClosed;
        await EditChatMemberCommands.OnPromoteToOwnerClick(Hub, author);
    }

    private async Task OnSetModeratorClick(Author author, bool isModerator) {
        await WhenClosed;
        await EditChatMemberCommands.OnSetModeratorClick(Hub, author, isModerator);
    }
}
