@namespace ActualChat.UI.Blazor.App.Components
@using ActualChat.Search
@inherits ComputedStateComponent<AppUIHub, EditChatMembersModalPage.ComputedModel>
@{
    var m = State.Value;
    Context.Title = _isOwnerHandover
        ? L.LeaveConfirm_PickNewOwnerTitle
        : L.Place_Members(m.MemberCount, m.MemberCount);
    Context.ContextItems.Set(nameof(ChatSettingsStartModalPage.ComputedModel.MemberCount), m.MemberCount);
}

<SearchBox
    Class="icon-align-right"
    Placeholder="@L.Common_Search"
    MaxLength="@Constants.Chat.MaxSearchFilterLength"
    TextChanged="@OnFilter"/>

<div class="member-list no-scrollbar">
    @foreach (var authorId in m.AuthorIds) {
        var isOwn = m.IsOwn(authorId);
        var isOwner = m.IsOwner(authorId);
        var statusText = FormatStatusText(isOwner, m.IsModerator(authorId), isOwn);
        /* At the moment there is no available actions for owners and own membership hence do not show menu  */
        /* Handing the chat over is a single choice, so the row itself takes it and the menu only distracts */
        var showMenu = !_isOwnerHandover && !(isOwn || isOwner);
        var dataMenuAttr = showMenu ? MenuRef.New<EditChatMemberMenu>(authorId.Value).ToString() : null;
        <li @key="@authorId"
            class="@(_isOwnerHandover ? "candidate" : null)"
            data-menu="@dataMenuAttr"
            data-menu-placement="@(FloatingPosition.BottomStart.ToPositionString())"
            @onclick="@(() => OnCandidateClick(authorId))">
            <AuthorBadge
                AuthorId="@authorId"
                ShowPresence="true"
                StatusText="@statusText" />
            @if (dataMenuAttr != null) {
                <div class="menu"
                     data-menu="@dataMenuAttr"
                     data-menu-trigger="@MenuTrigger.Primary"
                     data-menu-placement="@(FloatingPosition.RightStart.ToPositionString())">

                    <HeaderButton>
                        <i class="icon-more-vertical text-2xl"></i>
                    </HeaderButton>
                </div>
            } else {
                <div class="menu"></div>
            }
        </li>
    }
</div>

@code {
    private SearchQuery _searchQuery;
    private bool _isOwnerHandover;
    private ChatId ChatId { get; set; } = null!;

    private IAuthors Authors => Hub.Authors;
    private IRoles Roles => Hub.Roles;

    [CascadingParameter] public DiveInModalPageContext Context { get; set; } = null!;

    protected override void OnInitialized() {
        var model = Context.GetModel<Model>();
        ChatId = model.ChatId;
        _isOwnerHandover = model.IsOwnerHandover;
        if (ChatId is PeerChatId)
            throw StandardError.NotSupported("Peer chat id should not be provided.");
        Context.Class = "edit-members";
        Context.Buttons = [DialogButtonInfo.CreateSubmitButton(L.Place_AddMembers, OnInviteClick)];
    }

    private void OnFilter(string filter) {
        _searchQuery = new SearchQuery(filter);
        _ = State.Recompute();
    }

    protected override ComputedState<ComputedModel>.Options GetStateOptions()
        => new() {
            InitialValue = new ComputedModel {
                // Try to use stored members count to avoid header title blinking
                MemberCount = Context.ContextItems.Get(nameof(ChatSettingsStartModalPage.ComputedModel.MemberCount), 1),
            },
            Category = GetStateCategory(GetType()),
        };

    protected override async Task<ComputedModel> ComputeState(CancellationToken cancellationToken) {
        var chatId = ChatId;
        var searchQuery = _searchQuery;

        var allAuthorIds = await Authors.ListAuthorIds(Session, chatId, cancellationToken).ConfigureAwait(false);
        var ownerIds = await Roles.ListOwnerIds(Session, chatId, cancellationToken).ConfigureAwait(false);
        var moderatorIds = await Roles.ListModeratorIds(Session, chatId, cancellationToken).ConfigureAwait(false);
        var ownAuthor = await Authors.GetOwn(Session, chatId, cancellationToken).ConfigureAwait(false);
        // Opened to hand the chat over, the list is the candidates - and the Owner being replaced isn't one.
        // The count in the header still counts them, since it's the chat's size rather than the list's.
        var listedAuthorIds = _isOwnerHandover && ownAuthor != null
            ? allAuthorIds.Where(c => c != ownAuthor.Id)
            : allAuthorIds;
        var authors = (await listedAuthorIds
            .Select(async authorId => {
                var authorTask = Authors.Get(Session, chatId, authorId, cancellationToken);
                var author = await authorTask.ConfigureAwait(false);
                var authorName = author?.Avatar.Name ?? "";
                return (authorId, authorName);
            })
            .Collect(ApiConstants.Concurrency.High, cancellationToken)
            .ConfigureAwait(false)) // Add concurrency
            .ToList();

        if (searchQuery.IsEmpty) {
            authors.Sort((Comparison<(AuthorId, string)>)Compare);
        } else {
            authors = authors
                .WithSearchMatchRank(searchQuery, c => new SearchDocument(c.authorName))
                .FilterBySearchMatchRank()
                .OrderBySearchMatchRank()
                .WithoutSearchMatchRank()
                .ToList();
        }

        return new() {
            MemberCount = allAuthorIds.Length,
            AuthorIds = authors.Select(c => c.Item1).ToArray(),
            OwnerIds = ownerIds,
            ModeratorIds = moderatorIds,
            OwnAuthorId = ownAuthor?.Id,
        };

        int Compare((AuthorId, string) info1, (AuthorId, string) info2)
            => string.Compare(info1.Item2, info2.Item2);
    }

    private async Task OnCandidateClick(AuthorId authorId) {
        // Promoting closes this page, which resumes the leave that sent the user here
        if (!_isOwnerHandover)
            return;

        var author = await Authors.Get(Session, ChatId, authorId, default).ConfigureAwait(true);
        if (author != null)
            await EditChatMemberCommands.OnPromoteToOwnerClick(Hub, author, Context.Close).ConfigureAwait(true);
    }

    private void OnInviteClick()
        => Context.StepIn(DiveInDialogPage.New<AddMemberModalPage>(ChatId));

    private string? FormatStatusText(bool isOwner, bool isModerator, bool isOwn) {
        var statusText = isOwner ? L.Members_Owner : isModerator ? L.Members_Moderator : null;
        if (isOwn)
            statusText = statusText != null
                ? L.Members_StatusOwn_Format(statusText)
                : L.Members_YourProfile;
        return statusText;
    }

    // Nested types

    public sealed record Model(ChatId ChatId) {
        public bool IsOwnerHandover { get; init; }
    }

    public sealed record ComputedModel {
        public int MemberCount { get; init; }
        public AuthorId[] AuthorIds { get; init; } = [];
        public AuthorId[] OwnerIds { get; init; } = [];
        public AuthorId[] ModeratorIds { get; init; } = [];
        public AuthorId? OwnAuthorId { get; init; }

        public bool IsOwner(AuthorId authorId)
            => OwnerIds.Contains(authorId);
        public bool IsModerator(AuthorId authorId)
            => ModeratorIds.Contains(authorId);
        public bool IsOwn(AuthorId authorId)
            => OwnAuthorId is not null && OwnAuthorId.Equals(authorId);
    }
}
