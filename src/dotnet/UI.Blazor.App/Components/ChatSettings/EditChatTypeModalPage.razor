@namespace ActualChat.UI.Blazor.App.Components
@inherits ComputedStateComponent<AppUIHub, EditChatTypeModalPage.ComputedModel>
@{
#pragma warning disable IL2091

    if (State.IsInitial(out var m))
        return;

    if (m.Chat == null || !m.Chat.Rules.IsOwner()) {
        Context.Close();
        return;
    }
    if (_form == null || _editContext == null)
        return;

    Context.Title = "Chat Type";
    var isPlaceChat = _placeId is not null;
    var canChangeChatType = _placeId is null
        || _place is not null && _place.Rules.CanApplyPublicChatType() && !_isPlaceWelcomeChat;
    var publicChatLabel = !isPlaceChat ? "Public chat" : "Place chat";
    var publicChatHint = !isPlaceChat ?
        "Anyone can join this chat by navigating to its URL" :
        "All members of this Place will see it in Place's chat list and will be able to talk there";
    var onMakeChatPublicClick = canChangeChatType ? EventCallback.Factory.Create(this, () => OnPublicChatClick(true)) : new EventCallback(null, null);
    var onMakeChatPrivateClick = canChangeChatType ? EventCallback.Factory.Create(this, () => OnPublicChatClick(false)) : new EventCallback(null, null);
}

<Form Class="h-full" @ref="@_formRef" EditContext="@_editContext">
    @{
        _submitButtonInfo.CanExecute = _formRef?.IsValid ?? false;
    }
    <DataAnnotationsValidator />
    <FormBlock Class="with-input-radio first">
        <InputRadioGroup Name="chat_type" DisplayName="Chat type" @bind-Value="_form.IsPublic">
            <TileItem
                Class="@(_form.IsPublic ? "clickable selected" : "clickable")"
                Click="@onMakeChatPublicClick">
                <Icon>
                    <FormRadio Id="@_form.IsPublicTrueFormId" IsDisabled="@(!canChangeChatType)" Value="@true" />
                </Icon>
                <Content>
                    <Label InputId="@_form.IsPublicTrueFormId" Text="@publicChatLabel" IsRequired="true"></Label>
                </Content>
                <Caption>
                    @publicChatHint
                </Caption>
            </TileItem>
            <TileItem
                Class="@(_form.IsPublic ? "clickable selected" : "clickable")"
                Click="@onMakeChatPrivateClick">
                <Icon>
                    <FormRadio Id="@_form.IsPublicFalseFormId" IsDisabled="@(!canChangeChatType)" Value="@false"/>
                </Icon>
                <Content>
                    <Label InputId="@_form.IsPublicFalseFormId" Text="Private chat" IsRequired="true"></Label>
                </Content>
                <Caption>
                    Can be joined only if you are invited / have an invite link
                </Caption>
            </TileItem>
        </InputRadioGroup>
    </FormBlock>

    @if (_form.IsPublic) {
        <FormBlock Class="with-input-radio first last">
            <TileItem Class="field-chat-alias-id unhovered">
                <Icon>
                    <i class="icon-link-2"></i>
                </Icon>
                <Content>
                    <FormSection For="() => _form.ActualAliasId"
                                 InputId="@_form.AliasIdFormId"
                                 Label="Custom link"
                                 IsLabelInsideInput="true">
                        <ValidationMessage Context="fieldLabel">
                            @if (_isPlaceAliasRequired) {
                                <PlaceAliasRequiredValidationMessage/>
                            } else {
                                <AliasValidationMessage
                                    For="@(() => _form.ActualAliasId)"
                                    Scope="@AliasValidationMessage.AliasScope.Chat(_placeId)"
                                    FieldLabel="@fieldLabel"
                                    CurrentAliasId="@_form.CurrentAliasId"
                                    AliasIdReader="@(() => _form.ActualAliasId)"/>
                            }
                        </ValidationMessage>
                        <ChildContent>
                            <TextBox
                                Id="@_form.AliasIdFormId"
                                Prefix="@_aliasLocalPrefix"
                                @bind-Value="@_form.AliasId"
                                InputRefCreated="@_setAliasCopySource"
                                readonly="@(_aliasLocalPrefix.IsNullOrEmpty())"/>
                        </ChildContent>
                    </FormSection>
                    @if (!_copyAliasFormatString.IsNullOrEmpty() && !_aliasTextBoxRef.Id.IsNullOrEmpty()) {
                        <CopyToClipboard
                            IsSquare="true"
                            ButtonClass="btn-transparent btn-sm"
                            Text=""
                            CopyTextSourceRef="@_aliasTextBoxRef"
                            CopyTextFormatString="@_copyAliasFormatString"/>
                    }
                </Content>
            </TileItem>
        </FormBlock>
    } else if (m.Chat.CanInvite()) {
        <FormBlock Title="Manage links" Class="first last">
            @if (m.Invites.Count > 0) {
                <InviteList
                    Invites="m.Invites"
                    LinkFormat="@InviteLinkFormat.PrivateChat"
                    NewInviteId="@_newInviteId"
                    AllowRevoke="true"/>
            }
            <Button IsDisabled="@(m.Invites.Count >= MaxInviteCount)" Click="OnNewInviteClick" Class="btn-modal h-10 btn-w-full">
                <Icon><i class="icon-plus text-xl"></i></Icon>
                <Title>New private join link</Title>
            </Button>
        </FormBlock>
    }

    @if (!isPlaceChat) {
        <FormBlock Class="with-input-radio last">
            @if (_isAdmin && _form.IsPublic) {
                <TileItem Class="field-allow-guest clickable" Click="OnAllowGuestAuthorsClick">
                    <Icon>
                        <i class="icon-guest"></i>
                    </Icon>
                    <Content>
                        <Label InputId="@_form.AllowGuestAuthorsFormId" Text="Visitors can join without signing in"></Label>
                    </Content>
                    <Caption>
                        <Label InputId="@_form.AllowGuestAuthorsFormId" Text="Spam messages are more likely if this option is enabled"></Label>
                    </Caption>
                    <Right>
                        <ToggleEdit Id="@_form.AllowGuestAuthorsFormId" @bind-Value="_form.AllowGuestAuthors"/>
                    </Right>
                </TileItem>
            }
            @if (Features_EnableAnonymousChat.IsEnabled) {
                <TileItem Class="field-allow-anonym clickable" Click="@OnAllowAnonymousAuthorsClick">
                    <Icon>
                        <i class="icon-anonym"></i>
                    </Icon>
                    <Content>
                        <Label InputId="@_form.AllowAnonymousAuthorsFormId" Text="Allow to join anonymously"></Label>
                    </Content>
                    <Caption>
                        <Label InputId="@_form.AllowAnonymousAuthorsFormId" Text="Signed-in users can join this chat without revealing their identity"></Label>
                    </Caption>
                    <Right>
                        <ToggleEdit Id="@_form.AllowAnonymousAuthorsFormId" @bind-Value="_form.AllowAnonymousAuthors"/>
                    </Right>
                </TileItem>
            }
        </FormBlock>
        @if (m.AllowEditIsTemplate && _form.IsPublic) {
            <FormBlock Class="with-input-radio first last">
                <TileItem Class="field-is-template clickable" Click="OnIsTemplateClick">
                    <Icon>
                        <i class="icon-file-text"></i>
                    </Icon>
                    <Content>
                        <Label InputId="@_form.IsTemplateFormId" Text="Use chat as a template"></Label>
                    </Content>
                    <Caption>
                        <Label InputId="@_form.IsTemplateFormId" Text="Template for embedded chats"></Label>
                    </Caption>
                    <Right>
                        <ToggleEdit Id="@_form.IsTemplateFormId" @bind-Value="_form.IsTemplate"/>
                    </Right>
                </TileItem>
            </FormBlock>
        }
    }
</Form>
