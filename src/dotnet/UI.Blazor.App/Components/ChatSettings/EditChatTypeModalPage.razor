@namespace ActualChat.UI.Blazor.App.Components
@inherits ComputedStateComponent<AppUIHub, EditChatTypeModalPage.ComputedModel>
@{
#pragma warning disable IL2091

    if (State.IsInitial(out var m))
        return;

    if (m.Chat == null || !m.Chat.Rules.IsOwner()) {
        Context.Close();
        return;
    }
    if (_form == null || _editContext == null)
        return;

    Context.Title = L.Chat_TypeTitle;
    var isPlaceChat = _placeId is not null;
    var showGuestsToggle = !isPlaceChat && _isAdmin && _form.IsPublic;
    var showAnonymousToggle = !isPlaceChat && Features_EnableAnonymousChat.IsEnabled;
    var showTemplateToggle = !isPlaceChat && m.AllowEditIsTemplate && _form.IsPublic;
    var canChangeChatType = _placeId is null
        || _place is not null && _place.Rules.CanApplyPublicChatType() && !_isPlaceWelcomeChat;
    var publicChatLabel = !isPlaceChat ? L.Chat_PublicChat : L.Chat_PlaceChat;
    var publicChatHint = !isPlaceChat ? L.Chat_PublicChatHint : L.Chat_PlaceChatHint;
    var onMakeChatPublicClick = canChangeChatType ? EventCallback.Factory.Create(this, () => OnPublicChatClick(true)) : new EventCallback(null, null);
    var onMakeChatPrivateClick = canChangeChatType ? EventCallback.Factory.Create(this, () => OnPublicChatClick(false)) : new EventCallback(null, null);
}

<Form Class="h-full" @ref="@_formRef" EditContext="@_editContext">
    @{
        _submitButtonInfo.CanExecute = _formRef?.IsValid ?? false;
    }
    <DataAnnotationsValidator />
    <AliasAvailabilityValidator For="() => _form.ActualAliasId"
                                Scope="@AliasAvailabilityValidator.AliasScope.Chat(_placeId)"
                                CurrentAliasId="@_form.CurrentAliasId"
                                AliasIdReader="@(() => _form.ActualAliasId)"/>
    <FormBlock Class="with-input-radio first">
        <InputRadioGroup Name="chat_type" DisplayName="@L.Chat_TypeTitle" @bind-Value="_form.IsPublic">
            <TileItem
                Class="@(_form.IsPublic ? "clickable selected" : "clickable")"
                Click="@onMakeChatPublicClick">
                <Icon>
                    <FormRadio Id="@_form.IsPublicTrueFormId" IsDisabled="@(!canChangeChatType)" Value="@true" />
                </Icon>
                <Content>
                    <Label InputId="@_form.IsPublicTrueFormId" Text="@publicChatLabel" IsRequired="true"></Label>
                </Content>
                <Caption>
                    @publicChatHint
                </Caption>
            </TileItem>
            <TileItem
                Class="@(_form.IsPublic ? "clickable selected" : "clickable")"
                Click="@onMakeChatPrivateClick">
                <Icon>
                    <FormRadio Id="@_form.IsPublicFalseFormId" IsDisabled="@(!canChangeChatType)" Value="@false"/>
                </Icon>
                <Content>
                    <Label InputId="@_form.IsPublicFalseFormId" Text="@L.Chat_PrivateChat" IsRequired="true"></Label>
                </Content>
                <Caption>
                    @L.Chat_PrivateChatHint
                </Caption>
            </TileItem>
        </InputRadioGroup>
    </FormBlock>

    @if (_form.IsPublic) {
        <FormBlock Class="with-input-radio first last">
            @if (_isPlaceAliasRequired) {
                <TileItem Class="field-chat-alias-id unhovered">
                    <Icon>
                        <i class="icon-link-2"></i>
                    </Icon>
                    <Content>@L.Form_CustomLink</Content>
                    <Caption>@L.Alias_PlaceLinkRequired</Caption>
                </TileItem>
            } else {
                <TileItem Class="field-chat-alias-id unhovered">
                    <Icon>
                        <i class="icon-link-2"></i>
                    </Icon>
                    <Content>
                        <FormSection For="() => _form.ActualAliasId"
                                     InputId="@_form.AliasIdFormId"
                                     Label="@L.Form_CustomLink"
                                     IsLabelInsideInput="true">
                            <ChildContent>
                                <TextBox
                                    Id="@_form.AliasIdFormId"
                                    Prefix="@_aliasLocalPrefix"
                                    @bind-Value="@_form.AliasId"
                                    InputRefCreated="@_setAliasCopySource"/>
                            </ChildContent>
                            <Right>
                                @if (!_copyAliasFormatString.IsNullOrEmpty() && !_aliasTextBoxRef.Id.IsNullOrEmpty()) {
                                    <CopyToClipboard
                                        Kind="CopyButtonKind.Header"
                                        ButtonClass="btn-sm"
                                        Text=""
                                        CopyTextSourceRef="@_aliasTextBoxRef"
                                        CopyTextFormatString="@_copyAliasFormatString"/>
                                }
                            </Right>
                        </FormSection>
                    </Content>
                </TileItem>
            }
        </FormBlock>
    } else if (m.Chat.CanInvite()) {
        <FormBlock Title="@L.Invite_ManageLinks" Class="first last">
            @if (m.Invites.Count > 0) {
                <InviteList
                    Invites="m.Invites"
                    LinkFormat="@InviteLinkFormat.PrivateChat"
                    NewInviteId="@_newInviteId"
                    AllowRevoke="true"/>
            }
            <Button IsDisabled="@(m.Invites.Count >= MaxInviteCount)" Click="OnNewInviteClick" Class="btn-modal h-10 btn-w-full">
                <Icon><i class="icon-plus text-xl"></i></Icon>
                <Title>@L.Invite_NewPrivateLink</Title>
            </Button>
        </FormBlock>
    }

    @if (showGuestsToggle || showAnonymousToggle || showTemplateToggle) {
        <FormBlock Class="chat-type-toggles">
            <Tile>
                @if (showGuestsToggle) {
                    <TileItem Class="field-allow-guest clickable" IsIconCentered="true" Click="OnAllowGuestAuthorsClick">
                        <Icon><i class="icon-guest text-2xl"></i></Icon>
                        <Content>@L.Chat_AllowGuests</Content>
                        <Caption>@L.Chat_AllowGuestsHint</Caption>
                        <Right>
                            <ToggleEdit Id="@_form.AllowGuestAuthorsFormId" @bind-Value="_form.AllowGuestAuthors"/>
                        </Right>
                    </TileItem>
                }
                @if (showAnonymousToggle) {
                    @if (showGuestsToggle) {
                        <Divider/>
                    }
                    <TileItem Class="field-allow-anonym clickable" IsIconCentered="true" Click="@OnAllowAnonymousAuthorsClick">
                        <Icon><i class="icon-anonym text-2xl"></i></Icon>
                        <Content>@L.Chat_AllowAnonymous</Content>
                        <Caption>@L.Chat_AllowAnonymousHint</Caption>
                        <Right>
                            <ToggleEdit Id="@_form.AllowAnonymousAuthorsFormId" @bind-Value="_form.AllowAnonymousAuthors"/>
                        </Right>
                    </TileItem>
                }
                @if (showTemplateToggle) {
                    @if (showGuestsToggle || showAnonymousToggle) {
                        <Divider/>
                    }
                    <TileItem Class="field-is-template clickable" IsIconCentered="true" Click="OnIsTemplateClick">
                        <Icon><i class="icon-file-text text-2xl"></i></Icon>
                        <Content>@L.Chat_UseAsTemplate</Content>
                        <Caption>@L.Chat_UseAsTemplateHint</Caption>
                        <Right>
                            <ToggleEdit Id="@_form.IsTemplateFormId" @bind-Value="_form.IsTemplate"/>
                        </Right>
                    </TileItem>
                }
            </Tile>
        </FormBlock>
    }
</Form>
