@namespace ActualChat.UI.Blazor.App.Components
@using Microsoft.Extensions.ObjectPool
@inherits ComponentBase<AppUIHub>

<ul class="reaction-select">
    @foreach (var emoji in _visibleEmojis) {
        <MenuEntry @key="emoji"
            Class="reaction-select-reaction"
            Click="@(_ => React(emoji))">
            <IconContent>
                <EmojiIcon Emoji="@emoji" Class="reaction-select-reaction-emoji"/>
            </IconContent>
        </MenuEntry>
    }
    @if (_hasMore) {
        <li class="reaction-select-toggle" data-menu-keep-open @onclick="@OnExpandClick" @onclick:stopPropagation>
            <i class="icon-chevron-right text-3.5xl"></i>
        </li>
    }
</ul>

@code {
    private const int MaxReactionCount = 6;
    private Emoji[] _allEmojis = [];
    private Emoji[] _visibleEmojis = [];
    private bool _hasMore;
    private UserReactionSettings? _reactionSettings;

    private ReactionsUI ReactionsUI => Hub.ReactionsUI;

    [Parameter, EditorRequired] public ChatEntry Entry { get; set; } = null!;
    [Parameter] public bool ShowDefaultReaction { get; set; } = true;
    [Parameter] public EventCallback OnExpandClick { get; set; }

    protected override async Task OnParametersSetAsync() {
        _reactionSettings = await Hub.UserSettingsUI.UserReactionSettings().Get();
        UpdateEmojis();
    }

    private void UpdateEmojis() {
        var skipCount = ShowDefaultReaction ? 0 : 1;
        var allEmojis = _reactionSettings?.GetSortedEmojis() ?? Emojis.All;
        _allEmojis = allEmojis.Skip(skipCount).ToArray();
        _hasMore = _allEmojis.Length > MaxReactionCount;
        _visibleEmojis = _hasMore ? _allEmojis.Take(MaxReactionCount).ToArray() : _allEmojis;
    }

    private async Task React(Emoji emoji) {
        _ = TuneUI.Play(Tune.React);
        ReactionsUI.AddPendingAnimation(Entry.Id.Value, emoji.Id.Value);
        var reaction = new Reaction {
            Id = Symbol.Empty,
            AuthorId = null!,
            EntryId = Entry.Id,
            Emoji = emoji,
        };

        _reactionSettings = await Hub.UserSettingsUI.UserReactionSettings().Update(s => s.WithBubbleUp(emoji.Id.Value));
        UpdateEmojis();
        await UICommander.Run(new Reactions_React { Session = Session, Reaction = reaction });
    }
}
