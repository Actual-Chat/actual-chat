@namespace ActualChat.UI.Blazor.App.Components

@if (_svgName is not null) {
    <img class="@Class" src="/dist/images/@(_svgName).svg" alt="@Emoji?.Title" />
} else {
    @(Emoji?.Value ?? "")
}

@code {
    public static readonly Dictionary<Emoji, string> SvgNames = new() {
        { Emojis.ThumbsUp, "emoji-thumbs-up" },
        { Emojis.RedHeart, "emoji-red-heart" },
        { Emojis.Lol, "emoji-lol" },
        { Emojis.Surprise, "emoji-surprise" },
        { Emojis.Sad, "emoji-sad" },
        { Emojis.Angry, "emoji-angry" },
        { Emojis.Poo, "emoji-poo" },
    };

    private string? _svgName;

    [Parameter] public Emoji? Emoji { get; set; }
    [Parameter] public string Class { get; set; } = "";

    protected override void OnParametersSet() {
        _svgName = Emoji is { } emoji
            ? SvgNames.GetValueOrDefault(emoji)
            : null;
    }
}
