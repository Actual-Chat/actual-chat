@namespace ActualChat.UI.Blazor.App.Components

@if (_svgName is not null) {
    <img class="@Class" src="/dist/images/@(_svgName).svg" alt="@Emoji?.Title" />
} else {
    @(Emoji?.Value ?? "")
}

@code {
    public static readonly Dictionary<Emoji, string> SvgNames = new() {
        // Positive
        { Emojis.Lol, "emoji-lol" },
        { Emojis.Awesome, "emoji-awesome" },
        { Emojis.Cool, "emoji-cool" },
        { Emojis.Smile, "emoji-smile" },
        { Emojis.Nerd, "emoji-nerd" },
        { Emojis.SmileRotated, "emoji-smile-rotated" },
        { Emojis.Kiss, "emoji-kiss" },
        // Negative
        { Emojis.Angry, "emoji-angry" },
        { Emojis.Sad, "emoji-sad" },
        { Emojis.Cry, "emoji-cry" },
        { Emojis.Melt, "emoji-melt" },
        { Emojis.Devil, "emoji-devil" },
        { Emojis.Clown, "emoji-clown" },
        // Love
        { Emojis.RedHeart, "emoji-red-heart" },
        { Emojis.InLove, "emoji-in-love" },
        { Emojis.BrokenHeart, "emoji-broken-heart" },
        { Emojis.Please, "emoji-please" },
        // Gestures
        { Emojis.ThumbsUp, "emoji-thumbs-up" },
        { Emojis.Done, "emoji-done" },
        { Emojis.Eyes, "emoji-eyes" },
        { Emojis.Poo, "emoji-poo" },
        { Emojis.Boom, "emoji-boom" },
        { Emojis.Surprise, "emoji-surprise" },
        { Emojis.Mysterious, "emoji-mysterious" },
        { Emojis.Stone, "emoji-stone" },
    };

    private string? _svgName;

    [Parameter] public Emoji? Emoji { get; set; }
    [Parameter] public string Class { get; set; } = "";

    protected override void OnParametersSet() {
        _svgName = Emoji is { } emoji
            ? SvgNames.GetValueOrDefault(emoji)
            : null;
    }
}
