@namespace ActualChat.UI.Blazor.App.Components

@if (_svgName is not null) {
    <img class="@Class"
         src="/dist/images/emoji/@(_svgName).svg"
         alt="@Emoji?.Title"
         draggable="false"
         data-emoji-preview="@(HasPreview ? _svgName : null)"
         data-emoji-inline="@(InlineAnimate ? _svgName : null)" />
} else {
    @(Emoji?.Value ?? "")
}

@code {
    private string? _svgName;

    [Parameter] public Emoji? Emoji { get; set; }
    [Parameter] public string Class { get; set; } = "";
    [Parameter] public bool HasPreview { get; set; } = true;
    [Parameter] public bool InlineAnimate { get; set; }

    protected override void OnParametersSet()
        => _svgName = Emojis.TryGetSvgName(Emoji);
}
