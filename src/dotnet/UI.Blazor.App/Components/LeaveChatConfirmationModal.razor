@inherits ComponentBase<AppUIHub>
@implements IModalView<LeaveChatConfirmationModal.Model>
@{
    var (title, question, buttonTitle) = ModalModel.Target switch {
        TargetKind.Thread => (L.LeaveConfirm_DeleteThreadTitle, L.LeaveConfirm_DeleteThreadQuestion, L.Common_Delete),
        TargetKind.Place when ModalModel.IsDelete
            => (L.LeaveConfirm_DeletePlaceTitle, L.LeaveConfirm_DeletePlaceForAllQuestion, L.Common_Delete),
        TargetKind.Place => (L.LeaveConfirm_LeavePlaceTitle, L.LeaveConfirm_LeavePlaceQuestion, L.Common_Leave),
        _ when ModalModel.IsDelete
            => (L.LeaveConfirm_DeleteChatTitle, L.LeaveConfirm_DeleteChatForAllQuestion, L.Common_Delete),
        _ => (L.LeaveConfirm_LeaveChatTitle, L.LeaveConfirm_LeaveChatQuestion, L.Common_Leave),
    };
    // A thread is only ever deleted
    var isDelete = ModalModel.IsDelete || ModalModel.Target == TargetKind.Thread;
}

<DialogFrame Title="@title" Class="leave-chat-confirmation-modal compact-header modal-sm">
    <Body>
    <FormBlock>
        <p class="@(isDelete ? "c-warning" : "")">@question</p>
        @if (isDelete) {
            <ConfirmationCheckbox @bind-IsChecked="@_isConfirmed"/>
        }
    </FormBlock>
    </Body>
    <Buttons>
        <Button Class="btn-modal" Click="OnCancel">@L.Common_Cancel</Button>
        <Button Class="btn-modal btn-danger" Click="OnLeave" IsDisabled="@(isDelete && !_isConfirmed)">
            @buttonTitle
        </Button>
    </Buttons>
</DialogFrame>

@code {
    private bool _isConfirmed;

    [CascadingParameter] public Modal Modal { get; set; } = null!;
    [Parameter] public Model ModalModel { get; set; } = null!;

    private void OnCancel()
        => Modal.Close();

    private void OnLeave()
        => ModalModel.Confirmed(Modal);

    // Nested types

    public enum TargetKind { Chat, Thread, Place }

    public sealed record Model(bool IsDelete, TargetKind Target, Action<Modal> Confirmed);
}
