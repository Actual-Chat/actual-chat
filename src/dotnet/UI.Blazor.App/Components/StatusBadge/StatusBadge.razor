@namespace ActualChat.UI.Blazor.App.Components
@inherits ComputedStateComponent<AppUIHub, StatusBadge.Model>
@{
    var m = State.Value;
}

<span class="status-badge @m.BadgeClass">
    @switch (m.ChatKind) {
        case ChatKind.Group: {
            var iconCls = Chat.IsPublic ? "icon-globe" : "icon-lock";
            <i class="@iconCls text-sm"></i>
            @if (!ShowOnlyIcon) {
                @m.Status
            }
            break;
        }
        case ChatKind.Peer when ShowLastSeen:
            <AuthorPresenceText AuthorId="@m.AuthorId"/>
            break;
        case ChatKind.Peer:
            @m.Status
            break;
        case ChatKind.Place when m.Place != null: {
            var iconCls = !Chat.IsPublic ? "icon-lock" : m.Place.IsPublic ? "icon-globe" : "icon-people-2";
            <i class="@iconCls text-sm"></i>
            @if (!ShowOnlyIcon) {
                @m.Status
            }
            break;
        }
    }
</span>

@code {
    private IAuthors Authors => Hub.Authors;
    private IChats Chats => Hub.Chats;
    private IPlaces Places => Hub.Places;

    [Parameter, EditorRequired] public Chat Chat { get; set; } = null!;
    [Parameter] public bool IsColorful { get; set; } = true;
    [Parameter] public bool ShowLastSeen { get; set; }
    [Parameter] public bool ShowOnlyIcon { get; set; }

    protected override ComputedState<Model>.Options GetStateOptions()
        => ComputedStateComponent.GetStateOptions(GetType(),
            static t => new ComputedState<Model>.Options() {
                InitialValue = Model.Loading,
                Category = GetStateCategory(t),
            });

    protected override async Task<Model> ComputeState(CancellationToken cancellationToken) {
        var status = "";
        var badgeClass = "";
        var chat = Chat;
        var isPublicChat = chat.IsPublic;
        ChatId parentChatId = chat.Id;
        var isThread = chat.Id.IsThread(out var threadChatId);
        if (isThread) {
            parentChatId = threadChatId!.GetOutermostParent();
            var parentChat = await Chats.Get(Session, parentChatId, cancellationToken).ConfigureAwait(false);
            isPublicChat = parentChat?.IsPublic ?? isPublicChat;
        }
        switch (parentChatId.Kind) {
            case ChatKind.Group:
                badgeClass = ShowOnlyIcon ? "default" : "public";
                status = isPublicChat
                    ? isThread ? L.Chat_PublicChatThread : L.Chat_PublicChat
                    : isThread ? L.Chat_PrivateChatThread : L.Chat_PrivateChat;
                return new() {
                    ChatKind = ChatKind.Group,
                    Status = status,
                    BadgeClass = badgeClass,
                };
            case ChatKind.Place:
                badgeClass = ShowOnlyIcon ? "default" : "public";
                var placeId = ((PlaceChatId)parentChatId).PlaceId;
                var place = await Places.Get(Session, placeId, cancellationToken).ConfigureAwait(false);
                if (ReferenceEquals(place, null))
                    return Model.Loading;

                status = isPublicChat
                    ? isThread ? L.Chat_PlaceChatThread : L.Chat_PlaceChat
                    : isThread ? L.Chat_PrivateChatThread : L.Chat_PrivateChat;
                return new () {
                    ChatKind = ChatKind.Place,
                    Status = status,
                    BadgeClass = badgeClass,
                    Place = place,
                };
            default:
                var ownAccount = await AccountUI.OwnAccount.Use(cancellationToken).ConfigureAwait(false);
                if (parentChatId is not PeerChatId peerChatId)
                    return Model.Loading;

                var peerAccountId = peerChatId.AnotherUserIdOrNull(ownAccount.Id);
                if (peerAccountId is null)
                    return Model.Loading;

                var ownUserId = ownAccount.Id;
                var anotherAuthorId = peerChatId.AnotherAuthorId(ownUserId);
                var anotherAuthor = await Authors.Get(Session, peerChatId, anotherAuthorId, cancellationToken).ConfigureAwait(false);

                if (anotherAuthor == null)
                    return Model.Loading;

                var presence = await Authors.GetPresence(Session, peerChatId, anotherAuthor.Id, cancellationToken).ConfigureAwait(false);
                status = presence switch {
                    Presence.Offline => L.Presence_Offline,
                    Presence.Away => L.Presence_Away,
                    Presence.Online or Presence.Recording => L.Presence_Online,
                    _ => "",
                };
                if (IsColorful) {
                    badgeClass = presence switch {
                        Presence.Offline => "offline",
                        Presence.Away => "away",
                        Presence.Online => "online",
                        Presence.Recording => "recording",
                        _ => "",
                    };
                }
                return new() {
                    ChatKind = ChatKind.Peer,
                    Status = status,
                    BadgeClass = badgeClass,
                    AuthorId = anotherAuthorId,
                };
        }
    }

    // Nested types

    public sealed record Model {
        public static readonly Model Loading = new () { ChatKind = ChatKind.Group};

        public required ChatKind ChatKind { get; init; }
        public string Status { get; init; } = "";
        public string BadgeClass { get; init; } = "";
        public AuthorId? AuthorId { get; init; }
        public Place? Place { get; init; }
    }
}
