@namespace ActualChat.UI.Blazor.App.Components

@{
    var clickTune = ClickTune == Tune.None ? null : ClickTune.ToString();
}

<div class="navbar-button @Class"
     @attributes="@AdditionalAttributes">
    @if (IsRound) {
        <ButtonRound
            Click="@Click"
            Class="@ButtonClass"
            data-tune="@clickTune"
            Tooltip="@Tooltip"
            ContentClass="navbar-button-content"
            TooltipPosition="@TooltipPosition">
            @ChildContent
        </ButtonRound>
    } else {
        <ButtonSquare
            Click="@Click"
            Class="@ButtonClass"
            data-tune="@clickTune"
            Tooltip="@Tooltip"
            ContentClass="navbar-button-content"
            TooltipPosition="@TooltipPosition">
            @ChildContent
        </ButtonSquare>
    }
    @Ending
</div>

@code {
    [Parameter] public string Class { get; set; } = "";
    [Parameter] public string ButtonClass { get; set; } = "";
    [Parameter] public bool IsRound { get; set; }
    [Parameter] public string Tooltip { get; set; } = "";
    [Parameter] public bool CanMove { get; set; }
    [Parameter] public FloatingPosition TooltipPosition { get; set; } = FloatingPosition.Right;
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Ending { get; set; }
    [Parameter] public EventCallback Click { get; set; }
    [Parameter] public Tune ClickTune { get; set; }
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
