@namespace ActualChat.UI.Blazor.App.Components

@{
    var tooltipPosition = TooltipPosition ?? NavbarPlacement switch {
        NavbarPlacement.Top => FloatingPosition.Bottom,
        NavbarPlacement.Bottom => FloatingPosition.Top,
        _ => FloatingPosition.Right,
    };
}
<div class="navbar-button @Class"
     @attributes="@AdditionalAttributes">
    @if (IsRound) {
        <ButtonRound
            Click="@Click"
            Class="@ButtonClass"
            Tooltip="@Tooltip"
            ContentClass="navbar-button-content"
            TooltipPosition="@tooltipPosition">
            @ChildContent
        </ButtonRound>
    } else {
        <ButtonSquare
            Click="@Click"
            Class="@ButtonClass"
            Tooltip="@Tooltip"
            ContentClass="navbar-button-content"
            TooltipPosition="@tooltipPosition">
            @ChildContent
        </ButtonSquare>
    }
    @Ending
</div>

@code {
    [CascadingParameter] public NavbarPlacement NavbarPlacement { get; set; }
    [Parameter] public string Class { get; set; } = "";
    [Parameter] public string ButtonClass { get; set; } = "";
    [Parameter] public bool IsRound { get; set; }
    [Parameter] public string Tooltip { get; set; } = "";
    [Parameter] public bool CanMove { get; set; }
    [Parameter] public FloatingPosition? TooltipPosition { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Ending { get; set; }
    [Parameter] public EventCallback Click { get; set; }
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
