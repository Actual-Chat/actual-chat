@namespace ActualChat.UI.Blazor.App.Components
@inherits ComputedStateComponent<NavbarChatRouletteButton.Model>
@{
    var m = State.Value;
    var isVisible = m.IsVisible;
    if (!isVisible)
        return;

    var size = ScreenSize.IsNarrow() ? SquareSize.Size10 : SquareSize.Size12;
    var placeId = Constants.Place.ChatRouletteId;
}

<div class=c-delimiter></div>

<NavbarGroupSelectionButton
    CanMove="@false"
    Title="Chat Roulette"
    Id="@placeId.GetNavbarGroupId()"
    Tooltip="Chat Roulette">
    <ChildContent>
        <Pic Title="Chat Roulette"
             Size="@size"
             IsSquare="true">
            <NoPicture>
                <div class="c-chat-roulette-icon">
                    <i class="icon-hand text-2xl"></i>
                </div>
            </NoPicture>
        </Pic>
    </ChildContent>
    <BadgeContent>
        <ChatsNavbarButtonBadge PlaceId="@placeId"/>
    </BadgeContent>
</NavbarGroupSelectionButton>

@code {
    [Inject] private ChatUIHub Hub { get; init; } = null!;

    private Session Session => Hub.Session();

    [CascadingParameter] ScreenSize ScreenSize { get; set; }

    protected override ComputedState<Model>.Options GetStateOptions()
        => ComputedStateComponent.GetStateOptions(GetType(),
            static t => new ComputedState<Model>.Options {
                InitialValue = new Model(false),
                Category = GetStateCategory(t),
            });

    protected override async Task<Model> ComputeState(CancellationToken cancellationToken) {
        var chatRouletteContacts = await Hub.Contacts.ListIds(Session, Constants.Place.ChatRouletteId, cancellationToken).ConfigureAwait(false);
        var isVisible = chatRouletteContacts.Count > 0;
        return new Model(isVisible);
    }

    // Nested types

    public sealed record Model(bool IsVisible);
}
