@namespace ActualChat.UI.Blazor.App.Components
@inherits ComputedMenuBase<ChatUIHub, CreateMenu.Model>
@{
    var m = State.Value;
}

<MenuEntry
    Icon="icon-conversation"
    Text="New Chat"
    Click="OnCreateChatClick">
</MenuEntry>
<MenuEntry
    Icon="icon-people-2"
    Text="New Place"
    Click="OnCreatePlaceClick">
</MenuEntry>
@if (m.EnableChatRouletteUI) {
    <MenuEntry
        Icon="icon-hand"
        Text="New Chat Roulette"
        Click="OnStartChatRouletteClick">
    </MenuEntry>
}

@code {
    private RouletteUI RouletteUI => Hub.RouletteUI;

    protected override ComputedState<Model>.Options GetStateOptions()
        => new() {
            InitialValue = new Model(false),
            Category = GetStateCategory(GetType()),
        };

    protected override async Task<Model> ComputeState(CancellationToken cancellationToken) {
        var enableChatRouletteUI = await Features.Get<Features_EnableChatRouletteUI>(cancellationToken);
        return new Model(enableChatRouletteUI);
    }

    private void OnCreateChatClick()
        => ModalUI.Show(new NewChatModal.Model(Hub.ChatUI.SelectedPlaceId.Value));

    private void OnCreatePlaceClick()
        => ModalUI.Show(new NewPlaceModal.Model());

    private async Task OnStartChatRouletteClick() {
        await WhenClosed;
        await RouletteUI.StartChatRoulette();
    }

    // Nested types

    public record Model(bool EnableChatRouletteUI);
}
