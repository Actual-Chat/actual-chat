@namespace ActualChat.UI.Blazor.App.Components
@inherits MenuBase

<MenuEntry
    Icon="icon-conversation"
    Text="New Chat"
    Click="OnCreateChatClick">
</MenuEntry>
<MenuEntry
    Icon="icon-people-2"
    Text="New Place"
    Click="OnCreatePlaceClick">
</MenuEntry>
<MenuEntry
    Icon="icon-hand"
    Text="New Chat Roulette"
    Click="OnStartChatRouletteClick">
</MenuEntry>

@code {
    [Inject] private ChatUIHub Hub { get; init; } = null!;

    private void OnCreateChatClick()
        => Hub.ModalUI.Show(new NewChatModal.Model(Hub.ChatUI.SelectedPlaceId.Value));

    private void OnCreatePlaceClick()
        => Hub.ModalUI.Show(new NewPlaceModal.Model());

    private void OnStartChatRouletteClick()
        => _ = NavigateTo("/chat-roulette");
}
