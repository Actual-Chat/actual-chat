@namespace ActualChat.UI.Blazor.App.Components
@inherits MenuBase

<MenuEntry
    Icon="icon-conversation"
    Text="New Chat"
    Click="OnCreateChatClick">
</MenuEntry>
<MenuEntry
    Icon="icon-people-2"
    Text="New Place"
    Click="OnCreatePlaceClick">
</MenuEntry>
<MenuEntry
    Icon="icon-hand"
    Text="New Chat Roulette"
    Click="OnStartChatRouletteClick">
</MenuEntry>

@code {
    [Inject] private ChatUIHub Hub { get; init; } = null!;

    private ModalUI ModalUI => Hub.ModalUI;
    private RouletteUI RouletteUI => Hub.RouletteUI;

    private void OnCreateChatClick()
        => ModalUI.Show(new NewChatModal.Model(Hub.ChatUI.SelectedPlaceId.Value));

    private void OnCreatePlaceClick()
        => ModalUI.Show(new NewPlaceModal.Model());

    private async Task OnStartChatRouletteClick() {
        await WhenClosed;
        await RouletteUI.StartChatRoulette();
    }
}
