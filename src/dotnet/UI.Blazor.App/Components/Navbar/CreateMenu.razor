@namespace ActualChat.UI.Blazor.App.Components
@inherits ComputedMenuBase<AppUIHub, Unit>

<MenuEntry
    Icon="icon-conversation"
    Text="@L.Navbar_NewChat"
    Click="OnCreateChatClick">
</MenuEntry>
<MenuEntry
    Icon="icon-people-2"
    Text="@L.Navbar_NewPlace"
    Click="OnCreatePlaceClick">
</MenuEntry>

@code {
    protected override ComputedState<Unit>.Options GetStateOptions()
        => new() {
            InitialValue = default,
            Category = GetStateCategory(GetType()),
        };

    protected override Task<Unit> ComputeState(CancellationToken cancellationToken)
        => ActualLab.Async.TaskExt.UnitTask;

    private void OnCreateChatClick()
        => ModalUI.Show(new NewChatModal.Model(Hub.ChatUI.SelectedPlaceId.Value));

    private void OnCreatePlaceClick()
        => ModalUI.Show(new NewPlaceModal.Model());
}
