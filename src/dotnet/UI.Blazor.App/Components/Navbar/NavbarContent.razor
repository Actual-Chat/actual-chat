@using ActualChat.Hosting
@namespace ActualChat.UI.Blazor.App.Components
@inherits OwnAccountComponentBase<AppUIHub>
@{
    var m = State.Value;
    PlaceId? placeId = null;
    // Default to chats if no group is selected
    var isChats = NavbarUI.SelectedGroupId == NavbarGroupIds.Chats || NavbarUI.SelectedGroupId.IsNullOrEmpty() || NavbarUI.IsPlaceSelected(out placeId);
    if (NavbarUI.IsPinnedChatSelected(out var pinnedChatId)) {
        isChats = true;
        placeId = (pinnedChatId as PlaceChatId)?.PlaceId;
    }
    var isTestPages = NavbarUI.SelectedGroupId == NavbarGroupIds.TestPages;
    var cls = isChats ? "navbar-chats" : "navbar-pages";
}

<div class="navbar-content">
    <div class="navbar-group @cls">
        @if (isChats) {
            <ChatListNavbarWidget PlaceId="@placeId" />
        }
        else if (isTestPages && m.IsAdmin) {
            var tp = "/test/";
            var tpHome = Links.TestPageHome.Value;
            var isNarrow = ScreenSize.IsNarrow();
            @foreach (var page in GetTestPages()) {
                if (page.DesktopOnly && isNarrow)
                    continue;
                <NavbarItem ReplaceOnPrefix="@tp" ReplaceOnPrefixExcept="@tpHome" Url="@(page.Url)">@(page.Title)</NavbarItem>
            }
        }
    </div>
</div>

@code {
    private EventHandler<NavbarGroupChangedEventArgs> _navbarUIOnSelectedGroupChanged = null!;

    private NavbarUI NavbarUI => field ??= Hub.Services.GetRequiredService<NavbarUI>();

    [CascadingParameter] public ScreenSize ScreenSize { get; set; }

    protected override void OnInitialized() {
        _navbarUIOnSelectedGroupChanged = NavbarUIOnSelectedGroupChanged;
        NavbarUI.SelectedGroupChanged += _navbarUIOnSelectedGroupChanged;
    }

    public override ValueTask DisposeAsync() {
        NavbarUI.SelectedGroupChanged -= _navbarUIOnSelectedGroupChanged;
        return base.DisposeAsync();
    }

    private void NavbarUIOnSelectedGroupChanged(object? sender, NavbarGroupChangedEventArgs e)
        => StateHasChanged();

    private IEnumerable<TestPageEntry> GetTestPages() {
        var hostKind = HostInfo.HostKind;
        var isDev = HostInfo.IsDevelopmentInstance;
        var pages = new List<TestPageEntry> {
            new("/test/audio-blob-download", "Audio Blob Download"),
            new("/test/blazor", "Blazor"),
            new("/test/copy-chat2place", "Copy Chat to Place"),
            new("/test/digest", "Digest"),
            new("/test/discover", "Discover", DesktopOnly: true),
            new("/test/dive-in-modal", "Dive-in Modal"),
            new("/test/emojis", "Emojis"),
            new("/test/embedded", "Embedded"),
            new("/test/error-barrier", "Error Barrier"),
            new("/test/features", "Features"),
            new("/test/flows", "Flows"),
            new("/test/incoming-share-modal-test", "Incoming Share Modal"),
            new("/test/landing-background", "Landing Background", DesktopOnly: true),
            new("/test/markup-editor", "Markup Editor"),
            new("/test/mesh", "Mesh"),
            new("/test/mic-permission-guides", "Mic Permission Guides"),
            new("/test/photo-permission", "Photo Permission"),
            new("/test/place-info", "Place Info", DesktopOnly: true),
            new("/test/reconnect-overlay", "Reconnect Overlay", DesktopOnly: true),
            new("/test/render-slot", "Render Slot"),
            new("/test/requirements", "Requirements"),
            new("/test/skeletons", "Skeletons"),
            new("/test/svg-cats", "SVG Cats"),
            new("/test/system", "System"),
            new("/test/toasts", "Toasts"),
            new("/test/totp", "TOTP"),
            new("/test/ui-colors", "UI Colors"),
            new("/test/video-input", "Video Input Devices"),
            new("/test/video-transcoding", "Video Transcoding"),
            new("/test/virtual-list", "Virtual List"),
            new("/test/voice-call", "Voice Call"),
            new("/test/web-splash", "Web Splash", DesktopOnly: true),
        };
        if (hostKind != HostKind.MauiApp && isDev)
            pages.Add(new("/test/email-templates", "Email Templates"));
        if (hostKind != HostKind.MauiApp && isDev)
            pages.Add(new("/test/external-contacts", "External Contacts"));
        if (hostKind == HostKind.MauiApp)
            pages.Add(new("/test/maui", "Maui"));
        pages.Sort(static (a, b) => StringComparer.Ordinal.Compare(a.Title, b.Title));
        return pages;
    }

    private sealed record TestPageEntry(string Url, string Title, bool DesktopOnly = false);
}
