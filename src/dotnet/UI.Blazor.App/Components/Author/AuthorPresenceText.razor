@namespace ActualChat.UI.Blazor.App.Components
@inherits ComputedStateComponent<AppUIHub, AuthorPresenceText.Model>
@{
    var m = State.Value;
}

@if (m.IsTyping) {
    <span class="c-typing-indicator">@L.Presence_Typing</span>
} else {
    @PresenceFragments.PresenceText((m.Presence, m.LastCheckIn, IsShortText, L))
}

@code {
    private IAuthors Authors => Hub.Authors;
    private LiveStreamUI LiveStreamUI => Hub.LiveStreamUI;
    private TypingUI TypingUI => Hub.TypingUI;

    [Parameter, EditorRequired] public AuthorId? AuthorId { get; set; }
    [Parameter] public bool ShowRecording { get; set; }
    [Parameter] public bool ShowTyping { get; set; }
    [Parameter] public bool IsShortText { get; set; }

    protected override ComputedState<Model>.Options GetStateOptions()
        => ComputedStateComponent.GetStateOptions(GetType(),
            static t => new ComputedState<Model>.Options() {
                InitialValue = Model.None,
                Category = GetStateCategory(t),
            });

    protected override async Task<Model> ComputeState(CancellationToken cancellationToken) {
        var authorId = AuthorId;
        if (authorId is null)
            return Model.None;

        var chatId = authorId.ChatId;

        // The code below doesn't use any component prop, so we can use .ConfigureAwait(false)
        var presence = await Authors.GetPresence(Session, chatId, authorId, cancellationToken).ConfigureAwait(false);
        var isRecording = false;
        if (ShowRecording) {
            var isStreaming = await LiveStreamUI.IsAuthorStreamingAudio(chatId, authorId, cancellationToken).ConfigureAwait(false);
            if (isStreaming) {
                presence = Presence.Recording;
                isRecording = true;
            }
        }

        // Recording (audio) takes priority over typing.
        var isTyping = ShowTyping
            && !isRecording
            && await TypingUI.IsTyping(chatId, authorId, cancellationToken).ConfigureAwait(false);

        var lastCheckIn = await Authors.GetLastCheckIn(Session, chatId, authorId, cancellationToken).ConfigureAwait(false);
        return new() {
            Presence = presence,
            LastCheckIn = lastCheckIn,
            IsTyping = isTyping,
        };
    }

    // Nested types

    public sealed record Model {
        public static readonly Model None = new() {
            Presence = Presence.Unknown,
            LastCheckIn = null,
        };

        public required Presence Presence { get; init; }
        public required Moment? LastCheckIn { get; init; }
        public bool IsTyping { get; init; }
    }
}
