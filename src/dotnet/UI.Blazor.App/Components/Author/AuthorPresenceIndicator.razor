@namespace ActualChat.UI.Blazor.App.Components
@inherits ComputedRenderStateComponent<AppUIHub, Presence>
@{
    var presence = State.Value;
}
@PresenceFragments.PresenceIndicator(presence)

@code {
    private IAuthors Authors => Hub.Authors;
    private LiveStreamUI LiveStreamUI => Hub.LiveStreamUI;

    [Parameter, EditorRequired] public AuthorId? AuthorId { get; set; }
    [Parameter] public bool ShowRecording { get; set; }

    protected override void OnInitialized()
        // This renders nothing but the presence itself, and presence recomputes far more often
        // than it changes - comparing the value is what keeps those recomputes off the screen
        => StateEqualityComparer = EqualityComparer<Presence>.Default;

    protected override ComputedState<Presence>.Options GetStateOptions()
        => ComputedStateComponent.GetStateOptions(GetType(),
            static t => new ComputedState<Presence>.Options() {
                InitialValue = Presence.Unknown,
                Category = GetStateCategory(t),
            });

    protected override async Task<Presence> ComputeState(CancellationToken cancellationToken) {
        var authorId = AuthorId;
        if (authorId is null)
            return Presence.Offline;

        var chatId = authorId.ChatId;
        var showRecording = ShowRecording;

        var presence = await Authors.GetPresence(Session, chatId, authorId, cancellationToken).ConfigureAwait(false);
        if (showRecording) {
            var isStreaming = await LiveStreamUI
                .IsAuthorStreamingAudio(chatId, authorId, cancellationToken)
                .ConfigureAwait(false);
            if (isStreaming)
                presence = Presence.Recording;
        }
        return presence;
    }
}
