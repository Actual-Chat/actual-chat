@using ActualChat.UI
@namespace ActualChat.UI.Blazor.App.Components
@inherits ComponentBase<AppUIHub>
@implements IModalView<PhotoTroubleshooterModal.Model>

<DialogFrame
    Class="photo-troubleshooter-modal guide-modal compact-header modal-sm"
    BodyClass="no-scrollbar"
    Title="@L.Photo_Title"
    HasCloseButton="true">
    <Body>
    <FormBlock>
        <div class="c-intro">
            @L.Photo_Intro_Prefix(CoreConstants.AppName)<a
                @onclick="OnSettingsClick"
                @onclick:preventDefault
                class="settings-link">@L.Common_Settings</a>@L.Photo_Intro_Suffix
        </div>
    </FormBlock>
    </Body>
    <Buttons>
        <Button Class="btn-modal btn-primary" Click="OnOkClick">
            @L.Common_OK
        </Button>
    </Buttons>
</DialogFrame>

@code {
    private SystemSettingsUI SystemSettingsUI => field ??= Hub.Services.GetRequiredService<SystemSettingsUI>();

    [CascadingParameter] public Modal Modal { get; set; } = null!;

    [Parameter] public Model ModalModel { get; set; } = null!;

    private async Task OnSettingsClick() {
        await SystemSettingsUI.Open(SystemSettingsPane.Photos);
        Modal.Close();
    }

    private void OnOkClick()
        => Modal.Close();

    public sealed record Model;
}
