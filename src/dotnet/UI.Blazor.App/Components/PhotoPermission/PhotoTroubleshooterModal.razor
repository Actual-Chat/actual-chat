@using ActualChat.UI
@namespace ActualChat.UI.Blazor.App.Components
@inherits ComponentBase<AppUIHub>
@implements IModalView<PhotoTroubleshooterModal.Model>

<DialogFrame
    Class="photo-troubleshooter-modal guide-modal"
    BodyClass="no-scrollbar"
    Title="Photo library access"
    HasCloseButton="true"
    NarrowViewSettings="@DialogFrameNarrowViewSettings.ForSubmitButton(OnOkClick, "OK")">
    <Body>
    <FormBlock>
        <div class="c-intro">
            @CoreConstants.AppName needs access to your photo library to save photos and videos.
            Please enable it in <a @onclick="OnSettingsClick" @onclick:preventDefault class="settings-link">Settings</a>.
        </div>
    </FormBlock>
    <div class="safe-area-bottom safe-area-bottom-overlay"></div>
    </Body>
    <Buttons>
        <Button Class="btn-modal btn-primary" Click="OnOkClick">
            OK
        </Button>
    </Buttons>
</DialogFrame>

@code {
    private SystemSettingsUI SystemSettingsUI => field ??= Hub.Services.GetRequiredService<SystemSettingsUI>();

    [CascadingParameter] public Modal Modal { get; set; } = null!;

    [Parameter] public Model ModalModel { get; set; } = null!;

    private async Task OnSettingsClick() {
        await SystemSettingsUI.Open();
        Modal.Close();
    }

    private void OnOkClick()
        => Modal.Close();

    public sealed record Model;
}
