@using ActualChat.UI
@namespace ActualChat.UI.Blazor.App.Components
@inherits ComponentBase<AppUIHub>
@implements IModalView<PhotoTroubleshooterModal.Model>
@{
    var settingsButtonTitle = "Settings";
}

<DialogFrame
    Class="photo-troubleshooter-modal"
    Title="Photo library access"
    HasCloseButton="true"
    NarrowViewSettings="@DialogFrameNarrowViewSettings.SubmitButton(OnSettingsClick, settingsButtonTitle)">
    <Body>
    <FormBlock>
        <div class="c-text font-normal">
            @CoreConstants.AppName needs access to your photo library to save photos and videos.
            Please enable it in <a @onclick="OnSettingsClick" @onclick:preventDefault class="settings-link">Settings</a>.
        </div>
    </FormBlock>
    </Body>
    <Buttons>
        <Button Class="btn-modal" Click="@(() => Modal.Close())">
            Later
        </Button>
        <Button Class="btn-modal btn-primary" Click="OnSettingsClick">
            Settings
        </Button>
    </Buttons>
</DialogFrame>

@code {
    private SystemSettingsUI SystemSettingsUI => field ??= Hub.Services.GetRequiredService<SystemSettingsUI>();

    [CascadingParameter] public Modal Modal { get; set; } = null!;

    [Parameter] public Model ModalModel { get; set; } = null!;

    private async Task OnSettingsClick() {
        await SystemSettingsUI.Open();
        Modal.Close();
    }

    public sealed record Model;
}
