@inherits ComputedStateComponent<AppUIHub, ChatHeaderRightPanelToggle.Model>
@{
    var m = State.Value;
    var chat = m.Chat;
    var isRightPanelVisible = m.IsRightPanelVisible;
}

@if (ScreenSize.IsNarrow()) {
    @if (chat is not null) {
        <HeaderButton
            data-bubble="@(BubbleRef.New<RightChatPanelButtonBubble>())"
            data-bubble-priority="401"
            data-bubble-placement="@(FloatingPosition.BottomEnd.ToPositionString())"
            data-menu="@(MenuRef.New<ChatPropertiesMenu>(chat.Id.Value).ToString())"
            data-menu-trigger="@MenuTrigger.Primary"
            data-menu-placement="@(FloatingPosition.BottomStart.ToPositionString())"
            Tooltip="Chat properties"
            TooltipPosition="FloatingPosition.Bottom">
            <i class="icon-more-vertical"></i>
        </HeaderButton>
    } else {
        <HeaderButton
            data-bubble="@(BubbleRef.New<RightChatPanelButtonBubble>())"
            data-bubble-priority="401"
            data-bubble-placement="@(FloatingPosition.BottomEnd.ToPositionString())"
            Click="Click"
            Tooltip="Chat properties"
            TooltipPosition="FloatingPosition.Bottom">
            <i class="icon-layout"></i>
        </HeaderButton>
    }
} else {
    @if (!isRightPanelVisible) {
        <HeaderButton
            data-bubble="@(BubbleRef.New<RightChatPanelButtonBubble>())"
            data-bubble-priority="401"
            data-bubble-placement="@(FloatingPosition.BottomEnd.ToPositionString())"
            Click="Click"
            Tooltip="Chat properties"
            TooltipPosition="FloatingPosition.Bottom">
            <i class="icon-layout"></i>
        </HeaderButton>
    }
}

@code {
    private Chat? Chat => ChatContext?.Chat;
    private IChats Chats => Hub.Chats;

    [CascadingParameter] public ChatContext? ChatContext { get; set; }
    [CascadingParameter] public ScreenSize ScreenSize { get; set; }
    [Parameter] public EventCallback Click { get; set; }

    protected override ComputedState<Model>.Options GetStateOptions()
        => ComputedStateComponent.GetStateOptions(GetType(),
            t => new ComputedState<Model>.Options() {
                InitialValue = Model.None,
                UpdateDelayer = FixedDelayer.NextTick,
                Category = GetStateCategory(t),
            });

    protected override async Task<Model> ComputeState(CancellationToken cancellationToken) {
        var chatId = Chat?.Id;
        Chat? chat = null;
        if (chatId is not null)
            chat = await Chats.Get(Session, chatId, cancellationToken).ConfigureAwait(false);

        var isRightPanelVisible = await PanelsUI.Right.IsVisible.Use(cancellationToken);

        if (ScreenSize.IsNarrow())
            return new Model() {
                Chat = chat,
                IsRightPanelVisible = true,
            }; // Do not hide button on narrow screen. Right panel will hide middle column with chat header entirely.

        return new Model {
            Chat = chat,
            IsRightPanelVisible = isRightPanelVisible,
        };
    }

    // Nested types

    public sealed record Model {
        public static readonly Model None = new();

        public Chat? Chat { get; init; }
        public bool IsRightPanelVisible { get; init; }
    }
}
