@namespace ActualChat.UI.Blazor.App.Components
@inherits Menu<AppUIHub>

<div class="call-audio-output-menu">
    @if (_output is { ExternalKind: { } externalKind } output) {
        foreach (var kind in new[] { externalKind, AudioOutputKind.Phone, AudioOutputKind.Speaker }) {
            <MenuEntry
                Class="@(kind == output.Kind ? "selected" : "")"
                Icon="@GetIcon(kind)"
                Text="@GetTitle(kind)"
                Click="@(() => OnClick(kind))">
            </MenuEntry>
        }
    }
</div>

@code {
    private ChatId? _chatId;
    private CallAudioOutput? _output;

    private CallScreensUI CallScreensUI => Hub.CallScreensUI;

    public static string GetIcon(AudioOutputKind kind)
        => kind switch {
            AudioOutputKind.Speaker => "icon-volume-up-2",
            AudioOutputKind.Phone => "icon-phone",
            _ => "icon-headphones-fill",
        };

    protected override async Task OnParametersSetAsync() {
        _chatId = ChatId.TryParse(Arguments.ElementAtOrDefault(0));
        _output = _chatId is { } chatId
            ? await CallScreensUI.GetAudioOutput(chatId, CancellationToken.None).ConfigureAwait(true)
            : null;
    }

    private void OnClick(AudioOutputKind kind) {
        if (_chatId is { } chatId)
            CallScreensUI.SetAudioOutput(chatId, kind);
    }

    private string GetTitle(AudioOutputKind kind)
        => kind switch {
            AudioOutputKind.Speaker => L.Call_AudioOutputSpeaker,
            AudioOutputKind.Phone => L.Call_AudioOutputPhone,
            AudioOutputKind.Bluetooth => L.Call_AudioOutputBluetooth,
            _ => L.Call_AudioOutputHeadphones,
        };
}
