@using ActualChat.UI.Blazor.App.Module
@namespace ActualChat.UI.Blazor.App.Components
@inherits ComponentBase<AppUIHub>
@implements IAsyncDisposable

<div @ref="Ref" class="font-size-slider">
    <label>
        <span class="slider-text">Font size: @_fontSize</span>
        <input
            class="slider-input"
            type="range"
            id="fontSizeSlider"
        />
    </label>
</div>

@code {
    private static readonly string JSCreateMethod = $"{BlazorUIAppModule.ImportName}.FontSizeSlider.create";

    private DotNetObjectReference<FontSizeSlider>? BlazorRef { get; set; }
    private IJSObjectReference? JSRef { get; set; }
    private ElementReference Ref { get; set; }

    private string[]? _fontSizes;
    private string? _fontSize;

    private readonly TaskCompletionSource _whenFontSizeInfoReady = TaskCompletionSourceExt.New();

    private FontSizeUI FontSizeUI => Hub.FontSizeUI;

    public async ValueTask DisposeAsync() {
        if (BlazorRef is null)
            return;

        await JSRef.DisposeSilentlyAsync("dispose");
        JSRef = null;
        BlazorRef.Dispose();
        BlazorRef = null;
    }

    protected override async Task OnInitializedAsync() {
        await FontSizeUI.FontSize.WhenFirstTimeRead;
        _fontSizes = await FontSizeUI.List(CancellationToken.None);
        _fontSize = FontSizeUI.FontSize.Value;
        if (_fontSizes is { Length: > 0 }) {
            if (_fontSize == null || !_fontSizes.Contains(_fontSize)) {
                _fontSize = _fontSizes[0];
            }
            _whenFontSizeInfoReady.TrySetResult();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (BlazorRef is not null)
            return;

        await _whenFontSizeInfoReady.Task;

        BlazorRef = DotNetObjectReference.Create(this);
        JSRef = await JS.InvokeAsync<IJSObjectReference>(
            JSCreateMethod,
            Ref,
            BlazorRef,
            _fontSizes,
            _fontSize
        );
    }

    [JSInvokable]
    public async Task OnFontSizeChangedFromJs(int index) {
        var newValue = _fontSizes![index];
        if (newValue == FontSizeUI.FontSize.Value)
            return;

        FontSizeUI.FontSize.Value = newValue;
        await FontSizeUI.FontSize.WhenWritten(CancellationToken.None);

        _fontSize = newValue;
        StateHasChanged();
    }
}
