@namespace ActualChat.UI.Blazor.App.Components
@using ActualChat.Live
@using ActualChat.UI.Blazor.App.Module
@inherits ComputedStateComponent<AppUIHub, CollapsedOutgoingCall.ComputedModel>
@{
    var m = State.Value;
    if (m.Author is not { } author)
        return;
}

<div class="collapsed-outgoing-call" @ref="Ref">
    <div class="c-av" @onclick="@OnExpandClick">
        <AuthorCircle AuthorId="@author.Id" Size="SquareSize.Size10"/>
    </div>
    <div class="c-name" @onclick="@OnExpandClick">
        <AuthorName AuthorId="@author.Id" Class="c-callee-name" ShowDetailsOnClick="false"/>
    </div>
    <ButtonRound Class="c-hang-up" Click="@OnHangUpClick">
        <i class="icon-phone-off text-2xl"></i>
    </ButtonRound>
</div>

@code {
    private static readonly string JSCreateMethod = $"{BlazorUIAppModule.ImportName}.DraggableCallIsland.create";

    private ElementReference Ref { get; set; }
    private IJSObjectReference? _jsRef;

    private IAuthors Authors => Hub.Authors;
    private CallUI CallUI => Hub.CallUI;
    private LiveSessionUI LiveSessionUI => Hub.LiveSessionUI;
    private IncomingCallUI IncomingCallUI => Hub.IncomingCallUI;

    protected override ComputedState<ComputedModel>.Options GetStateOptions()
        => ComputedStateComponent.GetStateOptions(GetType(),
            static t => new ComputedState<ComputedModel>.Options() {
                InitialValue = ComputedModel.None,
                UpdateDelayer = FixedDelayer.NextTick,
                Category = GetStateCategory(t),
            });

    protected override async Task<ComputedModel> ComputeState(CancellationToken cancellationToken) {
        var chatId = await IncomingCallUI.CollapsedOutgoingChatId.Use(cancellationToken).ConfigureAwait(false);
        if (chatId is not { } id)
            return ComputedModel.None;

        var live = await LiveSessionUI.Get(id, cancellationToken).ConfigureAwait(false);
        if (live is not { Kind: LiveSessionKind.Call, Conversation: null })
            return ComputedModel.None;

        var invitee = live.Invites.Count > 0 ? live.Invites[0].InviteeId : (AuthorId?)null;
        if (invitee is not { } inviteeId)
            return ComputedModel.None;

        var author = await Authors.Get(Session, id, inviteeId, cancellationToken).ConfigureAwait(false);
        return author is null ? ComputedModel.None : new ComputedModel { ChatId = id, Author = author };
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        // Attach / detach the drag controller as the island appears and disappears.
        var isShowing = State.Value.Author is not null;
        if (isShowing && _jsRef is null)
            _jsRef = await Hub.JS.InvokeAsync<IJSObjectReference>(JSCreateMethod, Ref).ConfigureAwait(true);
        else if (!isShowing && _jsRef is not null) {
            await _jsRef.DisposeAsync().ConfigureAwait(true);
            _jsRef = null;
        }
    }

    public override async ValueTask DisposeAsync() {
        if (_jsRef is not null) {
            await _jsRef.DisposeAsync().ConfigureAwait(true);
            _jsRef = null;
        }
        await base.DisposeAsync().ConfigureAwait(true);
    }

    private void OnExpandClick() {
        if (State.Value.ChatId is { } chatId)
            IncomingCallUI.ExpandOutgoing(chatId);
    }

    private Task OnHangUpClick()
        => State.Value.ChatId is { } chatId
            ? CallUI.CancelCall(chatId, CancellationToken.None)
            : Task.CompletedTask;

    // Nested types

    public sealed record ComputedModel {
        public static readonly ComputedModel None = new();
        public ChatId? ChatId { get; init; }
        public Author? Author { get; init; }
    }
}
