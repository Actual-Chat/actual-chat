@namespace ActualChat.UI.Blazor.App.Components
@using ActualChat.Live
@implements IModalView<OutgoingCallModal.Model>
@inherits ComputedStateComponent<AppUIHub, OutgoingCallModal.ComputedModel?>
@{
    var m = State.Value;
    if (m is null)
        return;

    if (m.Author is not { } author) {
        // Dialing ended (answered, no answer, declined, canceled elsewhere), or it was collapsed into
        // the island. This is a resolved close, so it must NOT re-collapse from Dispose.
        if (!_isAutoClosed) {
            _isAutoClosed = true;
            _handled = true;
            Modal.Close();
        }
        return;
    }
}

<DialogFrame
    Title="@L.Call_Outgoing"
    Class="author-modal modal-sm outgoing-call-modal"
    HasCloseButton="false">
    <Body>
    <IncomingCallModalHeader
        Author="author"
        IsOwn="true"
        OnCollapse="@OnCollapseClick"/>
    </Body>
    <Buttons>
        <ButtonRound Class="c-call-btn c-hang-up" Tooltip="@L.Call_HangUp" Click="@OnHangUpClick">
            <i class="icon-phone-off text-2xl"></i>
        </ButtonRound>
    </Buttons>
</DialogFrame>

@code {
    private bool _isAutoClosed;
    // True once resolved by an explicit action (hang up/collapse) or dialing ending on its own; still
    // false means the user dismissed the modal (tap outside/Esc), so Dispose must collapse to the island.
    private bool _handled;

    private IAuthors Authors => Hub.Authors;
    private CallUI CallUI => Hub.CallUI;
    private LiveSessionUI LiveSessionUI => Hub.LiveSessionUI;
    private CallScreensUI CallScreensUI => Hub.CallScreensUI;

    private ChatId ChatId => ModalModel.ChatId;  // Shortcut

    [CascadingParameter] public Modal Modal { get; set; } = null!;
    [Parameter] public Model ModalModel { get; set; } = null!;

    protected override async Task<ComputedModel?> ComputeState(CancellationToken cancellationToken) {
        var chatId = ChatId;

        // Collapsed into the island → close the modal; the island takes over.
        var collapsed = await CallScreensUI.CollapsedChatId.Use(cancellationToken).ConfigureAwait(false);
        if (collapsed == chatId)
            return ComputedModel.None;

        var live = await LiveSessionUI.Get(chatId, cancellationToken).ConfigureAwait(false);
        if (live is not { Kind: LiveSessionKind.Call, Conversation: null })
            return ComputedModel.None; // Not dialing (anymore) - answered, ended, or never was a call.

        var invitee = live.Invites.Count > 0 ? live.Invites[0].InviteeId : (AuthorId?)null;
        if (invitee is not { } inviteeId)
            return ComputedModel.None;

        var session = Session;
        var author = await Authors.Get(session, chatId, inviteeId, cancellationToken).ConfigureAwait(false);
        if (author is null)
            return ComputedModel.None;

        return new() { Author = author };
    }

    public override async ValueTask DisposeAsync() {
        // A tap outside (or Esc) closes via ModalChrome without touching the call, leaving it dialing
        // with no UI - so unless an explicit action already resolved this, collapse it to the island.
        if (!_handled)
            CallScreensUI.Collapse(ChatId);
        await base.DisposeAsync().ConfigureAwait(false);
    }

    private Task OnHangUpClick() {
        _handled = true;
        var chatId = ChatId;
        Modal.Close();
        return CallUI.CancelCall(chatId, CancellationToken.None);
    }

    // Collapse to the island: the modal auto-closes because ComputeState reads CollapsedChatId.
    private void OnCollapseClick() {
        _handled = true;
        CallScreensUI.Collapse(ChatId);
    }

    // Nested types

    public sealed record ComputedModel {
        public static readonly ComputedModel None = new();

        public Author? Author { get; init; }
    }

    public sealed record Model(ChatId ChatId);
}
