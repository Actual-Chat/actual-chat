@using ActualChat.Media
@using ActualChat.Users
@namespace ActualChat.UI.Blazor.App.Components
@inherits ComponentBase<AppUIHub>

@code {
    [Parameter, EditorRequired] public string Scope { get; set; } = "";
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public Picture? CurrentPicture { get; set; }
    [Parameter] public EventCallback<MediaRef> OnCropped { get; set; }
    [Parameter] public bool IsSquare { get; set; }
    [Parameter] public float ViewportAspectRatio { get; set; }
    [Parameter] public bool HasBlur { get; set; }
    // Generated avatar shown in the modal when there's no image. For accounts the key rides on the
    // Picture; for chats/places it's derived from the id, so it's passed in explicitly.
    [Parameter] public string CurrentAvatarKey { get; set; } = "";
    [Parameter] public string CurrentAvatarTitle { get; set; } = "";
    [Parameter] public AvatarKind AvatarKind { get; set; } = AvatarKind.Beam;

    public async Task Pick() {
        var imageUrl = ResolveInitialUrl(CurrentPicture);
        var avatarKey = imageUrl.IsNullOrEmpty()
            ? (CurrentPicture?.AvatarKey).NullIfEmpty() ?? CurrentAvatarKey
            : "";
        var model = new PicCropModal.Model(
            imageUrl, Scope, OnCroppedInternal, IsSquare, ViewportAspectRatio, HasBlur) {
            Title = Title,
            AvatarKey = avatarKey,
            AvatarTitle = CurrentAvatarTitle,
            AvatarKind = AvatarKind,
        };
        await Hub.ModalUI.Show(model).ConfigureAwait(true);
    }

    private string ResolveInitialUrl(Picture? picture) {
        if (picture is null)
            return "";
        if (picture.MediaRef is { } mediaRef)
            return UrlMapper.ContentUrl(mediaRef.BlobId);
        if (!picture.ExternalUrl.IsNullOrEmpty())
            return picture.ExternalUrl;
        return "";
    }

    private void OnCroppedInternal(MediaRef mediaRef)
        => _ = OnCropped.InvokeAsync(mediaRef);
}
