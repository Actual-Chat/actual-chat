@namespace ActualChat.UI.Blazor.App.Components
@inherits ComponentBase<UIHub>
@{
    var icon = IsVerified ? "icon-checkmark-circle-2" : "icon-alert-circle";
    var text = IsVerified ? L.Common_Verified : L.Common_Unverified;
    var colorCls = IsVerified ? "text-success" : "text-danger";
    var cursorCls = !IsVerified ? "cursor-pointer" : "";
}

<div class="verification-status @Class @cursorCls"
     @onclick="@(IsVerified ? default : Verify)"
     data-tooltip="@text">
    <i class="@icon text-xl @colorCls" aria-hidden="true"></i>
</div>


@code {

    [Parameter, EditorRequired] public bool IsVerified { get; set; }
    [Parameter] public string Class { get; set; } = "";
    [Parameter] public EventCallback Verify { get; set; }
}
