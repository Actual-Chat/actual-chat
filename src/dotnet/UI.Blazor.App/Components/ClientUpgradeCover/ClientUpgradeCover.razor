@namespace ActualChat.UI.Blazor.App.Components
@using ActualChat.Hosting
@using ActualLab.Rpc
@inherits ComputedStateComponent<ServerApiInfo>
@if (State.LastNonErrorValue is not { CompatibilityLevel: CompatibilityLevel.Incompatible } serverApiInfo) {
    @ChildContent
    return;
}

<div class="client-upgrade-cover">
    <div class="c-header">
        <div class="c-logo">
            <img draggable="false" src="/dist/images/voxt-white-horizontal.svg" alt="" class="light-title">
        </div>
    </div>
    <div class="c-content">
        <upgrade-app-cat-svg/>
        <div class="c-title">
            Please update @CoreConstants.AppName
        </div>
        <div class="c-text">
            <p>
                You are using @CoreConstants.AppName client
                <span class="whitespace-nowrap font-bold">v@(ApiConstants.VersionString)</span>,
                and it is incompatible with the current server API
                <span class="whitespace-nowrap font-bold">v@(serverApiInfo.VersionString)</span>.
            </p>
        </div>
        <div class="c-button">
            @if (!_appLink.IsNullOrEmpty()) {
                <Button Class="btn-primary btn-w-full" data-href="@_appLink">
                    Update
                </Button>
            } else {
                <Button Class="btn-primary btn-w-full" Click="@(() => ReloadUI.Reload())">
                    Update
                </Button>
            }
        </div>
    </div>
</div>

@code {
    private string? _appLink;

    [Inject] private UIHub Hub { get; set; } = null!;
    private HostInfo HostInfo => Hub.HostInfo;
    private ISystemProperties SystemProperties => Hub.SystemProperties;
    private ReloadUI ReloadUI => Hub.ReloadUI;

    [Parameter] public RenderFragment? ChildContent { get; set; }

    protected override void OnInitialized() {
        _appLink = HostInfo.AppKind switch {
            AppKind.Ios => Links.Apps.iOS,
            AppKind.MacOS => Links.Apps.iOS,
            AppKind.Android => Links.Apps.Android,
            AppKind.Windows => Links.Apps.Windows,
            // _ => Links.Apps.Android,
            _ => null,
        };
    }

    protected override ComputedState<ServerApiInfo>.Options GetStateOptions()
        => ComputedStateComponent.GetStateOptions(GetType(),
            static t => new ComputedState<ServerApiInfo>.Options() {
                InitialValue = new ServerApiInfo(CompatibilityLevel.Unknown),
                UpdateDelayer = FixedDelayer.NextTick,
                Category = GetStateCategory(t),
            });

    protected override async Task<ServerApiInfo> ComputeState(CancellationToken cancellationToken) {
        if (State.LastNonErrorValue is { CompatibilityLevel: CompatibilityLevel.Incompatible } last)
            return last;

        // Check if the RPC peer terminated due to unsupported serialization format
        var peerState = await Hub.ReconnectUI.State.Use(cancellationToken).ConfigureAwait(false);
        if (peerState.LastError is RpcSerializationFormatException)
            return new ServerApiInfo(CompatibilityLevel.Incompatible);

        return await SystemProperties.GetServerApiInfo(cancellationToken).ConfigureAwait(false);
    }
}
