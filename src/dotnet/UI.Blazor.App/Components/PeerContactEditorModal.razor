@using ActualChat.Contacts
@namespace ActualChat.UI.Blazor.App.Components
@inherits ComponentBase<AppUIHub>
@implements IModalView<PeerContactEditorModal.Model>

<Form @ref="_formRef" Class="h-full" Model="@_form" OnSubmit="@OnSave">
    <DataAnnotationsValidator/>
    <DialogFrame
        Class="peer-contact-editor-modal modal-sm"
        Title="Edit contact"
        HasCloseButton="true"
        ButtonsClass="full-width">
        <Body>
        <FormBlock>
            @if (_peerAvatar is not null) {
                <div class="avatar-badge">
                    <AvatarCircle
                        Avatar="@_peerAvatar"
                        Size="@SquareSize.Size9"
                        IsBlurred="@false"/>
                    <div class="c-name">
                        <div class="c-title">@(_form.PeerContactName.NullIfEmpty() ?? _peerOwnName)</div>
                        @if (!_form.PeerContactName.IsNullOrEmpty()) {
                            <div class="c-peer-own-name">@_peerOwnName</div>
                        }
                    </div>
                </div>
            }
            <FormSection For="() => _form.PeerContactName" InputId="@_form.PeerContactNameFieldId" Label="Display Name" IsLabelInsideInput="true">
                <TextBox @bind-Value="@_form.PeerContactName" Id="@_form.PeerContactNameFieldId" />
            </FormSection>
        </FormBlock>
        @if (_contact is not null) {
            <FormBlock Class="block-user-form-block">
                <Button
                    Type="@ButtonType.Button"
                    Class="btn-modal btn-danger"
                    Click="@OnToggleBlock">
                    @(_contact.IsBlocked ? "Unblock user" : "Block user")
                </Button>
            </FormBlock>
        }
        </Body>
        <Buttons>
            <FormButtons>
                @{
                    var submitClass = $"btn-modal btn-primary {_formRef.IsValid.ToEnabledClass()}";
                }
                <Button Type="@ButtonType.Button" Class="btn-modal" Click="OnCancel">Cancel</Button>
                <Button Type="@ButtonType.Submit" IsDisabled="@(_contact is null)" Class="@submitClass">Save</Button>
            </FormButtons>
        </Buttons>
    </DialogFrame>
</Form>

@code {
    private Form _formRef = null!;
    private FormModel _form = null!;
    private Contact? _contact;
    private Avatar? _peerAvatar;
    private string? _peerOwnName;
    private string? _peerExternalContactName;

    private IContacts Contacts => Hub.Contacts;

    [CascadingParameter] public Modal Modal { get; set; } = null!;
    [Parameter] public Model ModalModel { get; set; } = null!;

    protected override async Task OnInitializedAsync() {
        var cancellationToken = CancellationToken.None;
        _form = new FormModel(ComponentIdGenerator).CopyToBase(); // Must be fully initialized in sync part
        var peerContactId = ModalModel.PeerContactId;
        _contact = await Contacts.Get(Session, peerContactId, cancellationToken).ConfigureAwait(false);
        var peerContactName = _contact?.PeerContactName ?? "";
        _form.PeerContactName = peerContactName;
        _form.CopyToBase();
        if (_contact is null)
            return;

        _peerExternalContactName = _contact.ExternalContactName;
        _peerAvatar = _contact.Account?.Avatar;
        _peerOwnName = _peerExternalContactName.NullIfWhiteSpace() ?? _peerAvatar?.Name ?? "";
    }

    private async Task OnSave() {
        var contact = _contact! with {
            PeerContactName = _form.PeerContactName
        };
        var command = new Contacts_Change(Session, contact.Id, contact.Version, Change.Update(contact));
        var (_, error) = await UICommander.Run(command);
        if (error != null)
            return;

        CloseModal();
    }

    private async Task OnToggleBlock() {
        if (_contact is null)
            return;

        var (_, error) = await Hub.PeerBlockUI.SetBlocked(_contact.Id, !_contact.IsBlocked);
        if (error != null)
            return;

        CloseModal();
    }

    private void OnCancel()
        => CloseModal();

    private void CloseModal()
        => Modal.Close();

    // Nested types

    public sealed class FormModel : FormModel<FormModel> {
        public string PeerContactName { get; set; } = "";
        public string PeerContactNameFieldId { get; set; } = "";

        public FormModel(ComponentIdGenerator? componentIdGenerator)
            : base("peer-contact-editor", componentIdGenerator) {
        }
    }

    public sealed record Model(ContactId PeerContactId);
}
