@namespace ActualChat.UI.Blazor.App.Components
@using ActualChat.Kvas
@inherits ComputedStateComponent<AppUIHub, VoiceSettingsButton.Model?>
@{
    var m = State.Value;
    if (m is null)
        return;

    var language = m.ChatLanguage;
    var primary = m.Primary;
}

@if (IsNarrow) {
    <button class="volume-settings-btn text" @onclick="@OnClick">
        <div class="c-text">@((language ?? primary).ShortTitle)</div>
    </button>
} else {
    <div class="language-wrapper">
        <div class="selected-language">@(language is not null ? language.ShortTitle : "?" + primary.ShortTitle + "?")</div>
        <ButtonRound
            Class="transcription-options-btn"
            Tooltip="Voice settings"
            TooltipPosition="FloatingPosition.Top"
            Click="@OnClick">
            <i class="icon-options-2"></i>
        </ButtonRound>
    </div>
}

@code {
    private ChatId? _detectedLanguageChatId;

    private LanguageUI LanguageUI => Hub.LanguageUI;

    [Parameter, EditorRequired] public Chat Chat { get; set; } = null!;
    [Parameter, EditorRequired] public bool IsNarrow { get; set; }

    protected override ComputedState<Model?>.Options GetStateOptions()
        => ComputedStateComponent.GetStateOptions(GetType(),
            static t => new ComputedState<Model?>.Options() {
                UpdateDelayer = FixedDelayer.NextTick,
                Category = GetStateCategory(t),
            });

    protected override async Task<Model?> ComputeState(CancellationToken cancellationToken) {
        var chat = Chat;
        var chatId = chat.Id;
        var data = await LanguageUI.GetChatLanguageAndPrimary(chatId, cancellationToken).ConfigureAwait(false);
        if (data.Item1 is null && _detectedLanguageChatId != chatId) {
            var detectedLanguage = await AccountSettings.UserChatRecordingDetectedLanguage().Get(cancellationToken).ConfigureAwait(false);
            if (detectedLanguage.ChatId == chatId
                && detectedLanguage.Language is not null
                && IsRecent(detectedLanguage.Timestamp)) {
                _detectedLanguageChatId = chatId;
                _ = UpdateChatLanguage(chat, detectedLanguage.Language);
            }
        }
        return new Model(data.Item1, data.Item2);
    }

    private bool IsRecent(Moment timestamp)
        => (Clocks.SystemClock.Now - timestamp).Positive().TotalSeconds < 60;

    private void OnClick()
        => ModalUI.Show(new VoiceSettingsModal.Model(Chat.Id));

    private Task UpdateChatLanguage(Chat chat, Language language)
        => InvokeAsync(async () => {
            CancellationToken cancellationToken = default;
            await LanguageUI.ChangeChatLanguage(chat.Id, language, cancellationToken);
            ToastUI.Show($"Detected transcription language for chat '{chat.Title}' is {language.Title}.", OnClick, "Change", ToastDismissDelay.Long);
        });

    // Nested types
    public record Model(Language? ChatLanguage, Language Primary);
}
