@namespace ActualChat.UI.Blazor.App.Components
@inherits ComputedStateComponent<AppUIHub, VoiceSettingsStartModalPage.ComputedModel>
@{
    var m = State.Value;
    var voiceStatus = !m.CanChangeMustStreamVoice
        ? "Disabled for anonymous users"
        : m.MustStreamVoice
            ? "On"
            : "Off";
}

<FormBlock Class="first last">
    <LanguageButtonGroup ChatId="@ChatId" Click="@(() => Context.Close())"/>

    <TileItem Click="@OnVoiceStreamingClick">
        <Icon><i class="icon-voice-01 text-2xl"></i></Icon>
        <Content>Voice streaming</Content>
        <Caption>@voiceStatus</Caption>
        <Right>
            <Toggle
                IsDisabled="@(!m.CanChangeMustStreamVoice)"
                IsChecked="@m.MustStreamVoice"
                IsCheckedChanged="@(_ => OnVoiceStreamingClick())" />
        </Right>
    </TileItem>

    @if (m.EnableIncompleteUI) {
        var pttCaption = m.PttEnabledAt is null
            ? "Not enabled in this chat"
            : m.IsPtt
                ? "Wakes this device when someone speaks"
                : m.IsAtPttCapacity
                    ? $"Already on in {UserPttSettings.MaxChatCount} chats"
                    : "Off";
        <TileItem Click="@OnPttClick">
            <Icon><i class="icon-talking text-2xl"></i></Icon>
            <Content>Push-to-talk</Content>
            <Caption>@pttCaption</Caption>
            <Right>
                <Toggle
                    IsDisabled="@(m.PttEnabledAt is null || m.IsAtPttCapacity)"
                    IsChecked="@m.IsPtt"
                    IsCheckedChanged="@(_ => OnPttClick())"/>
            </Right>
        </TileItem>
    }

</FormBlock>

@code {
    [CascadingParameter] public DiveInModalPageContext Context { get; set; } = null!;

    private ChatId ChatId { get; set; } = null!;

    protected override void OnInitialized() {
        ChatId = Context.GetModel<ChatId>();
        Context.Title = "Voice settings";
    }

    protected override ComputedState<ComputedModel>.Options GetStateOptions()
        => ComputedStateComponent.GetStateOptions(GetType(),
            static t => new ComputedState<ComputedModel>.Options() {
                InitialValue = new(false, false, false, false, null, false),
                UpdateDelayer = FixedDelayer.NextTick,
                Category = GetStateCategory(t),
            });

    protected override async Task<ComputedModel> ComputeState(CancellationToken cancellationToken) {
        var chatId = ChatId;
        var settings = await UserSettingsUI.GetChatVoiceMode(chatId, cancellationToken).ConfigureAwait(false);
        var chat = await Hub.Chats.Get(Session, chatId, cancellationToken).ConfigureAwait(false);
        var pttEnabledAt = chat?.PttEnabledAt;
        var pttChatIds = await Hub.ChatAudioUI.GetPttChatIds(cancellationToken).ConfigureAwait(false);
        var isPtt = pttChatIds.Contains(chatId);
        var mustStreamVoice = settings.VoiceMode.HasVoice();
        var isIncompleteUIEnabled = await Hub.Features.IsIncompleteUIEnabled(cancellationToken).ConfigureAwait(false);
        return new (
            mustStreamVoice,
            settings.CanChange,
            isPtt,
            !isPtt && pttChatIds.Count >= UserPttSettings.MaxChatCount,
            pttEnabledAt,
            isIncompleteUIEnabled);
    }

    private async Task OnMustStreamVoiceChanged(bool mustStreamVoice) {
        var voiceMode = mustStreamVoice
            ? VoiceMode.TextAndVoice
            : VoiceMode.JustText;
        await UserSettingsUI.SetChatVoiceMode(ChatId, voiceMode);
    }

    private Task OnVoiceStreamingClick()
        => OnMustStreamVoiceChanged(!State.Value.MustStreamVoice);

    private async Task OnPttClick() {
        var m = State.Value;
        if (m.PttEnabledAt is not { } enabledAt)
            return;

        var chatId = ChatId;
        if (m.IsPtt) {
            await UserSettingsUI.UserPttSettings()
                .Update(x => x.WithoutPttChat(chatId), CancellationToken.None);
            return;
        }

        if (m.IsAtPttCapacity)
            return;

        var pttChatIds = await Hub.ChatAudioUI.GetPttChatIds(CancellationToken.None).ConfigureAwait(true);
        // Never a raw client clock: JoinedAt must land within the current epoch (>= enabledAt).
        var joinedAt = Moment.Max(Clocks.ServerClock.Now, enabledAt);
        await UserSettingsUI.UserPttSettings().Update(
            x => x.WithOnlyPttChats(pttChatIds.ToHashSet()).WithPttChat(chatId, joinedAt),
            CancellationToken.None);
    }

    // Nested types

    public sealed record ComputedModel(
        bool MustStreamVoice,
        bool CanChangeMustStreamVoice,
        bool IsPtt,
        bool IsAtPttCapacity,
        Moment? PttEnabledAt,
        bool EnableIncompleteUI);
}
