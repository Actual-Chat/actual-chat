@namespace ActualChat.UI.Blazor.App.Components
@inherits ComputedStateComponent<AppUIHub, VideoToggle.Model>
@{
    var m = State.Value;
    var isVideoOn = m.IsLocalVideoRecording;
    var stateCls = isVideoOn ? "video-on" : "video-off";
    var wrapperCls = $"{stateCls}";
    if (IsNarrow)
        wrapperCls += " narrow";
    var tooltip = isVideoOn ? "Stop video" : "Start video";
}

<div class="@wrapperCls video-wrapper">
    <ButtonRound
        Click="@OnVideoClick"
        Tooltip="@tooltip"
        TooltipPosition="FloatingPosition.Top">
        <i class="icon-video text-2xl"></i>
    </ButtonRound>
</div>

@code {
    private IAuthors Authors => Hub.Authors;
    private ChatVideoUI ChatVideoUI => Hub.ChatVideoUI;

    [Parameter, EditorRequired] public Chat Chat { get; set; } = null!;
    [Parameter] public bool IsNarrow { get; set; }

    protected override ComputedState<Model>.Options GetStateOptions()
        => new() {
            InitialValue = Model.NewLoading(Chat),
            UpdateDelayer = FixedDelayer.NextTick,
            Category = GetStateCategory(GetType()),
        };

    protected override async Task<Model> ComputeState(CancellationToken cancellationToken) {
        var chat = Chat;
        var chatId = chat.Id;

        var videoStreams = await ChatVideoUI.GetActiveVideoStreams(chatId, cancellationToken).ConfigureAwait(false);
        var ownAuthor = await Authors.GetOwn(Session, chatId, cancellationToken).ConfigureAwait(false);
        var recordingChatId = await ChatVideoUI.GetRecordingChatId(cancellationToken).ConfigureAwait(false);
        var isLocalVideoRecording = recordingChatId == chatId;

        var isOwnVideoStreaming = ownAuthor != null && videoStreams.Any(s => s.AuthorId == ownAuthor.Id);
        var areOthersVideoStreaming = videoStreams.Count > (isOwnVideoStreaming ? 1 : 0);

        return new(chat, isOwnVideoStreaming, areOthersVideoStreaming, isLocalVideoRecording);
    }

    private void OnVideoClick() {
        var m = State.Value;
        if (m.IsLocalVideoRecording) {
            // Recording → stop
            ChatVideoUI.SetRecordingChatId(null);
        } else if (ChatVideoUI.HasJoinedVideoCall(Chat.Id)) {
            // Previously recorded this session → resume without modal
            ChatVideoUI.ResumeRecording(Chat.Id);
        } else {
            // First time → open modal to confirm
            ChatVideoUI.JoinVideoSession(Chat.Id);
        }
    }

    // Nested types

    public sealed record Model(
        Chat Chat,
        bool IsOwnVideoStreaming,
        bool AreOthersVideoStreaming,
        bool IsLocalVideoRecording
    ) {
        public static Model NewLoading(Chat chat) => new(chat, false, false, false);
    }
}
