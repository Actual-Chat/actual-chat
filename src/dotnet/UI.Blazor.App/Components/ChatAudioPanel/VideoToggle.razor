@namespace ActualChat.UI.Blazor.App.Components
@using ActualChat.Streaming
@inherits ComputedStateComponent<AppUIHub, bool>
@{
    var isVideoOn = State.Value;
    var stateCls = isVideoOn ? "video-on" : "video-off";
    var wrapperCls = stateCls;
    if (IsNarrow)
        wrapperCls += " narrow";
    var tooltip = isVideoOn ? "Stop video" : "Start video";
}

<div class="@wrapperCls video-wrapper">
    <ButtonRound
        Click="@(() => OnVideoClick(!isVideoOn))"
        Tooltip="@tooltip"
        TooltipPosition="FloatingPosition.Top">
        <i class="icon-video text-2xl"></i>
    </ButtonRound>
</div>

@code {
    private ChatVideoUI ChatVideoUI => Hub.ChatVideoUI;

    [Parameter, EditorRequired] public Chat Chat { get; set; } = null!;
    [Parameter] public bool IsNarrow { get; set; }

    protected override ComputedState<bool>.Options GetStateOptions()
        => new() {
            InitialValue = false,
            UpdateDelayer = FixedDelayer.NextTick,
            Category = GetStateCategory(GetType()),
        };

    protected override async Task<bool> ComputeState(CancellationToken cancellationToken) {
        var chat = Chat;
        var chatId = chat.Id;

        var ownStreamKind = await ChatVideoUI.GetOwnStreamKind(chatId, cancellationToken).ConfigureAwait(false);
        var isOwnCameraStreaming = ownStreamKind == StreamKind.Webcam;
        return isOwnCameraStreaming;
    }

    private void OnVideoClick(bool enable) {
        if (!enable) {
            // Recording → stop
            ChatVideoUI.StopStreaming();
        } else if (ChatVideoUI.HasJoinedVideoCall(Chat.Id)) {
            // Previously recorded this session → resume without modal
            ChatVideoUI.ResumeVideoStreaming(Chat.Id);
        } else {
            // First time → open modal to confirm
            ChatVideoUI.JoinVideoSession(Chat.Id);
        }
    }

    // Nested types

    public sealed record Model(
        Chat Chat,
        bool IsOwnVideoStreaming,
        bool IsLocalVideoRecording
    ) {
        public static Model NewLoading(Chat chat) => new(chat, false, false);
    }
}
