@namespace ActualChat.UI.Blazor.App.Components
@using ActualChat.UI.Blazor.Events
@inherits ComputedStateComponent<AppUIHub, (IReadOnlyList<Language>?, Language)>
@{
    var m = State.Value;
    var (languages, language) = m;
    if (languages == null)
        return; // Loading

    var useShortTitle = languages.Count > 2;
}

<div class="language-btn-group">
    @if (languages.Count < 2) {
        <div class="c-settings-hint">
            @L.VoiceSettings_SecondLanguageHint_Prefix<a
                class="link"
                @onclick="@OnConfigureSecondLanguage"
                @onclick:preventDefault="true">@L.Common_Settings</a>@L.VoiceSettings_SecondLanguageHint_Suffix
        </div>
    }
    <div class="c-title">
        @L.VoiceSettings_TranscriptionLanguage@**@
        @if (languages.Count > 1) {
            <span
                @onclick="@OnConfigureSecondLanguage"
                class="c-edit"
                role="button"
                tabindex="0">@L.VoiceSettings_Setup</span>
        }
        @**@:
    </div>
    <SegmentedSwitch
        Class="pill"
        Items="@BuildItems(languages, useShortTitle)"
        SelectedId="@language.Value"
        SelectedIdChanged="@OnLanguageIdChanged"
        MustPlayClickTune="false"/>
</div>

@code {
    private const string AddLanguageId = "@add";

    private LanguageUI LanguageUI => Hub.LanguageUI;

    [Parameter, EditorRequired] public ChatId ChatId { get; set; } = null!;

    protected override ComputedState<(IReadOnlyList<Language>?, Language)>.Options GetStateOptions()
        => ComputedStateComponent.GetStateOptions(GetType(),
            static t => new ComputedState<(IReadOnlyList<Language>?, Language)>.Options() {
                UpdateDelayer = FixedDelayer.NextTick,
                Category = GetStateCategory(t),
            });

    protected override async Task<(IReadOnlyList<Language>?, Language)> ComputeState(CancellationToken cancellationToken) {
        var chatId = ChatId;

        var languages = await LanguageUI.Settings.Use(LanguageUI.WhenReady, cancellationToken).ConfigureAwait(false);
        var language = await LanguageUI.GetChatLanguage(chatId, cancellationToken).ConfigureAwait(false);
        return (languages.ListSpoken(), language);
    }

    private IReadOnlyList<SegmentedSwitchItem> BuildItems(IReadOnlyList<Language> languages, bool useShortTitle) {
        var items = new List<SegmentedSwitchItem>(languages.Count + 1);
        foreach (var l in languages)
            items.Add(new(l.Value, useShortTitle ? l.ShortTitle : l.Title));
        if (languages.Count == 1)
            items.Add(new(AddLanguageId, L.VoiceSettings_AddLanguage));
        return items;
    }

    private Task OnLanguageIdChanged(string id) {
        if (id == AddLanguageId) {
            // MustPlayClickTune is off for the language segments, and this one changes no language
            _ = TuneUI.Play(Tune.ClickButton);
            OnConfigureSecondLanguage();
            return Task.CompletedTask;
        }
        return LanguageUI.ChangeChatLanguage(ChatId, Language.Parse(id));
    }

    private void OnConfigureSecondLanguage()
        => _ = UIEventHub.Publish(new ShowSettingsEvent(SettingsTabId.Transcription));
}
