@namespace ActualChat.UI.Blazor.App.Components
@inherits ComputedStateComponent<AppUIHub, ChatAudioPanel.Model>
@{
    var m = State.Value;
    var audioState = m.AudioState;
    var isRecording = audioState?.IsRecording == true;
    var isOwnVideoStreaming = m.IsOwnVideoStreaming;
    var isHeaderVisible = audioState != null && IsNarrow
        && audioState.IsListening
        && (audioState.IsRecording || isOwnVideoStreaming);
    var enableIncompleteUI = m.EnableIncompleteUI;
    var allowVideo = m.IsVideoFeatureEnabled;
}

<div class="chat-audio-panel">
    @if (enableIncompleteUI && isHeaderVisible) {
        <div class="audio-panel-header">
            <div class="c-left">
                <ButtonRound>
                    <i class="icon-cast text-xl"></i>
                </ButtonRound>
            </div>
            <div class="c-right">
                <VideoToggle Chat="@Chat" IsNarrow="true" />
            </div>
        </div>
    }
    <div class="audio-panel-wrapper">
        <div class="playback-button"
             data-bubble="@(BubbleRef.New<ListenButtonBubble>())"
             data-bubble-priority="110"
             data-bubble-placement="@(FloatingPosition.TopEnd.ToPositionString())">
            <PlaybackToggle Chat="@Chat"/>
        </div>
        @if (allowVideo && !IsNarrow && (isRecording || isOwnVideoStreaming)) {
            <VideoToggle Chat="@Chat" />
        }
        <div class="recorder-button">
            <div data-bubble="@(BubbleRef.New<RecordButtonBubble>())"
                 data-bubble-priority="100"
                 data-bubble-placement="@(FloatingPosition.Top.ToPositionString())">
            </div>
            <RecorderToggle Chat="@Chat"/>
        </div>
        @if (allowVideo && IsNarrow) {
            <VoiceSettingsButton Chat="@Chat" IsNarrow="true" />
        }
        <div class="language-button"
             data-bubble="@(BubbleRef.New<VoiceSettingsButtonBubble>())"
             data-bubble-priority="120"
             data-bubble-placement="@(FloatingPosition.TopStart.ToPositionString())">
            <VoiceSettingsButton Chat="@Chat" IsNarrow="false" />
        </div>
    </div>
</div>

@code {
    private ChatAudioUI ChatAudioUI => Hub.ChatAudioUI;
    private ChatVideoUI ChatVideoUI => Hub.ChatVideoUI;

    [Parameter, EditorRequired] public Chat Chat { get; set; } = null!;
    [Parameter] public bool IsNarrow { get; set; }

    protected override async Task<Model> ComputeState(CancellationToken cancellationToken) {
        var chat = Chat;
        var enableIncompleteUI = await Features.IsIncompleteUIEnabled(cancellationToken).ConfigureAwait(false);
        var settings = await AccountSettings.UserAppSettings().Get(cancellationToken).ConfigureAwait(false);
        var isVideoFeatureEnabled = settings.AreExperimentalFeaturesEnabled ?? false;
        if (chat?.Id is null)
            return new(null, enableIncompleteUI, false, isVideoFeatureEnabled);

        var audioState = await ChatAudioUI.GetState(chat.Id).ConfigureAwait(false);
        var isOwnVideoStreaming = await ChatVideoUI.GetRecordingChatId(cancellationToken).ConfigureAwait(false) == chat.Id;
        return new(
            audioState,
            enableIncompleteUI,
            isOwnVideoStreaming,
            isVideoFeatureEnabled);
    }

    // Nested classes

    public sealed record Model(ChatAudioState? AudioState, bool EnableIncompleteUI, bool IsOwnVideoStreaming, bool IsVideoFeatureEnabled);
}
