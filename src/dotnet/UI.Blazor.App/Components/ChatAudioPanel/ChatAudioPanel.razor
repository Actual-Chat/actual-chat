@namespace ActualChat.UI.Blazor.App.Components
@using ActualChat.UI.Blazor.App.Module
@inherits ComputedStateComponent<AppUIHub, ChatAudioPanel.Model>
@{
    var m = State.Value;
    var audioState = m.AudioState;
    var isRecording = audioState?.IsRecording == true;
    var isOwnVideoStreaming = m.IsOwnVideoStreaming;
    var isAnyoneVideoStreaming = m.IsAnyoneVideoStreaming;
    var isHeaderVisible = audioState != null && IsNarrow
        && (audioState.IsListening || isOwnVideoStreaming)
        && (audioState.IsRecording || isOwnVideoStreaming || isAnyoneVideoStreaming);
    var allowVideo = m.IsVideoFeatureEnabled;
}

<div class="chat-audio-panel">
    @if (allowVideo && isHeaderVisible) {
        <div class="audio-panel-header">
            <div class="c-left">
                @if (isOwnVideoStreaming) {
                    <ButtonRound Click="@OnSwitchCamera">
                        <i class="icon-camera-switch text-2xl"></i>
                    </ButtonRound>
                } else {
                    <div class="c-incut"></div>
                }
                <VideoToggle Chat="@Chat" IsNarrow="true"/>
            </div>
            <div class="c-right">
                <VoiceSettingsButton Chat="@Chat" IsNarrow="false" />
                <div class="c-incut"></div>
            </div>
        </div>
    }
    <div class="audio-panel-wrapper">
        @if (allowVideo && !IsNarrow && (isRecording || isOwnVideoStreaming || isAnyoneVideoStreaming)) {
            <div class="@(m.IsScreencasting ? "screencast-on" : "screencast-off") screencast-wrapper">
                <ButtonRound Click="@OnScreencastClick"
                    Tooltip="@(m.IsScreencasting ? "Stop screen share" : "Share screen")"
                    TooltipPosition="FloatingPosition.Top">
                    <i class="icon-screen-share text-2xl"></i>
                </ButtonRound>
            </div>
            <VideoToggle Chat="@Chat" />
        }
        <div class="recorder-button">
            <div data-bubble="@(BubbleRef.New<RecordButtonBubble>())"
                 data-bubble-priority="100"
                 data-bubble-placement="@(FloatingPosition.Top.ToPositionString())">
            </div>
            <RecorderToggle Chat="@Chat"/>
        </div>
        @if (IsNarrow) {
            <VoiceSettingsButton Chat="@Chat" IsNarrow="true" />
        }
        <div class="language-button"
             data-bubble="@(BubbleRef.New<VoiceSettingsButtonBubble>())"
             data-bubble-priority="120"
             data-bubble-placement="@(FloatingPosition.TopStart.ToPositionString())">
            <VoiceSettingsButton Chat="@Chat" IsNarrow="false" />
        </div>
    </div>
</div>

@code {
    private static readonly string JSEnumerateMethod = $"{BlazorUIAppModule.ImportName}.JoinVideoCallModal.enumerateDevices";

    private record VideoDevice(string DeviceId, string Label);

    private string _selectedDeviceId = "";
    private List<VideoDevice> _videoDevices = new();

    private ChatAudioUI ChatAudioUI => Hub.ChatAudioUI;
    private ChatVideoUI ChatVideoUI => Hub.ChatVideoUI;

    [Parameter, EditorRequired] public Chat Chat { get; set; } = null!;
    [Parameter] public bool IsNarrow { get; set; }

    protected override async Task OnInitializedAsync() {
        var settings = await Hub.LocalSettings.LocalAppSettings().Get();
        _selectedDeviceId = settings.SelectedCameraDeviceId ?? "";
    }

    private async Task LoadVideoDevices() {
        try {
            var devices = await JS.InvokeAsync<VideoDevice[]>(JSEnumerateMethod);
            _videoDevices = devices.ToList();
        } catch {
            _videoDevices = new();
        }
    }

    private async Task OnSwitchCamera() {
        await LoadVideoDevices();
        if (_videoDevices.Count <= 1)
            return;

        var currentIndex = _videoDevices.FindIndex(d => d.DeviceId == _selectedDeviceId);
        var nextIndex = (currentIndex + 1) % _videoDevices.Count;
        var nextDevice = _videoDevices[nextIndex];

        _selectedDeviceId = nextDevice.DeviceId;
        await Hub.LocalSettings.LocalAppSettings().Update(
            s => s with { SelectedCameraDeviceId = nextDevice.DeviceId });
        ChatVideoUI.SetSelectedCamera(nextDevice.DeviceId);
    }

    private void OnScreencastClick() {
        var chat = Chat;
        if (chat?.Id is null)
            return;

        var m = State.Value;
        if (m.IsScreencasting)
            ChatVideoUI.SetRecordingChatId(null);
        else
            ChatVideoUI.SetScreencasting(chat.Id);
    }

    protected override ComputedState<Model>.Options GetStateOptions()
        => ComputedStateComponent.GetStateOptions(GetType(),
            static t => new ComputedState<Model>.Options {
                InitialValue = new Model(null, false, false, false),
                UpdateDelayer = FixedDelayer.NextTick,
                Category = GetStateCategory(t),
            });

    protected override async Task<Model> ComputeState(CancellationToken cancellationToken) {
        var chat = Chat;
        var isVideoFeatureEnabled = await Features.IsVideoStreamingEnabled(cancellationToken).ConfigureAwait(false);
        if (chat?.Id is null)
            return new(null, false, false, isVideoFeatureEnabled);

        var audioState = await ChatAudioUI.GetState(chat.Id).ConfigureAwait(false);
        var videoState = await ChatVideoUI.GetState(chat.Id, cancellationToken).ConfigureAwait(false);
        var isOwnVideoStreaming = videoState.IsRecording;
        var isAnyoneVideoStreaming = await ChatVideoUI.IsAnyoneVideoStreaming(chat.Id, cancellationToken).ConfigureAwait(false);
        return new(
            audioState,
            isOwnVideoStreaming,
            isAnyoneVideoStreaming,
            isVideoFeatureEnabled,
            videoState.IsScreencasting);
    }

    // Nested classes

    public sealed record Model(ChatAudioState? AudioState, bool IsOwnVideoStreaming, bool IsAnyoneVideoStreaming, bool IsVideoFeatureEnabled, bool IsScreencasting = false);
}
