@namespace ActualChat.UI.Blazor.App.Components
@inherits ComputedStateComponent<AppUIHub, ChatAudioPanel.Model>
@{
    var m = State.Value;
    var audioState = m.AudioState;
    var isListening = audioState?.IsListening == true;
    var isRecording = audioState?.IsRecording == true;
    var isVideoEnabled = m.IsVideoEnabled;
    var isOwnCameraRecording = m.IsOwnCameraRecording;
    var isOwnScreenCasting = m.IsOwnScreenCasting;
    var isOwnVideoStreaming = isOwnCameraRecording || isOwnScreenCasting;
    var isAnyoneVideoStreaming = m.IsAnyoneVideoStreaming;
    var isVideoAvailable = m.IsVideoAvailable;
    var isVideoDisabled = !isVideoAvailable;
    var showHeaderVoiceSettings = isListening && isRecording;
    var showVideoControls = (isVideoEnabled || !isVideoAvailable)
        && (isOwnVideoStreaming || isRecording || isAnyoneVideoStreaming);
    var showHeader = showHeaderVoiceSettings || showVideoControls;
    var screenCastTooltip = isVideoDisabled
        ? "Unavailable in this chat"
        : isOwnScreenCasting ? "Stop screen share" : "Share screen";
}

<div class="chat-audio-panel">
    @if (IsNarrow && showHeader) {
        <div class="audio-panel-header">
            <div class="c-left">
                @if (isOwnCameraRecording) {
                    <ButtonRound Click="@OnSwitchCamera">
                        <i class="icon-camera-switch text-2xl"></i>
                    </ButtonRound>
                } else {
                    <div class="c-incut"></div>
                }
                @if (isVideoEnabled || !isVideoAvailable) {
                    <VideoToggle Chat="@Chat" IsNarrow="true" IsDisabled="@isVideoDisabled"/>
                }
            </div>
            <div class="c-right">
                <VoiceSettingsButton Chat="@Chat" IsNarrow="false" />
                <div class="c-incut"></div>
            </div>
        </div>
    }
    <div class="audio-panel-wrapper">
        @if (!IsNarrow && showVideoControls) {
            <div class="@(isOwnScreenCasting ? "screencast-on" : "screencast-off") screencast-wrapper">
                <ButtonRound Click="@(() => OnScreenCastClick(!isOwnScreenCasting))"
                    IsDisabled="@isVideoDisabled"
                    Tooltip="@screenCastTooltip"
                    TooltipPosition="FloatingPosition.Top">
                    <i class="icon-screen-share text-2xl"></i>
                </ButtonRound>
            </div>
            <VideoToggle Chat="@Chat" IsDisabled="@isVideoDisabled" />
        }
        <div class="recorder-button">
            <div data-bubble="@(BubbleRef.New<RecordButtonBubble>())"
                 data-bubble-priority="100"
                 data-bubble-placement="@(FloatingPosition.Top.ToPositionString())">
            </div>
            <RecorderToggle Chat="@Chat"/>
        </div>
        @if (IsNarrow) {
            <VoiceSettingsButton Chat="@Chat" IsNarrow="true" />
        }
        <div class="language-button"
             data-bubble="@(BubbleRef.New<VoiceSettingsButtonBubble>())"
             data-bubble-priority="120"
             data-bubble-placement="@(FloatingPosition.TopStart.ToPositionString())">
            <VoiceSettingsButton Chat="@Chat" IsNarrow="false" />
        </div>
    </div>
</div>

@code {
    private ChatAudioUI ChatAudioUI => Hub.ChatAudioUI;
    private ChatVideoUI ChatVideoUI => Hub.ChatVideoUI;
    private CameraUI CameraUI => Hub.CameraUI;

    [Parameter, EditorRequired] public Chat Chat { get; set; } = null!;
    [Parameter] public bool IsNarrow { get; set; }

    private Task OnSwitchCamera()
        => CameraUI.SwitchCamera();

    private void OnScreenCastClick(bool enable) {
        var chat = Chat;
        if (!ChatVideoUI.IsVideoAvailableNonComputed(chat))
            return;

        if (!enable)
            ChatVideoUI.StopScreenCasting();
        else
            ChatVideoUI.StartScreenCasting(chat.Id);
    }

    protected override ComputedState<Model>.Options GetStateOptions()
        => ComputedStateComponent.GetStateOptions(GetType(),
            static t => new ComputedState<Model>.Options {
                InitialValue = new Model(null, true, false, false, false, false),
                UpdateDelayer = FixedDelayer.NextTick,
                Category = GetStateCategory(t),
            });

    protected override async Task<Model> ComputeState(CancellationToken cancellationToken) {
        var chat = Chat;
        var audioState = await ChatAudioUI.GetState(chat.Id).ConfigureAwait(false);
        var isVideoAvailable = ChatVideoUI.IsVideoAvailableNonComputed(chat);
        var isVideoEnabled = await ChatVideoUI.IsVideoEnabled(chat.Id, cancellationToken).ConfigureAwait(false);
        var isAnyoneVideoStreaming = await ChatVideoUI.IsAnyoneVideoStreaming(chat.Id, cancellationToken).ConfigureAwait(false);
        var isOwnCameraRecording = await ChatVideoUI.IsOwnCameraRecording(chat.Id, cancellationToken).ConfigureAwait(false);
        var isOwnScreenCasting = await ChatVideoUI.IsOwnScreenCasting(chat.Id, cancellationToken).ConfigureAwait(false);
        return new(
            audioState,
            isVideoAvailable,
            isVideoEnabled,
            isAnyoneVideoStreaming,
            isOwnCameraRecording,
            isOwnScreenCasting);

    }

    // Nested classes

    public sealed record Model(
        ChatAudioState? AudioState,
        bool IsVideoAvailable,
        bool IsVideoEnabled,
        bool IsAnyoneVideoStreaming,
        bool IsOwnCameraRecording,
        bool IsOwnScreenCasting);
}
