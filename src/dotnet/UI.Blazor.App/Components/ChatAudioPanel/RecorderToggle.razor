@namespace ActualChat.UI.Blazor.App.Components
@using ActualChat.Hosting
@using ActualChat.UI.Blazor.App.Module
@inherits ComputedStateComponent<AppUIHub, RecorderToggle.Model>
@{
    var m = State.Value;
    _animator.State = m.IsRecordingHere;
    var hasMicrophonePermission = m.HasMicrophonePermission != false;
    var animatorClass = "record-" + _animator.Class;
    var transitioningClass = m.IsTransitioning || m is { IsRecordingHere: true, IsConnected: false } ? "applying-changes" : "";
    var permissionClass = hasMicrophonePermission ? "" : "mic-disabled";
    var hasRecordingFailed = m.Status is RecordingStatus.StartFailed or RecordingStatus.Disconnected;
    var tooltip = m.Status switch {
        RecordingStatus.Starting => L.Call_StartingRecording,
        RecordingStatus.Recording => L.Call_Recording,
        RecordingStatus.Reconnecting or RecordingStatus.Disconnected => L.Reconnect_Title,
        RecordingStatus.StartFailed => L.Recording_CantStart,
        _ => L.ChatMenu_StartRecording,
    };
    var severity = hasRecordingFailed ? TooltipSeverity.Error : TooltipSeverity.Normal;
    var autoShowText = hasRecordingFailed ? tooltip : "";
    var recordingIconSize = ScreenSize.IsNarrow() ? 10 : 8;
    var recBtnCls = "rec-btn ";
    if (m is { IsAnyoneTalking: true, IsRecordingHere: false } && !IsListening) {
        recBtnCls += "take-phone-btn";
        animatorClass += " take-phone";
    } else if (IsListening && !m.IsRecordingHere) {
        recBtnCls += "listen-only-btn";
        animatorClass += " listen-only";
    } else if (m.IsRecordingHere) {
        recBtnCls += "record-on-btn";
    } else
        recBtnCls += "record-off-btn";
    var mustKeepAwake = !m.IsRecordingHere;
    if (!hasMicrophonePermission) {
        recBtnCls = "mic-disabled";
        animatorClass = "";
        transitioningClass = "";
    }
}

<div class="recorder-wrapper @permissionClass @animatorClass @transitioningClass"
     data-tooltip="@tooltip"
     data-tooltip-position="@(FloatingPosition.Top.ToPositionString())"
     data-tooltip-severity="@(severity.ToSeverityString())"
     data-render-script-tooltip-auto-show="@autoShowText">
    <ButtonRound
        Class="@recBtnCls"
        Click="@OnClick"
        MustKeepAwake="@mustKeepAwake"
        PointerDownPreventDefault="true">

        @if (hasMicrophonePermission) {
            if (m is { IsAnyoneTalking: true, IsRecordingHere: false } && !IsListening) {
                <take-phone-svg/>
            } else {
                @* Icon for OFF state *@
                <div class="rec-icon off">
                    <i class="icon-recorder-left-half left"></i>
                    <i class="icon-recorder-right-half right"></i>
                </div>

                @* Icon for narrow-panel and text-mode *@
                <narrow-recording-svg
                    isRecording="@m.IsRecordingHere"
                    class="rec-icon on text-mode-on" />

                @* Icon for ON state *@
                <active-recording-svg
                    size="@recordingIconSize"
                    isRecording="@m.IsRecordingHere"
                    class="rec-icon on text-mode-off"/>
            }
        } else {
            <i class="icon-mic-off"></i>
        }
    </ButtonRound>
</div>

@code {
    private static readonly string JSInitMethod = $"{BlazorUIAppModule.ImportName}.RecorderToggle.init";
    private readonly TaskSerializer _taskSerializer = new();
    private OnOffAnimator _animator = null!;
    private CpuTimestamp _lastActionAt;

    private AudioRecorder AudioRecorder => Hub.AudioRecorder;
    private ActiveChatsUI ActiveChatsUI => Hub.ActiveChatsUI;
    private ChatAudioUI ChatAudioUI => Hub.ChatAudioUI;
    private SearchUI SearchUI => Hub.SearchUI;
    private LiveStreamUI LiveStreamUI => Hub.LiveStreamUI;
    private LiveSessionUI LiveSessionUI => Hub.LiveSessionUI;
    private IChats Chats => Hub.Chats;

    private ChatId? RecordingChatId {
        get {
            var activeChats = ActiveChatsUI.ActiveChats.Value;
            var recordingChat = activeChats.FirstOrDefault(c => c.IsRecording);
            return recordingChat?.ChatId;
        }
    }
    private bool IsRecordingHere => ChatId is not null && RecordingChatId == ChatId;
    private bool IsUpdating => Chat?.Id is not null && State.Value?.Chat != null && State.Value?.Chat.Id != Chat.Id;
    private bool IsListening => !IsUpdating && State is { Value.AudioState.IsListening: true };

    [CascadingParameter] public ScreenSize ScreenSize { get; set; }

    [Parameter, EditorRequired] public Chat Chat { get; set; } = null!;
    private ChatId? ChatId => (ChatId?)Chat.Id;

    protected override void OnInitialized() {
        _animator = new (this, TimeSpan.FromMilliseconds(300));
    }

    protected override Task OnInitializedAsync()
        => AudioRecorder.MicrophonePermission.Check(CancellationToken.None);

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (!firstRender)
            return;

        if (HostInfo.HostKind is HostKind.MauiApp)
            return;

        await JS.InvokeVoidAsync(JSInitMethod);
    }

    public override ValueTask DisposeAsync() {
        _animator.Dispose();
        return base.DisposeAsync();
    }

    protected override ComputedState<Model>.Options GetStateOptions()
        => ComputedStateComponent.GetStateOptions(GetType(),
            static t => new ComputedState<Model>.Options {
                InitialValue = Model.Loading,
                UpdateDelayer = FixedDelayer.NextTick,
                Category = GetStateCategory(t),
            });

    protected override async Task<Model> ComputeState(CancellationToken cancellationToken) {
        var chatId = ChatId;
        // Locals captured, ConfigureAwait(false) below is fine
        if (chatId is null)
            return Model.Loading;

        var chat = await Chats.Get(Session, chatId, cancellationToken).ConfigureAwait(false);
        if (chat is null)
            return Model.Loading;

        var recordingChatId = await ChatAudioUI.GetRecordingChatId().ConfigureAwait(false);
        var status = await ChatAudioUI.GetRecordingStatus(chatId, cancellationToken).ConfigureAwait(false);
        var recorderState = await AudioRecorder.State.Use(cancellationToken).ConfigureAwait(false);
        var hasMicrophonePermission = await AudioRecorder.MicrophonePermission.Cached.Use(cancellationToken).ConfigureAwait(false);
        var isRecordingHere = recordingChatId == chatId;
        var isTransitioning =
            recordingChatId == chatId // The recorder records in this chat
            && recorderState.IsRecording != isRecordingHere; // AND it's state is not in sync with the expected one here
        var isAnyoneTalking = await LiveStreamUI.IsAnyoneStreamingAudio(chatId, cancellationToken).ConfigureAwait(false);
        var audioState = await ChatAudioUI.GetState(chatId).ConfigureAwait(false);

        return new (
            chat,
            status,
            isRecordingHere,
            recorderState.IsConnected,
            hasMicrophonePermission,
            isTransitioning,
            isAnyoneTalking,
            audioState);
    }

    private void OnClick()
        => ToggleRecording();

    private void ToggleRecording() {
        if (IsRecordingHere)
            StopRecording();
        else
            StartRecording();
    }

    private void StartRecording() {
        SearchUI.Clear();
        if (!IsValidAction())
            return;

        var chatId = ChatId;
        _ = _taskSerializer.Enqueue(async cancellationToken => {
            // .ConfigureAwait(false) is fine here
            if (chatId is null || RecordingChatId == chatId)
                return;

            if (!await AudioRecorder.MicrophonePermission.CheckOrRequest(cancellationToken).ConfigureAwait(false))
                return;

            cancellationToken.ThrowIfCancellationRequested();
            // Tapping the mic to record lifts a soft "mute all" applied by the host.
            var chat = await Chats.Get(Session, chatId, cancellationToken).ConfigureAwait(false);
            if (chat?.Rules.Author?.Id is { } ownAuthorId)
                await LiveSessionUI.MutePeer(chatId, ownAuthorId, false, cancellationToken).ConfigureAwait(false);
            await ChatAudioUI.SetRecordingChatId(chatId).ConfigureAwait(false);
        });
    }

    private void StopRecording() {
        if (!IsValidAction())
            return;

        _ = _taskSerializer.Enqueue(async _ => {
            // .ConfigureAwait(false) is fine here
            if (RecordingChatId is not null)
                await ChatAudioUI.SetRecordingChatId(null).ConfigureAwait(false);
        }, mustAbortPreviousTasks: true);
    }

    private bool IsValidAction() {
        if (_lastActionAt.Elapsed < TimeSpan.FromMilliseconds(500))
            return false; // Rapid action sequence is likely a mistake

        _lastActionAt = CpuTimestamp.Now;
        return true;
    }

    // Nested types

    public sealed record Model(
        Chat? Chat,
        RecordingStatus Status = RecordingStatus.Off,
        bool IsRecordingHere = false,
        bool IsConnected = false,
        bool? HasMicrophonePermission = null,
        bool IsTransitioning = false,
        bool IsAnyoneTalking = false,
        ChatAudioState? AudioState = null
    ) {
        public static readonly Model Loading = new(null, RecordingStatus.Off, false, true, false, false, false);
    }
}
