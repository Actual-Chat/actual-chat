@namespace ActualChat.UI.Blazor.App.Components
@implements IModalView<VoiceSettingsModal.Model>

<DiveInDialogFrame
    HasCloseButton="true"
    Class="transcription-options-modal modal-sm"
    Position="DialogFramePosition.Bottom"
    StartPage="@StartPage" />

@code {
    [Parameter] public Model ModalModel { get; set; } = null!;

    private DiveInDialogPage StartPage => DiveInDialogPage.New<VoiceSettingsStartModalPage>(ModalModel.ChatId);

    // Nested types

    public sealed record Model(ChatId ChatId);
}
