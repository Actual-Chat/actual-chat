<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <SuppressTrimAnalysisWarnings>false</SuppressTrimAnalysisWarnings>
  </PropertyGroup>

  <!-- Release configuration -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <IsPublishable>false</IsPublishable>
  </PropertyGroup>

  <!-- Debug symbols -->
  <PropertyGroup>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>portable</DebugType>
    <TrimmerRemoveSymbols>false</TrimmerRemoveSymbols>
    <StripSymbols>false</StripSymbols>
  </PropertyGroup>

  <!-- Ensures ArgumentList variants with generics are trimmed in Native AOT -->
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="ArgumentList.AllowGenerics" Value="false" Trim="true" />
  </ItemGroup>

  <!-- App.Server transitively references the full server-side surface (every Service +
       transitively every Contracts project) AND UI.Blazor.App, so the generator's
       reflection-based discovery sees every serializable / API / component type without
       us having to enumerate them here. AotHelper isn't shipped, only used at dev time. -->
  <ItemGroup>
    <ProjectReference Include="..\App.Server\App.Server.csproj" />
  </ItemGroup>

</Project>
