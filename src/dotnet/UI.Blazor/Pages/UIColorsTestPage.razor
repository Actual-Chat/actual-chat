@page "/test/ui-colors"

<RequireAccount MustBeAdmin="true"/>
<MainHeader>UI Colors Test Page</MainHeader>

<details>
    <summary class="flex-x items-center gap-4 bg-03">
        <i class="icon-chevron-up rotate-180"></i>
        <span>Text and bg colors</span>
    </summary>
    <h1>Text and background colors</h1>
    <div class="text-bg-colors grid grid-cols-4 items-center justify-center gap-1">
        <div class="p-2 bg-01 text-03">
            <p>bg-01 text-03</p>
        </div>
        <div class="p-2 bg-02 text-02">
            <p>bg-02 text-02</p>
        </div>
        <div class="p-2 bg-03 text-03">
            <p>bg-03 text-03</p>
        </div>
        <div class="p-2 bg-04 text-primary">
            <p>bg-04 text-primary</p>
        </div>
        <div class="p-2 bg-05 text-01">
            <p>bg-05 text-01</p>
        </div>
        <div class="p-2 bg-06 text-04">
            <p>bg-06 text-04</p>
        </div>
        <div class="p-2 bg-07 text-05">
            <p>bg-07 text-05</p>
        </div>
        <div class="p-2 bg-08 text-06">
            <p>bg-08 text-06</p>
        </div>
    </div>
</details>


<details>
    <summary class="flex-x items-center gap-4 bg-03">
        <i class="icon-chevron-up rotate-180"></i>
        <span>Timer buttons</span>
    </summary>
    <h1>Timer buttons</h1>
    <div class="flex-x gap-4 flex-wrap">
        <div class="flex-y gap-y-1">
            <span class="text-center text-xxs">Default 3s</span>
            <TimerCloseButton Delay="3"/>
        </div>
        <div class="flex-y gap-y-1">
            <span class="text-center text-xxs">Default 5s</span>
            <TimerCloseButton Delay="5"/>
        </div>
        <div class="flex-y gap-y-1">
            <span class="text-center text-xxs">SM 3s</span>
            <TimerCloseButton Delay="3" CircleClass="btn-sm"/>
        </div>
        <div class="flex-y gap-y-1">
            <span class="text-center text-xxs">SM 5s</span>
            <TimerCloseButton Delay="5" CircleClass="btn-sm"/>
        </div>
    </div>
</details>

<details>
    <summary class="flex-x items-center gap-4 bg-03">
        <i class="icon-chevron-up rotate-180"></i>
        <span>Square buttons</span>
    </summary>
    <h1>Square buttons</h1>
    <div class="flex-x gap-4 flex-wrap">
        <div class="flex-y gap-y-1">
            <span class="text-center text-xxs">Default</span>
            <ButtonSquare>
                1
            </ButtonSquare>
        </div>
        <div class="flex-y gap-y-1">
            <span class="text-center text-xxs">Primary</span>
            <ButtonSquare Class="btn-primary">
                2
            </ButtonSquare>
        </div>
        <div class="flex-y gap-y-1">
            <span class="text-center text-xxs">Danger SM</span>
            <ButtonSquare Class="btn-danger btn-sm">
                SM
            </ButtonSquare>
        </div>
        <div class="flex-y gap-y-1">
            <span class="text-center text-xxs">Cancel XS</span>
            <ButtonSquare Class="btn-cancel btn-xs">
                XS
            </ButtonSquare>
        </div>
        <div class="flex-y gap-y-1">
            <span class="text-center text-xxs">Transparent</span>
            <ButtonSquare Class="btn-transparent">
                B
            </ButtonSquare>
        </div>
        <div class="flex-y gap-y-1">
            <span class="text-center text-xxs">Unhovered</span>
            <ButtonSquare Class="unhovered">
                C
            </ButtonSquare>
        </div>
        <div class="flex-y gap-y-1">
            <span class="text-center text-xxs">Disabled</span>
            <ButtonSquare IsDisabled="true">
                D
            </ButtonSquare>
        </div>
    </div>
</details>

<details>
    <summary class="flex-x items-center gap-4 bg-03">
        <i class="icon-chevron-up rotate-180"></i>
        <span>Round buttons</span>
    </summary>
    <h1>Round buttons</h1>
    <div class="flex-x gap-4 flex-wrap">
        <div class="flex-y gap-y-1">
            <span class="text-center text-xxs">Default</span>
            <ButtonRound>
                1
            </ButtonRound>
        </div>
        <div class="flex-y gap-y-1">
            <span class="text-center text-xxs">Primary</span>
            <ButtonRound Class="btn-primary">
                2
            </ButtonRound>
        </div>
        <div class="flex-y gap-y-1">
            <span class="text-center text-xxs">Danger</span>
            <ButtonRound Class="btn-danger">
                3
            </ButtonRound>
        </div>
        <div class="flex-y gap-y-1">
            <span class="text-center text-xxs">Cancel</span>
            <ButtonRound Class="btn-cancel">
                A
            </ButtonRound>
        </div>
        <div class="flex-y gap-y-1">
            <span class="text-center text-xxs">Transparent</span>
            <ButtonRound Class="btn-transparent">
                B
            </ButtonRound>
        </div>
        <div class="flex-y gap-y-1">
            <span class="text-center text-xxs">Unhovered</span>
            <ButtonRound Class="unhovered">
                C
            </ButtonRound>
        </div>
        <div class="flex-y gap-y-1">
            <span class="text-center text-xxs">Disabled</span>
            <ButtonRound IsDisabled="true">
                D
            </ButtonRound>
        </div>
    </div>
</details>

<details>
    <summary class="flex-x items-center gap-4 bg-03">
        <i class="icon-chevron-up rotate-180"></i>
        <span>Header buttons</span>
    </summary>
    <h1>Header buttons</h1>
    <div class="flex-x gap-4 flex-wrap">
        <div class="flex-y gap-y-1">
            <span class="text-center text-xxs">Default</span>
            <HeaderButton>
                <i class="icon-close text-2xl"></i>
            </HeaderButton>
        </div>
        <div class="flex-y gap-y-1 bg-black">
            <span class="text-center text-xxs text-white">Bleached</span>
            <HeaderButton Class="bleached">
                B
            </HeaderButton>
        </div>
        <div class="flex-y gap-y-1">
            <span class="text-center text-xxs">SM</span>
            <HeaderButton Class="btn-sm">
                S
            </HeaderButton>
        </div>
        <div class="flex-y gap-y-1">
            <span class="text-center text-xxs">LG</span>
            <HeaderButton Class="btn-lg">
                L
            </HeaderButton>
        </div>
        <div class="flex-y gap-y-1">
            <span class="text-center text-xxs">Unhovered</span>
            <HeaderButton Class="unhovered">
                U
            </HeaderButton>
        </div>
    </div>
</details>

<details>
    <summary class="flex-x items-center gap-4 bg-03">
        <i class="icon-chevron-up rotate-180"></i>
        <span>Main buttons</span>
    </summary>
    <h1>Main Buttons</h1>
    <h3>Default</h3>
    <div class="flex-wrap flex-x items-center gap-4">
        <Button Class="btn-lg">
            Default LG
        </Button>
        <Button Class="">
            Default
        </Button>
        <Button Class="btn-sm">
            Default SM
        </Button>
        <Button Class="btn-xs">
            Default XS
        </Button>
        <Button Class="" IsDisabled="true">
            Disabled
        </Button>
    </div>
    <h3>Primary</h3>
    <div class="flex-wrap flex-x items-center gap-4">
        <Button Class="btn-primary btn-lg">
            Primary LG
        </Button>
        <Button Class="btn-primary">
            Primary
        </Button>
        <Button Class="btn-primary btn-sm">
            Primary SM
        </Button>
        <Button Class="btn-primary btn-xs">
            Primary XS
        </Button>
        <Button Class="btn-primary" IsDisabled="true">
            Primary Disabled
        </Button>
    </div>
    <h3>Danger</h3>
    <div class="flex-wrap flex-x items-center gap-4">
        <Button Class="btn-danger btn-lg">
            Danger LG
        </Button>
        <Button Class="btn-danger">
            Danger
        </Button>
        <Button Class="btn-danger btn-sm">
            Danger SM
        </Button>
        <Button Class="btn-danger btn-xs">
            Danger XS
        </Button>
        <Button Class="btn-danger" IsDisabled="true">
            Danger Disabled
        </Button>
    </div>
    <h3>Cancel</h3>
    <div class="flex-wrap flex-x items-center gap-4">
        <Button Class="btn-cancel btn-lg">
            Cancel LG
        </Button>
        <Button Class="btn-cancel">
            Cancel
        </Button>
        <Button Class="btn-cancel btn-sm">
            Cancel SM
        </Button>
        <Button Class="btn-cancel btn-xs">
            Cancel XS
        </Button>
        <Button Class="btn-cancel" IsDisabled="true">
            Cancel Disabled
        </Button>
    </div>
</details>

<details>
    <summary class="flex-x items-center gap-4 bg-03">
        <i class="icon-chevron-up rotate-180"></i>
        <span>Outline, Transparent, Modal buttons</span>
    </summary>
    <h3>Outline buttons</h3>
    <div class="flex-wrap flex-x items-center gap-4">
        <Button Class="btn-outline btn-lg">
            Default Outline
        </Button>
        <Button Class="btn-outline btn-primary">
            Primary Outline
        </Button>
        <Button Class="btn-outline btn-danger btn-sm">
            Danger
        </Button>
        <Button Class="btn-outline btn-cancel btn-xs">
            Cancel
        </Button>
        <Button Class="btn-outline btn-cancel" IsDisabled="true">
            Disabled
        </Button>
    </div>

    <h3>With Icon</h3>
    <div class="flex-wrap flex-x items-center gap-4">
        <Button Class="btn-primary btn-lg">
            <Icon><i class="icon-at text-2xl"></i></Icon>
            <Title>Notify</Title>
        </Button>
        <Button Class="btn-danger">
            <Icon><i class="icon-at text-2xl"></i></Icon>
            <Title>Notify</Title>
        </Button>
        <Button Class="btn-cancel btn-sm">
            <Icon><i class="icon-at text-xl"></i></Icon>
            <Title>Notify</Title>
        </Button>
        <Button Class="btn-xs">
            <Icon><i class="icon-at text-lg"></i></Icon>
            <Title>Notify</Title>
        </Button>
    </div>

    <Button Class="btn-primary btn-w-full mt-2">
        Full Width Button
    </Button>

    <h1>Disabled buttons</h1>
    <div class="flex-wrap flex-x items-center gap-4">
        <Button Class="btn-primary" IsDisabled="true">
            Long Primary
        </Button>
        <Button Class="btn-danger" IsDisabled="true">
            Danger
        </Button>
        <Button Class="btn-cancel" IsDisabled="true">
            Cancel
        </Button>
        <Button Class="btn-primary btn-sm" IsDisabled="true">
            Primary SM
        </Button>
    </div>

    <h1>Outline Disabled buttons</h1>
    <div class="flex-wrap flex-x items-center gap-4">
        <Button Class="btn-primary btn-outline" IsDisabled="true">
            Long Primary
        </Button>
        <Button Class="btn-danger btn-outline" IsDisabled="true">
            Danger
        </Button>
        <Button Class="btn-cancel btn-outline" IsDisabled="true">
            Cancel
        </Button>
        <Button Class="btn-primary btn-outline btn-sm" IsDisabled="true">
            Primary SM
        </Button>
    </div>

    <h1>Transparent buttons</h1>
    <div class="flex-wrap flex-x items-center gap-4">
        <Button Class="btn-transparent btn-primary btn-lg">
            Primary LG
        </Button>
        <Button Class="btn-transparent btn-danger btn-md">
            Danger MD
        </Button>
        <Button Class="btn-transparent btn-cancel btn-sm">
            Cancel SM
        </Button>
        <Button Class="btn-transparent btn-xs" IsDisabled="true">
            Disabled XS
        </Button>
    </div>

    <h1>Modal buttons</h1>
    <div class="flex-wrap flex-x items-center gap-4">
        <Button Class="btn-modal btn-lg">
            Default Modal LG
        </Button>
        <Button Class="btn-modal btn-primary">
            Primary MD
        </Button>
        <Button Class="btn-modal btn-danger btn-sm">
            Danger SM
        </Button>
        <Button Class="btn-modal btn-cancel btn-xs">
            Cancel XS
        </Button>
        <Button Class="btn-modal" IsDisabled="true">
            Disabled
        </Button>
    </div>
</details>

<details>
    <summary class="flex-wrap flex-x items-center gap-4 bg-03">
        <i class="icon-chevron-up rotate-180"></i>
        <span>Toasts and Banners</span>
    </summary>

    <div class="buttons-colors flex-y items-start justify-center gap-y-1">
        <h1>Toast and banner colors</h1>
        <ErrorToast Class="min-h-14">
            Color Test Page Error Toast
        </ErrorToast>

        <Toast Text="Test Toast"></Toast>

        <Banner
            IsVisible="true"
            ShowDismissButton="true">
            <Body>
            Default Banner
            </Body>
            <Buttons>
                <Button Class="btn-transparent">
                    Configure
                </Button>
            </Buttons>
        </Banner>

        <Banner
            Severity="BannerSeverity.Info"
            IsVisible="true">
            <Body>
            Info Banner
            </Body>
            <Buttons>
                <Button Class="btn-transparent">
                    Configure
                </Button>
            </Buttons>
        </Banner>

        <Banner
            Severity="BannerSeverity.Warning"
            IsVisible="true"
            ShowDismissButton="true">
            <Body>
            Warning Banner
            </Body>
            <Buttons>
                <Button Class="btn-transparent">
                    Settings
                </Button>
            </Buttons>
        </Banner>

        <Banner
            Severity="BannerSeverity.Success"
            IsVisible="true">
            <Body>
            Success Banner
            </Body>
            <Buttons>
                <Button Class="btn-transparent">
                    OK
                </Button>
            </Buttons>
        </Banner>

        <Banner
            Severity="BannerSeverity.Error"
            IsVisible="true">
            <Body>
            Error Banner
            </Body>
            <Buttons>
                <Button Class="btn-transparent">
                    Yes
                </Button>
            </Buttons>
        </Banner>
    </div>
</details>

<h1>Utility colors</h1>
<div class="separator-colors grid grid-cols-3 items-center justify-center gap-4">
    <div class="flex items-center p-2 bg-new-separator text-danger">
        bg-new-separator text-danger
    </div>
    <div class="flex items-center p-2 bg-hover text-01">
        bg-hover text-01
    </div>
    <div class="flex items-center p-2 bg-selected text-01">
        bg-selected text-01
    </div>
</div>

<input placeholder="Placeholder"/>
<TextBox @bind-Value="@_textBox"></TextBox>

@code {
    private string _textBox = "Test TextBox";
}
