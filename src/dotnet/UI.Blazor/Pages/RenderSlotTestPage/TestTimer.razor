@inherits ComputedStateComponent<UIHub, Moment>

@DateTime.Now.ToString("F")

@code {
    private IFusionTime FusionTime => Hub.FusionTime;

    [Parameter] public double UpdatePeriod { get; set; } = 1;

    protected override async Task<Moment> ComputeState(CancellationToken cancellationToken)
        => await FusionTime.Now(TimeSpan.FromSeconds(UpdatePeriod)).ConfigureAwait(false);
}
