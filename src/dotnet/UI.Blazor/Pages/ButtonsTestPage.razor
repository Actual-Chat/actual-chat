@page "/test/buttons"

<RequireAccount MustBeAdmin="true"/>
<MainHeader>Buttons</MainHeader>

@{
    var colors = new (string Label, string Cls)[] {
        ("Default", ""),
        ("Primary", "btn-primary"),
        ("Danger", "btn-danger"),
        ("Cancel", "btn-cancel"),
    };
    var iconColors = new (string Label, string Cls)[] {
        ("Default", ""),
        ("Primary", "btn-primary"),
        ("Danger", "btn-danger"),
        ("Cancel", "btn-cancel"),
        ("Transparent", "btn-transparent"),
    };
    var sizes = new (string Label, string Cls)[] {
        ("LG", "btn-lg"),
        ("MD", ""),
        ("SM", "btn-sm"),
        ("XS", "btn-xs"),
    };
    var textSizes = new (string Label, string Cls)[] {
        ("LG", "btn-lg"),
        ("MD", ""),
        ("SM", "btn-sm"),
        ("XS", "btn-xs"),
        ("XXS", "btn-xxs"),
    };
    var styles = new (string Label, string Cls)[] {
        ("Solid", ""),
        ("Outline", "btn-outline"),
        ("Transparent", "btn-transparent"),
        ("Modal", "btn-modal"),
    };
}

@{
    RenderFragment buttons =
        @<text>
            @foreach (var style in styles) {
                <h2>@style.Label buttons</h2>
                <div class="flex-y gap-y-2">
                    @foreach (var c in colors) {
                        <div class="flex-x items-center gap-3 flex-wrap">
                            <span class="w-20 text-xs opacity-60">@c.Label</span>
                            @foreach (var z in sizes) {
                                <Button Class="@($"{style.Cls} {c.Cls} {z.Cls}")">@z.Label</Button>
                            }
                            <Button Class="@($"{style.Cls} {c.Cls}")" IsDisabled="true">Disabled</Button>
                        </div>
                    }
                </div>
            }

            <h2>With icon &amp; title</h2>
            <div class="flex-y gap-y-2">
                @foreach (var c in colors) {
                    <div class="flex-x items-center gap-3 flex-wrap">
                        <span class="w-20 text-xs opacity-60">@c.Label</span>
                        @foreach (var z in sizes) {
                            <Button Class="@($"{c.Cls} {z.Cls}")">
                                <Icon><i class="icon-at"></i></Icon>
                                <Title>@z.Label</Title>
                            </Button>
                        }
                        <Button Class="@c.Cls" IsDisabled="true">
                            <Icon><i class="icon-at"></i></Icon>
                            <Title>Disabled</Title>
                        </Button>
                    </div>
                }
            </div>

            <h2>Text buttons</h2>
            <div class="flex-y gap-y-2">
                @foreach (var c in colors) {
                    <div class="flex-x items-center gap-3 flex-wrap">
                        <span class="w-20 text-xs opacity-60">@c.Label</span>
                        @foreach (var z in textSizes) {
                            <Button Class="@($"btn-text {c.Cls} {z.Cls}")">@z.Label</Button>
                        }
                        <Button Class="@($"btn-text {c.Cls}")">
                            <Icon><i class="icon-chevron-up"></i></Icon>
                            <Title>Chevron</Title>
                        </Button>
                        <Button Class="@($"btn-text {c.Cls}")" IsDisabled="true">Disabled</Button>
                    </div>
                }
            </div>

            <h2>Full width</h2>
            <Button Class="btn-primary btn-w-full mt-1">Full Width Button</Button>

            <h2>Square buttons</h2>
            <div class="flex-y gap-y-2">
                @foreach (var c in iconColors) {
                    <div class="flex-x items-center gap-3 flex-wrap">
                        <span class="w-20 text-xs opacity-60">@c.Label</span>
                        @foreach (var z in sizes) {
                            <ButtonSquare Class="@($"{c.Cls} {z.Cls}")"><i class="icon-close"></i></ButtonSquare>
                        }
                        <ButtonSquare Class="@c.Cls" IsDisabled="true"><i class="icon-close"></i></ButtonSquare>
                    </div>
                }
            </div>

            <h2>Round buttons</h2>
            <div class="flex-y gap-y-2">
                @foreach (var c in iconColors) {
                    <div class="flex-x items-center gap-3 flex-wrap">
                        <span class="w-20 text-xs opacity-60">@c.Label</span>
                        @foreach (var z in sizes) {
                            <ButtonRound Class="@($"{c.Cls} {z.Cls}")"><i class="icon-close"></i></ButtonRound>
                        }
                        <ButtonRound Class="@c.Cls" IsDisabled="true"><i class="icon-close"></i></ButtonRound>
                    </div>
                }
            </div>

            <h2>Header buttons</h2>
            <div class="flex-x items-center gap-4 flex-wrap">
                <div class="flex-y items-center gap-y-1">
                    <span class="text-center text-xxs">LG</span>
                    <HeaderButton Class="btn-lg"><i class="icon-close text-2xl"></i></HeaderButton>
                </div>
                <div class="flex-y items-center gap-y-1">
                    <span class="text-center text-xxs">MD</span>
                    <HeaderButton><i class="icon-close text-2xl"></i></HeaderButton>
                </div>
                <div class="flex-y items-center gap-y-1">
                    <span class="text-center text-xxs">SM</span>
                    <HeaderButton Class="btn-sm"><i class="icon-close text-xl"></i></HeaderButton>
                </div>
                <div class="flex-y items-center gap-y-1 p-1 bg-black rounded">
                    <span class="text-center text-xxs text-white">Bleached</span>
                    <HeaderButton Class="bleached"><i class="icon-close text-2xl"></i></HeaderButton>
                </div>
                <div class="flex-y items-center gap-y-1">
                    <span class="text-center text-xxs">Unhovered</span>
                    <HeaderButton Class="unhovered"><i class="icon-close text-2xl"></i></HeaderButton>
                </div>
                <div class="flex-y items-center gap-y-1">
                    <span class="text-center text-xxs">Disabled</span>
                    <HeaderButton IsDisabled="true"><i class="icon-close text-2xl"></i></HeaderButton>
                </div>
            </div>

            <h2>Tile buttons</h2>
            <div class="flex-x gap-x-6 flex-wrap items-start">
                <div class="flex-y gap-y-2 w-72">
                    <span class="text-xs opacity-60">Transparent (intent = colour only)</span>
                    @foreach (var c in colors) {
                        <ButtonTile Class="@c.Cls">
                            <Icon><i class="icon-at text-2xl"></i></Icon>
                            <Content>@c.Label tile</Content>
                        </ButtonTile>
                    }
                    <ButtonTile Class="btn-danger">
                        <Icon><i class="icon-trash03 text-2xl"></i></Icon>
                        <Content>
                            <span class="c-text">Danger with caption</span>
                            <span class="c-caption">Caption stays muted</span>
                        </Content>
                    </ButtonTile>
                    <ButtonTile IsDisabled="true">
                        <Icon><i class="icon-at text-2xl"></i></Icon>
                        <Content>Disabled</Content>
                    </ButtonTile>
                </div>
                <div class="flex-y gap-y-2 w-72">
                    <span class="text-xs opacity-60">Filled (btn-tile-filled)</span>
                    @foreach (var c in colors) {
                        <ButtonTile Class="@c.Cls" Filled="true">
                            <Icon><i class="icon-at text-2xl"></i></Icon>
                            <Content>@c.Label tile</Content>
                        </ButtonTile>
                    }
                    <ButtonTile Filled="true" IsDisabled="true">
                        <Icon><i class="icon-at text-2xl"></i></Icon>
                        <Content>Disabled</Content>
                    </ButtonTile>
                </div>
            </div>

            <h2>Timer buttons</h2>
            <div class="flex-x gap-4 flex-wrap">
                <div class="flex-y items-center gap-y-1">
                    <span class="text-center text-xxs">Default 3s</span>
                    <TimerCloseButton Delay="3"/>
                </div>
                <div class="flex-y items-center gap-y-1">
                    <span class="text-center text-xxs">Default 5s</span>
                    <TimerCloseButton Delay="5"/>
                </div>
                <div class="flex-y items-center gap-y-1">
                    <span class="text-center text-xxs">SM 3s</span>
                    <TimerCloseButton Delay="3" CircleClass="btn-sm"/>
                </div>
                <div class="flex-y items-center gap-y-1">
                    <span class="text-center text-xxs">SM 5s</span>
                    <TimerCloseButton Delay="5" CircleClass="btn-sm"/>
                </div>
            </div>
        </text>;
}

<div class="test-page-wrapper flex-y gap-y-6 p-4">
    <div class="theme-light flex-y gap-y-4 p-6 rounded-2xl bg-01 text-01">
        <h1>theme-light</h1>
        @buttons
    </div>
    <div class="theme-dark flex-y gap-y-4 p-6 rounded-2xl bg-01 text-01">
        <h1>theme-dark</h1>
        @buttons
    </div>
</div>
