@inherits LayoutComponentBase

<IsolateRerender>
    <BaseLayout>
        <Body>
            <PageWithHeaderAndFooter @key="@Key" Class="@MiddlePanelClass" BodyClass="@BodyClass">
                <LeftDrawer><RenderSlot Name="@LayoutSlots.MainLeftDrawer"/></LeftDrawer>
                <Header><RenderSlot Name="@LayoutSlots.MainHeader"/></Header>
                <SubHeader><RenderStack Name="@LayoutSlots.SubHeader"/></SubHeader>
                <Footer><RenderSlot Name="@LayoutSlots.MainFooter"/></Footer>
                <SubFooter><RenderStack Name="@LayoutSlots.SubFooter"/></SubFooter>
                <Body><RerenderRegion>@Body</RerenderRegion>
                </Body>
                <BodyOverlay><RenderSlot Name="@LayoutSlots.MainBodyOverlay"/></BodyOverlay>
                <RightDrawer><RenderSlot Name="@LayoutSlots.MainRightDrawer"/></RightDrawer>
            </PageWithHeaderAndFooter>
        </Body>
    </BaseLayout>
</IsolateRerender>

@code {
    private static readonly object Key = new();

    public string MiddlePanelClass { get; set; } = "default-layout";
    public string BodyClass { get; set; } = "";
}
