@inherits LayoutComponentBase
@layout BaseLayout

<PageWithHeaderAndFooter Class="discover-layout">
    <LeftDrawer><RenderSlot Name="@LayoutSlots.MainLeftDrawer"/></LeftDrawer>
    <Header><RenderSlot Name="@LayoutSlots.MainHeader"/></Header>
    <SubHeader><RenderStack Name="@LayoutSlots.SubHeader"/></SubHeader>
    <Footer><RenderSlot Name="@LayoutSlots.MainFooter"/></Footer>
    <SubFooter><RenderStack Name="@LayoutSlots.SubFooter"/></SubFooter>
    <Body>@Body</Body>
    <RightDrawer><RenderSlot Name="@LayoutSlots.MainRightDrawer"/></RightDrawer>
</PageWithHeaderAndFooter>
