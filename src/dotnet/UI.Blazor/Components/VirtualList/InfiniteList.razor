@namespace ActualChat.UI.Blazor.Components
@typeparam TItem
@using ActualChat.UI.Blazor.Components.Internal
@using ActualChat.UI.Blazor.Diagnostics
@inherits VirtualList<TItem>
@{
#pragma warning disable IL2026

    var renderIndex = RenderIndex++;
    ChatSwitchTracer.Mark($"InfiniteList: render #{renderIndex}",
        $"{Identity}, {Data.Count} items, scrollToKey={Data.ScrollToKey}");

    // ReSharper disable once ConditionIsAlwaysTrueOrFalseAccordingToNullableAPIContract
    // We are unable to scroll to the right location until JS client part of the Virtual List created
    var data = Data;
    var hasVeryFirstItem = data.HasVeryFirstItem;
    var hasVeryLastItem = data.HasVeryLastItem;
    var showOverscrollCue = ShowOverscrollCue
        && hasVeryFirstItem;
    var renderState = new VirtualListRenderState {
        RenderIndex = renderIndex,
        Query = Query,
        KeyRange = data.KeyRange,
        Count = data.Count,
        BeforeCount = Data.BeforeCount,
        AfterCount = Data.AfterCount,
        EstimatedCount = Data.EstimatedCount,
        HasVeryFirstItem = data.HasVeryFirstItem,
        HasVeryLastItem = data.HasVeryLastItem,
        ScrollToKey = data.ScrollToKey,
        ScrollToKeyInTheMiddle = data.ScrollToKeyInTheMiddle,
    };
    var items = data.Items;
    var startSkeletonCount = data.BeforeCount.HasValue && data.BeforeCount < SkeletonCount
        ? data.BeforeCount.Value
        : SkeletonCount;
    var endSkeletonCount = data.AfterCount.HasValue && data.AfterCount < SkeletonCount
        ? data.AfterCount.Value
        : SkeletonCount;
    LastData = data;
    Query = VirtualListDataQuery.None;
}

<div @ref="Ref"
     class="@Class virtual-list infinite-list"
     style="@Style"
     data-content-swap-dependency="@IsContentSwapDependency">

    <div @key="@VirtualListSpecialKeys.RenderIndex"
         data-render-index="@renderIndex"
         class="data render-index">
    </div>

    <div @key="@VirtualListSpecialKeys.RenderState"
         class="data render-state">
        @* RenderAtDepth ensures the JSON here is rendered once every item is rendered *@
        <RenderAtDepth RenderKey="@renderState" Depth="5">
            @Serializers.SystemJson.Write(context)
        </RenderAtDepth>
    </div>

    <div @key="@VirtualListSpecialKeys.Wrapper"
         class="c-wrapper c-initially-hidden">

        <ul @key="@VirtualListSpecialKeys.Container"
            class="c-virtual-container">

            @if (showOverscrollCue) {
                <li @key="@VirtualListSpecialKeys.TopOverscrollCue"
                    class="c-top-overscroll-cue"
                    aria-hidden="true">
                    <img src="/dist/images/top-overscroll-cue.svg" draggable="false" alt=""/>
                </li>
            }

            @* Sized and shown or hidden entirely from JS - see setSpacerSize. Rendering a display
               here as well would make Blazor the second owner of the same property, and its writes
               land as a whole style attribute, taking the JS-set height with them. *@
            <li @key="@VirtualListSpecialKeys.Spacer"
                class="c-spacer-start">
                <VirtualListSkeletonView SkeletonCount="@startSkeletonCount" Skeleton="@Skeleton" SkeletonBatch="@SkeletonBatch"/>
            </li>

            @for (var i = 0; i < items.Count; i++) {
                var item = items[i];
                var edgeClass = (hasVeryFirstItem && i == 0 ? " c-first" : "")
                    + (hasVeryLastItem && i == items.Count - 1 ? " c-last" : "");
                @if (item.IsGroup) {
                    <li @key="@item.RenderKey" class="group@(edgeClass)">
                        @Item(item)
                    </li>
                } else {
                    <li @key="@item.RenderKey"
                        class="item@(edgeClass)"
                        data-key="@item.Key"
                        data-skip="@item.ShouldSkipKey"
                        data-vl-h-transition="@GetHeightTransition(item)"
                        data-vl-h-delay="@(item.HeightSettleDelayMs?.Format())">
                        @Item(item)
                    </li>
                }
            }

            <li @key="@VirtualListSpecialKeys.EndSpacer"
                class="c-spacer-end">
                <VirtualListSkeletonView SkeletonCount="@endSkeletonCount" Skeleton="@Skeleton" SkeletonBatch="@SkeletonBatch"/>
            </li>

            @* In-flow end marker right after the content: visible only when scrolled to the newest,
               which drives sticky-end detection (top-to-bottom layout, no reverse rendering). *@
            <li @key="@VirtualListSpecialKeys.EndAnchor"
                class="c-end-anchor">
                &nbsp;
            </li>

        </ul>
    </div>
</div>
