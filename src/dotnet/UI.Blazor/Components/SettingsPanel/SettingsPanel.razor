@using ActualChat.UI.Blazor.Services
@namespace ActualChat.UI.Blazor.Components
@{
    var tabs = Tabs;
    var selectedTabId = SelectedTabId;
    var selectedTab = tabs.FirstOrDefault(x => x.Id == selectedTabId);
    var cls = _isRightSideVisible ? "hide-panel" : "hide-tabs";
    var attr = _isRightSideVisible ? "hide-panel" : "hide-tabs";

    RenderFragment RenderTabTitle(SettingsTabDef tab) =>
        @<div class="settings-tab-item">
            <i class="@tab.IconClass text-2xl icon-title"></i>
            <span>
                @tab.Title
                @if (tab.TitleBadge is { } titleBadge) {
                    <sup class="c-title-badge">@titleBadge</sup>
                }
            </span>
            <div class="flex-x">
                @tab.TitleContent
            </div>
        </div>;
}

<div class="@Class settings-panel @cls" data-settings-panel="@attr">
    <div class="c-tabs" role="tablist" aria-orientation="vertical">
        <div class="c-header">
            <SettingsHeader Title="@Title" ArrowClick="CloseModalClick"/>
        </div>
        <div class="c-tab-items">
            @foreach (var tab in tabs) {
                var isActive = tab.Id == selectedTabId;
                @if (tab.HasSeparatorBefore) {
                    <Divider Class="m-4"/>
                }
                <div @key="@tab.Id" class="c-tab-item @(isActive ? "on" : "") @tab.Class">
                    <Button
                        Class="unhovered"
                        Click="@(_ => OnTabClick(tab))"
                        data-tab-id="@tab.Id"
                        role="tab"
                        aria-selected="@isActive">
                        @RenderTabTitle(tab)
                    </Button>
                </div>
            }
        </div>
        <DownloadAppBanner CanBeClosed="false"/>
        <div class="p-2">
            <ShareOwnAccountTileItem/>
        </div>
        <div class="c-footer">
            <div class="c-content">
                <div class="c-version">@ApiConstants.DisplayVersionString</div>
                <div class="flex-none">
                    <StartupTimeBar/>
                </div>
            </div>
        </div>
    </div>
    @if (selectedTab is { Content: { } content }) {
        <div @key="@selectedTab.Id" class="@selectedTab.Class settings-tab">
            <div class="tab-inner">
                <div class="settings-tab-header @selectedTab.HeaderClass">
                    <SettingsHeader Title="@selectedTab.Title" ArrowClick="@OnTabArrowClick"/>
                </div>
                <div class="settings-tab-content @selectedTab.ContentClass">
                    @content
                </div>
            </div>
        </div>
    }
</div>

@code {
    private IReadOnlyList<SettingsTabDef> _lastTabs = [];
    private bool _isRightSideVisible;
    private ModalStepRef? _tabStepRef;

    [CascadingParameter] public Modal? Modal { get; set; }
    [CascadingParameter] public ScreenSize ScreenSize { get; set; }

    [Parameter, EditorRequired] public IReadOnlyList<SettingsTabDef> Tabs { get; set; } = [];
    [Parameter] public string Class { get; set; } = "";
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public EventCallback<string?> SelectedTabIdChanged { get; set; }
    [Parameter] public EventCallback CloseModalClick { get; set; }
    [Parameter] public string? DefaultTabId { get; set; }

    public string? SelectedTabId {
        get;
        set {
            if (field == value)
                return;

            field = value;
            SelectedTabIdChanged.InvokeAsync(field);
            StateHasChanged();
        }
    }

    protected override void OnInitialized() {
        SelectedTabId = DefaultTabId;
        if (!DefaultTabId.IsNullOrEmpty())
            _isRightSideVisible = true;
    }

    protected override void OnParametersSet() {
        var tabs = Tabs;
        var lastTabs = _lastTabs;
        _lastTabs = tabs;
        SelectedTabId = ResolveSelectedTabId(tabs, lastTabs);
    }

    public void OnTabArrowClick() {
        var stepRef = _tabStepRef;
        _tabStepRef = null;
        _isRightSideVisible = false;
        if (stepRef != null)
            Modal!.StepBack();
        StateHasChanged();
    }

    // Private methods

    private string? ResolveSelectedTabId(IReadOnlyList<SettingsTabDef> tabs, IReadOnlyList<SettingsTabDef> lastTabs) {
        // Survival is decided by Id rather than instance: a tab re-created with the same Id hasn't
        // disappeared. An action tab has no content, so it is never a selection to fall back to.
        var selectedTabId = SelectedTabId;
        var selectable = tabs.Where(x => x.Content != null).ToList();
        if (selectable.Count == 0)
            return null;
        if (selectedTabId is null || lastTabs.All(x => x.Id != selectedTabId))
            return selectable[0].Id;
        if (selectable.Any(x => x.Id == selectedTabId))
            return selectedTabId;

        // The selected tab is gone: take the nearest survivor after it in the order it had,
        // and fall back to the last tab if everything after it went away too.
        return lastTabs
            .SkipWhile(x => x.Id != selectedTabId)
            .FirstOrDefault(x => selectable.Any(y => y.Id == x.Id))
            ?.Id
            ?? selectable[^1].Id;
    }

    private void OnTabClick(SettingsTabDef tab) {
        if (tab.Click is { } click) {
            click.Invoke();
            return;
        }

        SelectedTabId = tab.Id;
        _isRightSideVisible = true;
        StepIn();
    }

    private void StepIn() {
        // Only a narrow screen hides the tab list behind the tab content, so only there
        // the tab is a place the back button should return from.
        if (_tabStepRef != null || Modal is not { } modal || !ScreenSize.IsNarrow())
            return;

        var stepRef = modal.StepIn("settings-tab");
        _tabStepRef = stepRef;
        _ = stepRef.WhenClosed.ContinueWith(
            task => InvokeAsync(() => OnStepClosed(stepRef, task)),
            TaskScheduler.Default);
    }

    private void OnStepClosed(ModalStepRef stepRef, Task<bool> whenClosed) {
        // A mismatch means OnTabArrowClick has already handled this step
        if (_tabStepRef != stepRef)
            return;

        _tabStepRef = null;
        // The step result is false when it's closed because the entire modal is closing.
        if (!whenClosed.IsCompletedSuccessfully || !whenClosed.Result)
            return;

        _isRightSideVisible = false;
        StateHasChanged();
    }
}
