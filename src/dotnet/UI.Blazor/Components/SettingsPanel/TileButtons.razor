@namespace ActualChat.UI.Blazor.Components
@using ActualChat.Users
@inherits ComputedStateComponent<UIHub, bool>
@{
    var m = State.Value;
    var cls = m ? "btn-xs btn-transparent selected" : "btn-xs btn-transparent text-03 hover:text-02";
    var setDefaultBtnTooltip = m ? "" : L.Avatar_MakeDefault;
}

@if (SetDefaultClick.HasDelegate) {
    <ButtonRound
        Class="@cls"
        Tooltip="@setDefaultBtnTooltip"
        TooltipPosition="FloatingPosition.Top"
        Click="@SetDefaultClick">
        <i class="icon-star text-xl"></i>
    </ButtonRound>
}
@if (EditClick.HasDelegate) {
    <ButtonRound
        Class="btn-xs btn-transparent tile-btn"
        Tooltip="@L.Common_Edit"
        TooltipPosition="FloatingPosition.Top"
        Click="EditClick">
        <i class="icon-edit text-xl"></i>
    </ButtonRound>
}
@if (CloseClick.HasDelegate) {
    <ButtonRound
        Class="btn-xs btn-transparent"
        Tooltip="@L.Common_Close"
        TooltipPosition="FloatingPosition.Top"
        Click="@CloseClick">
        <i class="icon-close text-xl @cls"></i>
    </ButtonRound>
}

@code{
    [Parameter] public AvatarFull? Avatar { get; set; }
    [Parameter] public EventCallback EditClick { get; set; }
    [Parameter] public EventCallback SetDefaultClick { get; set; }
    [Parameter] public EventCallback CloseClick { get; set; }

    protected override ComputedState<bool>.Options GetStateOptions()
        => ComputedStateComponent.GetStateOptions(GetType(),
            static t => new ComputedState<bool>.Options() {
                UpdateDelayer = FixedDelayer.NextTick,
                Category = GetStateCategory(t),
            });

    protected override async Task<bool> ComputeState(CancellationToken cancellationToken) {
        var userAvatarSettings = await UserSettingsUI
            .UserAvatarSettings().Get(cancellationToken)
            .ConfigureAwait(false);
        var defaultAvatarId = userAvatarSettings.DefaultAvatarId;
        if (defaultAvatarId.IsEmpty)
            defaultAvatarId = userAvatarSettings.AvatarIds.GetOrDefault(0);
        return Avatar?.Id == defaultAvatarId;
    }
}
