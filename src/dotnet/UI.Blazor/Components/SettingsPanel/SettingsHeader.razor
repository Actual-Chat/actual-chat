@namespace ActualChat.UI.Blazor.Components

<HeaderButton Click="ArrowClick" Class="md:hidden">
    <i class="icon-arrow-left"></i>
</HeaderButton>
<div class="c-title">
    @Title
</div>
@if (Buttons != null) {
    <div class="c-buttons">
        @Buttons
    </div>
}

@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public EventCallback ArrowClick { get; set; }
    [Parameter] public RenderFragment? Buttons { get; set; }
}
