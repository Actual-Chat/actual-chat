@namespace ActualChat.UI.Blazor.Components
@using ActualChat.UI.Blazor.Services
@using ActualChat.Users
@inherits ComputedStateComponent<UIHub, AccountFull>
@{
    var account = State.Value;
    if (account.IsGuestOrNull())
        return;
}

<TileItem IsHoverable="false" Class="first-tile-item tile-item-my-account-link">
    <Icon>
        <AvatarCircle
            Avatar="@account.Avatar"
            Size="@AvatarSize" />
    </Icon>
    <Content>
        @account.Name
    </Content>
    <Right>
        <Button Class="btn-outline btn-sm btn-share-action" Click="@(() => OnShareClick(account, account.Avatar.Name))">
            <Icon><i class="icon-share text-2xl"></i></Icon>
            <Title>@L.Common_Share</Title>
        </Button>
    </Right>
</TileItem>

@code {
    [Parameter] public SquareSize AvatarSize { get; set; } = SquareSize.Size12;

    protected override ComputedState<AccountFull>.Options GetStateOptions()
        => new() {
            InitialValue = AccountUI.OwnAccount.Value,
            Category = GetStateCategory(GetType()),
        };

    protected override Task<AccountFull> ComputeState(CancellationToken cancellationToken)
        => AccountUI.OwnAccount.Use(cancellationToken);

    private void OnShareClick(AccountFull account, string name) {
        var shareUI = Services.GetRequiredService<ShareUI>();
        var request = new ShareRequest($"{name} on {CoreConstants.AppName}", Links.User(account.AliasInfo));
        shareUI.Share(ShareKind.Contact, "Share your contact", name, request);
    }
}
