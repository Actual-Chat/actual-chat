@using ActualChat.UI.Blazor.Services
@namespace ActualChat.UI.Blazor.Components
@inherits ComponentBase<UIHub>

<div class="bubble-content">
    <div class="c-body">
        @if (VideoMP4 != null || VideoWebM != null) {
            <div class="c-video">
                @if (VideoMP4 != null && BrowserInfo.IsIos) {
                    @VideoMP4
                } else if (VideoWebM != null) {
                    @VideoWebM
                }
            </div>
        }
        <div class="c-content">
            @if (Title != null) {
                <div class="bubble-title">
                    @Title
                </div>
            }
            <div class="bubble-body">
                @Body
            </div>
        </div>
    </div>
    <div class="flex-x items-center">
        <div class="bubble-counter flex-none text-xs">
            @L.Bubble_Counter_Format(Bubble.Index, Bubble.Total)
        </div>
        <div class="bubble-buttons flex justify-end">
            @if (!Bubble.IsLastVisible) {
                <Button Class="btn-bubble" Click="OnSkipClick">@L.Common_Skip</Button>
            }
            <Button Class="btn-bubble btn-next" Click="OnNextClick">
                @(Bubble.IsLastVisible ? L.Common_OK : L.Common_Next)
            </Button>
        </div>
    </div>
</div>

@code {
    private BrowserInfo BrowserInfo => Hub.BrowserInfo;

    [Parameter, EditorRequired] public IBubble Bubble { get; set; } = null!;
    [Parameter] public RenderFragment? Title { get; set; }
    [Parameter] public RenderFragment? VideoWebM { get; set; }
    [Parameter] public RenderFragment? VideoMP4 { get; set; }
    [Parameter, EditorRequired] public RenderFragment Body { get; set; } = null!;

    private async Task OnNextClick()
        => await Bubble.Host.ReadBubble(Bubble);

    private async Task OnSkipClick()
        => await Bubble.Host.SkipBubbles();
}
