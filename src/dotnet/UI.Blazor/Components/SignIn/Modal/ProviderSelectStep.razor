@namespace ActualChat.UI.Blazor.Components
@using ActualChat.UI.Blazor.Services
@using ActualChat.Users
@inherits Step<UIHub, ProviderSelectStep.Model>;
@{
    if (CurrentStep != this || _authProviders is null)
        return;

    var m = State.Value;
    ProcessSignInError(m.SignInError);
}

<div class="sign-in-step provider-select-step">
    <div class="c-auth-providers">
        @foreach (var provider in _authProviders!) {
            <Button
                Class="btn-modal sign-in sign-in-with"
                Click="@(_ => OnSignInWithProvider(provider.Name))">
                <Icon>
                    @if (provider.Icon != null) {
                        <img draggable="false" src="@provider.Icon" class="@provider.Class" alt="@provider.DisplayName">
                    }
                </Icon>
                <Title>@L.SignIn_SignInWith_Format(provider.DisplayName)</Title>
            </Button>
        }
    </div>

    <div class="c-separator">@L.SignIn_Or</div>
    <Form
        Class="c-phone-form"
        Model="@_formModel"
        OnSubmit="@OnSubmit">
        <AsyncDataAnnotationsValidator @ref="_formValidator"/>
        <FormSection
            For="() => _formModel.PhoneOrEmail"
            InputId="@_formModel.PhoneOrEmailFieldId"
            Class="grow"
            ShowErrors="@_showFieldErrors"
            IsLabelInsideInput="true">
            <TextBox
                Id="@_formModel.PhoneOrEmailFieldId"
                Value="@(!_formModel.PhoneOrEmail.IsNullOrEmpty() ? _formModel.PhoneOrEmail : "")"
                ValueExpression="@(() => _formModel.PhoneOrEmail)"
                Autocomplete="tel email username"
                ValueChanged="@((string? v) => OnPhoneOrEmailChanged(v))"
                Placeholder="@_placeholder"
                disabled="@m.HasSentCodeRecently"
                type="text"
                inputmode="text"
            />
            @if (m.HasSentCodeRecently) {
                <div class="c-info">
                    <i class="icon-info"></i>
                    <span>@L.SignIn_CodeSent</span>
                </div>
            }
        </FormSection>

        <CaptchaView />

        @if (!_signInError.IsNullOrEmpty()) {
            <div class="c-account-error">@_signInError</div>
        }
        <FormButtons IsEndAligned="false" Class="dialog-buttons">
            <Button Type="@ButtonType.Submit"  Class="btn-primary btn-modal sign-in" IsDisabled="@(_validationState is ValidationState.Invalid || _formModel.PhoneOrEmail.IsNullOrEmpty())">
                @switch (_validationState) {
                    case ValidationState.Validating:
                        <i class="icon-refresh"></i><span>@L.SignIn_Validating</span>
                        break;
                    case ValidationState.Invalid:
                        <span>@L.SignIn_Unavailable</span>
                        break;
                    case ValidationState.None:
                    case ValidationState.Valid:
                    case ValidationState.CodeSentRecently:
                    default:
                        <span>@L.Common_Continue</span>
                        break;
                }
            </Button>
        </FormButtons>

    </Form>
</div>

@code {
    // ReSharper disable once InconsistentNaming
    private const string SessionTemporals_SignInErrorKey = Constants.SessionTemporals.SignInErrorKey;

    private ValidationState _validationState = ValidationState.None;
    private StepModel _formModel = null!;
    private List<AuthProviderModel>? _authProviders;
    private AsyncDataAnnotationsValidator _formValidator = null!;
    private bool _showFieldErrors;
    private string _signInError = "";
    private CpuTimestamp _lastSignInErrorConsumedAt;
    private volatile string _placeholder = "+1(555)555-5555 or email@gmail.com";

    private IPhones Phones => Hub.Phones;
    private ICaptcha Captcha => Hub.Captcha;
    private ISessionTemporals SessionTemporals => Hub.SessionTemporals;
    private CaptchaUI CaptchaUI => Hub.CaptchaUI;
    private TotpUI TotpUI => Hub.TotpUI;

    [Parameter, EditorRequired] public TotpSignInModel TotpSignInModel { get; set; } = null!;
    [CascadingParameter] public Modal Modal { get; set; } = null!;

    protected override async Task OnInitializedAsync() {
        _authProviders = AccountUI.GetAuthSchemas()
            .Select(schema => new AuthProviderModel {
                Name = schema.Name,
                DisplayName = schema.DisplayName,
                Icon = schema.Name switch {
                    AuthSchema.Google => "/dist/images/landing/google-icon-color.svg",
                    AuthSchema.Apple => "/dist/images/landing/apple-icon-black.svg",
                    _ => null,
                },
                Class = schema.Name switch {
                    AuthSchema.Apple => "logo-apple",
                    _ => "",
                },
            })
            .ToList();
        _formModel = new StepModel(ComponentIdGenerator).CopyToBase();
        await CaptchaUI.WhenReady.ConfigureAwait(false);
        _ = UpdatePlaceholder();
        return;

        async Task UpdatePlaceholder() {
            var example = await Phones.GetExampleCountryPhone(Hub.Session, CancellationToken.None);
            if (example != null) {
                _placeholder = $"{example.ToReadable(withSpaces: false)} or email@gmail.com";
                this.NotifyStateHasChanged();
            }
        }
    }

    protected override ComputedState<Model>.Options GetStateOptions() {
        return new() {
            InitialValue = new (),
            UpdateDelayer = FixedDelayer.MinDelay,
            Category = GetStateCategory(GetType()),
        };
    }

    protected override async Task<Model> ComputeState(CancellationToken cancellationToken) {
        var hasSentCodeRecently = await TotpUI.HasSentCodeRecently(CancellationToken.None);
        var signInError = await SessionTemporals.Get(Session, SessionTemporals_SignInErrorKey, cancellationToken)
            ?? "";
        return new(hasSentCodeRecently, signInError);
    }

    protected override async Task<bool> Validate() {
        var isValid = _validationState is not ValidationState.Invalid
            && await _formValidator.Validate().ConfigureAwait(false);
        return isValid;
    }

    private void ProcessSignInError(string signInError) {
        if (signInError.IsNullOrEmpty())
            return;

        _signInError = signInError;
        if (_lastSignInErrorConsumedAt.Elapsed <= TimeSpan.FromSeconds(2))
            return;

        _lastSignInErrorConsumedAt = CpuTimestamp.Now;

        // After a registration cancel, the phone/email field is still blocked
        // by the TOTP throttle and still holds the abandoned input. Reset both
        // so the user can start fresh.
        if (signInError == Constants.SessionTemporals.SignInCanceledMessage) {
            _formModel.PhoneOrEmail = "";
            TotpSignInModel.Phone = null;
            TotpSignInModel.Email = null;
            _validationState = ValidationState.None;
            _showFieldErrors = false;
            TotpUI.Reset();
        }

        var cmd = new SessionTemporals_Set { Session = Session, Key = SessionTemporals_SignInErrorKey, Value = null };
        _ = Hub.Services.Commander().Run(cmd, true, CancellationToken.None);
    }

    protected override async Task<bool> Save() {
        var input = _formModel.PhoneOrEmail;
        if (!input.IsNullOrEmpty() && System.Net.Mail.MailAddress.TryCreate(input, out _)) {
            TotpSignInModel.Email = Email.Parse(input);
            TotpSignInModel.Phone = null;
            return true;
        }

        var phone = await Phones.ParseWithCountryFallback(Hub.Session, input, CancellationToken.None);
        if (phone == null)
            return false;

        TotpSignInModel.Phone = phone;
        TotpSignInModel.Email = null;
        return true;
    }

    private async Task OnSignInWithProvider(string schema) {
        await AccountUI.SignIn(schema);
    }

    private void OnPhoneOrEmailChanged(string? value) {
        _signInError = "";
        _showFieldErrors = true;
        var newValue = value ?? "";
        if (Equals(_formModel.PhoneOrEmail, newValue))
            return;

        _formModel.PhoneOrEmail = newValue;
        if (_validationState is ValidationState.CannotSend or ValidationState.Invalid)
            _validationState = ValidationState.None;
        StateHasChanged();
    }

    private async Task OnSubmit() {
        _showFieldErrors = true;
        _signInError = "";
        if (_validationState is ValidationState.CannotSend or ValidationState.Invalid)
            _validationState = ValidationState.None;

        var hasSentCodeRecently = await TotpUI.HasSentCodeRecently(CancellationToken.None);
        if (hasSentCodeRecently) {
            _validationState = ValidationState.CodeSentRecently;
            StateHasChanged();
            await Stepper.TryMoveForward();
            return;
        }

        if (CaptchaUI.IsAvailable) {
            _validationState = ValidationState.Validating;
            StateHasChanged();
            try {
                var captchaAction = Constants.Recaptcha.Actions.PhoneSignIn;
                var captchaToken = await CaptchaUI.GetActionToken(captchaAction, CancellationToken.None);
                var validationResult = await Captcha.Validate(captchaToken, captchaAction, CancellationToken.None);
                _validationState = validationResult.Success
                    ? ValidationState.Valid
                    : ValidationState.Invalid;
            }
            catch {
                _validationState = ValidationState.Invalid;
            }
            finally {
                StateHasChanged();
            }
        } else {
            _validationState = ValidationState.Valid;
        }

        if (_validationState is ValidationState.Valid) {
            var input = _formModel.PhoneOrEmail;
            var phone = await Phones.ParseWithCountryFallback(Hub.Session, input, CancellationToken.None);
            if (phone is not null) {
                if (!await ValidatePhoneForSend(phone))
                    return;
            } else if (!input.IsNullOrEmpty()) {
                if (!await ValidateEmailForSend(input))
                    return;
            }
        }

        await Stepper.TryMoveForward().AsTask();
    }

    private async Task<bool> ValidatePhoneForSend(Phone phone) {
        var blocked = await TotpUI.CheckIfBlocked(phone, TotpPurpose.SignInPhone, CancellationToken.None);
        if (blocked.IsNullOrEmpty())
            return true;

        _signInError = blocked;
        StateHasChanged();
        return false;
    }

    private async Task<bool> ValidateEmailForSend(string input) {
        Email? email = null;
        if (System.Net.Mail.MailAddress.TryCreate(input, out var emailValue))
            Email.TryParse(emailValue.Address, out email);

        if (email is null) {
            _signInError = "Invalid phone number or email address.";
            StateHasChanged();
            return false;
        }

        var blocked = await TotpUI.GetEmailValidationMessage(
            email, TotpPurpose.SignInEmail, CancellationToken.None);
        if (blocked.IsNullOrEmpty())
            return true;

        _signInError = blocked;
        StateHasChanged();
        return false;
    }

    // Nested types

    private class AuthProviderModel {
        public string Name { get; init; } = null!;
        public string DisplayName { get; init; } = null!;
        public string? Icon { get; init; }
        public string Class { get; init; } = null!;
    }

    public sealed record Model(bool HasSentCodeRecently = false, string SignInError = "");

    public sealed class StepModel(ComponentIdGenerator? componentIdGenerator = null)
        : FormModel<StepModel>("phone-signin", componentIdGenerator) {
        [PhoneOrEmail]
        public string PhoneOrEmail { get; set; } = "";
        public string PhoneOrEmailFieldId { get; set; } = "";
    }
}
