@namespace ActualChat.UI.Blazor.Components
@using ActualChat.UI.Blazor.Services
@using System.ComponentModel.DataAnnotations
@using ActualChat.Users
@inherits Step<UIHub, ProviderSelectStep.Model>;
@{
    if (CurrentStep != this)
        return;

    if (_authSchemas is null)
        return;

    var m = State.LastNonErrorValue;
    var codeHasBeenSent = m.HasSentCodeRecently;
}

<div class="sign-in-step provider-select-step">
    <div class="c-auth-providers">
        @foreach (var schema in _authSchemas!) {
            <Button
                Class="btn-modal sign-in sign-in-with"
                Click="@(_ => OnSignInWith(schema.Name))">
                <Icon>
                    @if (schema.Icon != null) {
                        <img draggable="false" src="@schema.Icon" class="@schema.Class" alt="@schema.DisplayName">
                    }
                </Icon>
                <Title>@("Sign in with " + schema.DisplayName)</Title>
            </Button>
        }
    </div>

    <div class="c-separator">or</div>
    <Form
        Class="c-phone-form"
        Model="@_stepModel"
        OnSubmit="@OnSignIn">
        <AsyncDataAnnotationsValidator @ref="_validator"/>
        <FormSection
            For="() => _stepModel.Contact"
            InputId="@_stepModel.ContactFieldId"
            Class="grow"
            ShowErrors="@_showPhoneValidationErrors"
            IsLabelInsideInput="true"
            IsRequired="true">
            <TextBox
                Id="@_stepModel.ContactFieldId"
                Value="@(!_stepModel.Contact.IsNullOrEmpty() ? _stepModel.Contact : "")"
                ValueExpression="@(() => _stepModel.Contact)"
                Autocomplete="tel email username"
                ValueChanged="@((string? v) => OnContactChanged(v))"
                Placeholder="Sign in with email or phone number"
                disabled="@codeHasBeenSent"
                type="text"
                inputmode="text"
                />
            @if (codeHasBeenSent) {
                <div class="c-info">
                    <i class="icon-info"></i>
                    <span>Code sent. Check your inbox or phone.</span>
                </div>
            }
        </FormSection>
        @if (CaptchaUI.IsConfigured) {
            <div class="c-recaptcha-info">
                This site is protected by reCAPTCHA and the Google
                <a class="recaptcha-link" href="https://policies.google.com/privacy">Privacy Policy</a> and
                <a class="recaptcha-link" href="https://policies.google.com/terms">Terms of Service</a> apply.
            </div>
        }
        <FormButtons IsEndAligned="false" Class="dialog-buttons">
            <Button Type="@ButtonType.Submit"  Class="btn-primary btn-modal sign-in" IsDisabled="@(_validationState is ValidationState.Invalid or ValidationState.CannotSend)">
                @switch (_validationState) {
                    case ValidationState.Validating:
                        <i class="icon-refresh"></i><span>Validating...</span>
                        break;
                    case ValidationState.Invalid:
                        <span>Unavailable</span>
                        break;
                    case ValidationState.None:
                    case ValidationState.Valid:
                    case ValidationState.CodeSentRecently:
                    default:
                        <span>Continue</span>
                        break;
                }
            </Button>
        </FormButtons>

    </Form>
</div>

@code {
    private readonly string _defaultPhoneValue = PhoneCodes.Default.DisplayCode;
    private ValidationState _validationState = ValidationState.None;
    private StepModel _stepModel = null!;
    private List<AuthSchemaModel>? _authSchemas;
    private AsyncDataAnnotationsValidator _validator = null!;
    private bool _showPhoneValidationErrors;

    private IPhones Phones => Hub.Phones;
    private ICaptcha Captcha => Hub.Captcha;
    private CaptchaUI CaptchaUI => Hub.CaptchaUI;
    private TotpUI TotpUI => Hub.TotpUI;

    [Parameter, EditorRequired] public TotpSignInModel TotpSignInModel { get; set; } = null!;
    [CascadingParameter] public Modal Modal { get; set; } = null!;

    protected override async Task OnInitializedAsync() {
        _authSchemas = AccountUI.GetAuthSchemas()
            .Select(schema => new AuthSchemaModel {
                Name = schema.Name,
                DisplayName = schema.DisplayName,
                Icon = schema.Name switch {
                    AuthSchema.Google => "/dist/images/landing/google-icon-color.svg",
                    AuthSchema.Apple => "/dist/images/landing/apple-icon-black.svg",
                    _ => null,
                },
                Class = schema.Name switch {
                    AuthSchema.Apple => "logo-apple",
                    _ => "",
                },
            })
            .ToList();
        _stepModel = new StepModel(ComponentIdGenerator).CopyToBase();
        await CaptchaUI.EnsureInitialized().ConfigureAwait(false);
    }

    protected override ComputedState<Model>.Options GetStateOptions() {
        return new() {
            InitialValue = new (),
            UpdateDelayer = FixedDelayer.MinDelay,
            Category = GetStateCategory(GetType()),
        };
    }

    protected override async Task<Model> ComputeState(CancellationToken cancellationToken) {
        var hasSentCodeRecently = await TotpUI.HasSentCodeRecently(CancellationToken.None);
        return new (hasSentCodeRecently);
    }

    protected override async Task<bool> Validate() {
        var isValid = _validationState is not (ValidationState.Invalid or ValidationState.CannotSend)
            && await _validator.Validate().ConfigureAwait(false);
        return isValid;
    }

    protected override async Task<bool> Save() {
        var input = _stepModel.Contact;
        if (!input.IsNullOrEmpty() && System.Net.Mail.MailAddress.TryCreate(input, out var email)) {
            // Parse into Email identifier
            TotpSignInModel.Email = Email.Parse(input);
            TotpSignInModel.Phone = null;
            return true;
        }

        var phone = await Phones.Parse(input, CancellationToken.None);
        if (phone == null)
            return false;

        TotpSignInModel.Phone = phone;
        TotpSignInModel.Email = null;
        return true;

    }

    private void OnSignInWith(string schema)
        => _ = AccountUI.SignIn(schema);

    private void OnContactChanged(string? value) {
        _showPhoneValidationErrors = true;
        var newValue = value ?? "";
        if (newValue == _defaultPhoneValue)
            newValue = "";
        if (Equals(_stepModel.Contact, newValue))
            return;

        _stepModel.Contact = newValue;
        if (_validationState == ValidationState.CannotSend)
            _validationState = ValidationState.None;
    }

    private async Task OnSignIn() {
        _showPhoneValidationErrors = true;
        var hasSentCodeRecently = await TotpUI.HasSentCodeRecently(CancellationToken.None);
        if (hasSentCodeRecently) {
            _validationState = ValidationState.CodeSentRecently;
            StateHasChanged();
            await Stepper.TryMoveForward().AsTask();
            return;
        }

        if (CaptchaUI.IsConfigured) {
            _validationState = ValidationState.Validating;
            StateHasChanged();
            try {
                var captchaAction = Constants.Recaptcha.Actions.PhoneSignIn; // reuse action unless project defines a separate EmailSignIn
                var captchaToken = await CaptchaUI.GetActionToken(captchaAction, CancellationToken.None);
                var validationResult = await Captcha.Validate(captchaToken, captchaAction, CancellationToken.None);
                _validationState = validationResult.Success
                    ? ValidationState.Valid
                    : ValidationState.Invalid;
            }
            catch {
                _validationState = ValidationState.Invalid;
            }
            finally {
                StateHasChanged();
            }
        }

        if (_validationState is ValidationState.Valid) {
            // Determine kind and pre-validate sending for phones
            var phone = await Phones.Parse(_stepModel.Contact, CancellationToken.None);
            if (phone is not null) {
                var canSendValidationMessage = await TotpUI.ValidateCanSendToPhone(phone, TotpPurpose.SignInPhone, CancellationToken.None);
                if (!canSendValidationMessage.IsNullOrEmpty()) {
                    _validationState = ValidationState.CannotSend;
                    UICommander.ShowError(canSendValidationMessage);
                }
            } else if (!(_stepModel.Contact.IsNullOrEmpty())) {
                // Parse contact as email identifier for validation
                Email? emailId = null;
                if (System.Net.Mail.MailAddress.TryCreate(_stepModel.Contact, out var mail))
                    Email.TryParse(mail.Address, out emailId);

                if (emailId is null) {
                    _validationState = ValidationState.CannotSend;
                    UICommander.ShowError("Invalid email address.");
                } else {
                    var emailCheck = await TotpUI.ValidateCanSendToEmail(emailId, TotpPurpose.SignInEmail, CancellationToken.None);
                    if (!emailCheck.IsNullOrEmpty()) {
                        _validationState = ValidationState.CannotSend;
                        UICommander.ShowError(emailCheck);
                    }
                }
            }
        }

        await Stepper.TryMoveForward().AsTask();
    }

    // Nested types

    private class AuthSchemaModel {
        public string Name { get; init; } = null!;
        public string DisplayName { get; init; } = null!;
        public string? Icon { get; init; }
        public string Class { get; init; } = null!;
    }

    public sealed record Model(bool HasSentCodeRecently = false);

    public sealed class StepModel(ComponentIdGenerator? componentIdGenerator = null)
        : FormModel<StepModel>("phone-signin", componentIdGenerator) {
        [Required] public string Contact { get; set; } = "";
        public string ContactFieldId { get; set; } = "";
    }
}
