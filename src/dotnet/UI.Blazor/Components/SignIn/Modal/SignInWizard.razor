@namespace ActualChat.UI.Blazor.Components
@inherits ComponentBase<UIHub>
@{
    var title = Title.NullIfEmpty() ?? L.SignIn_SignInTo_Format(CoreConstants.AppName);
}

<Stepper Context="stepper">
    <Header>
        @if (!stepper.CanMoveBack) {
            <div class="sign-in-modal-header-wrapper">
                <div class="sign-in-modal-header">@title</div>
            </div>
        } else {
            <HeaderButton Click="@(_ => stepper.MoveBack())">
                <i class="icon-arrow-left text-2xl"></i>
            </HeaderButton>
            <div class="sign-in-modal-header">@L.SignIn_VerificationCode</div>
        }
    </Header>
    <Steps>
        <ProviderSelectStep TotpSignInModel="_model"/>
        <CompleteSignInStep TotpSignInModel="_model"/>
    </Steps>
</Stepper>

@code {
    private TotpSignInModel _model = new();

    [Parameter] public string Title { get; set; } = "";
}
