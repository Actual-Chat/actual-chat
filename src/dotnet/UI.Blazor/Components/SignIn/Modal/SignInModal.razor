@namespace ActualChat.UI.Blazor.Components
@inherits ComputedStateComponent<UIHub, AccountFull>
@using ActualChat.Users
@implements IModalView<SignInModal.Model>
@{
    if (!State.Value.IsGuestOrNull())
        Modal.Close(true);
}

<DialogFrame
    Class="sign-in-modal fixed-height"
    HasHeader="false"
    NarrowViewSettings="DialogFrameNarrowViewSettings.Default">
    <Body>
        <SignInWizard Title="@ModalModel.Title" />
    </Body>
</DialogFrame>

@code {
    [CascadingParameter] public Modal Modal { get; set; } = null!;
    [Parameter] public Model ModalModel { get; set; } = null!;

    protected override void OnInitialized() {
        AccountUI.PostponeOnSignInWorkflow(Modal.Ref.WhenClosed);
        base.OnInitialized();
    }

    protected override ComputedState<AccountFull>.Options GetStateOptions()
        => new() {
            InitialValue = AccountUI.OwnAccount.Value,
            UpdateDelayer = FixedDelayer.NextTick,
            Category = GetStateCategory(GetType()),
        };

    protected override Task<AccountFull> ComputeState(CancellationToken cancellationToken)
        => AccountUI.OwnAccount.Use(cancellationToken);

    // Nested types

    public sealed record Model(string Title = "");
}
