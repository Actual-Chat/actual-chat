@namespace ActualChat.UI.Blazor.Components
@inherits ComponentBase<UIHub>

<div class="@Class search-box">
    <label>
        <TextInput
            @ref="_inputRef"
            Class="w-full dialog-unstyled"
            Placeholder="@(Placeholder ?? L.Common_Search)"
            MaxLength="@MaxLength"
            TextChanged="OnInput">
        </TextInput>
        <i class="icon-search text-2xl search-icon"></i>
        @if (ClearButton && !_text.IsNullOrEmpty()) {
            <HeaderButton
                Class="btn-sm text-box-btn"
                Click="@OnClearClick"
                data-tooltip="@L.Common_Clear"
                data-tooltip-position="@(FloatingPosition.Top.ToPositionString())">
                <i class="icon-close"></i>
            </HeaderButton>
        }
        @if (ShowCloseButton) {
            <HeaderButton Click="Close" Class="c-close-btn">
                <i class="icon-close text-2xl"></i>
            </HeaderButton>
        }
    </label>
</div>

@code {
    private TextInput? _inputRef;
    private string _text = "";

    [Parameter] public string Class { get; set; } = "";
    [Parameter] public int? MaxLength { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public bool ShowCloseButton { get; set; }
    [Parameter] public bool ClearButton { get; set; }
    [Parameter] public EventCallback OnCloseClick { get; set; }
    [Parameter] public EventCallback<string> TextChanged { get; set; }

    public ValueTask Focus()
        => _inputRef?.Focus() ?? default;

    public ValueTask Cancel()
        => _inputRef?.Clear() ?? default;

    private void Close() {
        Cancel();
        OnCloseClick.InvokeAsync();
    }

    private Task OnInput(string text) {
        _text = text;
        return TextChanged.InvokeAsync(text);
    }

    private async Task OnClearClick() {
        if (_inputRef is not null)
            await _inputRef.Clear();
    }
}
