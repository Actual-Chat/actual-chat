@using ActualChat.Users
@using ActualChat.UI.Blazor.Services
@namespace ActualChat.UI.Blazor.Components
@inherits ComponentBase<UIHub>
@{
    var isEmail = Purpose is TotpPurpose.VerifyEmail or TotpPurpose.SignInEmail;
    var address = isEmail ? Email?.Value : Phone!.ToReadable();
    var sentToSuffix = _sentChannel switch {
        TotpChannel.Telegram => L.Verify_EnterCodeSentTo_SuffixTelegram,
        TotpChannel.Sms => L.Verify_EnterCodeSentTo_SuffixSms,
        _ => L.Verify_EnterCodeSentTo_Suffix,
    };
}

<UITimer @key="@_timerKey" Period="@TimerPeriod" IsRecurring="false" Tick="@OnTimerTick" />
<div class="totp-verifier @Class" @onclick="@(() => Focus())">
    <span class="c-description">
        @L.Verify_EnterCodeSentTo_Prefix<span class="whitespace-nowrap">@(address)</span>@(sentToSuffix)
    </span>
    @if (_sentChannel == TotpChannel.Telegram) {
        <span class="c-note">@L.Verify_SmsUnavailableUsedTelegram</span>
    }
    <TotpInput @ref="_totpInput" Completed="OnInputCompleted" IsVerifying="@_isVerifying"/>
    @if (_totpNextSendAt is { } totpNextSendAt) {
        @if (Clocks.SystemClock.Now < totpNextSendAt) {
            <div class="c-resend-code">
                <span>@L.Verify_RequestNewCodeIn</span>
                <Countdown Class="w-9" EndsAt="totpNextSendAt"/>
            </div>
        } else {
            <Button Class="btn-modal sign-in" Click="@SendTotp">@L.Verify_Resend</Button>
        }
    }
</div>

@code {
    private object? _timerKey = new();
    private TotpInput? _totpInput;
    private Moment? _totpNextSendAt;
    private bool _isVerifying;
    private TotpChannel? _sentChannel;

    private TotpUI TotpUI => Hub.TotpUI;

    [Parameter] public Phone? Phone { get; set; }
    [Parameter] public Email? Email { get; set; }
    [Parameter] public string Class { get; set; } = "";
    [Parameter, EditorRequired] public TotpPurpose Purpose { get; set; }
    [Parameter] public EventCallback Verified { get; set; }
    [Parameter] public EventCallback Error { get; set; }
    [Parameter] public EventCallback IncorrectCodeEntered { get; set; }

    private TimeSpan TimerPeriod
        => _totpNextSendAt is { } totpNextSendAt
            ? totpNextSendAt - Clocks.SystemClock.Now + TimeSpan.FromMilliseconds(10)
            : default; // No ticks

    protected override Task OnInitializedAsync()
        // Always send TOTP on init - server-side throttling prevents duplicate sends.
        // We can't rely on TotpUI.TotpNextSendAt here because it's shared across
        // phone and email flows, so a prior phone verification would suppress email sending.
        => SendTotp();

    public ValueTask Focus()
        => _totpInput?.Focus() ?? ValueTask.CompletedTask;

    private async Task OnInputCompleted(int totp) {
        bool isValid;
        Exception? error;
        try {
            if (_isVerifying)
                return;

            _isVerifying = true;
            ICommand<bool> cmd = Purpose switch {
                TotpPurpose.SignInPhone => new PhoneAuth_ValidateTotp {
                    Session = Session,
                    Phone = Phone!,
                    Totp = totp,
                },
                TotpPurpose.VerifyPhone => new PhoneAuth_VerifyPhone { Session = Session, Phone = Phone!, Totp = totp },
                TotpPurpose.SignInEmail => new EmailAuth_ValidateTotp {
                    Session = Session,
                    Email = Email!,
                    Totp = totp,
                },
                TotpPurpose.VerifyEmail => new EmailAuth_VerifyEmail {
                    Session = Session,
                    Email = Email!,
                    Token = totp,
                },
                _ => throw new ArgumentOutOfRangeException(nameof(Purpose)),
            };
            (isValid, error) = await UICommander.Run(cmd);
        }
        finally {
            _isVerifying = false;
            StateHasChanged();
        }

        if (error != null) {
            if (_totpInput != null)
                await _totpInput.Clear();
            await Error.InvokeAsync();
            return;
        }

        if (!isValid && _totpInput != null) {
            _ = TuneUI.Play(Tune.ShowInputError);
            await _totpInput.Clear();
            await _totpInput.ShowError();
            await IncorrectCodeEntered.InvokeAsync();
            return;
        }

        await Verified.InvokeAsync();
    }

    private async Task SendTotp() {
        bool isCodeSent;
        if (Purpose is TotpPurpose.VerifyEmail or TotpPurpose.SignInEmail) {
            isCodeSent = await TotpUI.SendCode(Purpose, Email!, CancellationToken.None);
        } else {
            var result = await TotpUI.SendCode(Purpose, Phone!, CancellationToken.None);
            isCodeSent = result != null;
            // The server reports no channel only when nothing was sent at all, e.g. for a predefined code
            _sentChannel = result?.Channel ?? _sentChannel;
        }
        if (!isCodeSent)
            return;

        _totpNextSendAt = TotpUI.TotpNextSendAt.Value;
        _timerKey = new(); // To make sure the timer is renewed
    }

    private void OnTimerTick() {
        // Just implicitly triggers StateHasChanged()
    }
}
