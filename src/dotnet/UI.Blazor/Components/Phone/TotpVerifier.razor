@using ActualChat.Users
@using ActualChat.UI.Blazor.Services
@namespace ActualChat.UI.Blazor.Components
@inherits ComponentBase<UIHub>
@{
    var address = Purpose is TotpPurpose.VerifyEmail or TotpPurpose.SignInEmail ? Email?.Value : Phone!.ToReadable();
}

<UITimer @key="@_timerKey" Period="@TimerPeriod" IsRecurring="false" Tick="@OnTimerTick" />
<div class="totp-verifier @Class" @onclick="@(() => Focus())">
    <span class="c-description">
        Enter the code we've sent to <span class="whitespace-nowrap">@(address)</span>
    </span>
    <TotpInput @ref="_totpInput" Completed="OnInputCompleted" IsVerifying="@_isVerifying"/>
    @if (_totpNextSendAt is { } totpNextSendAt) {
        @if (Clocks.SystemClock.Now < totpNextSendAt) {
            <div class="c-resend-code">
                <span>You can request a new code in</span>
                <Countdown Class="w-9" EndsAt="totpNextSendAt"/>
            </div>
        } else {
            <Button Class="btn-modal sign-in" Click="@SendTotp">Resend</Button>
        }
    }
</div>

@code {
    private object? _timerKey = new();
    private TotpInput? _totpInput;
    private Moment? _totpNextSendAt;
    private bool _isVerifying;

    private TotpUI TotpUI => Hub.TotpUI;

    [Parameter] public Phone? Phone { get; set; }
    [Parameter] public Email? Email { get; set; }
    [Parameter] public string Class { get; set; } = "";
    [Parameter, EditorRequired] public TotpPurpose Purpose { get; set; }
    [Parameter] public EventCallback Verified { get; set; }
    [Parameter] public EventCallback Error { get; set; }
    [Parameter] public EventCallback IncorrectCodeEntered { get; set; }

    private TimeSpan TimerPeriod
        => _totpNextSendAt is { } totpNextSendAt
            ? totpNextSendAt - Clocks.SystemClock.Now + TimeSpan.FromMilliseconds(10)
            : default; // No ticks

    protected override Task OnInitializedAsync() {
        var now = Clocks.ServerClock.Now;
        var totpNextSendAt = TotpUI.TotpNextSendAt.Value;
        if (totpNextSendAt > now) {
            _totpNextSendAt = totpNextSendAt;
            _timerKey = new(); // To make sure the timer is renewed
        } else {
            _totpNextSendAt = null;
            return SendTotp();
        }
        return Task.CompletedTask;
    }

    public ValueTask Focus()
        => _totpInput?.Focus() ?? ValueTask.CompletedTask;

    private async Task OnInputCompleted(int totp) {
        bool isValid;
        Exception? error;
        try {
            if (_isVerifying)
                return;
            _isVerifying = true;
            StateHasChanged();
            ICommand<bool> cmd = Purpose switch {
                TotpPurpose.SignInPhone => new PhoneAuth_ValidateTotp(Session, Phone!, totp),
                TotpPurpose.VerifyPhone => new PhoneAuth_VerifyPhone(Session, Phone!, totp),
                TotpPurpose.SignInEmail => new EmailAuth_ValidateTotp(Session, Email!, totp),
                TotpPurpose.VerifyEmail => new EmailAuth_VerifyEmail(Session, Email!, totp),
                _ => throw new ArgumentOutOfRangeException(nameof(Purpose)),
            };
            (isValid, error) = await UICommander.Run(cmd);
        }
        finally {
            _isVerifying = false;
            StateHasChanged();
        }

        if (error != null) {
            if (_totpInput != null) {
                await _totpInput.Clear();
            }
            await Error.InvokeAsync();
            return;
        }

        if (!isValid && _totpInput != null) {
            _ = TuneUI.Play(Tune.ShowInputError);
            await _totpInput.Clear();
            await _totpInput.ShowError();
            await IncorrectCodeEntered.InvokeAsync();
            return;
        }

        await Verified.InvokeAsync();
    }

    private async Task SendTotp() {
        var codeSent = Purpose is TotpPurpose.VerifyEmail or TotpPurpose.SignInEmail
            ? await TotpUI.SendCode(Purpose, Email!, CancellationToken.None)
            : await TotpUI.SendCode(Purpose, Phone!, CancellationToken.None);
        if (!codeSent)
            return;

        _totpNextSendAt = TotpUI.TotpNextSendAt.Value;
        _timerKey = new(); // To make sure the timer is renewed
        StateHasChanged();
    }

    private void OnTimerTick() {
        // Just implicitly triggers StateHasChanged()
    }
}
