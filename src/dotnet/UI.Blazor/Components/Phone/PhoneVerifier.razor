@namespace ActualChat.UI.Blazor.Components
@using ActualChat.UI.Blazor.Services
@using ActualChat.Users
@inherits ComponentBase<UIHub>

@{
    var showVerifier = _validationState is ValidationState.Valid or ValidationState.CodeSentRecently;
    var buttonText = _validationState switch {
        ValidationState.Validating => L.SignIn_Validating,
        ValidationState.Invalid => L.SignIn_Unavailable,
        ValidationState.CannotSend => L.SignIn_Unavailable,
        ValidationState.CodeSentRecently => L.Phone_CodeSent,
        _ => L.Phone_VerifyBySms,
    };
    var description = _validationState switch {
        ValidationState.Invalid => L.Phone_TryAgainLater,
        ValidationState.CannotSend => _canSendValidationMessage,
        ValidationState.CodeSentRecently => L.Phone_TryAgainInMinutes,
        _ => L.Phone_VerifyToSignIn_Format(CoreConstants.AppName),
    };
    var isDisabled = _validationState is ValidationState.Invalid or ValidationState.Validating or ValidationState.CannotSend;
}

<div class="phone-verifier @Class">
    @if (showVerifier) {
        <TotpVerifier
            @ref="_totpVerifier"
            Purpose="TotpPurpose.VerifyPhone"
            Phone="@Phone"
            Class="c-totp-verifier"
            Verified="Verified"/>
    } else {
        <div class="c-verify">
            <Button Class="btn-outline c-verify-btn" IsDisabled="@isDisabled" Click="OnVerifyPhoneClick">@buttonText</Button>
            <p class="c-description">@description</p>
        </div>

        <CaptchaView />
    }
</div>

@code {
    private TotpVerifier? _totpVerifier;
    private ValidationState _validationState = ValidationState.None;
    private string _canSendValidationMessage = "";

    private ICaptcha Captcha => Hub.Captcha;
    private TotpUI TotpUI => Hub.TotpUI;
    private CaptchaUI CaptchaUI => Hub.CaptchaUI;

    [Parameter, EditorRequired] public Phone Phone { get; set; } = null!;
    [Parameter] public string Class { get; set; } = "";
    [Parameter] public EventCallback Verified { get; set; }

    protected override Task OnInitializedAsync()
        => CaptchaUI.WhenReady;

    protected override void OnParametersSet() {
        _validationState = ValidationState.None;
    }

    private async Task OnVerifyPhoneClick() {
        var hasSentCodeRecently = await TotpUI.HasSentCodeRecently(CancellationToken.None);
        if (hasSentCodeRecently) {
            _validationState = ValidationState.CodeSentRecently;
            StateHasChanged();
            return;
        }

        if (CaptchaUI.IsAvailable) {
            _validationState = ValidationState.Validating;
            StateHasChanged();
            try {
                var captchaToken = await CaptchaUI.GetActionToken(Constants.Recaptcha.Actions.PhoneSignIn, CancellationToken.None);
                var validationResult = await Captcha.Validate(captchaToken, Constants.Recaptcha.Actions.PhoneSignIn, CancellationToken.None);
                _validationState = validationResult.Success
                    ? ValidationState.Valid
                    : ValidationState.Invalid;
                if (_validationState is ValidationState.Valid) {
                    _canSendValidationMessage = await TotpUI.CheckIfBlocked(Phone, TotpPurpose.VerifyPhone, CancellationToken.None);
                    if (!_canSendValidationMessage.IsNullOrEmpty()) {
                        _validationState = ValidationState.CannotSend;
                        UICommander.ShowError(_canSendValidationMessage);
                    }
                }
            }
            catch {
                _validationState = ValidationState.Invalid;
            }
            finally {
                StateHasChanged();
            }
        } else {
            _validationState = ValidationState.Valid;
            _canSendValidationMessage = await TotpUI.CheckIfBlocked(Phone, TotpPurpose.VerifyPhone, CancellationToken.None);
            if (!_canSendValidationMessage.IsNullOrEmpty()) {
                _validationState = ValidationState.CannotSend;
                UICommander.ShowError(_canSendValidationMessage);
            }
            StateHasChanged();
        }

        if (_totpVerifier == null)
            return;

        await _totpVerifier.Focus().AsTask();
    }
}
