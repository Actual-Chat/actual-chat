@implements IDisposable
@using ActualChat.UI.Blazor.Services
@{
    if (_slot != null) {
        _slot.NotifyChanged();
        return;
    }
    if (ContentSwapContext is { IsLayerVisible: false })
        return;

    Register();
}
@code {
    private RenderVar<List<RenderIntoSlot>>? _slot;
    [Inject] private UIHub Hub { get; init; } = null!;
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [CascadingParameter] private ContentSwapContext? ContentSwapContext { get; set; }

    public void Dispose() {
        if (ContentSwapContext is { } swap)
            swap.StateChanged -= OnStateChanged;
        Unregister();
    }

    // Protected/internal methods

    protected override void OnInitialized() {
        if (ContentSwapContext is { } swap)
            swap.StateChanged += OnStateChanged;
    }

    // Private methods

    private void OnStateChanged() {
        if (ContentSwapContext!.IsLayerVisible)
            Register();
        else
            Unregister();
    }

    private void Register() {
        if (_slot != null)
            return;

        _slot = Hub.RenderVars.RenderSlot(Name);
        _slot.Value.Add(this);
        _slot.NotifyChanged();
    }

    private void Unregister() {
        if (_slot == null)
            return;

        var slot = _slot;
        _slot = null;
        if (!slot.Value.Remove(this)) {
            var log = Hub.LogFor(GetType());
            log.LogWarning("Couldn't remove RenderIntoSlot with Name = '{Name}'", Name);
            return;
        }

        slot.NotifyChanged();
    }
}
