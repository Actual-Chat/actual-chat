@using ActualChat.UI.Blazor.Services
@namespace ActualChat.UI.Blazor.Components

@{
    var narrowViewSettings = NarrowViewSettings;
    var narrowViewShouldHideButtons = narrowViewSettings.ShouldHideButtons ?? false;
    var showButtons = ScreenSize.IsWide() || !narrowViewShouldHideButtons;
    var hasFooterContent = Footer != null && Footer != RenderFragments.Null;
    var hasButtons = Buttons != null && showButtons && Buttons != RenderFragments.Null;
    var positionClass = narrowViewSettings.Position == DialogFramePosition.Bottom
        ? "narrow-view__modal__position-bottom"
        : "narrow-view__modal__position-stretch";
    var cls = Class + " " + positionClass + (FullBleed ? " full-bleed" : "");
    var bodyVariantClass = BodyVariant switch {
        BodyVariant.Flush => "body-flush",
        BodyVariant.Tiles => "body-tiles",
        _ => "",
    };
}

<ModalFrame Class="@cls">
    <Header>
        @if (HeaderMode == HeaderMode.Custom) {
            @Header
        }
        else if (HasHeader && HeaderMode != HeaderMode.None) {
            <DialogHeader
                Title="@Title"
                HasCloseButton="@HasCloseButton"
                HideBackButton="@HideHeaderBackButton" />
        }
    </Header>
    <ChildContent>
        <div class="dialog-body @BodyClass @bodyVariantClass">
            @Body
        </div>

        @if (hasFooterContent || hasButtons) {
            <div class="dialog-footer">
                @if (hasFooterContent) {
                    @Footer
                }
                @if (hasButtons) {
                    <div class="dialog-buttons @ButtonsClass">
                        @Buttons
                    </div>
                }
            </div>
        }
    </ChildContent>
</ModalFrame>

@code {
    [CascadingParameter] public ScreenSize ScreenSize { get; set; }

    [Parameter] public string Class { get; set; } = "";
    [Parameter] public string ButtonsClass { get; set; } = "";
    [Parameter] public string BodyClass { get; set; } = "";
    [Parameter] public BodyVariant BodyVariant { get; set; }
    [Parameter] public bool HasHeader { get; set; } = true;
    [Parameter] public bool HideHeaderBackButton { get; set; }
    [Parameter] public HeaderMode HeaderMode { get; set; }
    [Parameter] public RenderFragment? Header { get; set; }
    [Parameter] public bool FullBleed { get; set; }
    [Parameter] public bool HasCloseButton { get; set; }
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public RenderFragment? Body { get; set; }
    [Parameter] public RenderFragment? Footer { get; set; }
    [Parameter] public RenderFragment? Buttons { get; set; }
    [Parameter] public DialogFrameNarrowViewSettings NarrowViewSettings { get; set; } = DialogFrameNarrowViewSettings.Bottom;
}
