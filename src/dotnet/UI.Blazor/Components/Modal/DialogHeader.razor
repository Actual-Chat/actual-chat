@namespace ActualChat.UI.Blazor.Components
@inherits ComponentBase<UIHub>
@{
    var isInnerStep = Modal.Ref.StepRef != null;
}

<div class="modal-header">
    @if (isInnerStep && !HideBackButton) {
        <HeaderButton Click="OnBackClick" Class="btn-header-back">
            <i class="icon-arrow-left"></i>
        </HeaderButton>
    }
    <h3 class="modal-title">@Title</h3>
    @* × only on the start page; on inner steps navigation is Back (footer/arrow), no × clutter. *@
    @if (HasCloseButton && !isInnerStep) {
        <HeaderButton Click="OnCloseClick">
            <i class="icon-close"></i>
        </HeaderButton>
    }
</div>

@code {
    [CascadingParameter] public Modal Modal { get; set; } = null!;
    [Parameter] public bool HasCloseButton { get; set; }
    [Parameter] public bool HideBackButton { get; set; }
    [Parameter] public string Title { get; set; } = "";

    private void OnCloseClick()
        => Modal.Close();

    private void OnBackClick()
        => _ = Modal.StepBack();
}
