@namespace ActualChat.UI.Blazor.Components
@{
    var max = Math.Max(Maximum ?? 0, Items.Count == 0 ? 0 : Items.Max(i => i.Value));
    if (ReferenceValue is not null && max == 0)
        max = 1;
}

<div class="bar-chart @Class">
    @if (ReferenceValue is { } reference && max > 0) {
        <div class="c-reference"
             style="bottom: calc((100% - var(--bar-chart-label-height, 1.25rem)
                 - var(--bar-chart-value-height, 0rem)) * @Math.Clamp(reference / max, 0, 1).ToString("F4", null)
                 + var(--bar-chart-label-height, 1.25rem))"></div>
    }
    @foreach (var item in Items) {
        @if (ItemClick.HasDelegate) {
            <button type="button" class="c-column btn-chart-item" aria-label="@item.Hint"
                    @onclick="@(() => ItemClick.InvokeAsync(item))">
                @Column(item, max)
            </button>
        } else {
            <div class="c-column">@Column(item, max)</div>
        }
    }
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<ChartItem> Items { get; set; } = [];
    [Parameter] public string Class { get; set; } = "";
    [Parameter] public string ValueFormat { get; set; } = "F0";
    [Parameter] public double? ReferenceValue { get; set; }
    [Parameter] public bool ShowValues { get; set; }
    [Parameter] public bool ShowZeroValues { get; set; }
    [Parameter] public double? Maximum { get; set; }
    [Parameter] public EventCallback<ChartItem> ItemClick { get; set; }

    private RenderFragment Column(ChartItem item, double max) => @<text>
        @if (item.HasGap) {
            <span class="c-gap" aria-hidden="true">⋯</span>
        }
        <div class="c-bar-track"
             style="--bar-height: @((max > 0 ? item.Value / max * 100 : 0).ToString("F4", null))%">
            @if (ShowValues && (ShowZeroValues || item.Value > 0)) {
                <div class="c-value">@item.Value.ToString(ValueFormat, null)</div>
            }
            <div class="c-bar @item.Class"
                 style="height: @((max > 0 ? item.Value / max * 100 : 0).ToString("F0", null))%"
                 title="@(item.Hint ?? item.Value.ToString(ValueFormat, null))"></div>
        </div>
        <div class="c-label">@item.Label</div>
    </text>;
}
