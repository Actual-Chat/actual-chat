@using ActualChat.Chat
@namespace ActualChat.UI.Blazor.Components
@{
    var urls = GetUrls();
    var originalUrl = urls.OriginalUrl;
    var thumbnailUrl = urls.ThumbnailUrl;
}
<div class="video-thumbnail @Class" data-width="@Attachment.Media.Width" data-height="@Attachment.Media.Height">
    @if (Attachment.ThumbnailMedia is null) {
        // OBSOLETE 2023.11: For backward compatibility for old videos. Probably convert in background.
        <video preload="metadata">
            <source src="@originalUrl#t=0.5" />
        </video>
    } else {
        <image-skeleton src="@thumbnailUrl" isVideo="true" class="show-image-skeleton" />
    }
    <div class="c-overlay">
        <i class="c-play icon-play-fill"></i>
    </div>
</div>
@code {
    [Inject] private UrlMapper UrlMapper { get; init; } = null!;

    [Parameter] public TextEntryAttachment Attachment { get; set; } = null!;
    [Parameter] public string Class { get; set; } = "";

    private (string OriginalUrl, string ThumbnailUrl) GetUrls()
    {
        if (Attachment.ThumbnailMedia is not {} thumbnail)
            // OBSOLETE 2023.11: For backward compatibility for old videos. Probably convert in background.
            return (UrlMapper.ContentUrl(Attachment.Media.ContentId), UrlMapper.ContentUrl(Attachment.Media.ContentId));

        var contentUrl = UrlMapper.ContentUrl(thumbnail.ContentId);
        var originalUrl = UrlMapper.ImagePreviewUrl(contentUrl, null, (int?)Constants.Attachments.MaxActualResolution.Y);
        var thumbnailUrl = UrlMapper.ImagePreviewUrl(contentUrl, null, (int?)Constants.Attachments.MaxActualThumbnailResolution.Y);
        return (originalUrl, thumbnailUrl);
    }
}
