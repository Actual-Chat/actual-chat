@namespace ActualChat.UI.Blazor.Components
@using ActualChat.UI.Blazor.Module
@implements IAsyncDisposable
@inherits FusionComponentBase<UIHub>

<div @ref="_ref"
     class="@Class copy-trigger"
     data-tooltip="@Tooltip"
     data-toooltip-position="@FloatingPosition.Top">
    @ChildContent
</div>

@code {
    private static readonly string JSCreateMethod = $"{BlazorUICoreModule.ImportName}.CopyTrigger.create";

    private ElementReference _ref;
    private Task<IJSObjectReference>? _jsRefTask;
    private string _lastCopyText = "";

    [Parameter] public string Class { get; set; } = "";
    [Parameter] public string Tooltip { get; set; } = "Copy";
    [Parameter] public string CopyText { get; set; } = "";
    [Parameter] public ElementReference? CopyTextSourceRef { get; set; }
    [Parameter] public string CopyTextFormatString { get; set; } = "";
    [Parameter] public RenderFragment? ChildContent { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (firstRender) {
            // Store the in-flight task so a re-render triggered by the parent
            // (e.g. AddMemberModalPage.OnInitializedAsync) can await it instead
            // of dereferencing a not-yet-assigned IJSObjectReference — see #3864.
            _jsRefTask = JS.InvokeAsync<IJSObjectReference>(
                JSCreateMethod,
                _ref, CopyText, Tooltip, CopyTextSourceRef, CopyTextFormatString).AsTask();
            await _jsRefTask;
            _lastCopyText = CopyText;
        } else if (CopyText != _lastCopyText && _jsRefTask is not null) {
            _lastCopyText = CopyText;
            var jsRef = await _jsRefTask;
            await jsRef.InvokeVoidAsync("setCopyText", CopyText);
        }
    }

    public async ValueTask DisposeAsync() {
        var task = _jsRefTask;
        _jsRefTask = null;
        if (task is null)
            return;
        IJSObjectReference? jsRef = null;
        try { jsRef = await task; }
        catch { /* Intended: JS init may have failed; nothing to dispose. */ }
        await jsRef.DisposeSilentlyAsync("dispose");
    }
}
