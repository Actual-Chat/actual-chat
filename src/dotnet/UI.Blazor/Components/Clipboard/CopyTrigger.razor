@namespace ActualChat.UI.Blazor.Components
@using ActualChat.UI.Blazor.Module
@implements IAsyncDisposable
@inherits FusionComponentBase<UIHub>

<div @ref="_ref"
     class="@Class copy-trigger"
     data-tooltip="@Tooltip"
     data-toooltip-position="@FloatingPosition.Top">
    @ChildContent
</div>

@code {
    private static readonly string JSCreateMethod = $"{BlazorUICoreModule.ImportName}.CopyTrigger.create";

    private ElementReference _ref;
    private IJSObjectReference? _jsRef;
    private readonly AsyncTaskMethodBuilder _whenFirstRender = AsyncTaskMethodBuilderExt.New();
    private string _lastCopyText = "";

    [Parameter] public string Class { get; set; } = "";
    [Parameter] public string Tooltip { get; set; } = "Copy";
    [Parameter] public string CopyText { get; set; } = "";
    [Parameter] public ElementReference? CopyTextSourceRef { get; set; }
    [Parameter] public string CopyTextFormatString { get; set; } = "";
    [Parameter] public RenderFragment? ChildContent { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (firstRender) {
            try {
                _jsRef = await JS.InvokeAsync<IJSObjectReference>(
                    JSCreateMethod,
                    _ref, CopyText, Tooltip, CopyTextSourceRef, CopyTextFormatString);
                _lastCopyText = CopyText;
            }
            finally {
                _whenFirstRender.TrySetResult();
            }
        } else if (CopyText != _lastCopyText) {
            _lastCopyText = CopyText;
            // Re-renders can fire before first-render's JS init completes — wait for it
            // so we don't dereference a null IJSObjectReference (see #3864).
            await _whenFirstRender.Task;
            if (_jsRef is not null)
                await _jsRef.InvokeVoidAsync("setCopyText", CopyText);
        }
    }

    public async ValueTask DisposeAsync() {
        // Unblock anyone still awaiting first-render if dispose races init.
        _whenFirstRender.TrySetResult();
        await _jsRef.DisposeSilentlyAsync("dispose");
        _jsRef = null;
    }
}
