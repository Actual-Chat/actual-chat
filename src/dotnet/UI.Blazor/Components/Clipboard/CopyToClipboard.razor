@namespace ActualChat.UI.Blazor.Components

<div class="copy-to-clipboard">
    @if (ShowInput) {
        <input
            @ref="_inputRef"
            readonly="readonly"
            class="@InputClass flex-1"
            type="text"
            value="@(Caption.NullIfEmpty() ?? Text)"/>
    }

    <CopyTrigger Tooltip="@Tooltip" CopyText="@Text" CopyTextSourceRef="@CopyTextSourceRef" CopyTextFormatString="@CopyTextFormatString">
        <CopyButton Class="@ButtonClass" IsSquare="@IsSquare" />
    </CopyTrigger>
</div>

@code {
    private ElementReference _inputRef;

    [Parameter] public string Class { get; set; } = "";
    [Parameter] public string ButtonClass { get; set; } = "";
    [Parameter] public bool IsSquare { get; set; }
    [Parameter] public string InputClass { get; set; } = "";
    [Parameter] public string Tooltip { get; set; } = "Copy";
    [Parameter] public bool ShowInput { get; set; }
    [Parameter] public string Caption { get; set; } = "";
    [Parameter, EditorRequired] public string Text { get; set; } = "";
    [Parameter] public ElementReference? CopyTextSourceRef { get; set; }
    [Parameter] public string CopyTextFormatString { get; set; } = "";
}
