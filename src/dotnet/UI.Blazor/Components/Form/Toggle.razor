@using ActualChat.UI.Blazor.Services
@implements IDisposable
@namespace ActualChat.UI.Blazor.Components

<label class="@Class toggle"
       role="switch"
       aria-checked="@_localValue.ToString().ToLower()"
       data-input-checked="@_localValue"
       data-input-disabled="@IsDisabled">
    <input type="checkbox"
           id="@Id"
           disabled="@IsDisabled"
           checked="@_localValue"
           @onchange="@OnChange"/>
    <span class="dash"><span class="o">&nbsp;</span></span>
    @if (LabelContent != null) {
        <div class="c-label">@LabelContent</div>
    } else if (!Label.IsNullOrEmpty()) {
        <div class="c-label"><span class="c-text">@Label</span></div>
    }
</label>

@code {
    private bool _localValue;
    private bool? _previousConfirmedValue;
    private CancellationTokenSource? _cts;

    [Inject] private UIHub Hub { get; init; } = null!;
    private TuneUI TuneUI => Hub.TuneUI;

    [Parameter] public string Id { get; set; } = "";
    [Parameter] public string Class { get; set; } = "";
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public RenderFragment? LabelContent { get; set; }
    [Parameter] public bool IsDisabled { get; set; }
    [Parameter] public bool IsChecked { get; set; }
    [Parameter] public EventCallback<bool> IsCheckedChanged { get; set; }

    protected override void OnParametersSet() {
        if (_previousConfirmedValue is null) {
            _previousConfirmedValue = IsChecked;
        } else if (_previousConfirmedValue != IsChecked) {
            _previousConfirmedValue = IsChecked;
            _ = TuneUI.Play(Tune.ChangeToggle);
        }

        _localValue = IsChecked;
    }

    private async Task OnChange(ChangeEventArgs eventArgs) {
        var newValue = eventArgs.Value is bool b ? b : eventArgs.Value?.ToString() == "true";

        if (_cts is not null) {
            await _cts.CancelAsync();
            _cts.Dispose();
        }
        _cts = new CancellationTokenSource();
        var token = _cts.Token;

        _localValue = newValue;
        StateHasChanged();

        await IsCheckedChanged.InvokeAsync(newValue);

        try {
            await Task.Delay(2000, token);

            if (IsChecked != _localValue) {
                _localValue = IsChecked;
                StateHasChanged();
            }
        }
        catch (TaskCanceledException) {
            throw new TaskCanceledException();
        }
    }

    public void Dispose() {
        _cts?.Cancel();
        _cts?.Dispose();
    }
}
