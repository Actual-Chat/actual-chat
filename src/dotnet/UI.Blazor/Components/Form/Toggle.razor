@using ActualLab.Locking
@using ActualChat.UI.Blazor.Services
@namespace ActualChat.UI.Blazor.Components

@* stopPropagation on the label, not just the input: the tap lands on the knob span, and while
   the label's default behavior activates the checkbox (change fires), the original click still
   bubbles to an enclosing clickable row - double-toggling the setting. *@
<label @ref="_labelRef"
       class="@Class toggle"
       role="switch"
       aria-checked="@_isChecked.ToString().ToLower()"
       data-input-checked="@_isChecked"
       data-input-disabled="@IsDisabled"
       @onclick:stopPropagation="true">
    <input type="checkbox"
           id="@Id"
           disabled="@IsDisabled"
           checked="@_isChecked"
           @onclick:stopPropagation="true"
           @onchange="@OnChange"/>
    <span class="dash"><span class="o">&nbsp;</span></span>
    @if (LabelContent != null) {
        <div class="c-label">@LabelContent</div>
    } else if (!Label.IsNullOrEmpty()) {
        <div class="c-label"><span class="c-text">@Label</span></div>
    }
</label>

@code {
    private bool _isChecked;
    private ElementReference _labelRef;
    private bool _isRendered;
    private readonly AsyncLock _lock = new (LockReentryMode.CheckedFail);

    [Inject] private UIHub Hub { get; init; } = null!;
    private TuneUI TuneUI => Hub.TuneUI;

    [Parameter] public string Id { get; set; } = "";
    [Parameter] public string Class { get; set; } = "";
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public RenderFragment? LabelContent { get; set; }
    [Parameter] public bool IsDisabled { get; set; }
    [Parameter] public bool IsChecked { get; set; }
    [Parameter] public EventCallback<bool> IsCheckedChanged { get; set; }
    // Fires once with the label element, for callers that must attach a JS listener to it -
    // a browser permission prompt only runs from a native click handler, not from @onchange.
    [Parameter] public EventCallback<ElementReference> Rendered { get; set; }

    protected override void OnParametersSet()
        => _isChecked = IsChecked;

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (_isRendered || !Rendered.HasDelegate)
            return;

        _isRendered = true;
        await Rendered.InvokeAsync(_labelRef);
    }

    private async Task OnChange(ChangeEventArgs eventArgs) {
        // just avoiding concurrent click handling
        using var _1 = await _lock.Lock();
        _ = TuneUI.Play(Tune.ChangeToggle);
        var newValue = eventArgs.Value is bool b ? b : eventArgs.Value?.ToString() == "true";
        _isChecked = newValue;
        StateHasChanged();

        await IsCheckedChanged.InvokeAsync(newValue);
    }
}
