@namespace ActualChat.UI.Blazor.Components
@using System.ComponentModel.DataAnnotations
@using System.Linq.Expressions
@typeparam TValue
@inherits ComponentBase
@implements IDisposable
@{
    var isInvalid = false;
    IEnumerable<string> messages = [];
    if (ShowErrors) {
        messages = CurrentEditContext.GetValidationMessages(_fieldIdentifier).ToList();
        isInvalid = messages.Any();
    }
    var cls = Class;
    if (isInvalid) {
        cls += " invalid";
    }
}

<section data-control-id="@InputId" class="form-section @cls">
    @if (!IsLabelInsideInput) {
        @if (!Label.IsNullOrEmpty()) {
            <div class="@LabelClass form-section-label">
                <Label InputId="@InputId" Text="@Label" IsRequired="@ComputedIsRequired"></Label>
            </div>
        }
        <div class="@ContentClass form-section-content">
            @ChildContent
        </div>
    } else {
        <div class="@ContentClass form-section-content label-inside-input">
            <div class="c-left">
                @if (!Label.IsNullOrEmpty()) {
                    <div class="@LabelClass form-section-label">
                        <Label InputId="@InputId" Text="@Label" IsRequired="@ComputedIsRequired" Class="internal-label"></Label>
                    </div>
                }
                @ChildContent
            </div>
            @Right
        </div>
    }
    @if (ValidationMessage is not null) {
        @ValidationMessage(Label)
    }
    else @if (!HideValidationMessage) {
        var validationCls = isInvalid ? "invalid" : "";
        <div class="form-section-validation @validationCls">
            @if (isInvalid) {
                <LocalizedMessage Text="@messages.First()" FieldLabel="@Label"/>
            }
        </div>
    }
</section>

@code {
    private readonly EventHandler<ValidationStateChangedEventArgs>? _validationStateChangedHandler;
    private EditContext? _previousEditContext;
    private Expression<Func<TValue>>? _previousFieldAccessor;
    private FieldIdentifier _fieldIdentifier;

    private bool ComputedIsRequired { get; set; }

    public FormSection()
        => _validationStateChangedHandler = (_, _) => StateHasChanged();

    [CascadingParameter] EditContext CurrentEditContext { get; set; } = default!;

    [Parameter] public string Class { get; set; } = "";
    [Parameter] public string LabelClass { get; set; } = "";
    [Parameter] public string ContentClass { get; set; } = "";
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string InputId { get; set; } = "";
    [Parameter] public bool? IsRequired { get; set; }
    [Parameter] public bool IsLabelInsideInput { get; set; }
    [Parameter] public bool ShowErrors { get; set; } = true;
    [Parameter] public bool HideValidationMessage { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Right { get; set; }
    [Parameter] public RenderFragment<string>? ValidationMessage { get; set; }
    [Parameter] public Expression<Func<TValue>>? For { get; set; }

    protected override void OnParametersSet() {
        if (CurrentEditContext == null)
            throw StandardError.Internal(
                $"{GetType()} requires a cascading parameter " +
                $"of type {nameof(EditContext)}. For example, you can use {GetType()} inside " +
                $"an {nameof(EditForm)}.");

        if (For == null)
            throw StandardError.Internal($"{GetType()} requires a value for the {nameof(For)} parameter.");

        if (For != _previousFieldAccessor) {
            _fieldIdentifier = FieldIdentifier.Create(For);
            _previousFieldAccessor = For;
        }

        if (CurrentEditContext != _previousEditContext) {
            DetachValidationStateChangedListener();
            CurrentEditContext.OnValidationStateChanged += _validationStateChangedHandler;
            _previousEditContext = CurrentEditContext;
        }

        if (IsRequired.HasValue) {
            ComputedIsRequired = IsRequired.Value;
        } else {
            var expression = For.Body as MemberExpression
                             ?? (For.Body as UnaryExpression)?.Operand as MemberExpression;

            if (expression?.Member is PropertyInfo propInfo) {
                ComputedIsRequired = propInfo.IsDefined(typeof(RequiredAttribute), inherit: true);
            } else {
                ComputedIsRequired = false;
            }
        }
    }

    void IDisposable.Dispose() {
        DetachValidationStateChangedListener();
    }

    private void DetachValidationStateChangedListener() {
        if (_previousEditContext != null) {
            _previousEditContext.OnValidationStateChanged -= _validationStateChangedHandler;
        }
    }
}
