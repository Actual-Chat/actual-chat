@using ActualChat.UI.Blazor.Module
@using ActualChat.UI.Blazor.Services
@using ActualChat.Media
@inherits ComponentBase<UIHub>
@implements IAsyncDisposable

<input @ref="InputRef" type="file" @attributes="InputAttributes"/>

@code {
    private static readonly string JSCreateMethod = $"{BlazorUICoreModule.ImportName}.FileUpload.create";

    private FileUploader FileUploader => field ??= Services.GetRequiredService<FileUploader>();

    private ElementReference InputRef { get; set; }
    private DotNetObjectReference<FileUpload> BlazorRef { get; set; } = null!;
    private IJSObjectReference JSRef { get; set; } = null!;

    [Parameter, EditorRequired] public string Scope { get; set; } = "";
    [Parameter] public int? MaxSize { get; set; }
    [Parameter] public EventCallback<MediaContent> Uploaded { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object> InputAttributes { get; set; } = new();

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (!firstRender)
            return;

        BlazorRef = DotNetObjectReference.Create(this);
        JSRef = await JS.InvokeAsync<IJSObjectReference>(JSCreateMethod, InputRef, BlazorRef);
    }

    public async ValueTask DisposeAsync() {
        await JSRef.DisposeSilentlyAsync("dispose");
        JSRef = null!;
        BlazorRef.DisposeSilently();
        BlazorRef = null!;
    }

    [JSInvokable]
    public async Task FileSelected(string fileName, string contentType, long size)
    {
        if (MaxSize.HasValue && size > MaxSize.Value) {
            var sizeStr = FileSizeFormatter.Format(MaxSize.Value);
            UICommander.ShowError(StandardError.Constraint($"File is too big. Max file size: {sizeStr}."));
            await ClearSelection();
            return;
        }

        WebFileUploaderBackend? uploaderBackend = null;
        try {
            // Reserve MediaId
            var mediaId = await UICommander.Call(new Medias_ReserveMedia(Session, Scope));

            // Create Upload
            var tag = $"FileUpload/v1/{Scope}";
            var metadata = new PropertyBag()
                .Set("FileName", fileName)
                .Set("ContentType", contentType);
            var uploadId = await UICommander.Call(new Uploads_Create(Session, size, tag, metadata));

            var webUploadStreamSource = new WebUploadStreamSource(JSRef);
            await FileUploader.Upload(webUploadStreamSource, uploadId, null, CancellationToken.None);

            // Process upload
            var mediaContent = await UICommander.Call(new Medias_ProcessUpload(Session, mediaId, uploadId));
            await Uploaded.InvokeAsync(mediaContent);
        }
        catch (Exception e) {
            UICommander.ShowError(e);
        }
        finally {
            uploaderBackend?.DisposeSilently();
            await ClearSelection();
        }
    }

    private async Task ClearSelection()
        => await JSRef.InvokeVoidAsync("clear");
}
