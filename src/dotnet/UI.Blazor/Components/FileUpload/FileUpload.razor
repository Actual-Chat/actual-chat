@using ActualChat.UI.Blazor.Services
@using ActualChat.UI.Services
@using ActualChat.Media
@inherits ComponentBase<UIHub>

<FileUploadPicker @ref="_picker" FileSelected="OnFileSelected" @attributes="InputAttributes"/>

@code {
    private FileUploader FileUploader => field ??= Services.GetRequiredService<FileUploader>();

    private FileUploadPicker _picker = null!;

    [Parameter, EditorRequired] public string Scope { get; set; } = "";
    [Parameter] public MediaKind MediaKind { get; set; }
    [Parameter] public int? MaxSize { get; set; }
    [Parameter] public EventCallback<MediaRef> Uploaded { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object> InputAttributes { get; set; } = new();

    private async Task OnFileSelected(UploadSource source) {
        try {
            if (MaxSize is { } maxSize && source.Metadata.Length > maxSize) {
                UICommander.ShowError(StandardError.Upload.FileTooBig(maxSize));
                return;
            }

            // Reserve MediaId
            var mediaId = await UICommander.Call(new Media_ReserveMedia(Session, Scope) { Kind = MediaKind });

            // Create Upload
            var tag = $"FileUpload/v1/{Scope}";
            var metadata = new MetadataBag()
                .Set("FileName", source.Metadata.FileName.Value)
                .Set("ContentType", source.Metadata.ContentType);
            var uploadId = await UICommander.Call(new Uploads_Create(Session, source.Metadata.Length, tag, metadata));

            await FileUploader.Upload(source.StreamSource, uploadId, null, CancellationToken.None);

            // Process upload
            var mediaRef = await UICommander.Call(new Media_ProcessUpload(Session, mediaId, uploadId));
            await Uploaded.InvokeAsync(mediaRef);
        }
        catch (Exception e) {
            UICommander.ShowError(e);
        }
        finally {
            await _picker.ClearSelection();
        }
    }
}
