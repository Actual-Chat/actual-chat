@namespace ActualChat.UI.Blazor.Components
@using ActualChat.Users
@inherits FusionComponentBase<UIHub>
@{
    var showBio = Avatar != null && ShowBio && !Avatar.Bio.IsNullOrEmpty();
    var isStatusTextExist = !StatusText.IsNullOrEmpty();
    var isStatusContentExist = StatusContent != null;
}

<div class="avatar-badge @Class" @onclick="@Click">
    <AvatarCircle
        Avatar="@Avatar"
        Size="@Size"
        BadgeContent="@BadgeContent" />
    <div class="c-content">
        <div class="c-top">
            <div class="c-name">
                <AvatarName Avatar="@Avatar" Class="@NameClass"/>
            </div>
            @if (showBio) {
                @if (isStatusTextExist) {
                    <span class="c-status">@StatusText</span>
                } else if (isStatusContentExist) {
                    <span class="c-status">@StatusContent</span>
                }
            }
        </div>
        @if (showBio || isStatusTextExist || isStatusContentExist) {
            <div class="c-bottom">
                @if (!showBio) {
                    @if (isStatusTextExist) {
                        <span class="c-status">@StatusText</span>
                    } else if (isStatusContentExist) {
                        <span class="c-status">@StatusContent</span>
                    }
                } else {
                    <div class="c-bio">
                        @Avatar!.Bio
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public Avatar? Avatar { get; set; }
    [Parameter] public RenderFragment? BadgeContent { get; set; }
    [Parameter] public RenderFragment? StatusContent { get; set; }
    [Parameter] public SquareSize Size { get; set; } = SquareSize.Size10;
    [Parameter] public string NameClass { get; set; } = "";
    [Parameter] public string Class { get; set; } = "";
    [Parameter] public string? StatusText { get; set; }
    [Parameter] public bool ShowBio { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> Click { get; set; }
}
