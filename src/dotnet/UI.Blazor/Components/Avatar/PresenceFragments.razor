@using ActualChat.Users
@namespace ActualChat.UI.Blazor.Components

@* ReSharper disable once InconsistentNaming *@
@code {
    @* '__builder' is predefined name used by RazorSourceGenerator *@
    public static RenderFragment<Presence> PresenceIndicator = presence => __builder =>
    {
        if (presence is Presence.Unknown or Presence.Offline)
            return;

        var cls = presence switch {
            Presence.Online => "bg-online",
            Presence.Away => "bg-away",
            Presence.Recording => "bg-danger animate-pulse",
            _ => "",
        };

        <div class="presence-indicator">
            <div class="@cls c-dot"></div>
        </div>
    };

    @* Both fragments render per chat entry, so they stay fragments rather than components
       (#2450): no instance, no parameter diff, no lifecycle. That is also why the localizer
       is passed in - a fragment has no way to resolve one. *@
    @* '__builder' is predefined name used by RazorSourceGenerator *@
    public static RenderFragment<(Presence, Moment?, bool, IStringLocalizer)> PresenceText = tuple => __builder => {
        var (presence, lastCheckIn, isShort, l) = tuple;
        @switch (presence)
        {
            case Presence.Online:
                @l.Presence_Online
                break;
            case Presence.Recording:
                @(isShort ? l.Presence_SpeakingShort : l.Presence_Speaking)
                break;
            case Presence.Away or Presence.Offline:
                @if (lastCheckIn == null) {
                    @l.Presence_Offline
                } else if (isShort) {
                    <LiveTimeDeltaText Moment="@lastCheckIn" NullText="" IsCapitalized="true"/>
                } else {
                    @l.Presence_LastSeen_Prefix<LiveTimeDeltaText Moment="@lastCheckIn" NullText=""/>
                    @l.Presence_LastSeen_Suffix
                }
                break;
            case Presence.Unknown:
            default:
                @(isShort ? "" : "...")
                break;
        }
    };
}
