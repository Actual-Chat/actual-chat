@namespace ActualChat.UI.Blazor.Components

<div class="wide-left-panel-skeleton">
    <PanelHeaderSkeleton>
        <div class="c-title">
            <string-skeleton firstWidth="3" secondWidth="7"/>
        </div>
        <div class="c-content"></div>
    </PanelHeaderSkeleton>
    <PanelBodySkeleton>
        <tab-skeleton/>
        <chat-list-skeleton count="12"></chat-list-skeleton>
    </PanelBodySkeleton>
    @ChildContent
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
