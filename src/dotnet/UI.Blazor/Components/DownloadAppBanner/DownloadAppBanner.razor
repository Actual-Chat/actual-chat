@namespace ActualChat.UI.Blazor.Components
@using ActualChat.Hosting
@using ActualChat.Kvas
@using ActualChat.UI.Blazor.Services
@inherits ComputedStateComponent<UIHub, DownloadAppBanner.BannerMode>
@{
    var mode = State.Value;
    if (mode == BannerMode.Hidden)
        return;

    var isUpdate = mode == BannerMode.Update;
    var title = mode switch {
        BannerMode.Update => L.AppUpdate_Banner_Format(CoreConstants.AppName),
        BannerMode.Open => L.Download_OpenAppBanner_Format(CoreConstants.AppName),
        _ => L.Download_GetAppBanner_Format(CoreConstants.AppName),
    };
    var icon = mode switch {
        BannerMode.Update => "icon-refresh",
        BannerMode.Open => "icon-external-link",
        _ => "icon-download",
    };
}

<div class="download-app-banner">
    <div
        class="download-app-banner-button"
        @onclick="@OnClick">
        <div class="download-app-banner-filler"></div>
        <div class="download-app-banner-title">
            @title
        </div>
        <i class="@icon"></i>
        <div class="download-app-banner-filler"></div>
        @if (CanBeClosed && !isUpdate) {
            <HeaderButton
                Click="@OnClose"
                PreventDefault="@true"
                StopPropagation="@true"
                Class="c-close-btn">
                <i class="icon-close"></i>
            </HeaderButton>
        }
    </div>
</div>

@code {
    private StoredState<Box<bool>> _isDismissed = null!;
    private AppUpdateUI AppUpdateUI => Hub.AppUpdateUI;
    [Parameter] public bool CanBeClosed { get; set; } = true;

    protected override void OnInitialized()
        => _isDismissed = StateFactory.NewKvasStored<Box<bool>>(
            new(LocalSettings, "DownloadAppBanner.IsDismissed") {
                InitialValue = Box.New(false),
            });

    private Task OnClick() {
        var mode = State.Value;
        if (mode == BannerMode.Update)
            return AppUpdateUI.Update();
        if (mode == BannerMode.Open)
            return AppUpdateUI.OpenApp();

        ModalUI.Show(new DownloadAppModal.Model());
        return Task.CompletedTask;
    }

    private void OnClose()
        => _isDismissed.Value = Box.New(true);

    protected override ComputedState<BannerMode>.Options GetStateOptions()
        => new() {
            InitialValue = BannerMode.Hidden, // We don't want to show & hide it every time
            Category = GetStateCategory(GetType()),
        };

    protected override async Task<BannerMode> ComputeState(CancellationToken cancellationToken) {
        // An update wins over everything: it shows on every host, ignores the dismissal flag,
        // and has no close button, because a client that's behind is the problem here.
        var update = await AppUpdateUI.GetAvailableUpdate(cancellationToken).ConfigureAwait(false);
        if (update is not null)
            return BannerMode.Update;

        if (HostInfo.HostKind == HostKind.MauiApp && (HostInfo.AppKind.IsMobile() || CanBeClosed))
            return BannerMode.Hidden; // No banner on mobile + only non-closable banner (in SettingsPanel) on Windows

        // Open follows the same visibility rules as Install - it's still the same banner, just
        // pointing at an app that's already there rather than at the store.
        var isAppInstalled = await AppUpdateUI.IsAppInstalled(cancellationToken).ConfigureAwait(false);
        var mode = isAppInstalled ? BannerMode.Open : BannerMode.Install;
        if (!CanBeClosed)
            return mode;

        await _isDismissed.WhenRead.ConfigureAwait(false);
        var box = await _isDismissed.Use(cancellationToken).ConfigureAwait(false);
        return box.Value ? BannerMode.Hidden : mode;
    }

    // Nested types

    public enum BannerMode {
        Hidden = 0,
        Install,
        Open,
        Update,
    }
}
