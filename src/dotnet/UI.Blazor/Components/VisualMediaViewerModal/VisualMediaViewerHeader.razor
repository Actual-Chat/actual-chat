@using ActualChat.Chat
@using ActualChat.Hosting
@using ActualChat.Media
@using ActualChat.UI.Blazor.Services
@namespace ActualChat.UI.Blazor.Components
@{
    var canSave = MediaTypeExt.IsSupportedVisualMedia(ContentType) && !MediaTypeExt.IsSvg(ContentType);
}

<div class="image-viewer-header">
    @if (ChatEntry != null && _author != null) {
        <HeaderButton Class="mobile bleached" Click="CloseClick">
            <i class="icon-close"></i>
        </HeaderButton>
        <div class="c-author">
            <AvatarCircle
                Avatar="@_author.Avatar"
                Size="SquareSize.Size10"/>
            <div class="c-content">
                <AvatarName Avatar="@_author.Avatar" Class="c-name"/>
                <LiveTimeDeltaText Class="c-time" Moment="@ChatEntry.BeginsAt"/>
            </div>
        </div>
    }
    <div class="c-control-panel">
        @if (_enableIncompleteUI) {
            <HeaderButton
                Class="bleached"
                Tooltip="Share"
                TooltipPosition="FloatingPosition.Bottom">
                <i class="icon-share"></i>
            </HeaderButton>
        }
        @if (!DownloadUrl.IsNullOrEmpty()) {
            if (SaveMediaActionHandler != null && canSave) {
                <a href="#" download class="c-link" @onclick="@SaveMediaActionHandler.Execute" @onclick:preventDefault>
                    <HeaderButton
                        Class="bleached"
                        IsDisabled="@SaveMediaActionHandler.IsBusy"
                        Tooltip="Download"
                        TooltipPosition="FloatingPosition.Bottom">
                        <i class="icon-download"></i>
                    </HeaderButton>
                </a>
            } else {
                <a href="@DownloadUrl" target="_blank" download class="c-link">
                    <HeaderButton
                        Class="bleached"
                        Tooltip="Download"
                        TooltipPosition="FloatingPosition.Bottom">
                        <i class="icon-download"></i>
                    </HeaderButton>
                </a>
            }
        }
        <HeaderButton
            Class="desktop bleached"
            Tooltip="Close"
            TooltipPosition="FloatingPosition.Bottom"
            Click="CloseClick">
            <i class="icon-close"></i>
        </HeaderButton>
    </div>
</div>

@code {
    private Author? _author;
    private bool _enableIncompleteUI;

    [Inject] private UIHub Hub { get; init; } = null!;
    private HostInfo HostInfo => Hub.HostInfo;
    private Session Session => Hub.Session;
    private Features Features => Hub.Features;
    [field: AllowNull, MaybeNull]
    private IAuthors Authors => field ??= Hub.Services.GetRequiredService<IAuthors>();
    private IUIActionHandler? SaveMediaActionHandler { get; set; }

    [Parameter] public ChatEntry? ChatEntry { get; set; }
    [Parameter] public EventCallback CloseClick { set; get; }
    [Parameter] public string DownloadUrl { set; get; } = "";
    [Parameter] public string ContentType { set; get; } = "";

    protected override async Task OnInitializedAsync() {
        var saver = Hub.Services.GetService<IMediaSaver>();
        if (saver != null) {
            SaveMediaActionHandler = UIActionHandler.Create(
                this,
                () => saver.Save(DownloadUrl, ContentType));
        }
        _enableIncompleteUI = await Features.IsIncompleteUIEnabled(CancellationToken.None);
    }

    protected override async Task OnParametersSetAsync() {
        if (ChatEntry != null)
            _author = await Authors.Get(Session, ChatEntry.ChatId, ChatEntry.AuthorId, CancellationToken.None).ConfigureAwait(false);
    }
}
