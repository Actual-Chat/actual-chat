@using ActualChat.Chat
@using ActualChat.Hosting
@using ActualChat.Media
@using ActualChat.UI.Blazor.Services
@namespace ActualChat.UI.Blazor.Components
@{
    var canSave = MediaTypeExt.IsSupportedVisualMedia(ContentType) && !MediaTypeExt.IsSvg(ContentType);
}

<div class="image-viewer-header">
    @if (_chatEntry != null && _author != null) {
        <HeaderButton Class="mobile bleached" Click="CloseClick">
            <i class="icon-close"></i>
        </HeaderButton>
        <div class="c-author">
            <AvatarCircle
                Avatar="@_author.Avatar"
                Size="SquareSize.Size10"/>
            <div class="c-content">
                <AvatarName Avatar="@_author.Avatar" Class="c-name"/>
                <LiveTimeDeltaText Class="c-time" Moment="@_chatEntry.BeginsAt"/>
            </div>
        </div>
    }
    <div class="c-control-panel">
        @if (_mediaShareUI != null && Attachment != null) {
            <HeaderButton
                Click="OnShareClick"
                Class="bleached"
                Tooltip="Share"
                TooltipPosition="FloatingPosition.Bottom">
                <i class="icon-share"></i>
            </HeaderButton>
        }
        <HeaderButton
            Click="OnInfoClick"
            Class="desktop bleached"
            Tooltip="Info"
            TooltipPosition="FloatingPosition.Bottom">
            <i class="icon-info"></i>
        </HeaderButton>
        @if (!DownloadUrl.IsNullOrEmpty()) {
            if (SaveMediaActionHandler != null && canSave) {
                <a href="#" download class="c-link" @onclick="@SaveMediaActionHandler.Execute" @onclick:preventDefault>
                    <HeaderButton
                        Class="bleached"
                        IsDisabled="@SaveMediaActionHandler.IsBusy"
                        Tooltip="Download"
                        TooltipPosition="FloatingPosition.Bottom">
                        <i class="icon-download"></i>
                    </HeaderButton>
                </a>
            } else {
                <a href="@DownloadUrl" target="_blank" download class="c-link">
                    <HeaderButton
                        Class="bleached"
                        Tooltip="Download"
                        TooltipPosition="FloatingPosition.Bottom">
                        <i class="icon-download"></i>
                    </HeaderButton>
                </a>
            }
        }
        <HeaderButton
            Class="desktop bleached"
            Tooltip="Close"
            TooltipPosition="FloatingPosition.Bottom"
            Click="CloseClick">
            <i class="icon-close"></i>
        </HeaderButton>
    </div>
</div>

@code {
    private ChatEntry? _chatEntry;
    private Author? _author;
    private IMediaShareUI? _mediaShareUI;

    [Inject] private UIHub Hub { get; init; } = null!;
    private Session Session => Hub.Session;
    private ModalUI ModalUI => Hub.ModalUI;
    private IAuthors Authors => field ??= Hub.Services.GetRequiredService<IAuthors>();
    private IChats Chats => Hub.Services.GetRequiredService<IChats>();
    private IUIActionHandler? SaveMediaActionHandler { get; set; }

    [Parameter] public ChatEntryAttachment? Attachment { get; set; }
    [Parameter] public EventCallback CloseClick { set; get; }
    [Parameter] public string DownloadUrl { set; get; } = "";
    [Parameter] public string ContentType { set; get; } = "";

    protected override void OnInitialized() {
        var saver = Hub.Services.GetService<IMediaSaver>();
        if (saver != null) {
            SaveMediaActionHandler = UIActionHandler.Create(
                this,
                () => saver.Save(DownloadUrl, ContentType));
        }

        _mediaShareUI = Hub.Services.GetService<IMediaShareUI>();
    }

    protected override async Task OnParametersSetAsync() {
        if (Attachment != null) {
            _chatEntry = await Chats.GetEntry(Session, Attachment.EntryId, CancellationToken.None).ConfigureAwait(false);
        }

        if (_chatEntry != null)
            _author = await Authors.Get(Session, _chatEntry.ChatId, _chatEntry.AuthorId, CancellationToken.None).ConfigureAwait(false);
    }

    private void OnInfoClick()
        => _ = ModalUI.Show(new VisualMediaInfoModal.Model(Attachment));

    private Task OnShareClick() {
        if (_mediaShareUI == null || Attachment == null)
            return Task.CompletedTask;

        return _mediaShareUI.Share(Attachment);
    }
}
