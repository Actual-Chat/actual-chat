@using ActualChat.UI.Blazor.Module
@using System.Diagnostics.CodeAnalysis
@inherits ComponentBase<UIHub>
@implements IAsyncDisposable

<div @ref="ElementRef" class="@_class @Class" data-side-nav="@_attribute" inert="@(!IsOpen)">
    @ChildContent
</div>

@code {
    // Aliased because ComponentBase.PanelsUI - and this component's own namespace - shadow the type
    private static readonly TimeSpan TransitionDuration
        = ActualChat.UI.Blazor.Services.PanelsUI.PanelTransitionDuration;
    private static readonly string JSCreateMethod = $"{BlazorUICoreModule.ImportName}.SideNav.create";

    private string _class = "";
    private string _attribute = "";
    private bool _wasOpen;

    [Parameter] public SideNavSide Side { get; set; } = SideNavSide.Left;
    [Parameter] public string Class { get; set; } = "";
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public RenderFragment ChildContent { get; set; } = null!;
    [Parameter] public EventCallback<bool> VisibilityChanged { get; set; }

    private ElementReference ElementRef { get; set; }
    private IJSObjectReference JSRef { get; set; } = null!;
    private DotNetObjectReference<SideNav> BlazorRef { get; set; } = null!;

    [DynamicDependency(DynamicallyAccessedMemberTypes.All, typeof(SideNav))]
    public SideNav() { }

    protected override void OnParametersSet() {
        _class = "side-nav";
        _class += Side == SideNavSide.Left
            ? " side-nav-left"
            : " side-nav-right";
        _attribute = IsOpen
            ? "open"
            : "closed";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (_wasOpen != IsOpen) {
            // The render above is what started the CSS transition; pausing before it would have
            // postponed that render through ShouldRender, and the panel would never have moved.
            _wasOpen = IsOpen;
            if (!firstRender)
                Hub.RenderDelayer.Pause(TransitionDuration);
        }
        if (firstRender) {
            BlazorRef = DotNetObjectReference.Create(this);
            var options = new SideNavOptions {
                Side = Side,
            };
            JSRef = await JS.InvokeAsync<IJSObjectReference>(JSCreateMethod, ElementRef, BlazorRef, options);
        }
    }

    public async ValueTask DisposeAsync() {
        await JSRef.DisposeSilentlyAsync("dispose");
        JSRef = null!;
        BlazorRef.DisposeSilently();
        BlazorRef = null!;
    }

    [JSInvokable]
    public async Task OnVisibilityChanged(bool isOpen) {
        if (IsOpen != isOpen)
            await VisibilityChanged.InvokeAsync(isOpen);
    }

    [JSInvokable]
    public void OnPullSettling() {
        // A pull's settle animation runs entirely in JS and reports its result only once it's over,
        // so this is the only edge .NET can't see for itself.
        Hub.PanelsUI.Middle.NotifyPullSettled();
        Hub.RenderDelayer.Pause(TransitionDuration);
    }
}
