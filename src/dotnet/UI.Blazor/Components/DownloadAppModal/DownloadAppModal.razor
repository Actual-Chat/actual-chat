@namespace ActualChat.UI.Blazor.Components
@inherits ComponentBase<UIHub>
@implements IModalView<DownloadAppModal.Model>
@{
    var title = ModalModel.IsMobileOnly
        ? L.Download_GetMobileApp_Format(CoreConstants.AppName)
        : L.Download_GetApp_Format(CoreConstants.AppName);
}

<DialogFrame
    Class="@(ModalModel.IsMobileOnly ? "download-app-modal mobile-only" : "download-app-modal")"
    Title="@title"
    HasCloseButton="true"
    NarrowViewSettings="@DialogFrameNarrowViewSettings.Default">
    <Body>
        <FormBlock>
            <DownloadTiles IsMobileOnly="@ModalModel.IsMobileOnly"/>
        </FormBlock>
    </Body>
</DialogFrame>

@code {
    [Parameter] public Model ModalModel { get; set; } = null!;

    public sealed record Model(bool IsMobileOnly = false);
}
