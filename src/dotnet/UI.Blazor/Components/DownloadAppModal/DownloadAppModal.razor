@namespace ActualChat.UI.Blazor.Components
@inherits ComponentBase<UIHub>
@implements IModalView<DownloadAppModal.Model>
@{
    var title = L.Download_GetApp_Format(CoreConstants.AppName);
}

<DialogFrame
    Class="download-app-modal"
    Title="@title"
    HasCloseButton="true"
    NarrowViewSettings="@DialogFrameNarrowViewSettings.Default">
    <Body>
        <FormBlock>
            <DownloadTiles/>
        </FormBlock>
    </Body>
</DialogFrame>

@code {
    [Parameter] public Model ModalModel { get; set; } = null!;

    public sealed record Model;
}
