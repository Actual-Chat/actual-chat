@namespace ActualChat.UI.Blazor.Components

@{
    var isClickable = Click.HasDelegate;
    var rootCls = isClickable ? "card-item hovered" : "card-item";

    RenderFragment RenderInner() =>
        @<text>
            @if (Left != null) {
                <div class="c-left" data-child="card-left">
                    @Left
                </div>
            }
            <div class="c-center">
                <div class="@TitleClass c-title">
                    @Title
                </div>
                @if (Caption != null) {
                    <div class="c-caption">
                        @Caption
                    </div>
                }
            </div>
            @if (Right != null) {
                <div class="c-right" data-child="card-right">
                    @Right
                </div>
            }
        </text>;
}

@if (isClickable) {
    <div class="@rootCls @Class"
         data-children="card-left card-right"
         role="button"
         tabindex="0"
         @onclick="@Click"
         @onclick:preventDefault="true">
        @RenderInner()
    </div>
} else {
    <div class="@rootCls @Class" data-children="card-left card-right">
        @RenderInner()
    </div>
}

@code {
    [Parameter] public string Class { get; set; } = "";
    [Parameter] public string TitleClass { get; set; } = "text-01";
    [Parameter] public EventCallback Click { get; set; }
    [Parameter] public RenderFragment? Left { get; set; }
    [Parameter] public RenderFragment? Title { get; set; }
    [Parameter] public RenderFragment? Caption { get; set; }
    [Parameter] public RenderFragment? Right { get; set; }
}
