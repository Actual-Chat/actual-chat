@namespace ActualChat.UI.Blazor.Components
@inherits ComponentBase<UIHub>

<div class="stepper @Class">
    <CascadingValue Value="@this" IsFixed="true">
        @if (Header != null) {
            <div class="stepper-header">
                @Header.Invoke(this)
            </div>
        }
        <div class="stepper-body">
            @if (Filler is null) {
                <div class="stepper-filler"></div>
            } else {
                @Filler.Invoke(this)
            }
            @if (Steps != null) {
                <div class="stepper-content @ContentClass">
                    @Steps.Invoke(this)
                </div>
            }
            <div class="stepper-filler"></div>
        </div>
        @if (Footer != null) {
            <div class="stepper-footer @(ShowNoise ? "show-noise" : "")">
                @Footer.Invoke(this)
                @if (ShowNoise) {
                    <div class="stepper-footer-noise">
                        <img draggable="false" src="/dist/images/landing/landing-page-noise-small.svg" alt="">
                    </div>
                }
            </div>
        }
    </CascadingValue>
    @if (ShowNoise) {
        <div class="stepper-noise">
            <img draggable="false" src="/dist/images/landing/landing-page-noise-small.svg" alt="">
        </div>
    }
</div>

@code {
    private readonly List<IStep> _steps = new();
    private readonly HashSet<IStep> _skippedSteps = new();
    private readonly HashSet<IStep> _leftSteps = new();
    private IStep? _currentStep;

    [Parameter] public RenderFragment<Stepper>? Header { get; set; }
    [Parameter] public RenderFragment<Stepper>? Footer { get; set; }
    [Parameter] public RenderFragment<Stepper>? Steps { get; set; }
    [Parameter] public RenderFragment<Stepper>? Filler { get; set; }
    [Parameter] public EventCallback<bool> CurrentStepChanged { get; set; }
    [Parameter] public string Class { get; set; } = "";
    [Parameter] public string ContentClass { get; set; } = "";
    [Parameter] public bool ShowNoise { get; set; }
    [Parameter] public bool SkipCompletedSteps { get; set; }

    public int StepCount => _steps.Count;
    public int LastStepIndex => Math.Max(0, _steps.Count - 1);
    public int CurrentStepIndex => _currentStep is { } currentStep ? _steps.IndexOf(currentStep) : -1;
    public bool IsLastStep => CurrentStepIndex == LastStepIndex;
    public int VisibleStepCount => SkipCompletedSteps ? _steps.Count(IsStepVisible) : _steps.Count;
    public int CurrentVisibleStepIndex => SkipCompletedSteps && _currentStep is not null
        ? _steps.TakeWhile(s => s != _currentStep).Count(IsStepVisible)
        : CurrentStepIndex;

    private bool IsStepVisible(IStep step) {
        if (_skippedSteps.Contains(step))
            return false;
        var stepIndex = _steps.IndexOf(step);
        // Passed or current steps are always visible
        if (stepIndex <= CurrentStepIndex)
            return true;
        // Future steps are visible only if not pre-completed
        return !IsCompletedBeforeRun(step);
    }
    public bool CanMoveForward => CurrentStepIndex is var i and >= 0 && i < LastStepIndex;
    public bool CanMoveBack => SkipCompletedSteps
        ? CurrentStepIndex > 0 && _steps.Take(CurrentStepIndex).Any(IsReturnTarget)
        : CurrentStepIndex > 0;

    private bool IsReturnTarget(IStep step)
        => step.CanReturnTo && !_skippedSteps.Contains(step);

    private bool IsCompletedBeforeRun(IStep step)
        => step.IsCompleted && !_leftSteps.Contains(step);
    public bool CanSkip => _currentStep is { CanSkip: true };
    public string SkipTitle => _currentStep?.SkipTitle ?? L.Common_Skip;
    public string NextTitle => _currentStep?.NextTitle ?? L.Common_Next;
    public IStep? CurrentStep => _currentStep;

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (SkipCompletedSteps && _leftSteps.Count == 0 && _currentStep?.IsCompleted == true) {
            _skippedSteps.Add(_currentStep);
            await Move(1);
        }
    }

    public void AddStep(IStep step) {
        _steps.Add(step);
        if (_steps.Count == 1)
            _currentStep = step;
        StateHasChanged();
    }

    public async ValueTask<bool> TryMoveForward() {
        if (_currentStep is null || !await _currentStep.TryComplete())
            return false;

        return await Move(1);
    }

    public async ValueTask Skip() {
        if (_currentStep is null)
            return;

        await _currentStep.Skip();
        await Move(1);
    }

    public ValueTask<bool> MoveBack()
        => Move(-1);

    private async ValueTask<bool> Move(int offset) {
        if (_currentStep == null)
            return false;

        _leftSteps.Add(_currentStep);
        var newStepIndex = CurrentStepIndex + offset;

        if (SkipCompletedSteps) {
            var direction = Math.Sign(offset);
            if (direction > 0) {
                // Forward: skip steps already completed before this run, remembering them
                while (newStepIndex >= 0 && newStepIndex < StepCount && IsCompletedBeforeRun(_steps[newStepIndex])) {
                    _skippedSteps.Add(_steps[newStepIndex]);
                    newStepIndex += direction;
                }
            } else {
                // Back: skip auto-skipped and non-returnable (informational) steps, so we land on
                // the last step the user could actually act on
                while (newStepIndex >= 0 && newStepIndex < StepCount && !IsReturnTarget(_steps[newStepIndex])) {
                    newStepIndex += direction;
                }
            }
        }

        if (newStepIndex < 0)
            return false;

        if (newStepIndex >= StepCount) {
            await CurrentStepChanged.InvokeAsync(true);
            return true;
        }

        var previousStep = _currentStep;
        _currentStep = _steps[newStepIndex];
        previousStep.NotifyStateHasChanged();
        _currentStep.NotifyStateHasChanged();
        StateHasChanged();
        await CurrentStepChanged.InvokeAsync(false);
        return true;
    }
}
