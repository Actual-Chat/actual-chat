@namespace ActualChat.UI.Blazor.Components

@{
    var activeIndex = -1;
    for (var i = 0; i < Items.Count; i++) {
        if (Items[i].Id == SelectedId) {
            activeIndex = i;
            break;
        }
    }
}

<div class="segmented-switch @Class" role="tablist" style="--seg-count: @Items.Count; --seg-index: @activeIndex;">
    @if (activeIndex >= 0) {
        <div class="c-thumb"></div>
    }
    @foreach (var item in Items) {
        var isOn = item.Id == SelectedId;
        <button
            type="button"
            role="tab"
            aria-selected="@(isOn ? "true" : "false")"
            class="btn-segment @(isOn ? "on" : "")"
            @onclick="@(() => OnClick(item.Id))">@item.Title@if (item.HasDot) {
                <span class="c-dot"></span>
            }</button>
    }
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<SegmentedSwitchItem> Items { get; set; } = [];
    [Parameter] public string SelectedId { get; set; } = "";
    [Parameter] public EventCallback<string> SelectedIdChanged { get; set; }
    [Parameter] public string Class { get; set; } = "";

    private Task OnClick(string id)
        => id == SelectedId ? Task.CompletedTask : SelectedIdChanged.InvokeAsync(id);
}
