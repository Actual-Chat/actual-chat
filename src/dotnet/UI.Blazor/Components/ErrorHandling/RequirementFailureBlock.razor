@namespace ActualChat.UI.Blazor.Components
@using ActualChat.Users
@inherits FusionComponentBase<UIHub>
@attribute [UnconditionalSuppressMessage("Trimming", "IL2110", Justification = "UI types are expected to be untrimmed.")]
@attribute [UnconditionalSuppressMessage("Trimming", "IL2111", Justification = "UI types are expected to be untrimmed.")]
@{
    var needsSignIn = Account is not null && Failures.Items.Any(x => x.Value is INotFoundException);
    if (needsSignIn) {
        _ = History.NavigateTo(Links.Home);
        return;
    }
}

<LayoutView Layout="@typeof(DefaultLayout)">
    <MainHeader>@L.Error_Title</MainHeader>
    @foreach (var (requirement, error) in Failures.Items) {
        var title = HostInfo.IsDevelopmentInstance
            ? $"Error ({error.GetType().GetName()}):"
            : L.Error_Label;
        <ErrorToast @key="@requirement"
               Title="@title"
               Dismissed="@(_ => RequirementChecker.Remove(requirement))">@error.Message</ErrorToast>
    }
</LayoutView>

@code {
    [CascadingParameter] public RequirementChecker RequirementChecker { get; set; } = null!;
    [Parameter, EditorRequired] public FailedRequirementSet Failures { get; set; } = FailedRequirementSet.Empty;
    [Parameter, EditorRequired] public AccountFull? Account { get; set; }
}
