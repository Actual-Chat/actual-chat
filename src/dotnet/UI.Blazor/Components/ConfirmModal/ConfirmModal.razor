@namespace ActualChat.UI.Blazor.Components
@implements IModalView<ConfirmModal.Model>

@{
    var isDestructive = ModalModel.IsDestructive;
    var title = ModalModel.Title;
    if (title.IsNullOrEmpty())
        title = isDestructive ? "Discard changes" : "Confirm changes";
    var text = ModalModel.Text;
    if (text.IsNullOrEmpty())
        text = isDestructive
            ? "Are you sure you want to discard all changes?"
            : "Are you sure you want to confirm all changes?";
    var additionalContent = ModalModel.AdditionalContent;
    var markupTitle = ModalModel.MarkupTitle;
    var btnCls = isDestructive ? "btn-danger" : "btn-primary";
    btnCls = "btn-modal " + btnCls;
    var btnText = ModalModel.ConfirmButtonText;
    if (btnText.IsNullOrEmpty())
        btnText = isDestructive ? "Discard" : "Confirm";
    var cancelText = ModalModel.CancelButtonText;
    if (cancelText.IsNullOrEmpty())
        cancelText = "Cancel";
    var cls = $"confirm-modal modal-sm {ModalModel.Class}";
}

<DialogFrame Class="@cls" Title="@title">
    <Body>
    <FormBlock Class="confirm-text">
        <div class="c-text">
            @if (!markupTitle.Value.IsNullOrEmpty()) {
                @markupTitle
            } else {
                <p>
                    @text
                </p>
            }
        </div>
    </FormBlock>
    @if (!additionalContent.IsNullOrEmpty()) {
        <FormBlock>
            @((MarkupString)additionalContent)
        </FormBlock>
    }
    </Body>
    <Buttons>
        <Button Class="btn-modal" Click="@(_ => Modal.Close())">@cancelText</Button>
        <Button Class="@btnCls" Click="OnConfirm">@btnText</Button>
    </Buttons>
</DialogFrame>

@code {
    [CascadingParameter] public Modal Modal { get; set; } = null!;
    [Parameter] public Model ModalModel { get; set; } = null!;

    private void OnConfirm() {
        ModalModel.Confirm();
        Modal.Close();
    }

    public sealed record Model(bool IsDestructive, string Text, Action Confirm) {
        public string Title { get; init; } = "";
        public string ConfirmButtonText { get; init; } = "";
        public string CancelButtonText { get; init; } = "";
        public MarkupString MarkupTitle { get; init; } = default;
        public string AdditionalContent { get; init; } = "";
        public string Class { get; init; } = "";
    }
}
