@namespace ActualChat.UI.Blazor.Components
@inherits ComponentBase<UIHub>
@implements IModalView<ConfirmModal.Model>

@{
    var isDestructive = ModalModel.IsDestructive;
    var title = ModalModel.Title;
    if (title.IsNullOrEmpty())
        title = isDestructive ? L.Confirm_DiscardTitle : L.Confirm_ConfirmTitle;
    var text = ModalModel.Text;
    if (text.IsNullOrEmpty())
        text = isDestructive
            ? L.Confirm_DiscardText
            : L.Confirm_ConfirmText;
    var additionalContent = ModalModel.AdditionalContent;
    var markupTitle = ModalModel.MarkupTitle;
    var btnCls = isDestructive ? "btn-danger" : "btn-primary";
    btnCls = "btn-modal " + btnCls;
    var btnText = ModalModel.ConfirmButtonText;
    if (btnText.IsNullOrEmpty())
        btnText = isDestructive ? L.Confirm_Discard : L.Confirm_Confirm;
    var cancelText = ModalModel.CancelButtonText;
    if (cancelText.IsNullOrEmpty())
        cancelText = L.Common_Cancel;
    var altText = ModalModel.AltButtonText;
    var hasAlt = ModalModel.Alt != null && !altText.IsNullOrEmpty();
    // Three buttons don't fit one modal-sm row - they clip their labels, so stack them instead
    var cls = $"confirm-modal modal-sm {(hasAlt ? "wide-dialog-buttons " : "")}{ModalModel.Class}";
}

<DialogFrame Class="@cls" Title="@title">
    <Body>
    <FormBlock Class="confirm-text">
        <div class="c-text">
            @if (markupTitle != null) {
                @markupTitle
            } else {
                <p>
                    @text
                </p>
            }
        </div>
    </FormBlock>
    @if (additionalContent != null) {
        <FormBlock>
            @additionalContent
        </FormBlock>
    }
    </Body>
    <Buttons>
        <Button Class="btn-modal" Click="@(_ => Modal.Close())">@cancelText</Button>
        <Button Class="@btnCls" Click="OnConfirm">@btnText</Button>
        @* Stacked, the footer is column-reverse, so the alternative sits on top - it's the way out we recommend *@
        @if (hasAlt) {
            <Button Class="btn-modal btn-primary" Click="OnAlt">@altText</Button>
        }
    </Buttons>
</DialogFrame>

@code {
    [CascadingParameter] public Modal Modal { get; set; } = null!;
    [Parameter] public Model ModalModel { get; set; } = null!;

    private void OnConfirm() {
        ModalModel.Confirm();
        Modal.Close();
    }

    private void OnAlt() {
        ModalModel.Alt!();
        Modal.Close();
    }

    public sealed record Model(bool IsDestructive, string Text, Action Confirm) {
        public string Title { get; init; } = "";
        public string ConfirmButtonText { get; init; } = "";
        public string CancelButtonText { get; init; } = "";
        // Renders a third button - an escape from the choice rather than a second way to take it.
        // It stacks the footer, since three buttons don't fit a row. Requires AltButtonText too.
        public Action? Alt { get; init; }
        public string AltButtonText { get; init; } = "";
        public RenderFragment? MarkupTitle { get; init; }
        public RenderFragment? AdditionalContent { get; init; }
        public string Class { get; init; } = "";
    }
}
