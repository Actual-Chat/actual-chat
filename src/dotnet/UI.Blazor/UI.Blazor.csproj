<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <!-- Suppressed warnings (please sort alphabetically!) -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.Extensions.Localization" />
    <PackageReference Include="OpenTelemetry" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="ActualLab.Fusion.Blazor" />
    <PackageReference Include="Serilog" />
  </ItemGroup>

  <!-- Embed JSON translation files as resources in the main assembly.
       WithCulture=false prevents MSBuild from treating "Strings.es.json" etc. as culture
       satellite resources (the ".es." in the filename would otherwise trigger that). -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\Strings.*.json" LogicalName="%(Filename)%(Extension)" WithCulture="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Api.Contracts\Api.Contracts.csproj" />
    <ProjectReference Include="..\UI\UI.csproj" />
    <ProjectReference Include="..\Users.Templates\Users.Templates.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ServiceWorker Include="ServiceWorkers\service-worker.ts" />
  </ItemGroup>

</Project>
