// Reverse-indexed catalog: MessageIndex maps a runtime-produced English message back to
// its key here, so the English value below MUST byte-match what the app actually produces.
// Placeholders are named: {field} is replaced by the form label, the rest pass through.
// Only messages produced by BCL attributes belong here - our own attributes report a
// Validation_* key directly and live in Strings.*.json.
// TODO(FC): the Validation_* entries here are temporary - see MessageIndex. Once the .NET 11
// pipeline resolves IStringLocalizerFactory per call (preview.7?), BCL attributes localize
// forwards too and only Error_ server strings remain in this file.
{
  "Validation_Required_Format": "The {field} field is required.",
  "Validation_MinLength_Format": "The field {field} must be a string or array type with a minimum length of '{min}'.",
  "Validation_EmailAddress_Format": "The {field} field is not a valid e-mail address.",
  "Validation_DeleteConfirmationRequired": "Delete confirmation is required",
  "Validation_DeleteConfirmationInvalid": "Please enter DELETE to confirm",
  "Field_PhoneOrEmail": "Phone or email"
}
