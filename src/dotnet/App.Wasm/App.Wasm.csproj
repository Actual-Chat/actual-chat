<!--
Use:
- <Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly"> for regular builds
- <Project Sdk="Microsoft.NET.Sdk.Razor"> for hot reload (only in server mode)
-->
<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <!-- Publish & runtime properties -->
  <PropertyGroup>
    <!-- Required for WASM+Server projects -->
    <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
    <!-- These settings allows to build dotnet.js w/ symbols, but it takes like 1H or so -->
    <!--
    <RunAOTCompilation>true</RunAOTCompilation>
    <RunAOTCompilationAfterBuild>true</RunAOTCompilationAfterBuild>
    <WasmEmitSymbolMap>true</WasmEmitSymbolMap>
    <WasmNativeStrip>false</WasmNativeStrip>
    -->
    <WasmEnableWebcil>true</WasmEnableWebcil>
    <!-- Startup is 50-100ms slower when enabled: -->
    <WasmEnableSIMD>true</WasmEnableSIMD>
    <SuppressTrimAnalysisWarnings>false</SuppressTrimAnalysisWarnings>
    <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
    <!-- Disable WASM hot reload - caused 404 errors in .NET 10, not re-verified on 11 -->
    <WasmEnableHotReload>false</WasmEnableHotReload>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
  </PropertyGroup>

  <!-- Trimming & feature switches -->
  <PropertyGroup>
    <!-- Required with PublishTrimmed=true in our case -->
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <!-- Slower runtime, but slightly faster startup -->
    <DisableDependencyInjectionDynamicEngine>true</DisableDependencyInjectionDynamicEngine>
  </PropertyGroup>

  <!-- WASM Profiling -->
  <!--
  <PropertyGroup>
    <WasmProfilers>browser;</WasmProfilers>
    <WasmBuildNative>true</WasmBuildNative>
  </PropertyGroup>
  -->

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <RunAOTCompilation>false</RunAOTCompilation>
    <WasmStripILAfterAOT>false</WasmStripILAfterAOT>
    <CompressionEnabled>true</CompressionEnabled>
  </PropertyGroup>

  <!-- Trimming -->
  <ItemGroup>
    <!-- <TrimmerRootDescriptor Include="ILLink.Descriptors.xml" />-->
    <TrimmerRootAssembly Include="ActualChat.App.Wasm" RootMode="EntryPoint" />
    <TrimmerRootAssembly Include="ActualChat.Api" RootMode="All" />
    <TrimmerRootAssembly Include="ActualChat.Api.Contracts" RootMode="All" />
    <TrimmerRootAssembly Include="ActualChat.UI.Blazor" RootMode="All" />
    <TrimmerRootAssembly Include="ActualChat.UI.Blazor.App" RootMode="All" />
  </ItemGroup>

  <!-- References -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
    <!-- Workaround of https://github.com/dotnet/aspnetcore/issues/37141>: -->
    <ProjectCapability Include="AspNetCore" />
    <ProjectReference Include="..\UI.Blazor.App\UI.Blazor.App.csproj" />
  </ItemGroup>

  <ItemGroup>
    <_ContentIncludedByDefault Remove="wwwroot\dist\config\firebase.config.js" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Properties\" />
    <Folder Include="wwwroot\dist" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Properties\launchSettings.json" />
  </ItemGroup>

</Project>
