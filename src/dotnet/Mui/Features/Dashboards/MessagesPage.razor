@namespace ActualChat.Mui
@page "/m/dashboards/messages"

<MudText Typo="Typo.h5" Class="mb-4">Messages</MudText>

<MuiMetricsView Database="chat" CacheName="messages" Metrics="@Metrics"/>

<MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-4">
    Built from the chat_entries table only. System entries and imported entries are not counted. Removed
    messages are still counted: the activity happened, and only the removal time is known.
</MudText>

@code {
    private const string UserEntries =
        "from chat_entries where not is_system_entry and not is_imported"
        + " and begins_at >= {from} and begins_at < {to}";

    private static readonly IReadOnlyList<MuiMetric> Metrics = [
        new("text_messages", "Text messages",
            "select count(*) " + UserEntries + " and coalesce(audio_id, '') = ''",
            Description: "Messages typed by users: chat_entries rows that are neither system nor "
                + "imported and have no audio_id, with begins_at in the window."),
        new("voice_messages", "Voice messages",
            "select count(*) " + UserEntries + " and coalesce(audio_id, '') <> ''",
            Description: "Transcribed speech: the same entries as text messages, but with an audio_id. "
                + "Speech is split into entries by pauses, so this is the number of spoken phrases, "
                + "not of recordings."),
        new("voice_minutes", "Voice minutes",
            "select round((coalesce(sum(extract(epoch from ends_at - begins_at)), 0) / 60)::numeric, 1) "
            + UserEntries + " and coalesce(audio_id, '') <> ''",
            Description: "Total speech time of voice messages, in minutes: the sum of ends_at - begins_at "
                + "over the voice messages of the window. Entries without ends_at count as zero."),
        new("active_users", "Active users",
            "select count(distinct a.user_id) from chat_entries e join authors a on a.id = e.author_id"
            + " where not e.is_system_entry and not e.is_imported"
            + " and e.begins_at >= {from} and e.begins_at < {to}",
            Description: "Distinct users among the authors of text and voice messages of the window: "
                + "chat_entries joined with authors by author_id, counting authors.user_id, so someone who "
                + "wrote in two chats counts once. Entries whose author row is missing are not counted."),
    ];
}
