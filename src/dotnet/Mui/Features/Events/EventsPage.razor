@namespace ActualChat.Mui
@page "/m/system/events"
@inherits MuiComponent
@implements IDisposable
@inject IMuiDb Db

<MudText Typo="Typo.h5" Class="mb-2">Events</MudText>
<MudText Color="Color.Secondary" Class="mb-2">
    The Fusion event log (<code>_events</code>) of every database that has it: queued events waiting to be
    processed and processed ones until they are trimmed. Click a database to see its events by type.
</MudText>

<MuiLiveBar OnRefresh="@Load"/>

@if (_error is not null) {
    <MudAlert Severity="Severity.Error" Class="mb-2" Style="white-space: pre-wrap">@_error</MudAlert>
}
@if (_rows is not null) {
    <MudPaper Class="pa-2 mb-4" Style="overflow-x: auto">
        <MudSimpleTable Dense="true" Hover="true">
            <thead>
                <tr>
                    <th>Database</th>
                    <th>Rows</th>
                    <th>Commit markers</th>
                    <th>Pending</th>
                    <th>Delayed</th>
                    <th>Oldest pending</th>
                    <th>Created, last 60 s</th>
                    <th>Created, last 5 min</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in _rows) {
                    <tr style="cursor: pointer; @(row.Database == _selected ? "font-weight: bold" : "")"
                        @onclick="@(() => Select(row.Database))">
                        <td>@row.Database</td>
                        @if (row.Values is not { } v) {
                            <td colspan="7" style="color: var(--mui-error, #d32f2f)">@(row.Error ?? "No data")</td>
                        }
                        else {
                            <td>@MuiLive.ToLong(v[0])</td>
                            <td>@MuiLive.ToLong(v[1])</td>
                            <td style="@GetWarningStyle(MuiLive.ToLong(v[2]) > 0)">@MuiLive.ToLong(v[2])</td>
                            <td>@MuiLive.ToLong(v[3])</td>
                            <td style="@GetWarningStyle(MuiLive.ToSeconds(v[4]) > 60)">
                                @MuiLive.FormatDuration(MuiLive.ToSeconds(v[4]))
                            </td>
                            <td>@MuiLive.FormatRate(MuiLive.ToLong(v[5]), 60)</td>
                            <td>@MuiLive.FormatRate(MuiLive.ToLong(v[6]), 300)</td>
                        }
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
    </MudPaper>
}

@if (_selected is not null) {
    <MudText Typo="Typo.h6" Class="mb-1">Events by type: @_selected</MudText>
    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">
        The type is the first string of the MessagePack payload (<code>value_data</code>), "Namespace.Type, Assembly".
        Shown without namespace. An operation completion is listed as OperationCompletion: the command inside
        it is not extracted. Bars are scaled to the largest value in their column.
    </MudText>
    @if (_types is null) {
        <MudProgressLinear Indeterminate="true" Class="mb-2"/>
    }
    else if (_types.Result is not { } types) {
        <MudAlert Severity="Severity.Error" Class="mb-2" Style="white-space: pre-wrap">@_types.Error</MudAlert>
    }
    else {
        <MudPaper Class="pa-2 mb-4" Style="overflow-x: auto">
            <MudSimpleTable Dense="true">
                <thead>
                    <tr>
                        <th>Type</th>
                        <th style="width: 40%">Created, last 5 min</th>
                        <th style="width: 30%">Pending</th>
                        <th>Delayed</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var type in types.Rows) {
                        <tr>
                            <td>@type[0]</td>
                            <td>
                                <MuiBar Value="@MuiLive.ToLong(type[1])" Max="@_maxCreated"/>
                            </td>
                            <td>
                                <MuiBar Value="@MuiLive.ToLong(type[2])" Max="@_maxPending"/>
                            </td>
                            <td>@MuiLive.ToLong(type[3])</td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        </MudPaper>
        @if (types.IsTruncated || types.Rows.Length >= 100) {
            <MudText Typo="Typo.caption" Color="Color.Warning" Class="mb-2">Only the first 100 types are shown.</MudText>
        }
    }
}

<MudExpansionPanels Class="mt-4">
    <MudExpansionPanel Text="Columns, queries and trimming">
        <MudText Typo="Typo.body2" Class="mb-2">
            <b>Rows</b>: all rows in <code>_events</code>. <b>Commit markers</b>: rows without a payload, written
            by Fusion for every committed operation to verify the commit (uuid <code>~op-...</code>, already
            processed); they are not events. <b>Pending</b>: state New (0) and <code>delay_until</code> in the past:
            due now, waiting for a host to process them. <b>Delayed</b>: state New and <code>delay_until</code> in
            the future (scheduled, for example flow timers). <b>Oldest pending</b>: how long the oldest due event
            has been waiting since its <code>delay_until</code>. <b>Created</b>: events with a payload whose
            <code>logged_at</code> falls into the window, with the rate per second.
        </MudText>
        <MudText Typo="Typo.body2" Class="mb-2">
            Trimming: the trimmer deletes processed and discarded rows whose <code>delay_until</code> is older
            than 4 hours (the Fusion default, checked about every 15 minutes) and never deletes New ones. Created
            counts therefore always cover the whole 60 s and 5 min windows, while Rows includes up to 4 hours of
            processed events. Times come from the database clock.
        </MudText>
        <MuiSqlBox Title="Per database" Sql="@EventsSql.Summary"
                   Database="@(_databases?.FirstOrDefault() ?? "")"/>
        <MuiSqlBox Title="By type (for the selected database)" Sql="@EventsSql.Types"
                   Database="@(_selected ?? _databases?.FirstOrDefault() ?? "")"/>
    </MudExpansionPanel>
</MudExpansionPanels>

@code {
    private readonly CancellationTokenSource _disposeCts = new();
    private string[]? _databases;
    private MuiLiveRow[]? _rows;
    private string? _selected;
    private MuiLiveRow? _types;
    private long _maxCreated;
    private long _maxPending;
    private string? _error;

    public void Dispose() {
        _disposeCts.Cancel();
        _disposeCts.Dispose();
    }

    private async Task Load() {
        try {
            if (_databases is null) {
                var databases = await Db.GetDatabases(Session, _disposeCts.Token);
                _databases = MuiLive.GetDatabaseNames(databases, "_events");
            }
            var rowsTask = MuiLive.Query(Db, Session, _databases, EventsSql.Summary, _disposeCts.Token);
            await Task.WhenAll(rowsTask, LoadTypes());
            _rows = await rowsTask;
            _error = null;
        }
        catch (OperationCanceledException) {
            // The page is gone
        }
        catch (Exception e) {
            _error = e.Message;
        }
    }

    private async Task Select(string database) {
        _selected = _selected == database ? null : database;
        _types = null;
        try {
            await LoadTypes();
        }
        catch (OperationCanceledException) {
            // The page is gone
        }
    }

    private async Task LoadTypes() {
        if (_selected is not { } selected)
            return;

        var rows = await MuiLive.Query(Db, Session, [selected], EventsSql.Types, _disposeCts.Token);
        if (_selected != selected)
            return;

        _types = rows[0];
        var types = _types.Result?.Rows ?? [];
        _maxCreated = types.Select(x => MuiLive.ToLong(x[1])).DefaultIfEmpty().Max();
        _maxPending = types.Select(x => MuiLive.ToLong(x[2])).DefaultIfEmpty().Max();
    }

    private static string GetWarningStyle(bool isWarning)
        => isWarning ? "color: #ed6c02; font-weight: bold" : "";
}
