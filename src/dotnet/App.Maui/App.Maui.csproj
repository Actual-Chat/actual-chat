<Project Sdk="Microsoft.NET.Sdk.Razor">
  <!--
  If we're going to override SDK targets, we need to import .props here.
  See https://stackoverflow.com/questions/47179705/net-core-override-default-build-targets
  -->
  <!-- <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk.Razor" /> -->

  <PropertyGroup>
    <!-- Build Android by default; add iOS / MacCatalyst only on macOS to avoid iOS build issues on Windows CI -->
    <TargetFrameworks>net11.0-android;</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx'))">$(TargetFrameworks);net11.0-ios;net11.0-maccatalyst</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net11.0-windows10.0.22621.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <AssemblyName>$(BaseName)</AssemblyName>
    <RootNamespace>$(BaseName).$(MSBuildProjectName)</RootNamespace>
    <Configurations>Release;Debug</Configurations>

    <!-- MAUI properties -->
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <IsPublishable>true</IsPublishable>
    <SkipValidateMauiImplicitPackageReferences>true</SkipValidateMauiImplicitPackageReferences>
    <EnableDefaultXamlItems>false</EnableDefaultXamlItems>

    <!-- Other build properties -->
    <EnableDefaultCssItems>false</EnableDefaultCssItems>
    <!--
    <EnablePreviewMsixTooling>true</EnablePreviewMsixTooling>
    -->

    <!-- Display name -->
    <ApplicationTitle>Voxt</ApplicationTitle>
    <appname>voxt.ai</appname>

    <!-- App Identifier -->
    <ApplicationId>chat.actual.app</ApplicationId>
    <ApplicationIdGuid>7AC72B49-8FEA-45AB-B7B8-C32719677E9D</ApplicationIdGuid>

    <!-- Original defaults for MAUI project: -->
    <!--
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">14.2</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">14.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'tizen'">6.5</SupportedOSPlatformVersion>
    -->

    <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('-android'))">28.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('-ios'))">16.4</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('-maccatalyst'))">17.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('-windows'))">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$(TargetFramework.Contains('-windows'))">10.0.17763.0</TargetPlatformMinVersion>
  </PropertyGroup>

  <!-- Partial ReadyToRun: compile what _Profiling/merged.mibc lists and leave the rest as
       IL. Default on, because on Android and Windows a miss costs one JIT compile and the
       image shrinks several-fold (Android 111 -> 19MB, Windows 234 -> 15MB).

       Off for Apple targets, and it must stay that way: there is no JIT there, so anything
       missing from the image is *interpreted* for the life of the process rather than
       compiled once. The size win is not worth that.

       Delete artifacts/obj/App.Maui/<config>/R2R/ when toggling this - _CreateR2RImages
       takes its Inputs from the project files, the compile list and the pgo files, not
       from the crossgen2 argument properties, so flipping it alone leaves the previous
       composite in place and the build quietly ships the image you meant to replace. -->
  <PropertyGroup>
    <UsePartialR2R Condition="'$(UsePartialR2R)' == ''">true</UsePartialR2R>
    <UsePartialR2R Condition="$(TargetFramework.Contains('-ios')) or $(TargetFramework.Contains('-maccatalyst'))">false</UsePartialR2R>
  </PropertyGroup>

  <!-- CoreCLR runtime settings — .NET 11 runs MAUI on CoreCLR on every platform,
       so these apply everywhere (they're ignored under Native AOT, which has no JIT) -->
  <PropertyGroup>
    <!-- Reduce work at startup -->
    <TieredCompilation>true</TieredCompilation>
    <TieredCompilationQuickJit>true</TieredCompilationQuickJit>
    <TieredCompilationQuickJitForLoops>true</TieredCompilationQuickJitForLoops>
    <TieredPGO>false</TieredPGO>
    <!-- Workstation GC. The old note here claimed Server GC costs ~80ms of startup; that
         predates DATAS (on by default since .NET 9), which starts Server GC with a single
         heap and grows it on demand rather than one heap per core, so the number no longer
         describes what we'd get. Staying on Workstation regardless: it's the only choice on
         iOS and Mac Catalyst, where the macios SDK's _ValidateGarbageCollector target
         hard errors on Server GC. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>

  <!-- Delay tier-1 call counting past startup. Tiering counts calls into R2R code too, so
       a composite-R2R startup spends real time re-jitting methods that already had native
       code: measured 1869 -> 119 jitted methods on Android, 2553 -> 446 on Windows.
       15s covers startup (app is up in ~1s, the *ServiceStarter work is done by ~6s) and
       then lets tier 1 happen normally, so long sessions still get optimized code.

       This is the config-file form of DOTNET_TC_CallCountingDelayMs, verified to be honored
       (the numbers above are from a runtimeconfig-only run, env var cleared). Prefer it over
       the env var: it travels with the app instead of with whoever launched it.
       Do NOT reach for TieredCompilation_CallCounting=0 - that disables *counting*, which
       promotes everything as soon as the delay expires: measured 1200 -> 1416 promotions. -->
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.Runtime.TieredCompilation.CallCountingDelayMs" Value="15000" />
  </ItemGroup>

  <!-- Trimming & feature switches -->
  <PropertyGroup>
    <!-- Required with PublishTrimmed=true in our case -->
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <!-- Tracing: enables the EventPipe diagnostic server so dotnet-trace can attach -->
  <PropertyGroup Condition="'$(IsTracingEnabled)' == ''">
    <IsTracingEnabled>false</IsTracingEnabled>
  </PropertyGroup>

  <!-- IsDevMaui controls whether the app talks to prod or dev instance -->
  <PropertyGroup Condition="'$(IsDevMaui)' == ''">
    <IsDevMaui>true</IsDevMaui>
  </PropertyGroup>
  <PropertyGroup Condition="'$(IsDevMaui)' == 'true'">
    <DefineConstants>$(DefineConstants);IS_DEV_MAUI</DefineConstants>
    <!-- Display name -->
    <ApplicationTitle>Voxt (Dev)</ApplicationTitle>
    <!-- App Identifier -->
    <ApplicationId>chat.actual.dev.app</ApplicationId>
  </PropertyGroup>

  <!-- Environment -->
  <PropertyGroup>
    <FixedEnvironment Condition="'$(FixedEnvironment)' == ''" />
    <!-- Produces tons of misleading warnings if true! -->
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
  </PropertyGroup>
  <PropertyGroup Condition="'$(FixedEnvironment)' == 'Production'">
    <DefineConstants>$(DefineConstants);IS_PRODUCTION_ENV</DefineConstants>
  </PropertyGroup>

  <!-- Shared source files -->
  <ItemGroup>
    <Compile Include="..\Core.Server\LibPhoneNumbersExt.cs" Link="Phone\LibPhoneNumbersExt.cs" />
  </ItemGroup>

  <!-- Project references -->
  <ItemGroup>
    <ProjectReference Include="..\App.Maui.IosShareExt\App.Maui.IosShareExt.csproj" Condition="$(TargetFramework.Contains('-ios')) AND $([MSBuild]::IsOSPlatform('osx'))">
      <IsAppExtension>true</IsAppExtension>
      <IsWatchApp>false</IsWatchApp>
    </ProjectReference>
    <ProjectReference Include="..\Core.Audio\Core.Audio.csproj" />
    <ProjectReference Include="..\Maui\Maui.csproj" />
    <ProjectReference Include="..\UI.Blazor.App\UI.Blazor.App.csproj" />
  </ItemGroup>

  <!-- Package references -->
  <ItemGroup>
    <PackageReference Remove="Microsoft.SourceLink.GitHub" />
    <PackageReference Include="banditoth.MAUI.DeviceId" />
    <PackageReference Include="CommunityToolkit.Maui.Core" />
    <PackageReference Include="libphonenumber-csharp" />
    <PackageReference Include="Microsoft.Maui.Controls" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" />
    <!-- This seems weird, but w/o this line MSBuild concludes the version is 1.0.0! -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" VersionOverride="$(MicrosoftExtensionsVersion)" />
    <PackageReference Include="Microsoft.IO.RecyclableMemoryStream" />
    <PackageReference Include="Plugin.Maui.Audio" />
  </ItemGroup>

  <!-- Platform-specific package references -->
  <ItemGroup Condition="$(TargetFramework.Contains('-android'))">
    <PackageReference Include="Xamarin.AndroidX.Core" />
    <PackageReference Include="Xamarin.AndroidX.Collection" />
    <PackageReference Include="Xamarin.AndroidX.Collection.Ktx" />
    <PackageReference Include="Xamarin.AndroidX.Fragment.Ktx" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.Common.Java8" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.Process" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.Runtime" />
    <PackageReference Include="Xamarin.AndroidX.Media" />
    <PackageReference Include="Xamarin.AndroidX.Work.Runtime" />
    <PackageReference Include="Plugin.Firebase.Analytics" />
    <PackageReference Include="Xamarin.Firebase.Analytics" />
    <PackageReference Include="Xamarin.Firebase.Crashlytics" />
    <PackageReference Include="Xamarin.Firebase.Messaging" />
    <PackageReference Include="Xamarin.GooglePlayServices.Auth" />
    <PackageReference Include="Xamarin.Google.Dagger" />
    <PackageReference Include="Xamarin.Google.AI.Edge.LiteRT" />
    <PackageReference Include="OpusSharp.Core" />
    <PackageReference Include="OpusSharp.Natives" />
  </ItemGroup>
  <ItemGroup Condition="$(TargetFramework.Contains('-ios'))">
    <PackageReference Include="Plugin.Firebase.Analytics" />
    <PackageReference Include="Plugin.Firebase.CloudMessaging" />
    <PackageReference Include="Plugin.Firebase.Crashlytics" />
    <PackageReference Include="Xamarin.Build.Download" />
    <PackageReference Include="AdamE.Firebase.iOS.Analytics" />
    <PackageReference Include="AdamE.Firebase.iOS.Crashlytics" />
    <PackageReference Include="AdamE.Firebase.iOS.CloudMessaging" />
    <PackageReference Include="ActualLab.Opus.MaciOS" />
  </ItemGroup>
  <ItemGroup Condition="$(TargetFramework.Contains('-maccatalyst'))">
    <PackageReference Include="ActualLab.Opus.MaciOS" />
  </ItemGroup>
  <ItemGroup Condition="$(TargetFramework.Contains('-windows'))">

<!--    <PackageReference Include="Microsoft.ML.OnnxRuntime" />-->
<!--    Commented out as both runtime and DirectML runtime have same biney names -->
<!--    <PackageReference Include="Microsoft.ML.OnnxRuntime">-->
<!--      <ExcludeAssets>runtime</ExcludeAssets>-->
<!--    </PackageReference>-->
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" />
    <!-- Exclude DirectML.dll from this package - it's already in MsixContent via Windows App SDK.
         Must block build/buildTransitive because the package uses custom targets, not runtimes/ layout. -->
    <PackageReference Include="Microsoft.AI.DirectML" ExcludeAssets="build;buildTransitive;native" />
    <PackageReference Include="NAudio" />
    <PackageReference Include="OpusSharp.Core" />
    <PackageReference Include="OpusSharp.Natives" />
  </ItemGroup>

  <!-- Runtime mode — common to every platform.
       .NET 11 dropped the Mono path for Android / iOS / Mac Catalyst, so CoreCLR is the
       only runtime here, exactly as it always was on Windows. That leaves a single
       axis: CoreCLR (+ ReadyToRun in Release) vs. Native AOT. UseNativeAot=true flips
       every TFM to NAOT — see the NAOT block at the end of this file. -->
  <PropertyGroup>
    <UseNativeAot Condition="'$(UseNativeAot)' == ''">false</UseNativeAot>
  </PropertyGroup>

  <!-- R2R exclusions. Release is CoreCLR + composite R2R on every platform, so these apply
       everywhere; inert when UseNativeAot=true since PublishReadyToRun is forced off by the
       common NAOT block at the end.

       Excluding an assembly doesn't drop it from the app - only its precompiled native code,
       so whatever runs anyway is JIT'd (Android / Windows) or interpreted (iOS / Mac Catalyst).

       Only PhoneNumbers is active: the nine other assemblies docs/app-bundles.md identifies
       as cold crashed crossgen2 in ReadyToRunVisibilityRootProvider.AddCompilationRoots
       (NETSDK1096). Re-add them one group at a time - see "Adding an exclusion" there. -->
  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <PublishReadyToRunExclude Include="PhoneNumbers.dll" /> <!-- Phone number parsing / formatting -->
  </ItemGroup>

  <!-- Trimming: trimmer root assemblies apply to both R2R trimming and Native AOT.
       Under NAOT, CodeKeeper keeps reflection-referenced types but ILC still needs every
       ctor/method body preserved for COM/JNI/ObjC activation paths — see the Native AOT
       section below for third-party roots. -->
  <ItemGroup>
    <!--
    <TrimmerRootDescriptor Include="ILLink.Descriptors.xml" />
    -->
    <!-- MAUI services assembly -->
    <TrimmerRootAssembly Include="ActualChat.Maui" RootMode="All" />
    <!-- Other crucial assemblies -->
    <TrimmerRootAssembly Include="ActualChat.Api" RootMode="All" />
    <TrimmerRootAssembly Include="ActualChat.Api.Contracts" RootMode="All" />
    <TrimmerRootAssembly Include="ActualChat.UI.Blazor" RootMode="All" />
    <TrimmerRootAssembly Include="ActualChat.UI.Blazor.App" RootMode="All" />
  </ItemGroup>
  <!-- Windows ILLink needs "ActualChat" (the App.Maui output after AssemblyName=$(BaseName)
       override) explicitly rooted. Android's ILLink (Xamarin.Android linker pipeline) fails
       IL1032 "Root assembly 'ActualChat' could not be found" here because by the time ILLink
       runs the app assembly has been post-processed / renamed upstream — Xamarin.Android
       auto-roots the entry-point assembly anyway, so we don't need this on Android / iOS. -->
  <ItemGroup Condition="$(TargetFramework.Contains('-windows'))">
    <TrimmerRootAssembly Include="ActualChat" RootMode="EntryPoint" />
  </ItemGroup>

  <!-- Common iOS and Android build properties -->
  <PropertyGroup Condition="$(TargetFramework.Contains('-android')) or $(TargetFramework.Contains('-ios'))">
    <!-- Trimmer settings -->
    <EnableUnsafeBinaryFormatterSerialization>false</EnableUnsafeBinaryFormatterSerialization>
    <EnableUnsafeUTF7Encoding>false</EnableUnsafeUTF7Encoding>
    <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
    <EventSourceSupport>false</EventSourceSupport>
    <!-- Slower runtime, but slightly faster startup -->
    <DisableDependencyInjectionDynamicEngine>true</DisableDependencyInjectionDynamicEngine>
  </PropertyGroup>

  <!-- Android build properties -->

  <!-- Android: Signing & framework trimming -->
  <PropertyGroup Condition="$(TargetFramework.Contains('-android'))">
    <AndroidKeyStore>True</AndroidKeyStore>
    <AndroidSigningKeyStore>myapp.keystore</AndroidSigningKeyStore>
    <AndroidSigningKeyAlias>key</AndroidSigningKeyAlias>
    <AndroidSigningKeyPass>password</AndroidSigningKeyPass>
    <AndroidSigningStorePass>password</AndroidSigningStorePass>
    <AndroidUseNegotiateAuthentication>false</AndroidUseNegotiateAuthentication>
  </PropertyGroup>
  <ItemGroup>
    <ProguardConfiguration Include="proguard.cfg" />
  </ItemGroup>

  <!-- Android: Both Debug & Release configurations -->
  <PropertyGroup Condition="$(TargetFramework.Contains('-android'))">
    <!-- Use SocketsHttpHandler (managed) instead of AndroidMessageHandler (JNI-based).
         SocketsHttpHandler supports HTTP/2 and HTTP/3, avoids JNI overhead,
         and is more stable with CoreCLR on Android. -->
    <UseNativeHttpHandler>false</UseNativeHttpHandler>
    <!-- This also ensures debug symbols are there -->
    <DebuggerSupport>true</DebuggerSupport>
  </PropertyGroup>
  <ItemGroup Condition="$(TargetFramework.Contains('-android'))">
    <AndroidEnvironment Include="android-env.txt" />
  </ItemGroup>

  <!-- Android: Debug configuration.
       EmbedAssembliesIntoApk must stay True here, even though the SDK defaults it to False for Debug:
       under CoreCLR that False also turns off the assembly store, leaving Fast Deployment as the only
       assembly source. We deploy via 'adb install', which never populates the FastDev override dir,
       so the APK would ship with no managed assemblies and CoreCLR init would fail with 0x80070002. -->
  <PropertyGroup Condition="$(TargetFramework.Contains('-android')) and '$(Configuration)' == 'Debug'">
    <EmbedAssembliesIntoApk Condition="'$(EmbedAssembliesIntoApk)' == ''">True</EmbedAssembliesIntoApk>
  </PropertyGroup>

  <!-- Our own startup profile - the union of on-device Android and on-desktop Windows
       recordings. Regenerate with /mibc-update, or by hand via
       scripts/Record-{Android,Windows}StartupProfiles.ps1 + scripts/New-StartupMibc.ps1.
       See docs/startup-profiling.md. It reaches crossgen2 as -m:.

       The file carries method *names* only - `dotnet-pgo dump` reports 0 methods with
       block counts, edge counts or class histograms - so it cannot inform block layout or
       devirtualization, and hot-first ordering would need crossgen2's `method-layout`
       switch, which neither we nor the SDK ever pass (it defaults to DefaultSort = off).

       It does still ROOT in a full build - corrected 2026-08-09. This comment previously
       called it useless outside `partial`; that was wrong. ReadyToRunProfilingRootProvider
       is added unconditionally (crossgen2/Program.cs:576), outside the `if (!partial)` that
       guards the other root providers. The old claim rested on profile-listed methods still
       being jitted on Android - which is tier-1 rejit, something this build does ~1,200
       times per cold start. See docs/startup-profiling.md.

       MAUI ships its own generic profiles and adds them to _ReadyToRunPgoFiles alongside
       this one (Microsoft.Maui.Controls.targets, _MauiUseDefaultReadyToRunPgoFiles). What
       does *not* arrive is the runtime pack's tools/StandardOptimizationData.mibc: it is
       absent from RuntimeList.xml, so it is not a `pgodata` asset and
       PublishReadyToRunUseRuntimePackOptimizationData picks up nothing. -->
  <ItemGroup Condition="$(TargetFramework.Contains('-android')) and '$(Configuration)' == 'Release'">
    <PublishReadyToRunPgoFiles Include="$(MSBuildThisFileDirectory)_Profiling\merged.mibc" />
  </ItemGroup>

  <!-- ActualChat.r2r.map.csv, next to the composite: every method crossgen2 actually
       compiled, generic instantiations included. It is the only way to tell a jit event
       that means "no native code existed" from one that means "tier 1 promotion" - the
       distinction the raw jitted-method count hides. Costs build time, not app size.

       On iOS it earns its keep the other way round: there is no jit and no tiering, so
       cross-referencing the map against a -Mode Jit trace names the methods that run
       interpreted for the life of the process. Mostly value-type generic instantiations,
       which a full-mode image cannot enumerate statically. See
       docs/ios-specific.md -> Measuring what runs interpreted. -->
  <PropertyGroup Condition="($(TargetFramework.Contains('-android')) or $(TargetFramework.Contains('-ios'))) and '$(Configuration)' == 'Release'">
    <PublishReadyToRunCrossgen2CompositeExtraArgs>$(PublishReadyToRunCrossgen2CompositeExtraArgs);--mapcsv</PublishReadyToRunCrossgen2CompositeExtraArgs>
  </PropertyGroup>

  <!-- Android: Release configuration (CoreCLR + composite R2R). The common NAOT
       block at the end overrides PublishTrimmed / TrimMode / PublishReadyToRun* when
       UseNativeAot=true, so this block always applies in Release. -->
  <PropertyGroup Condition="$(TargetFramework.Contains('-android')) and '$(Configuration)' == 'Release'">
    <RuntimeIdentifiers>android-arm64</RuntimeIdentifiers>
    <!-- Trimming -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <!-- ReadyToRun: composite, partial per UsePartialR2R above. Android is the one target
         where partial is also MAUI's own default - Microsoft.Maui.Controls.targets appends
         crossgen2's `partial` switch unless _MauiPublishReadyToRunPartial is false, and
         feeds crossgen2 its generic .mibc files alongside ours. (That file lives in the
         microsoft.maui.controls.build.tasks NuGet package, not under dotnet/packs - grep
         the package cache too before concluding the property is unused.)

         18.6MB composite / 35.8k methods compiled, against 111.4MB / 362.6k for full. Not
         merely smaller: crossgen2 roots from the profile in partial mode and ignores it
         entirely in full mode, so exact generic instantiations that full silently skips -
         the ArrayPoolBuffer<byte> / RadixHeapSet<GenericTimeoutSlot> shapes - get compiled
         here and do not on a full build. -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishReadyToRunComposite>true</PublishReadyToRunComposite>
    <_MauiPublishReadyToRunPartial>$(UsePartialR2R)</_MauiPublishReadyToRunPartial>
    <!-- -50ms to startup time: -->
    <AndroidGenerateJniMarshalMethods>true</AndroidGenerateJniMarshalMethods>
    <!-- Must be commented out: r8/d8 is the default now, specifying them explicitly
         triggers MSB6002: The command-line for the "R8" task is too long.
    <AndroidDexTool>d8</AndroidDexTool>
    <AndroidLinkTool>r8</AndroidLinkTool>
    -->
    <!-- When true, fails with No implementation found for void crc6444c698770736d3d5.MainApplication.n_OnAppForegrounded()
    <AndroidEnableMarshalMethods>false</AndroidEnableMarshalMethods>
    -->
  </PropertyGroup>

  <!-- Android: Tracing mode — records a .nettrace that _Profiling/CreateMibc-A.cmd turns
       into the .mibc fed to crossgen2 via PublishReadyToRunPgoFiles above.
       Applies to Release too: Build-Tracing-AR.cmd records against the trimmed +
       R2R'd assemblies the app actually ships, which is what the profile describes. -->
  <PropertyGroup Condition="$(IsTracingEnabled) and $(TargetFramework.Contains('-android'))">
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies> <!-- Required to produce .mibc -->
    <AndroidEnableProfiler>true</AndroidEnableProfiler>
  </PropertyGroup>
  <ItemGroup Condition="$(IsTracingEnabled) and $(TargetFramework.Contains('-android'))">
    <AndroidEnvironment Include="android-tracing-env.txt" />
  </ItemGroup>

  <!-- Non-generic ArgumentList variants only: the generic ones cost an instantiation per arity
       in every AOT/R2R image, and the trimmer can drop them entirely once this is off.
       Trim="true" makes it a trimmer feature switch, not just a runtime one. -->
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="ArgumentList.AllowGenerics" Value="false" Trim="true" />
  </ItemGroup>

  <!-- iOS: startup profile. The opposite purpose to Android's. There a profile SHRINKS the
       image (a miss costs one jit); here a miss is interpreted for the life of the process,
       so the profile exists to ADD what a full build cannot enumerate statically: value-type
       generic instantiations, async state-machine boxes, and the reflection-created
       serializers / converters / interception types nothing references from code.

       ios-interactive.mibc is a device recording of a real session (chats + recording +
       call paths), not a synthetic launch - a launch-only profile leaves the audio paths
       interpreted. Re-record per docs/ios-specific.md -> Measuring what runs interpreted.

       aothelper.mibc is the static counterpart, emitted by update-aot-helpers.cmd from the
       CodeKeeper type set plus what ActualLab's proxy keepers and the async machinery build
       reflectively. A recording only covers what that session ran and goes stale as the code
       moves; this is regenerated from the current tree. On its own it reaches 99.3% of the
       methods the two recordings cover, so it is the safety net when they age - not a
       replacement, since it cannot know which instantiations actually run.

       Measured 2026-08-09 on device: interpreted methods 2835 -> 140 (-95%), compiled
       324,076 -> 328,066, bundle 268MB -> 269MB. The residue is objc_msgSend stubs and
       runtime-emitted accessors, neither of which can ever be precompiled. -->
  <ItemGroup Condition="$(TargetFramework.Contains('-ios')) and '$(Configuration)' == 'Release'">
    <PublishReadyToRunPgoFiles Include="$(MSBuildThisFileDirectory)_Profiling\ios-interactive.mibc" />
    <PublishReadyToRunPgoFiles Include="$(MSBuildThisFileDirectory)_Profiling\merged.mibc" />
    <PublishReadyToRunPgoFiles Include="$(MSBuildThisFileDirectory)_Profiling\aothelper.mibc" />
  </ItemGroup>

  <!-- Apple build properties -->

  <!-- Apple: trimming. The macios SDK always runs the trimmer and rejects an explicit
       PublishTrimmed outright ("iOS projects do not support setting 'PublishTrimmed'"),
       so MtouchLink stays the knob here - None / SdkOnly / Full. The NAOT block at the
       end raises it to Full. -->
  <PropertyGroup Condition="($(TargetFramework.Contains('-ios')) or $(TargetFramework.Contains('-maccatalyst'))) and !($(UseNativeAot) and '$(Configuration)' == 'Release')">
    <MtouchLink>SdkOnly</MtouchLink>
  </PropertyGroup>

  <!-- Despite the name, this does NOT turn the CoreCLR interpreter on or off on Apple targets -
       the interpreter is always present and is the only code generator there (no JIT is linked
       into libcoreclr for ios-arm64). All this property does is gate DynamicCodeSupport, i.e.
       RuntimeFeature.IsDynamicCodeSupported: the macios SDK aliases it to MtouchInterpreter,
       which the linker discards outright when the runtime isn't MonoVM.
       False keeps libraries on their static paths - which is what avoids dotnet/runtime#130840,
       since the fault needs a library to build an open-instance delegate in the first place.
       See docs/ios-specific.md before changing this. -->
  <PropertyGroup Condition="$(TargetFramework.Contains('-ios'))">
    <UseInterpreter>false</UseInterpreter>
  </PropertyGroup>

  <!-- iOS: Both Debug & Release configurations -->
  <PropertyGroup Condition="$(TargetFramework.Contains('-ios'))">
    <RuntimeIdentifier>ios-arm64</RuntimeIdentifier>
    <IntermediateOutputPath>..\..\..\artifacts\out</IntermediateOutputPath>
    <UseShortFileNames>True</UseShortFileNames>
    <CodesignEntitlements Condition="'$(IsDevMaui)' == 'true'">Platforms\iOS\Entitlements.dev.plist</CodesignEntitlements>
    <CodesignEntitlements Condition="'$(IsDevMaui)' != 'true'">Platforms\iOS\Entitlements.prod.plist</CodesignEntitlements>
    <VoxtIosAppManifest>$(MSBuildThisFileDirectory)Platforms\iOS\Info.plist</VoxtIosAppManifest>
    <!-- Performance-related -->
    <UseNativeHttpHandler>true</UseNativeHttpHandler>

    <!-- Was false, per https://github.com/AdamEssenmacher/GoogleApisForiOSComponents?tab=readme-ov-file#firebase-crashlytics,
         but that leaves the main executable exporting no symbols at all. Mono resolved
         DllImport("__Internal") anyway; CoreCLR doesn't, so .NET 11 crashes on the very first
         P/Invoke - DllNotFoundException '__Internal' out of Foundation.NSObject's cctor. -->
    <_ExportSymbolsExplicitly>true</_ExportSymbolsExplicitly>

    <SkipStaticLibraryValidation>true</SkipStaticLibraryValidation>

  </PropertyGroup>

  <!-- iOS: Debug configuration -->
  <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net11.0-ios|AnyCPU'">
    <CreatePackage>false</CreatePackage>
    <CodesignProvision>chat.actual.dev.app</CodesignProvision>
    <CodesignKey>iPhone Developer</CodesignKey>
    <ProvisioningType>manual</ProvisioningType>
  </PropertyGroup>

  <!-- iOS: Release configuration (CoreCLR + composite R2R; there's no JIT on device, so
       whatever R2R doesn't cover runs on CoreCLR's interpreter)

       Keep this FULL. Android and Windows moved to mibc-driven partial R2R for the size
       win, and the reasoning does not carry over: there, anything left out of the image is
       jitted, so a miss costs one compilation. Here a miss is interpreted for the life of
       the process, which is far worse than the bytes are worth. Nothing switches Apple
       targets to partial today - MAUI's default is Android-only - so this is a warning
       against "making it consistent", not a setting. -->

  <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net11.0-ios|AnyCPU'">
    <CodesignProvision Condition="'$(IsDevMaui)' == 'true'">App Store Dev</CodesignProvision>
    <CodesignProvision Condition="'$(IsDevMaui)' != 'true'">App Store 2</CodesignProvision>
    <CodesignKey>Apple Distribution: Actual Chat Inc. (M287G8G83F)</CodesignKey>
    <ArchiveOnBuild>true</ArchiveOnBuild>
    <CreatePackage>false</CreatePackage>
  </PropertyGroup>

  <!-- Push to Talk is dev-only until it's been tested: the prod entitlements drop
       com.apple.developer.push-to-talk, and Info.plist's push-to-talk background mode is
       stripped for prod by the ipa workflow. Claiming either without a working feature is what
       App Store review guidelines 2.3.1 (hidden features) and 2.5.4 (background modes serving
       their declared purpose) are about, and the two must agree - an entitlement-less app that
       still declares the background mode is the mismatch a reviewer would find. -->
  <Target Name="VerifyIosProdCapabilities" BeforeTargets="_CompileAppManifest"
          Condition="'$(IsDevMaui)' != 'true' and $(TargetFramework.Contains('-ios'))">
    <Error Condition="$([System.IO.File]::ReadAllText($(VoxtIosAppManifest)).Contains('push-to-talk'))"
           Text="A prod build must not declare the push-to-talk background mode - the prod entitlements don't grant it. Strip it from Platforms/iOS/Info.plist (the ipa workflow does this)." />
  </Target>

  <!-- MacCatalyst build properties -->

  <!-- Entitlements are selected by IsDevMaui (not Configuration) — same App Store
       entitlement set is used for Debug and Release, matching iOS. -->
  <PropertyGroup Condition="$(TargetFramework.Contains('-maccatalyst'))">
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">maccatalyst-arm64</RuntimeIdentifier>
    <CodesignEntitlements Condition="'$(IsDevMaui)' == 'true'">Platforms\MacCatalyst\Entitlements.dev.plist</CodesignEntitlements>
    <CodesignEntitlements Condition="'$(IsDevMaui)' != 'true'">Platforms\MacCatalyst\Entitlements.prod.plist</CodesignEntitlements>
    <UseNativeHttpHandler>true</UseNativeHttpHandler>
  </PropertyGroup>

  <!-- Debug: Apple Development cert + development profile (mirrors iOS Debug).
       Profile names below must exist in Apple Developer Console as Mac Catalyst
       subtype; the developer's Mac must be a registered device on them. -->
  <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net11.0-maccatalyst|AnyCPU'">
    <CreatePackage>false</CreatePackage>
    <CodesignProvision Condition="'$(IsDevMaui)' == 'true'">mac.chat.actual.dev.app</CodesignProvision>
    <CodesignProvision Condition="'$(IsDevMaui)' != 'true'">mac.chat.actual.app</CodesignProvision>
    <CodesignKey>Apple Development</CodesignKey>
    <ProvisioningType>manual</ProvisioningType>
    <EnableCodeSigning>true</EnableCodeSigning>
  </PropertyGroup>

  <!-- Release: App Store / TestFlight signed. Profiles below MUST be the "Mac" type,
       not "Mac Catalyst" — the latter makes dyld reject @rpath for embedded .frameworks
       and crashes the app at launch (dotnet/macios#14686).
       CreatePackage + EnablePackageSigning let the SDK build & sign the .pkg directly. -->
  <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net11.0-maccatalyst|AnyCPU'">
    <CodesignProvision Condition="'$(IsDevMaui)' == 'true'">Mac App Store Dev</CodesignProvision>
    <CodesignProvision Condition="'$(IsDevMaui)' != 'true'">Mac App Store</CodesignProvision>
    <CodesignKey>Apple Distribution: Actual Chat Inc. (M287G8G83F)</CodesignKey>
    <PackageSigningKey>3rd Party Mac Developer Installer: Actual Chat Inc. (M287G8G83F)</PackageSigningKey>
    <EnableCodeSigning>true</EnableCodeSigning>
    <EnablePackageSigning>true</EnablePackageSigning>
    <CreatePackage>true</CreatePackage>
  </PropertyGroup>

  <!-- Windows build properties -->

  <!-- The MSIX packaging targets default this to $(ProjectDir)AppPackages\, which is the one
       build output that escaped the artifacts/ convention - and it isn't gitignored, so a
       packaged build leaves ~300MB staged under source control. -->
  <PropertyGroup Condition="$(TargetFramework.Contains('-windows'))">
    <AppxPackageDir>$(ArtifactsPath)\AppPackages\</AppxPackageDir>
