"NSMicrophoneUsageDescription" = "குரல் செய்திகளைப் பதிவுசெய்ய மைக்ரோஃபோன் அணுகல் தேவை";
"NSCameraUsageDescription" = "படங்களை எடுத்து மற்ற பயனர்களுடன் பகிர கேமரா அணுகல் தேவை.";
"NSPhotoLibraryUsageDescription" = "மற்ற பயனர்களுடன் பகிர அல்லது உங்கள் அவதாரத்தை மாற்ற படங்களைப் பதிவேற்றுங்கள்.";
"NSPhotoLibraryAddUsageDescription" = "உங்கள் கேலரியிலிருந்து புகைப்படங்களையும் வீடியோக்களையும் பகிருங்கள்.";
"NSContactsUsageDescription" = "ஏற்கனவே Voxt பயன்படுத்தும் நண்பர்களை உங்கள் தொடர்புப் பட்டியலில் கண்டறிய உதவ இந்தத் தகவலைச் சேகரிக்கிறோம். தொடர்புகளுக்கான அணுகலை அனுமதித்தால், தொடர்புகளின் பெயர்களையும் அவர்களின் தொலைபேசி எண்கள் மற்றும் மின்னஞ்சல் முகவரிகளின் ஹாஷ்களையும் எங்கள் சர்வர்களுக்கு அனுப்புவோம்.";
"NSLocationWhenInUseUsageDescription" = "இருப்பிடப் பகிர்வு இயக்கத்தில் இருக்கும்போது உங்கள் நேரலை இருப்பிடத்தை அரட்டை உறுப்பினர்களுடன் பகிருங்கள்.";
"NSLocationUsageDescription" = "இருப்பிடப் பகிர்வு இயக்கத்தில் இருக்கும்போது உங்கள் நேரலை இருப்பிடத்தை அரட்டை உறுப்பினர்களுடன் பகிருங்கள்.";
"NSFocusStatusUsageDescription" = "உறக்கம் அல்லது தொந்தரவு செய்யாதே போன்ற ஃபோகஸ் பயன்முறை இயக்கத்தில் உள்ளதா என்பதை Voxt பார்க்க அனுமதிக்கிறது, இதனால் புஷ்-டு-டாக் சத்தமாக ஒலிக்காமல் அமைதியாக இருக்கும்.";
