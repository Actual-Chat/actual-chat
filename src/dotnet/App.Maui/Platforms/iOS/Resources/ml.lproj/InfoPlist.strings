"NSMicrophoneUsageDescription" = "വോയ്‌സ് സന്ദേശങ്ങൾ റെക്കോർഡ് ചെയ്യാൻ മൈക്രോഫോൺ ആക്സസ് ആവശ്യമാണ്";
"NSCameraUsageDescription" = "ഫോട്ടോകൾ എടുത്ത് മറ്റ് ഉപയോക്താക്കളുമായി പങ്കിടാൻ ക്യാമറ ആക്സസ് ആവശ്യമാണ്.";
"NSPhotoLibraryUsageDescription" = "മറ്റ് ഉപയോക്താക്കളുമായി പങ്കിടാനോ നിങ്ങളുടെ അവതാർ മാറ്റാനോ ചിത്രങ്ങൾ അപ്‌ലോഡ് ചെയ്യുക.";
"NSPhotoLibraryAddUsageDescription" = "നിങ്ങളുടെ ഗാലറിയിൽ നിന്ന് ഫോട്ടോകളും വീഡിയോകളും പങ്കിടുക.";
"NSContactsUsageDescription" = "ഇതിനകം Voxt ഉപയോഗിക്കുന്ന സുഹൃത്തുക്കളെ നിങ്ങളുടെ കോൺടാക്റ്റ് ലിസ്റ്റിൽ കണ്ടെത്താൻ സഹായിക്കാനാണ് ഞങ്ങൾ ഈ വിവരം ശേഖരിക്കുന്നത്. നിങ്ങൾ കോൺടാക്റ്റുകളിലേക്ക് ആക്സസ് അനുവദിച്ചാൽ, കോൺടാക്റ്റുകളുടെ പേരുകളും അവരുടെ ഫോൺ നമ്പറുകളുടെയും ഇമെയിൽ വിലാസങ്ങളുടെയും ഹാഷുകളും ഞങ്ങളുടെ സെർവറുകളിലേക്ക് അയയ്ക്കും.";
"NSLocationWhenInUseUsageDescription" = "ലൊക്കേഷൻ പങ്കിടൽ ഓണായിരിക്കുമ്പോൾ നിങ്ങളുടെ തത്സമയ ലൊക്കേഷൻ ചാറ്റ് അംഗങ്ങളുമായി പങ്കിടുക.";
"NSLocationUsageDescription" = "ലൊക്കേഷൻ പങ്കിടൽ ഓണായിരിക്കുമ്പോൾ നിങ്ങളുടെ തത്സമയ ലൊക്കേഷൻ ചാറ്റ് അംഗങ്ങളുമായി പങ്കിടുക.";
"NSFocusStatusUsageDescription" = "ഉറക്കം അല്ലെങ്കിൽ ശല്യപ്പെടുത്തരുത് പോലുള്ള ഫോക്കസ് മോഡ് ഓണാണോ എന്ന് കാണാൻ Voxt-നെ അനുവദിക്കുന്നു, അതിനാൽ പുഷ്-ടു-ടോക്ക് ഉച്ചത്തിൽ പ്ലേ ചെയ്യുന്നതിന് പകരം നിശ്ശബ്ദമായിരിക്കും.";
