            tensor<int32, [1]> var_143_dilations_0 = const()[name = string("op_143_dilations_0"), val = tensor<int32, [1]>([1])];
            int32 var_143_groups_0 = const()[name = string("op_143_groups_0"), val = int32(1)];
            tensor<fp32, [1, 128, 1]> var_143 = conv(bias = core_conv_d_bias, dilations = var_143_dilations_0, groups = var_143_groups_0, pad = var_143_pad_0, pad_type = var_143_pad_type_0, strides = var_143_strides_0, weight = core_conv_d_weight, x = input_13)[name = string("op_143")];
            tensor<fp32, [1, 128, 1]> input_conv = relu(x = var_143)[name = string("input_conv")];
            tensor<int32, [1]> x8_axes_0 = const()[name = string("x8_axes_0"), val = tensor<int32, [1]>([-1])];
            tensor<fp32, [1, 128]> x8 = squeeze(axes = x8_axes_0, x = input_conv)[name = string("x8")];
            tensor<int32, [1]> h_prev_axes_0 = const()[name = string("h_prev_axes_0"), val = tensor<int32, [1]>([0])];
            tensor<fp32, [1, 128]> h_prev = squeeze(axes = h_prev_axes_0, x = h)[name = string("h_prev")];
            tensor<int32, [1]> c_prev_axes_0 = const()[name = string("c_prev_axes_0"), val = tensor<int32, [1]>([0])];
            tensor<fp32, [1, 128]> c_prev = squeeze(axes = c_prev_axes_0, x = c)[name = string("c_prev")];
            tensor<fp32, [512, 128]> var_154_weight_0 = const()[name = string("op_154_weight_0"), val = tensor<fp32, [512, 128]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(712000)))];
            tensor<fp32, [512]> var_154_bias_0 = const()[name = string("op_154_bias_0"), val = tensor<fp32, [512]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(974208)))];
            tensor<fp32, [1, 512]> var_154 = linear(bias = var_154_bias_0, weight = var_154_weight_0, x = x8)[name = string("op_154")];
