[buildInfo = dict<string, string>({{"coremlc-component-MIL", "3405.2.1"}, {"coremlc-version", "3404.23.1"}, {"coremltools-component-torch", "2.8.0"}, {"coremltools-source-dialect", "TorchScript"}, {"coremltools-version", "9.0b1"}})]
{
    func main<ios18>(tensor<fp32, [1, 1, 128]> c, tensor<fp32, [1, 64]> context, tensor<fp32, [1, 1, 128]> h, tensor<fp32, [1, 512]> input) {
            tensor<fp32, [258]> core_front_conv_bias = const()[name = string("core_front_conv_bias"), val = tensor<fp32, [258]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(64)))];
