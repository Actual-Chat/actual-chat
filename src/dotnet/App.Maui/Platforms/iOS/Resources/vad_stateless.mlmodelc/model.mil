            tensor<fp32, [1, 64, 2]> var_118 = conv(bias = core_conv_b_bias, dilations = var_118_dilations_0, groups = var_118_groups_0, pad = var_118_pad_0, pad_type = var_118_pad_type_0, strides = var_118_strides_0, weight = core_conv_b_weight, x = input_9)[name = string("op_118")];
            tensor<fp32, [1, 64, 2]> input_11 = relu(x = var_118)[name = string("input_11")];
