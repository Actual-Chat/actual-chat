            tensor<fp32, [1, 129, 4]> var_67 = slice_by_index(begin = var_67_begin_0, end = var_67_end_0, end_mask = var_67_end_mask_0, x = ft)[name = string("op_67")];
            tensor<int32, [3]> var_82_begin_0 = const()[name = string("op_82_begin_0"), val = tensor<int32, [3]>([0, 129, 0])];
