            tensor<fp32, [1, 64, 1]> input_13 = relu(x = var_131)[name = string("input_13")];
            string var_143_pad_type_0 = const()[name = string("op_143_pad_type_0"), val = string("custom")];
            tensor<int32, [2]> var_143_pad_0 = const()[name = string("op_143_pad_0"), val = tensor<int32, [2]>([1, 1])];
