            string var_105_pad_type_0 = const()[name = string("op_105_pad_type_0"), val = string("custom")];
            tensor<int32, [2]> var_105_pad_0 = const()[name = string("op_105_pad_0"), val = tensor<int32, [2]>([1, 1])];
