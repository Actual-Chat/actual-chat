            tensor<fp32, [1, 1]> var_195 = squeeze(axes = var_195_axes_0, x = y)[name = string("op_195")];
            tensor<int32, [1]> var_200_axes_0 = const()[name = string("op_200_axes_0"), val = tensor<int32, [1]>([1])];
