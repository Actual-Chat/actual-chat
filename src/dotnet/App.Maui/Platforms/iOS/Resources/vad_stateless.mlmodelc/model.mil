            tensor<fp32, [1, 128, 4]> var_105 = conv(bias = core_conv_a_bias, dilations = var_105_dilations_0, groups = var_105_groups_0, pad = var_105_pad_0, pad_type = var_105_pad_type_0, strides = var_105_strides_0, weight = core_conv_a_weight, x = input_7)[name = string("op_105")];
            tensor<fp32, [1, 128, 4]> input_9 = relu(x = var_105)[name = string("input_9")];
            string var_118_pad_type_0 = const()[name = string("op_118_pad_type_0"), val = string("custom")];
            tensor<int32, [2]> var_118_pad_0 = const()[name = string("op_118_pad_0"), val = tensor<int32, [2]>([1, 1])];
