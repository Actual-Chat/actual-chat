<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Store / TestFlight: sandbox required -->
	<key>com.apple.security.app-sandbox</key>
	<true/>

	<!-- Bundle identity (mirrors iOS dev entitlements) -->
	<key>application-identifier</key>
	<string>M287G8G83F.chat.actual.dev.app</string>
	<key>com.apple.developer.team-identifier</key>
	<string>M287G8G83F</string>

	<!-- Shared Keychain access group — matches iOS so session can be shared with the iOS app -->
	<key>keychain-access-groups</key>
	<array>
		<string>M287G8G83F.chat.actual.dev.app.shared</string>
	</array>

	<!-- Sign in with Apple -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>

	<!-- Universal links (associated domains) — dev hosts only -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:dev.voxt.ai</string>
		<string>applinks:dev.actual.chat</string>
	</array>

	<!-- Sandbox-gated runtime capabilities -->
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<key>com.apple.security.device.camera</key>
	<true/>
	<key>com.apple.security.personal-information.photos-library</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
</dict>
</plist>
