<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework Condition="!$([MSBuild]::IsOSPlatform('osx'))">net10.0</TargetFramework>
    <TargetFramework Condition="$([MSBuild]::IsOSPlatform('osx'))">net10.0-ios</TargetFramework>
    <OutputType>Library</OutputType>
    <UseMauiEssentials Condition="$(TargetFramework.Contains('-ios'))">true</UseMauiEssentials>
    <SingleProject Condition="$(TargetFramework.Contains('-ios'))">true</SingleProject>

    <ApplicationId>chat.actual.app.share</ApplicationId>
    <ApplicationTitle>Voxt</ApplicationTitle>

    <IsAppExtension>True</IsAppExtension>
    <IsWatchExtension>False</IsWatchExtension>
    <Registrar>static</Registrar>

<!--    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>-->
<!--    <ApplicationVersion>1</ApplicationVersion>-->

    <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('-ios'))">16.4</SupportedOSPlatformVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsDevMaui)' == ''">
    <IsDevMaui>true</IsDevMaui>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsDevMaui)' == 'true'">
    <DefineConstants>$(DefineConstants);IS_DEV_MAUI</DefineConstants>
    <ApplicationId>chat.actual.dev.app.share</ApplicationId>
    <ApplicationTitle>Voxt (Dev)</ApplicationTitle>
  </PropertyGroup>

  <!-- Build properties -->
  <!-- Both: Debug & Release configuration -->
  <PropertyGroup Condition="$(TargetFramework.Contains('-ios'))">
    <RuntimeIdentifier>ios-arm64</RuntimeIdentifier>
    <CodesignEntitlements Condition="'$(IsDevMaui)' == 'true'">Entitlements.dev.plist</CodesignEntitlements>
    <CodesignEntitlements Condition="'$(IsDevMaui)' != 'true'">Entitlements.prod.plist</CodesignEntitlements>
    <MtouchLink>SdkOnly</MtouchLink>
    <FirebaseCrashlyticsUploadSymbolsEnabled>false</FirebaseCrashlyticsUploadSymbolsEnabled>
  </PropertyGroup>

  <!-- Debug configuration -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <CodesignProvision>chat.actual.dev.app.share</CodesignProvision>
    <UseInterpreter>true</UseInterpreter>
  </PropertyGroup>

  <!-- Release configuration (default — Mono + interpreter; NAOT block below overrides) -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <CodesignProvision Condition="'$(IsDevMaui)' == 'true'">App Store Share Dev</CodesignProvision>
    <CodesignProvision Condition="'$(IsDevMaui)' != 'true'">App Store Share</CodesignProvision>
    <CodesignKey>Apple Distribution: Actual Chat Inc. (M287G8G83F)</CodesignKey>
    <UseInterpreter>true</UseInterpreter>
    <MTouchInterpreter>-ActualChat</MTouchInterpreter>
  </PropertyGroup>

  <!-- Environment -->
  <PropertyGroup>
    <FixedEnvironment Condition="'$(FixedEnvironment)' == ''" />
    <!-- Produces tons of misleading warnings if true! -->
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
  </PropertyGroup>
  <PropertyGroup Condition="'$(FixedEnvironment)' == 'Production'">
    <DefineConstants>$(DefineConstants);IS_PRODUCTION_ENV</DefineConstants>
  </PropertyGroup>


  <ItemGroup Condition="$(TargetFramework.Contains('-ios'))">
    <BundleResource Include="..\..\..\resources\images\converted\error-barrier-image.png" Link="%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- TODO: Move GoogleService-Info.plist files to Maui project and define BundleResource there,
       so both App.Maui and App.Maui.IosShareExt inherit it without duplication.
       Alternatively, move them to a shared non-project folder (e.g. resources/) -->
  <ItemGroup Condition="'$(IsDevMaui)' == 'true' AND $(TargetFramework.Contains('-ios'))">
    <BundleResource Include="..\App.Maui\Platforms\iOS\GoogleService-Info.plist.dev" Link="GoogleService-Info.plist" />
  </ItemGroup>
  <ItemGroup Condition="'$(IsDevMaui)' != 'true' AND $(TargetFramework.Contains('-ios'))">
    <BundleResource Include="..\App.Maui\Platforms\iOS\GoogleService-Info.plist.prod" Link="GoogleService-Info.plist" />
  </ItemGroup>

  <ItemGroup Condition="$(TargetFramework.Contains('-ios'))">
    <ProjectReference Include="..\Api.Contracts\Api.Contracts.csproj" />
    <ProjectReference Include="..\Maui\Maui.csproj" />
  </ItemGroup>

  <ItemGroup Condition="$(TargetFramework.Contains('-ios'))">
    <PackageReference Include="Microsoft.Maui.Essentials" />
  </ItemGroup>

  <!-- Native AOT — mirrors App.Maui.csproj; keep in sync -->
  <PropertyGroup>
    <UseNativeAot Condition="'$(UseNativeAot)' == ''">false</UseNativeAot>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release' and $(UseNativeAot) and $(TargetFramework.Contains('-ios'))">
    <PublishAot>true</PublishAot>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <IlcGenerateStackTraceData>false</IlcGenerateStackTraceData>
    <IlcDisableReflection>false</IlcDisableReflection>
    <IlcTrimMetadata>false</IlcTrimMetadata>

    <RunAOTCompilation>false</RunAOTCompilation>
    <PublishReadyToRun>false</PublishReadyToRun>
    <UseInterpreter>false</UseInterpreter>
    <MtouchLink>Full</MtouchLink>

    <!-- NativeAOT requires the managed-static registrar (default 'static' is rejected) -->
    <Registrar>managed-static</Registrar>
  </PropertyGroup>

  <!-- Workaround for excluding C# files from compilation for non-iOS targets -->
  <ItemGroup Condition="!$(TargetFramework.Contains('-ios'))">
    <Using Remove="@(Using)" />
    <Compile Remove="**\*.cs"/>
    <None Include="**\*.cs" Exclude="$(DefaultItemExcludes);$(DefaultExcludesInProjectFolder)"/>
  </ItemGroup>

</Project>
