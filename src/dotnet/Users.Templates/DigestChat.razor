@using ActualChat.Localization
@using ActualChat.Mjml.Blazor.Components
@using ActualChat.Mjml.Blazor.Enums
@namespace ActualChat.Users.Templates
@inherits EmailTemplateBase

<MjmlSection
    Padding="5px 10px"
    FullWidth="MjmlSectionFullWidth.FullWidth">
    <MjmlColumn
        CssClass="message-border">
        <MjmlText
            Padding="10px"
            FontWeight="500"
            FontSize="16px">
            @Chat.Name
        </MjmlText>
        @foreach (var bulletPoint in Chat.BulletPoints) {
            <MjmlText
                Padding="0 10px 5px 10px"
                FontWeight="300"
                Color="#1C1C1C"
                FontSize="16px">
                @bulletPoint
            </MjmlText>
        }
        @if (Chat.UnreadCount > 0) {
            <DigestButton
                Link="@Chat.Link">
                @L.EmailDigest_OpenUnread(Chat.UnreadCount, Chat.UnreadCount, Chat.Name)
            </DigestButton>
        } else {
            <DigestButton
                Link="@Chat.Link">
                @L.EmailDigest_OpenChat_Format(Chat.Name)
            </DigestButton>
        }
    </MjmlColumn>
</MjmlSection>

@code {
    [Parameter, EditorRequired] public DigestParameters.DigestChat Chat { get; set; } = null!;
}
