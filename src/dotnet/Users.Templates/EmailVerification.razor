@using ActualChat.Localization
@using ActualChat.Mjml.Blazor.Components
@using ActualChat.Mjml.Blazor.Enums
@namespace ActualChat.Users.Templates
@inherits EmailTemplateBase
@{
    var imgSrc = $"https://{Constants.Hosts.Voxt}/dist/images/emails/email-cat.png";
}

<EmailBody>
    <MjmlImage
        Align="MjmlImageAlign.Center"
        Width="221px"
        Src="@imgSrc">
    </MjmlImage>
    <MjmlText
        Align="MjmlTextAlign.Center"
        FontFamily="Arial"
        CssClass="gradient-text"
        FontSize="28px"
        FontWeight="600"
        LineHeight="30px"
        Color="#AE00CA">
        @L.EmailCode_Title
    </MjmlText>
    <MjmlText
        Align="MjmlTextAlign.Center"
        FontFamily="Arial"
        FontSize="14px"
        FontWeight="400"
        LineHeight="20px"
        Color="#1C1C1C">
        @L.EmailCode_Prompt_Format(CoreConstants.AppName)
    </MjmlText>
    <MjmlText
        Align="MjmlTextAlign.Center"
        FontFamily="Arial"
        FontSize="28px"
        FontWeight="700"
        LetterSpacing="10px"
        LineHeight="30px"
        Color="#1C1C1C">
        @Token
    </MjmlText>
    <MjmlText
        Align="MjmlTextAlign.Center"
        FontSize="14px"
        FontWeight="400"
        LineHeight="20px"
        FontFamily="Arial"
        Color="#1C1C1C">
        @L.EmailCode_Warning
    </MjmlText>
</EmailBody>

@code {
    [Parameter, EditorRequired] public string Token { get; set; } = null!;
}
