@using ActualChat.Localization
@using ActualChat.Mjml.Blazor.Components
@using ActualChat.Mjml.Blazor.Enums
@namespace ActualChat.Users.Templates
@inherits EmailTemplateBase

<EmailBody>
    <ChildContent>
        @if (Parameters.UnreadChats.Any()) {
            @foreach (var chat in Parameters.UnreadChats) {
                <DigestChat Chat="chat" />
            }
            @if (Parameters.OtherUnreadCount > 0) {
                <DigestButton
                    Link="@Parameters.OtherUnreadLink"
                    WithGradient="true">
                    @L.EmailDigest_OtherUnread(Parameters.OtherUnreadCount, Parameters.OtherUnreadCount)
                </DigestButton>
            }
        }
    </ChildContent>
    <Footer>
        <MjmlText
            Align="MjmlTextAlign.Center"
            FontSize="12px"
            FontWeight="400"
            FontFamily="Arial"
            LineHeight="14px"
            Color="#A0A0A0">
            @L.EmailDigest_Reason_Format(CoreConstants.AppName)
            <a href="@Parameters.UnsubscribeLink" style="color: #A0A0A0;">@L.EmailDigest_TurnOff</a>
        </MjmlText>
    </Footer>
</EmailBody>

@code {
    [Parameter, EditorRequired] public DigestParameters Parameters { get; set; } = null!;
}
