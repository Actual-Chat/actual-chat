<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MemoryPack" />
    <PackageReference Include="CommunityToolkit.HighPerformance" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
    <PackageReference Include="Microsoft.JSInterop" />
    <PackageReference Include="SauceControl.Blake2Fast" />
    <PackageReference Include="Ulid" />
  </ItemGroup>

  <!-- ActualLab packages - Fusion, Rpc, etc. -->
  <ItemGroup>
    <PackageReference Include="ActualLab.Core" />
    <PackageReference Include="ActualLab.Interception" />
    <PackageReference Include="ActualLab.Rpc" />
    <PackageReference Include="ActualLab.CommandR" />
    <PackageReference Include="ActualLab.Fusion" />
  </ItemGroup>

  <!-- Workaround: MessagePack 3.x analyzer/source generator crashes (StackOverflow) on types
       with self-referencing generic constraints like IAdditionOperators<T, T, T> (Trimmed<T>).
       See: https://github.com/MessagePack-CSharp/MessagePack-CSharp/issues/2133 -->
  <Target Name="DisableMessagePackSourceGenerator" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Analyzer Remove="@(Analyzer)" Condition="'%(Filename)' == 'MessagePack.SourceGenerator' Or '%(Filename)' == 'MessagePack.Analyzers.CodeFixes'" />
    </ItemGroup>
  </Target>

</Project>
