# Name of this relay: the part before ".edge." in its host name (kz1 for kz1.edge.voxt.ai)
RELAY_ID=kz1
# Where RPC traffic goes: the origin's host name and port
RELAY_ORIGIN=voxt.ai:443
# Signs the client IP. Per relay, random, at least 32 bytes; the origin holds a copy.
# Generate with: openssl rand -base64 32
RELAY_KEY=
