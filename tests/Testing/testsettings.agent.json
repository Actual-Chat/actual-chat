      // Enable mesh/sharding logging
      "ActualChat.Mesh": "Debug",
      "ActualChat.Sharding": "Debug",
      "ActualChat.Redis": "Debug",
      "Microsoft.Hosting.Lifetime": "Warning",
      "NATS.Client.Core": "Warning",
      "NATS.Client": "Warning"
    }
  }
}
