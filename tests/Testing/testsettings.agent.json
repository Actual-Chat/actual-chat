{
  // Claude mode settings - enables detailed logging for debugging
  // These override AddTestLogging filters where applicable
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft": "Warning",
      "Microsoft.EntityFrameworkCore.Database": "Warning",
      // Enable detailed Fusion/Rpc logging for routing debugging
      "ActualLab.Rpc": "Debug",
