<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsTestProject>false</IsTestProject>
    <IsPackable>false</IsPackable>
    <!-- BenchmarkDotNet requires assembly name to match the csproj name -->
    <AssemblyName>Benchmarks</AssemblyName>
  </PropertyGroup>

  <!-- Remove global usings that require server-side or test-only references -->
  <ItemGroup>
    <Using Remove="ActualChat.Blobs" />
    <Using Remove="ActualChat.Mesh" />
    <Using Remove="ActualChat.Sharding" />
    <Using Remove="ActualChat.Testing" />
    <Using Remove="ActualLab.Testing" />
    <Using Remove="ActualLab.Fusion.Testing" />
    <Using Remove="AwesomeAssertions" />
    <Using Remove="FlakyTest.XUnit.Attributes" />
    <Using Remove="Moq" />
    <Using Remove="Xunit" />
    <Using Remove="Xunit.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\dotnet\UI.App\UI.App.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Samples\*.txt" LogicalName="%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
  </ItemGroup>

</Project>
