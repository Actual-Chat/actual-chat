<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="latest" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <!-- Output -->
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <ArtifactsPath>$(RepoRoot)artifacts\tests</ArtifactsPath>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <!-- Copy all references to output folder (important for coverage tools) -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <!-- Also we will copy all pdb from nupkg, it will help with debugging -->
    <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
    <AllowedReferenceRelatedFileExtensions>$(AllowedReferenceRelatedFileExtensions);.pdb</AllowedReferenceRelatedFileExtensions>

    <!-- xunit -->
    <UseDefaultStartup>true</UseDefaultStartup>
    <XunitStartupAssembly>$(BaseName).Testing</XunitStartupAssembly>
    <XunitStartupFullName>$(BaseName).Testing.DefaultStartup</XunitStartupFullName>
  </PropertyGroup>

  <!-- Test analyzers & warnings -->
  <PropertyGroup>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer> <!-- Ok for tests -->
    <!-- Suppressed warnings (please sort alphabetically!) -->
    <!-- CS8604: Possible null reference argument -->
    <NoWarn>$(NoWarn);1701;1702;CS8604</NoWarn>
    <!-- CA1034: Do not nest type -->
    <!-- CA1822: Member can be marked as static -->
    <!-- CA1859: Use a concrete type instead of interface for improved performance -->
    <!-- CA1861: Prefer 'static readonly' fields over constant array arguments -->
    <!-- CA2007: Consider calling ConfigureAwait on the awaited task -->
    <!-- CA2016: Forward the CancellationToken parameter to methods that take one -->
    <!-- CA2025: Do not pass 'IDisposable' instances into unawaited tasks -->
    <NoWarn>$(NoWarn);CA1034;CA1822;CA1859;CA1861;CA2007;CA2016;CA2025</NoWarn>
    <!-- MA0004: Use Task.ConfigureAwait(false) -->
    <NoWarn>$(NoWarn);MA0004</NoWarn>
    <!-- RCS1090: Call 'ConfigureAwait(false)' -->
    <NoWarn>$(NoWarn);RCS1090</NoWarn>
    <!-- xUnit1041: Fixture argument does not have a fixture source -->
    <NoWarn>$(NoWarn);xUnit1041</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ActualLab.CommandR" />
    <PackageReference Include="ActualLab.Fusion" />
    <PackageReference Include="ActualLab.Generators" PrivateAssets="all" />
    <PackageReference Include="ActualLab.Testing" />
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="FlakyTest.XUnit" />
    <PackageReference Include="MemoryPack.Generator" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Moq" />
    <PackageReference Include="Moq.Analyzers" PrivateAssets="all" />
    <PackageReference Include="Moq.Autocomplete" PrivateAssets="all" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.analyzers" PrivateAssets="all" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="GitHubActionsTestLogger" />
  </ItemGroup>

  <!-- Testing-specific global usings (base usings inherited from root Directory.Build.props) -->
  <ItemGroup>
    <Using Include="ActualChat.Testing" />
    <Using Include="ActualLab.Testing" />
    <Using Include="ActualLab.Fusion.Testing" />
    <Using Include="AwesomeAssertions" />
    <Using Include="FlakyTest.XUnit.Attributes" />
    <Using Include="Moq" />
    <Using Include="Xunit" />
    <Using Include="Xunit.Abstractions" />
    <!-- Server-side usings for all test projects (some test projects like Testing.Host
         don't match IsServerSideProject but still need these) -->
    <Using Include="ActualChat.Blobs" />
    <Using Include="ActualChat.Mesh" />
    <Using Include="ActualChat.Sharding" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)template.xunit.runner.json" CopyToOutputDirectory="PreserveNewest" Link="$(AssemblyName).xunit.runner.json"/>
  </ItemGroup>
</Project>
