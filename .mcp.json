{
  "mcpServers": {
    "chrome-devtools-1": {
      "type": "http",
      "url": "http://localhost:8765/mcp"
    },
    "chrome-devtools-2": {
      "type": "http",
      "url": "http://localhost:8766/mcp"
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${AC_GITHUB_TOKEN}"
      }
    },
    "figma": {
      "type": "http",
      "url": "https://mcp.figma.com/mcp"
    },
    "seq": {
      "command": "tools/seq-mcp-mcp-wrapper"
    }
  }
}
