<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>False</IsPackable>
    <IsPublishable>False</IsPublishable>
    <RollForward>Major</RollForward>
    <RestoreIgnoreFailedSources>true</RestoreIgnoreFailedSources>
    <DependencyVersion>Highest</DependencyVersion>
    <ImplicitUsings>true</ImplicitUsings>
    <IsTrimmable>true</IsTrimmable>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);CS1587;CS1591;CA1062;CA2254</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Bullseye" />
    <PackageReference Include="Crayon" />
    <PackageReference Include="CliWrap" />
    <PackageReference Include="Microsoft.Extensions.FileSystemGlobbing" />
    <PackageReference Include="Nerdbank.GitVersioning" />
    <PackageReference Include="System.CommandLine.DragonFruit" />
    <PackageReference Include="System.Management" />
  </ItemGroup>
  <ItemGroup>
    <!-- Linked so the appxmanifest protocol rewrite uses the same scheme constants as the app -->
    <Compile Include="..\src\dotnet\Api\Constants.AppSchemes.cs" Link="Constants.AppSchemes.cs" />
  </ItemGroup>
  <ItemGroup>
    <UpToDateCheckInput Condition="Exists('..\version.json')" Include="..\version.json" />
  </ItemGroup>
</Project>
