<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget" value="https://api.nuget.org/v3/index.json" />
    <!-- <add key="local_fusion" value="../Stl.Fusion/artifacts/nupkg" /> -->
    <add key="local" value="./lib/nupkg" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget">
      <package pattern="*" />
    </packageSource>
    <packageSource key="local">
      <!--
      Svg.Skia is built from our fork (Actual-Chat/Svg.Skia) targeting SkiaSharp 3.x
      for 16KB page alignment on Android. Upstream Svg.Skia depends on SkiaSharp 2.88.9,
      which ships libSkiaSharp.so with 4KB alignment and will never be fixed in 2.x.
      -->
      <package pattern="Svg.Skia" />
      <package pattern="Svg.Custom" />
      <package pattern="Svg.Model" />
      <package pattern="ShimSkiaSharp" />
    </packageSource>
  </packageSourceMapping>
</configuration>
